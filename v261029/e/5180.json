[["对症之药","","针对病根下的药。比喻纠正缺点错误所用的相应办法。"],["独出己见","","见见解、主张。与别人不同地提出自己的见解和主张。"],["定倾扶危","","倾危。扶助危倾，使其安定。指挽救国家于危难之时。"],["东南半壁","","半壁半边。指长江中下游及其以东、以南的半边江山。"],["吊古伤今","","吊凭吊。凭吊古迹，追忆往昔，对现今状况有所感伤。"],["跌脚槌胸","","以足跺地，以拳敲胸。表示气愤、着急、悲痛等感情。"],["颠斤播两","","较量轻重。常用以比喻品评优劣或形容计较微细之事。"],["道尽途穷","","道、途路。走到路的尽头。形容无路可走，面临末日。"],["澹泊寡欲","","澹泊恬淡；寡少；欲欲望。形容心情恬淡，不图名利。"],["戴玄履黄","","犹戴天履地。玄指天，黄指地。形容人活在天地之间。"],["从恶若崩","","崩倒塌。学坏像高山崩塌一样迅速。比喻学坏很容易。"],["摧心剖肝","","摧折。剖划开。心肝断裂剖开。比喻极度悲伤和痛苦。"],["村酒野蔬","","乡村酿的酒，田野种的菜。形容酒食淡薄，生活清贫。"],["寸长片善","","寸长一点儿长处。片零碎的。形容微小的长处和优点。"],["春风和气","","春天和煦的春风吹拂着人们。比喻对人态度和蔼可亲。"],["春蛇秋蚓","","比喻字写得不好，弯弯曲曲，象蚯蚓和蛇爬行的痕迹。"],["辍毫栖牍","","停笔藏牍，指停止写作。牍，古代写字用的狭长木板。"],["触手生春","","一动手就转成了春天，富有生机。形容技术高明神奇。"],["吹角连营","","角古代军中所吹的乐器。指整个军营响着进攻的号角。"],["炊砂作饭","","砂，同沙”。煮沙子作饭。比喻徒劳无功，白费气力。"],["樗栎庸材","","樗栎不成材的树木。比喻平庸无用的人。常用作谦词。"],["楚囚相对","","形容人们遭遇国难或其他变故，相对无策，徒然悲伤。"],["弛高骛远","","犹好高骛远。比喻不切合实际地追求过高过远的目标。"],["称体载衣","","称适合。按照身材剪载衣服。比喻根据实际情况办事。"],["成佛作祖","","佛教语。指修成佛道，成为祖师。比喻获得杰出成就。"],["乘高决水","","凭借地势居高临下，决口放水。比喻费力小，收效大。"],["朝生夕死","","①早晨刚生，晚上就死亡。②今亦形容事物生命短暂。"],["扯篷拉纤","","指用不正当的手段为人撮合或说情而从中取利的行为。"],["沉著痛快","","坚劲而流利，遒劲而酣畅。形容诗文、书法遒劲流利。"],["长幼有叙","","指年长者和年幼者之间的先后尊卑。亦作长幼有序”。"],["巢居穴处","","栖身于树上或岩洞里。指人类未有房屋前的生活状况。"],["草创未就","","草创开始创办或创立；就完成。刚开始做，尚未完成。"],["餐松啖柏","","以松柏的叶实充饥。形容修仙学道者超尘脱俗的生活。"],["不可揆度","","揆音‘葵’度音‘夺’揆度估量，揣测。指无法推测。"],["不弃草昧","","草昧原始，未开化。不嫌弃蒙昧无知的人。用作谦词。"],["不便水土","","不能适应移居地方的气候和饮食习惯。同不服水土”。"],["兵不雪刃","","兵器上没有沾上血。形容未经战斗就轻易取得了胜利。"],["变醨养瘠","","使薄酒变醇，瘠土变得肥沃。比喻改变贫穷落后面貌。"],["变贪厉薄","","指改变、劝勉贪图财利、行为轻薄的人使之廉洁忠厚。"],["摽梅之年","","摽梅梅子成熟后落下来。比喻女子已到了出嫁的年龄。"],["彼弃我取","","别人摒弃的我拿来。指不与世人共逐名利而甘于淡泊。"],["闭门投辖","","辖车轴的键，去辖则车不能行。比喻主人留客的殷勤。"],["荜门圭窦","","筚门荆竹编成的门，又称柴门。常用以喻指贫户居室。"],["北鄙之音","","指殷纣时的音乐◇世视为亡国之声。亦作北鄙之声”。"],["敖世轻物","","敖，通傲”。鄙弃世俗，看不起别人。也指高傲自大。"],["阿党相为","","阿党偏袒、偏私一方。为了谋求私利相互偏袒、包庇。"],["哀毁瘠立","","旧时形容在父母丧中因过度悲伤而瘦得只剩一把骨头。"],["爱莫之助","","爱爱惜；莫不。虽然心中关切同情，却没有力量帮助。"],["安常守分","","分本分，自己分内的。习惯于平稳的生活，安守本分。"],["非懒即馋","","be either lazy or greedy"],["一官一集","","旧时士大夫以所署官作为撰集之名，始于南朝梁王筠。"],["三门干部","","谓从家门到学校门再到机关门的缺乏实践经验的干部。"],["予齿去角","","谓天生动物赋予齿就不赋予角。比喻事物无十全十美。"],["五坊小儿","","对五坊人员的蔑称。因其仗势虐人，百姓恶之，故称。"],["五峰先生","","宋代理学流派之一的创始人胡宏，学者称为五峰先生。"],["伏魔大帝","","明万历四十二年敕封三国蜀大将关羽为三界伏魔大帝。"],["两贤相厄","","《史记‧季布栾布列传》：“季布母弟丁公，为楚将。"],["八字门楼","","一种门上有牌楼式的顶，门两侧墙壁呈八字形的建筑。"],["公侯万代","","旧时感激他人恩德的祝颂之辞。言子孙万代皆为公侯。"],["分燠嘘寒","","呵出热气使受寒的人温暖。形容对人十分热情、关心。"],["匹马北方","","指唐肃宗于安史之乱中在北方即位，独立维持局面事。"],["千里借筹","","秦末楚汉相争，郦食其劝刘邦立六国后代，共同攻楚。"],["半截汉子","","1) 指下跪的男子。\n2) 比喻屈服于人的男子。"],["南诏画卷","","唐南诏名画。亦名《南诏国史图》、《中兴国史画》。"],["四明狂客","","唐贺知章(字季真)，会稽永兴人，性放旷，善谈说。"],["后膛枪炮","","弹药从后膛装入的枪和炮。后膛，枪膛或炮膛的后部。"],["抓纸卷儿","","旧时做小生意的人所采用的类似赌博的一种推销方式。"],["披头盖脸","","1) 谓头发披遮住脸面。\n2) 见“披头盖脑”。"],["旗扁银两","","清制，发给新中式举人、进士树旗立匾于宅门的银两。"],["木居海处","","指外族或少数民族居住在深山海岛。木居，依树而居。"],["东海夫人","","淡菜的别名。见明李时珍《本草纲目‧介二‧淡菜》。"],["枕席未安","","不能安然睡眠。谓形势尚未稳定或事情有待辛勤处置。"],["栘中属国","","指汉苏武。因其先后为栘中监、典属国，故以此称之。"],["梓匠轮舆","","古代对梓人、匠人、轮人、舆人的并称。亦泛指木工。"],["汉票签处","","清官署名。负责校阅汉文，拟写票签，记录谕旨等事。"],["玉润冰清","","像玉一样润泽，像冰一样清纯。常喻人或物形神之美。"],["瑜百瑕一","","比喻优点多而缺点少。瑜，玉的光采；瑕，玉的毛病。"],["瑰瑰赖赖","","犹磈磈磊磊。众石高低不平貌。亦形容肌肉盘结突起。"],["皱面还丹","","人参的别名。见明李时珍《本草纲目‧草一‧人参》。"],["直百五铢","","三国时，蜀刘备所铸货币的一种。与直百钱价值相等。"],["眼迷心荡","","眼光迷乱，心神摇荡。形容见美色而不能自持的神情。"],["瞿卢折娜","","牛黄的别名。见明李时珍《本草纲目‧兽一‧牛黄》。"],["竹烟波月","","雾气中的竹林和月照下的波纹。喻月光下优美的景色。"],["绝地天通","","《书‧吕刑》：“乃命重黎，绝地天通，罔有降格。”"],["习俗移人","","本作“习俗移性”。\n谓风俗习惯可以改变人的本性。"],["腹蟹目虾","","《文选‧郭璞〈江赋〉》：“璅蛣腹蟹，水母目虾。”"],["膏粱纨裤","","指富贵人家子弟的生活，有浮华奢侈。浅薄无知之意。"],["苻朗皂白","","(今读fú)谓晋苻朗善识味，食鹅能知其毛色之事。"],["蛮攀五经","","方言。谓蛮横不讲理，却硬拉一些大道理来掩护自己。"],["蛮笺象管","","高丽或蜀地所产的纸与象牙管的笔。泛指名贵的纸笔。"],["咏月嘲花","","指创作诗歌。花和月经常作为诗人歌咏的对象，故称。"],["诬托诡挂","","谓将自己的田地伪报在别人名下，以逃避田赋、徭役。"],["跑马占荒","","犹言跑马占圈。有势力的富人亦用此法强占农民土地。"],["送长送短","","犹言送这送那。形容对人生活很关切，待人殷勤热情。"],["过海和尚","","指唐高僧鉴真。因其东渡至日本传播佛教教义，故称。"],["银字觱栗","","簧管乐器觱栗的一种。管上标有表示音调高低的银字。"],["鐻枝兰鼓","","古代钟鼓及其台架。借为饰有钟鼓台架花纹的美锦名。"],["关弓盘马","","跨马盘旋，弯弓欲射。关，通“弯”。泛指习武游乐。"],["阳尘吊子","","方言。屋顶、墙壁上挂下来的灰尘。有的地方叫檐尘。"],["雨淋日晒","","雨水淋浇，太阳曝晒。亦形容露天劳作或旅途的辛苦。"],["青精石饭","","相传道家辟谷时所食之药丸，用青石脂、青粱米制之。"],["饰甲底兵","","整理铠甲，磨快武器。饰，通“饬”；底，通“砥”。"],["马目毒公","","鬼臼的别名。