[["海鳌","","神话传说中的海中巨鳖。"],["浸想","","谓仔细深入地观察思考。"],["浸熏","","浸渍熏灼。谓逐渐败坏。"],["浸蠹","","指侵蚀或损耗国家财富。"],["涌挤","","亦作“涌挤”。\n拥挤。"],["涌身","","亦作“涌身”。\n纵身。"],["涎缠","","胡缠；死皮赖脸地纠缠。"],["淡嘴","","扯淡的嘴。指信口胡言。"],["淡退","","淡泊退让。谓淡于名利。"],["渌醽","","美酒名。渌，同“醁”。"],["淫人","","邪恶的人；不正派的人。"],["深句","","含蓄而语义深刻的句子。"],["深堂","","内堂，屋宇深处的厅堂。"],["渊映","","如潭水照映。形容明澈。"],["渊黛","","深碧幽深貌。借指山谷。"],["淹时","","移时；经过了一段时间。"],["浅埃","","犹尘埃。比喻社会底层。"],["浅戆","","谓心胸狭窄而举事鲁莽。"],["添妆","","指向新娘赠送财物礼品。"],["清偃","","谓世道太平，战争停息。"],["清啸","","清越悠长的啸鸣或鸣叫。"],["清己","","谓以清廉之德要求自己。"],["清斝","","指清酒。斝，古代酒器。"],["清泛","","清散，不繁密。泛，散。"],["清称","","美誉。亦指有声望的人。"],["清身","","谓清廉公正，以身作则。"],["清近","","谓居官清贵，接近皇帝。"],["减克","","亦作“减克”。\n克扣。"],["渝巴","","指四川省的渝水和巴水。"],["渝歌","","四川省渝水一带的民歌。"],["游愒","","游息。愒，古“憩”字。"],["浑帐","","詈词。谓言行无理无耻。"],["湔拭","","洗擦。引申指除去过错。"],["湘勇","","即湘军。参见“湘军”。"],["湘月","","词牌名。即《念奴娇》。"],["湘裙","","湘地丝织品制成的女裙。"],["汤散","","汤药和丸散。常泛指药。"],["源渊","","渊源。比喻事物的根底。"],["溢德","","过分、不合情理的行为。"],["溪柴","","若耶溪所出的小束柴火。"],["溷处","","混杂在一起居住、生活。"],["溺意","","谓心志沉湎于某个方面。"],["沧渤","","东海和渤海。泛指大海。"],["涤虑","","清除烦扰，使思想清净。"],["涤耳","","洗耳。表示恭敬地倾听。"],["滫髓","","滫瀡。柔滑爽口的食物。"],["滞屈","","谓贤人沉抑，不得升进。"],["滞赏","","指应赏而长久未赏的人。"],["渗濑","","丑陋，使人可怕的样子。"],["滴绿","","形容翠绿而润泽的颜色。"],["渔榜","","摇渔船的桨。借指渔船。"],["渔浦","","江河边打鱼的出入口处。"],["漂蓬","","漂泊。谓飘转如同飞蓬。"],["漂蚁","","指漂浮在酒面上的泡沫。"],["演帐","","方言。犹言鬼混，闲逛。"],["沤鹭","","即鸥鹭。沤，通“鸥”。"],["沤点","","雨滴着水时泛起的水泡。"],["漠如","","犹漠然。冷淡，不关心。"],["汉爵","","汉代的封爵。泛指爵禄。"],["漫园","","旧时北京十刹海中园名。"],["漫渎","","漫涧水与渎谷水的并称。"],["漫着","","谓污蔑别人以显示自己。"],["漫钞","","随手写录。亦用作书名。"],["泼贼","","詈词。犹坏蛋，坏东西。"],["洁矩","","谓行为端正，符合法度。"],["洁祀","","洁敬之祀。谓诚心祭祀。"],["潜底","","指藏在泥土中过冬的虫。"],["潜识","","见识深刻；深识；高见。"],["澄窨","","谓将酒窖藏，使之澄清。"],["澄阳","","清澈池水中反射的阳光。"],["浇荡","","谓社会风气浮薄、动荡。"],["浇顿","","谓浇洒费力。顿，劳困。"],["涝朝","","方言。谓晨雾迟迟不开。"],["涧栖","","在涧谷中居住。指隐居。"],["涧沚","","山沟流水中的小块高地。"],["涧阴","","涧谷中不见阳光的地方。"],["澡涤","","洗刷。引申指辩白冤屈。"],["澡罐","","僧人盛盥漱用水的器皿。"],["泽兵","","犹泽旅。泽，通“醳”。"],["澹宁","","谓恬淡寡欲，宁静自持。"],["澹月","","清淡的月光。亦指月亮。"],["浊官","","地位卑下事务冗繁之官。"],["济侈","","犹增侈，更为穷奢极侈。"],["济赈","","赈济，以财物救济灾民。"],["濡墨","","蘸润墨汁。谓用墨书写。"],["濩略","","龙行貌。濩，通“蠖”。"],["滥熟","","烂熟。极其熟悉、熟练。"],["滨塞","","边塞，边远险要的地方。"],["泻囊","","倾囊，谓拿出所有的钱。"],["沥情","","谓点滴不漏地告知实情。"],["潇条","","形容鸟的叫声婉转悦耳。"],["灏露","","白露。灏，用同“皓”。"],["火坼","","占卜时烧灼甲骨的裂纹。"],["火抓","","古代火攻用的一种武器。"],["火杏","","古代火攻用的一种战具。"],["火祥","","火灾。亦指火灾的征兆。"],["火舟","","旧时有火攻装备的战船。"],["火铅","","术士炼丹用的一种红铅。"],["火鞭","","神话中指羲和驭日之鞭。"],["灰燧","","葭灰与燧火。借指岁月。"],["灰货","","方言。詈词。谓不成器。"],["灾愆","","罪孽招致的灾祸；灾殃。"],["灾扇","","谓低劣的字画灾及扇子。"],["灾氛","","不祥之气；灾异的征兆。"],["灾谴","","指上天降灾示罚；灾祸。"],["炎炀","","火势炽猛；炽烈的火焰。"],["照龟","","指烧灼龟甲，以卜吉凶。"],["炭金","","旧时称购炭取暖的礼金。"],["炮牺","","即伏牺。炮，通“庖”。"],["炳博","","谓文章绚烂，学识渊博。"],["乌咽","","呜咽。形容凄切的水声。"],["乌殟","","晕厥。参见“乌头晕”。"],["乌膏","","古时妇女涂唇的化妆品。"],["乌虬","","指雕饰虬龙的黑色手杖。"],["乌阳","","指太阳。亦喻昌明盛世。"],["烘帘","","暖帘。冬天挂的棉门帘。"],["烜洲","","古代传说中的海中洲名。"],["烝弑","","谓奸淫母辈，残杀君父。"],["烽尘","","烽火和烟尘。借指战乱。"],["烽旆","","烽火和战旗。借指兵事。"],["无垒","","不设营垒。谓太平无事。"],["无襦","","没有短袄。谓衣服单薄。"],["无遇","","谓没有得到用世的机会。"],["焦然","","憔悴貌。焦，通“憔”。"],["炜发","","火光迸发。谓发难起事。"],["烟杯","","即烟筒。吸水烟的用具。"],["烟树","","云烟缭绕的树木、丛林。"],["烟清","","烟尘澄清。指战乱平息。"],["烟舍","","泛指山乡或江村的住屋。"],["焕景","","光辉焕发；焕发的光辉。"],["照席","","宴饮时照料宾客，陪席。"],["烦且","","指骏马。且，同“驵”。"],["烦弊","","众多的弊害；弊害繁多。"],["煮井","","煮盐井之水(以为盐)。"],["熇蒸","","热气升腾。引申为酷热。"],["熏祓","","谓以烟、气等祛除邪秽。"],["熏膏","","点燃灯烛。谓夜以继日。"],["熨齿","","使牙齿感到凉爽或寒冷。"],["热魔","","谓执着某事而热心欲狂。"],["灯事","","指元宵节张灯游乐之事。"],["灯烬","","灯心燃烧后剩下的炭灰。"],["灯窗","","窗前灯下。指苦学之所。"],["燋虑","","犹忧虑。燋，通“焦”。"],["燋毒","","旧铜烧器中的一种毒质。"],["燕弓","","燕地所产的弓。指良弓。"],["燕脯","","燕肉干。传说龙嗜食之。"],["燕雨","","有燕子绕飞其间的小雨。"],["燛","","jiŏng\n同“煚”。"],["营勇","","清代指地方招募的士兵。"],["灿黄","","犹金灿灿。形容金黄色。"],["烛灺","","烛将尽。亦指烛的余烬。"],["焘载","","天覆地载。谓仁德广被。"],["爆烁","","剥落。枝叶稀疏不均貌。"],["爆直","","唐代称节假值日为爆直。"],["爟烽","","报警的烽火。亦指战事。"],["爟燧","","报警的烽火。亦指战事。"],["爨濯","","做饭、洗刷。泛指家务。"],["爬窝","","方言。谓牲畜卧圈不起。"],["争辔","","驭马争先。指争竞高下。"],["爻槌","","江湖卖卜者占卜的用具。"],["牌纛","","用作仪仗的金牌和大旗。"],["牙首","","行会基层组织的负责人。"],["牛享","","古代用牛作祭祀的供品。"],["牛客","","宋代称拥有耕牛的佃客。"],["牟甲","","即盔甲。牟，通“鍪”。"],["牟衫","","用牛毛捻线织成的衣服。"],["牢饩","","祭祀