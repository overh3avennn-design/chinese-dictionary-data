[["僧只户","","北魏僧官管辖的民户。僧只户除向僧官输粟外，不向官府供输赋役。"],["两梁冠","","古代博士和某些高级文官所戴的一种帽子。用缁布做，有两道横脊。"],["合不着","","方言。不合算；不值得。如：花那麽多钱去旅游一次，实在合不着。"],["同泰寺","","寺名。在今江苏省南京市。为南朝梁所建，梁武帝曾数度舍身于此。"],["昆仑竹","","昆仑山所产之竹。相传黄帝取之以制律管。见《汉书‧律历志上》。"],["期集费","","亦称“期集钱”。\n宋代皇帝赐给新及第进士游宴及造名册的费用。"],["独奏州","","唐时靺鞨族政权渤海国所置直属中央政府之州，所奏事可直达京师。"],["宁封子","","亦称“甯封”。\n传说中黄帝时仙人。后代文人游仙诗多引为典实。"],["粉荔枝","","亦作“粉荔”。\n唐代洛阳人家正旦以粉制成荔枝状作为节日食品。"],["贡公喜","","谓汉贡禹为王吉(字子阳)的登用而欣喜。引申为乐于良朋的出仕。"],["卖饼家","","1) 出售糕饼的店家。\n2) 比喻小家气派。与大方之家相对。"],["酆城剑","","1) 相传晋张华与雷焕登楼仰观天文。\n2) 比喻优异的才识。"],["韩陵石","","唐张鷟《朝野佥载》卷六：“梁庾信从南朝初至北方，文士多轻之。"],["龙藏寺","","1) 寺名。(1)在浙江省嵊县之北。\n2) 见“龙藏寺碑”。"],["吃闲话","","受人讥讽或批评。 如： “你也不怕吃闲话， 敢做这种事？ ”"],["押孤丁","","比喻孤注一掷。 如： “这事做不得的， 别拿小命押孤丁。 ”"],["有分儿","","1. 气派权势大。 如： “他很有分儿。 ”\n2. 有余裕。"],["西都赋","","文章名。 汉班固撰。 亘描述长安物产丰饶， 繁华热闹的景象。"],["复分数","","[p]math.[/p] compound fraction"],["灌片子","","cut a record; record (on disk)"],["猴顶灯","","[p]coll.[/p] rickety; unstable"],["夹衣裳","","lined garments without padding"],["紧底下","","[p]coll.[/p] very lowest point"],["开不成","","can’t carry out (meeting/etc.)"],["木樨饭","","fried rice with scrambled eggs"],["娶过来","","marry a girl (into the family)"],["晒蔫了","","[p]coll.[/p] wilted in the sun"],["耍势力","","[p]coll.[/p] abuse one’s power"],["下下来","","[p]coll.[/p] take a thing down"],["学得象","","imitate/copy with marked skill"],["住街坊","","[p]coll.[/p] live as neighbors"],["分配数","","allotment; distribution number"],["淬火池","","quenching bath; hardening bath"],["东边儿","","erhua variant of 东边[dōng bian]"],["备鞍","","[saddle] 给马等装设鞍子"],["折纹","","[wrinkle] 皱褶; 褶子"],["济助","","[relieve] 救济, 帮助"],["渗凉","","[feel cold] 感觉到冷"],["粝米","","[coarse rice] 糙米"],["螫蜂","","[dryinid] 螫蜂科的一种"],["中隆","","discal elevation"],["再梳","","second scutching"],["幂积","","product of power"],["经差","","meridian spacing"],["脉环","","circulus venosus"],["装钉","","working together"],["三性","","three properties"],["乍热","","periodical fever"],["光施","","optical rotation"],["后沟","","sulcus posterior"],["淖泽","","moist and smooth"],["病热","","pyretic diseases"],["真中","","stroke with wind"],["背干","","truncus dorsalis"],["腹肾","","abdominal kidney"],["血菀","","blood stagnation"],["顺传","","due transmission"],["顿呛","","paroxysmal cough"],["黄栎","","delavay oak bark"],["圆炉","","circular furnace"],["恒真","","identically-true"],["方锤","","plane set-hammer"],["七科","","指应征派到边疆去服兵役的七种人。"],["三二","","约计之词。常用于表示较少的数量。"],["不殄","","1) 不善，不好。\n2) 不断。"],["不毈","","亦作“不段”。\n谓鸟卵孵育成雏。"],["丐命","","1) 请求饶命。\n2) 犹苟活。"],["中绝","","1) 隔断。\n2) 中断；绝灭。"],["九列","","1) 九卿的职位。\n2) 九星。"],["享礼","","使臣向朝聘国君主进献礼物的仪式。"],["人排","","古代冶炼时用人力带动的鼓风机械。"],["来乃","","唐时骠国乐曲名。又名“斗羊胜”。"],["俊辩","","亦作“俊辨”。\n雄辩，辩才杰出。"],["俸资","","亦作“俸赀”。\n官吏所得的薪金。"],["倓钱","","古代南方少数民族为赎罪所出的钱。"],["优与","","1) 从优给予。\n2) 谓宽容。"],["典衣","","1) 典押衣服。\n2) 指饮酒。"],["凄其","","1) 凄凉悲伤。\n2) 寒凉貌。"],["出帖","","1) 出给柬帖。\n2) 指门联。"],["刻蜡","","刻烛。相传古人在蜡烛上刻度计时。"],["剥丧","","1) 伤亡；丧乱。\n2) 衰败。"],["剧易","","1) 轻重；难易。\n2) 艰难。"],["匹裂","","亦称“匹制”。\n小口大腹的木罐。"],["升车","","1) 登车，上车。\n2) 缆车。"],["参丽","","亦作“参俪”。\n参乘并驾；并列。"],["反听","","1) 谓自我省察。\n2) 不听。"],["周惶","","亦作“周遑”。\n彷徨，犹疑不定。"],["咀味","","1) 品味。\n2) 玩味；体味。"],["商羽","","五音中的商声和羽声，亦泛指曲调。"],["丧娶","","亦作“丧取”。\n在服丧期间婚娶。"],["嘉祯","","亦作“嘉贞”。\n犹言吉祥的征兆。"],["嘉穟","","亦作“嘉穗”。\n茁壮饱满的禾穗。"],["叽愣","","亦作“叽冷”。\n方言。突然受惊。"],["坻隤","","亦作“坻颓”。\n山崩；山崩之声。"],["塉确","","亦作“塉埆”。\n土地贫瘠而多石。"],["夏礿","","亦作“夏禴”。\n谓天子诸侯夏祭。"],["夜发","","1) 夜不寐。\n2) 夜间出发。"],["大优","","1) 极丰富。\n2) 高级伶官。"],["好修","","喜爱修饰仪容。借指重视道德修养。"],["妙辩","","亦作“妙辨”。\n圆融无碍的论辩。"],["奸舋","","指奸诈不轨的行为。舋，通“衅”。"],["孔皆","","1) 普遍。\n2) 指普遍降福。"],["容庇","","亦作“容芘”。\n包庇；宽容庇护。"],["寝默","","亦作“寝嘿”。\n止而不言，沉默。"],["尤功","","功绩最卓着，亦指功绩最卓着的人。"],["尸皮","","亦作“尸皮子”。\n詈词。指衣服。"],["屈沉","","亦作“屈沈”。\n委曲沉沦；埋没。"],["山阜","","亦作“山峊”。\n土山。泛指山岭。"],["山际","","1) 山边。\n2) 山中；山间。"],["崇日","","终日。一天的时间。崇，通“终”。"],["崩崩","","象声词。弹拨弦乐器所发出的声响。"],["崩阤","","1) 塌毁。\n2) 引申指败坏。"],["巧挴","","巧于贪求。一说精于驱车策马之术。"],["巨卿","","1) 汉范式的字。\n2) 大官。"],["帷帽","","亦作“帷冒”。\n周围垂网的帽子。"],["幡花","","亦作“幡华”。\n供佛的幢幡彩花。"],["庬澒","","亦作“庬鸿”。\n元气混沌未分貌。"],["庙胜","","指朝廷预先制定的克敌制胜的谋略。"],["弄马","","1) 玩马。\n2) 指表演骑术。"],["徐方","","1) 指古徐国。\n2) 指徐州。"],["徒作","","1) 服劳役。\n2) 无因而作。"],["悉诸","","亦称“悉老”。\n传说为神农之师。"],["惸孤","","1) 孤独。\n2) 指孤独的人。"],["忧属","","亦作“忧瞩”。\n忧国忧民的属望。"],["忧服","","谓因父母死而居忧服丧。亦指丧服。"],["成荆","","亦称“成庆”。\n春秋齐国的勇士。"],["戒监","","亦作“戒鉴”。\n警戒；引以为戒。"],["排阖","","1) 推开门扇。\n2) 犹捭阖。"],["援噬","","亦作“援簭”。\n谓捕执而咬食之。"],["改席","","改换座席。对客人表示尊敬的举动。"],["故弊","","1) 破旧。\n2) 指破旧之物。"],["故然","","1) 因此。\n2) 本然；必然。"],["效官","","1) 授官。\n2) 引申指做官。"],["敏劭","","亦作“敏卲”。\n谓才识敏捷美善。"],["新清","","1) 犹清新。\n2) 新鲜清爽。"],["昌仆","","人名。相传为昌意之妃，颛顼之母。"],["明诫","","亦作“明戒”。\n明白告诫；明训。"],["春至","","1) 即春分。\n2) 春天来到。"],["春酝","","1) 春季酿造。\n2) 指春酒。"],["景望","","1) 崇高的声望。\n2) 仰慕。"],["晓妆","","1) 晨妆。\n2) 指晨起梳妆。"],["月堂","","唐李林甫堂名。因形如偃月，故名。"],["朔途","","亦作“朔涂”。\n谓前往北方之路。"],["朝沆","","早晨的沆瀣。传说为神仙服食之物。"],["朱三","","五代后梁太祖朱温排行第三，故称。"],["柘袍","","1) 柘黄袍。\n2) 借指皇帝。"],["柯舒","","亦称“柯欘”。\n古代的一种兵器。"],["柳烟","","柳树枝叶茂密似笼烟雾，因以为称。"],["桲椤","","亦作“桲罗”。\n木名。叶可饲蚕。"],["梢芟","","指树枝、芦荻之类的防汛护堤材料。"],["植杖","","1) 倚杖。扶杖。\n2) 立杖。"],["橘林","","1) 古蜀名园。\n2) 橘树林。"],["毁车","","谓放弃战车(改编为步卒的行列)。"],["毒痛","","1) 痛楚；苦痛。\n2) 荼毒。"],["毒痡","","1) 毒害，残害。\n2) 痛苦。"],["氛浊","","1) 尘浊之气。\n2) 喻弊端。"],["汁防","","汉代侯国名。在今四川省什邡县境。"],["沓障","","亦作“沓嶂”。\n重重叠叠的山峰。"],["沸涌","","1) 水翻腾貌。\n2) 指喷泉。"],["洄旋","","亦作“洄漩”。\n水流回旋，盘旋。"],["浅谬","","亦作“浅缪”。\n谓肤浅而多谬误。"],["清霄","","1) 天空。\n2) 指空中浮云。"],["渚牙","","亦作“渚芽”。\n洲上初生的草芽。"],["涡口","","涡水入淮处。在安徽省怀远县东北。"],["涤秽","","涤除污秽。多比喻清除谬误、邪恶。"],["汉官","","指古代少数民族王朝中的汉人官吏。"],["炊米","","1) 煮饭。\n2) 煮饭用的米。"],["乌啼","","指琴曲《乌夜啼引》或《乌啼引》。"],["烹炼","","1) 冶炼。\n2) 提炼、锤炼。"],["无廖","","亦作“无戮”。\n不努力，不尽力。"],["无朕","","亦作“无眹”。\n没有迹象或先兆。"],["无觉","","1) 未睡醒。\n2) 没有知觉。"],["燔瘗","","1) 祭祀天地。\n2) 指祭品。"],["营众","","1) 惑众。\n2) 指营内官兵。"],["独贤","","1) 谓独劳。\n2) 特别贤良。"],["玄址","","亦作“玄沚”。\n水中的小块陆地。"],["玉押","","亦作“玉柙”。\n门帘的玉饰镇坠。"],["王极","","皇极。指天子据以治国的大中之道。"],["瑕摘","","亦作“瑕擿”。\n犹瑕适。指过失。"],["璧采","","亦作“璧彩”。\n比喻月光，月色。"],["环句","","亦作“环钩”。\n环与环相勾联貌。"],["玺册","","亦作“玺策”。\n玉玺和册命文书。"],["画圈","","在文件上画个圈儿，表示已经过目。"],["疏勺","","古代柄上刻有饰纹的舀酒浆的器具。"],["疑谬","","亦作“疑缪”。\n可疑和谬误之处。"],["痞隔","","亦作“痞鬲”。\n郁结，阻滞不通。"],["百仞","","八尺为仞。百仞，形容极深或极高。"],["百能","","各种才能。借指具有各种才能的人。"],["荡摩","","亦作“荡磨”。\n谓相切摩而变化。"],["直辟","","亦作“直劈”。\n谓固执，不随和。"],["相禅","","亦作“相嬗”。\n相演变；相转化。"],["瞑坐","","I\n闭目静坐。\nII\n坐着小睡。"],["石局","","1) 石棋盘。\n2) 元代官名。"],["硗聱","","亦作“硗磝”。\n多石，高低不平。"],["禄算","","宿命论者所谓人生注定的福禄气数。"],["穴壁","","1) 凿墙洞。\n2) 借指窃贼。"],["空耗","","1) 空虚；匮乏。\n2) 白费。"],["窃訾","","亦作“窃赀”。\n占有别人的资财。"],["章蔀","","亦作“章部”。\n我国古历法名词。"],["竦身","","耸身，纵身向上跳。竦，通“耸”。"],["笔债","","指应人约请而尚未完成的文墨之事。"],["箕服","","亦作“箕箙”。\n箕木做成的箭袋。"],["简恤","","亦作“简恤”。\n谓考察而体恤之。"],["精精","","1) 兽名。\n2) 指精明的人。"],["结毦","","亦作“结氂”。\n用羽毛编织饰物。"],["絣扒","","剥去衣服捆绑起来。絣，通“绷”。"],["绿縢","","古代弓上的绿色绳索，用作装饰品。"],["纶诰","","亦作“纶告”。\n皇帝的诏令文告。"],["绮宴","","亦作“绮燕”。\n华美丰盛的筵宴。"],["绣褓","","亦作“绣葆”。\n覆裹婴儿的绣被。"],["置楬","","树立木桩。多用于墓前，以作标志。"],["翠樽","","亦作“翠尊”。\n饰以绿玉的酒器。"],["翠滑","","色黑而润泽。多用以形容女人头发。"],["翠芽","","亦作“翠牙”。\n植物初生的绿芽。"],["聆风","","1) 闻风。\n2) 箘竹的别名。"],["肆情","","1) 犹纵欲。\n2) 放荡情怀。"],["胡苑","","胡人牧养禽兽的苑囿。指胡人地域。"],["脱巾","","脱下头巾，改戴官帽。指开始入仕。"],["腿绷","","亦作“腿絣”。\n绑腿一类的用品。"],["肤辞","","亦作“肤词”。\n肤浅空泛的言辞。"],["腊面","","明时宫中于十二月初八日赐食之面。"],["卧鼓","","息鼓。常示无战争，或战事已息止。"],["舍中","","1) 犹家中。\n2) 指家中人。"],["苛留","","I\n极力挽留。\nII\n盘问扣留。"],["英蕤","","1) 艳丽的花。\n2) 犹英华。"],["茫蛮","","亦作“茫诏”。\n古代西南部族名。"],["兹非","","春秋楚国剑士。后世借指勇力武士。"],["莫得","","1) 不得；休要。\n2) 没有。"],["蔓辞","","亦作“蔓词”。\n芜杂繁冗的言辞。"],["蕃畿","","古代指最远的地方。蕃，通“藩”。"],["蛆蟝","","亦作“蛆渠”。\n即马蚿。百足虫。"],["蠲酲","","消除酒病。酲，酒醉醒后困乏如病。"],["褒录","","1) 奖进录用。\n2) 犹褒述。"],["西倾","","1) 向西倾斜。\n2) 喻年老。"],["誓盟","","I\n立誓订盟。\nII\n立誓订盟。"],["语难","","谓因愤激而出语艰涩，说话不流利。"],["诚素","","亦作“诚愫”。\n情愫；真情实意。"],["请会","","一种邀请他人参加的小型贷款形式。"],["谖浮","","指喧嚣轻佻的风气。谖，通“諠”。"],["谗箭","","谗言。谗言如箭矢一样伤人，故称。"],["谶术","","古代巫师、方士等预卜未来的法术。"],["贡砚","","亦作“贡研”。\n充作贡品的砚台。"],["赐则","","指给未成诸侯国的子、男赐以土地。"],["贤合","","亦作“贤阁”。\n对人妻子的尊称。"],["卖佣","","亦作“卖庸”。\n出卖劳力作佣工。"],["超殊","","1) 犹迵异。\n2) 卓越特异。"],["路脚","","1) 路的尽头。\n2) 指路边。"],["踏节","","亦作“蹋节”。\n以脚踏地打节拍。"],["軥辀","","亦作“軥輖”。\n象声词。鸟鸣声。"],["辅正","","1) 辅佐匡正。\n2) 犹校正。"],["辍食","","停止饭食。多形容哀伤或发愤之情。"],["迷澌","","亦作“迷厮”。\n谓神思恍惚散乱。"],["逆政","","1) 乱政。\n2) 指败坏政治。"],["逞辞","","亦作“逞词”。\n放言；恣纵词章。"],["连阁","","1) 连延的楼阁。\n2) 满阁。"],["过都","","明时豪强地主瞒田逃税的一种方法。"],["遵途","","亦作“遵涂”。\n谓遵循道路前进。"],["辽绕","","亦作“辽遶”。\n缭绕，回环旋转。"],["边信","","1) 偏信。\n2) 边地的书信。"],["郡合","","亦作“郡阁”。\n借指郡守的府院。"],["酒藏","","旧时专门为朝廷酿造和藏酒的机构。"],["重姓","","I\n犹大姓。\nII\n复姓，双姓。"],["野享","","亦作“野飨”。\n在野外设食款待。"],["钝闻","","亦作“钝闵”。\n昏昧，不明事理。"],["闪朒","","亦作“闪肭”。\n扭伤筋络或肌肉。"],["开谕","","亦作“开喻”。\n启发解说；劝告。"],["阪险","","1) 斜坡与山泽。\n2) 险峻。"],["陋圃","","狭小的园圃。借指浅狭简陋的居处。"],["阴渠","","1) 山北的沟渠。\n2) 暗渠。"],["隐鳞","","神龙隐匿其鳞。比喻贤者待时而动。"],["雀罗","","捕雀的网罗。常用以形容门庭冷落。"],["雉兔","","野鸡和兔子。亦指猎取野鸡和兔子。"],["雪足","","1) 赤着的脚。\n2) 赤着脚。"],["云旓","","亦作“云梢”。\n绘有云彩的旌旗。"],["云矗","","1) 耸立的云。\n2) 高耸貌。"],["霞岭","","高山峻岭。出家修道者的隐居场所。"],["雾勃","","亦作“雾渤”。\n雾气蓬勃蒸腾貌。"],["青辉","","亦作“青晖”。\n幽暗惨淡的光线。"],["飞钳","","亦作“飞箝”。\n辩论的一种方法。"],["骇鹿","","1) 受惊的鹿。\n2) 犹逐鹿。"],["魁秀","","1) 壮美。\n2) 指杰出人才。"],["鸿炉","","1) 大火炉。\n2) 比喻天地。"],["鹄苍","","亦作“鹄仓”。\n传说中的神犬名。"],["麻辞","","亦作“麻词”。\n委任宰相的诏书。"],["鼘鼘","","鼓声。 “～～不已，声以发之。”"],["囊生","","西藏农奴主家的奴隶。也译作朗生。"],["劓刑","","（yìxíng）古代割鼻的刑罚。"],["涤尘","","to wash off dust"],["炳著","","eminent\nrenowned"],["蠲体","","to clean oneself"],["冯谖","","孟尝君门下食客。 见“冯欢”条。"],["出齐","","齐备完整。 如： “书已出齐”。"],["勃如","","发怒冲动的样子。 亦作“勃然”。"],["史鱼","","春秋时卫国大夫。 见“史”条。"],["帮别","","大陆地区指各地区不同风味的菜色。"],["捯线","","放风筝时收线的动作称为“捯线”。"],["掇遗","","收集整理遗失的文字或先人的遗著。"],["故退","","器物陈旧而不用。 亦作“退故”。"],["去零","","zero-suppression"],["挫敌","","defeat the enemy"],["顶克","","see dǐngkèzú 顶克族"],["房贴","","rental allowance"],["𫛳鸟","","buzzard; vulture"],["干铲","","sponge off (sb.)"],["黑呢","","black wool cloth"],["排下","","line up; arrange"],["朐脯","","dried flank meat"],["煽火","","fan a fire/flame"],["舍出","","give up; abandon"],["奢言","","extravagant talk"],["市上","","on/at the market"],["是晚","","the said evening"],["竖道","","vertical line(s)"],["先妻","","my deceased wife"],["绣袍","","embroidered gown"],["𫚈","","silver carp (鲂𫚈)"],["洵属","","truly; certainly"],["缘溪","","along the stream"],["纸旗","","small paper flag"],["总选","","general election"],["厚荚","","thick-walled pod"],["掌侧"