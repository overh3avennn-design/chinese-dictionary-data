[["除巳","","指农历三月上巳节。旧俗于此日祓除不洁，故称。"],["除馑","","佛教语。指出家人。僧尼断贪欲，除六情，故称。"],["阴戎","","1) 古代少数民族名。\n2) 泛指少数民族。"],["陶阮","","晋陶渊明和三国魏阮籍的并称。两人皆为大诗人。"],["陷将","","I\n将领被俘或阵亡。\nII\n将领被俘或阵亡。"],["隋宫","","指隋炀帝下扬州时兴建的离宫行苑。又称江都宫。"],["隔品","","I\n指官位相差一品。\nII\n指官位相差一品。"],["隔搔","","I\n见“隔靴搔痒”。\nII\n见“隔靴搔痒”。"],["陨队","","1) 陨落。死亡的婉称。\n2) 毁坏；败坏。"],["随园","","1) 清袁枚的别墅名。\n2) 清袁枚的别号。"],["险竿","","杂技名。爬上高竿，并在高竿上做各种杂技表演。"],["隐暧","","1) 指草木浓盛茂密貌。\n2) 指文义隐晦。"],["隶省","","汉字隶变的一种。篆字简省后的隶定称“隶省”。"],["雁户","","1) 指流动无定的民户。\n2) 猎凫雁之户。"],["雅篆","","问别人字号时的敬称。私人印章多用篆字，故称。"],["雅旧","","1) 故旧。\n2) 旧谊。\n3) 指有旧谊。"],["雌甲","","年逾花甲之同庚者二人，其幼者之甲子为雌甲子。"],["雍泮","","辟雍与泮宫。泛指古代天子或诸侯所设立的大学。"],["杂拟","","古诗诗体之一种。指各种模拟前人作品所写的诗。"],["杂歌","","1) 指古诗中的歌或行。\n2) 苗族指山歌。"],["离坼","","1) 谓土地因缺乏水分而龟裂。\n2) 拆散。"],["离亲","","1) 谓与亲属相分离。\n2) 离间亲属关系。"],["离黍","","《诗‧王风‧黍离序》：“《黍离》，闵宗周也。"],["雪窝","","1) 积雪的洞穴。\n2) 积雪的洼地、谷地。"],["云樯","","1) 帆樯。其高入云，故称。\n2) 借指船。"],["云涧","","1) 云气弥漫的山间。\n2) 指隐者的居处。"],["云积","","1) 云朵堆积。\n2) 如云堆积。比喻盛多。"],["雷杼","","传说中雷神用以发霹雳的工具。其形如梭，故名。"],["雷气","","1) 形容威武雄壮的气概。\n2) 雷火之气。"],["电烻","","I\n如闪电之光。谓色红而光亮。\nII\n闪电。"],["电谢","","1) 比喻迅速消逝。\n2) 打电报表示谢意。"],["电露","","1) 闪电和露水。借指天地。\n2) 喻短暂。"],["霆雷","","1) 迅雷。比喻巨大的声威。\n2) 喻盛怒。"],["震夙","","《诗‧大雅‧生民》：“载震载夙，载生载育。”"],["震维","","震，指东方。维，地维，指地。震维，东方之地。"],["霓襟","","1) 指道士的衣服。\n2) 比喻鲜艳的车帷。"],["霜庭","","1) 日月光照下的庭院。\n2) 秋天的庭院。"],["霜简","","1) 古代御史弹劾大臣的奏章。\n2) 竹笏。"],["霜缟","","1) 白绢。\n2) 洁白貌。\n3) 指月光。"],["霜艳","","亦作“霜艳”。\n1) 霜浓。\n2) 明洁貌。"],["霞采","","亦作“霞彩”。\n1) 彩霞。\n2) 喻彩旗。"],["雾帐","","1) 如帐幔的云雾。\n2) 轻柔如雾的帐帷。"],["霸蛮","","1) 方言。勉强。\n2) 方言。坚决；执拗。"],["灵枣","","1) 犹仙枣。\n2) 枣的一种。形大而甜美。"],["灵蔡","","卜卦用的大龟。蔡，本大龟所出地名，后指大龟。"],["青兕","","青兕牛。古代犀牛类兽名。一角，青色，重千斤。"],["青扈","","即桑扈。俗名青雀。背青黑色，腹下蓝色，故称。"],["青煤","","松烟。指松柴燃烧时生成的黑烟。为制墨的原料。"],["青烛","","即南天烛。植物名。道家炮制青精饭的原料之一。"],["青甲","","草木初生时的外皮。亦指新绽开的草木的叶、芽。"],["青躔","","古代指春季日月星辰运行的度次。借指司春之神。"],["青霾","","犹阴霾。大气混浊呈浅蓝色或微黄色的天气现象。"],["静士","","1) 隐居之士。\n2) 沉静稳重的青年男子。"],["非地","","1) 犹言是非之地。\n2) 不适宜去的地方。"],["靡旌","","旌旗披靡。本谓战车疾驱之状。借指疾驱之战车。"],["靡碎","","1) 糜烂粉碎。\n2) 分崩离析，瓦解崩溃。"],["靡响","","本义为靡靡之音，借指辞藻华丽而无风骨的诗赋。"],["鞠尘","","酒麴所生的霉菌。色淡黄，如尘。鞠，通“麴”。"],["韦曲","","1) 地名。\n2) 借指风景秀丽的游览胜地。"],["韩白","","古代名将汉韩信和秦白起的并称。以善用兵着称。"],["韬发","","古礼，未成年者用帻巾包扎头发，谓之“韬发”。"],["鞴鹰","","蹲在臂套上的苍鹰。比喻摆脱羁绊欲展鸿图的人。"],["顶笔","","古代朝见，插笔于冠，以备记事，谓之“顶笔”。"],["顶费","","转让或取得企业经营权或房屋租赁权所付出的钱。"],["顶颡","","谓食物抵撞到喉头。形容饱食到极点而吞咽不下。"],["项里","","在今浙江绍兴西南二十里，世传为项羽流寓之处。"],["顺节","","1) 顺应节奏。\n2) 顺从节令；依照时令。"],["颀甫","","即圻父。古官名。掌封圻内兵甲。颀，通“圻”。"],["顿老","","明代金陵琵琶手。名噪一时，人称“琵琶顿老”。"],["愿嚏","","《诗‧邶风‧终风》：“寤言不寐，愿言则嚏。”"],["颡泚","","《孟子‧滕文公上》：“其颡有泚，睨而不视。”"],["颠陷","","1) 下陷。\n2) 覆灭。\n3) 指使覆灭。"],["类锡","","《诗‧大雅‧既醉》：“孝子不匮，永锡尔类。”"],["显允","","1) 英明信诚。\n2) 显扬。允，语气助词。"],["显昭","","1) 使显扬昭着。\n2) 指有显着德才的人。"],["显义","","1) 发扬正义。\n2) 谓显着而重要的事义。"],["风壤","","犹风土。指一个地方特有的自然环境和风俗习惯。"],["风矩","","1) 风度，气派。\n2) 文章的风采和法式。"],["风菜","","1) 药草名。\n2) 一种供制腌菜用的蔬菜。"],["飙飙","","1) 风吹貌。\n2) 显赫貌。形容声势盛大。"],["飞盏","","1) 谓传杯痛饮。\n2) 谓传杯斟酒行酒令。"],["飞翮","","1) 飞鸟。\n2) 古冠名。\n3) 名马名。"],["饷午","","1) 吃午饭。\n2) 中午。饷，用同“晌”。"],["养爷","","旧时照料或抚养孩子的奴仆，孩子尊称其为养爷。"],["余态","","1) 无穷的美好姿态。\n2) 指残留的姿色。"],["余智","","1) 充足的智慧。\n2) 指小谋略、小手段。"],["余泽","","1) 指大水泽。\n2) 指遗留给后人的德泽。"],["饯尸","","祔祭时献酒给代表死者受祭的尸。古代一种祭礼。"],["馆殿","","昭文馆、集贤院、史馆和集贤殿、右文殿的统称。"],["飨象","","比喻难以捉摸，无可明辨的事物。飨，通“响”。"],["馋唾","","1) 口水。\n2) 比喻他人说过的一言半语。"],["马纲","","指成批的马编纲运输，宋代或把马百匹编为一纲。"],["马靳","","指马身前部。靳，古代车上夹辕两马当胸的皮革。"],["驰光","","1) 光芒飞射。喻迅疾。\n2) 流逝的时光。"],["驼脂","","指骆驼背部驼峰内的脂肪。又称峰子油，可入药。"],["骋力","","1) 施展才力；效力。\n2) 炫示强大有力。"],["骑气","","1) 如骑兵阵的云气。\n2) 谓乘云气飞行。"],["骑羊","","典出汉刘向《列仙传‧葛由》：“葛由，羌人也。"],["骄憨","","年幼不懂事而又天真可爱的样子。骄，通“娇”。"],["惊秋","","1) 秋令蓦地来到。\n2) 喻迅速凋零衰败。"],["骨榇","","死人埋葬后经过腐烂剩下来的骨头。亦借指尸体。"],["高揖","","双手抱拳高举过头作揖。古代作为辞别时的礼节。"],["鬓花","","1) 插戴于鬓边的花朵。\n2) 花白的鬓发。"],["闹蛾","","古代一种头饰。剪丝绸或乌金纸为花或草虫之形。"],["郁嵂","","1) 形容山势曲折蜿蜒。\n2) 烟气升腾貌。"],["鬼质","","1) 谓形貌粗野丑陋。\n2) 指形质丑恶者。"],["魔宫","","1) 魔鬼之宫。\n2) 喻恶势力盘踞的地方。"],["鱼孽","","古代迷信谓鱼类的某些不常见现象所预示的灾异。"],["鲁儒","","鲁国儒生。亦泛指儒家学说的信奉者、儒派学者。"],["鲁雉","","典出《后汉书‧鲁恭传》：“﹝鲁恭﹞拜中牟令。"],["鲠塞","","1) 哽咽气塞。鲠，通“哽”。\n2) 阻塞。"],["鲞鹤","","鳓鱼鯗。因鳓鱼头上有骨，合之如鹤喙形，故称。"],["鸟明","","相传为伏羲氏的六佐之一。执掌为民谋福利的事。"],["鸟乡","","宋时鄂州崇阳县雷家洞、石门洞民所居住的乡村。"],["鳦降","","《诗‧商颂‧玄鸟》：“天命玄鸟，降而生商。”"],["凤质","","1) 指人的美好品质。\n2) 指美妙的乐音。"],["鸿材","","1) 大才；卓越的才能。\n2) 上等的材料。"],["鸿泽","","1) 巨大的恩泽。多指皇恩。\n2) 古泽名。"],["鹈梁","","《诗‧曹风‧候人》：“维鹈在梁，不濡其翼。”"],["鹄山","","黄鹄山的省称。即今武汉市蛇山。鹄，通“鹤”。"],["鹤焰","","亦作“鹤焰”。\n烛火。因烛台竦立如鹤，故称。"],["鹤谶","","白色预兆物。对旧王朝主凶，而对新王朝则主吉。"],["鹢路","","《左传‧僖公十六年》：“六鹢退飞，过宋都。”"],["鹪蚊","","焦螟与蚊虫。比喻极微小的东西。鹪，通“焦”。"],["鸾翅","","1) 鸾鸟的翅羽。借指鸾鸟。\n2) 指排箫。"],["麇聚","","I\n谓似獐那样依类相聚。\nII\n群集；聚集。"],["丽亿","","《诗‧大雅‧文王》：“商之孙子，其丽不亿。”"],["麴法","","1) 征酒税的法律。\n2) 酿酒制曲的方法。"],["麻林","","成片长着的麻。常用以形容刀、枪之类密集众多。"],["黄案","","1) 尚书省的案卷、文书。\n2) 黄色盘案。"],["黄烟","","1) 黄色的烟尘、云雾。\n2) 旱烟；烟丝。"],["鼓延","","两个传说中的人物。相传为炎帝之孙伯陵的儿子。"],["鼓纛","","战鼓与大旗。古时皇帝册封少数民族首领的信物。"],["齻牙","","智牙。牙床末端最后长出的两对臼齿。旧称真牙。"],["龙禁","","1) 指皇帝所居之禁中。\n2) 旧时忌日名。"],["龙盐","","药名。传说乃龙精液生成。又称吉吊脂、紫稍花。"],["龟王","","1) 传说中指龟中之王。\n2) 见“龟主”。"],["傣剧","","傣族戏曲剧种之一，流行于云南傣族聚居的地区。"],["甜密","","形容感到幸福、愉快、舒适：孩子们笑得那么～。"],["透墒","","土壤中所含的水分足够农作物出苗或生长的需要。"],["洗盐","","用淡水淹灌盐碱地，淋洗耕层中过多盐分的措施。"],["锱珠","","（zīzhū）指很少的钱或很小的事：～必较。"],["亨祚","","to prosper\nto flourish"],["峒剧","","variant of 侗剧[Dòng jù]"],["幼马","","young horse\ncolt\nfilly"],["彭县","","Peng county in Sichuan"],["彷似","","variant of 仿似[fǎng sì]"],["懮虑","","(feel) anxiety\nconcern"],["搬请","","to request\nto call for"],["有局","","vulnerable (in bridge)"],["树栖","","arboreal\ntree-dwelling"],["渺运","","faraway\ndistant\nremote"],["秃瓢","","bald head (colloquial)"],["筼筜","","species of tall bamboo"],["筹出","","to plan out\nto prepare"],["兴荣","","to flourish\nto prosper"],["色友","","photography enthusiast"],["鄞县","","Yin county in Zhejiang"],["锦县","","Jin county in Liaoning"],["开皌","","to receive condolences"],["页底","","the bottom of the page"],["预配","","pre-allocated\nprewired"],["鱆鱼","","variant of 章鱼, octopus"],["鹞鲼","","bonnet skate (zoology)"],["三境","","唐代诗歌的三种境界。 即物境、 情境与意境。"],["共衾","","共盖一床棉被。 比喻同床而眠。\n[反] 独宿"],["劈兰","","朋友间互相凑钱聚餐的游戏。 亦称为“撇兰”。"],["南横","","南部横贯公路的缩称。 见“南部横贯公路”条。"],["吊宴","","丧家为答谢吊祭者而准备的