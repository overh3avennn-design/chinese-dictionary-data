"亡辜","","无罪。亦指没有罪的人。"],["交聘","","两国互相遣使通好往来。"],["亨路","","坦途。多指顺利的境遇。"],["享赐","","谓宴飨宾客，赏赐臣下。"],["亭驿","","古代供旅客歇宿的处所。"],["亮拔","","谓明达事理，才能出众。"],["什九","","十分之九。指绝大多数。"],["仆废","","谓失意潦倒，不为世用。"],["他适","","指女子另嫁他人，改嫁。"],["仙主","","仙家主人或主管仙境者。"],["仙吏","","仙界、天庭的职事人员。"],["仙旌","","指高官出行时用的旌旗。"],["仙秩","","仙官。秩，俸禄或品级。"],["仙穴","","传说有仙人遗迹的山洞。"],["仙舆","","指御辇，皇家用的车驾。"],["仙龛","","供陈灵牌、神像的小室。"],["令箴","","指帝王规戒臣下的诏令。"],["仰哺","","谓依靠他人哺养、供养。"],["仰属","","仰望，敬仰。属，注目。"],["仲忽","","相传周代“八士”之一。"],["仲起","","相传伏羲氏的六佐之一。"],["任信","","信任。相信而敢于托付。"],["企咏","","谓以吟咏寄托向往之情。"],["企附","","因景仰前人而附会其事。"],["伍侯","","谓编民为伍，相为侯望。"],["伍旋","","方言。谓动作缓慢迟钝。"],["伎船","","以歌舞色相为业的游船。"],["伏利","","尚未开发的物资、财源。"],["伭冥","","玄冥。雨师。一说水神。"],["伯忽","","蒙古语称鹿为“伯忽”。"],["伯昌","","即周文王。姓姬，名昌。"],["伯讨","","谓方伯讨伐有罪的诸侯。"],["伸歇","","方言。谓舒展肢体休息。"],["但割","","谓袒露上身，宰割牲畜。"],["但马","","古代仪仗队中备用的马。"],["佐享","","犹配享。谓陪同受祭祀。"],["佗乡","","他乡，家乡以外的地方。"],["佚道","","逸道，使百姓安乐之道。"],["佛婆","","指尼姑庵中的老年女仆。"],["佛扃","","佛寺的门户。借指佛寺。"],["佛火","","指供佛的油灯香烛之火。"],["佛钵","","相传为佛陀所用的食钵。"],["佛记","","佛的悬记，即佛的预言。"],["作健","","成为强者。谓奋发称雄。"],["作兵","","指担任维修任务的士兵。"],["作裙","","劳作时用于防护的围裙。"],["佹异","","奇异，与平常的不一样。"],["侍射","","谓举行射礼时在旁侍候。"],["侑斝","","侑觞，劝酒。斝，酒器。"],["侑柬","","礼单。亦借指酬赠礼品。"],["侔状","","描摹物状，指摹写景物。"],["侮诮","","以轻慢的态度加以讥嘲。"],["便孽","","指擅长谄媚进谗的佞人。"],["促辔","","谓拉紧缰绳，催马速行。"],["促音","","因发音急促而成的合音。"],["俄俄","","庄严貌。俄，通“峨”。"],["俊侣","","才智杰出的同伴、朋友。"],["俚柔","","南诏语“百姓”的音译。"],["俯起","","身处卑屈的地位而奋起。"],["保奏","","向朝廷推荐人并予担保。"],["保强","","恃势逞强，谓不服管辖。"],["保界","","谓守河山之险以为疆界。"],["保终","","谓保全至终，安然无患。"],["信必","","谓诚实不欺，必定做到。"],["修剔","","修整，把不合用的剔除。"],["修塞","","谓修缮堤防，堵塞决口。"],["修忮","","谓心怀忌恨而进行报复。"],["修慎","","谓注重修养，处世谨慎。"],["修畅","","谓情操高尚，言行旷达。"],["倅廨","","州郡副职官员办公处所。"],["倅厅","","州郡副职官员办公处所。"]]