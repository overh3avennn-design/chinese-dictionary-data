[["绿琴","","绿绮琴之省称。泛指琴。"],["绸绸","","密集貌。绸，通“稠”。"],["绶花","","花名。蔓生如绶，故名。"],["绾组","","系结组绶。谓佩挂官印。"],["绮船","","画舫。装饰华丽的游船。"],["绵劣","","谓才能薄弱，智力低下。"],["绵痼","","谓疾病严重，久治不愈。"],["绵花","","即棉花。绵，通“棉”。"],["缄题","","信函的封题。亦指书信。"],["缗襁","","穿钱的绳子。引申为钱。"],["编韦","","编联竹简的皮条或绳子。"],["练饰","","琢磨修饰。多用于文辞。"],["缇紫","","犹朱紫。形容宫室华丽。"],["缒人","","用绳索吊人，使之上下。"],["縏袟","","泛指装针线等物的囊袋。"],["缟袂","","白衣。亦借喻白色花卉。"],["县跂","","悬挂于高处而令人仰慕。"],["缩蜷","","收缩而蜷曲。谓不舒畅。"],["缩鬯","","古代祭祀用的滤过的酒。"],["纵辔","","谓放开马缰，纵马奔驰。"],["总做","","犹纵使。总，通“纵”。"],["绩火","","夜间纺织时照明的灯火。"],["绩筐","","纺绩时用以盛纱缕的筐。"],["缪说","","胡诌，乱说。亦指谬论。"],["缪丑","","宋秦桧之谥。借指奸佞。"],["缋纯","","用有画纹的缯帛作镶边。"],["缴寝","","谓封还制命而停止其事。"],["繻券","","古代作通行证用的符帛。"],["继烛","","一支接一支地点燃蜡烛。"],["纂历","","亦作“纂历”。\n嗣位。"],["纂雕","","即蛊雕。传说中的兽名。"],["颣丝","","多节的丝。指丝之次者。"],["续刻","","继原书之后再刻印成书。"],["缠疾","","谓疾病缠身，久久不愈。"],["缨绶","","冠带与印绶。借指官位。"],["缨锁","","缨与锁。比喻束缚之物。"],["纤珪","","喻指美女细白如玉之手。"],["纤足","","指旧时妇女缠过的小脚。"],["缸砚","","用破酿酒缸片制成的砚。"],["罔措","","喻无所适从；不知所措。"],["罩罗","","泛指捕鱼或捕鸟的竹器。"],["罢垒","","停止构筑壁垒。犹休战。"],["罾缴","","矰缴。猎取飞鸟的射具。"],["罗胜","","古代饰物。用丝罗剪制。"],["羁辔","","马络头和马缰。喻控制。"],["羁途","","亦作“羇途”。\n旅途。"],["羊性","","谓无主见，跟着别人跑。"],["羊羧","","古时冉駹族的羊毛织品。"],["羡爱","","亦作“羡爱”。\n爱慕。"],["羡赢","","盈余。亦指赋税的盈余。"],["义孝","","谓为非亲属的死者服孝。"],["义象","","指《易经》的义理爻象。"],["羸形","","形体瘦弱；瘦弱的形体。"],["羸疢","","犹痼疾。久治不愈的病。"],["羹元","","不和五味之羹。喻质朴。"],["羽幢","","以鸟羽为饰的旌旗之属。"],["羽畎","","羽山之谷。以产翟着称。"],["习容","","谓练习举止，整饬仪表。"],["翔旝","","古代战争中发射的飞石。"],["翠瓜","","甜瓜的一种。皮色翠绿。"],["剪灯","","修剪灯芯。后常指夜谈。"],["翰纸","","笔和纸。借指文书典籍。"],["翘悚","","谓惶悚不安地等待盼望。"],["翻胎","","方言。翻身。比喻申冤。"],["老格","","指诗文书画的苍老风格。"],["老苏","","对宋文学家苏洵的尊称。"],["老赵","","方言。衔食哺雏的母鸟。"],["考贡","","考试生员以备充任贡生。"],["耆壮","","谓年事虽高而犹壮健者。"],["耍话","","方言。玩笑的话，假话。"],["耕穑","","耕种和收获。泛指农事。"],["耕筑","","耕地筑场。多泛指农事。"],["耧锄","","一种翻松土壤用的农具。"],["聒乱","","犹扰乱。亦指声音震耳。"],["聒帐","","谓通宵宴饮，管弦齐作。"],["圣讳","","旧指圣人或帝后的名字。"],["圣鼓","","传说中有神异事迹的鼓。"],["聘命","","指皇帝任用官吏的命令。"],["聱聱","","象声词。形容众声杂作。"],["声朔","","声教正朔。指帝王之治。"],["声乡","","犹声势。乡，通“响”。"],["声香","","馨香。比喻美好的名声。"],["耸企","","犹企望。耸，通“竦”。"],["耸慑","","犹耸惧。耸，通“悚”。"],["聩眊","","耳聋眼花。引申为昏聩。"],["职租","","宋代特称职分田的租赋。"],["听习","","听从熟悉情况者的意见。"],["听览","","听事览文。谓处理政务。"],["聋瞶","","耳聋眼瞎。喻愚昧无知。"],["肃服","","肃然服从。有安定之意。"],["肆言","","无所顾忌地说话；纵言。"],["肆迹","","放开脚步。谓到处游览。"],["肘行","","谓以肘前行，表示畏服。"],["肩排","","肩挨着肩。谓人多杂沓。"],["肫恻","","谓诚恳而富于同情之心。"],["肴胾","","鱼肉等比较丰盛的菜肴。"],["肸蝢","","即月氏，古代西域国名。"],["胄序","","古代贵族子弟就学之所。"],["背集","","方言。没有集市的日子。"],["胡妲","","汉代歌舞百戏中的女伎。"],["胡皴","","牛颔下松弛有皱纹的皮。"],["胤辞","","就原作加以引申的文词。"],["胸腋","","胸前与腋下。泛指胸部。"],["能绩","","以有才能而取得的治绩。"],["脂驾","","脂车。谓准备驾车出行。"],["脱械","","去掉刑具。谓免罪获释。"],["脱秤","","指因过秤而出现的损耗。"],["脱选","","谓选人脱离原有的官阶。"],["脱麻","","谓脱去粗衣，开始出仕。"],["脽上","","指汾阴脽。在今山西省。"],["腑肺","","泛指内脏。亦比喻内心。"],["腓辟","","古代削去膝盖骨的酷刑。"],["腥窍","","禽类的下窍(生殖腔)。"],["脑华","","道教称头发为“脑华”。"],["肿泄","","病名。腹泻及手足浮肿。"],["脚客","","行商，往来贩卖的商人。"],["脚店","","供人临时歇脚的小客店。"],["腴厚","","谓物产丰饶，风俗淳厚。"],["腹实","","腹中所有之物。指内脏。"],["腹尺","","腹的阔度。比喻食量大。"],["膏乳","","比喻甘美的果汁与山泉。"],["膏面","","以膏涂面，谓修饰面容。"],["膜呗","","边膜拜边歌颂佛的功德。"],["胶鳔","","鱼胶。用鱼鳔熬成的胶。"],["膻秽","","又臭又脏。谓肮脏丑恶。"],["胆当","","犹言胆略。谓能当大事。"],["臂缠","","妇女缠在手臂上的饰物。"],["臂肩","","臂与肩。比喻密切无间。"],["膑辟","","古代削去膝盖骨的酷刑。"],["脔肉","","犹言一块肉。谓其量少。"],["臧器","","谓隐藏器识，不露才能。"],["臧锢","","谓因收受贿赂而被监禁。"],["临质","","临场对射。谓临场比赛。"],["臬府","","即臬司。指肃政廉访使。"],["至罢","","极无能。罢，通“疲”。"],["至贼","","指对人危害最大的恶行。"],["至辨","","具有极高辨别能力的人。"],["致思","","谓集中心思于某一方面。"],["臷国","","古代神话传说中的国名。"],["台宪","","指御史台或御史台官员。"],["台敕","","朝廷发布的命令或指示。"],["举武","","举足；举步。武，步武。"],["举缩","","蜷曲不能伸。举，拘挛。"],["旧染","","谓往昔沾染的不良习气。"],["旧班","","从前的职位。班，位次。"],["舛文","","错误的字或错乱的文句。"],["舞天","","古代东方部族祭天之舞。"],["舞席","","舞蹈时用以铺地的席子。"],["舟杭","","同“舟航”。\n指船只。"],["艮头","","方言。谓朴实耿直之人。"],["良辅","","贤良的辅弼；好的助手。"],["芒锷","","犹锋芒。比喻人的锐气。"],["花拍","","乐曲正拍外的附加节拍。"],["花镊","","古代附缀于簪上的首饰。"],["苓通","","猪屎与马粪。比喻卑贱。"],["苛论","","过分严格的议论、品评。"],["苟辨","","犹诡辩。辨，通“辩”。"],["苫庐","","古代在亲丧中所居之室。"],["茅焦","","战国齐人，以敢谏见称。"],["茹黄","","古良犬名。亦泛指良犬。"],["草迷","","指婴儿出生时无啼哭声。"],["荒獐","","犹慌张。荒，通“慌”。"],["荒耗","","谓遭灾减产，民用空竭。"],["荼垒","","神荼、郁垒二神的并称。"],["菜肠","","食菜之肠，指肚子饥饿。"],["菟肩","","植物名。属葵类，可食。"],["华枯","","犹荣枯。喻盛衰，得失。"],["莱朱","","传说汤贤臣。又名仲虺。"],["萍身","","谓身若浮萍，行踪不定。"],["萛","","jiū\n草纠结在一起。"],["万喙","","众口。亦借指众人之言。"],["葑炉","","用葑田泥土制成的炉子。"],["荤膻","","指有辛味的菜与牛羊肉。"],["蒍敖","","春秋楚相孙叔敖的别称。"],["蒜气","","腋部发出的臭气，狐臭。"],["蒜颗","","亦作“蒜果”。\n蒜头。"],["蒩馆","","古代祭祀时盛草藉的筐。"],["蒲辇","","金代军队中的一种职称。"],["蒻席","","蒲蒻做的席，其质细柔。"],["席号","","以草席临时搭造的号房。"],["蓑翁","","穿蓑衣的老人。指渔翁。"],["莲井","","绘有荷菱等图形的藻井。"],["莲菂","","亦作“莲的”。\n莲实。"],["葱楚","","谓林木丛生，青翠茂密。"],["蔽美","","掩盖他人的美德、长处。"],["蕃表","","犹藩屏。蕃，通“藩”。"],["蕊简","","指道教经籍。又名蕊书。"],["蕊粉","","指妇女化妆用的额黄粉。"],["荡户","","恃湖塘水产为生的人家。"],["芜没","","谓掩没于荒草间；湮灭。"],["薄馔","","粗劣的饭食。多为谦辞。"],["薨夭","","指皇帝子女少年时死亡。"],["薨然","","犹哄然。形容人声嘈杂。"],["藜菽","","藜和菽。泛指粗粝之食。"],["藩储","","指太子之位。储，储君。"],["蘧宁","","蘧伯玉和甯武子的并称。"],["兰鹢","","船的美称。鹢，借指船。"],["虎侯","","边缘以虎皮为饰的箭靶。"],["虎殿","","汉未央宫白虎殿的简称。"],["虎螭","","虎与龙。比喻勇猛威武。"],["虎卫","","守卫王宫或国门的勇士。"],["虚颢","","白色的天空。颢，白貌。"],["虏尘","","指敌寇或叛乱者的侵扰。"],["虏子","","古蜀人对中原人的贬称。"],["亏蟾","","缺月。蟾，蟾蜍，指月。"],["虬床","","龙床。旧称皇帝的床榻。"],["虺蜓","","蜥蜴和壁虎。泛指虫豸。"],["蚊吟","","蚊子振翅所发出的声音。"],["蚋序","","犹言蚊类。多用作谦词。"],["蚋眦","","蚊虫的眼眶。极言其小。"],["蚌蠹","","即白蚁。蚌，通“蜂”。"],["蚍蝣","","蚍蜉和蜉蝣。极言其小。"],["蚙穷","","即蚰蜒，一种节肢动物。"],["蚤亡","","犹早死。蚤，通“早”。"],["蚤日","","犹早岁。蚤，通“早”。"],["蚤晏","","犹早晚。蚤，通“早”。"],["蚧搔","","即疥疮。蚧，通“疥”。"],["蚨缗","","犹钱贯。缗，穿钱的绳。"],["蛇伏","","像蛇一样身体贴地爬行。"],["蛇脐","","古注辇国所产的一种花。"],["蛖蜄","","亦作“蠬蜄”。\n贝类。"],["蛙虾","","青蛙与虾蟆。泛指蛙类。"],["蛟螈","","蛟龙与蝾螈。泛指水族。"],["蛟革","","鲨鱼皮。蛟，通“鲛”。"],["蛟鼋","","蛟龙与大鳖。泛指水族。"],["蛟鼍","","指水中凶猛的鳄类动物。"],["蜀才","","东晋时成汉范贤的自称。"],["蜀石","","产于蜀地的次于玉的石。"],["蜃贝","","贝壳的一种，可作饰物。"],["蜇花","","指海蜇腹下的众多的脚。"],["蜜殊","","宋苏轼对僧仲殊的戏称。"],["蜜饵","","用蜜和米面制成的糕饼。"],["蝝蚁","","蚁子。比喻轻贱微小者。"],["蝞道","","以姿色取悦于人的方法。"],["猬列","","猬毛竖列。形容多而密。"],["猬须","","如猬毛稠密张开的胡须。"],["虾公","","虾苗。状似蜈蚣，故名。"],["蝭蟧","","蝉之一种。一说即蟪蛄。"],["蜗战","","比喻为微小之利而争斗。"],["蜗醢","","用蚌蛤类的肉做成的酱。"],["融坚","","唐宇文融、韦坚的并称。"],["融泰","","东汉符融、郭泰的并称。"],["螐蠋","","亦作“乌蠋”。\n虫名。"],["螟立","","谓立为螟蛉子。犹过继。"],["螽螟","","蝗虫与螟虫。泛指虫灾。"],["螾衍","","即蚰蜒。一种节足动物。"],["蟊食","","比喻奸吏掠夺百姓财物。"],["蟜蟜","","勇武貌。蟜，通“矫”。"],["虫籀","","泛指难以辨认的古文字。"],["虫落","","传说中的一种奇民怪俗。"],["蟹蝼","","伛偻的借音。腰背弯曲。"],["蚁忱","","谦词。犹言微末的真诚。"],["蚁迭","","如蚁之累叠。比喻人多。"],["蠀螬","","即蛴螬。金龟子的幼虫。"],["蜡香","","蜡烛燃点时产生的气味。"],["蠢类","","愚蠢的一夥。指犯法者。"],["蠲贷","","谓免除租税，借放钱粮。"],["蚕攒","","如蚕之攒聚。比喻众多。"],["蚕穑","","蚕桑和耕种。泛指农活。"],["蚕箪","","养幼蚕用的糊纸小竹匾。"],["血羹","","用禽、畜的血做成的羹。"],["血胞","","本指胎儿。引申指婴孩。"],["行妨","","谓行为损害别人的利益。"],["行戮","","犹行刑。特指执行死刑。"],["行枚","","行阵衔枚。指征战之事。"],["行玺","","秦汉时皇帝印玺的一种。"],["行篆","","指带有篆书笔意的行书。"],["行镳","","行进的乘骑。镳，马衔。"],["衍蚓","","即蚯蚓。俗名“曲蟺”。"],["衒冒","","谓自炫干冒。谦敬之词。"],["街禁","","犹宵禁。夜间禁人行走。"],["衙斋","","衙门里供职官燕居之处。"],["卫蘧","","指春秋卫国大夫蘧伯玉。"],["卫鱼","","指春秋时卫国大夫史鱼。"],["冲泥","","谓踏泥而行，不避雨雪。"],["冲疲","","谓地当冲要，民情疲顽。"],["衡梠","","屋檐的横木。比喻微才。"],["衣桁","","犹衣架，挂衣服的横木。"],["衾帏","","被子和帐子。泛指卧具。"],["衿棍","","文人中的恶棍。指讼棍。"],["袁张","","晋袁山松和张莹的并称。"],["袖轴","","可藏在袖中的小巧画轴。"],["袢袄","","一种有衬里的对襟夹衣。"],["被参","","封建时代官员受到弹劾。"],["裁㧑","","犹指挥。㧑，通“麾”。"],["裛妆","","犹泪妆。裛，通“浥”。"],["补化","","蒙古语译音。牛的别名。"],["褅","","tì\n裹覆婴儿的小被。"],["复穾","","如洞穴一般幽深的屋子。"],["褊袒","","犹偏袒。解衣裸露一臂。"],["褊鹊","","即扁鹊。褊，通“扁”。"],["褒朔","","汉王褒、东方朔的并称。"],["褒述","","谓记述其功德予以表彰。"],["褓乳","","在襁褓中吮乳。指婴儿。"],["褫褐","","脱下粗布衣服。谓出仕。"],["襄钟","","春秋郑襄公宗庙内的钟。"],["襞染","","操纸染翰，谓作书绘画。"],["西嫁","","特指王昭君嫁匈奴故事。"],["西锦","","西方传来的彩色丝织物。"],["覂轨","","车子倾覆出轨。喻失败。"],["覆甑","","倒置的甑。喻环境闭塞。"],["覆短","","护短，掩盖缺点或错误。"],["规步","","行步端正。喻合乎法度。"],["亲嫌","","谓因亲属而徇私的嫌疑。"],["觑当","","照顾，照看。当，助词。"],["觉路","","佛教语。谓成佛的道路。"],["观身","","谓观察自身的道德修养。"],["角婢","","少婢。束发如角，故称。"],["角柶","","古礼器。角制，状如匙。"],["角簟","","细竹篾或白藤织成的席。"],["觚竹","","古国名。觚，通“孤”。"],["觠局","","蹲伏不伸，匐跧曲身貌。"],["解批","","解送犯人或货物的公文。"],["解榜","","唐宋时解试中式的榜文。"],["解比","","谓选送应举者参加大比。"],["解玺","","解下印玺。指退让帝位。"],["解籍","","旧指歌妓脱离乐籍从良。"],["解粽","","剥食粽子。亦借指端午。"],["解辩","","对受到的指责加以解释。"],["觥觞","","泛指酒器。引申为酬酢。"],["觞斝","","酒器。斝，古代温酒器。"],["觞窦","","谓仅能泛起酒杯的小渎。"],["触锋","","触犯锋刃。谓亲临战斗。"],["言诰","","据君王言辞写成的文告。"],["言象","","指在言词上留下的迹象。"],["订述","","谓订正旧闻，编写成书。"],["计左","","谓计虑不当，无助于事。"],["讯函","","犹信函。讯，通“信”。"],["讯据","","指审讯笔录和人证物证。"],["讨类","","谓属于应该讨伐的一类。"],["训型","","谓作为典范以教育他人。"],["讪谲","","形容诡秘而嘲弄的神情。"],["讫讫","","崇高貌。讫，通“仡”。"],["托便","","谓趁他人之便请求帮忙。"],["托伪","","谓依托非正统的统治者。"],["托幽","","谓寄身于深邃幽隐之境。"],["托慕","","谓寄托仰慕、向往之情。"],["托铎","","鲜卑语。非神非人之谓。"],["记史","","指职掌章表书牍的吏员。"],["讷直","","谓言语迟钝，品格正直。"],["设纚","","用帛为行冠礼的人束发。"],["许张","","唐代许远、张巡的并称。"],["许郭","","东汉许劭、郭太的并称。"],["许鄙","","古代传说中的善相马者。"],["诃辱","","大声斥责，使觉得羞耻。"],["注赞","","关于言行的说明和赞语。"],["訾讆","","谓诋毁贤者而赞誉恶者。"],["诈注","","谓登记户口时弄虚作假。"],["诏囚","","奉皇帝命令拘禁的囚犯。"],["诐憸","","指谄佞奸邪的世俗之论。"],["询闻","","闻讯。询，用同“讯”。"],["诣入","","造诣，达到的艺术境界。"],["试铨","","谓经过考试；量才授官。"],["诗梦","","如诗一般的梦境，美梦。"],["诗源","","喻关于诗的理论、主张。"],["诗祖","","诗的某一流派的创始人。"],["诗舌","","吟诗之口。舌，借指口。"],["诗运","","犹诗风。指诗歌的风骨。"],["诟租","","谓骂骂咧咧地催交租税。"],["诡祠","","淫祠，祭祀邪神的祠庙。"],["诡越","","谓行事怪诞，超越常理。"],["诠第","","犹诠次。诠，通“铨”。"],["诠除","","犹诠授。诠，通“铨”。"],["诘蹶","","犹竭蹶。形容境况窘迫。"],["该该","","喜笑貌。该，通“咳”。"],["诓赚","","谓以甜言蜜语进行诈骗。"],["认族","","谓同姓不宗而认成同族。"],["认旧","","仍旧。认，用同“仍”。"],["认处","","指可供辨认之处，特征。"],["认赃","","承认偷来或骗来的赃物。"],["诱伏","","引诱敌人进入伏击地区。"],["诚必","","谓遵守信用，说到做到。"],["诚正","","谓心意真诚，思想端正。"],["诬执","","谓捏造罪名，加以陷害。"],["诰令","","朝廷、君上发布的命令。"],["说喈","","比喻聒噪。皆，鸟鸣声。"],["说载","","把棺木从柩车上卸下来。"],["课舡","","官府运载税银用的船只。"],["调营","","调理营卫。营卫，精气。"],["调繁","","谓调任政务繁剧的州县。"],["调胹","","烹调食物。喻治理政事。"],["诿属","","委托嘱咐(代办事情)。"],["请吏","","请求为臣。谓愿意臣服。"],["请正","","请求指正。多用为敬辞。"],["诤子","","能直言劝谏父亲的儿子。"],["论执","","发表和坚持自己的意见。"],["谀史","","对人有溢美之辞的史传。"],["谐遂","","谓顺心遂意，事可成功。"],["谏函","","谏书的封函。借指谏书。"],["谕子","","官府的告示、谕告之类。"],["谘逊","","谓请求指教并表示逊谢。"],["谘酒","","谓敬酒。谘，通“资”。"],["诸率","","古代官名。太子的侍卫。"],["谖谖","","喧扰貌。谖，通“諠”。"],["谋章","","谓考虑文章的篇章结构。"],["谋维","","犹谋虑。维，通“惟”。"],["谋赞","","谓谋划大事，辅佐朝廷。"],["谒文","","文体的一种，类似祭文。"],["谜字","","指字谜中作为谜底的字。"],["謏能","","谓才能浅陋。用作谦词。"],["谦需","","犹谦弱。需，通“懦”。"],["讲帐","","讲经说法的座席的帷帐。"],["讲颂","","谓讲习学业，诵读诗书。"],["谢赏","","感谢上级或长辈的赏赐。"],["谣谶","","以谣谚形式表达的谶语。"],["谟言","","可奉为圭臬的谋略之言。"],["谪掾","","古代被贬谪流放的属官。"],["谨静","","谓安静自守，谨言慎行。"],["哗毁","","以虚夸言词毁谤以惊世。"],["证位","","谓参悟得道而证入仙界。"],["证讲","","谓参悟修炼，讲经说法。"],["讥揣","","谓猜度他人并加以讥评。"],["谭吐","","指说话时的措词和态度。"],["谱状","","记载族系及行状的书籍。"],["警乘","","警戒车乘；为车乘警卫。"],["警唱","","指报晓。警，通“惊”。"],["警门","","犹敲门。警，通“惊”。"],["议可","","谓天子认可所议之意见。"],["议蠲","","谓审议灾情，蠲免赋税。"],["护于","","汉时匈奴左贤王的改称。"],["护炕","","炕边两端用砖砌的护栏。"],["护箱","","装成套书画的特制箱子。"],["护叶","","书籍、簿册外面的包纸。"],["誉誉","","疑惑貌。誉，通“豫”。"],["读社","","朗读祭祀土地神的文章。"],["变例","","不符合常例的变通条例。"],["变省","","谓变革弊政，省察过错。"],["变衅","","发生变乱的事端或征兆。"],["谗幸","","因进谗言而得宠幸的人。"],["谗孽","","指好构陷诬害他人的人。"],["谗欺","","谓谗害同僚，欺罔君上。"],["让章","","指古代辞让官职的奏章。"],["讙然","","喜悦貌。讙，通“欢”。"],["谳文","","向上司申报的议刑之文。"],["谳论","","对案件加以评议和判决。"],["谷魅","","山间的鬼怪。比喻恶人。"],["豆凑","","旧时杭州人谓偶然相遇。"],["豆蔬","","用作副食品的豆和蔬菜。"],["竖笠","","吴地俗讳，以伞为竖笠。"],["丰和","","谓五谷丰熟，风调雨顺。"],["丰庸","","谓五谷丰熟，民食足用。"],["丰强","","谓丰满有力，气势雄强。"],["丰业","","谓事业宏大；衣食富足。"],["丰甘","","丰盛甘美(多指饮食)。"],["丰虚","","丰收与荒歉。偏指荒歉。"],["丰颀","","谓肌肤丰满，身材修长。"],["豤款","","诚恳貌。豤，通“恳”。"],["豨首","","即豕首。天名精的别名。"],["豪乱","","犹混乱。豪，通“秏”。"],["豪叫","","犹大叫。特指高声吟诵。"],["豪濮","","古代濠水和濮水的并称。"],["豪甿","","指地方上有钱有势的人。"],["豪丝","","犹丝毫。豪，通“毫”。"],["豪缣","","笔和纸。豪，通“毫”。"],["豫和","","唐代祭天神所奏乐曲名。"],["豳歌","","指《诗‧豳风‧七月》。"],["豳诗","","指《诗‧豳风‧七月》。"],["豳颂","","指《诗‧豳风‧七月》。"],["豻狱","","监狱。引申指狱讼之事。"],["貂茵","","用貂皮制成的坐卧垫褥。"],["貆猪","","豪猪的别名，俗称箭猪。"],["貊盘","","古代貊族装食物的盛器。"],["貙娄","","犹貙刘。娄，通“刘”。"],["貙牙","","比喻勇武贤能的辅佐者。"],["貙蒌","","犹貙刘。蒌，通“刘”。"],["貙狸","","貙虎和狐狸。泛指野兽。"],["貙镏","","犹貙刘。镏，通“刘”。"],["贝玑","","珠玑。珠生于贝，故称。"],["贝筵","","指宣讲佛经经义的讲席。"],["贞孤","","谓固守正道，特立独行。"],["贞安","","正安。指政治清明安定。"],["贞恬","","谓志行高洁，淡薄名利。"],["贞神","","正直的神明；贞洁的神。"],["贞至","","谓坚贞高尚的道德修养。"],["贞远","","清高淡远。谓远于荣利。"],["贞金","","贵重金属。多指金银等。"],["贞默","","端庄静默。谓不苟言笑。"],["负斗","","背着北斗。谓面向南方。"],["负箧","","谓携书游学。箧，书箱。"],["负赁","","谓受雇于人，为其负载。"],["负逋","","拖欠。亦指拖欠的钱财。"],["贡察","","举荐。亦指所举荐之士。"],["貤庆","","谓余福流衍并延及后世。"],["贫妾","","旧时女子对自己的谦称。"],["贩肆","","谓贩运货物，开店买卖。"],["贪瞋","","佛教语。谓贪欲与瞋恚。"],["贯利","","犹事利。指事功和利益。"],["责断","","薄责断狱。谓从轻处罚。"],["责笃","","犹责督。笃，通“督”。"],["责譬","","用责备的口气晓喻对方。"],["赀帛","","犹货帛。赀，通“资”。"],["赀租","","口赋和田赋。泛指赋税。"],["贰纪","","古礼中添饭加菜的规章。"],["贰体","","谓太子继承帝位的体制。"],["贵令","","谓出身高贵，材质美善。"],["贵系","","谓大家、高手的后继者。"],["贵厚","","谓地位尊贵、俸禄优厚。"],["贵私","","以私人占有为第一要义。"],["贵茂","","谓神旺气足，容色华贵。"],["贵选","","指朝廷重要官员的人选。"],["贬弃","","谓免去职位，弃置不用。"],["买情","","谓受人财物后为人求情。"],["买棹","","亦作“买櫂”。\n雇船。"],["买渡","","出钱以求在水道上通行。"],["买红","","买喜事用的红色丝织物。"],["买纵","","因接受贿赂而徇私纵放。"],["买补","","购买某物，来补足缺额。"],["贷放","","金融机构把钱借给客户。"],["贷离","","犹差别。贷，通“忒”。"],["贺序","","文体名。贺人升迁之文。"],["贺饯","","谓贺人赴任，置酒饯行。"],["贲帱","","宏大的覆盖物。喻皇恩。"],["贼汉","","男性贼人。亦用作詈词。"],["贼驴","","詈词。指奸恶愚笨的人。"],["赈粥","","旧时为灾民或贫民施粥。"],["宾婚","","谓招待宾客与举行婚礼。"],["宾老","","旧称学校里年长的教师。"],["宾臣","","谓以宾客之礼对待臣下。"],["赐冰","","谓盛暑时天子以冰赐臣。"],["赐墩","","朝见时赐坐。墩，坐具。"],["赐对","","帝王召见臣子对答问题。"],["赐邑","","天子或诸侯赐给的食邑。"],["赏揭","","赏格揭帖，悬赏的告示。"],["贤府","","古代对地方长官的尊称。"],["贤度","","敬称对方的器量，胸襟。"],["贤会","","贤惠。会，用同“惠”。"],["贤藩","","敬称藩镇或藩国的首领。"],["卖倒","","犹言卖定。请不可变更。"],["卖券","","出卖货物时留下的凭证。"],["卖租","","谓出卖收取地租的权利。"],["卖贼","","谓接受贿赂，放走敌人。"],["贱丐","","乞丐。以其低贱，故称。"],["贱坯","","詈词。孬种；下贱坯子。"],["贱虫","","卑贱的虫豸。用作詈词。"],["赋畀","","给予。特指天赋的权利。"],["赕賨","","指南方地区贡赋的钱财。"],["赕钱","","指南方少数民族的钱财。"],["质桓","","东汉质帝、桓帝的并称。"],["赌跳","","以跳跃的高低比赛胜负。"],["赖好","","方言。好歹；无论如何。"],["赗赐","","因助办丧事而赐予财物。"],["赗赠","","因助办丧事而赠送财物。"],["剩味","","谓在正供之外增益供品。"],["剩义","","指片段不成系统的余义。"],["赙施","","为助人治丧而施与财物。"],["赙马","","赠与丧家治办丧事的马。"],["赛口","","谓报答说合姻缘的功劳。"],["贽文","","求见人时所呈送的文章。"],["赘疽","","赘瘤痈疽。喻多余无用。"],["赘调","","谓集聚征调丁壮供役使。"],["赘贰","","身任副职者的自谦之词。"],["赠玉","","谓落葬时将玉埋入墓穴。"],["赠赗","","赠送车马等以助人送葬。"],["赠馈","","赠送。亦指赠送的财物。"],["赡缛","","形容诗文词采丰丽繁密。"],["赡辨","","犹雄辩。辨，通“辩”。"],["赡速","","谓语汇丰富，文思敏捷。"],["赢博","","春秋时齐国的两个邑名。"],["赢朒","","犹言赢缩，赢余与不足。"],["赢虚","","充实和空虚。犹言虚实。"],["赃械","","指盗贼用来作案的器械。"],["赎取","","用钱物或其他代价换取。"],["赎国","","谓付出代价，拯救国家。"],["赤冀","","古代传说中臼的发明者。"],["赤岭","","山名。在今青海西宁西。"],["赤晴","","指没有一点云翳的晴空。"],["赤兽","","指兽炭，一种兽形的炭。"],["赤豹","","毛赤而有黑色斑纹的豹。"],["赤轩","","古代帝王殿堂前的平台。"],["赤钟","","相传黄帝所作五钟之一。"],["赪肩","","肩头因负担重物而发红。"],["走野","","指搞不正当的男女关系。"],["趁笔","","谓不假思索地随意书写。"],["趁体","","犹合身。趁，通“称”。"],["超物","","谓离尘脱俗，超然物外。"],["超阔","","指才气过人，胸襟开阔。"],["越局","","谓超越自己职掌的部分。"],["越翳","","即伯益。佐禹治水有功。"],["越豨","","汉代彭越和陈豨的并称。"],["越貊","","古代对南方土著的蔑称。"],["赶络","","连续不断地驱使、逼迫。"],["赵书","","指元赵孟頫的书法作品。"],["赵面","","赵(赵孟頫)字的外貌。"],["趋朝","","亦作“趍朝”。\n上朝。"],["趫揵","","指矫健而善于攀高的人。"],["趴蛋","","方言。躺倒；不能动弹。"],["跂耸","","踮脚举首。喻敬仰向往。"],["跋识","","跋文、印记、题署之类。"],["跌钱","","掷钱以卜吉凶、赌输赢。"],["跐踦","","参差不齐。意谓不配对。"],["跛立","","站立时重心偏在一足上。"],["跨缝","","指袍子下身两侧的开叉。"],["跨边","","谓兼有边境两方的籍贯。"],["跪灵","","跪伏在灵位或灵柩前面。"],["跲疐","","倾跌。引申为颠沛困顿。"],["跳蹼","","跳扑。蹼，用同“扑”。"],["踏冻","","踏着冰冻。谓冒着严寒。"],["踏圆","","亦作“蹋圆”。\n踏球。"],["踏硬","","谓用脚踩踏硬弩而发箭。"],["踏莎","","《踏莎行》词牌的省称。"],["踝体","","裸体。踝，用同“裸”。"],["踧口","","犹合口。踧，通“蹙”。"],["踩捕","","亦作“跴捕”。\n追捕。"],["踊溢","","亦作“踊溢”。\n腾跃。"],["踊甓","","亦作“踊甓”。\n指塔。"],["踊发","","亦作“踊发”。\n迸发。"],["踊距","","亦作“踊距”。\n跳跃。"],["踊跳","","亦作“踊跳”。\n跳跃。"],["踹蹬","","谓脚向脚底的方向用力。"],["蹈拾","","谓蹈袭前人，拾人牙慧。"],["蹝马","","戏曲中的跃马扬鞭动作。"],["蹩拉","","形容走路扭晃，不方便。"],["蹴几","","触机。谓以巧遇而得之。"],["躁盛","","指脉搏的跳动疾速有力。"],["跃炉","","喻自以为能，急于求用。"],["躖","","duàn\n践处，足迹。"],["躝跞","","践踏辗压。喻欺压伤害。"],["躟躟","","纷乱貌。躟，通“攘”。"],["蹑冻","","踏着未融化的冰雪行路。"],["蹑潜","","谓行动隐秘，不露踪迹。"],["轨官","","古时主掌会计事宜的官。"],["军产","","充军流放者留下的产业。"],["军笳","","古代塞北军用的管乐器。"],["轩世","","指上古黄帝轩辕氏之世。"],["轩孙","","黄帝轩辕氏的子孙后代。"],["软战","","没配头盔、铠甲的战袍。"],["软障","","即幛子。古代用作画轴。"],["载牲","","谓陈设牺牲，准备祭祀。"],["辅颊","","上颔与面颊。泛指面颊。"],["轻垢","","佛教语。指犯轻戒之罪。"],["辍辍","","忧郁貌。辍，通“惙”。"],["輠脂","","古代车上润滑用的脂膏。"],["輣轧","","象声词。形容水声宏大。"],["辊辊","","犹混混。形容苟且混世。"],["轮索","","挂攀在塔顶四周的铁链。"],["轮补","","谓候补官员依次序补缺。"],["轮軿","","车轮和车帷。代称车辆。"],["舆棺","","谓载棺以随，以示决死。"],["舆童","","犹舆隶。泛指操贱役者。"],["轈车","","古代军中窥敌的了望车。"],["转轼","","回转车头。谓驾车回返。"],["转顾","","回过头看。喻时间短促。"],["转鬻","","谓另投别主，卖身为佣。"],["轰锽","","象声词。形容声音响亮。"],["辟置","","谓征聘人才，置为僚属。"],["辟质","","即辟积。辟，通“襞”。"],["辨变","","犹变换。辨，通“变”。"],["辩俊","","俊辩，雄辩，辩才出众。"],["辩敏","","谓能言善辩，才思敏捷。"],["辩丽","","指言辞或文辞华美绮丽。"],["辰夜","","犹晨夜。辰，通“晨”。"],["辰晷","","日月星之光。比喻天子。"],["辱举","","谓违背自然法则而行事。"],["农社","","古代农村中的互助组织。"],["迅动","","谓心性敏感，容易激动。"],["近署","","与帝王接触密切的官署。"]]