[["近血","","中医指先血后便的病症。"],["返葬","","谓死在外地者归葬故乡。"],["返袂","","用衣袖拭泪。形容哭泣。"],["返迷","","谓迷途知返，改邪归正。"],["迦楠","","即伽南香。沉香的别名。"],["迫戚","","困厄貌。戚，通“蹙”。"],["述咏","","谓以诗歌形式叙述事理。"],["迷浊","","指不明佛道的凡俗之人。"],["迷烟","","指迷漫的烟雾，迷茫如烟"],["迸兵","","犹合兵。迸，通“并”。"],["迸气","","犹屏气。迸，通“屏”。"],["迸走","","犹逃跑。迸，通“屏”。"],["迸集","","指汇集。迸，通“并”。"],["追削","","谓追究前愆而削夺官职。"],["追媲","","和前代的人或事物比美。"],["追计","","盘算思索以往的人或事。"],["退智","","谓隐藏才智，不露锋芒。"],["退槽","","方言。谓家畜进食减少。"],["退磨","","方言。擦拭脏污使消退。"],["退衙","","旧指官吏公毕退出衙署。"],["退静","","退让静默。谓不谋进用。"],["送钩","","犹藏钩。古代一种游戏。"],["逃奸","","指逃人与奸情两种案件。"],["逆笔","","形反而神同的一种笔法。"],["逋累","","指积欠的赋税、债务等。"],["透髓","","犹透骨。形容程度极深。"],["逐罢","","旧时谓官员被免职斥逐。"],["逐靡","","谓追逐围观而表示倾倒。"],["途迍","","道途困顿。喻处境困窘。"],["逖闻","","在远处听到。表示恭敬。"],["通厉","","犹登临。厉，通“历”。"],["通堙","","开浚堵塞的水道使通畅。"],["通微","","通晓、洞察细微的事物。"],["通索","","没有结头的整条长索链。"],["逞艳","","犹争艳。炫耀色彩艳丽。"],["速宾","","主人亲自登门邀请宾客。"],["速锐","","谓士卒精锐而行动快速。"],["连塍","","田埂相连。谓田地成片。"],["连榱","","邻居或同处。榱，屋椽。"],["连榻","","并榻。多形容关系密切。"],["连白","","连缀白羽为鱼网的标记。"],["连策","","谓骑马并行。策，马鞭。"],["逮累","","犹逮捕。累，通“缧”。"],["逮亲","","谓双亲在世而得以孝养。"],["进涉","","犹言登山涉水。指出游。"],["进玺","","谓进奉皇帝专用的玉玺。"],["进筑","","谓军队推进并构筑工事。"],["进辇","","谓推车近前请尊者上车。"],["进飨","","谓用酒食招待以资鼓励。"],["逸僧","","游方僧。云游四方之僧。"],["逸力","","经过休养而充实的力气。"],["逸政","","使人民安居乐业的政治。"],["逸欲","","谓贪图安逸，嗜欲无节。"],["逸发","","谓神情超逸而容光焕发。"],["逸肥","","谓军务安闲而供给富饶。"],["逼禅","","谓强迫帝王让位给别人。"],["逾笄","","谓女子年龄超过十五岁。"],["遁音","","犹言销声匿迹。指隐居。"],["遇变","","谓碰到突然发生的事故。"],["游晷","","移动的日影。借指时光。"],["运纲","","指成批运送货物的组织。"],["过套","","作为例行公事而走过场。"],["过笋","","越出竹林范围生长的笋。"],["过驳","","把甲船货物搬卸至乙船。"],["遏猪","","谓水受阻塞而停聚为泽。"],["遐游","","亦作“遐游”。\n远游。"],["道荫","","庇覆之大恩。道，敬词。"],["道范","","敬称他人的容颜，风范。"],["达听","","谓广泛听取，了解下情。"],["违署","","离开官署。谓辞去官职。"],["违阔","","书信用语。离别；阔别。"],["遘结","","犹缔结。遘，通“构”。"],["遥艳","","犹妖艳。遥，通“姚”。"],["逊政","","谓把国家政权让给别人。"],["远土","","远国异土。指边远地方。"],["远胡","","指西北边地的少数民族。"],["遭命","","指行善而遭凶的坏命运。"],["遮堂","","指堂屋内后半间的屏门。"],["遳子","","方言。指身材短小的人。"],["遴爱","","犹吝啬。遴，通“吝”。"],["迁格","","提升官职的标准或规定。"],["迁歆","","汉司马迁和刘歆的并称。"],["迁满","","指旧时官员之秩满迁升。"],["迁雄","","汉司马迁和扬雄的并称。"],["选兵","","挑选出来的兵卒；精兵。"],["选卒","","挑选出来的兵卒，精兵。"],["选命","","经过铨选对官吏的任命。"],["遗偏","","遗漏和偏侧。谓未遍及。"],["遗债","","积欠；前人遗留的债务。"],["遗惜","","谓因吝惜而遗漏未遍及。"],["遗庆","","余庆；泽及后人的余福。"],["遗曲","","指前代遗留下来的乐曲。"],["遗植","","指后来继续栽种的植物。"],["遗燎","","指遗漏而未被焚烧之处。"],["遗牍","","指前人遗留下来的信件。"],["遗盟","","指死者生前订立的盟约。"],["遗砮","","指年代久远的石制箭镞。"],["遗碑","","指前代遗留之碑；古碑。"],["遗话","","指前代留传到后世的话。"],["遗讴","","指古代留传下来的歌曲。"],["遗雏","","指失去亲鸟保护的雏鸟。"],["遗魄","","旧谓人死后遗存的魂魄。"],["避仕","","谓避而不仕；不从征召。"],["避弟","","谓兄避位而使辟召其弟。"],["避招","","谓逃避征召，隐居不仕。"],["避案","","指罪犯作案后逃避追究。"],["邀速","","谓谋求举荐，快速出仕。"],["邀饰","","谓迎合别人，求得奖饰。"],["还名","","除名之后重新纳入名册。"],["迩志","","谓目光短浅，胸无大志。"],["边业","","指睦邻友好的外交事业。"],["边蛮","","指边远地区的少数民族。"],["边议","","守边防敌的意见、谋策。"],["邋级","","犹躐等。邋，通“躐”。"],["逻络","","比喻巡防严密犹如罗网。"],["邗关","","亦作“邘关”。\n邗城。"],["邛邮","","指古代蜀郡邛地的邮置。"],["邢疏","","宋代邢昺所作经书之疏。"],["邦诬","","谓诬罔君臣，歪曲事实。"],["邪叟","","古代若邪山谷间的老人。"],["邪津","","佛教语。指邪见之所在。"],["邴魏","","汉相邴吉和魏相的并称。"],["邸兵","","王侯府第内的警卫兵卒。"],["郊拜","","帝王郊祭敬拜上帝神只。"],["郊牺","","天子祭天地所用的牺牲。"],["郊舍","","谓宿于城郊。表示诚敬。"],["郊飨","","犹郊享。飨，通“享”。"],["郝蝉","","丹参的别名。即郤蝉草。"],["郡朝","","郡署的厅事。亦指郡守。"],["部守","","谓掌闭城门，负责守卫。"],["都抹","","方言。嘟起嘴巴不吭声。"],["鄂然","","吃惊貌。鄂，通“愕”。"],["乡丈","","对同乡老年男子的敬称。"],["乡相","","指同乡中官居相位的人。"],["乡迩","","谓接近。乡，通“向”。"],["乡面","","乡里，家乡。面，地面。"],["乡馔","","乡味，本地特有的食品。"],["鄙冗","","浅陋而芜杂。用指文辞。"],["鄙夭","","谓性情贪鄙，寿命不长。"],["鄙怀","","谦称自己的心愿，心意。"],["鄙争","","谓用不正当的手法争夺。"],["鄙谏","","谦称自己向对方的进言。"],["鄙谬","","鄙陋谬误。多用作谦辞。"],["鄣刀","","唐朝武库中的一种刀名。"],["鄹里","","孔子故里。详“鄹阙”。"],["酋党","","指伙同反叛的部落首领。"],["酌和","","谓择取其善，顺而行之。"],["酌海","","以蠡酌海。喻见识短浅。"],["酒战","","与人角饮，较酒量大小。"],["酒潮","","饮酒后脸上泛起的红晕。"],["酒道","","指有关酒和饮酒的事理。"],["酣酡","","像酒醉脸红一样的色泽。"],["酣饱","","指文笔酣畅，感情饱满。"],["醇郁","","纯正馥郁。喻上乘之作。"],["醇醴","","味厚的美酒；酒味甘美。"],["醉梦","","谓人糊里糊涂如醉如梦。"],["醉騃","","醉得神志麻木不清之貌。"],["醒绽","","方言。谓树木返青发芽。"],["丑族","","犹丑类。指坏人、恶人。"],["丑羯","","对北方部族羯族的蔑称。"],["丑谥","","具有贬义的谥号，恶谥。"],["醪纩","","酒和丝棉。喻饱暖之惠。"],["醮事","","道士所做斋醮祈祷之事。"],["醮器","","道士设坛祭祀用的法器。"],["醵率","","按规定的标准凑钱聚饮。"],["酿寒","","谓逐渐酿成寒冷的天气。"],["衅厩","","涂牲血于新修治的马厩。"],["采旄","","指用旄牛尾装饰的彩旗。"],["采綖","","彩色线。綖，同“线”。"],["释警","","解除警戒。谓安宁无事。"],["里儒","","旧指乡里间的知识分子。"],["重帛","","两件或两件以上的绸衣。"],["重旨","","指文中隐含的丰富意旨。"],["重晖","","谓前后相继的光辉业绩。"],["重氛","","种种凶恶气象。指灾祸。"],["重睛","","古代传说中的重瞳之鸟。"],["重誉","","声誉崇高；崇高的声誉。"],["重躯","","谓重视自己身体、生命。"],["重迟","","迟钝；迟缓；很不敏捷。"],["重饵","","贵重的食饵。比喻厚禄。"],["野壤","","郊野的土壤。特指土鼓。"],["野屐","","古人出游所穿的木底鞋。"],["野丝","","野蚕或其他昆虫吐的丝。"],["野言","","隐者之语；村野人的话。"],["金杵","","佛教传说中的降魔兵器。"],["金椟","","外面用金绳捆束的木柜。"],["金璇","","犹金玉。比喻牢固长久。"],["金练","","金甲组练。武士的甲衣。"],["金钺","","古代仪仗用的金色大斧。"],["金鞯","","华美的鞍垫。借指马匹。"],["金黛","","秀美的眉毛。借指美人。"],["釜鍑","","锅属炊器。鍑，大口锅。"],["釜鏂","","釜和鏂。皆古之量器名。"],["针纫","","亦作“针纫”。\n缝纫。"],["钓罩","","钓钩和竹笼。用以捕鱼。"],["钓耕","","渔人和农夫。泛指平民。"],["钗雀","","雀钗。有雀形饰物的钗。"],["钗鸾","","首端有鸾状镶饰物的钗。"],["钝眊","","谓精力衰颓，眼睛昏花。"],["钧解","","谓胜负不分，打成平局。"],["铃辕","","长官的公署或临时驻地。"],["铃镊","","缀有垂饰的风铃、鸾铃。"],["钜人","","伟人。指德才高超的人。"],["鉏钩","","锄头和镰刀。泛指农具。"],["银函","","封存道经或佛经的银匣。"],["银勒","","银饰的带嚼口的马络头。"],["银篝","","指银质的或银饰的熏笼。"],["银荒","","严重短缺硬通货币白银。"],["铜炙","","铜制的烤炙食物的炊具。"],["铜照","","铜镜。古代以青铜为镜。"],["铜界","","以铜柱作为标志的边界。"],["铜觜","","鹭鸶的别名。嘴硬而尖。"],["铜陌","","铜驼陌、铜驼街的简称。"],["铨法","","选拔、任用官吏的条例。"],["铨轴","","犹衡轴。比喻中枢要职。"],["铨限","","选授官职的等级、界限。"],["铢称","","谓极细致地衡量、推究。"],["铭词","","亦作“铭辞”。\n铭文。"],["衔揭","","署有官衔的名片、名帖。"],["锐居","","锐利，锋利。居，助词。"],["销复","","谓消除灾变，恢复正常。"],["销朽","","谓形销骨朽，泯灭无存。"],["销氛","","谓消除恶气，平定祸乱。"],["销膏","","指灯烛燃烧时耗费油膏。"],["鋐鋐","","象声词。形容声音宏大。"],["锋焰","","锋颖光焰; 锋芒气焰。"],["锋巨","","锋锷。借指刀剑等武器。"],["锋钲","","利剑和铜钲。借指战乱。"],["铓辉","","刀剑尖端、刃口的光辉。"],["录橐","","谓抄家，清点登记财产。"],["锥匕","","喻细小之物。匕，箭头。"],["铮鍧","","象声词。形容声音洪亮。"],["铮枪","","象声词。玉石等撞击声。"],["锭药","","制成锭子状的小块药物。"],["钱黥","","在面孔上黥刺钱形图纹。"],["錣策","","上端带有铁针的赶马杖。"],["锦凡","","锦帆。凡，用同“帆”。"],["锢籍","","谓废为庶人，居留原籍。"],["锢见","","犹成见。锢，通“固”。"],["错兵","","犹用兵。错，通“措”。"],["错守","","置守。一说，轮番守卫。"],["错躬","","犹置身。错，通“措”。"],["锻坊","","旧时的手工业打铁作坊。"],["钟气","","谓凝聚天地间灵秀之气。"],["钟笙","","乐钟声和相应和的笙乐。"],["镕调","","指立意炼句，调和韵律。"],["锁袱","","用鸟兽细毛制成的衣饰。"],["镐宴","","谓天下太平，君臣同乐。"],["锵鎯","","象声词。形容金属响声。"],["镜浦","","像镜子一样清澈的水面。"],["鐏俎","","樽俎。借指宴席，宴会。"],["钟彝","","指青铜礼器。彝，彝器。"],["镫火","","灯火。古代油灯的火头。"],["镯镂","","属镂。剑名。泛指宝剑。"],["铁什","","指古代车饰之铁制杂具。"],["铁帚","","铁扫帚。比喻人民力量。"],["铁摆","","契丹语的音译。犹嵩高。"],["铁限","","铁门限。借指大的铁棒。"],["铁鹿","","船上收放篷帆的铁辘轳。"],["铛旋","","即铛。一种古代的炊器。"],["铸客","","从事铸造业的工商业者。"],["鉴观","","亦作“鉴观”。\n察视。"],["鑢锤","","磋磨锤打。引申为治理。"],["炉櫜","","冶炉旁吹火令炽的风箱。"],["凿窒","","开通窒塞。谓心境舒畅。"],["长列","","十二支中“未”的别称。"],["长壬","","十二支中“酉”的别称。"],["长旓","","指旒饰下垂较长的旌旗。"],["长王","","十二支中“酉”的别称。"],["长蔬","","长期食蔬菜，不吃荤腥。"],["长蛾","","指妇女所画细长的眉毛。"],["长襦","","较长之短衣。襦，短衣。"],["门选","","根据门第高低选任官员。"],["闭修","","谓修明政治，自守其国。"],["闭壁","","关闭城门。谓只守不战。"],["闭肆","","谓关闭铺子，停止营业。"],["闭蓄","","谓埋藏于内心而不外露。"],["开嗣","","开拓，继承；为展延续。"],["开屯","","谓屯聚人员，开垦荒地。"],["开厅","","旧指在妓院中设席宴客。"],["开延","","谓开启贤路，延揽人才。"],["开忏","","谓开始诵经拜忏的活动。"],["开统","","谓开创世代相继的皇统。"],["闳俊","","谓气魄阔大，才气出众。"],["闳约","","谓内容丰富，言词简炼。"],["闲休","","指辞退工作。谓歇息去。"],["闲伺","","亦作“间伺”。\n窥测。"],["闲侦","","亦作“间侦”。\n刺探。"],["闲口","","亦作“闲口”。\n闲话。"],["闲执","","亦作“间执”。\n堵塞。"],["闲奥","","亦作“闲奥”。\n幽深。"],["闲毁","","亦作“间毁”。\n诽谤。"],["闲缺","","亦作“间缺”。\n空隙。"],["闲邑","","古代指未被封赐的土地。"],["闲错","","亦作“间错”。\n间杂。"],["闲阻","","亦作“间阻”。\n阻隔。"],["阁主","","寺院中专管佛阁的和尚。"],["阁标","","明督师大学士所辖军队。"],["阁诏","","搁置诏书。谓不奉诏命。"],["闺戒","","旧指妇女应遵守的戒条。"],["阅心","","谓各种情感交集于内心。"],["阅见","","逐一地看到。指经历过。"],["阉洁","","割除动物的睾丸或卵巢。"],["闱箔","","内室的门帘。借指妇女。"],["阑逸","","犹出格。谓言语没遮拦。"],["闿切","","恳切。闓，用同“剀”。"],["闯破","","突然进来碰见而被揭穿。"],["阱坑","","陷阱。比喻苦难的深渊。"],["防团","","防御使、团练使的并称。"],["防绝","","防止杜绝(坏事发生)。"],["阻乱","","谓武人拥兵或恃险作乱。"],["阻异","","谓意见不和，产生嫌隙。"],["阿夷","","古代獠族对妇女的称呼。"],["阿鹜","","三国魏荀攸之妾的小名。"],["陋固","","谓孤陋寡闻，浅见薄识。"],["陋诚","","愚诚，愚忠。自谦之词。"],["陌纸","","指纸钱。陌，通“佰”。"],["降乩","","谓扶乩时神灵降下旨意。"],["降死","","由死罪降免减等为徒刑。"],["降玺","","谓降敕褒奖，下诏勉励。"],["限米","","古代按规定应出的税米。"],["除孝","","指守孝期满后脱去丧服。"],["陬澨","","僻远处。犹言天涯海角。"],["阴基","","房基。因在地下，故称。"],["阴岸","","背阳的水岸。河的南岸。"],["阴微","","谓短浅的，说不出口的。"],["阴台","","在北郊的祭祀土神之台。"],["阴谐","","鸟名。一说虫名。即蝔。"],["陈戎","","部署军队，以兵戎相见。"],["陈雷","","东汉陈重和雷义的并称。"],["陵场","","陵墓周围的场地；陵园。"],["陵社","","陵庙与社稷。借指国家。"],["陵薮","","山陵和湖泽。泛指山野。"],["陵逾","","僭越，超出规定的范围。"],["陵陂","","山坡；地势较高的田地。"],["陵霞","","犹凌云。比喻超然物外。"],["陶物","","谓教化培育，使人成材。"],["陶远","","谓教化之泽，流传久远。"],["陆郎","","指南朝陈后主宠臣陆瑜。"],["阳榭","","高台；高大无室的厅堂。"],["阳霁","","谓日出雨止，天气放晴。"],["阳类","","迷信称属于阳间的物类。"],["隃墨","","隃麋产的墨。借指名墨。"],["隈蔚","","山势曲折，树木茂密貌。"],["隍陴","","城壕与女墙。借指城池。"],["阶檐","","台阶和屋檐。指进门处。"],["阶迎","","在阶前迎接，表示敬意。"],["陨丘","","传说中燧人氏四佐之一。"],["陨踬","","跌倒；崩塌。借指死亡。"],["隙蠹","","隙缝和蛀虫。比喻隐患。"],["障吝","","围堤占夺水面并加守护。"],["随璞","","指随侯之珠与和氏之璧。"],["险肤","","谓恶意中伤的谣传之言。"],["隐佯","","谓隐蔽真情，佯装不知。"],["隐忿","","心怀忿恨；心中的忿恨。"],["隐疵","","微小的不足之处；小过。"],["隶汉","","即汉隶。指汉代的隶书。"],["隼击","","比喻疾速而猛烈地攻击。"],["雄剧","","谓地位重要而事务繁重。"],["雄宕","","谓气魄宏伟，感情奔放。"],["雅奴","","丫环。雅，用同“丫”。"],["雅鬟","","丫鬟。雅，用同“丫”。"],["雉库","","雉门及库门。泛指宫阙。"],["隽蔚","","谓意味深长，富有文采。"],["雍畤","","古代祭五方天帝的祭坛。"],["雕目","","形容眼睛睁圆如雕之目。"],["虽马","","兽名。神话中的独角马。"],["双表","","华表。通常成对，故称。"],["雚蒲","","芦苇和蒲草。泛指水草。"],["杂奏","","谓俳优及歌舞交相融合。"],["杂污","","谓杂乱污秽，不合礼义。"],["杂耕","","谓屯田之兵与居民杂居。"],["雍培","","犹培育。雝，通“壅”。"],["鸡肤","","形容老年人发皱的皮肤。"],["离苑","","古代帝王离宫中的园林。"],["雩蜡","","年终祭神。亦泛指祭神。"],["雪履","","在雪地行走所穿的鞋子。"],["雪荠","","荠菜花开呈白色，故称。"],["雪藕","","嫩藕。嫩藕色白，故称。"],["雪赞","","亦作“雪赞”。\n咏雪。"],["云冻","","谓天气寒冷时阴云凝聚。"],["云岑","","云雾缭绕的山峰。高山。"],["云村","","云气笼罩的村落、山村。"],["云楶","","有云状纹饰的柱头斗栱。"],["云标","","云的顶端。比喻极高处。"],["云祥","","祥云。表示吉祥的云彩。"],["云箔","","云帘。天宫以云为帘幕。"],["云萃","","从四面八方聚集在一起。"],["云鸡","","传说中随仙道升天之鸡。"],["零烟","","指被烽火熏染后的残迹。"],["零铃","","词牌名。即《雨淋铃》。"],["雹神","","传说中指主管降雹的神。"],["电旆","","舒卷如闪电之光的旗帜。"],["电碓","","利用电力舂米谷的设备。"],["电釂","","闪电般地喝干杯中之酒。"],["需滞","","指授职后迟迟不能赴任。"],["霄明","","人名。相传为舜的女儿。"],["霄渊","","犹霄壤。比喻相去极远。"],["霄驾","","犹云车。仙人以云为车。"],["震筵","","帝王的坐席。借指朝廷。"],["霓袖","","彩袖。也借指歌伎舞女。"],["霜木","","指树身白色如霜的古木。"],["霜村","","指白色月光笼罩的山村。"],["霜标","","高雅贞洁的风度、品格。"],["霜禽","","霜鸟。指白鸥、白鹭等。"],["霜笛","","霜天笛声；凄怨的笛声。"],["霜脊","","刀剑的脊。亦借指刀剑。"],["霜角","","边寒地区戍卒吹的号角。"],["霜电","","霜和雷电。喻严正刚烈。"],["霞佩","","仙女的饰物。借指仙女。"],["霣祚","","殒寿，死亡。祚，年寿。"],["雾扃","","比喻深居，与外界隔绝。"],["雾氛","","亦作“雾雰”。\n雾气。"],["雾鬣","","浓密的鬣毛。亦借指马。"],["露会","","在晚上刚下露水时相会。"],["露泄","","亦作“露泄”。\n泄露。"],["霸相","","指能助君主称霸的相臣。"],["霸衿","","指地方上有权势的士绅。"],["灵兔","","指传说中月宫中的玉兔。"],["灵匮","","犹金匮。国家藏书之柜。"],["灵蚌","","即蚌。因能产珠，故称。"],["青刀","","形容尖长如刀的青蒲叶。"],["青吹","","风吹林木声。借指清风。"],["青坛","","帝王春日郊祭用的土台。"],["青幻","","谓其色青苍，其形奇幻。"],["青氐","","古代少数民族氐的一支。"],["青洲","","即青邱。传说中的仙洲。"],["青缴","","系在箭上的青色生丝绳。"],["青翳","","传说中翳鸟的彩色毛羽。"],["青薪","","刚砍伐下的树木、树枝。"],["青锡","","即锡。锡色青灰，故称。"],["青靠","","黑色的紧身窄袖武士服。"],["青鲂","","鱼。体呈银灰色，故称。"],["靛颔","","鸟名。颔下蓝色，故称。"],["静乱","","平定变乱；使安定宁静。"],["静晦","","静处韬晦。指隐退不仕。"],["非世","","谓诋毁世俗，讥刺世事。"],["靡倾","","随顺着向某一方面流动。"],["面佥","","(书画)封面上的题签。"],["革木","","古乐器名，鞀鼓与柷敔。"],["革听","","改变听闻。指提高名声。"],["靳巧","","谓保守技艺，不肯外传。"],["靳色","","犹吝色。舍不得的神情。"],["鞅郁","","犹抑郁。鞅，通“怏”。"],["鞋襻","","鞋帮上用以系扣的物件。"],["鞠恧","","谓弯着身子，低声下气。"],["鞬弭","","弓箭的代称。借指武器。"],["鞭叱","","鞭挞呵斥。引申为驱使。"],["鞭哨","","赶车时鸣鞭吆喝的声音。"],["鞭拊","","鞭杖。古代刑罚之一种。"],["鞮汗","","指古代北方的少数民族。"],["鞯勒","","鞍鞯与笼头。泛指马具。"],["鞯盖","","鞍鞯和车盖。借指车驾。"],["鞯辔","","鞍鞯和辔头。借指马具。"],["韧战","","坚决、持久不断的战斗。"],["韔弓","","谓弛弓弦将弓放入弓袋。"],["韬弦","","藏起弓箭。指息兵停战。"],["韬戈","","收藏兵器。引申指息兵。"],["韬旗","","收藏军旗。谓息兵罢战。"],["韬钥","","藏起管笛。指停止奏乐。"],["鞴扞","","古代射箭时用的皮臂套。"],["韶理","","谓持续不断地演习奏乐。"],["韵梅","","宋时对植物果实的雅称。"],["响拚","","击掌作声以示热烈响应。"],["响玉","","碰击时能发声响的玉石。"],["顶冕","","头戴冕旒。谓登上皇位。"],["顺桓","","汉顺帝、汉桓帝的并称。"],["顺欲","","顺从自己的心欲或意志。"],["顺泽","","谓顺合礼乐而富有文采。"],["顺祗","","指地神。祗，同“只”。"],["顺考","","谓考校古事，择善而行。"],["顺趋","","谓顺着地势而流赴某处。"],["顺阴","","谓顺随阴影；顺着暗处。"],["顺阳","","谓顺从阳气，顺应天道。"],["顺默","","谓顺从其势而沉默不语。"],["颂子","","偈颂。佛经中的唱颂词。"],["颂只","","用歌颂的方式祭祀地神。"],["颂论","","颂和论两种文体的并称。"],["顽提","","指童年。顽，通“玩”。"],["顿夺","","谓违反情理地强行断绝。"],["顿锡","","谓僧人住止。锡，锡杖。"],["领峤","","山峰。领，古“岭”字。"],["领干","","比喻起带头和支撑作用。"],["颉羌","","古时泛指少数民族首领。"],["颐朵","","犹朵颐。谓向往，羡馋。"],["头梢","","亦作“头稍”。\n头发。"],["头牲","","牲畜、家禽之类的俗称。"],["颓坌","","颓垣断壁上堆积的尘埃。"],["题旌","","题书表彰。多用于死者。"],["题亲","","犹提亲。题，通“提”。"],["题销","","谓上奏经皇帝批准报销。"],["题面","","谓寓藏文章旨意的标题。"],["颜法","","指唐颜真卿的书写技法。"],["颜题","","指古代头巾覆额面部分。"],["颛寝","","犹颛房。颛，通“专”。"],["颠旄","","指头发。旄，通“毛”。"],["顾券","","旧时指临时雇佣的工役。"],["顾姑","","蒙古贵族妇女所戴冠名。"],["显问","","谓明显之事而故意询问。"],["显魂","","迷信谓人死后灵魂出现。"],["风虚","","体内虚弱，而外感风邪。"],["风骊","","传说中疾驰如风的神马。"],["飒洒","","象声词。多用以状风声。"],["飞棋","","不拘常规的出奇的棋艺。"],["飞辩","","谓发挥口才，高谈阔论。"],["飞闼","","高楼上的门。借指高楼。"],["飞驲","","犹飞驿。策动驿马疾驰。"],["食重","","指装载粮食等的辎重车。"],["饥附","","比喻不得志时即来依附。"],["饪餗","","指鼎中煮熟的佳肴美味。"],["饭帚","","扫去灶上饭粒等的笤帚。"],["饭鼓","","寺院召僧尼进食之鼓声。"],["饮队","","犹醉倒。队，通“坠”。"],["饮香","","吸食香花。指蜂采花蜜。"],["饴散","","饴盐和散盐。亦泛指盐。"],["饰官","","犹治官。饰，通“饬”。"],["饰琢","","谓修饰加工语言、文字。"],["饰声","","谓修饰言辞，花言巧语。"],["饷生","","清代称纳资入监的生员。"],["养求","","谓欲望滋长并求得满足。"],["养非","","谓纵容错误，使之滋长。"],["余丧","","指父母以外的亲属之丧。"],["余尘","","后尘。比喻在他人之后。"],["余带","","衣带过长。指形体消瘦。"],["余拙","","谦词。无用的愚拙的人。"],["余敝","","过去留下来的劳顿疲敝。"],["余泉","","贝名。白地黄纹的贝甲。"],["余燎","","指边缘之火；未尽之火。"],["余犯","","首犯、主犯以外的犯人。"],["余睡","","谓刚醒后的未尽的睡意。"],["余耳","","秦末陈余、张耳的并称。"],["余萌","","指较一般晚发芽的草木。"],["余制","","指传留下来的诗文体制。"],["余辞","","指多余的、次要的文辞。"],["肴席","","以鱼、肉等做菜的酒席。"],["肴烝","","谓切肉为块，升之于俎。"],["馄屯","","亦作“餫屯”。\n馄饨。"],["饯路","","指外出前的赐予和饯行。"],["馆丈","","翰林前辈对后辈的称呼。"],["馆劳","","谓安置于馆舍而慰劳之。"],["餪生","","旧俗称生日前夕的宴饮。"],["饩客","","谓以肉食之类款待宾客。"],["饥耗","","谓年岁饥馑，存粮损耗。"],["饘酏","","厚粥和薄粥。亦泛指粥。"],["馋火","","比喻强烈的贪食的欲望。"],["首免","","谓揭发他人而免于连坐。"],["首戾","","犹首罪。指罪行最重者。"],["首逆","","旧指造反作乱的为首者。"],["香尉","","时人对汉雍仲子的戏称。"],["香岑","","对佛寺所在山丘的美称。"],["香弓","","弓足的美称。借指女子。"],["香署","","指京畿省台之类的官署。"],["香台","","烧香之台。佛殿的别称。"],["香轮","","香木作的车；车的美称。"],["马嵬","","地名。在陕西省兴平县。"],["马排","","用马力转动的鼓风器具。"],["马磨","","用马拉磨。谓辛苦劳作。"],["马讼","","有关马买卖引起的诉讼。"],["冯招","","指汉冯唐白首被招之事。"],["驮骡","","专门用来驮东西的骡子。"],["驯庭","","谓驯服地生活于庭院中。"],["驳选","","旧指黜免已入选的官员。"],["駏驴","","驴和马杂交所生的力畜。"],["驽弱","","谓才能低下，力量薄弱。"],["驹犊","","小马与小牛。泛指幼畜。"],["驵侠","","谓做事狡黠，带有侠气。"],["驵疾","","骏马疾驶。引申为敏捷。"],["驾曹","","驾部中分管厩牧的部门。"],["驷骊","","驾一车的四匹深黑色马。"],["骈门","","一户挨一户。形容人多。"],["骇奇","","亦作“駴奇”。\n惊奇。"],["骏壮","","犹强壮。骏，通“峻”。"],["骏骡","","善于奔走、负重的骡子。"],["骋迹","","往来自如; 纵横驰骋。"],["骑曹","","指骑曹参军一类的小官。"],["骞荡","","犹飘荡。骞，通“骞”。"],["腾谤","","谓肆意诽谤；大加指责。"],["骚学","","指关于《楚辞》的学问。"],["骚携","","谓忧愁愤懑，离心离德。"],["骖镳","","骖马的镳辔。泛指马具。"],["驱配","","指主人给驱口指定配偶。"],["骄空","","肆无忌惮地在空间飞舞。"],["骄騧","","壮健的騧马。泛指骏马。"],["骄骢","","壮健的骢马。泛指骏马。"],["验军","","指查验应征士兵的素质。"],["惊定","","谓受惊的心情安定下来。"],["惊敛","","禽鸟因受惊而收拢翅膀。"],["惊气","","因受惊吓而招致的气恼。"],["驿口","","驿站的口岸；水驿码头。"],["驿政","","指驿站传递信件的业务。"],["驿邮","","传递文书、信件的机构。"],["驩合","","指婚配。驩，通“欢”。"],["驩浃","","犹欢洽。驩，通“欢”。"],["驩然","","欢乐貌。驩，通“欢”。"],["驩燕","","犹欢宴。驩，通“欢”。"],["驩跃","","犹欢腾。驩，通“欢”。"],["骨路","","旧称修补铜铁器的工匠。"],["骫奊","","屈曲之状；头不正之貌。"],["骰钱","","旧时投掷给艺人的赏钱。"],["髇矢","","亦作“骹矢”。\n响箭。"],["高啄","","高耸似禽鸟在仰首啄物。"],["高影","","高处的水影，借指银河。"],["高濑","","从高处飞奔而下的急流。"],["高荐","","谓考试中式，名列前茅。"],["高虚","","谓徒拥高位而不干实事。"],["髡耏","","指剃发和去除颊鬓之刑。"],["髦髫","","犹老幼。髦，通“耄”。"],["髯狎","","即髯公。参见“髯公”。"],["髯丽","","即髯公。参见“髯公”。"],["髹帛","","涂上油漆的脱胎丝织像。"],["鬐刺","","鱼鳍硬骨顶端露出的刺。"],["鬓钗","","插戴于鬓髻的首饰钗子。"],["鬓云","","形容妇女鬓发美如乌云。"],["斗侃","","犹逗乐。斗，通“逗”。"],["斗拢","","方言。拼揍聚合在一起。"],["阄还","","用拈阄的方式偿还债务。"],["鬯达","","畅达。鬯，通，“畅”。"],["郁冈","","帖名。即《郁冈斋帖》。"],["郁栗","","犹郁律。曲折、起伏貌。"],["郁蹙","","犹郁桡。形容盘结皱摺。"],["鬲如","","上小下大貌。如，助词。"],["鬼岛","","旧指英人侵占下的香港。"],["鬼磷","","亦作“鬼磷”。\n磷火。"],["魂床","","在孝堂为亡魂虚设的床。"],["魂旦","","戏曲中扮演女鬼的角色。"],["魄渊","","指月亮。魄，通“霸”。"],["魏丙","","汉相魏相和丙吉的并称。"],["魇术","","魇昧之类的巫术、手段。"],["鱼坻","","可供钓鱼用的水中小洲。"],["鱼姊","","指年岁较大的渔家姑娘。"],["魱鮥","","即鲥鱼。也称鯦、当魱。"],["鲛工","","传说中织制鲛绡的鲛人。"],["鲠愤","","谓心中不平，充满义愤。"],["鲠讦","","直言不讳地揭发、指斥。"],["鲞腊","","腌制或风干的鱼肉食品。"],["鲞货","","干鱼，腌鱼；腌腊食品。"],["鲵鲐","","鲵齿和鲐背。长寿之征。"],["鲸鲟","","泛指大鱼。比喻大贤人。"],["鲰头","","方言。谓才智低劣的人。"],["鳇冰","","鳇鱼的软骨。脆软可食。"],["鳅虾","","泥鳅和虾。泛称小鱼鲜。"],["鳅鱽","","泥鳅和刀鱼。泛指小鱼。"],["鳅鮆","","鳅鱼和鮆鱼。泛指鱼类。"],["鳏官","","犹渎职。鳏，通“瘝”。"],["鳛鳛","","古代传说中的一种怪鱼。"],["鳞彩","","鳞片所折射的鲜艳光彩。"],["鳞皴","","像鳞片般的皲皮或裂痕。"],["鸟澜","","谓水鸟浮游于波澜之间。"],["鸟谭","","形容说话如鸟鸣，难懂。"],["鸠竹","","鸠车与竹马。小儿玩具。"],["凤传","","指帝王之家所乘的车马。"],["凤念","","珍贵的怀念。用作敬词。"],["凤毫","","毛笔的美称。借指功名。"],["凤绣","","绣有凤凰花饰的被子等。"],["凤语","","形容美妙的声音或乐曲。"],["凤迹","","仙人或贵人车乘的辙迹。"]]