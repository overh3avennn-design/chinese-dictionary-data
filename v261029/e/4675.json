[["羡卒","","古代正卒以外的兵卒。"],["义志","","符合道义准则的意志。"],["义粮","","旧时施舍贫民的粮食。"],["义赈","","对灾民或贫民的赈济。"],["羸尪","","瘦弱。亦指瘦弱之人。"],["羸败","","指(车马)破旧瘦弱。"],["羸殆","","形消骨立，接近死亡。"],["羸縢","","缠着绑腿布以利远行。"],["羸行","","谓隐藏身份改装而行。"],["羽钻","","同“翼赞”。\n帮助。"],["翔骞","","高飞。亦指远行之人。"],["翠旄","","杆顶饰以翠羽的旗帜。"],["翠蜡","","一种带有香气的蜡烛。"],["翠辇","","饰有翠羽的帝王车驾。"],["玩华","","谓讲究文辞华丽雕琢。"],["翳蔽","","幽深不明；隐蔽不露。"],["翻海","","形容声响如海涛翻腾。"],["翻盏","","形容马蹄腾疾的样子。"],["翻竞","","谓竞相翻新。含贬义。"],["老欧","","指宋代文学家欧阳修。"],["考省","","考校省察；考校查核。"],["耄皤","","老而头白。泛指高龄。"],["者别","","蒙古语“箭”的音译。"],["耆昧","","致昧，使之至于昏乱。"],["耆率","","老将。率，通“帅”。"],["耐静","","安于清静，忍受寂寞。"],["端启","","书信常用语。犹专函。"],["耿烈","","正直刚烈；光明炽热。"],["圣裁","","犹圣断。皇上的裁断。"],["聘弓","","古代聘问时持用之弓。"],["闻家","","显达、有名望的家族。"],["闻义","","谓听到合乎义理的事。"],["联职","","犹同事。谓职务相连。"],["联蝉","","连续。多指连任官职。"],["声党","","唐宋时称擅长歌唱者。"],["耸异","","惊奇。耸，通“悚”。"],["耸目","","动人眼目；耸动眼目。"],["职吏","","旧指地位低下的官吏。"],["职孤","","主持抚养孤儿的职官。"],["职币","","古官名。掌官用余财。"],["职岁","","古官名。掌邦赋支出。"],["职素","","指原来的身分和职务。"],["职规","","关于职务的规章制度。"],["听纳","","听从采纳；听谏纳善。"],["肃如","","犹肃然。恭敬整饬貌。"],["肆手","","放手。谓随意，任意。"],["肆逆","","横行不法，背叛作乱。"],["肉燎","","犹心焦。谓焦急难过。"],["肉称","","谓轮辐两端粗细适宜。"],["肉腥","","指鱼肉等类荤腥食物。"],["肓膜","","五脏之间的薄膜组织。"],["肥仙","","北宋诗人张耒的别称。"],["肩比","","肩并着肩。形容人多。"],["肩迫","","两肩相并。形容亲密。"],["背场","","方言。犹场外；私下。"],["背诞","","违命放诞，不受节制。"],["胎卵","","胎生与卵生。指鸟兽。"],["胞厨","","厨房。胞，通“庖”。"],["胡敲","","一种玩具。形似扯铃。"],["胡髯","","颊旁及下巴上的胡须。"],["胥原","","伍子胥与屈原的并称。"],["胥产","","伍子胥与子产的并称。"],["能称","","谓因有才干而被称誉。"],["能贤","","有才能而又有道德者。"],["胁衣","","女人的内衣。或称袜。"],["脊偻","","脊背向前弯曲；驼背。"],["脞说","","琐碎鄙俗的言谈议论。"],["修薄","","指长长的丛生的草木。"],["脱活","","指制作脱胎品的手艺。"],["脱清","","犹开脱。使脱离干系。"],["腄腄","","谓肌肤发硬和瘢胝状。"],["腋翅","","腋下生翅，意犹飞身。"],["腐剿","","辗转抄袭，毫无新意。"],["腐饭","","谦辞。谓很差的饭食。"],["腒雉","","晒干的雉和新鲜的雉。"],["脑脂","","中医病名。指白内障。"],["脑头","","犹头脑。指思维能力。"],["腰厅","","旧式房屋中间的厅屋。"],["腰襻","","指腰间系衣裙的带子。"],["腴产","","肥美的产业。指腴田。"],["腴表","","指最肥沃富庶的土地。"],["腹咏","","内心歌咏，表示喜悦。"],["膏晷","","灯光与日影。犹晨夕。"],["肤浸","","肤受。犹言谗言中伤。"],["膺荷","","犹承受。有感恩之意。"],["臑鳖","","菜肴名。煮烂的鳖肉。"],["脔股","","谓割股疗疾以示虔敬。