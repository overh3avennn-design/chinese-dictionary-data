],["管系图","","piping diagram; piping plan"],["管纱线","","cotton sewing thread on cop"],["线性档","","linear frequency modulation"],["细褶皱","","crenulation; minute folding"],["织分化","","independent differentiation"],["缎纹呢","","woollen satin; satin berber"],["羽毛虱","","betting lice; feather louse"],["翼型族","","family of aerofoil sections"],["耐冲荒","","shock resistant; shockproof"],["耐痛阈","","threshold of pain tolerance"],["肌甙酸","","inisine acid; inosinic acid"],["脉冲图","","pulse diagram; pulse scheme"],["脉膊率","","pulse frequency; pulse rate"],["花罗缎","","shuchin; bengaline marquise"],["著标系","","principal coordinate system"],["蚕胃液","","digestive juice of silkworm"],["补色律","","law of complementary colors"],["裱糊纸","","pasted paper; pasting paper"],["诌性矩","","principal moment of inertia"],["辛癸醇","","Off-Shoot-T; Sucker plucker"],["过硬化","","overcure; overvulcanization"],["运木船","","log carrier; timber carrier"],["退化瀑","","rudiment; rudimentary organ"],["逆林布","","countercurrent distribution"],["透玫数","","coefficient of transparency"],["重力觉","","graviperception; barognosis"],["金属刷","","metallic brush; metal brush"],["金桔饼","","preserved kumquat flattened"],["钢笔夹","","pen clip; fountain pen clip"],["钾云母","","potash mica; potassium mica"],["铜钮扣","","bronze button; brass button"],["锻头机","","upsetter; upsetting machine"],["长秆稻","","rice infected by gibberella"],["闪光纸","","flashing paper; flash sheet"],["防山崩","","protection against landslip"],["防眩罩","","sun visor; antidazzle visor"],["阻燃管","","Frpipe =fire-retardant pipe"],["难燃的","","combustible with difficulty"],["香柠醇","","hydroxy methyl menthandiene"],["鹿茸胶","","antler gelatin; antler glue"],["大陆话","","Mainland Chinese (language)"],["地负涵","","指大地负载万物，海洋容纳百川。形容包罗万象，含蕴丰富。"],["垂泽昆","","裕富足◇昆子孙，后代，后嗣。为后世子孙留下功业或财产。"],["七宝花","","1) 花名。\n2) 佛教指西方极乐世界七宝池中的莲花。"],["三三径","","宋杨万里于东园辟九径，分植不同的花木，名曰“三三径”。"],["三堵墙","","明末农民起义军的一种战术，临阵列马三万，名“三堵墙”。"],["三大书","","指宋代之《太平御览》、《册府元龟》、《文苑英华》三书。"],["三龙祠","","古匈奴俗，于正月、五月、九月戊日祭天神。戊为龙，故称。"],["不乃羹","","古交趾食品名。一种用羊、鹿、鸡、猪肉等连骨熬制的浓汤。"],["且不上","","方言。等不到。民间气象谚语：黑云接日头，且不上放枕头。"],["九锡文","","古代帝王赐九锡予权臣时的诏书。内容皆谀颂权臣功德之词。"],["五技鼠","","1) 即鼫鼠。\n2) 诗文中常用以比喻技能多而不精者。"],["五禽言","","禽言，诗体名。依鸟名象声取义而作。五禽言，咏五鸟之名。"],["五色笔","","1) 几种颜色的笔。\n2) 五彩妙笔。\n3) 喻文才。"],["传事板","","即云版。旧时官署和权贵之家都以击云板为报事集众的信号。"],["两石弓","","用两石的力量才能拉开的弓。石，古代重量单位。亦泛指弓。"],["八丁兵","","南北朝北周实行过的一种兵制，把境内民丁分八批轮换服役。"],["公父训","","指春秋时鲁国大夫公父文伯之母敬姜对文伯深明礼义的训辞。"],["六韵诗","","律诗的一种。多为五言。六韵十二句。科举时代特指试帖诗。"],["十王宅","","唐玄宗诸子年长封王之后所共居的大宅。宅在长安安国寺东。"],["千岁子","","1) 植物名。藤生植物。\n2) 植物名。仙人掌的别名。"],["同功绵","","两蚕以上共作一茧，其丝称“同功绵”。常以象征男女情深。"],["同乐会","","单位、团体召开的庆祝会。因会上常有文娱节目演出，故称。"],["吴富体","","唐吴少微、富嘉谟文章雅厚雄迈，为时所尚，称“吴富体”。"],["吕虔刀","","三国魏刺史吕虔有一宝刀，铸工相之，以为必三公始可佩带。"],["哀痛诏","","封建帝王因灾害频至、民不聊生、内外交困而下的罪己诏书。"],["哈昔泥","","中药材阿魏的别名。见明李时珍《本草纲目‧木一‧阿魏》。"],["哥升节","","太平天国纪念耶稣升天的节日。哥，太父耶稣；升，指升天。"],["启母石","","夏启母所化之石。古代神话传说夏禹妻涂山氏生启而化为石。"],["回图使","","五代和北宋时契丹设置的掌管同中原地区进行贸易事宜的官。"],["坐上客","","1) 座席上的宾客。\n2) 指受到主人尊敬礼遇的客人。"],["士夫画","","画家的画，文人的画。别于画院待诏、祗候等所作的院体画。"],["壮缪侯","","蜀汉关羽死后，后主景耀三年追谥为壮缪侯。也省称为壮缪。"],["壶关老","","《汉书‧戾太子刘据传》：“上怒甚，群下忧惧，不知所出。"],["山屹塔","","小山丘。如：四周是一望无际的绿色田园，连山屹塔也没有。"],["帝流浆","","药石名。一种不吸铁的磁石。道家谓月华精气中含有帝流浆。"],["席函丈","","《礼记‧曲礼上》：“若非饮食之客，则布席，席间函丈。”"],["带叙法","","史传的一种方法。即其人不必立传，而在他人传内顺便略叙。"],["幼妇碑","","即曹娥碑。因碑背上题“黄绢幼妇，外孙齑臼”八字，故名。"],["庚申帝","","即元顺帝。又称庚申君。因生于庚申年(延佑七年)，故称。"],["影身草","","传说中的一种可以使人隐形的草。比喻掩盖真相的某种藉口。"],["御史娘","","指唐贞元中宫中御史娘子田顺郎，以善歌闻。后亦用为曲名。"],["思士操","","琴曲名。相传为周文王所作。见汉蔡邕《琴操‧文王思士》。"],["悲良弓","","《史记‧淮阴侯列传》：“上令武士缚信(韩信)，载后车。"],["所由官","","亦省作“所由”。\n犹言有关官吏。因事必经由其手，故称。"],["挂枝儿","","亦作“挂枝儿”。\n明万历后逐渐流行的一种民间时调小曲。"],["新姊妹","","太平天国时指新参加太平军或太平军新占领区中的女性群众。"],["方术士","","即方士。专门从事星占、神仙、房中、巫医、占卜等术的人。"],["旦过寮","","佛教指禅林行脚僧的宿泊处。以其夕来宿，过旦则去，故称。"],["有分交","","亦作“有分教”。\n旧小说段终的套语，并提示情节的发展。"],["杜十姨","","唐杜甫，曾官左拾遗，故世称杜拾遗。旧村学究戏作杜十姨。"],["杜武库","","晋人对杜预的尊称。谓其学识渊博，如武库兵器，样样具备。"],["杞梁妻","","1) 春秋齐大夫杞梁之妻。或云即孟姜。\n2) 歌曲名。"],["东吕乡","","古地名。故址在今山东省日照县西。相传为周初姜尚的故里。"],["东土山","","指东晋谢安在金陵城东南比照会稽东山所筑之山。一名土山。"],["东陵瓜","","1) 指汉邵平所种之瓜，味甜美。\n2) 泛指味美之瓜。"],["柴桑令","","指东晋末隐寓庐山西林寺的刘遗民。因其曾为柴桑令，故称。"],["桔槔烽","","《史记‧魏公子列传》：“公子与魏王博，而北境传举烽。”"],["梅花婢","","指迎春花、瑞香花、山茶花。三者皆早春之花，与梅花同时。"],["杨白花","","1) 乐府杂曲歌辞名。\n2) 指柳絮。亦喻指薄幸之人。"],["盘盘国","","古代南海古国名。故地一般以为在今泰国南万伦湾沿岸一带。"],["正声伎","","指清商三调，包括平调、清调、瑟调。即宫调、商调、角调。"],["每句韵","","古诗的韵法之一，又名全韵诗，即一首诗中每句末字皆押韵。"],["水机关","","机关枪的一种。放射时要灌水以防爆裂，故称。现已被淘汰。"],["没前程","","1) 谓昧良心，行为刻薄。\n2) 没有好结果、好下场。"],["冲天鹤","","传说周灵王太子晋从道士浮邱公游，曾在缑氏山巅控鹤冲天。"],["游百病","","旧时有于端阳节出游的风俗。据云此举可以消除疾病，故称。"],["温温然","","1) 和蔼可亲貌。\n2) 温暖貌。\n3) 眷恋不忘貌。"],["澄海楼","","楼名。在河北省旧临榆县南宁海城上，明兵部主事王致中建。"],["火齐珠","","1) 宝珠的一种。一说，似珠的石。\n2) 琉璃的别名。"],["无心草","","1) 草名。鼠耳草的别名。\n2) 草名。麋衔草的别名。"],["无漏果","","佛教语。谓修持无漏法所得的证果，四谛中灭谛之涅盘即是。"],["无礼喏","","行礼的一种方式：一边作揖，一边口说“无礼”，表示客气。"],["无声乐","","一种模拟乐器形状及演奏动作而不发声的游戏，俗以为酒令。"],["营田使","","官名，掌管屯田诸事宜，唐玄宗时始置，后多由节度使兼领。"],["犯斗槎","","1) 指游仙、升天所乘的仙舟。\n2) 指远行所乘之舟。"],["独荷草","","草名。鬼臼的别名。见明李时珍《本草纲目‧草六‧鬼臼》。"],["玄水石","","中药玄石的别名。见明李时珍《本草纲目‧金石四‧玄石》。"],["玉女窗","","嵩山古迹之一；宋时已不存，传说汉武帝于此窗中见到玉女。"],["玉盘盂","","1) 白芍药的别名。\n2) 指白牡丹。\n3) 喻美貌。"],["甓社湖","","湖名。在江苏高邮县西北。湖东西长七十里，南北宽五十里。"],["百脚旗","","一种竖立的旗帜。两边为锯齿形。古代王公出行，用作前导。"],["直百钱","","三国时，蜀刘备所铸货币的一种。一枚金属钱币抵币值一百。"],["竹佛子","","虫名。竹虱的别称。见明李时珍《本草纲目‧虫三‧竹虱》。"],["等盘儿","","戥子和杆秤上盛放被称物体的盘子。借指秤，比喻打定主意。"],["绾角儿","","古时孩童束发为两髻，形状如角，故以“绾角儿”借指童年。"],["能言鸭","","唐陆龟蒙故事。比喻文人囊中虽无所有，但其才智足以惊人。"],["修闾氏","","周代掌管王城里门的官员。主管宿卫、击更、追捕盗贼等事。"],["脚力人","","旧时担任传递文书或递运货物的差役或民丁。后指搬运工人。"],["蒡蓊菜","","草名。牛蒡的别名。见明李时珍《本草纲目‧草四‧恶实》。"],["资课钱","","唐时因国库空虚，官员俸禄需待课税后付给，称“资课钱”。"],["卖口吃","","宋时新年的一种民俗。谓将口吃转移给人。参见“卖蒙懂”。"],["走偏锋","","原指书法中用偏锋书写。后多比喻通过不正当途径谋取利益。"],["足谷翁","","唐相国韦宙善于经营，积谷如山，皇帝因称其为“足谷翁”。"],["载生魄","","指农历每月十六日。语出《书‧康诰》：“惟三月哉生魄。”"],["返真元","","真元，本原。道家谓人死为返归本原，故以“返真元”指死。"],["迷齐眼","","方言。眼睛微合成缝的样子。亦指近视眼。迷，用同“眯”。"],["逍遥津","","在安徽省合肥市东北隅。古为肥水上的津渡，今已辟为公园。"],["还京乐","","1) 乐曲名。\n2) 词牌名。调见宋周邦彦《片玉词》。"],["郭隗金","","《文选‧鲍照〈放歌行〉》：“岂伊白璧赐，将起黄金台。”"],["郭顺时","","元代杂剧演员郭顺卿，别号顺时秀。歌喉动听，世称郭顺时。"],["醉杨妃","","1) 花名。(1)兰花品种名。\n2) 醉酒后的杨贵妃。"]]