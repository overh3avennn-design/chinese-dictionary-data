[["悲烹狗","","表示对功高被弃或被诛者的悲叹。"],["慈母服","","古时为抚育己之庶母所服的丧服。"],["戏蚂蚁","","方言。称组织戏班的人，即班主。"],["打粟干","","方言。甜高粱。上海俗称甜芦粟。"],["拉齐套","","几匹马齐头拉车。比喻平均分配。"],["拖地锦","","女子结婚时的披红。一说为长裙。"],["拗相公","","对宋代力主变法的王安石的诬称。"],["拜阴寿","","旧时为死者做生日称“拜阴寿”。"],["挑牙虫","","旧时以剔除牙虫治病为名的骗术。"],["换鹅经","","指《黄庭经》，或谓《道德经》。"],["扑楞楞","","象声词。形容心跳、拍翅等声音。"],["攀地龙","","野藤的一种。因爬在地上，故名。"],["支床龟","","支床之龟。喻受束缚或内心寂寞。"],["整生日","","逢十的生日。如十岁、二十岁等。"],["文剪公","","指剪贴拼凑别人文章以成文的人。"],["昌蒲菹","","菖蒲根的腌制品。昌，通“菖”。"],["春月柳","","春季之柳。用以形容柔美的仪态。"],["晋晋然","","低垂貌；俯下貌。引申为肃敬貌。"],["普尔钱","","清代新疆、西藏地区通行的钱币。"],["景阳井","","南朝陈景阳殿之井，又名胭脂井。"],["曝衣楼","","皇宫中帝后于七月七日曝衣之处。"],["书本气","","指喜欢掉书袋，卖弄才学的习气。"],["书呆气","","不明世事而只知死啃书本的习气。"],["望海潮","","词牌名。调见宋柳永《乐章集》。"],["杏花烟","","形容女子鬓发之美，如杏花含烟。"],["杯渡松","","相传为晋宋间高僧杯渡手植之松。"],["东都门","","汉代长安城东门之一，即宣平门。"],["柏下人","","指墓中人。因墓地多植柏，故称。"],["柳箧子","","对唐柳璨的誉称。箧子，指书箱。"],["桃枝杖","","桃枝竹制成的拐杖。为杖中佳品。"],["桃枝簟","","桃枝竹编织的席子。为席中佳品。"],["梅红伞","","梅红色的伞盖。古代仪仗的一种。"],["梅花障","","梅花障扇。古代帝王仪仗的一种。"],["梨花冻","","即梨花春酒。因冬酿春熟，故称。"],["梨花蜜","","蜂蜜的一种。蜂采梨花所酿之蜜。"],["梵王宫","","本指大梵天王的宫殿。泛指佛寺。"],["棒喝党","","即法西斯党。参见“棒喝主义”。"],["枣核笔","","即枣心笔。一种用古法制的毛笔。"],["椒花舫","","清朱筠室名“椒花吟舫”的省称。"],["杨妃粉","","传说为一种可润泽肌肤的粉状土。"],["杨子院","","唐盐铁转运使在杨子县所置巡院。"],["业窠团","","谓罪孽之渊。指情爱、情欲之事。"],["业贝戎","","以偷为业。贝戎为“贼”的拆字。"],["楼店务","","宋代地方管理房地产税务的机构。"],["树头酒","","以贝多罗树果实的汁液制成的酒。"],["橘中乐","","谓弈棋之乐趣。参见“橘中戏”。"],["横斗柄","","谓北斗星的柄横斜。指拂晓时分。"],["钦玺书","","即玺书。古代以印信封记的文书。"],["归寿衣","","即寿衣。人死后穿着入葬的衣服。"],["毛女洞","","华山洞名。传说中仙人毛女所居。"],["气哄哄","","形容生气而说话粗声粗气的样子。"],["水场钱","","五代时南唐水上居民所纳的税钱。"],["水帝子","","水帝颛顼之子。相传死后为疫鬼。"],["永安宫","","1) 宫殿名。\n2) 宫殿名。"],["沈珠浦","","亦作“沉珠浦”。\n珠江的别名。"],["沙发榻","","装有弹簧或厚泡沫塑料等的卧榻。"],["河阳桥","","晋杜预于古孟津所建的跨河浮桥。"],["泥脚杆","","指农民。旧时多为对农民的蔑称。"],["洑上水","","游向上游。比喻巴结有权势的人。"],["活抖抖","","方言。因恐惧而全身不停地哆嗦。"],["活辣子","","一种躯体像树叶颜色的有毒虫子。"],["海夷道","","指古代通往海外诸国的海上航线。"],["淹中馆","","淹中的塾馆。借指一般儒家学馆。"],["滑七擦","","形容在泥水里走动的情状和声响。"],["满番汗","","即古沛水。距鸭绿江入海不远处。"],["汉武泉","","泉名。在长安城南，为曲江之源。"],["汉阳造","","指旧中国汉阳兵工厂制造的长枪。"],["浔阳楼","","古楼名。故址在今江西省九江市。"],["火葫芦","","形似葫芦，内装火药的引火战具。"],["灶下婢","","1) 女厨工。\n2) 指侍妾。"],["乌爨弄","","古代云南少数民族乌爨族的乐曲。"],["烹小鲜","","《老子》：“治大国若烹小鲜。”"],["无名租","","指五代王审知据闽时滥收的租税。"],["无常钟","","古代佛寺为死者送终而撞击的钟。"],["无明业","","佛教语。指于人有害的痴愚恶业。"],["无星秤","","没有秤星的秤。比喻随缘不执着。"],["无弃材","","没有无用的材料。常喻人各有用。"],["无生话","","佛教语。指无生无灭的佛法真谛。"],["焦尾琴","","1) 琴名。\n2) 泛指好琴。"],["照病镜","","传说中可以照见病人脏腑的宝镜。"],["烦恼业","","佛教语。谓因愚痴而造下的罪孽。"],["燕九节","","旧俗以正月十九日为“燕九节”。"],["燕喜亭","","亭名。在广东省连县城内北山下。"],["尔汝歌","","魏晋时一种带有亲狎情调的民歌。"],["牌面馆","","太平天国安置全劳力男子的机构。"],["牛渚怪","","晋温峤在牛渚矶燃犀照怪的典故。"],["牢饭碗","","比喻稳当的职业。犹今言铁饭碗。"],["犀角带","","饰有犀角的腰带。非品官不能用。"],["狗马心","","旧时对尊长表示赤诚报效的谦词。"],["狼顾相","","谓人的一种异相，头反顾形似狼。"],["独户军","","元代每户征兵一人所编成的军队。"],["独醒人","","原指屈原。后亦泛指不随流俗者。"],["玉堂体","","明宁王朱权所定乐府十五体之一。"],["珠樱宴","","即樱桃宴，科举时进士及第之宴。"],["班朝录","","记载朝中官员职位、姓名的册子。"],["现路子","","方言。谓现成的路子，即老路子。"],["璎珞藤","","植物名。其子粒形似璎珞，故名。"],["甘露厨","","佛家对厨房的称呼。也称香积厨。"],["画麒麟","","刻画的麒麟。比喻虚有其表的人。"],["发天葩","","开放奇花。比喻制作新奇的文章。"],["白单衣","","古丧礼中的盛服。单，通“襌”。"],["白玉墀","","宫殿前的玉石台阶。亦借指朝堂。"],["白玉玺","","白玉制的玺印。为帝王传国之宝。"],["白雪楼","","古迹名。故址在今湖北锺祥城西。"],["白鹿车","","传说仙人乘坐的用白鹿挽的车子。"],["百代城","","谓极坚固之城，虽经百世而不毁。"],["百衲碑","","指宋蔡襄所书《昼锦堂记》碑文。"],["百谏图","","宋靳东发所绘古今谏诤百事的画。"],["百炼铅","","比喻人经磨炼后更为柔顺的性格。"],["的溜溜","","形容圆形东西滚动或转动的样子。"],["眇丈夫","","犹言小丈夫。指见识短浅的男子。"],["眉子坑","","眉子砚石的产地。在安徽省歙县。"],["眼孔浅","","方言。形容目光短浅，贪财爱物。"],["眼睛头","","眼前。指眼睛很容易看见的地方。"],["瞭望军","","明代科举考试时所设的监场人员。"],["知县事","","佐官代行县令职务称“知县事”。"],["石帮岸","","方言。石砌的河岸。也叫石驳岸。"],["石首局","","乐府鼓吹曲名。原名《将进酒》。"],["破帆风","","即飓风。夏秋间生于海洋的暴风。"],["碧瑶树","","玉树。比喻美丰姿、多才艺的人。"],["碧落碑","","唐碑。在今山西省新绦县龙兴宫。"],["神道碣","","谓立在墓前刻有死者事迹的碑石。"],["神锦衾","","唐代大轸国所献的一种精美衾被。"],["祠祭司","","清代礼部所属官署名。主掌祭祀。"],["禾三千","","一个禾穗三千子实。谓丰收年景。"],["秦望碑","","指秦始皇东游秦望山时所立的碑。"],["秦余望","","秦望山。在今浙江省杭州市东南。"],["稍挽稍","","拿自己的赌资来博取别人的银钱。"],["空头话","","内容空洞或不能实现的话；闲话。"],["立朝夕","","立表观测早晚日影以定东西方向。"],["立钦钦","","形容因惊惧或寒冷而颤抖畏缩貌。"],["笑咧咧","","形容笑时嘴角向两边伸展的样子。"],["答不也","","女真语音译词。在田里除草的人。"],["胡涂账","","指混乱不清的事或不明事理的人。"],["纪纲地","","伸张法纪之地。多特指谏官职务。"],["丝纶簿","","明清内阁中保存诏旨底稿的簿本。"],["绿石砚","","一种名贵的砚台。参见“绿石”。"],["绿荔枝","","荔枝名。皮为绿色，产于