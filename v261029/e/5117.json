,["高频声波","","high frequency sound wave"],["高频校正","","high frequency correction"],["黑糯米酒","","black glutinous rice wine"],["全面试压","","thorough-pressure testing"],["钻探风险","","risk of drilling prospect"],["支出授权","","authority for expenditure"],["控流浮箍","","flow control float collar"],["两用尾管","","drilling-completion liner"],["耳叶越桔","","Vaccinium pseudospadiceum"],["单连接站","","single attachment station"],["改善通讯","","to improve communications"],["程式理员","","program manager (Windows)"],["钻懒帮闲","","指逢迎凑趣，耍弄乖巧。亦指逢迎凑趣，耍弄乖巧的人。"],["趑趄嗫嚅","","欲进又退，欲言又止。形容奴颜婢膝，畏缩不前的样子。"],["柱石之坚","","像柱石一样坚硬。比喻大臣坚强可靠，能担负国家重任。"],["祝发文身","","削短头发，刻画其身。指中原以外地区异族的风俗服制。"],["踵迹相接","","谓脚迹相连。形容人数众多，接连不断。同踵趾相接”。"],["踵武前贤","","踵脚跟。武足迹。跟随着前人的脚步走。比喻效法前人。"],["踵武相接","","谓脚迹相连。形容人数众多，接连不断。同踵趾相接”。"],["踵足相接","","谓脚迹相连。形容人数众多，接连不断。同踵趾相接”。"],["众目共视","","所有人的眼睛都看到了。形容非常明显。同众目共睹”。"],["众目具瞻","","所有人的眼睛都看到了。形容非常明显。同众目共睹”。"],["众喣飘山","","众人吹气，可以移山。比喻人多力量大。同众喣漂山”。"],["众喣山动","","众人吹气，可以移山。比喻人多力量大。同众喣漂山”。"],["重规沓矩","","指前后相合，合乎同样的规矩法度。亦比喻因袭、重复。"],["重规累矩","","指前后相合，合乎同样的规矩法度。亦比喻因袭、重复。"],["重规袭矩","","指前后相合，合乎同样的规矩法度。亦比喻因袭、重复。"],["质而不野","","质朴素、单纯。野粗俗。质朴而不粗俗。同质而不俚”。"],["只身孤影","","只单独的。指孤单一人。亦作只影孤形”、只影单形”。"],["指瑕造隙","","犹言寻找事端，制造分裂。瑕，玉上的斑点。隙，裂缝。"],["正色危言","","态度严肃，语言正直，能使人望而生畏。同正色直言”。"],["针芥之契","","磁石引针，琥珀拾芥，因以之指相投契。同针芥相投”。"],["蒸沙为饭","","要把沙子蒸成饭。比喻事情不可能成功。同蒸沙成饭”。"],["照萤映雪","","利用萤火虫的光和白雪的映照读书，形容刻苦地读书精神"],["摘胆剜心","","摘取。剜用刀剜。用刀子将胆和心取出。形容非常痛苦。"],["摘句寻章","","摘取、搜寻文章的片断词句。指读书局限于文字的推求。"],["远至迩安","","远方来归附，近民安居乐业。形容政治清明，国家大治。"],["迎风冒雪","","迎对着，冲着。顶着寒风，冒着大雪。常形容旅途艰辛。"],["蝇名蜗利","","苍蝇头般微名，蜗牛角样的小利。比喻微不足道的名利。"],["蝇声蛙躁","","苍蝇、青蛙无休止地叫。比喻低劣的、无病呻吟的诗文。"],["颖悟绝伦","","颖悟聪颖。绝伦超过同辈。聪明过人。亦作颖悟绝人”。"],["饮恨而终","","饮恨心里怀着怨恨和冤屈。内心满怀着怨恨或冤屈死去。"],["隐忍不发","","隐忍勉强忍耐，把事情藏在心里。把事情藏在心里不说。"],["因敌取资","","因依，靠；资财物，资用。从敌人方面取得资用、给养。"],["因难见巧","","因由于某种缘故；巧巧妙。由于难而更显出技艺的巧妙。"],["以蚓投鱼","","用蚯蚓做鱼饵钓鱼。比喻用较小的代价换得较大的收获。"],["以锥刺地","","用锥子刺地来测量地的深浅。比喻见识浅陋，所知甚少。"],["易如翻掌","","比喻事情及容易办成，不必费很大力气。同易如反掌”。"],["易同反掌","","比喻事情及容易办成，不必费很大力气。同易如反掌”。"],["以冠补履","","冠帽子；履鞋子。用帽子补鞋。比喻以贵重物品配贱物。"],["以身报国","","把身体献给国家。指宁愿为国家的安危奉献自己的生命。"],["以磛投卵","","磛磨刀石。用磨刀石去砸蛋。比喻以强攻弱，必胜无疑。"],["衣锦食肉","","穿锦绣衣裳，吃肉食。形容生活富足。亦借指居官食禄。"],["衣马轻肥","","穿着轻暖的皮袍，坐着由肥马驾的车。形容生活的豪华。"],["一泻百里","","形容江河水势奔流直下，流得又快又远。同一泻千里”。"],["一泻万里","","形容江河水势奔流直下，流得又快又远。同一泻千里”。"],["一波万波","","比喻事情开端后的不断发展变化。同一波才动万波随”。"],["峣峣易缺","","峣峣高直的样子；缺损坏。比喻刚直不阿的人不容于世。"],["瑶草琪花","","①仙境里的花草。②珍贵奇异的花草。亦作瑶草琪葩”。"],["野人献曝","","比喻贡献的不是珍贵的东西。（向人建议时的客套话）。"],["燕颔儒生","","有封侯之相的读书人。亦用以称美志在建立军功的士人。"],["言语路绝","","犹言言语道断。指不能通过交谈、谈判的方法解决问题。"],["沿门托钵","","钵和尚吃东西用的器具。原指僧徒化缘。比喻挨家乞讨。"],["揎拳掳袖","","把袖子往上一推，露出胳膊，握着拳头。形容准备动手。"],["揎拳捰袖","","伸出拳头，捋起袖子。一种粗野蛮横或准备动武的姿态。"],["悬车之年","","悬车古人一般至七十岁辞官家居，废车不用。指七十岁。"],["虚骄恃气","","虚骄虚浮而骄矜；恃气凭着意气。虚浮骄矜，意气用事。"],["行古志今","","按古道行事，为当今服务。指时异势迁，不可食而不化。"],["形槁心灰","","槁枯干。形容身体消瘦不堪，心境极为冷漠，毫无生气。"],["形劫势禁","","指受形势的阻碍或限制，事情难于进行。同形格势禁”。"]]