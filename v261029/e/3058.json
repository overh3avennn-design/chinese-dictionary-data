[["牵物","","1) 为外物所牵制。\n2) 援引同类事物。参见“牵物引类”。"],["玄衮","","亦作“玄裷”。\n古代帝王及上公所穿的一种绣着卷龙的黑色礼服。"],["玉坛","","1) 道坛的美称。亦借指仙境。\n2) 花坛的美称。借指庭院。"],["异器","","1) 不同的器具。\n2) 特殊的才具。\n3) 不寻常的器物。"],["疆外","","1) 犹域外。指中原地区以外的地方。\n2) 指某一界线以外。"],["白路","","1) 亦作“白辂”。古代皇帝于秋季所乘的车子。\n2) 大道。"],["石户","","1) 上古传说中的地名。\n2) 见“石户农”。\n3) 石门。"],["稍礼","","古时朝聘宾客，不得按时返回的，主人供给其饮食，叫做“稍礼”。"],["称藩","","亦作“称蕃”。\n自称藩属。向大国或宗主国承认自己的附庸地位。"],["章指","","1) 亦作“章旨”。诗文的主旨。\n2) 经籍注释的一种形式。"],["笔彩","","亦作“笔采”。\n1) 谓文笔辞采。\n2) 指图画的光华色彩。"],["簠簋","","1) 簠与簋。两种盛黍稷稻粱之礼器。\n2) 犹苞苴。指贿赂。"],["綟绶","","即绿綟绶。一种黑黄而近绿色的丝带。古代丞相以上官吏用作印绶。"],["缬纹","","亦作“缬文”。\n1) 酒后脸上呈现的红晕。\n2) 彩色花纹。"],["翠衿","","亦作“翠襟”。\n1) 指鹦鹉胸前的翠色羽毛。\n2) 指鹦鹉。"],["胥宇","","1) 察看可筑房屋的地基和方向。犹相宅。\n2) 指看守房屋。"],["英逸","","1) 英俊卓越。\n2) 指才智卓越的人。\n3) 潇洒；超脱。"],["草庵","","亦作“草庵”。\n1) 草房，草舍。\n2) 特指小寺庙或庵堂。"],["蚓结","","像蚯蚓一样屈曲。语出《礼记‧月令》：“﹝仲冬之月﹞蚯蚓结。”"],["要节","","1) 犹言切合礼节。\n2) 立节。谓自身按照节义的要求去做。"],["诸姬","","1) 指同是姬姓的女子。\n2) 众姬姓之国。\n3) 众女伎。"],["竖刁","","亦作“竖刀”。\n春秋时齐桓公的宦官寺人貂谀事桓公，颇受宠信。"],["负筭","","亦作“负算”。\n负欠的口钱(一种人口税)。后泛指负欠的租税。"],["贯丳","","将肉串在铁签上烤烧。丳，串物烧烤的铁签类器具。喻有顺序条理。"],["走介","","亦作“走价”。\n1) 供奔走的仆役、小使。\n2) 派遣仆役。"],["趑雎","","亦作“趑趄”。亦作“趑趣”。\n犹恣睢。狂妄、凶暴；放纵肆扰。"],["跳磴","","亦作“跳蹬”。\n放在浅水中，相隔一定距离，供踏脚用的大石块。"],["踏白","","1) 见“踏白军”。\n2) 谓开路，打先锋。也指打先锋的人。"],["跖实","","亦作“跖实”。\n1) 谓兽类足踏实地而行。\n2) 借指走兽。"],["重较","","指古代卿士所乘车箱前左右有伸出的弯木(车耳)可供倚攀的车子。"],["青絇","","亦作“青句”。\n古时鞋头上青色的丝织妆饰，有孔，可穿系鞋带。"],["韩寿","","南朝宋刘义庆《世说新语‧惑溺》：“韩寿美姿容，贾充辟以为掾。"],["颂台","","指古代太常寺之类专司礼乐、祭祀的官署，因其多祝颂之事，故称。"],["顽蔽","","亦作“顽弊”。\n1) 愚鲁，愚笨。\n2) 指愚鲁、愚笨的人。"],["风律","","1) 指音律。亦比喻风教律令。\n2) 古代的一种占卜的方法。"],["飙驰","","1) 狂风疾吹。\n2) 疾速奔驰。\n3) 形容才思敏捷奔放。"],["騑骖","","1) 指拉车的四匹马中在辕外的两匹马。\n2) 泛指拉车的马。"],["魇样","","亦作“魇阳”。\n用符咒或其他迷信手法消解灾殃，或致灾祸于人。"],["鵸鵌","","传说中的鸟名。(1)有三头六尾的鸟。(2)有五彩而赤文的鸟。"],["鹤侣","","1) 鹤伴。\n2) 唐时称尚书省官员。\n3) 泛指官员人选。"],["麦城","","古城名。相传为楚昭王所筑。故址在今湖北当阳东南，沮漳两水间。"],["龟峰","","龟山。在江苏省苏州市邓尉山北，上有光福塔，南朝梁大同年间建。"],["编班","","to group or place into classes"],["便走","","马上就走、 立刻就走。 如： “他说完便走， 头也不回。 ”"],["墦间","","墓地。 孟子·离娄下： “卒之东郭墦间之祭者， 乞其余。 ”"],["斧冰","","凿冰。 汉·曹操·苦寒行： “担囊行取薪， 斧冰持作糜。 ”"],["泥堆","","ní duī\n泥土堆。\n如：「小弟在泥堆里玩得像个泥人儿。」"],["躧拿","","xǐ ná\n跟踪擒拿。\n如：「目前警方正全力躧拿枪击要犯。」"],["掘拾","","jué shí\n挖掘拾取。\n如：「鸟儿在田里掘拾蚯蚓果腹。」"],["樊仲","","a surname:\n樊仲生 Fangzhong Sheng"],["狐邱","","a surname:\n狐邱丈人 Huqiu Zhangren"],["介登","","a surname:\n介登师门 Jiedeng Shimen"],["破丑","","a surname:\n破丑平昆 Pochou Pingkun"],["烛庸","","a surname:\n烛庸之越 Zhuyong Zhiyue"],["襞𫌀","","[p]wr.[/p] pleats (in a skirt)"],["滨行","","be about to start on a journey"],["不家","","[p]coll.[/p] otherwise; if not"],["谷垛","","stack of harvested crop stalks"],["价底","","lowest price seller can afford"],["抠根","","search for root reason of sth."],["令祖","","[p]court.[/p] your grandfather"],["甚急","","1) very anxious\n2) very urgent"],["失于","","lose due to the mistake of ..."],["销运","","sell and transport commodities"],["音差","","[p]lg.[/p] difference in sound"],["拼购","","几个人合在一起购物, 费用分摊: 三人~了一箱特价促销啤酒。"],["呼之即来","","to come when called (idiom); ready and compliant\nalways at sb’s beck and call"],["外御其侮","","internal disunity dissolves at the threat of an invasion from outside (idiom)"],["定值调节","","constant setpoint regulation; constant value control; fixed set-point control"],["牛至叶粉","niúzhì yèfěn","[p]см.[/p] 牛至 ([i]приправа[/i])"],["搭桥引线","dāqiáo yǐnxiàn","[p]см.[/p] 搭桥牵线 dāqiáo qiānxiàn"],["加一地址","","increment address"],["超薄切片","","ultrathin section"],["容器支承","","support of vessel"],["塞拉勒窝内","sèlālèwōnèi","Сьерра-Леоне"],["几内亚比绍","jī’nèiyà bǐshào","Гвинея-Бисау"],["一言以蔽之","yī yán yǐ bì zhī","одним словом"],["一对一个儿","yīduìyīgèr","один на один"],["社会主义化","shèhuìzhǔyìhuà","социализация"],["盔式飞行帽","kuī shì fēixíngmào","лётная каска"],["一个半小时","yīgebàn xiǎoshí","полтора часа"],["本丢彼拉多","běndiū bǐlāduō","Понтий Пилат"],["感情奔放的","gǎnqíng bēnfàngde","импульсивный"],["年根儿底下","niángēnrdǐxià","в конце года"],["特姆特姆弹","tèmǔtèmǔdàn","пули дум-дум"],["统一大市场","tǒngyī dà shìchǎng","единый рынок"],["倾转旋翼机","qīngzhuǎn xuányìjī","конвертоплан"],["变铁铀云母","biàn tiěyóu yúnmǔ","метабассетит"],["男人俱乐部","nánr