"内隙","","inner gap; inner width"],["医神","","Aesculapius; Asclepius"],["吹箱","","acid blwcase; blowcase"],["大艾","","Blumea balsamifera DC."],["尺磅","","foot-pound; foot-pound"],["幼鲸","","whale calf; whale-calf"],["摆管","","swing line; swing pipe"],["改铸","","remint; remold; recast"],["松掉","","come loose; work loose"],["油商","","oiler; oilman; oil man"],["漆柿","","Diospyros embryopteris"],["牙梃","","dental lever; elevator"],["突败","","catatastrophic failure"],["糠榔","","Phoenix hanceana Naud."],["美薇","","Osmunda claytoniana L."],["脱湿","","desorption of moisture"],["自勒","","suicidal strangulation"],["萘胲","","naphthyl hydroxylamine"],["蓝四","","ditetrazolium chloride"],["谍子","","hollowware; small dish"],["钠氨","","sodamide; sodium amide"],["零移","","zero-drift; zero-shift"],["偶同","","accidental resemblance"],["堡坝","","barrier; beach barrier"],["抛筑","","pell mell construction"],["日态","","journal; log; protocol"],["次茧","","light defective cocoon"],["河璃","","fluviology; potamology"],["测砧","","measuring anvil; anvil"],["混撩","","axial radial flow pump"],["灰云","","fume; smoke; ash cloud"],["砂锡","","placer tin; stream tin"],["织轮","","capstan; driving wheel"],["试拌","","trial batch; trial mix"],["酯屎","","ester gum; rosin ester"],["钉拔","","nail claw; nail puller"],["钢诵","","rope clamp; rope cramp"],["铁夯","","iron ram; tamping iron"],["犯毒","","illegal drug, narcotic"],["㩹","","to pile on; to fold up"],["㱩","","an abortion; stillborn"],["㳯","","goddess of an ink-slab"],["䛖","","(same as 詍) loquacious"],["䛛","","(same as 8A6F) courage"],["䟞","","to falter; to hesitate"],["䦁","","a broad hoe, a mattock"],["䫨","","tall and big; colossal"],["䰇","","(same as 鬐) mane, fins"],["嵶","","low part of a mountain"],["鎅","","(Cant.) to saw; to cut"],["一宛","","宋时小贩卖麦面时以袋为计量单位，一袋称一宛。"],["一盛","","I\n一时兴盛或旺盛。\nII\n表一器所盛之量。"],["一笛","","1) 指一支笛的声音。\n2) 喻轻微的风声。"],["丁甲","","即六丁六甲。本为道教神名。后亦泛指天兵天将。"],["七牢","","牛、羊、豕三牲各七。古代天子馈赐诸侯的礼品。"],["三干","","犹三天。道教称清微天、禹余天、大赤天为三天。"],["三佞","","三个奸佞的人。指北齐邹孝裕、陆仁惠、卢元亮。"],["三峨","","四川峨眉山有大峨、中峨、小峨三峰，故称三峨。"],["三崔","","汉崔駰及子瑗、孙寔，皆有文名，合称“三崔”。"],["上果","","1) 精美的果品。\n2) 佛家语。犹言正果。"],["不韵","","1) 不风雅；不风趣。\n2) 不押韵，失韵。"],["且弥","","汉代西域国名。有东、西两且弥，其后合为一国。"],["丕承","","很好地继承。旧谓帝王承天受命，常曰“丕承”。"],["世度","","1) 出世。谓超凡而成仙。\n2) 整个封域。"],["中岩","","1) 山岩之中。\n2) 山岩名。在四川眉山。"],["中扆","","指朝廷或天子。扆，宫殿中设在户牖之间的屏风。"],["中晡","","古代地支记时法中的正申时。相当于下午四点钟。"],["丰致","","1) 风采韵致。\n2) 指诗文的韵味，情趣。"],["主侩","","旧时促成双方买卖并从中获取佣金的牙行经纪人。"],["乖和","","1) 反常；不和谐。\n2) 犹违和。指有病。"],["九侯","","1) 商纣时的诸侯之一。\n2) 九服的诸侯。"],["九丝","","1) 九弦。\n2) 山名。在今四川省兴文县。"],["乞取","","1) 求得。\n2) 请求釆取。\n3) 勒索。"],["乾隐","","1) 侵吞财物；侵吞。\n2) 指侵吞的财物。"],["乱贼","","1) 叛乱。\n2) 残害。\n3) 乱臣贼子。"],["事济","","1) 事业完成；事情办成功。\n2) 犹事情。"],["二朝","","I\n两个早晨。\nII\n指卿大夫的外朝和内朝。"],["二税","","夏秋两季完纳的赋税。征二税始于唐，后世因之。"],["二蔡","","1) 指管叔与蔡叔。\n2) 指宋蔡京与蔡卞。"],["五推","","谓扶耒耜往还五度。古代的一种耕种籍田的礼仪。"],["五旦","","1) 古代西域曲调的五韵。\n2) 犹言五更。"],["五辟","","1) 五刑。\n2) 五君。\n3) 五次征召。"],["五丑","","五类。指士、农、商(行商)、工、贾(坐商)。"],["亡鹿","","《汉书‧蒯通传》：“秦失其鹿，天下共逐之。”"],["交露","","指用交错的珠串组成的帷幔。其状若露珠，故称。"],["交韔","","《诗‧秦风‧小戎》：“虎韔镂膺，交韔二弓。”"],["人枭","","喻指忤逆不孝之人。传说枭是食母的恶鸟，因称。"],["仙禁","","指皇宫。因禁卫森严，臣下不得任意出入，故称。"],["仙种","","1) 仙界的品种。\n2) 喻指出身高贵的人。"],["代终","","1) 谓取代旧皇朝。\n2) 谓继承死者遗业。"],["代输","","1) 谓代人输边服役。\n2) 代为缴纳租赋。"],["令王","","1) 贤明的天子。\n2) 对有王爵者的美称。"],["令盆","","掷骰子用的盆。一种赌具，可掷骰以行令，故称。"],["令范","","1) 可为楷模的美德。\n2) 指良好的典范。"],["令音","","1) 和善的语音。\n2) 善言，美好的言辞。"],["仲连","","战国时齐人鲁仲连。喜为人排难解纷，高蹈不仕。"],["伍什","","古代军队以五人为伍，二伍为什。后用以指部队。"],["休囚","","1) 犹言失时，失运。\n2) 委靡，不振作。"],["伯鸾","","1) 汉梁鸿的字。\n2) 作为贤丈夫的代称。"],["伾文","","指唐顺宗时领导政治改革的王叔文及其同党王伾。"],["佐券","","左券。债权人所执的左片债券。左、佐，古今字。"],["作玩","","亦作“作玩”。\n1) 游戏。\n2) 开玩笑。"],["佩青","","1) 腰边挂着青色的印绶。\n2) 泛指任官。"],["来突","","谓突然而来。语本《易‧离》：“突如其来如。”"],["供御","","I\n供给。亦指供给之物。\nII\n进奉于帝王。"],["俄忽","","1) 一会儿；极短的时间。\n2) 谓突然间。"],["保弼","","1) 保卫并辅佐。\n2) 指保卫、辅佐之业。"],["保氏","","古代职掌以礼义匡正君王、教育贵族子弟的官员。"],["信凭","","1) 信任；相信。\n2) 谓相信并引为根据。"],["修完","","1) 整修使完好。\n2) 谓整顿补充使完备。"],["倔奇","","生硬奇诡，与众不同。多指诗文书画的风格而言。"],["候景","","测日影。古代测日影定时刻。景，“影”的古字。"],["候台","","即烽火台。古代边境要地为守望报警而筑的高台。"],["倦旅","","1) 厌倦于行旅。\n2) 又指倦于行旅的人。"],["偃骨","","仙骨。道教称名字上了仙册的人，胸间必有偃骨。"],["假乐","","《诗‧大雅‧假乐》：“假乐君子，显显令德。”"],["假限","","I\n宽限；期限。\nII\n休假的期限，指假期。"],["伟才","","1) 卓越的才能。\n2) 具有卓越才能的人。"],["侧妃","","清时皇妃中地位在元妃、大妃之下，庶妃之上者。"],["备史","","犹言全史。如：宋范垧、林禹着有《吴越备史》。"],["备详","","1) 周备详尽。\n2) 详细说明；详细见于。"],["倾容","","低头哈腰、谄媚事人的样子。亦借指谄媚的小人。"],["僧斋","","请僧而供养斋食，兼有诵经略仪，谓之“僧斋”。"],["僭滥","","《诗‧商颂‧殷武》：“不僭不滥，不敢怠遑。”"],["仪康","","仪狄杜康的并称。古代传说中，二人以善酿着名。"],["亿丑","","1) 谓官有十万类属。\n2) 泛指品类极多。"],["元坛","","即赵玄坛，道教所奉的财神，亦称“赵公元帅”。"],["光精","","1) 容光焕发；精神焕发。\n2) 光辉清澈。"],["入谒","","进见，请见。一般用于臣对君、下对上、幼对长。"],["内封","","指书籍封面后印有书名的单页。有时和扉页不分。"],["公礼","","1) 官方的礼节。\n2) 指送给官家的礼物。"],["六署","","南朝齐尚书左右仆射、左右丞所领导的六个官署。"],["兵寇","","1) 敌兵或乱兵的侵扰。\n2) 乱兵和贼寇。"],["兵忌","","1) 兵家的忌日。\n2) 谓兵家所当避忌者。"],["兼功","","1) 谓因依存而得功绩。\n2) 谓加倍劳作。"],["再辱","","1) 再次蒙受耻辱。\n2) 谓两人先后受辱。"],["冒践","","1) 犹冒涉。\n2) 谦词。谓非分而居其位。"],["冕绂","","古代礼冠与印绶，皆大官所服佩者，因以指重臣。"],["冠剑","","古代官员戴冠佩剑，因以“冠剑”指官职或官吏。"],["冤报","","1) 谓判罪不当使人冤屈。\n2) 冤冤相报。"],["冥曹","","1) 谓阴间官吏。\n2) 地府，阴间的官府。"],["冰兔","","神话传说谓月中有白兔，故以“冰兔”代称月亮。"],["冰弦","","琴弦的美称。传说中有用冰蚕丝作的琴弦，故称。"],["几舄","","《诗‧豳风‧狼跋》：“公孙硕肤，赤舄几几。”"],["凡伦","","1) 人世伦常；普通伦常。\n2) 平庸之辈。"],["凶急","","1) 凶恶暴烈。\n2) 指凶恶暴烈的人或事。"],["函活","","《诗‧周颂‧载芟》：“播厥百谷，实函斯活。”"],["函舆","","指车轿类乘坐之具。亦泛指天之所覆、地之所载。"],["刁调","","1) 动摇貌。多形容草木。\n2) 形容风声。"],["刉珥","","谓割取禽兽之血而行祭礼。割兽曰刉，割禽曰珥。"],["列辟","","1) 指诸侯，历代君主。\n2) 指公卿诸官。"],["割削","","1) 削减。\n2) 犹切割。\n3) 犹剥削。"],["加笄","","谓以簪束发。古时女子十五岁始加笄，表示成年。"],["劫尘","","1) 凡尘，人世。\n2) 谓兵火战乱之余烬。"],["劲势","","I\n谓强而有力的态势。\nII\n犹势头，情势。"],["劳情","","1) 谓劳费精神；苦思。\n2) 忧愁的感情。"],["劝慕","","谓因受奖勉而有所企慕、向往(多指倾心向善)。"],["勿齿","","1) 不愿意提及。表示鄙视。\n2) 不录用。"],["化迹","","1) 变化之迹；教化之迹。\n2) 神灵之迹。"],["北纮","","传说中北方极远之地的山名。八紘之一，即委羽。"],["北邻","","1) 指北方的邻国。\n2) 指在北侧的邻居。"],["匣椟","","匣子和柜子。泛指盛物的器具。椟，木匣；木柜。"],["匾窄","","1) 低矮狭窄。\n2) (心胸)不开阔宽广。"],["匿瑕","","1) 比喻人器量大能包容。\n2) 掩藏缺点。"],["半千","","1) 唐员余庆的别名。\n2) 金雷渊的别号。"],["卒时","","1) 尽时。谓度过三个月。\n2) 度过时日。"],["南辫","","古指我国西南的少数民族。其俗编发为辫，故称。"],["南迁","","1) 迁都南方。\n2) 被贬谪、流放到南方。"]]