[["歇息牌","","表示正在休息，不接待宾客的告示牌。"],["正统论","","对我国历代王朝的正位与闰位的论定。"],["水八阵","","即八阵图。因其聚石布于水边，故称。"],["水哨马","","旧时水军用的轻便快艇。也称快哨船。"],["水济济","","1) 犹水汪汪。\n2) 犹湿漉漉。"],["沈默默","","亦作“沉默默”。\n默不作声的样子。"],["河东戒","","指唐代文学家柳宗元的寓言《三戒》。"],["泰东西","","泛指欧美和东亚、南亚、东南亚各国。"],["淌板船","","即躺板船。一种专载客、走长途的船。"],["净水瓶","","道教和佛教贮清水洗手或作法用的瓶。"],["清道旗","","古代官员等外出时仪仗队所持的旗帜。"],["湘山祠","","供奉湘水神的庙宇。在洞庭湖君山上。"],["沧海君","","秦时一贤者之号。沧，也写作“仓”。"],["火石袋","","贮放火石的袋子。古代作为一种服饰。"],["灶披楼","","方言。在楼上的小房间。又称亭子间。"],["乌剌赤","","元时称驿站牧马者。也称“兀剌赤”。"],["无上乘","","佛教浯。谓至极之佛法。大乘之别名。"],["无任徒","","古代指无技能或无法取保的劳役刑徒。"],["无辜鸟","","传说中姑获鸟的别名。俗亦呼为鬼鸟。"],["然犀角","","传说点燃犀牛角可以照见水中之怪物。"],["烟萝子","","相传为古代学仙得道者。亦泛指隐士。"],["照骨宝","","传说中的古镜名。能映现内脏和骨骼。"],["烦恼贼","","佛教语。谓烦恼伤人之性，有如盗贼。"],["热闹场","","1) 热闹的场所。\n2) 指官场。"],["燕家景","","指北宋画家燕文季所绘的四时风景画。"],["营生子","","方言。犹劳什子。泛指所厌恶的东西。"],["爆流泉","","即趵突泉。在山东省济南市西门桥南。"],["狐魅疾","","旧谓被狐蛊惑所致的一种精神错乱病。"],["狝猴江","","佛教语。古印度的佛教五大道场之一。"],["献纳院","","唐时朝廷专管臣民书奏呈文等的机构。"],["玉交杯","","玉制的交饮杯。借指男女交饮的美酒。"],["玉亭亭","","1) 犹亭亭玉立。\n2) 高洁貌。"],["玉印符","","道教指盖有印章可以镇妖驱邪的符箓。"],["玉蟾宫","","本指月宫。后称科考中式为入玉蟾宫。"],["瑞锦窠","","唐代对礼部员外郎或礼部郎中的称呼。"],["琼田草","","玉芝的异名。古人以为食之可以长生。"],["甲乙科","","科举考试甲乙二科的合称。泛指科第。"],["瘊子甲","","古代青堂羌用冷锻法制造的一种坚甲。"],["白公桧","","唐诗人白居易任苏州刺史时所植之桧。"],["白篷船","","白竹篷的小船。多见于浙江绍兴一带。"],["白练裙","","1) 白绢制的裙。\n2) 戏曲名。"],["白羊车","","以白羊曳引的车。亦泛指轻便的车子。"],["白面馆","","旧时出售或供人吸食毒品白面的场所。"],["百乳彝","","周代酒器。周围有二百十六乳，故名。"],["百像图","","专供画像者临摹的各种人物头像图册。"],["皇业钱","","五代后晋天福时藩邸主事所铸的私钱。"],["看乐子","","方言。犹言看笑话。幸灾乐祸的意思。"],["真珠船","","用真珠装饰的船。比喻极珍贵的事物。"],["瞒裆裤","","有裆的裤子。以别于无裆的套裤而言。"],["瞻地者","","考察地下古器物的人。指考古工作者。"],["短长吟","","长吟和短吟。吟，诗体名。借指作诗。"],["砚子冢","","春秋时晋赵简子的坟，形如砚，故名。"],["碧涧羹","","用芹菜、芝麻、茴香、盐等制成的羹。"],["碧玲珑","","碧绿空明的假山石。亦指苍翠的山峰。"],["碧霭霭","","1) 澄澈貌。\n2) 浓郁苍翠貌。"],["神上使","","东汉黄巾军领袖张曼成起兵时的称号。"],["神武旗","","清代帝王出行仪仗中乘舆旗饰之一种。"],["秃鲁麻","","元代僧人为罪人祈福免罪的佛事活动。"],["稠膏蕈","","一种寄生在稠木上的伞状菌类，可食。"],["积善局","","旧时民间组织的办理慈善事业的机构。"],["窝窝鞋","","方言。暖鞋。即北方通称的“毛窝”。"],["竹扬杴","","一种农具。以竹制成，用于抛扬谷物。"],["竹火笼","","一种内置瓦器、可供燃香的竹编香笼。"],["竹雀战","","指打麻将。因麻将牌多系竹制，故名。"],["笤帚星","","扫帚星。彗星的俗称。常用以作比喻。"],["等忽儿","","亦作“等会儿”。\n谓过不久的时间。"],["节目牌","","指演出场所门口告示上演节目的木板。"],["纱屉子","","指窗户的内层。内层木屉糊纱，故名。"],["县父母","","旧时对知县之尊称。喻其如民之父母。"],["县针篆","","小篆的一种体式。相传为汉曹喜所创。"],["纵横术","","指以辩才陈述利害、游涗君主的方法。"],["罗刹江","","钱塘江别名。因江中有罗刹石而得名。"],["翠羽被","","以翡翠羽制成的背帔。被，同“帔”。"],["老父母","","旧时对地方官的敬称。谓其爱民如子。"],["耍私情","","为了私情而做不合法或不合道理的事。"],["耍花盘","","耍盘子。杂技节目。参见“耍盘子”。"],["肉桃子","","方言。指皮厚、不出浆汁的罂粟果实。"],["苦春头","","指春季里青黄不接、生活困苦的时候。"],["蛇漠疮","","旧谓蝮蛇所吐涎沫触人身而成的恶疮。"],["蜉蝣岛","","岛名。在山东省莱州市。俗称芙蓉岛。"],["虾蟆精","","传说月中的蟾蜍。亦泛指成精的虾蟆。"],["装堂花","","五代时供宫中装饰厅堂的一种花鸟画。"],["西益宅","","向西面扩充旧居。古代以为不祥之事。"],["要路津","","重要的道路和渡口。比喻显要的职位。"],["见在佛","","现在佛。三世佛之一。亦用作调侃语。"],["讨饶头","","方言。物已买就之后，要求增益少许。"],["访外护","","谓寻求外人福庇使炼丹之术得以见效。"],["艳阳年","","1) 犹春时。\n2) 喻青春年华。"],["豹皮囊","","豹皮做的袋子。用以藏墨，可防潮湿。"],["贺印钱","","指以祝贺新官到任为名而索取的钱财。"],["贺兰仙","","即何仙姑。传说中的女仙。八仙之一。"],["赛神会","","用仪仗、箫鼓、杂戏迎神，集会酬祭。"],["踏猛子","","扎猛子。游泳时头朝下钻到水里潜泳。"],["踝蹄婆","","旧时对妓女的贬称。踝，用同“裸”。"],["踹浑水","","比喻利用混乱的局面，趁机捞取便宜。"],["军下卒","","指县令出行时充当护卫和开道的士兵。"],["辘轳剑","","剑名。剑首以玉作辘轳形为饰，故名。"],["转关桥","","我国古代用人力绞盘转动的守城吊桥。"],["辟司徒","","春秋时主管垒壁之官。辟，通“壁”。"],["辟恶车","","秦代仪卫车，因用以祓除不祥，故称。"],["迎霜宴","","古时重阳节前后邀客相饮所设的宴席。"],["迎风板","","旧时新官上任后显示威风的一种做法。"],["追复脯","","脯名。传说食一片而复生一片，故名。"],["透骨金","","传说中的宝物名。凡物近之即成金色。"],["造国手","","指在治理国家方面具有卓异才能的人。"],["逼汗草","","香草名。散发的香气能驱除汗液气味。"],["道德腊","","道教五斋祭日之一。指农历七月七日。"],["递步哨","","由若干人组成的依次传送情报的哨兵。"],["遮须国","","传说中的国名。国王为三国时的曹植。"],["遗腹孙","","谓怀孕儿媳妇于儿子死后所生的男孩。"],["还魂纸","","即再生纸。用废旧纸作原料造出的纸。"],["乡良人","","春秋齐掌一乡的官吏。相当于乡大夫。"],["酆城气","","本谓丰城剑气。后比喻人的豪情壮志。"],["酒闷子","","一种扁形盛酒器，可以带在身边随饮。"],["醉翁操","","本琴曲。自苏辛入词，遂沿用为词牌。"],["酱瓜儿","","1) 用酱腌制的瓜。\n2) 讥笑。"],["金粟堆","","指陕西蒲城东北金粟山唐玄宗的陵墓。"],["钓璜溪","","相传周吕尚曾钓于渭之滨，因指渭河。"],["银香球","","银制的球状香炉，用来取暖兼薰衣被。"],["钱锅子","","植立于地面的铁条，供作套铜钱之戏。"],["錾口儿","","碎银子。银子用时要凿成小块，故称。"],["铁唤头","","旧时剃头匠人等用来招揽顾客的响铁。"],["铁胎弓","","一种强劲的弓。弓内含有铁胎，因称。"],["长夜国","","比喻荒淫侈靡、浑浑噩噩的生活状态。"],["闲踢蹬","","亦作“闲踢蹬”。\n随便走动；闲行。"],["阪泉师","","黄帝征伐蚩尤的军队。借指正义之师。"],["阴阳镜","","迷信谓可以照见阴间的人和物的镜子。"],["陶令宅","","晋诗人陶潜的家宅。后用指隐者居所。"],["集字诗","","摘取前人诗赋中的字词