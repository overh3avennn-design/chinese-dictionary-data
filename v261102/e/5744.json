]}],["以书为御","yǐshūwéiyù","按照书本上学来的知识去驾驭马匹。比喻死守教条，难以成事。",{"a":1,"w":[2262,81,550,7809]}],["怡堂燕雀","yítángyànquè","怡安适。小鸟住在安适的堂屋里。比喻身处险境也不自知的人。",{"a":1,"w":[10883,7695,19636]}],["贻厥孙谋","yíjuésūnmóu","贻遗留；厥其，他的；谋计谋，打算。为子孙的将来作好安排。",{"a":1,"w":[540701,7936,8000]}],["一点灵犀","yīdiǎn língxī","①指犀角上有纹，两头感应通灵，故比喻心心相印。②指聪敏。",{"a":1,"w":[9074,67608]}],["扬清抑浊","yángqīngyìzhuó","犹扬清激浊。比喻抨击、清除坏人坏事，表彰、发扬好人好事。",{"a":1,"w":[7578,4617,8091,8559]}],["养鹰飏去","yǎngyīngyángqù","比喻怀有野心的人不易控制，当其得意之时就不再为主人所用。",{"a":1,"w":[582,8542,72942,61]}],["眼饧耳热","yǎn táng ěrrè","两眼半睁半闭，朦胧而视，双耳燥热。形容饮酒微醉时的感觉。",{"a":1,"w":[551,15398,72207]}],["言多伤幸","yánduōshāngxìng","话多易出问题，以致言行不一，使品行受损害。同言多伤行”。",{"a":1,"w":[7440,21,1358,8065]}],["研精钩深","yánjīnggōushēn","钩深探取深沉的东西。研究探索精微的道理，探求深奥的学问。",{"a":1,"w":[96820,7696,1343]}],["血债累累","xuèzhàilěilěi","血债未报的杀人深仇；累累形容很多。指杀人很多，罪恶极大。",{"a":1,"w":[63170,25441]}],["旭日初升","xùrì chūshēng","早晨的太阳刚刚从东方升起。比喻充满活力、生气勃勃的景象。",{"a":1,"w":[49651,136547]}],["心痒难揉","xīnyǎngnánróu","指心中有某种意念或情绪起伏不定，无法克制。同心痒难挠”。",{"a":1,"w":[56450,117,5043]}],["心痒难抓","xīnyǎngnánzhuā","指心中有某种意念或情绪起伏不定，无法克制。同心痒难挠”。",{"a":1,"w":[56450,117,1439]}],["下乔迁谷","xià qiáoqiān gǔ","用来比喻人从光明走向黑暗，或者从良好的处境而进入劣境。。",{"a":1,"w":[17,54575,7701]}],["仙姿佚貌","xiānzīyìmào","仙子的姿质，秀逸的容貌。形容女子出色的姿容。佚，通逸”。",{"a":1,"w":[262531,10701,8217]}],["膝行肘步","xīxíngzhǒubù","用膝盖和肘部匍匐前进。形容地位低下，不足以与人平起平坐。",{"a":1,"w":[282964,9286,1337]}],["五经扫地","wǔjīngsǎodì","五经借指文人。把文人的脸都丢尽了。旧时也指圣人之道泯灭。",{"a":1,"w":[18560,17241]}],["无胫而行","wújìng'érxíng","胫小腿。没有腿而能行走。比喻事物用不着推行，能迅速传播。",{"a":1,"w":[2255,13941,2267,8]}],["文章魁首","wénzhāng kuíshǒu","魁首为首的，这里指名列第一。形容文章写得最好，文才极高。",{"a":1,"w":[1642,91846]}],["稳操胜算","wěn cāo shèngsuàn","稳有把握；操掌握；胜算能够制胜的计谋。指有把握取得胜利。",{"a":1,"w":[2346,1037780]}],["万绪千端","wànxùqiānduān","绪丝头。比喻事情的开端，头绪非常多。也形容事情复杂纷乱。",{"a":1,"w":[131549,587,4659]}],["万绪千头","wànxùqiāntóu","绪丝头。比喻事情的开端，头绪非常多。也形容事情复杂纷乱。",{"a":1,"w":[131549,587,509]}],["枉曲直凑","wǎngqǔzhícòu","指在弯曲的路上却笔直地往前走。形容人笨拙死板而不知变通。",{"a":1,"w":[164194,1294,8789]}],["涂歌里抃","túgēlǐbiàn","路途的人歌诵，里巷的人抃舞。形容百姓欢欣快乐的升平景象。",{"a":1,"w":[7866,208,30,49028]}],["兔走鹘落","tùzǒugǔluò","比喻动作敏捷。也比喻绘画或写文章迅捷流畅。见兔起鹘落”。",{"a":1,"w":[3426,107,16222,2275]}],["退藏于密","tuìcángyúmì","后退隐藏于秘密之处，不露行迹。谓哲理精微深邃，包容万物。",{"a":1,"w":[196835,4621,2299]}],["偷安旦夕","tōu'ān dànxī","偷安苟且求安；旦夕早晚，形容时间短。只图眼前的一时安逸。",{"a":1,"w":[79473,20550]}],["投木报琼","tóumùbàoqióng","原指男女相爱互赠礼品◇用以指报答他人对待自己的深情厚谊。",{"a":1,"w":[2288,7435,1318,8471]}],["同明相照","tóngmíngxiāngzhào","指二光相互映照而愈明。比喻杰出人物得贤者揄扬而声名更显。",{"a":1,"w":[4611,7431,7427,1326]}],["同条共贯","tóngtiáogòngguàn","条枝条；贯钱串。长在同一枝条上。比喻事理相通，脉络连贯。",{"a":1,"w":[4611,556,2273,8062]}],["天地长久","tiāndìchángjiǔ","形容时间悠久。也形容永远不变（多指爱情）。同天长地久”。",{"a":1,"w":[9159,6395]}],["碎首糜躯","suìshǒumíqū","头颅粉碎，身躯糜烂。犹言粉身碎骨。多指为某种目的而献身。",{"a":1,"w":[3359,2310,149042]}],["死有余僯","sǐ yǒuyú lìn","犹死有余辜。形容罪大恶极，即使处死刑也抵偿不了他的罪恶。",{"a":1,"w":[1329,12803]}],["死有余责","sǐyǒuyúzé","犹死有余辜。形容罪大恶极，即使处死刑也抵偿不了他的罪恶。",{"a":1,"w":[1329,12803,7765]}],["死有余诛","sǐyǒuyúzhū","犹死有余辜。形容罪大恶极，即使处死刑也抵偿不了他的罪恶。",{"a":1,"w":[1329,12803,9317]}],["死有余罪","sǐyǒuyúzuì","犹死有余辜。形容罪大恶极，即使处死刑也抵偿不了他的罪恶。",{"a":1,"w":[1329,12803,4686]}],["说古道今","shuōgǔdàojīn","从今到古无所不谈，无不评论。形容话题广泛。同说古谈今”。",{"a":1,"w":[266444,511,7811]}],["殊勋异绩","shūxūn yì jì","殊突出。勋功勋。异不同。指功勋业绩卓越。亦作殊勋茂绩”。",{"a":1,"w":[292429,7464,8634]}],["束身自好","shùshēnzìhào","束身约束自己，不使放纵；自好要求自己好。指保持自身纯洁。",{"a":1,"w":[121182,75775]}],["视死犹归","shìsǐyóuguī","把死看得象回家一样平常。形容不怕牺牲生命。同视死如归”。",{"a":1,"w":[7494,1329,8070,2317]}],["十人九慕","shírénjiǔmù","慕羡慕。十个人见了有九个人羡慕。形容才貌出众，人人羡慕。",{"a":1,"w":[93,3,143,8745]}],["十日并出","shírìbìngchū","①古代神话传说天本有十个同时出现的太阳。②比喻暴乱并起。",{"a":1,"w":[52532,1377,22]}],["神鬼不测","shénguǐbùcè","神灵鬼怪都不能揣度。极言事情的隐秘奇异。亦作神鬼难测”。",{"a":1,"w":[46696,20588]}],["伤风败化","shāngfēngbàihuà","指败坏社会风俗。多用来遣责道德败坏的行为。同伤风败俗”。",{"a":1,"w":[19786,2345,1272]}],["少不经事","shàobùjīngshì","少年轻；更经历。年纪轻，没有经历过什么事情。指经验不多。",{"a":1,"w":[126,216831]}],["舌挢不下","shéjiǎobùxià","挢翘起。翘起舌头，久久不能放下。形容惊讶或害怕时的神态。",{"a":1,"w":[7844,15639,9096]}],["舍策追羊","shěcèzhuīyáng","放下手中书本去寻找丢失的羊。比喻发生错误以后，设法补救。",{"a":1,"w":[7531,7673,172685]}],["善颂善祷","shànsòngshàndǎo","关于颂扬，关于祝祷。用来称赞能在颂扬之中带有规劝的意思。",{"a":1,"w":[7657,8972,9677]}],["三头对案","sāntóuduì'àn","指有关双方在证人或中间人在场时一起对质，讲清楚事情真相。",{"a":1,"w":[18638,40,7610]}],["三日新妇","sānrì xīnfù","旧时过门三日之新妇，举止不得自专。因以喻行动备受拘束者。",{"a":1,"w":[15683,19089]}],["入邦问俗","rù bāng wènsú","到别的国家或地方去，先要了解它的风俗习惯。同入国问俗”。",{"a":1,"w":[4615,7918,36204]}],["若存若亡","ruòcúnruòwáng","有时记在心里，有时则忘记掉。用以形容若有若无，难以捉摸。",{"a":1,"w":[4652,1349,7763]}],["如蹈汤火","rúdǎotānghuǒ","蹈踩；汤滚水。如同在滚水、烈火中行走一样。比喻处境艰险。",{"a":1,"w":[4614,8509,47177]}],["日异月新","rìyìyuèxīn","指发展或进步迅速，不断出现新事物、新气象。同日新月异”。",{"a":1,"w":[50,7464,101,80]}],["人涉卬否","rénshè'ángfǒu","别人涉水过河，而我独不渡◇用以比喻自有主张，不随便附和。",{"a":1,"w":[3,7925,13309,8585]}],["人生如寄","rénshēng rú jì","寄寓居，暂住。指人的生命短促，就象暂时寄居在人世间一样。",{"a":1,"w":[1606,4614,2358]}],["人生若寄","rénshēngruòjì","指人的生命短促，就象暂时寄居在人世间一样。同人生如寄”。",{"a":1,"w":[1606,4652,2358]}],["群居穴处","qúnjūxuéchǔ","原始人类聚群而居，住于山洞之中。比喻粗野无知，见闻浅陋。",{"a":1,"w":[38623,377492]}],["攘人之美","rǎngrénzhīměi","攘窃取、夺取。夺取别人的好处。形容窃取他人的利益和好处。",{"a":1,"w":[9099,3,2254,1310]}],["穷极要妙","qióngjíyàomiào","形容精妙到极点，多形容音乐。亦作穷极其妙”、穷妙极巧”。",{"a":1,"w":[72788,229837]}],["穷泉朽壤","qióngquán xiǔ rǎng","穷泉泉下，地层深处；朽壤腐烂的土壤。指人死后埋葬的地方。",{"a":1,"w":[148250,9194,8583]}],["穷日之力","qióngrì zhī lì","穷意尽。原指一天之内，使尽全力。比喻尽一天的力量、工夫。",{"a":1,"w":[102632,2254,1276]}],["穷猿奔林","qióngyuánbēnlín","穷猿被猎人紧追的猿猴。比喻在穷困中急于找一个栖身的地方。",{"a":1,"w":[2372,9346,8195,7469]}],["穷猿投林","qióngyuántóulín","穷猿被猎人紧追的猿猴。比喻在穷困中急于找一个栖身的地方。",{"a":1,"w":[2372,9346,2288,7469]}],["轻口轻舌","qīng kǒuqīng shé","指说话轻率，言语随便。也比喻人爱说俏皮话。同轻嘴薄舌”。",{"a":1,"w":[595,175494,7844]}],["青山一发","qīngshānyīfà","青山远望，其轮廓仅如发丝一样。形容极其遥远。也借指中原。",{"a":1,"w":[13984,11736]}],["浅见寡闻","qiǎnjiànguǎwén","浅见肤浅的见解；寡闻听到的很少。形容见闻不广，所知不多。",{"a":1,"w":[80294,78435]}],["敲金击石","qiāojīnjīshí","金、石指钟磬一类的乐器。演奏钟磬等乐器。也形容声音铿锵。",{"a":1,"w":[2458,1270,7506,7419]}],["巧立名色","qiǎo lìmíng sè","变着法定出一些名目来达到某种不正当的目的。同巧立名目”。",{"a":1,"w":[1421,74402,2266]}],["千金一壸","qiānjīn yī kǔn","比喻物虽轻贱，关键时得其所用，却十分珍贵。同千金一瓠”。",{"a":1,"w":[10413,5,27156]}],["千随百顺","qiānsuíbǎishùn","随追随；顺顺从。形容完全顺随别人，别人要怎么样就怎么样。",{"a":1,"w":[587,1375,133,4660]}],["弃若敝屣","qìruòbìxǐ","敝破；屣鞋。象扔破鞋一样把它扔掉。比喻毫不可惜地抛弃掉。",{"a":1,"w":[7931,4652,146019]}],["七搭八扯","qīdābāchě","形容说话漫无边际，没有中心。纠缠；乱搭腔。同七搭八搭”。",{"a":1,"w":[134,4708,145,8529]}],["瓶罄罍耻","píng qìng léichǐ","①比喻关系密切，相互依存，彼此利害一致。②形容物伤其类。",{"a":1,"w":[671,10860,114352]}],["目不别视","mùbùbiéshì","眼睛不往别处看。形容精神集中，专心致志。亦作目不旁视”。",{"a":1,"w":[7465,0,69,7494]}],["目乱睛迷","mùluànjīngmí","形容所见情景复杂纷繁或怪异多变，令人惊异。同目乱精迷”。",{"a":1,"w":[7465,1360,8993,1384]}],["磨砻底厉","mólóngdǐlì","指四种质地和颜色不同的磨石。也指磨砺锻炼。同磨砻砥砺”。",{"a":1,"w":[223050,752285]}],["磨礲砥砺","mólóngdǐlì","指四种质地和颜色不同的磨石。也指磨砺锻炼。同磨砻砥砺”。",{"a":1,"w":[4677,442089,31861]}],["母慈子孝","mǔcí zǐxiào","母亲慈祥爱子，子女孝顺父母，是封建社会所提倡的道德风范。",{"a":1,"w":[81101,207434]}],["明德惟馨","míngdé wéi xīn","明德美德；惟是；馨散发的香气。真正能够发出香气的是美德。",{"a":1,"w":[20641,9009,9550]}],["腼颜人世","miǎn yán rénshì","腼颜表现出惭愧的脸色。形容丧气失节，厚颜无耻地活在世上。",{"a":1,"w":[160532,19600]}],["民康物阜","mínkāngwùfù","阜多。人民平安，物产丰富。形容社会安定，经济繁荣的景象。",{"a":1,"w":[7434,7742,7412,9656]}],["貌是心非","mào shì xīnfēi","表面做的与心里想的完全两样。比喻表里不一。同貌是情非”。",{"a":1,"w":[8217,48,45084]}],["卖头卖脚","màitóumàijiǎo","犹言抛头露面。原指妇女出现在大庭广众之中。现指公开露面。",{"a":1,"w":[151672,634,602]}],["慢易生忧","mànyì shēng yōu","慢疏慢；易轻易；忧忧愁。疏慢轻易必然坏事，因而产生忧愁。",{"a":1,"w":[139240,508,8112]}],["论黄数白","lùnhuángshùbái","①指任意评论是非好坏。②点了黄金又数白银。极言财富之多。",{"a":1,"w":[7480,530,527,24]}],["马空冀北","mǎkōngjìběi","伯乐将冀北之良马搜选一空。比喻执政者善选贤才，无所遗漏。",{"a":1,"w":[1273,1274,10582,132]}],["露己扬才","lùjǐyángcái","显露自己的才能。也比喻炫耀才能，表现自己。同露才扬己”。",{"a":1,"w":[4674,7767,7578,603]}],["零珠碎玉","líng zhū suìyù","比喻零碎的却值得珍惜的事物。亦作零珠断璧”、零珠片玉”。",{"a":1,"w":[181,7784,76810]}],["敛声屏气","liǎnshēngbǐngqì","敛收入束；屏抑止。抑制语声和呼吸。形容畏惧、小心的样子。",{"a":1,"w":[8878,3317,44057]}],["脸红筋涨","liǎnhóngjīnzhǎng","形容发急或发怒时面部红胀，青筋暴起的样子。同脸红筋暴”。",{"a":1,"w":[23598,8060,3507]}],["两豆塞耳","liǎngdòusāi'ěr","比喻为局部的或暂时的现象所迷惑，不能认清全局或看到根本。",{"a":1,"w":[96,7557,33052]}],["两耳塞豆","liǎng'ěrsāidòu","比喻为局部的或暂时的现象所迷惑，不能认清全局或看到根本。",{"a":1,"w":[49584,4630,7557]}],["两叶掩目","liǎngyèyǎnmù","如同两片树叶遮住了眼睛。比喻受到蒙蔽而对事物分辨不清楚。",{"a":1,"w":[96,7426,129401]}],["量力度德","liànglìduódé","衡量自己的德行是否能够服人，估计自己的能力是否能够胜任。",{"a":1,"w":[24541,513,7416]}],["撩火加油","liáohuǒjiāyóu","犹言火上加油。在一旁助威增加他人的愤怒或助长事态的发展。",{"a":1,"w":[296990,773]}],["兰艾难分","lán'àinánfēn","兰香草名，比喻贤者；艾臭草，比喻小人∶人、坏人难于分清。",{"a":1,"w":[83617,20000]}],["兰薰桂馥","lánxūnguìfù","薰、馥香气。原比喻恩泽长留，历久不衰◇用来称人子肖孙贤。",{"a":1,"w":[7450,9237,8044,11491]}],["狼餐虎噬","lángcān hǔ shì","①形容吃东西又猛又急。同狼餐虎咽”。②比喻残酷剥削搜括。",{"a":1,"w":[116146,359902]}],["狼吃幞头","lángchīfútóu","狼衔去人的幞头，吞不下又吐不出。比喻有苦难言，强自忍耐。",{"a":1,"w":[7960,108,92287]}],["刻足适屦","kèzúshìjù","屦麻制的单底鞋。按照鞋的大小来削自己的脚。比喻主次颠倒。",{"a":1,"w":[626,4625,7671,10982]}],["开花结实","kāihuājiéshí","比喻修养、学习、工作等有了成绩，取得效果。同开华结果”。",{"a":1,"w":[2598,2047]}],["开利除害","kāi lì chúhài","犹言兴利除弊。兴办对国家人民有益利的事业，除去各种弊端。",{"a":1,"w":[31,4606,34070]}],["裾马襟牛","jūmǎjīnniú","像马牛穿上人的衣服。比喻没有头脑和无知。亦作襟裾马牛”。",{"a":1,"w":[19947,1273,8612,1346]}],["局外之人","júwài zhī rén","局外原指棋局之外，引申为事外。指与某件事情没有关系的人。",{"a":1,"w":[31212,2254,3]}],["举世混浊","jǔshìhúnzhuó","举全；混浊不清明。世上所有的人都不清不白。比喻世道昏暗。",{"a":1,"w":[33476,7049]}],["距人千里","jù rén qiānlǐ","形容傲气极大，不愿与人接近或毫无商量的余地。距，通拒”。",{"a":1,"w":[7632,3,9306]}],["惊惶万状","jīnghuángwànzhuàng","惊惶害怕；万状各种样子，表示程度极深。形容害怕到了极点。",{"a":1,"w":[35932,69061]}],["矜贫恤独","jīnpínxùdú","矜怜悯；恤周济；独老年无子的人。怜悯救助贫苦和孤独的人。",{"a":1,"w":[8903,7999,8783,7561]}],["谨谢不敏","jǐnxièbùmǐn","犹言敬谢不敏。用作自谦或推托之辞。不敏，不聪明，无能力。",{"a":1,"w":[8625,7570,40238]}],["尽美尽善","jìnměijìnshàn","尽极。极其完善，极其美好。形容事物完无缺。同尽善尽美”。",{"a":1,"w":[4675,1310,7657]}],["进谗害贤","jìnchán hài xián","谗谗言，说他人的坏话；贤贤良，指好人。说坏话，陷害好人。",{"a":1,"w":[202444,3353,8050]}],["进利除害","jìn lì chúhài","犹言兴利除害。兴办对国家人民有益利的事业，除去各种弊端。",{"a":1,"w":[71,4606,34070]}],["解衣般礴","jiěyībānbó","脱衣箕坐。指神闲意定，不拘形迹◇亦指行为随便，不受拘束。",{"a":1,"w":[40885,204363]}],["浆酒藿肉","jiāngjiǔhuòròu","把酒肉当作水浆、豆叶一样。形容饮食的奢侈。同浆酒霍肉”。",{"a":1,"w":[7883,594,12808,116]}],["降本流末","jiàngběnliúmò","犹言舍本逐末。比喻不抓根本环节，而只在枝节问题上下功夫。",{"a":1,"w":[2305,135811,2329]}],["剑首一吷","jiànshǒuyīxuè","吷象声词，形容声音微小。比喻言论无足轻重。同剑头一吷”。",{"a":1,"w":[44636,5,79824]}]]