,2292]}],["油殿","yóudiàn","古代皇家用油布帐幕临时张设的殿堂。",{"a":1,"w":[547,8493]}],["沿心","yánxīn","1) 犹由衷。\n2) 顺心；适心。",{"a":1,"w":[4747,1279]}],["沿身","yánshēn","1) 犹周身；浑身。\n2) 随身。",{"a":1,"w":[4747,7456]}],["泉舶","quánbó","指宋元时从泉州出发航行的中国船只。",{"a":1,"w":[3461,10739]}],["泓碧","hóngbì","指水色清澈碧绿。亦指清澈碧绿的水。",{"a":1,"w":[21036,8659]}],["法味","fǎwèi","佛教语。谓因参悟妙法而产生的悦乐。",{"a":1,"w":[2258,7712]}],["法寺","fǎsì","大理寺的别称。泛指掌管刑狱的官署。",{"a":1,"w":[2258,4822]}],["泛授","fànshòu","古代指不按考绩制度规定而普授官职。",{"a":1,"w":[8013,8099]}],["泛菊","fànjú","古人指重阳节登山宴饮菊花酒的活动。",{"a":1,"w":[8013,8188]}],["波蹅","bōchǎ","1) 坎坷不平貌。\n2) 犹厮缠。",{"a":1,"w":[7433,41722]}],["泥缄","níjiān","古人书函多以泥封，后因以借指书信。",{"a":1,"w":[4651,10315]}],["泰室","tàishì","山名。即嵩山。在今河南省登封县北。",{"a":1,"w":[7662,1359]}],["洗妆","xǐzhuāng","1) 梳洗打扮。\n2) 洗除妆饰。",{"a":1,"w":[161,8268]}],["洗渭","xǐwèi","在渭水清洗耳内污浊之声，以示高洁。",{"a":1,"w":[161,13751]}],["洗祓","xǐfú","古代沐浴斋戒以除灾求福的祭祀活动。",{"a":1,"w":[161,18605]}],["洗路","xǐlù","谓扫除前进道路上的敌人或其他障碍。",{"a":1,"w":[161,54]}],["洛宴","luòyàn","指周公卜都洛邑，因流水以泛酒之事。",{"a":1,"w":[7534,8323]}],["洪壮","hóngzhuàng","1) 高大健壮。\n2) 洪亮雄壮。",{"a":1,"w":[7977,8135]}],["洪隧","hóngsuì","大火。指强烈的闪电。隧，通“燧”。",{"a":1,"w":[7977,8814]}],["流亮","liúliàng","1) 流畅明白。\n2) 流转响亮。",{"a":1,"w":[519,641]}],["流奔","liúbēn","1) 流亡，逃亡。\n2) 谓变迁。",{"a":1,"w":[519,8195]}],["流磻","liúpán","谓习射。磻，结于箭身丝绳上的石块。",{"a":1,"w":[519,32137]}],["流美","liúměi","1) 流畅华美。\n2) 流畅动听。",{"a":1,"w":[519,1310]}],["流驶","liúshǐ","1) 犹流逝。\n2) 飞快地移动。",{"a":1,"w":[519,8139]}],["浪宕","làngdàng","1) 游荡无定。\n2) 指浪荡子。",{"a":1,"w":[7832,14535]}],["浮侈","fúchǐ","1) 浮华奢侈。\n2) 华而不实。",{"a":1,"w":[4670,9324]}],["浮脆","fúcuì","1) 轻浮不实。\n2) 空虚脆弱。",{"a":1,"w":[4670,3491]}],["浮诡","fúguǐ","1) 浮华怪异。\n2) 虚伪诡诈。",{"a":1,"w":[4670,8845]}],["浮诞","fúdàn","1) 虚妄荒谬。\n2) 轻浮放荡。",{"a":1,"w":[4670,8377]}],["海井","hǎijǐng","传说中一种能使海水变为甘泉的宝器。",{"a":1,"w":[528,4671]}],["海汐","hǎixī","海潮。白天的称为潮，夜间的称为汐。",{"a":1,"w":[528,14470]}],["涉阅","shèyuè","1) 谓经历。\n2) 涉猎，阅读。",{"a":1,"w":[7925,8211]}],["涵受","hánshòu","1) 犹包容。\n2) 浸润，滋润。",{"a":1,"w":[10042,1324]}]