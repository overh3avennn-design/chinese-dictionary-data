37,0,585]}],["一剑之任","yījiànzhīrèn","指以一人一剑之力。指作战的士兵，犹言一人之勇。亦指独力担任艰巨的任务。",{"a":1,"w":[5,4730,76048]}],["颜骨柳筋","yángǔliǔjīn","指颜柳两家书法挺劲有力，但风格有所不同。也泛称书法极佳。同颜筋柳骨”。",{"a":1,"w":[8117,7537,7802,8060]}],["颜精柳骨","yánjīngliǔgǔ","指颜柳两家书法挺劲有力，但风格有所不同。也泛称书法极佳。同颜筋柳骨”。",{"a":1,"w":[8117,4629,93284]}],["燕翼贻谋","yànyìyímóu","燕安；翼敬；贻遗留。原指周武王谋及其孙而安抚其子◇泛指为后嗣作好打算。",{"a":1,"w":[173488,177617]}],["喧客夺主","xuānkèduózhǔ","客人占了主人的地位，或外来的、次要的事物占了原有的、主要的事物的地位。",{"a":1,"w":[10574,7618,4759,7425]}],["悬崖撒手","xuányásāshǒu","①比喻人至绝境，只能另作选择，义无反顾。②指在紧急关头，放下一切不管。",{"a":1,"w":[25446,16613]}],["行香挂牌","xíngxiāngguàpái","学政到省后例行的仪式。行香到孔丘庙烧香。挂牌出牌公告考试地点、日期等。",{"a":1,"w":[212797,16282]}],["舄乌虎帝","xìwūhǔdì","因舄”与乌”、虎”和帝”字形相近，同经传抄，容易写错。指文字抄传错误。",{"a":1,"w":[17774,7520,3337,7840]}],["武断专横","wǔduànzhuānhéng","武断只凭主观想象作判断。专横专制强横。形容凭借权势独断专行，蛮横跋扈。",{"a":1,"w":[103257,96525]}],["物在人亡","wùzàirénwáng","人死了，东西还在。指因看见遗物而引起对死者的怀念，或因此而引起的感慨。",{"a":1,"w":[7412,52,3,7763]}],["无置锥地","wúzhìzhuīdì","没有立锥子的地方。比喻连极小的地方也没有◇常形容贫穷。同无立锥之地”。",{"a":1,"w":[2255,7529,7992,10]}],["五零二落","wǔlíng'èrluò","犹言七零八落。形容零散稀疏的样子。特指原来又多又整齐的东西现在零散了。",{"a":1,"w":[106,181,91,2275]}],["文理俱惬","wénlǐ jù qiè","文、理指文辞表达和思想内容；惬满足、满意。文章的形式和内容都令人满意。",{"a":1,"w":[23937,8196,20907]}],["闻噎废食","wényēfèishí","听到有人吃饭噎了一下，自己就连饭也不吃了。比喻因为怕出问题，索性不干。",{"a":1,"w":[629,10955,7711,7466]}],["天高听卑","tiāngāo tīng bēi","卑低下。原指上天神明可以洞察人间最卑微的地方。旧时称好的帝王了解民情。",{"a":1,"w":[20869,146,8402]}],["随声是非","suíshēng shìfēi","别人说是，自己也说是；别人说不是，自己也说不是。指毫无主见，一味盲从。",{"a":1,"w":[110288,5027]}],["鉥肝刿肾","shùgānguìshèn","比喻用尽心思。多形容为事业、工作、文艺创作等用心的艰苦。同鉥心刿目”。",{"a":1,"w":[442056,4739,40843,8679]}],["鉥心刿目","shùxīnguìmù","犹言呕心沥血。比喻用尽心思。多形容为事业、工作、文艺创作等用心的艰苦。",{"a":1,"w":[442056,1279,294651]}],["鉥心刿肾","shùxīnguìshèn","比喻用尽心思。多形容为事业、工作、文艺创作等用心的艰苦。同鉥心刿目”。",{"a":1,"w":[442056,1279,40843,8679]}],["水火兵虫","shuǐhuǒ bīng chóng","指使古书遭受损毁的四种灾害水灾、火灾、战乱和书蠹。也泛指各种天灾人祸。",{"a":1,"w":[13036,638046]}],["蜀锦吴绫","shǔjǐn wúlíng","蜀锦四川生产的彩锦；吴绫绫的一种，最初出于吴郡。泛指各种精美的丝织品。",{"a":1,"w":[109719,191787]}],["施衿结褵","shījīnjiélí","本指古代女子出嫁，母亲将五彩丝绳和佩巾结于其身◇比喻父母对子女的教训。",{"a":1,"w":[7507,11664,753376]}],["十浆五馈","shíjiāngwǔkuì","十家卖浆者之中有五家争先送来。本指卖浆者争利，后用以比喻争相设宴款待。",{"a":1,"w":[93,7883,106,8692]}],["神差鬼遣","shénchàguǐqiǎn","好象有鬼神在支使着一样，不自觉地做了原先没想到要做的事。同神差鬼使”。",{"a":1,"w":[3316,121,3340,8864]}],["神使鬼差","shénshǐguǐchà","好象有鬼神在支使着一样，不自觉地做了原先没想到要做的事。同神差鬼使”。",{"a":1,"w":[223069,574623]}],["茹古涵今","rúgǔhánjīn","犹言博古通今。对古代的事知道得很多，并且通晓现代的事情。形容知识丰富。",{"a":1,"w":[8598,1322,10042,7811]}],["入圣超凡","rùshèng chāofán","凡指凡人，普通人。超越平常人而达到圣贤的境界。形容学识修养达到了高峰。",{"a":1,"w":[97020,51920]}],["任重致远","rènzhòngzhìyuǎn","指负载沉重而能到达远方◇比喻抱负远大，能闯出新的前景，做出宏伟的业绩。",{"a":1,"w":[22457,19231]}],["求志达道","qiú zhì dádào","指隐居以保全自己的意志，行义以贯彻自己的主张。是儒家一种理想的人生观。",{"a":1,"w":[598,7626,179199]}],["秋扇见捐","qiūshànjiànjuān","见被；捐弃。秋凉以后，扇子就被抛在一边不用了。旧时比喻妇女遭丈夫遗弃。",{"a":1,"w":[177769,76,3490]}],["清宫除道","qīnggōng chúdào","清、除洒水扫除；宫古代房屋的通称。打扫房屋和道路。指准备迎接贵宾到来。",{"a":1,"w":[31581,171563]}],["青黄未接","qīnghuáng wèijiē","旧粮已经吃完，新粮尚未接上。也比喻人才或物力前后接不上。同青黄不接”。",{"a":1,"w":[30174,51587]}],["攀车卧辙","pānchēwòzhé","拉住车辕，躺在车道上，不让车走。旧时用作挽留好官的谀词。同攀辕卧辙”。",{"a":1,"w":[8491,32,62332]}],["喷血自污","pēnxuèzìwū","含血喷人，却先污己口。比喻本欲恶毒地污蔑、攻击他人，结果却先害了自己。",{"a":1,"w":[119146,2256,7785]}],["南冠楚囚","nánguānchǔqiú","南冠楚国在南方，因此称楚冠为南冠。本指被俘的楚国囚犯◇泛称囚犯或战俘。",{"a":1,"w":[113898,103976]}],["木落归本","mùluòguīběn","犹言叶落归根。比喻事物总有一定的归宿。多指作客他乡的人最终要回到本乡。",{"a":1,"w":[719191,2317,42]}],["满而不溢","mǎn'érbùyì","器物已满盈但不溢出。比喻有资财而不浪用，有才能而不自炫，善于节制守度。",{"a":1,"w":[592,2267,0,8852]}],["轮扁斫轮","lúnbiǎnzhuólún","轮扁春秋时齐国有名的的造车工人；斫轮用刀斧砍木制造车轮。指精湛的技艺。",{"a":1,"w":[142340,11020,2280]}],["落魄不偶","luòpòbù'ǒu","古代一种迷信观念，认为偶数好，奇数不好。落魄倒霉、潦倒；不偶运气不好。",{"a":1,"w":[21824,0,7888]}],["马牛襟裾","mǎniú jīnjū","襟、裾泛指人的衣服。马、牛穿着人衣。比喻人不懂得礼节。也比喻衣冠禽兽。",{"a":1,"w":[30480,370362]}],["率尔成章","shuài'ěrchéngzhāng","率尔不经思索，随意地。不加思索，下笔成文。形容写文章粗疏草率，不认真。",{"a":1,"w":[124018,18253]}],["流落天涯","liúluòtiānyá","天涯天边，指极远的地方。穷困潦倒，到处漂泊。形容生活不安定，极为困苦。",{"a":1,"w":[44370,18131]}],["利傍倚刀","lì bàng yǐdāo","倚靠着。利”的偏旁是刀字，意指追求私利犹如倚在刀口上。比喻贪利常得祸。",{"a":1,"w":[4606,9059,237342]}],["离经畔道","líjīng pàndào","①指思想、言行背离儒家经典和规范。②指背离占统治地位的思想和行为规范。",{"a":1,"w":[71926,231857]}],["礼为情貌","lǐwéiqíngmào","意谓一个人的礼仪容止为内心的显现。情，情意；貌，容仪。貌和情互为表里。",{"a":1,"w":[3342,550,7490,8217]}],["阑风长雨","lánfēngchángyǔ","阑珊的风，冗多的雨。指夏秋之际的风雨◇亦泛指风雨不已。亦作阑风伏雨”。",{"a":1,"w":[380617,515,159]}],["聚敛无厌","jùliǎn wúyàn","聚敛搜刮，盘剥。厌饱，满足。尽力收刮钱财，永远也不满足。形容非常贪婪。",{"a":1,"w":[62000,41323]}],["捐忿弃瑕","juānfènqìxiá","忿怨恨。瑕玉上的斑痕裂纹，比喻旧有的嫌隙。抛弃怨恨和嫌隙。指重归于好。",{"a":1,"w":[3490,10017,7931,9428]}],["九原可作","jiǔyuánkězuò","九原春秋时晋国卿大夫的墓地在九原，因称墓地；作起，兴起。设想死者再生。",{"a":1,"w":[181963,69788]}],["酒酣耳熟","jiǔhān ěr shú","酒酣饮酒尽兴而痛快。耳热指面红过耳，非常兴奋。形容酒兴很浓，喝得痛快。",{"a":1,"w":[78414,47321]}],["金龟换酒","jīnguīhuànjiǔ","金龟袋名，唐代官员的一种佩饰。解下金龟换美酒。形容为人豁达，恣情纵酒。",{"a":1,"w":[12659,599,594]}],["解人难得","jiěrénnándé","解人原指通达言语或文辞意趣的人，借指知己；难得不易得到。比喻知己难得。",{"a":1,"w":[51101,4150]}],["降妖捉怪","xiángyāozhuōguài","原指有法术的人可以降伏妖精，捉拿鬼怪◇比喻以强大的力量战胜凶恶的敌人。",{"a":1,"w":[64709,4941,2379]}],["怀真抱素","huái zhēn bàosù","真纯真。素质朴的本色。指人格和品德纯洁高尚，质朴无华。亦作怀质抱真”。",{"a":1,"w":[7749,85,254872]}],["怙恩恃宠","hù ēn shìchǒng","怙依靠。恃凭借，依靠。凭借别人所给予的恩泽和宠幸而横行霸道、骄横妄为。",{"a":1,"w":[20725,7704,93733]}],["红衰翠减","hóngshuāicuìjiǎn","红指花；翠指绿叶§花衰败，绿叶减少。形容春尽花残或初秋百花凋谢的景象。",{"a":1,"w":[534,7950,7928,2328]}],["浩气凛然","hàoqì lǐnrán","浩气即正气，刚直正大的精神；凛然严肃，令人敬畏的样子∑然之气令人敬畏。",{"a":1,"w":[727677,76024]}],["豪情逸致","háoqíng yìzhì","豪情指兴奋豪放的感情；逸致悠闲脱俗的情趣。兴奋豪放的情感和洒脱的情趣。",{"a":1,"w":[54059,76685]}],["耕耘树艺","gēngyún shùyì","耘锄草，树栽植；艺播种。耕田、锄草、植树、播种。泛指各种农业生产劳动。",{"a":1,"w":[16326,54639]}],["革旧维新","gé jiù wéixīn","革废除；维新反对旧的，提倡新的。专指政治上的改良。改变旧的，提倡新的。",{"a":1,"w":[7633,1396,19438]}],["高垒深沟","gāolěi shēngōu","垒壁垒，军营四周所筑围墙。沟战壕。高筑壁垒，深挖壕沟。指强固防御工事。",{"a":1,"w":[45278,81388]}],["改玉改步","gǎiyù gǎibù","指死者身份改变，安葬礼数也应变更◇指改变制度或改朝换代。同改步改玉”。",{"a":1,"w":[70293,95036]}],["改玉改行","gǎiyùgǎixíng","指死者身份改变，安葬礼数也应变更◇指改变制度或改朝换代。同改步改玉”。",{"a":1,"w":[70293,68009]}],["腹心相照","fùxīnxiāngzhào","腹心内心；照映照，见。以真心相见。比喻彼此很知心，达到心心相印的程度。",{"a":1,"w":[29112,7427,1326]}],["风谲云诡","fēngjuéyúnguǐ","谲欺诈；诡欺诈，怪诞。风云怪诞，变幻不定。比喻局势复杂多变，神秘怪诞。",{"a":1,"w":[44,11277,554,8845]}],["粉身灰骨","fěnshēnhuīgǔ","身体粉碎而死。比喻为了某种目的或遭到什么危险而丧失生命。同粉身碎骨”。",{"a":1,"w":[59207,3344,7537]}],["丰肌秀骨","fēngjīxiùgǔ","丰润的肌肤，柔嫩的骨骼。形容女子或花朵娇嫩艳丽而有丰韵。同丰肌弱骨”。",{"a":1,"w":[267508,8040,7537]}],["蜚英腾茂","fēiyīng téng mào","蜚同飞”。英指名声。茂指实际。指人的名声与事业日益昌盛。同飞声腾实”。",{"a":1,"w":[154280,7985,8915]}],["匪匪翼翼","fěi fěi yìyì","匪匪马行走不停的样子；翼翼有次序的样子。形容车马行走时阵容整齐、威武。",{"a":1,"w":[8863,21167]}],["笃近举远","dǔjìnjǔyuǎn","笃忠实，厚道；举举荐，盐。对关系近的厚道，对关系远的举荐，指同等待人。",{"a":1,"w":[9188,574,606,103]}],["冬温夏凊","dōngwēn xià qìng","凊凉。冬天使父母温暖，夏天使父母凉爽。本指人子孝道。现亦泛称冬暖夏凉。",{"a":1,"w":[76121,1397,77926]}],["动心怵目","dòngxīn chù mù","怵目使人看了感到恐惧。看了使人感到内心恐惧。形容感受很深，震动非常大。",{"a":1,"w":[30136,14389,7465]}],["道义之交","dàoyì zhī jiāo","交交情，友谊。有道德有正义感的交往和友情。指互相帮助，互相支持的朋友。",{"a":1,"w":[20525,2254,535]}],["寸步千里","cùnbù qiānlǐ","寸步指距离非常短。虽然相距只有寸步，却如同千里之隔。比喻相见非常困难。",{"a":1,"w":[37269,9306]}],["辞微旨远","cíwēizhǐyuǎn","辞文词，言词。微隐蔽，精深。旨意思，目的。言词隐微而表达的意思很深远。",{"a":1,"w":[7757,73553,103]}],["川泽纳污","chuānzénàwū","以湖泊江河能容纳各种水流的特性。比喻人有涵养，能包容所有的善恶、毁誉。",{"a":1,"w":[754370,7454,7785]}],["吹大法螺","chuī dàfǎ luó","法螺做佛事时用的乐器。原比喻佛之说法广被大众◇借以讽刺吹牛皮，说大话。",{"a":1,"w":[637,17027,7596]}],["出云入泥","chūyúnrùní","指自己一旦青云直上，便不惜将旧时朋友踩入泥中。比喻人情浇薄，世态炎凉。",{"a":1,"w":[96389,4615,4651]}],["朝经暮史","zhāojīngmùshǐ","经指旧时奉为经典的书籍；史指历史书籍。一天到晚诵读经史。形容勤奋读书。",{"a":1,"w":[1357,7421,8841,7661]}],["超世拔俗","chāoshì bású","原指佛教徒功夫深，已超出尘世◇多形容才德远远超过平常人。同超尘出俗”。",{"a":1,"w":[28018,117669]}],["不遑宁息","bùhuángníngxī","没有闲暇的时间过安宁的日子。指忙于应付繁重或紧急的事务。同不遑宁处”。",{"a":1,"w":[127553,246521]}],["病骨支离","bìnggǔzhīlí","支离残缺不全，引伸为憔悴、衰残瘦弱的样子。形容病中体瘦骨露，衰弱无力。",{"a":1,"w":[162762,47922]}],["剥肤椎髓","bōfūchuísuǐ","剥剥去；肤皮肤；椎捶击。剥人皮肤，敲人骨髓。比喻极其残酷地压榨和剥削。",{"a":1,"w":[167028,8683,8423]}],["奔逸绝尘","bēnyìjuéchén","奔逸疾驰；绝尘脚不沾尘土。形容走得极快。也形容人才十分出众，无人企及。",{"a":1,"w":[143293,42104]}],["暴躁如雷","bàozàorúléi","暴暴烈，急躁。急怒叫跳，象打雷一样猛烈。形容又急又怒，大发脾气的样子。",{"a":1,"w":[40044,63899]}],["昂藏七尺","ángcángqīchǐ","昂藏登记表雄伟、气度不凡的样子；七尺七尺高的身躯。指轩昂伟岸的男子汉。",{"a":1,"w":[177643,41370]}],["傲睨一世","àonì yīshì","睨斜视。高傲地旁观，对当代的一切都不看在眼里。形容傲慢自负，目空一切。",{"a":1,"w":[195084,9644]}],["七级浮图","qī jí fútú","亦作“七级浮屠”。\n七层佛塔。浮图，梵文Buddhastūpa的音译。",{"a":1,"w":[134,564,68931]}],["三十六物","sānshíliù wù","佛教称人身有三十六种不净之物，如毛、发、爪、齿、泪、液、唾、屎、溺等。",{"a":1,"w":[16406,7412]}],["三招两式","sānzhāoliǎngshì","谓武艺不高。招，着数；式，把势，均为武术动作。亦泛指所操之术造诣甚浅。",{"a":1,"w":[74,4704,96,3311]}],["以亲为解","yǐ qīnwéi jiě","谓古代侠义之士，用父母在世有待尽孝为理由，谢绝朋友请其舍身赴难的要求。",{"a":1,"w":[2262,1338,550,4620]}],["侨终蹇谢","qiáozhōngjiǎnxiè","郑国子产(名侨)与秦国蹇叔俱为春秋时名贤。因以“侨终蹇谢”称贤者之死。",{"a":1,"w":[9640,7638,9722,7570]}],["十二时虫","shí'èrshí chóng","爬行类动物名。一名避役。蜥蜴的一种。相传能随十二时而变易其体色，故称。",{"a":1,"w":[83949,7601]}],["十家连坐","shíjiā liánzuò","旧时的一项统治办法。以十家为一组，一家犯法，其余九家如不检举，就同罪。",{"a":1,"w":[99044,96539]}],["常州画派","chángzhōu huàpài","清武进人恽格首创，以没骨法写生，一洗时习，海内学者宗之，时号常州画派。",{"a":1,"w":[36630,38229]}],["手版倒持","shǒubǎn dào chí","晋简文帝死，桓温于新亭陈兵，将不利于晋室，呼大臣谢安与王坦之，欲害之。",{"a":1,"w":[108306,131296]}],["敦煌五龙","dūnhuáng wǔ lóng","晋代敦煌人索靖、泛衷、张甝、索紾、索永的合称。因其俱有逸群之才，故称。",{"a":1,"w":[24591,106,1308]}],["减膳彻悬","jiǎnshàn chèxuán","减少肴馔和停奏音乐。古代皇帝在发生天灾或天象变异时，往往以此表示自责。",{"a":1,"w":[222245,118651]}],["发奸摘伏","fājiānzhāifú","《魏书‧良吏传‧宋世景》：“民间之事，巨细必知，发奸摘伏，有若神明。”",{"a":1,"w":[522,8125,3511,7729]}],["神行太保","shénxíng tàibǎo","元曲、《水浒传》中塑造的善走人物戴宗的绰号。今亦用以戏称赶路迅捷的人。",{"a":1,"w":[40154,14119]}],["羊真孔草","yángzhēnkǒngcǎo","南朝宋羊欣擅长隶书，孔琳之擅长草书，皆名重一时，因而并称。真，楷、隶。",{"a":1,"w":[1387,85,4636,521]}],["背奥媚灶","bèi ào mèizào","借喻背着君上而阿附权臣。语出《论语‧八佾》：“与其媚于奥，宁媚于灶。”",{"a":1,"w":[565,7481,170957]}],["处之晏然","chù zhī yànrán","同“处之泰然”。\n宋秦观《圆通禅师行状》：“事虽交至错出，处之晏然。”",{"a":1,"w":[2272,2254,110311]}],["衮实无阙","gǔnshíwúquē","衮衣无缺损。比喻帝王治理无过失。语本《诗‧大雅‧烝民》：“衮职有阙。”",{"a":1,"w":[12193,213865,8773]}],["解衣磅礡","jiěyī bàng bó","同“解衣般礡”。\n清戴名世《＜汪武曹稿＞序》：“酒阑灯灺，解衣磅礡。”",{"a":1,"w":[40885,5158,123860]}],["谷口躬耕","gǔkǒu gōnggēng","同“谷口耕”。\n闽徐夤《偶书》诗：“市门逐利终身饱，谷口躬耕尽日饥。”",{"a":1,"w":[53893,158337]}],["越扶越醉","yuèfúyuèzuì","酒醉的人，越是有人搀扶，越发使出醉态。比喻越是迁就随顺，越加纵情任性。",{"a":1,"w":[597,3458,3387]}],["退食委蛇","tuìshí wēiyí","谓退朝休息而从容自得。语本《诗‧召南‧羔羊》：“退食自公，委蛇委蛇。”",{"a":1,"w":[175704,51182]}],["雨条烟叶","yǔtiáoyānyè","1) 雨中的柳条，烟雾中的柳叶。形容凄迷的景色。\n2) 喻情意的缠绵。",{"a":1,"w":[159,556,37831]}],["云台主帅","yúntái zhǔshuài","汉明帝图画中兴功臣二十八人于云台，而以邓禹为二十八人之首，为云台主帅。",{"a":1,"w":[44085,33819]}],["郁垒神荼","yù lěi shēnshū","1) 二神名。传说善治恶鬼，故旧时民间奉为门神。\n2) 指桃符、春联。",{"a":1,"w":[69090,103429]}],["发行基金","fāxíng jījīn","社会主义国家银行为调节货币流通准备发行而尚未发行、处于准备状态的货币。",{"a":1,"w":[3702,3555]}],["江海同归","jiānghǎi tóngguī","意思是用布统的方法或做不同的道路，最后达到同一个目的或到达同一个地方。",{"a":1,"w":[28644,21806]}],["资金封套","zījīn fēngtào","funding envelope; resource envelope",{"a":1,"w":[1540,71187]}],["保留许可","bǎoliú xǔkě","retention license; retention permit",{"a":1,"w":[1707,3608]}],["不俭则匮","bùjiǎnzékuì","wastage makes one destitute (idiom)",{"a":1,"w":[0,9141,3323,13942]}],["亚洲周刊","yàzhōu zhōukān","Asiaweek (current affairs magazine)",{"a":1,"w":[2561,26822]}],["元恶大憝","yuán'èdàduì","arch-criminal and archenemy (idiom)",{"a":1,"w":[278994,119274]}],["勉力而为","miǎnlì ér wèi","to try one’s best to do sth (idiom)",{"a":1,"w":[151279,2267,550]}],["包头地区","bāotóu dìqū","Baotou prefecture in inner Mongolia",{"a":1,"w":[17574,1506]}],["同传耳麦","tóngchuán ěrmài","simultaneous interpretation headset",{"a":1,"w":[123616,224629]}],["善自珍摄","shàn zìzhēn shè","take good care of yourself! (idiom)",{"a":1,"w":[7657,67770,7746]}],["地租收入","dìzū shōurù","rent income (esp. from arable land)",{"a":1,"w":[14577,747]}],["审级制度","shěnjí zhìdù","system of appeals (to higher court)",{"a":1,"w":[85844,1447]}],["布朗克士","bùlǎngkè shì","The Bronx, borough of New York City",{"a":1,"w":[241333,7542]}],["帆张风满","fān zhāngfēng mǎn","sails unfurling in the wind (idiom)",{"a":1,"w":[8810,203574,592]}],["德惠地区","déhuì dìqū","Dehui county in Changchun 长春, Jilin",{"a":1,"w":[65591,1506]}],["捷尔梅兹","jié'ěr méizī","Termez city in southeast Uzbekistan",{"a":1,"w":[16155,29089]}],["普罗提诺","pǔluó tí nuò","Plotinus (Neoplatonism philosopher)",{"a":1,"w":[9285,561,7495]}],["款语移时","kuǎnyǔ yíshí","to talk slowly and in depth (idiom)",{"a":1,"w":[159163,101717]}],["欢容悦色","huānróng yuèsè","to look happy and contented (idiom)",{"a