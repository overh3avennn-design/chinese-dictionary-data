01,7802]}],["晋晋然","jìnjìnrán","低垂貌；俯下貌。引申为肃敬貌。",{"a":1,"w":[8291,7451]}],["普尔钱","pǔ'ěr qián","清代新疆、西藏地区通行的钱币。",{"a":1,"w":[12044,138]}],["景阳井","jǐngyángjǐng","南朝陈景阳殿之井，又名胭脂井。",{"a":1,"w":[4676,7484,4671]}],["曝衣楼","bàoyī lóu","皇宫中帝后于七月七日曝衣之处。",{"a":1,"w":[162865,174]}],["书本气","shūběn qì","指喜欢掉书袋，卖弄才学的习气。",{"a":1,"w":[28277,510]}],["书呆气","shūdāi qì","不明世事而只知死啃书本的习气。",{"a":1,"w":[335060,510]}],["望海潮","wàng hǎicháo","词牌名。调见宋柳永《乐章集》。",{"a":1,"w":[7556,167335]}],["杏花烟","xìnghuā yān","形容女子鬓发之美，如杏花含烟。",{"a":1,"w":[36489,1376]}],["杯渡松","bēidùsōng","相传为晋宋间高僧杯渡手植之松。",{"a":1,"w":[199,4780,2295]}],["东都门","dōng dūmén","汉代长安城东门之一，即宣平门。",{"a":1,"w":[87,110214]}],["柏下人","bǎi xiàrén","指墓中人。因墓地多植柏，故称。",{"a":1,"w":[7948,18673]}],["柳箧子","liǔqièzi","对唐柳璨的誉称。箧子，指书箱。",{"a":1,"w":[7802,15648,1]}],["桃枝杖","táozhī zhàng","桃枝竹制成的拐杖。为杖中佳品。",{"a":1,"w":[106103,8427]}],["桃枝簟","táozhī diàn","桃枝竹编织的席子。为席中佳品。",{"a":1,"w":[106103,25859]}],["梅红伞","méihóng sǎn","梅红色的伞盖。古代仪仗的一种。",{"a":1,"w":[148252,1432]}],["梅花障","méihuā zhàng","梅花障扇。古代帝王仪仗的一种。",{"a":1,"w":[5007,7656]}],["梨花冻","líhuā dòng","即梨花春酒。因冬酿春熟，故称。",{"a":1,"w":[21798,3397]}],["梨花蜜","líhuā mì","蜂蜜的一种。蜂采梨花所酿之蜜。",{"a":1,"w":[21798,8157]}],["梵王宫","fànwáng gōng","本指大梵天王的宫殿。泛指佛寺。",{"a":1,"w":[149087,4679]}],["棒喝党","bànghè dǎng","即法西斯党。参见“棒喝主义”。",{"a":1,"w":[30966,4685]}],["枣核笔","zǎohé bǐ","即枣心笔。一种用古法制的毛笔。",{"a":1,"w":[63454,619]}],["椒花舫","jiāohuā fǎng","清朱筠室名“椒花吟舫”的省称。",{"a":1,"w":[82537,20439]}],["杨妃粉","yángfēifěn","传说为一种可润泽肌肤的粉状土。",{"a":1,"w":[8318,11174,7613]}],["杨子院","yángziyuàn","唐盐铁转运使在杨子县所置巡院。",{"a":1,"w":[8318,1,571]}],["业窠团","yèkētuán","谓罪孽之渊。指情爱、情欲之事。",{"a":1,"w":[7418,11633,1336]}],["业贝戎","yèbèiróng","以偷为业。贝戎为“贼”的拆字。",{"a":1,"w":[7418,7553,8500]}],["楼店务","lóudiànwù","宋代地方管理房地产税务的机构。",{"a":1,"w":[174,675,7448]}],["树头酒","shùtóu jiǔ","以贝多罗树果实的汁液制成的酒。",{"a":1,"w":[188103,594]}],["橘中乐","júzhōnglè","谓弈棋之乐趣。参见“橘中戏”。",{"a":1,"w":[8816,7,1340]}],["横斗柄","héng dǒubǐng","谓北斗星的柄横斜。指拂晓时分。",{"a":1,"w":[4653,66354]}],["钦玺书","qīn xǐshū","即玺书。古代以印信封记的文书。",{"a