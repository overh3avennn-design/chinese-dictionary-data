pelter solder",{"a":1,"w":[25231,126174]}],["黑油布帽","hēiyóu bù mào","black oiled slicker cloth hat",{"a":1,"w":[53686,1283,8140]}],["黑白正片","hēibái zhèngpiàn","black and white positive film",{"a":1,"w":[10857,19029]}],["抗酵淀粉","kàng jiào diànfěn","fermentation resistant starch",{"a":1,"w":[7660,10205,13618]}],["自觉形秽","zìjuéxínghuì","本指羞愧自己的容貌举止不如别人◇也泛指与人相比，自愧不如。",{"a":1,"w":[1928,102179]}],["酌金馔玉","zhuó jīn zhuànyù","喝酒的杯子是金的，盛菜肴的器皿是玉的。极言饮宴的奢侈豪华。",{"a":1,"w":[9372,1270,70070]}],["朱雀玄武","zhūquèxuánwǔ","朱雀南方七星宿的总称。玄武北方七星宿的总称。形容阵容整齐。",{"a":1,"w":[13419,9397]}],["诸恶莫作","zhū'èmòzuò","诸恶各种坏事。佛家语，凡是坏事都不要做。旧时用以劝人行善。",{"a":1,"w":[7881,7620,7446,4608]}],["众虎同心","zhònghǔtóngxīn","许多虎一条心做事。比喻众多有本事的人团结一致，力量会更大。",{"a":1,"w":[7688,3337,10618]}],["众人国士","zhòngrén guóshì","众人普通人；国士国中杰出的人物。指一般人和国中杰出的人才。",{"a":1,"w":[11829,56273]}],["众议成林","zhòngyì chéng lín","指众人的议论可使人相信平地上出现森林。比喻流言多可以乱真。",{"a":1,"w":[29028,517,7469]}],["忠心贯日","zhōngxīn guànrì","贯贯通。忠诚之心可以贯通日月。形容忠诚至极。同忠贯白日”。",{"a":1,"w":[6607,104966]}],["指不胜偻","zhǐbùshènglǚ","形容数量很多，扳着指头数也数不过来。偻弯曲。同指不胜屈”。",{"a":1,"w":[1312,10267,10953]}],["啧啧称羡","zézéchēngxiàn","啧啧咂嘴声，表示赞叹。啧啧连声地表示羡慕。亦作啧啧称赞”。",{"a":1,"w":[26965,228869]}],["斩关夺隘","zhǎnguānduó'ài","砍断门闩，攻破城门，夺取关隘。形容军队作战勇敢，势不可挡。",{"a":1,"w":[472277,4759,10764]}],["越鸟南栖","yuèniǎonánqī","从南方飞来的鸟，筑巢时一定在南边的树枝上。比喻难忘故乡情。",{"a":1,"w":[323247,90,8477]}],["雍荣闲雅","yōng róng xiányǎ","雍荣态度大方，从容不迫；闲雅文雅。形容态度从容，举止文雅。",{"a":1,"w":[9147,7887,171993]}],["饮露餐风","yǐnlùcānfēng","喝的是露水，吃的是风。形容超凡脱俗的生活。亦作饮风餐露”。",{"a":1,"w":[640507,47437]}],["隐然敌国","yǐnrándíguó","敌国相当于一国。指对国家起举足轻重作用的人。同隐若敌国”。",{"a":1,"w":[413468,20226]}],["因风吹火","yīnfēngchuīhuǒ","因顺着。顺着风势吹火，比喻乘便行事，并不费力。常用作谦词。",{"a":1,"w":[4624,12936,1284]}],["以渴服马","yǐkěfúmǎ","使马忍渴受训，从人驱遣。比喻用苛政治民，不能使人真心顺服。",{"a":1,"w":[2262,236,92190]}],["以养伤身","yǐ yǎngshāng shēn","为了获得养育自己的条件，反而使身体受到损害。比喻得不偿失。",{"a":1,"w":[2262,116639,7456]}],["遗珠弃璧","yízhū qì bì","本指弃置不用的珍珠玉璧，比喻弃置不用的美好事物和优秀人才。",{"a":1,"w":[75123,7931,8965]}],["衣宵食旰","yīxiāoshígàn","指天未明就穿衣起身，天黑了才进食。常用以称谀帝王勤于政事。",{"a":1,"w":[7536,9364,7466,28176]}],["衣绣夜游","yīxiù yèyóu","比喻虽居官位，却不能使人看到自己的荣耀显贵。同衣绣夜行”。",{"a":1,"w":[59419,35135]}],["一寒如此","yīhán rúcǐ","一竟然；寒贫寒。竟然穷困到这样的地步。形容贫困潦倒到极点。",{"a":1,"w":[188064,3613]}],["一秉至公","yī bǐng zhìgōng","秉掌握、主持；至极、最。办事一切都出于公心。形容大公无私。",{"a":1,"w":[5,9534,58111]}],["野鹤闲云","yěhè xián yún","闲无拘束。飘浮的云，野生的鹤。旧指生活闲散、脱离世事的人。",{"a":1,"w":[95185,3381,554]}],["阳煦山立","yáng xù shānlì","象太阳那样暖和，象山岳那样屹立。比喻人性格温和，品行端正。",{"a":1,"w":[7484,12012,121502]}],["燕雀相贺","yànquèxiānghè","燕雀因大厦落成有栖身之所而互相庆贺◇多用作棕新屋落成之语。",{"a":1,"w":[19636,7427,8613]}],["言中事隐","yánzhōngshìyǐn","指言语虽然委曲却中正不偏，论事虽然放纵却隐藏着精深的道理。",{"a":1,"w":[33651,33,7652]}],["询迁询谋","xún qiān xúnmóu","指国家的安危、国都的迁徙、国君的拥立，都要征求人民的意见。",{"a":1,"w":[8379,8003,106789]}],["循名核实","xúnmínghéshí","犹言循名责实。按着名称或名义去寻找实际内容，使得名实相符。",{"a":1,"w":[7778,560,48950]}],["循名课实","xúnmíngkèshí","犹言循名责实。按着名称或名义去寻找实际内容，使得名实相符。",{"a":1,"w":[7778,560,187,7457]}],["咽苦吐甘","yànkǔtǔgān","指母亲自己吃粗劣食物，而以甘美之物哺育婴儿。形容母爱之深。",{"a":1,"w":[9066,2322,3406,7681]}],["雪碗冰瓯","xuěwǎnbīng'ōu","瓯盆碗之类的器皿。形容碗、盆器皿洁白干净。也比喻诗文清雅。",{"a":1,"w":[616,744,2318,11093]}],["雄辩高谈","xióngbiàn gāotán","辩论充分有力，言词豪放不羁。形容能言善辩。亦作高谈雄辩”。",{"a":1,"w":[21443,38400]}],["醒聩震聋","xǐng kuì zhènlóng","犹言振聋发聩。使昏昧糊涂、不明事理的人为之震惊，受到启发。",{"a":1,"w":[2424,23646,317993]}],["心如坚石","xīnrújiānshí","心象铁石一样坚硬。比喻心肠硬或意志十分坚决。同心如铁石”。",{"a":1,"w":[1279,4614,7849,7419]}],["兴兵动众","xīngbīngdòngzhòng","旧指大规模出兵。现多指动用很多人力做某件事。同兴师动众”。",{"a":1,"w":[80655,80073]}],["斜行横阵","xiéxínghéngzhèn","指飞行的雁阵。大雁飞行时或为人”字形，或为一”字形，故称。",{"a":1,"w":[3361,8,4653,2333]}],["心焦如火","xīnjiāo rúhuǒ","内心焦躁得如着火一般。形容焦灼难忍的心情，亦作心焦如焚”。",{"a":1,"w":[76483,38249]}],["小器易盈","xiǎoqì yì yíng","盈满。器物小，容易满。原指酒量小◇比喻器量狭小，容易自满。",{"a":1,"w":[55042,7463,8251]}],["晓风残月","xiǎofēngcányuè","拂晓风起，残月将落。常形容冷落凄凉的意境。也指歌妓的清唱。",{"a":1,"w":[413374,148286]}],["先行后闻","xiānxínghòuwén","比喻未经请示就先做了某事，造成既成事实，然后再向上级报告。",{"a":1,"w":[12300,43,629]}],["闲神野鬼","xiánshényěguǐ","迷信指流散的鬼神。多比喻不务正业，到处游逛，寻事生非的人。",{"a":1,"w":[3381,3316,140497]}],["无足重轻","wúzúzhòngqīng","没有它并不轻些，有它也并不重些。指无关紧要。同无足轻重”。",{"a":1,"w":[80199,49,595]}],["无胫而来","wú jìng érlái","犹无胫而行。常以喻良才不招而自至爱贤者之门。同无胫而至”。",{"a":1,"w":[2255,13941,11444]}],["无胫而走","wújìng'érzǒu","犹无胫而行。常以喻良才不招而自至爱贤者之门。同无胫而行”。",{"a":1,"w":[2255,13941,2267,107]}],["卧榻鼾睡","wòtà hānshuì","别人在自己的床铺旁边呼呼大睡。比喻别人肆意侵占自己的利益。",{"a":1,"w":[38966,37822]}],["我见犹怜","wǒjiànyóulián","犹尚且；怜爱。我见了她尚且觉得可爱。形容女子容貌美丽动人。",{"a":1,"w":[43444,8070,9532]}],["望峰息心","wàng fēng xīxīn","遥望山峦巍峨而尘念随之平息。多指遁世隐居。亦喻知难而止息。",{"a":1,"w":[7556,8122,118449]}],["添兵减灶","tiānbīng jiǎnzào","啬兵员，反而减少行军饭灶。指伪装士兵逃亡，示弱以欺骗对方。",{"a":1,"w":[279122,187526]}],["铁板不易","tiěbǎnbùyì","易变易，更改。像铁板那样不能改变。形容不变的，不可更改的。",{"a":1,"w":[11413,3996]}],["天崩地塌","tiānbēngdìtā","天崩塌，地裂陷。多比喻巨大的灾难、重大的事变或强烈的声响。",{"a":1,"w":[257796,10,4891]}],["桃羞杏让","táoxiūxìngràng","桃花和杏花都感到羞愧，只好退让。形容女子比花还要艳丽动人。",{"a":1,"w":[3386,8434,9579,627]}],["溯流穷源","sùliú qióng yuán","溯逆流而上。往河流上游寻找发源的地方。比喻寻求事物的根源。",{"a":1,"w":[77944,2372,7816]}],["随圆就方","suí yuánjiù fāng","处事顺应形势和情况的变化；待人随和而不固执。同随方就圆”。",{"a":1,"w":[1375,191622,2257]}],["四至八道","sìzhì bādào","旧时标志土地界域的用语。表示四面八方所到之处及通往的道路。",{"a":1,"w":[55227,48620]}],["司农仰屋","sīnóngyǎngwū","主管钱粮的官员一筹莫展，无计可施。形容国库空虚，财政拮据。",{"a":1,"w":[35124,94328]}],["思贤如渴","sīxiánrúkě","如渴如口渴思饮那般，形容迫切。比喻迫切的想延致有才德的人。",{"a":1,"w":[7586,8050,4614,236]}],["鼠凭社贵","shǔpíngshèguì","老鼠把窝做在土地庙下面，使人不敢去挖掘。比喻坏人仗势欺人。",{"a":1,"w":[3351,3452,3327,167]}],["守经达权","shǒujīng dáquán","经正道，原则；权权宜，变通。形容坚持原则而能变通、不固执。",{"a":1,"w":[155905,77725]}],["事宽即圆","shìkuānjíyuán","谓遇事只要从容对待，就能圆满解决。款，宽缓。同事款则圆”。",{"a":1,"w":[33,2323,7854,2301]}],["事宽则圆","shìkuānzéyuán","遇到事情只要从容对待，就能圆满解决。款宽缓。同事款则圆”。",{"a":1,"w":[33,2323,3323,2301]}],["慎终承始","shènzhōng chéng shǐ","谨慎收尾，如同开始时一样。指始终要谨慎从事。同慎终如始”。",{"a":1,"w":[31015,7576,7683]}],["升山采珠","shēngshāncǎizhū","到山上去采珍珠。比喻办事的方向、方法错误，一定达不到目的。",{"a":1,"w":[1362,45,164716]}],["身无完肤","shēnwúwánfū","①指被打得遍体鳞伤。②比喻遭到攻击或破坏后难以自存的局面。",{"a":1,"w":[7456,2255,604,8232]}],["蛇食鲸吞","shéshíjīngtūn","蛇食像蛇一样吞食。鲸吞像鲸一样吞咽。比喻强者逐步并吞弱者。",{"a":1,"w":[3363,7466,27119]}],["桑枢韦带","sāngshū wéidài","桑枢，桑木的门轴。韦带，无饰的皮革腰带◇以之形容贫家寒士。",{"a":1,"w":[193798,235223]}],["洒扫应对","sǎsǎoyìngduì","洒水扫地，酬答宾客。封建时代儒家教育、学习的基本内容之一。",{"a":1,"w":[224009,5771]}],["塞上江南","sàishàngjiāngnán","原指古凉州治内贺兰山一带◇泛指塞外富庶之地。同塞北江南”。",{"a":1,"w":[106432,13566]}],["如拾地芥","rúshídìjiè","象从地下拾起一根芥菜。比喻非常容易得到（多指官职、名位）。",{"a":1,"w":[4614,3494,10,8473]}],["戎马生郊","róngmǎ shēng jiāo","意指国家政治不上轨道，连怀胎的母马也用来作战◇指战乱不断。",{"a":1,"w":[59082,508,9158]}],["缺口镊子","quēkǒu nièzi","镊子用以拔毛，缺口镊子则不能。故用以比喻一毛不拔的吝啬鬼。",{"a":1,"w":[5422,47791]}],["鹊反鸾惊","quèfǎnluánjīng","形容字写得神采飞动，如盘旋往复的鹊鸟和鸾鸟。同鹊返鸾回”。",{"a":1,"w":[9090,2260,9528,7978]}],["裘马声色","qiúmǎ shēngsè","衣轻裘，乘肥马，醉心歌舞，迷恋女色。谓贪图享受，生活糜烂。",{"a":1,"w":[201491,16665]}],["穷理尽性","qiónglǐjìnxìng","原指彻底推究事物的道理，透彻了解人类的天性◇泛指穷究事理。",{"a":1,"w":[166725,135502]}],["穷途之哭","qióngtú zhī kū","本意是因车无路可行而悲伤，后也指处于困境所发的绝望的哀伤。",{"a":1,"w":[54021,2254,728]}],["穷阎漏屋","qióngyán lòu wū","穷阎偏僻的里巷；漏屋通陋”，狭小的房屋。指僻陋狭小的住处。",{"a":1,"w":[243601,3354,3389]}],["琼楼金阙","qiónglóujīnquè","犹琼楼玉宇。指月中宫殿，仙界楼台。也形容富丽堂皇的建筑物。",{"a":1,"w":[49245,193545]}],["秋毫见捐","qiūháojiànjuān","秋凉以后，扇子就被抛在一边不用了。早时比喻妇女遭丈夫遗弃。",{"a":1,"w":[17620,76,3490]}],["前瞻后顾","qiánzhān hòugù","看看前再看看后。有时形容顾虑过多，犹豫不决。同瞻前顾后”。",{"a":1,"w":[47218,42607]}],["逆耳良言","nì'ěr liángyán","虽然使人听起来感到刺耳，但却是有益的好话。逆抵触，不顺从。",{"a":1,"w":[44701,33541]}],["南鹞北鹰","nányàoběiyīng","鹞、鹰两种猛禽。在南为鹞子，在北为老鹰。比喻性格严峻的人。",{"a":1,"w":[90,14247,132,8542]}],["莫辨楮叶","mòbiànchǔyè","莫不；辨分辨。不能分辨楮叶的真假。比喻模仿逼真或以假乱真。",{"a":1,"w":[7446,8004,160731]}],["莫余毒也","mòyúdúyě","再也没有人威胁、桅我了。表示目空一切，认为谁也不能伤害我。",{"a":1,"w":[7446,234864,123]}],["明法审令","míngfǎshěnlìng","审谨慎。申明法令，使人人遵守，谨慎发布命令，避免出现差错。",{"a":1,"w":[46204,7781,3329]}],["腼颜天壤","miǎn yán tiānrǎng","腼颜厚着脸面。天壤天地，指人世间。形容厚着脸皮活在人世间。",{"a":1,"w":[160532,59427]}],["面缚衔璧","miànfù xiánbì","两手反绑而面向前，口含碧玉以示不生。古人用以表示投降请罪。",{"a":1,"w":[154741,157543]}],["面如满月","miàn rú mǎnyuè","脸盘圆圆的、白白的，象满月一样。形容相貌白净丰满而有神采。",{"a":1,"w":[523,4614,24898]}],["昧地谩天","mèidìmántiān","比喻昧着良心隐瞒真实情况，用谎言欺骗他人。亦作昧地瞒天”。",{"a":1,"w":[9075,10,10062,19]}],["密锣紧鼓","mìluójǐngǔ","戏剧开台前的一阵节奏急促的锣鼓。比喻公开活动前的紧张准备。",{"a":1,"w":[2299,11422,1366,3352]}],["没金铩羽","méijīnshāyǔ","指射箭入石，箭镞和箭杆后的雕翎全都隐没不见。同没金饮羽”。",{"a":1,"w":[94,1270,76476]}]]