["炊事服","chuīshì fú","cook’s overall; cooking uniform",{"a":1,"w":[47133,4619]}],["爆破线","bàopò xiàn","explosion line; detonating fuse",{"a":1,"w":[9562,1282]}],["特者法","tèzhěfǎ","method of characteristic curves",{"a":1,"w":[4607,1285,2258]}],["猪绦虫","zhū tāochóng","armed tapeworm; tapeworm of pig",{"a":1,"w":[1405,13246]}],["甲萘酚","jiǎ nàifēn","alpha naphthol; methyl naphthol",{"a":1,"w":[3330,71855]}],["电唱臂","diànchàngbì","electric gramophone pick-up arm",{"a":1,"w":[12,198,4751]}],["电瘤益","diànliúyì","beta current gain; current gain",{"a":1,"w":[12,8868,7724]}],["电阻条","diànzǔ tiáo","resistor stripe; resistor track",{"a":1,"w":[8754,556]}],["白毛虫","báimáo chóng","herba aristolochiae millissimae",{"a":1,"w":[13855,7601]}],["皂雕翎","zàodiāo líng","cinerious vulture wing and tail",{"a":1,"w":[323789,11307]}],["罪积温","zuì jīwēn","accumulated temperature of crop",{"a":1,"w":[4686,255111]}],["羊毛裤","yángmáo kù","woollen pants; woollen trousers",{"a":1,"w":[15518,9119]}],["被压树","bèiyāshù","oppressed tree; suppressed tree",{"a":1,"w":[1327,1286,109]}],["裂缝泉","lièfèng quán","fissure spring; fracture spring",{"a":1,"w":[13256,3461]}],["观赏墨","guānshǎng mò","inks for aesthetic appreciation",{"a":1,"w":[16060,7667]}],["透鸣质","tòumíngzhì","hyaline substance; vitreousness",{"a":1,"w":[2307,7935,7436]}],["钉结合","dīng jiéhé","nailed connection; nailed joint",{"a":1,"w":[7958,1554]}],["铈滴定","shì dīdìng","cerimetric titration; cerimetry",{"a":1,"w":[17932,12419]}],["长廊林","chángláng lín","fringe woodland; gallery forest",{"a":1,"w":[51280,7469]}],["不平常","bùpíng cháng","remarkable, remarkably, unusual",{"a":1,"w":[9530,99]}],["展信佳","zhǎnxìnjiā","(口语) How nice to hear from you!",{"a":1,"w":[7565,529,8154]}],["硅锗碳","guīzhětàn","SiGeC, Silicon-Germanium-Carbon",{"a":1,"w":[8381,22445,8440]}],["一抹光","yīmǒ guāng","1) 全都包括在内。\n2) 一次收拾干净。\n3) 指连成一片。",{"a":1,"w":[24478,1271]}],["一门子","yīmén zi","1) 犹言一房；一家。指宗族亲戚。\n2) 犹一种，指某一类事。",{"a":1,"w":[14805,1]}],["七大家","qīdà jiā","明李绍称唐韩愈柳宗元、宋欧阳修苏轼苏辙曾巩王安石为古文七大家。",{"a":1,"w":[13275,28]}],["三告官","sān gàoguān","宋代在禁中，唯宰相、翰林学士、御史有衙吏为之喝道，称为三告官。",{"a":1,"w":[74,75496]}],["三花树","sānhuā shù","即贝多树。一年开花三次，故名。见北魏贾思勰《齐民要术‧盘多》。",{"a":1,"w":[21116,109]}],["主人家","zhǔrénjiā","1) 主人。\n2) 仆婢及受雇佣者的家主。\n3) 特指店主人。",{"a":1,"w":[951,28]}],["九成台","jiǔchéng tái","台名。在今广东省曲江县北城上。原名闻韶台，相传舜南巡奏乐于此。",{"a":1,"w":[28265,1306]}],["佛面竹","fúmiànzhú","竹的一种，为江南竹的变种。竹的斑纹仿佛人面，故名。又名龟纹竹。",{"a":1,"w":[4682,523,7655]}],["俏冤家","qiào yuānjia","1) 对所爱者、情人的昵称。多见于元曲。\n2) 熏猪耳的别称。",{"a":1,"w":[9770,21709]}],["元规尘","yuánguīchén","东晋庾亮，字元规，以国舅身，历仕三朝，一时权倾朝野，人多趋附。",{"a":1,"w":[104,7549,7843]}],["内三关","nèi sānguān","明代以今河北境内沿内长城的居庸关、紫荆关、倒马关为“内三关”。",{"a":1,"w":[1287,50346]}],["两税使","liǎngshuì shǐ","唐代掌管夏、秋两税事务的长官，系临时派遣，多以盐铁转运使兼任。",{"a":1,"w":[125918,1332]}],["分龙节","fēnlóng jié","宋时池州以夏历正月二十九日、三十日为“分龙节”。其时常降大雨。",{"a":1,"w":[52702,540]}],["刮打嘴","guāda zuǐ","一种玩具。用泥土塑成动物等形象，当中穿线，用以抽拉，发出响声。",{"a":1,"w":[146935,609]}],["北向户","běixiàng hù","古人概念中的极南地区。因当地居民往往向北开门窗以纳日光，故称。",{"a":1,"w":[61160,2320]}],["十二街","shí'èr jiē","唐长安皇城南北七街，东西五街，因以“十二街”借指长安城的街道。",{"a":1,"w":[8641,681]}],["千日饮","qiānrìyǐn","刘玄石好饮酒，求饮“千日酒”一杯，醉眠千日。后用以为畅饮之典。",{"a":1,"w":[80394,7871]}],["升平帖","shēngpíng tiē","晋王羲之法帖名。此帖书于晋穆帝升平二年(公元358年)，故名。",{"a":1,"w":[39867,8250]}],["占排场","zhàn páichǎng","行院用语。在嫖客，谓包占妓女；在妓女，则谓于某一场所居于首位。",{"a":1,"w":[647,29392]}],["反复手","fǎnfù shǒu","1) 手一反一覆。极言其易。\n2) 手一反一覆。比喻变化无常。",{"a":1,"w":[1654,34]}],["呾刹那","dá chànà","(刹chà)梵文音译。古印度计时单位。约相当于现今的1.6秒。",{"a":1,"w":[70658,7083]}],["和声署","héshēng shǔ","本为明代之教坊司，清雍正中改为和声署，管理朝会时音乐歌舞事项。",{"a":1,"w":[19317,8264]}],["坐饿关","zuò'èguān","宗教修持方式之一。谓静坐不语，少食或断食一段时间，以净化身心。",{"a":1,"w":[128,229,65]}],["外三关","wài sānguān","明代以今河北境内沿外长城的雁门关、宁武关、偏头关为“外三关”。",{"a":1,"w":[36,50346]}],["太常妻","tàicháng qī","后汉周泽为太常，虔敬宗庙，常卧疾斋宫，其妻哀其老病，窥问疾苦。",{"a":1,"w":[62121,8353]}],["夹箔幛","jiābózhàng","方言。指用高粱秆为原料作墙壁，把室内区分成里外间。箔幛，篱笆。",{"a":1,"w":[3358,11753,20228]}],["奏事官","zòushì guān","1) 地方上派遣入朝奏事的官员。\n2) 在朝廷接递奏章的官员。",{"a":1,"w":[109193,2293]}],["女校书","nǚxiào shū","1) 唐成都名妓薛涛有文才，时人呼为女校书。\n2) 喻女才子。",{"a":1,"w":[214305,81]}],["如详缴","rúxiángjiǎo","旧时官府司法用语。谓照报告中对原案处理的办法处理，并准予销案。",{"a":1,"w":[4614,8449,8608]}],["小你你","xiǎonǐnǐ","亦作“小奶奶”。\n1) 对主人妾的称谓。\n2) 泛称青年妇女。",{"a":1,"w":[16,193]}],["屏风马","píngfēng mǎ","象棋开局的一种布局。双马并排，保护中兵(卒)，状如屏风，故名。",{"a":1,"w":[25555,1273]}],["山中相","shānzhōng xiāng","宋林逋《深居杂兴》诗之六：“幽人不作山中相，且拥图书看白云。”",{"a":1,"w":[22371,7427]}],["平码馆","píngmǎguǎn","方言。批发货物的庄行。流行于广东省西江流域以及香港、澳门等地。",{"a":1,"w":[525,7790,7919]}],["御街行","yùjiē xíng","1) 词牌名。\n2) 曲牌名。见金董解元《西厢记诸宫调》卷三。",{"a":1,"w":[184563,8]}],["思帝乡","sī dìxiāng","1) 唐教坊曲名。见唐崔令钦《教坊记‧曲名》。\n2) 词牌名。",{"a":1,"w":[7586,171037]}],["收江南","shōu jiāngnán","曲牌名。属北曲双调。字数定格据《九宫大成谱》，用在双调套曲内。",{"a":1,"w":[541,13566]}],["救数人","jiùshùrén","唐文学家温庭筠才思敏捷，科举考试时多代人作文，人称“救数人”。",{"a":1,"w":[1409,527,3]}],["新水令","xīnshuǐlìng","曲牌名。南北曲都属双调，北曲较常用，一般用作双调套曲的第一曲。",{"a":1,"w":[80,11,3329]}],["东昌纸","dōngchāngzhǐ","一种纤维较粗，质地松软的白纸，多用于糊窗户或包装。也叫毛头纸。",{"a":1,"w":[754491,622]}],["架阁库","jiàgé kù","1) 宋元时代储藏文牍案卷的机构。\n2) 指主管架阁库的官员。",{"a":1,"w":[174478,3332]}],["枫树苓","fēngshù líng","即猪苓。因多生于枫树根部，故有此称。菌核入药，子实体可供食用。",{"a":1,"w":[92848,12403]}],["桦皮脸","huàpí liǎn","厚面皮。桦木皮厚，层多，因称厚面皮为“桦皮脸”。喻不知羞耻者。",{"a":1,"w":[302710,614]}],["歌舞戏","gēwǔ xì","把乐曲、歌舞和叙事结合在一起，表演一个故事的戏剧。又称歌舞剧。",{"a":1,"w":[17007,3341]}],["毛鸦头","máoyātóu","亦作“毛丫头”。\n1) 女孩子。\n2) 指年青姑娘，用于蔑称。",{"a":1,"w":[70,51930]}],["水银浸","shuǐyín jìn","殉葬的金玉等器物，被大殓时涂于尸体上的水银所浸染而形成的斑点。",{"a":1,"w":[12000,8278]}],["沈住气","shěnzhùqì","亦作“沉住气”。\n谓在情况紧急或感情激动时克制自己，保持镇静。",{"a":1,"w":[9211,144,510]}],["沙鱼皮","shāyú pí","鲨鱼的皮。可以煮熟作羹。古代多用以装饰刀剑的柄和制成刀剑的鞘。",{"a":1,"w":[377479,1291]}],["油木梳","yóu mùshu","妇女头上插戴的一种梳子。古代歌妓常用作头饰，故又为歌妓的代称。",{"a":1,"w":[547,147163]}],["清明火","qīngmíng huǒ","《周礼‧夏官‧司爟》：“掌行火之政令，四时变国火，以救时疾。”",{"a":1,"w":[13159,1284]}],["汉东蚌","hàndōngbàng","汉东珠。蚌，蚌胎，指珍珠。旧谓蚌孕珠如人怀妊，与月的盈亏有关。",{"a":1,"w":[7539,87,10359]}],["濮上风","púshàng fēng","春秋卫地崇尚豪侠刚武，濮水在卫，故后以“濮上风”代称尚武之风。",{"a":1,"w":[95031,44]}],["无鲑菜","wú xiécài","《南史‧庾杲之传》：“﹝庾﹞清贫自业，食唯有韭菹……生韭杂菜。",{"a":1,"w":[2255,254152]}],["暖火盆","nuǎnhuǒ pén","古代除夕风俗，在庭院中架起松柏树枝，点火焚烧，谓之“暖火盆”。",{"a":1,"w":[413267,3414]}],["燕春台","yàn chūntái","词牌名。双调，九十八字。前段十句，五平韵；后段十一句，五平韵。",{"a":1,"w":[7821,74913]}],["玉枕穴","yùzhěn xué","亦省称“玉枕”。\n针灸穴位名。位于后头部，当枕外粗隆上缘外侧。",{"a":1,"w":[101795,8147]}],["环翠阁","huáncuìgé","相传为东晋名相谢安未仕时的游宴之所。故址在浙江上虞县东山之上。",{"a":1,"w":[372056,8208]}],["甜迷迷","tián mímí","1) 形容很甜。\n2) 形容柔媚的笑态。\n3) 形容轻柔舒适。",{"a":1,"w":[1501,26335]}],["百齿霜","bǎichǐshuāng","头垢的别名。见明李时珍《本草纲目‧人‧头垢》。参见“百齿梳”。",{"a":1,"w":[133,7577,8258]}],["直肚肠","zhí dùcháng","形容人性情爽直。如：小王说话痛快，从不转弯抹角，真是个直肚肠。",{"a":1,"w":[1294,335020]}],["盼辰勾","pàn chéngōu","亦作“盻辰勾”。\n比喻盼望不易盼到的事。辰勾，极难见到的水星。",{"a":1,"w":[10589,99056]}],["秘密藏","mìmì cáng","1) 佛教语。谓奥秘而不可思议的境界。\n2) 引申指奥秘之处。",{"a":1,"w":[2498,4688]}],["祗候人","zhīhòu rén","1) 古代指媵妾。\n2) 泛指旧时官府的小吏或富贵人家的仆从。",{"a":1,"w":[60816,3]}],["福字履","fúzìlǚ","又称夫子履。戏曲舞台上所用的一种鞋子。厚底，缎面，面上绣层云。",{"a":1,"w":[1365,84,7942]}],["策帽儿","cè màor","科举考试时，以策问试士，应试者作文的开头部分，俗谓“策帽儿”。",{"a":1,"w":[7673,14650]}],["绿蒲节","lǜ pújié","即端午节。民俗于端午节在门户上插绿色菖蒲与艾以祓除不祥，故称。",{"a":1,"w":[605,183404]}],["钵塞莫","bōsāimò","念珠。梵语的译音。珠多以108颗为一串，每念一佛名，即过一子。",{"a":1,"w":[10148,4630,7446]}],["老阿妈","lǎo āmā","指伯父。“阿妈”为女真语(amin，满语作ama)，意为父亲。",{"a":1,"w":[55,167031]}],["脂粉钱","zhīfěn qián","1) 旧指妇女的私蓄。\n2) 旧时向妓院征收的税捐。又称花捐。",{"a":1,"w":[41390,138]}],["蚩蚩氓","chīchī máng","敦厚而愚昧的人。语出《诗‧卫风‧氓》：“氓之蚩蚩，抱布贸丝。”",{"a":1,"w":[68016,10282]}],["蜗牛庐","wōniú lú","形圆似蜗牛的简易庐舍。亦泛指简陋的房屋。常用以谦称自己的居处。",{"a":1,"w":[27434,9988]}],["行香子","xíngxiāng zi","1) 词牌名。\n2) 曲牌名。南曲入中吕宫行，北曲入双角只曲。",{"a":1,"w":[212797,1]}],["谢亲酒","xièqīn jiǔ","宋元习俗，男女婚后三日，婿家备酒宴岳父母及媒人，称“谢亲酒”。",{"a":1,"w":[174403,594]}],["贪瞋痴","tānchēnchī","佛教语。贪欲、瞋恚与愚痴三种烦恼。此三者毒害人最剧，故称三毒。",{"a":1,"w":[8190,24126,8690]}],["卖痴呆","mài chīdāi","宋时吴中民俗，除夕小儿绕街呼叫卖痴卖呆。意谓将痴呆转移给别人。",{"a":1,"w":[634,14129]}],["赭黄袍","zhěhuáng páo","1) 天子所穿的袍服。因颜色赭黄，故称。\n2) 用以指代天子。",{"a":1,"w":[115920,9451]}],["趁汤推","chèntāngtuī","趁水滚热时把鸡鸭身上的毛推光拔净。比喻及时收拾干净，不留痕迹。",{"a":1,"w":[3570,1367,586]}],["跨青牛","kuàqīngniú","相传老子骑青牛出函谷关仙去。见《老子化胡经》。因喻指出世学道。",{"a":1,"w":[4710,143142]}],[