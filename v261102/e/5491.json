366]}],["无任徒","wúrèn tú","古代指无技能或无法取保的劳役刑徒。",{"a":1,"w":[31616,7813]}],["无辜鸟","wúgū niǎo","传说中姑获鸟的别名。俗亦呼为鬼鸟。",{"a":1,"w":[5613,581]}],["然犀角","ránxī jiǎo","传说点燃犀牛角可以照见水中之怪物。",{"a":1,"w":[426052,533]}],["烟萝子","yānluózi","相传为古代学仙得道者。亦泛指隐士。",{"a":1,"w":[1376,8406,1]}],["照骨宝","zhàogǔbǎo","传说中的古镜名。能映现内脏和骨骼。",{"a":1,"w":[1326,7537,2313]}],["烦恼贼","fánnǎo zéi","佛教语。谓烦恼伤人之性，有如盗贼。",{"a":1,"w":[2866,4718]}],["热闹场","rènao chǎng","1) 热闹的场所。\n2) 指官场。",{"a":1,"w":[2672,544]}],["燕家景","yàn jiājǐng","指北宋画家燕文季所绘的四时风景画。",{"a":1,"w":[7821,297091]}],["营生子","yíngshēng zi","方言。犹劳什子。泛指所厌恶的东西。",{"a":1,"w":[21917,1]}],["爆流泉","bào liúquán","即趵突泉。在山东省济南市西门桥南。",{"a":1,"w":[4697,48031]}],["狐魅疾","húmèi jí","旧谓被狐蛊惑所致的一种精神错乱病。",{"a":1,"w":[109827,7794]}],["狝猴江","xiǎnhóu jiāng","佛教语。古印度的佛教五大道场之一。",{"a":1,"w":[310835,2327]}],["献纳院","xiànnàyuàn","唐时朝廷专管臣民书奏呈文等的机构。",{"a":1,"w":[3435,7454,571]}],["玉交杯","yù jiāobēi","玉制的交饮杯。借指男女交饮的美酒。",{"a":1,"w":[2294,30189]}],["玉亭亭","yù tíngtíng","1) 犹亭亭玉立。\n2) 高洁貌。",{"a":1,"w":[2294,34123]}],["玉印符","yùyìnfú","道教指盖有印章可以镇妖驱邪的符箓。",{"a":1,"w":[593112,7841]}],["玉蟾宫","yùchán gōng","本指月宫。后称科考中式为入玉蟾宫。",{"a":1,"w":[153302,4679]}],["瑞锦窠","ruìjǐnkē","唐代对礼部员外郎或礼部郎中的称呼。",{"a":1,"w":[8082,7982,11633]}],["琼田草","qióngtiáncǎo","玉芝的异名。古人以为食之可以长生。",{"a":1,"w":[8471,4668,521]}],["甲乙科","jiǎyǐ kē","科举考试甲乙二科的合称。泛指科第。",{"a":1,"w":[33236,512]}],["瘊子甲","hóuzi jiǎ","古代青堂羌用冷锻法制造的一种坚甲。",{"a":1,"w":[751936,3330]}],["白公桧","báigōng guì","唐诗人白居易任苏州刺史时所植之桧。",{"a":1,"w":[142402,11378]}],["白篷船","bái péngchuán","白竹篷的小船。多见于浙江绍兴一带。",{"a":1,"w":[24,66828]}],["白练裙","báiliànqún","1) 白绢制的裙。\n2) 戏曲名。",{"a":1,"w":[469515,8880]}],["白羊车","báiyáng chē","以白羊曳引的车。亦泛指轻便的车子。",{"a":1,"w":[26481,32]}],["白面馆","báimiàn guǎn","旧时出售或供人吸食毒品白面的场所。",{"a":1,"w":[23220,7919]}],["百乳彝","bǎirǔyí","周代酒器。周围有二百十六乳，故名。",{"a":1,"w":[133,7719,9828]}],["百像图","bǎixiàngtú","专供画像者临摹的各种人物头像图册。",{"a":1,"w":[133,589,1301]}],["皇业钱","huángyè qián","五代后晋天福时藩邸主事所铸的私钱。",{"a":1,"w":[206731,138]}],["看乐子","kàn lèzi","方言。犹言看笑话。幸灾乐祸的意思。",{"a":1,"w":[122,107