,4752]}],["瞎火兵","xiāhuǒ bīng","比喻丧失作战能力的士兵。",{"a":1,"w":[202366,2282]}],["石牌楼","shípái lóu","门洞式的纪念性石建筑物。",{"a":1,"w":[153535,174]}],["石乡侯","shí xiānghóu","游戏文章中对石砚的戏称。",{"a":1,"w":[7419,140323]}],["砂镴钱","shālàqián","用锡和铅的合金所制的钱。",{"a":1,"w":[8419,25602,138]}],["砑纸版","yà zhǐbǎn","用以碾压印制笺纸的木版。",{"a":1,"w":[21091,42267]}],["硬挣子","yìngzheng zi","强有力地替人家撑腰的人。",{"a":1,"w":[180817,1]}],["碧玉椽","bìyù chuán","碧玉做的椽子。亦喻绿竹。",{"a":1,"w":[19804,15100]}],["祝尧龄","zhùyáolíng","古时祝贺帝王寿诞的歌曲。",{"a":1,"w":[1473,9836,8362]}],["祝盗方","zhùdàofāng","古代祈免盗患的一种方术。",{"a":1,"w":[1473,8038,2257]}],["神仙肚","shénxiān dù","形容料事如神，足智多谋。",{"a":1,"w":[5382,8407]}],["禅师窟","chánshī kū","禅门；僧人聚集习禅之所。",{"a":1,"w":[71185,9601]}],["科学诗","kēxué shī","以自然科学为题材的诗歌。",{"a":1,"w":[638,2369]}],["科目儒","kēmù rú","指追求科举功名的读书人。",{"a":1,"w":[5838,8257]}],["科目记","kēmù jì","记载登科士人情况的簿册。",{"a":1,"w":[5838,110]}],["移景法","yíjǐng fǎ","古代类似幻灯的传影方法。",{"a":1,"w":[506340,2258]}],["穆护子","mùhùzi","乐府曲名。即《穆护砂》。",{"a":1,"w":[7865,4643,1]}],["空洒洒","kōng sǎsǎ","形容胸怀洒脱，毫无牵挂。",{"a":1,"w":[1274,57490]}],["空王佛","kōngwáng fú","佛教语。过去世千佛之一。",{"a":1,"w":[231643,4682]}],["空索索","kōng suǒsuǒ","形容胸中洒脱，毫无牵挂。",{"a":1,"w":[1274,36713]}],["空豁豁","kōnghuō huō","形容一切空虚，毫无牵挂。",{"a":1,"w":[183256,8714]}],["竹尊者","zhú zūnzhě","谓竹林中最长最大的竹子。",{"a":1,"w":[7655,81898]}],["竺干学","zhúgànxué","亦作“笁乾学”。\n佛学。",{"a":1,"w":[9386,46,13]}],["笔如椽","bǐrúchuán","喻大手笔或重要的文墨之事",{"a":1,"w":[619,4614,15100]}],["等身图","děngshēn tú","指与人物身高相等的图像。",{"a":1,"w":[28674,1301]}],["策高驾","cègāojià","犹言策高足。高驾即上驾。",{"a":1,"w":[7673,35,7879]}],["节孝坊","jiéxiào fāng","旧时旌表节孝妇女的牌坊。",{"a":1,"w":[82503,8643]}],["篆籀笔","zhuànzhòu bǐ","写篆文和籀文所用的笔法。",{"a":1,"w":[129027,619]}],["红芙蓉","hóng fúróng","本指唐敬宗所宠爱之舞妓。",{"a":1,"w":[534,10515]}],["红头军","hóngtóu jūn","指红巾裹头的农民起义军。",{"a":1,"w":[12016,7467]}],["素心人","sùxīn rén","心地纯洁、世情淡泊的人。",{"a":1,"w":[45194,3]}],["紫水精","zǐshuǐ jīng","即紫水晶。精，同“晶”。",{"a":1,"w":[90639,4629]}],["绊脚索","bànjiǎo suǒ","为绊翻行人而敷设的绳索。",{"a":1,"w":[86770,7470]}],["丝竹会","sīzhú huì","有丝竹弹奏以