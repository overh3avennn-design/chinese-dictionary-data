[["仙穴","xiānxué","传说有仙人遗迹的山洞。",{"a":1,"w":[7740,8147]}],["仙舆","xiānyú","指御辇，皇家用的车驾。",{"a":1,"w":[7740,8330]}],["仙龛","xiānkān","供陈灵牌、神像的小室。",{"a":1,"w":[7740,11186]}],["令箴","lìngzhēn","指帝王规戒臣下的诏令。",{"a":1,"w":[3329,13367]}],["仰哺","yǎngbǔ","谓依靠他人哺养、供养。",{"a":1,"w":[4742,9935]}],["仰属","yǎngshǔ","仰望，敬仰。属，注目。",{"a":1,"w":[4742,1268]}],["仲忽","zhònghū","相传周代“八士”之一。",{"a":1,"w":[8481,8123]}],["仲起","zhòngqǐ","相传伏羲氏的六佐之一。",{"a":1,"w":[8481,29]}],["任信","rènxìn","信任。相信而敢于托付。",{"a":1,"w":[1331,529]}],["企咏","qǐyǒng","谓以吟咏寄托向往之情。",{"a":1,"w":[7937,10025]}],["企附","qǐfù","因景仰前人而附会其事。",{"a":1,"w":[7937,7718]}],["伍侯","wǔhóu","谓编民为伍，相为侯望。",{"a":1,"w":[8730,8170]}],["伍旋","wǔxuán","方言。谓动作缓慢迟钝。",{"a":1,"w":[8730,7532]}],["伎船","jìchuán","以歌舞色相为业的游船。",{"a":1,"w":[11385,621]}],["伏利","fúlì","尚未开发的物资、财源。",{"a":1,"w":[7729,4606]}],["伭冥","xiánmíng","玄冥。雨师。一说水神。",{"a":1,"w":[113434,8508]}],["伯忽","bóhū","蒙古语称鹿为“伯忽”。",{"a":1,"w":[7608,8123]}],["伯昌","bóchāng","即周文王。姓姬，名昌。",{"a":1,"w":[7608,8186]}],["伯讨","bótǎo","谓方伯讨伐有罪的诸侯。",{"a":1,"w":[7608,8102]}],["伸歇","shēnxiē","方言。谓舒展肢体休息。",{"a":1,"w":[3412,3462]}],["但割","dàngē","谓袒露上身，宰割牲畜。",{"a":1,"w":[726,4723]}],["但马","dànmǎ","古代仪仗队中备用的马。",{"a":1,"w":[726,1273]}],["佐享","zuǒxiǎng","犹配享。谓陪同受祭祀。",{"a":1,"w":[7955,8182]}],["佗乡","tuóxiāng","他乡，家乡以外的地方。",{"a":1,"w":[11656,3375]}],["佚道","yìdào","逸道，使百姓安乐之道。",{"a":1,"w":[10701,511]}],["佛婆","fúpó","指尼姑庵中的老年女仆。",{"a":1,"w":[4682,8137]}],["佛扃","fújiōng","佛寺的门户。借指佛寺。",{"a":1,"w":[4682,15982]}],["佛火","fúhuǒ","指供佛的油灯香烛之火。",{"a":1,"w":[4682,1284]}],["佛钵","fúbō","相传为佛陀所用的食钵。",{"a":1,"w":[4682,10148]}],["佛记","fújì","佛的悬记，即佛的预言。",{"a":1,"w":[4682,110]}],["作健","zuòjiàn","成为强者。谓奋发称雄。",{"a":1,"w":[4608,8022]}],["作兵","zuòbīng","指担任维修任务的士兵。",{"a":1,"w":[4608,2282]}],["作裙","zuòqún","劳作时用于防护的围裙。",{"a":1,"w":[4608,8880]}],["佹异","guǐyì","奇异，与平常的不一样。",{"a":1,"w":[19832,7464]}],["侍射","shìshè","谓举行射礼时在旁侍候。",{"a":1,"w":[8870,3312]}],["侑斝","yòujiǎ","侑觞，劝酒。斝，酒器。",{"a":1,"w":[33698,50889]}],["侑柬","yòujiǎn","礼单。亦借指酬赠礼品。",{"a":1,"w":[33698,12372]}],["侔状","móuzhuàng","描摹物状，指摹写景物。",{"a":1,"w":[22420,7511]}],["侮诮","wǔqiào","以轻慢的态度加以讥嘲。",{"a":1,"w":[10067,20147]}],["便孽","biànniè","指擅长谄媚进谗的佞人。",{"a":1,"w":[3336,9764]}],["促辔","cùpèi","谓拉紧缰绳，催马速行。",{"a":1,"w":[8438,13007]}],["促音","cùyīn","因发音急促而成的合音。",{"a":1,"w":[8438,7498]}],["俄俄","é'é","庄严貌。俄，通“峨”。",{"a":1,"w":[7693]}],["俊侣","jùnlǚ","才智杰出的同伴、朋友。",{"a":1,"w":[8835,10478]}],["俚柔","lǐróu","南诏语“百姓”的音译。",{"a":1,"w":[11165,8134]}],["俯起","fǔqǐ","身处卑屈的地位而奋起。",{"a":1,"w":[8380,29]}],["保奏","bǎozòu","向朝廷推荐人并予担保。",{"a":1,"w":[1292,4777]}],["保强","bǎoqiáng","恃势逞强，谓不服管辖。",{"a":1,"w":[1292,1314]}],["保界","bǎojiè","谓守河山之险以为疆界。",{"a":1,"w":[1292,4639]}],["保终","bǎozhōng","谓保全至终，安然无患。",{"a":1,"w":[1292,7638]}],["信必","xìnbì","谓诚实不欺，必定做到。",{"a":1,"w":[529,3335]}],["修剔","xiūtī","修整，把不合用的剔除。",{"a":1,"w":[1339,9422]}],["修塞","xiūsāi","谓修缮堤防，堵塞决口。",{"a":1,"w":[1339,4630]}],["修忮","xiūzhì","谓心怀忌恨而进行报复。",{"a":1,"w":[1339,19598]}],["修慎","xiūshèn","谓注重修养，处世谨慎。",{"a":1,"w":[1339,8252]}],["修畅","xiūchàng","谓情操高尚，言行旷达。",{"a":1,"w":[1339,8281]}],["倅廨","cuìxiè","州郡副职官员办公处所。",{"a":1,"w":[23086,26657]}],["倅厅","cuìtīng","州郡副职官员办公处所。",{"a":1,"w":[23086,3439]}],["仓窌","cāngjiào","贮藏粮食的房仓和地窖。",{"a":1,"w":[8035,158746]}],["仓黑","cānghēi","青黑色。仓，通“苍”。",{"a":1,"w":[8035,549]}],["倒挫","dàocuò","因受惊而脚步向后一退。",{"a":1,"w":[583,8947]}],["倒书","dàoshū","不按顺序，倒过来书写。",{"a":1,"w":[583,81]}],["倚身","yǐshēn","把身子靠在某一物体上。",{"a":1,"w":[8677,7456]}],["倚辀","yǐzhōu","指马靠着车辕停步不前。",{"a":1,"w":[8677,37367]}],["倚魁","yǐkuí","怪僻；独特而不合于俗。",{"a":1,"w":[8677,8560]}],["倛魄","qīpò","即倛丑。参见“倛丑”。",{"a":1,"w":[32472,9063]}],["借榻","jiètà","借人床榻睡觉。犹借宿。",{"a":1,"w":[650,12247]}],["倩浰","qiànliàn","疾速貌。倩，通“凄”。",{"a":1,"w":[14226,64075]}],["伟世","wěishì","光大时世，使时世光大。",{"a":1,"w":[9196,7462]}],["偏壅","piānyōng","谓流布不均，阻滞不畅。",{"a":1,"w":[4648,9728]}],["偏察","piānchá","过分地显示精明；苛察。",{"a":1,"w":[4648,7567]}],["偏累","piānlèi","谓负担不均衡，不公平。",{"a":1,"w":[4648,173]}],["偏褊","piānbiǎn","谓行为邪僻，器量狭窄。",{"a":1,"w":[4648,16149]}],["偏军","piānjūn","指主力以外的部分军队。",{"a":1,"w":[4648,7467]}],["健毫","jiànháo","刚健的笔。谓善于为文。",{"a":1,"w":[8022,7913]}],["侧心","cèxīn","反侧其心。谓离心离德。",{"a":1,"w":[4672,1279]}],["偶章","ǒuzhāng","指偶句形式为主的诗章。",{"a":1,"w":[7888,4661]}],["傅吕","fùlǚ","殷傅说和周吕尚的并称。",{"a":1,"w":[8760,8345]}],["傍扈","bànghù","清代禁中护驾卫士之称。",{"a":1,"w":[9059,9990]}],["傍荫","bàngyīn","旁系亲属袭封官职爵位。",{"a":1,"w":[9059,8853]}],["傍薄","bàngbáo","盛大貌；巨大而充满貌。",{"a":1,"w":[9059,2319]}],["傮然","zāorán","嘈杂貌。傮，通“嘈”。",{"a":1,"w":[7451]}],["传禀","chuánbǐng","传达禀告。用于下对上。",{"a":1,"w":[1297,9733]}],["传胤","chuányìn","谓传受统嗣；继承帝位。",{"a":1,"w":[1297,12889]}],["伤幸","shāngxìng","谓无情无义，出口伤人。",{"a":1,"w":[1358,8065]}],["伤时","shāngshí","因时世不如所愿而哀伤。",{"a":1,"w":[1358,1280]}],["伤暮","shāngmù","谓自伤年老而志向不就。",{"a":1,"w":[1358,8841]}],["伤疾","shāngjí","因受创伤而造成的疾病。",{"a":1,"w":[1358,7794]}],["伤蹶","shāngjué","受伤跌倒。喻遭受挫折。",{"a":1,"w":[1358,9501]}],["倾背","qīngbèi","逝世，去世。多指长辈。",{"a":1,"w":[7714,565]}],["倾输","qīngshū","指把感情尽量表达出来。",{"a":1,"w":[7714,1352]}],["侥忝","jiǎotiǎn","谦辞。谓侥幸愧居其列。",{"a":1,"w":[16454,15197]}],["僭奢","jiànshē","越分地奢侈；过分奢侈。",{"a":1,"w":[11371,9225]}],["僭易","jiànyì","犹言冒昧、轻慢。谦词。",{"a":1,"w":[11371,7463]}],["僭言","jiànyán","越分妄言。亦用为谦词。",{"a":1,"w":[11371,7440]}],["僭迹","jiànjì","谓僭越称尊的旧业遗绪。",{"a":1,"w":[11371,8080]}],["僭杂","jiànzá","谓下者犯上，混乱失序。",{"a":1,"w":[11371,4680]}],["僻嗜","pìshì","对某种事物有特异嗜好。",{"a":1,"w":[9462,8954]}],["僻学","pìxué","谓未能博学，见闻寡陋。",{"a":1,"w":[9462,13]}],["僻绝","pìjué","谓地方偏僻，交通隔绝。",{"a":1,"w":[9462,4627]}],["仪幕","yímù","指赞理地方政务的幕职。",{"a":1,"w":[7483,7877]}],["仪掾","yíyuàn","泛称地方掌刑律的属官。",{"a":1,"w":[7483,27955]}],["侩佞","kuàinìng","指唯利是图的奸佞小人。",{"a":1,"w":[17679,10272]}],["俭政","jiǎnzhèng","谓实行俭朴的政治措施。",{"a":1,"w":[9141,7478]}],["儋蓝","dānlán","即襜褴。古北方部族名。",{"a":1,"w":[18376,623]}],["儡块","lěikuài","喻胸中积郁的不平之气。",{"a":1,"w":[12984,151]}],["优狐","yōuhú","指专演老年男子的优人。",{"a":1,"w":[7733,8675]}],["优词","yōucí","指供教坊优伶歌咏之词。",{"a":1,"w":[7733,596]}],["优锡","yōuxī","优厚的赏赐。锡，赐给。",{"a":1,"w":[7733,8582]}],["储躬","chǔgōng","太子之身。亦借指太子。",{"a":1,"w":[7845,9213]}],["俪事","lìshì","属对之事。指写作骈文。",{"a":1,"w":[13825,33]}],["元序","yuánxù","最根本的秩序，指礼仪。",{"a":1,"w":[104,7598]}],["元淳","yuánchún","谓天真朴素，未经雕琢。",{"a":1,"w":[104,10223]}],["元识","yuánshí","谓先天具备的认识能力。",{"a":1,"w":[104,4658]}],["元醮","yuánjiào","上元节举行的祭神仪式。",{"a":1,"w":[104,12871]}],["充位","chōngwèi","谓徒居其位，无所建树。",{"a":1,"w":[7722,545]}],["入梓","rùzǐ","谓刻印书籍。梓，刻板。",{"a":1,"w":[4615,10822]}],["内任","nèirèn","指朝廷中的重任和要职。",{"a":1,"w":[1287,1331]}],["内娶","nèiqǔ","谓诸侯娶国内大夫之女。",{"a":1,"w":[1287,3829]}],["内妇","nèifù","犹内子。卿大夫的嫡妻。",{"a":1,"w":[1287,7957]}],["内庑","nèiwǔ","府内堂周的走廊、廊屋。",{"a":1,"w":[1287,21948]}],["内忌","nèijì","内心忌妒。亦指忌妒心。",{"a":1,"w":[1287,8540]}],["内润","nèirùn","谓颖慧天然，薀而不露。",{"a":1,"w":[1287,7847]}],["内祭","nèijì","古代天子祭祀祖先宗庙。",{"a":1,"w":[1287,8417]}],["全牲","quánshēng","完整的家畜。用于祭祀。",{"a":1,"w":[531,9334]}],["两墯","liǎngduò","谓任意而为，全无约束。",{"a":1,"w":[96,338474]}],["两望","liǎngwàng","不倾向一方的观望态度。",{"a":1,"w":[96,7556]}],["八屯","bātún","宫苑四周所设的八卫所。",{"a":1,"w":[145,8563]}],["八跪","bāguì","谓蟹的八足。跪，蟹足。",{"a":1,"w":[145,4980]}],["公奉","gōngfèng","犹俸禄。奉，通“俸”。",{"a":1,"w":[4610,7971]}],["公粥","gōngzhōu","旧时官方赈灾发放的粥。",{"a":1,"w":[4610,4875]}],["公葬","gōngzàng","公众为死者举行的葬礼。",{"a":1,"w":[4610,8823]}],["六慎","liùshèn","谓国君所应谨慎的六事。",{"a":1,"w":[141,8252]}],["六茎","liùjīng","古乐名。传为颛顼所作。",{"a":1,"w":[141,4776]}],["六迷","liùmí","谓作诗的六种糊涂认识。",{"a":1,"w":[141,1384]}],["共偫","gòngzhì","谓备用。共，通“供”。",{"a":1,"w":[2273,125997]}],["共辔","gòngpèi","共同执辔。谓一起驾御。",{"a":1,"w":[2273,13007]}],["兵尉","bīngwèi","古代的军职。在裨将下。",{"a":1,"w":[2282,9085]}],["兵形","bīngxíng","指用兵作战的方式方法。",{"a":1,"w":[2282,4612]}],["兵谋","bīngmóu","军事计谋；用兵的谋略。",{"a":1,"w":[2282,8000]}],["具茨","jùcí","山名，在今河南省密县。",{"a":1,"w":[7505,7689]}],["兼士","jiānshì","奉行墨家兼爱学说的人。",{"a":1,"w":[8290,7542]}],["兼珍","jiānzhēn","指两种以上的珍美食品。",{"a":1,"w":[8290,8037]}],["兼遣","jiānqiǎn","都排除掉，谓虚实两忘。",{"a":1,"w":[8290,8864]}],["冀心","jìxīn","侥幸的心理，非分之想。",{"a":1,"w":[10582,1279]}],["冀群","jìqún","谓冀北的马群。喻良材。",{"a":1,"w":[10582,1348]}],["册奏","cèzòu","册命、章奏之类的文书。",{"a":1,"w":[3413,4777]}],["册赠",