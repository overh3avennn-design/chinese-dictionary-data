":1,"w":[1369,7867]}],["分削","fēnxuē","谓分封土地或削减封地。",{"a":1,"w":[15,4765]}],["分另","fēnlìng","谓分割家产，另立门户。",{"a":1,"w":[15,4852]}],["分胙","fēnzuò","祭祀完毕分享祭神之肉。",{"a":1,"w":[15,23284]}],["分亲","fēnqīn","谓各人自己分内的亲戚。",{"a":1,"w":[15,1338]}],["分阃","fēnkǔn","指出任将帅或封疆大吏。",{"a":1,"w":[15,13395]}],["刈杀","yìshā","谓芟割草木，开垦土地。",{"a":1,"w":[14604,3331]}],["刊期","kānqī","谓定期刊物的出版周期。",{"a":1,"w":[8644,1299]}],["刑曹","xíngcáo","分管刑事的官署或属官。",{"a":1,"w":[7716,8358]}],["列食","lièshí","犹言列鼎而食。谓盛宴。",{"a":1,"w":[2268,7466]}],["初魄","chūpò","农历每月初三四的月亮。",{"a":1,"w":[1400,9063]}],["别堡","biébǎo","谓拱卫中心城市的城堡。",{"a":1,"w":[69,7946]}],["利患","lìhuàn","患痢疾。利，通“痢”。",{"a":1,"w":[4606,8146]}],["删取","shānqǔ","谓经过删除，取其精要。",{"a":1,"w":[9465,580]}],["刮言","guāyán","男女以言语勾搭、挑逗。",{"a":1,"w":[4770,7440]}],["刳脔","kūluán","把肉切割成块。谓剖杀。",{"a":1,"w":[18288,15970]}],["制鞭","zhìbiān","刑具。带棱的生革皮鞭。",{"a":1,"w":[7413,8162]}],["刺临","cìlín","谓出任刺史，治理百姓。",{"a":1,"w":[2300,7625]}],["前悔","qiánhuǐ","以前的悔恨；悔恨过去。",{"a":1,"w":[60,8771]}],["刚讦","gāngjié","谓刚直而不能容人之过。",{"a":1,"w":[636,21911]}],["剥割","bōgē","割削。犹言盘剥、搜刮。",{"a":1,"w":[8572,4723]}],["剪抑","jiǎnyì","贬低。 削弱; 压制。",{"a":1,"w":[3419,8091]}],["剪搣","jiǎnmiè","修剪整理(鬓发眉毛)。",{"a":1,"w":[3419,76264]}],["副东","fùdōng","帮助主人接待宾客的人。",{"a":1,"w":[4673,87]}],["割壤","gērǎng","划分土地。谓裂地分封。",{"a":1,"w":[4723,8583]}],["割慈","gēcí","谓子女同父母生离死别。",{"a":1,"w":[4723,8234]}],["割治","gēzhì","指用外科手术治疗疾患。",{"a":1,"w":[4723,2283]}],["创垂","chuàngchuí","谓开创业绩，传之后世。",{"a":1,"w":[7933,7786]}],["剽卤","piāolǔ","犹掳掠。卤，通“虏”。",{"a":1,"w":[11247,8513]}],["剧令","jùlìng","政务繁重的县份的县令。",{"a":1,"w":[4703,3329]}],["剧屯","jùtún","谓重兵驻守的军事要地。",{"a":1,"w":[4703,8563]}],["剧烦","jùfán","繁剧。亦指繁杂的事务。",{"a":1,"w":[4703,2397]}],["剧郡","jùjùn","大郡，政务繁剧的州郡。",{"a":1,"w":[4703,9030]}],["劈帐","pīzhàng","指分配收益或分摊开支。",{"a":1,"w":[4936,8011]}],["刘杜","liúdù","明末刘綎、杜松的并称。",{"a":1,"w":[8276,7680]}],["刘生","liúshēng","汉横吹曲名。原为人名。",{"a":1,"w":[8276,508]}],["刘卢","liúlú","晋代刘琨、卢谌的并称。",{"a":1,"w":[8276,7791]}],["刘贾","liújiǎ","汉代刘向、贾谊的并称。",{"a":1,"w":[8276,8056]}],["劘上","móshàng","规劝君上。谓直言诤谏。",{"a":1,"w":[28890,9]}],["功费","gōngfèi","工费。工程所需的费用。",{"a":1,"w":[7516,1316]}],["劫争","jiézhēng","即劫打。参见“劫打”。",{"a":1,"w":[8458,1356]}],["勉勖","miǎnxù","亦作“勉勖”。\n勉励。",{"a":1,"w":[9653,22524]}],["勖励","xùlì","亦作“勖励”。\n勉励。",{"a":1,"w":[22524,8577]}],["勖厉","xùlì","亦作“勖厉”。\n勉励。",{"a":1,"w":[22524,8111]}],["劳剧","láojù","繁重。亦指繁重的事务。",{"a":1,"w":[7526,4703]}],["劳辱","láorǔ","犹劳苦。亦指劳苦之事。",{"a":1,"w":[7526,8418]}],["勤劝","qínquàn","谓以身之勤劳劝勉别人。",{"a":1,"w":[7857,3484]}],["勤济","qínjì","谓工作勤奋而卓有成效。",{"a":1,"w":[7857,7522]}],["剿净","jiǎojìng","谓除去疵累而归于净洁。",{"a":1,"w":[10677,4690]}],["勺饮","sháoyǐn","一勺汤水。言汤水量少。",{"a":1,"w":[4956,7871]}],["勾绞","gōujiǎo","古代术数家所谓凶辰名。",{"a":1,"w":[8034,8114]}],["包苴","bāojū","苞苴。借指贿赂或馈赠。",{"a":1,"w":[88,11890]}],["包髻","bāojì","古代用来包发髻的头巾。",{"a":1,"w":[88,10590]}],["化先","huàxiān","四时变化之始。指初春。",{"a":1,"w":[1272,89]}],["北房","běifáng","古代在堂的北边的居室。",{"a":1,"w":[132,7555]}],["北歌","běigē","指北方少数民族的乐歌。",{"a":1,"w":[132,208]}],["匝眼","zāyǎn","眨眼。比喻极短的时刻。",{"a":1,"w":[10643,551]}],["匡立","kuānglì","谓拯救国家，建立大业。",{"a":1,"w":[9197,3314]}],["匪民","fěimín","非人，谓不被当人看待。",{"a":1,"w":[8863,7434]}],["十拗","shí'ǎo","指老人的十种反常情态。",{"a":1,"w":[93,9264]}],["千溢","qiānyì","形容财宝之多。溢，镒。",{"a":1,"w":[587,8852]}],["升燎","shēngliáo","谓古代郊祭时燔燎升首。",{"a":1,"w":[1362,9349]}],["升首","shēngshǒu","古代郊祭时用牲首上供。",{"a":1,"w":[1362,2310]}],["午暑","wǔshǔ","夏季中午的暑热、炎气。",{"a":1,"w":[8095,9309]}],["午漏","wǔlòu","午时的滴漏。亦指午时。",{"a":1,"w":[8095,3354]}],["卉犬","huìquǎn","用草扎成的狗，即刍狗。",{"a":1,"w":[13145,4727]}],["卉裘","huìqiú","粗陋的皮衣。多指敝裘。",{"a":1,"w":[13145,9755]}],["半垓","bàngāi","五千万。表示数量极多。",{"a":1,"w":[97,13398]}],["卑隐","bēiyǐn","(地位)微贱而不显达。",{"a":1,"w":[8402,7652]}],["南荒","nánhuāng","指南方荒凉遥远的地方。",{"a":1,"w":[90,7797]}],["博笑","bóxiào","谦词。谓换取别人一笑。",{"a":1,"w":[7502,185]}],["博謇","bójiǎn","谓知无不言，正直之极。",{"a":1,"w":[7502,15123]}],["博议","bóyì","全面详尽地讨论或评议。",{"a":1,"w":[7502,7521]}],["卜郊","bojiāo","用占卜选定郊祭的日期。",{"a":1,"w":[8005,9158]}],["占家","zhànjiā","古代以占候为职业的人。",{"a":1,"w":[647,28]}],["占役","zhànyì","逾制占用公务人员当差。",{"a":1,"w":[647,7861]}],["卡借","kǎjiè","谓故意刁难，卡住不借。",{"a":1,"w":[538,650]}],["卯困","mǎokùn","谓因吃卯酒而困倦昏睡。",{"a":1,"w":[9094,1437]}],["印委","yìnwěi","印官和临时差委的官员。",{"a":1,"w":[4649,7519]}],["印心","yìnxīn","佛家谓印证于心而顿悟。",{"a":1,"w":[4649,1279]}],["印施","yìnshī","谓刻印佛经，广为布施。",{"a":1,"w":[4649,7507]}],["即拜","jíbài","就其所在之地授予官职。",{"a":1,"w":[7854,7752]}],["卷绶","juǎnshòu","卷束绶带。谓官吏辞职。",{"a":1,"w":[2296,10706]}],["卷蓬","juǎnpéng","风卷飞蓬。形容极轻快。",{"a":1,"w":[2296,8390]}],["恤录","xùlù","谓予以抚恤，并记其功。",{"a":1,"w":[8783,1380]}],["卿佐","qīngzuǒ","指辅佐国君的执政大臣。",{"a":1,"w":[8953,7955]}],["厎慎","dǐshèn","致慎。谓采取慎重态度。",{"a":1,"w":[15856,8252]}],["厌断","yànduàn","用迷信的方法镇服鬼魅。",{"a":1,"w":[8372,1335]}],["去妇","qùfù","旧时被丈夫休弃的妇女。",{"a":1,"w":[61,7957]}],["参注","cānzhù","谓列入名册，斟酌录用。",{"a":1,"w":[7543,7606]}],["友声","yǒushēng","朋友的声音。亦指朋友。",{"a":1,"w":[7735,3317]}],["反棹","fǎnzhào","一般指回船，驾舟返航。",{"a":1,"w":[2260,12826]}],["反袂","fǎnmèi","用衣袖拭泪。形容哭泣。",{"a":1,"w":[2260,15354]}],["取则","qǔzé","取作准则、规范或榜样。",{"a":1,"w":[580,3323]}],["受誓","shòushì","谓祭祀之前，先申儆戒。",{"a":1,"w":[1324,8615]}],["口谀","kǒuyú","谓当面奉承、表里不一。",{"a":1,"w":[47,12522]}],["古戍","gǔshù","边疆古老的城堡、营垒。",{"a":1,"w":[1322,9666]}],["古逸","gǔyì","指未加纂辑的古诗文等。",{"a":1,"w":[1322,8116]}],["句绳","jùshéng","即钩绳。正曲直的工具。",{"a":1,"w":[646,7867]}],["叨厕","dāocè","忝居。厕身其间的谦词。",{"a":1,"w":[9519,8932]}],["叩愬","kòusù","犹申诉。愬，同“诉”。",{"a":1,"w":[9779,16186]}],["叩枻","kòuyì","桨击船舷。谓摇动船桨。",{"a":1,"w":[9779,33197]}],["可欲","kěyù","指足以引起欲念的事物。",{"a":1,"w":[3310,7872]}],["右骖","yòucān","星官名。位于房星北面。",{"a":1,"w":[178,14958]}],["吃交","chījiāo","亦作“吃交”。\n跌交。",{"a":1,"w":[108,535]}],["吃勘","chīkān","亦作“吃勘”。\n勘问。",{"a":1,"w":[108,8682]}],["吃跌","chīdiē","亦作“吃跌”。\n跌交。",{"a":1,"w":[108,4818]}],["合姓","héxìng","合二姓为婚姻。指婚娶。",{"a":1,"w":[1269,719]}],["合梨","hélí","合，通“蛤”。即蛤蜊。",{"a":1,"w":[1269,3632]}],["合见","héjiàn","谓一同出现，同时出现。",{"a":1,"w":[1269,76]}],["吉屦","jíjù","旧时送葬者所着之麻鞋。",{"a":1,"w":[7582,10982]}],["吉祝","jízhù","古礼六祝之一。祈福祥。",{"a":1,"w":[7582,1473]}],["同垣","tóngyuán","同居谏垣。指同为谏官。",{"a":1,"w":[4611,10422]}],["同籍","tóngjí","同一户籍的人。指家人。",{"a":1,"w":[4611,7983]}],["名缁","míngzī","指名僧。缁，黑色僧衣。",{"a":1,"w":[560,12296]}],["吏典","lìdiǎn","元、明、清府县的吏员。",{"a":1,"w":[8898,7636]}],["吞笔","tūnbǐ","犹含毫。比喻构思为文。",{"a":1,"w":[4843,619]}],["吟卧","yínwò","谓朗吟高卧。形容闲适。",{"a":1,"w":[8955,7997]}],["含嗔","hánchēn","带着生气或责怪的神情。",{"a":1,"w":[2351,11448]}],["含虚","hánxū","谓虚若无物。形容透明。",{"a":1,"w":[2351,7779]}],["吴画","wúhuà","指唐吴道子所画的佛像。",{"a":1,"w":[8110,625]}],["吴蓝","wúlán","蓝草的一种。可做染料。",{"a":1,"w":[8110,623]}],["吴霜","wúshuāng","吴地的霜。亦比喻白发。",{"a":1,"w":[8110,8258]}],["吸欻","xīchuā","迅疾貌。吸，通“翕”。",{"a":1,"w":[2331,18544]}],["吹呴","chuīxǔ","道家所谓呼吸吐纳之术。",{"a":1,"w":[637,15802]}],["吹簸","chuībǒ","谓上下簸动，扬弃杂质。",{"a":1,"w":[637,10411]}],["吻翰","wěnhàn","口与笔。指口辩与文才。",{"a":1,"w":[3451,8206]}],["吕傅","lǚfù","周吕尚与商傅说的并称。",{"a":1,"w":[8345,8760]}],["告祢","gàomí","谓祭告父庙或父之神主。",{"a":1,"w":[7591,21199]}],["周听","zhōutīng","兼听，听取各方面意见。",{"a":1,"w":[563,146]}],["呵欱","hēhē","犹言嘘吸吐纳。喻进退。",{"a":1,"w":[4926,270844]}],["呵祝","hēzhù","犹念咒。祝，通“咒”。",{"a":1,"w":[4926,1473]}],["呼鹰","hūyīng","呼鹰以逐兽，因指行猎。",{"a":1,"w":[7783,8542]}],["命管","mìngguǎn","命笔，下笔。管，指笔。",{"a":1,"w":[4622,1278]}],["命舄","mìngxì","古代帝王所赐的复底鞋。",{"a":1,"w":[4622,17774]}],["咈然","fúrán","不悦貌。咈，通“怫”。",{"a":1,"w":[31413,7451]}],["和贽","hézhì","指卞和向楚王献玉之事。",{"a":1,"w":[39,14613]}],["和钧","héjūn","谓使计量标准准确划一。",{"a":1,"w":[39,9707]}],["和题","hétí","符合题旨，从正面立论。",{"a":1,"w":[39,615]}],["咎戒","jiùjiè","上天所降的灾祸与警告。",{"a":1,"w":[9750,3377]}],["咯腾","gēténg","心脏猛跳声。形容吃惊。",{"a":1,"w":[10229,7985]}],["咳首","késhǒu","古代南方少数民族之一。",{"a":1,"w":[3535,2310]}],["咿嗢","yīwà","象声词。形容言语难懂。",{"a":1,"w":[18553,42941]}],["员钧","yuánjūn","转动制圆器陶模的轮子。",{"a":1,"w":[1289,9707]}],["哭鸟","kūniǎo","啼声如哭的鸟，如鸱鸺。",{"a":1,"w":[728,581]}],["哲后","zhéhòu","贤明的君主。后，君主。",{"a":1,"w":[8304,43]}],["唐环","tánghuán","指唐玄宗的贵妃杨玉环。",{"a":1,"w":[7869,1320]}],["唱卯","chàngmǎo","谓司更者呼报已到卯时。",{"a":1,"w":[198,9094]}],["商官","shāngguān","用金钱买得官爵的商人。",{"a":1,"w":[7485,2293]}],["商屯","shāngtún","又称盐屯。屯田的一种。",{"a":1,"w":[7485,8563]}],["衔佩","xiánpèi","谓永志不忘。极言感念。",{"a":1,"w":[8703,7810]}],["喉嗉","hóusù","咽喉和食道。借指生命。",{"a":1,"w":[8335,27533]}],["唤门","huànmén","在门外叫里边的人开门。",{"a":1,"w":[9218,53]}],["喣濡","xǔrú","谓相互给以温暖和帮助。",{"a":1,"w":[48905,10135]}],["丧冠","sàngguān","服丧时所戴的一种帽子。",{"a":1,"w":[8016,7694]}],["乔画","qiáohuà","化妆，打扮；浓妆艳抹。",{"a":1,"w":[7886,625]}],["单宣","dānxuān","宣纸品种之一。质较薄。",{"a":1,"w":[2269,7827]}],["嗒尔","dā'ěr","犹嗒然。形容物我两忘。",{"a":1,"w":[13480,7407]}],["嘉诲","jiāhuì","敬称别人对自己的教诲。",{"a":1,"w":[8327,12518]}],["嘓嘟","guōdū","咕嘟。吞饮液状食物声。",{"a":1,"w":[67412,11350]}],["哗传","huāchuán","谓消息轰动，广泛传布。",{"a":1,"w":[11924,1297]}],["嘲讴","cháo'ōu","谓带有讽刺意味的民谣。",{"a":1,"w":[10741,15312]}],["嘹乱","liáoluàn","形容声音响亮而又嘈杂。",{"a":1,"w":[32132,1360]}],["噀酒","xùnjiǔ","指后汉栾巴喷酒为雨事。",{"a":1,"w":[33291,594]}],["噤舌","jìnshé","犹结舌。形容言语谨慎。",{"a":1,"w":[12661,7844]}],["吓射","xiàshè","谓以恐吓手段逐取财利。",{"a":1,"w":[3550,3312]}],["啮啃","nièkěn","啃咬。比喻破坏或折磨。",{"a":1,"w":[10765,5283]}],["咽津","yànjīn","咽口水。形容思食之切。",{"a":1,"w":[9066,7884]}],["嚬伸","pínshēn","欠伸。打呵欠，伸懒腰。",{"a":1,"w":[28640,3412]}],["向赴","xiàngfù","犹响应。向，通“响”。",{"a":1,"w":[537,8928]}],["严廊","yánláng","庄严的廊庙。借指朝廷。",{"a":1,"w":[2349,10038]}],["严褊","yánbiǎn","谓性格暴躁，心胸狭窄。",{"a":1,"w":[2349,16149]}],["严迅","yánxùn","亦作“严讯”。\n严峻。",{"a":1,"w":[2349,9463]}],["严阙","yánquē","庄严的宫殿。借指朝廷。",{"a":1,"w":[2349,8773]}],["四印","sìyìn","旧指四种修养身心之道。",{"a":1,"w":[86,4649]}],["四域","sìyù","四周界限。指四方之内。",{"a":1,"w":[86,7823]}],["四奸","sìjiān","指聋、昧、顽、嚚四恶。",{"a":1,"w":[86,8125]}],["四景","sìjǐng","四时的景象。代指四时。",{"a":1,"w":[86,4676]}],["四泾","sìjīng","指江、河、淮、济四水。",{"a":1,"w":[86,12068]}],["四稽","sìjī","指藉以稽考的四个方面。",{"a":1,"w":[86,8842]}],["四统","sìtǒng","君王治国安民的四准则。",{"a":1,"w":[86,7442]}],["四老","sìlǎo","四位老人。指商山四皓。",{"a":1,"w":[86,55]}],["四聚","sìjù","使民众安集的四项措施。",{"a":1,"w":[86,2309]}],["四英","sìyīng","四位英杰。详“四相”。",{"a":1,"w":[86,7637]}],["因声","yīnshēng","犹言寄语。指托人带话。",{"a":1,"w":[4624,3317]}],["困亨","kùnhēng","谓困窘至极则转向通达。",{"a":1,"w":[1437,8978]}],["困污","kùnwū","谓生活贫苦，地位低下。",{"a":1,"w":[1437,7785]}],["固蔽","gùbì","谓蔽塞不聪，不谙事理。",{"a":1,"w":[7552,8083]}],["国喜","guóxǐ","指皇子诞生等皇家喜事。",{"a":1,"w":[23,7727]}],["国携","guóxié","谓国家出现离析的现象。",{"a":1,"w":[23,8623]}],["国琛","guóchēn","国宝。比喻有德才的人。",{"a":1,"w":[23,26334]}],["圆媚","yuánmèi","谓处世圆滑，善于逢迎。",{"a":1,"w":[2301,9523]}],["土瓷","tǔcí","指质地较粗的土制瓷器。",{"a":1,"w":[1300,8663]}],["土蛆","tǔqū","犹粪蛆。粪土中的蛆虫。",{"a":1,"w":[1300,15470]}],["圮下","pǐxià","地面塌陷而形成的低洼。",{"a":1,"w":[23132,17]}],["地傅","dìfù","犹邻人，住处相近的人。",{"a":1,"w":[10,8760]}],["地入","dìrù","土地的收入。指农产品。",{"a":1,"w":[10,4615]}],["地厌","dìyàn","古代术数家谓狗为地厌。",{"a":1,"w":[10,8372]}],["地岊","dìjié","地角，谓地之极僻远处。",{"a":1,"w":[10,86977]}],["地箓","dìlù","道教谓地府的秘文秘录。",{"a":1,"w":[10,15097]}],["地纮","dìhóng","犹地维。古谓地有八紘。",{"a":1,"w":[10,32032]}],["地贡","dìgòng","出自土地的贡物、赋税。",{"a":1,"w":[10,8007]}],["均种","jūnzhǒng","指种植的间隔均匀适度。",{"a":1,"w":[7820,1344]}],["坐见","zuòjiàn","犹言眼看着，徒然看着。",{"a":1,"w":[128,76]}],["城雉","chéngzhì","城上短墙。亦泛指城墙。",{"a":1,"w":[1353,9135]}],["执钧","zhíjūn","犹掌权。亦指掌权的人。",{"a":1,"w":[7826,9707]}],["埽门","sàomén","谓取媚权贵，夤缘仕进。",{"a":1,"w":[21817,53]}],["堂属","tángshǔ","堂官和属员；下属成员。",{"a":1,"w":[7695,1268]}],["堂息","tángxī","堂兄弟的儿子，即堂侄。",{"a":1,"w":[7695,7510]}],["堆案","duī'àn","堆积案头。谓文书甚多。",{"a":1,"w":[3333,7610]}],["堛坼","bìchè","土块开裂。引申指破开。",{"a":1,"w":[344330,15127]}],["堤夫","dīfū","修筑或管理堤坝的民夫。",{"a":1,"w":[9344,7409]}],["报房","bàofáng","发送邸报、书信的处所。",{"a":1,"w":[1318,7555]}],["场杵","chǎngchǔ","场上脱粒用的棍棒之属。",{"a":1,"w":[544,10054]}],["塌然","tārán","哀痛、失意或落陷之貌。",{"a":1,"w":[4891,7451]}],["塞聪","sāicōng","谓塞住耳朵，示不外听。",{"a":1,"w":[4630,9113]}]]