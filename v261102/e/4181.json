8121,8101]}],["五灵神","wǔlíng shén","古代神话谓麟、凤、龟、龙、白虎五种灵异鸟兽，并各有其神。合称“五灵神”。",{"a":1,"w":[68414,3316]}],["亚夫营","yàfūyíng","汉将周亚夫驻军细柳(今陕西省咸阳市西南渭河北)，防御匈奴，营中戒备森严。",{"a":1,"w":[7439,7409,7572]}],["仁智居","rénzhì jū","《论语‧雍也》：“知者乐水，仁者乐山。”后以山水宜人的住处为“仁智居”。",{"a":1,"w":[90650,7611]}],["仁智乐","rénzhì lè","《论语‧雍也》：“知者乐水，仁者乐山。”后以“仁智乐”指遨游山水的乐趣。",{"a":1,"w":[90650,1340]}],["伯远帖","bóyuǎntiē","晋王珣尺牍，五行四十七字，行书。此帖笔法峻拔刚断，意味高古，为晋人妙品。",{"a":1,"w":[7608,103,8250]}],["保章正","bǎozhāngzhèng","唐代官名，掌观测、记录天象变异，以视吉凶。名出《周礼‧春官》“保章氏”。",{"a":1,"w":[1292,4661,62]}],["剥面皮","bōmiàn pí","三国吴孙皓残暴，“或剥人之面，或凿人之眼。”见《三国志‧吴志‧孙皓传》。",{"a":1,"w":[219441,1291]}],["刘窟头","liúkūtóu","1) 五代刘仁恭善挖掘地道攻城，因得“刘窟头”之号。\n2) 谓身死入土。",{"a":1,"w":[8276,9601,509]}],["千秋亭","qiānqiū tíng","1) 亭名。在河北省内丘县(旧柏乡县)。\n2) 亭名。在河南省渑池县东。",{"a":1,"w":[16913,8241]}],["卜算子","bǔsuàn zi","1) 词牌名。\n2) 曲牌名，属南曲仙吕宫。字数与词牌半阕同。用作引子。",{"a":1,"w":[318508,1]}],["卵幕杯","luǎnmùbēi","明代浮梁(今并入景德镇市)人昊十九所制的白瓷杯。极精巧，是着名的工艺品。",{"a":1,"w":[8378,7877,199]}],["壶公龙","húgōnglóng","《后汉书‧方术传下‧费长房》载费长房从壶公学仙，壶公遣归，与一竹杖使骑。",{"a":1,"w":[3500,4610,1308]}],["大茶壶","dà cháhú","旧社会北京北帮妓院中的青年男仆。因其常手提水壶冲茶，故称。也称“茶壶”。",{"a":1,"w":[4,19552]}],["天水碧","tiānshuǐ bì","浅青色。相传南唐后主李煜的宫女染衣作浅碧色，经露水湿染，颜色更好，故名。",{"a":1,"w":[43960,8659]}],["将军炭","jiāngjūn tàn","旧时北京风俗，用红箩炭末塑制成将军形，岁暮植于门之两旁。后亦名“彩妆”。",{"a":1,"w":[4955,8524]}],["律博士","lǜ bóshì","官名。古代教授法律和保管法律典籍的官员。始置于三国魏明帝时，至元代废除。",{"a":1,"w":[7544,2459]}],["恋三宿","liànsānsù","清袁枚《腊月十四日别苏州还山作》诗：“不是伊桑恋三宿，只愁丁鹤别千年。”",{"a":1,"w":[8204,74,7825]}],["扑腾腾","pūteng téng","1) 气盛貌。\n2) 扬鞭策马貌。\n3) 象声词。形容击鼓、落水等声音。",{"a":1,"w":[105509,7985]}],["敲菱壳","qiāolíngké","方言。以地产卖于人，过若干时间要求加价称“找价”，屡找不已称“敲菱壳”。",{"a":1,"w":[2458,8809,7909]}],["明资匠","míngzījiàng","唐代官府手工业中出资雇用的有精湛技艺的工匠。其中尤为特殊的，又称巧儿匠。",{"a":1,"w":[7431,7444,8607]}],["昏惨剌","hūncǎnlá","同“昏惨惨”。\n元白朴《梧桐雨》第四摺：“淡氤氲串烟袅，昏惨剌银灯照。”",{"a":1,"w":[4748,4840,8630]}],["东海公","dōnghǎi gōng","1) 隋末农民起义军将领高士达自称之号。\n2) 清代诗人黄遵宪自署之号。",{"a":1,"w":[12569,4610]}],["桃花粥","táohuā zhōu","旧俗寒食节的食品。煮粳米及麦为酪，捣杏仁，作粥。呈桃花色，称“桃花粥”。",{"a":1,"w":[3799,4875]}],["桃叶渡","táoyè dù","渡口名。在今江苏省南京市秦淮河畔。相传因晋王献之在此送其爱妾桃叶而得名。",{"a":1,"w":[89264,4780]}],["桥公钺","qiáogōngyuè","汉蔡邕有《黄钺铭》，褒扬汉将桥玄守边武功。后因以“桥公钺”指《黄钺铭》。",{"a":1,"w":[1435,4610,13368]}],["樱笋厨","yīngsǔnchú","1) 唐时，樱桃与春笋上市时，朝廷以此物作盛馔，故称。\n2) 借指朝宴。",{"a":1,"w":[9944,8811,8889]}],["正军户","zhèngjūn hù","蒙古灭金后，规定北方贫家合二、三户出壮丁一名服军役，出壮丁户称为正军户。",{"a":1,"w":[149912,2320]}],["每日家","měirì jiā","元关汉卿《双赴梦》第一摺：“每日家作念煞关云长、张翼德，委得俺宣限急。”",{"a":1,"w":[13995,28]}],["水状元","shuǐ zhuàngyuan","中草药紫苏的别名。参阅宋陶谷《清异录‧药谱》、明陶宗仪《辍耕录‧药谱》。",{"a":1,"w":[11,14674]}],["没内外","méi nèiwài","谓不遵守男女有别的封建礼法。语本《礼记‧内则》：“男不言内，女不言外”。",{"a":1,"w":[94,5253]}],["清閟阁","qīngbì gé","元着名画家倪瓒收藏图书文玩和吟诗作画之所。在今江苏省无锡县。后为只陀寺。",{"a":1,"w":[174421,8208]}],["漏面贼","lòumiànzéi","坏蛋，恶棍。古代罪犯面部刺过字的叫“漏面”。后即以“漏面贼”骂歹恶之徒。",{"a":1,"w":[3354,523,4718]}],["澎浪矶","pēnglàngjī","地名。在江西省彭泽县西北临长江处，与安徽省宿松县小孤山相对。俗称彭郎矶。",{"a":1,"w":[12174,7832,10621]}],["燕然笔","yānrán bǐ","汉班固为窦宪作《封燕然山铭》，记其功勋。后以“燕然笔”指歌颂战功的文笔。",{"a":1,"w":[45818,619]}],["独乐园","dú lèyuán","1) 宋司马光之园名。故址在今河南省洛阳市南郊。\n2) 泛指名人的花园。",{"a":1,"w":[7561,13639]}],["王济癖","wángjìpǐ","《晋书‧王济传》：“济善解马性，尝乘一马，着连乾鄣泥，前有水，终不肯渡。",{"a":1,"w":[2278,7522,9470]}],["瑶光寺","yáoguāng sì","北魏世宗(宣武帝)在洛阳所建的尼寺。房舍五百余间，妃嫔贵媛，多出家于此。",{"a":1,"w":[103367,4822]}],["瞿唐关","qútáng guān","古关名。以位于瞿唐峡而得名。也称江关。故址在今四川省奉节县东，形势险要。",{"a":1,"w":[493927,65]}],["章句学","zhāngjù xué","汉儒所创的一种研究儒家经典的学问，所重在于解释篇章字句，而不在阐发大义。",{"a":1,"w":[98627,13]}],["策高足","cè gāozú","谓乘上等快马疾驰。高足，汉代驿传设高足、中足、下足三等马匹，高足为上等。",{"a":1,"w":[7673,55620]}],["绿衣郎","lǜyīláng","1) 古代低级官员官服为绿色。后泛指地位卑微的官员。\n2) 指新科进士。",{"a":1,"w":[107149,8101]}],["总纲领","zǒnggāng lǐng","政府、政党、社团等根据自己在一定时期内的总任务而规定的目标和行动步骤等。",{"a":1,"w":[161773,1361]}],["肱三折","gōngsānzhé","《左传‧定公十三年》：“三折肱，知为良医。”后以“肱三折”比喻精于医术。",{"a":1,"w":[11735,30229]}],["薏苡谤","yìyǐ bàng","同“薏苡之谤”。\n唐陈子昂《题居延古城》诗：“桂枝芳欲晚，薏苡谤谁明。”",{"a":1,"w":[33828,9810]}],["话赶话","huàgǎnhuà","I\n方言。谓紧接着对方的话题说话。\nII\n方言。谓紧接着对方的话题说话。",{"a":1,"w":[120,1440]}],["宾度罗","bīndùluó","罗汉名。十六罗汉中的第一尊者，全名宾头卢颇罗堕闍，相传为佛陀出家时之师。",{"a":1,"w":[7793,513,7420]}],["路庄板","lù zhuāngbǎn","用竹板、铁片制成，敲打时能发出响亮的声音。因使人闻知，故又称“报君知”。",{"a":1,"w":[54,381847]}],["跳灰驴","tiàohuīlǘ","一种儿童游戏。一人低头弯腰，双手撑膝；一人助跑跳起，手按其背，分腿跃过。",{"a":1,"w":[1404,3344,8826]}],["这边厢","zhèbiān xiāng","犹这边。京剧《水淹七军》第五场：“这边厢高来，那边低，山高水低不相宜。”",{"a":1,"w":[454,9106]}],["郎官星","lángguān xīng","《后汉书‧明帝纪》：“帝遵奉建武制度，无敢违者。后宫之家，不得封侯与政。",{"a":1,"w":[58865,7443]}],["郑生谷","zhèngshēnggǔ","同“郑谷”。\n唐岑参《终南山双峰草堂作》诗：“缅怀郑生谷，颇忆严子濑。”",{"a":1,"w":[9014,508,7701]}],["醉厌厌","zuìyànyàn","1) 见“醉恹恹”。\n2) 词牌名。即《南歌子》。调见宋贺铸《东山词》。",{"a":1,"w":[3387,81143]}],["阮生集","ruǎnshēngjí","三国魏阮籍与侄阮咸同预竹材七贤之游。后因以“阮生集”喻指叔侄与友好欢聚。",{"a":1,"w":[11124,508,4628]}],["阿那曲","ēnuó qū","词牌名。本为七言绝句，唐人以入乐府。旧题杨太真所作，宋人又名《鸡叫子》。",{"a":1,"w":[16024,7517]}],["陵园妾","língyuán qiè","唐制，诸帝升遐，宫人无子者悉遣陵园供奉朝夕，事死若生时，谓之“陵园妾”。",{"a":1,"w":[34985,10041]}],["鸡黍期","jīshǔ qī","同“鸡黍约”。\n唐高适《赠别王七十管记》诗：“款曲鸡黍期，酸辛别离袂。”",{"a":1,"w":[125738,1299]}],["灵飞散","líng fēisàn","道家方剂名。以云母、茯苓等九味中药合成。据传服用后可延年益寿或得道成仙。",{"a":1,"w":[7588,53065]}],["青门隐","qīngményǐn","秦东陵侯召平，秦灭后隐居长安青门外，以种瓜为业。后因以“青门隐”指隐居。",{"a":1,"w":[3320,53,7652]}],["青鸟使","qīngniǎo shǐ","神话传说西王母有三青鸟代为取食报信。后因以“青鸟使”借指传递书信的使者。",{"a":1,"w":[56106,1332]}],["风篁岭","fēnghuánglǐng","亦名龙泓。位于浙江杭州西南。相传晋葛洪曾在此炼丹。岭下即为名茶产地龙井。",{"a":1,"w":[44,43942,8515]}],["马牛风","mǎniú fēng","1) 马牛奔逸。语出《书‧费誓》：“马牛其风。”\n2) 无关系，不相干。",{"a":1,"w":[30480,44]}],["惊吉利","jīng jílì","同“惊急力”。\n明无名氏《龙门隐秀》第一摺：“諕的我惊吉利不敢孜孜看。”",{"a":1,"w":[7978,5369]}],["鲁连台","lǔ liántái","台名。在山东省茌平县东。传说战国时齐人鲁仲连曾在此居住，后人遂筑台纪念。",{"a":1,"w":[7564,86040]}],["鲈乡亭","lú xiāngtíng","亭名。在江苏省吴江市东长桥上，亭旁曾有春秋越范蠡、晋张翰、唐陆龟蒙画像。",{"a":1,"w":[8389,137065]}],["黄天霸","huángtiān bà","清代武侠小说《施公案》中的主要人物形象。本为绿林好汉，后投靠封建统治者。",{"a":1,"w":[79111,8096]}],["大劝脉","dàquànmài","1) 见主动脉。\n2) 比喻主要的交通干线：京广铁路是我国南北交通的～。",{"a":1,"w":[4,3484,7615]}],["阑尾穴","lánwěi xué","针灸穴位名。位于膝膑下约五寸，胫骨前嵴外侧一横指处。主治腹痛、阑尾炎等。",{"a":1,"w":[32864,8147]}],["循球赛","xún qiúsài","体育运动竞赛方式之一，参加者相互轮流比赛，按全部比赛中得分多少决定名次。",{"a":1,"w":[7778,14949]}],["微压印","wēi yāyìn","firearm microstamping; microstamping",{"a":1,"w":[7512,37792]}],["交粮本","jiāoliángběn","to hand in on