],["云锦天章","yúnjǐn tiānzhāng","云锦神话传说中织女用彩云织出的锦缎。天章彩云组合成的花纹。比喻文章极为高雅、华美。",{"a":1,"w":[128625,58843]}],["隐若敌国","yǐnruòdíguó","隐威严庄重的样子；若象；敌匹敌，同等；敌国相当于一国。指对国家起举足轻重作用的人。",{"a":1,"w":[7652,4652,20226]}],["阴服微行","yīnfúwēixíng","微行帝王、官吏隐藏自己身份改装出行。旧指帝王或官吏穿便装，隐瞒自己的身份进行民访。",{"a":1,"w":[576,4619,88889]}],["以骨去蚁","yǐgǔqùyǐ","用肉驱赶蚂蚁，蚂蚁越多。比喻行为和目的自相矛盾，只能得到相反的结果。同以肉去蚁”。",{"a":1,"w":[2262,7537,61,8267]}],["一发破的","yīfā pò de","发射出；的箭靶的中心。一箭就射中箭靶中心。比喻一下子就击中目标或一句话就击中要害。",{"a":1,"w":[11736,26968]}],["仰面唾天","yǎngmiàntuòtiān","仰头向着天吐唾沫，唾沫还是落在自己的脸上。比喻本来想损害别人，结果受害的还是自己。",{"a":1,"w":[62034,10006,19]}],["轩盖如云","xuāngàirúyún","轩古时供官员乘坐的一种便车；盖车盖。旧时形容官员很多，也形容官员、士绅集会的盛况。",{"a":1,"w":[441359,28495]}],["修短随化","xiūduǎnsuíhuà","修长；化造化，旧指自然界的主宰者，迷信说法指运气、命运。人的寿命长短，随造化而定。",{"a":1,"w":[154961,664018]}],["伈伈睍睍","xǐnxǐn xiànxiàn","伈伈小心恐惧的样子。睍睍也作伣伣”，眼睛不敢睁大的样子。小心害怕或低声下气的样子。",{"a":1,"w":[179528,318195]}],["向天而唾","xiàngtiān'értuò","仰头向着天吐唾沫，唾沫还是落在自己的脸上。比喻本来想损害别人，结果受害的还是自己。",{"a":1,"w":[537,19,2267,10006]}],["西邻责言","xīlín zéyán","西邻西部的邻国；责言问罪的话。原指秦国（在西）向晋国（在东）问罪◇泛指别人的责备。",{"a":1,"w":[115697,259219]}],["文修武备","wén xiūwǔ bèi","文指教化。修指走上正规，已符合标准。备准备完毕。谓文治和军备都已达到了理想的要求。",{"a":1,"w":[7415,143319,7452]}],["徒读父书","túdúfùshū","徒只。父书父亲之言论。白读父亲的兵书。比喻人只知死读书，不懂得运用知识，加以变通。",{"a":1,"w":[7813,186,7846,81]}],["司马青衫","sīmǎ qīngshān","司马古代官名，唐代诗人白居易曾贬官为江州司马。司马的衣衫为泪水所湿。形容极度悲伤。",{"a":1,"w":[10012,63510]}],["收因种果","shōuyīnzhǒngguǒ","指了却前缘，得到结果。旧有因果报应之说，指前有因缘则必有相对的后果。同收因结果”。",{"a":1,"w":[541,4624,1344,7445]}],["视同秦越","shìtóngqínyuè","先秦时秦越两国，一在西北，一在东南，相去极远◇因称疏远隔膜、互不相关为视同秦越”。",{"a":1,"w":[35843,80100]}],["什伍东西","shíwǔdōngxī","什伍纵横错杂。原指南斗六星，牵牛六星，箕四星等分布得杂乱无章◇多形容事物错杂纷乱。",{"a":1,"w":[7488,8730,226]}],["时绌举盈","shíchùjǔyíng","绌不足、不够。盈有余、多余。当衰败之时，而强作奢侈之事。盈，通赢”。同时绌举赢”。",{"a":1,"w":[1280,15971,606,8251]}],["师严道尊","shīyándàozūn","本指老师受到尊敬，他所传授的道理、知识、技能才能得到尊重◇多指为师之道尊贵、庄严。",{"a":1,"w":[7489,2349,511,7922]}],["日角龙颜","rìjiǎolóngyán","旧时相术家指额头隆起为龙颜。称之为为帝王的贵相。日角，额角中央部分隆起，形状如日。",{"a":1,"w":[151982,66260]}],["去就之分","qùjiùzhīfēn","去就；进退或取舍。分分寸。引申为应持的态度。比喻进取、取舍的分寸。亦作去就之际”。",{"a":1,"w":[38562,2254,15]}],["七死七生","qīsǐqīshēng","佛数谓小乘初果者，尚须往返天上人间，受七度生死，才能证得阿罗汉果。亦作七生七死”。",{"a":1,"w":[134,1329,508]}],["乃武乃文","nǎiwǔnǎiwén","本用以赞誉天子之德，指其文经天地，武定祸乱◇多指人既有武功又有文德。亦作乃文乃武。",{"a":1,"w":[8054,7504,7415]}],["暮景桑榆","mùjǐngsāngyú","夕阳斜照在桑树和榆树顶端，一派黄昏景象。比喻晚年的时光。桑榆，古人以为是日所入处。",{"a":1,"w":[160966,39450]}],["面壁功深","miànbì gōng shēn","面壁佛家语，指面对墙壁默坐静修⊥尚面壁静修，道行很深。比喻某人在某一方面造诣很深。",{"a":1,"w":[58282,7516,1343]}],["麦穗两岐","màisuì liǎngqí","①一麦两穗。旧时以为祥瑞，以兆丰年。亦用以称颂吏治成绩卓著。②比喻相像的两样事物。",{"a":1,"w":[50566,109714]}],["慢腾斯礼","mànténgsīlǐ","原指说话做事有条有理，不慌不忙。现也形容说话做事慢腾腾，不不慌不忙。同慢条斯理”。",{"a":1,"w":[182,7985,7406,3342]}],["聋者之歌","lóngzhězhīgē","聋者学人唱歌，却听不到歌声，无以自乐。形容模仿别人的行为，实际上乲不了解其中真义。",{"a":1,"w":[9524,1285,2254,208]}],["蓼虫忘辛","liǎochóngwàngxīn","吃惯了蓼（一种有辣味的草）的虫子已经不感到蓼是辣的了。比喻人为了所好就会不辞辛苦。",{"a":1,"w":[8988,7601,206,7882]}],["立木南门","lìmùnánmén","立木竖木于地上。用具体事实来证明新的法令、制度一定要推行开来。多用于形容取信于民。",{"a":1,"w":[66016,56174]}],["乐天任命","lètiānrènmìng","犹言听天由命。听任事态自然发展变化，不做主观努力。也比喻碰机会，该怎么样就怎么样。",{"a":1,"w":[16494,6435]}],["九死不悔","jiǔsǐbùhuǐ","九表示极多。纵然死很多回也不后悔。形容意志坚定，不认经历多少危险，也决不动摇退缩。",{"a":1,"w":[54297,158992]}],["九死未悔","jiǔsǐ wèi huǐ","九表示极多。纵然死很多回也不后悔。形容意志坚定，不认经历多少危险，也决不动摇退缩。",{"a":1,"w":[54297,7559,8771]}],["救黥医劓","jiùqíngyīyì","黥，刺面；劓，割鼻。均为古代刑罚。指医治刺面之伤，补上割掉之鼻，比喻恢复本来面目。",{"a":1,"w":[1409,19615,7668,44668]}],["巾国英雄","jīn guó yīngxióng","巾国即巾帼，古代妇女配戴的头巾和发饰，后借指妇女。指女子中的英雄。亦作巾帼英雄”。",{"a":1,"w":[8285,23,3647]}],["金枷玉锁","jīnjiāyùsuǒ","枷套在脖子上的刑具；锁用铁环连接而成的刑具。比喻儿女既是父母的宝贝，又是负低包袱。",{"a":1,"w":[1270,12092,2294,3368]}],["金人缄口","jīnrén jiānkǒu","金人铜制的人。缄口封嘴，指缄默不言。铜人闭口不讲话。形容言词谨慎。亦作金人三缄”。",{"a":1,"w":[37547,54146]}],["赍粮藉寇","jīliángjièkòu","赍资助；藉同借”；寇贼寇。借给敌寇兵器，送给盗贼粮食。比喻做有利于敌人、坏人的事。",{"a":1,"w":[286693,8459,9047]}],["魂亡魄失","húnwángpòshī","魂、魄即迷信所说的灵魂。形容万分惊恐，不知所措；有时也指受到了极大诱惑而不能自持。",{"a":1,"w":[113932,9063,7527]}],["荟萃一堂","huìcuì yītáng","荟萃草木繁茂，引申为杰出人物或精美东西的聚集；一堂指在一个厅堂里。形容难逢的盛会。",{"a":1,"w":[55409,16977]}],["浑然自成","húnrán zìchéng","形容诗文结构严密自然，用词运典毫无斧凿痕迹。亦形容人的才德完美自然。同浑然天成”。",{"a":1,"w":[23020,21453]}],["黄钟瓦釜","huángzhōngwǎfǔ","瓦釜泥土烧成的大锅，用作乐器，音调最为低。比喻高雅优秀的或庸俗低劣的；贤才和庸才。",{"a":1,"w":[16094,167410]}],["花朝月夜","huāzhāoyuèyè","有鲜花的早晨，有明月的夜晚。指美好的时光和景物。旧时也特指农历二月十五和八月十五。",{"a":1,"w":[58179,74333]}],["归正首丘","guīzhèngshǒuqiū","首向；丘土丘。传说狐狸即将死在外边，也要把头朝向所住洞穴的方向。指死后归葬于故乡。",{"a":1,"w":[30411,56629]}],["规行矩止","guīxíngjǔzhǐ","规、矩圆规和角尺，引伸为准则。指严格按照规矩办事，毫不苟且。也指办事死板，不灵活。",{"a":1,"w":[7549,8,8181,4656]}],["关情脉脉","guānqíngmàimài","关情关切的情怀。脉脉情意深长。形容眼神中表露的意味深长的绵绵情怀。亦作脉脉含情”。",{"a":1,"w":[258805,29634]}],["缟纻之交","gǎozhù zhī jiāo","缟纻缟带和纻衣。缟带指用白色绢制成的大带。纻衣指用苎麻纤维织成的衣服。指交情笃深。",{"a":1,"w":[125568,2254,535]}],["赴险如夷","fùxiǎnrúyí","赴投身进去；险危险；如像；夷平坦。走向危险的道路，看作像平坦的大道。形容不避艰险。",{"a":1,"w":[8928,4634,4614,7910]}],["凤枭同巢","fèngxiāotóngcháo","凤凤凰，吉祥的象征；枭恶鸟的象征。神鸟与恶鸟同在一个窝里。比喻好和坏混在一起不分。",{"a":1,"w":[7768,10374,4611,8435]}],["放歌纵酒","fànggēzòngjiǔ","放歌高声歌唱；纵酒任意饮酒，不加节制。尽情歌唱，放量地饮酒。形容开怀畅饮尽兴欢乐。",{"a":1,"w":[143351,91411]}],["独学寡闻","dú xué guǎwén","独学指自学而无以指导切磋。独自学习，无人切磋，则孤陋寡闻。形容孤偏鄙陋，见闻不多。",{"a":1,"w":[7561,13,78435]}],["低唱浅斟","dīchàngqiǎnzhēn","低唱轻柔地歌唱；斟喝酒。听人轻柔地歌唱，并自在地慢慢饮酒。形容一种安乐自在的神态。",{"a":1,"w":[125121,2400,11637]}],["低唱浅酌","dīchàngqiǎnzhuó","低唱轻柔地歌唱；酌饮酒。听人轻柔地歌唱，并自在地慢慢饮酒。形容一种安乐自在的神态。",{"a":1,"w":[125121,2400,9372]}],["带牛佩犊","dàiniúpèidú","原指汉宣帝时渤海太守龚遂诱使持刀剑起义的农民放弃武装斗争而从事耕种◇比喻改业归农。",{"a":1,"w":[542,1346,7810,10334]}],["摧坚获丑","cuījiān huò chǒu","摧坚击溃敌精锐部队。丑众，指敌人。挫败敌方精锐的军队，俘获敌寇。形容作战十分英勇。",{"a":1,"w":[199806,306856]}],["垂名竹帛","chuímíng zhúbó","垂名传名。竹帛古代供书写用的竹简和白绢，借指典籍、史册。名字被载入史册，流传后世。",{"a":1,"w":[56399,57509]}],["触机便发","chùjībiànfā","机弓弩上的发箭器。原指弓弩上的发箭器，一经触发，箭便射出◇亦指人遇到机会便要发作。",{"a":1,"w":[108921,3336,522]}],["财不露白","cáibùlùbái","露显露；白银子的代称。旧指有钱财不能泄露给别人看。现指随身携带的钱财不在人前显露。",{"a":1,"w":[7700,22793,24]}],["比目连枝","bǐmùliánzhī","比目比目鱼，传说仅一眼，须两鱼并游；连枝连在一起的树枝。比喻形影不离的情侣和朋友。",{"a":1,"w":[96659,86941]}],["闭关却扫","bìguānquèsǎo","却停止；却扫不再清扫车迹，意指谢客。关上大门，扫除车迹。指闭门谢客，不和外界往来。",{"a":1,"w":[23846,50213]}],["八音迭奏","bāyīn dié zòu","八音古代对乐器的统称；迭交互，轮流。八类乐器轮番演奏。表示器乐齐全，演奏场面盛大。",{"a":1,"w":[14307,8155,4777]}],["安营下寨","ānyíng xiàzhài","安、下建立，安置；寨防守用的栅栏。指部队驻扎下来。也比喻建立临时的劳动或工作基地。",{"a":1,"w":[102281,211321]}],["按兵束甲","ànbīng shù jiǎ","按兵军队停止行进。甲铠甲，泛指武器装备。止兵不前，捆起铠甲。指解除武装，停战言降。",{"a":1,"w":[38330,1407,3330]}],["几龙治水","jǐ lóng zhìshuǐ","旧时历书常用龙的图画来表示这一年的气候状况。龙的数量不同，表示的气候状况也就不一样",{"a":1,"w":[136,1308,30124]}],["乞留兀良","qǐ liú wùliáng","同“乞留乞良”。\n元郑庭玉《后庭花》第二摺：“不由我滴羞跌屑怕怖，乞留兀良口絮。”",{"a":1,"w":[9371,590,92143]}],["五洋杂货","wǔ yáng záhuò","旧称外国来的一些日用商品，如洋油、洋火、洋碱、洋蜡之类。亦泛指各种日用的零星货物。",{"a":1,"w":[106,4650,21874]}],["十二指阳","shí'èr zhǐ yáng","人的小肠的第一段，上接胃，下接空肠，因其长度约等于人的十二个手指并排的宽度，故名。",{"a":1,"w":[8641,1312,7484]}],["十方常住","shífāng chángzhù","佛教语。四种常住之一。谓接待往来僧人的寺院。亦称庙产等物品。见《行事钞》卷中之一。",{"a":1,"w":[117286,20694]}],["南熏北鄙","nánxūn běi bǐ","南薰，指虞、舜《南风》诗所表现的兴盛之声；北鄙，指殷纣所为北方边鄙之地的亡国之音。",{"a":1,"w":[309339,390928]}],["延津剑合","yánjīnjiànhé","指晋时龙泉、太阿两剑在延津会合的故事。后以“延津剑合”或“延津之合”比喻因缘会合。",{"a":1,"w":[349376,4730,1269]}],["滕薛争长","téng xuē zhēngzhǎng","《左传‧隐公十一年》：“滕侯、薛侯来朝，争长。”后以“滕薛争长”为典，谓竞相生长。",{"a":1,"w":[9454,11105,47838]}],["滴羞跌屑","dīxiūdiēxiè","同“滴羞笃速”。\n元郑廷玉《后庭花》第二摺：“今日今日羞辱，不由我滴羞跌屑怕怖。”",{"a":1,"w":[3434,8434,4818,4853]}],["无籍之徒","wújízhītú","同“无藉之徒”。\n元柯丹邱《荆钗记‧抢亲》：“况孙家是个无籍之徒，必来我家打闹。”",{"a":1,"w":[2255,7983,2254,7813]}],["稀散元素","xī sàn yuánsù","没有形成独立矿床，而以杂质状态分散在其他矿物中的元素。如硒、碲、锗、镓、铟、铊等。",{"a":1,"w":[8015,2286,4914]}],["笔锭如意","bǐ dìng rúyì","金银铸成如意形状的一种小锞子。供赏玩或装饰用。与“必定如意”谐音，象征吉祥，故名。",{"a":1,"w":[619,9058,9857]}],["卧苫枕块","wò shān zhěnkuài","古代礼教，子从父母之丧起至入葬，不住寝室，卧于草席，以土块为枕，谓之“卧苫枕块”。",{"a":1,"w":[7997,15408,60311]}],["华严世界","huáyán shìjiè","佛教语。法身佛毗卢遮那的净土。以大莲花中包藏微尘数的世界，故名。见《华严经》卷八。",{"a":1,"w":[30958,1398]}],["蚤兴夜寐","zǎoxīng yè mèi","谓提早起身，很晚才睡。形容勤劳。蚤，通“早”。语本《诗‧卫风‧氓》：“夙兴夜寐。”",{"a":1,"w":[259307,631,11604]}],["裂冠毁冕","lièguànhuǐmiǎn","1) 比喻背弃王室。\n2) 比喻绝意仕进。\n3) 比喻毁灭华夏文化，背离民族传统。",{"a":1,"w":[4657,7694,4749,9800]}],["雪山童子","xuěshān tóngzǐ","亦称“雪山大士”。\n佛教创始人释迦牟尼的别称。相传释氏在过去世曾在雪山修行，故称。",{"a":1,"w":[20677,15853]}],["鱼尾雁行","yúwěiyànxíng","谓兵轮行进之队列，一轮居中为首，其他轮船按人字形两旁依次排列，状如鱼尾，又如雁阵。",{"a":1,"w":[14503,20102]}],["酶法脱毛","méifǎ tuōmáo","皮革生产中脱掉毛的一种方法。以专用酶制剂作用于生皮，削弱毛与皮层的结合，将毛除去。",{"a":1,"w":[95687,16662]}],["琉璃珠冠","liúlízhū guān","buildings with glazed tile and pearl roof",{"a":1,"w":[367406,7694]}],["事必有兆","shì bìyǒu zhào","future events always have an omen (idiom)",{"a":1,"w":[33,11502,8519]}],["传播四方","chuánbō sìfāng","to disseminate in every direction (idiom)",{"a":1,"w":[1575,9798]}],["加封官阶","jiāfēng guānjiē","to confer additional titles on a nobleman",{"a":1,"w":[96954,110274]}],["售完即止","shòuwán jí zhǐ","while stocks last\nsubject to availability",{"a":1,"w":[281163,7854,4656]}],["尝尽心酸","cháng jìnxīn suān","to be dispirited and down hearted (idiom)",{"a":1,"w":[2455,17988,2277]}],["堵剿匪徒","dǔjiǎo fěitú","to hinder and exterminate bandits (idiom)",{"a":1,"w":[301884,117363]}],["广安地区","guǎng'ān dìqū","Guang’an prefecture level city in Sichuan",{"a":1,"w":[50779,1506]}]]