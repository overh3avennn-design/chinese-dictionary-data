[["飞行导航设备","fēixíng dǎohángshèbèi","用于飞机导航的各种技术设备的统称。按工作方式，分为自备式导航设备和他备式导航设备；按工作原理，分为无线电导航设备、惯性导航设备、天文导航设备和目视导航设备。",{"a":1,"w":[1415,37720]}],["炮兵分段射击","pàobīng fēnduàn shèjī","将各炮兵营或连的火力，分别指向同一目标中不同地段的射击。各营或连根据自己分担的射击地段或阻击线的中心点决定诸元，并根据射击地段的幅员或阻击线的宽度分配火力。",{"a":1,"w":[8512,16211,3433]}],["坦克火控系统","tǎnkè huǒkòngxìtǒng","用以搜索、发现目标和控制坦克武器进行跟踪、瞄准与发射的整套自动化或半自动化装置。主要包括火控计算机、传感器、测距仪、坦克炮稳定器、观察瞄准仪器和操纵机构等。",{"a":1,"w":[10215,122179]}],["野战供水标准","yězhàngōngshuǐ biāozhǔn","野战条件下供给军队饮水、用水的数量和水质参数的指标。分为饮用水标准、洗涤用水标准、冷却和洗消用水标准。其数量通常按单人、单车、单机在单位时间内的用水量计算。",{"a":1,"w":[360198,1429]}],["夜间侦察训练","yèjiānzhēnchá xùnliàn","为使侦察部队和分队掌握夜间实施侦察的技能和方法而进行的训练。主要训练内容包括：夜间活动的动作要领，夜间观察与潜听，夜视器材的种类、性能、特点及其操作使用等。",{"a":1,"w":[418255,1493]}],["有利攻击地线","yǒulì gōngjī dìxiàn","有利于反坦克导弹击毁目标的发射地线。根据反坦克导弹的战术技术性能和地形等条件，在目标可能出现的地域内预先或临时选定。目标接近此地线时发射导弹，射击效果最佳。",{"a":1,"w":[1862,4844,20278]}],["阿穆达特芦荟","ā mù dátè lúhuì","[p]бот.[/p] Aloe amudatensis",{"a":1}],["柠黄无丝鸢尾","níng huáng wú sī yuānwěi","[p]бот.[/p] Tigridia citrina",{"a":1}],["同站台换乘站","tóng zhàntái huànchéngzhàn","пересадка на одной платформе",{"a":1}],["快速拼装结构","kuàisù pīnzhuāng jiégòu","быстровозводимые конструкции",{"a":1}],["两性离子聚合","liǎngxìnglízǐ jùhé","цвиттер-ионная полимеризация",{"a":1}],["伺服执行机构","sìfú zhíxíngjīgòu","servo actuator сервомеханизм",{"a":1}],["化能有机营养","huà néng yǒujī yíngyǎng","химоорганотрофный (организм)",{"a":1}],["医药卫生机构","yīyàowèishēng jīgòu","медико-санитарное учреждение",{"a":1}],["合成化学武器","héchénghuàxué wǔqì","бинарное (химическое) оружие",{"a":1}],["地球椭球参数","dìqiú tuǒqiú cānshù","параметры земного эллипсоида",{"a":1}],["地理学思想史","dìlǐxué sīxiǎngshǐ","история географической мысли",{"a":1}],["地表水水文学","dìbiǎoshuǐ shuǐwénxué","гидрология поверхностных вод",{"a":1}],["塞尔托利细胞","sài'ěr tuōlì xìbāo","клетка Сертоли, Sertoli cell",{"a":1}],["大气环境监测","dàqìhuánjìng jiāncè","мониторинг атмосферной среды",{"a":1}],["天线稳定系统","tiānxiànwěndìng xìtǒng","система стабилизации антенны",{"a":1}],["微差延发爆炸","wēi chà yánfā bàozhà","короткозамед