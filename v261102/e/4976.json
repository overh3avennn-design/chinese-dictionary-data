媛","zhāoyuàn","唐代女官名。为九嫔之一。",{"a":1,"w":[8522,20064]}],["晁董","cháodǒng","汉代晁错和董仲舒的并称。",{"a":1,"w":[20186,8797]}],["晏赏","yànshǎng","宴饮赏玩。晏，通“宴”。",{"a":1,"w":[9793,2415]}],["晏游","yànyóu","宴饮游乐。晏，通“宴”。",{"a":1,"w":[9793,1317]}],["昼瞑","zhòumíng","白昼睡觉。瞑，通“眠”。",{"a":1,"w":[9111,13420]}],["曦价","xījià","希求善价。曦，通“希”。",{"a":1,"w":[12196,3325]}],["曦圣","xīshèng","仰慕圣人。曦，通“睎”。",{"a":1,"w":[12196,7587]}],["晦士","huìshì","指姓名不见于史传的人士。",{"a":1,"w":[9596,7542]}],["晦望","huìwàng","农历每月末一日与十五日。",{"a":1,"w":[9596,7556]}],["晦节","huìjié","唐代节日名。在正月晦日。",{"a":1,"w":[9596,540]}],["晦色","huìsè","变为昏暗之色。亦指暗色。",{"a":1,"w":[9596,2266]}],["晦雺","huìwù","昏暗。比喻政治黑暗无道。",{"a":1,"w":[9596,302028]}],["晨离","chénlí","指朝日。离，灵鸟，指日。",{"a":1,"w":[8733,543]}],["景语","jǐngyǔ","谓诗词中描写景物的文字。",{"a":1,"w":[4676,7447]}],["晖景","huījǐng","日影。指白天。景，阴影。",{"a":1,"w":[11534,4676]}],["暑吏","shǔlì","喻酷热大暑。吏，指酷吏。",{"a":1,"w":[9309,8898]}],["暖讲","nuǎnjiǎng","谓以酒食与听讲者相慰劳。",{"a":1,"w":[3424,653]}],["暗惑","ànhuò","愚昧不明，迷乱。指迷路。",{"a":1,"w":[2340,8601]}],["暮末","mùmò","犹末世。谓一代将终之时。",{"a":1,"w":[8841,2329]}],["暴缪","bàomóu","残暴乖谬。缪，通“谬”。",{"a":1,"w":[7675,9670]}],["晓筹","xiǎochóu","拂晓的更筹。指拂晓时刻。",{"a":1,"w":[8614,8478]}],["晓鬯","xiǎochàng","明白通达。鬯，通“畅”。",{"a":1,"w":[8614,14982]}],["曩怀","nǎnghuái","昔日之情怀；从前的抱负。",{"a":1,"w":[16629,7749]}],["曲旃","qūzhān","用整幅帛制成的曲柄长幡。",{"a":1,"w":[7517,11507]}],["曲衡","qūhéng","谓使物价有曲伸而不固定。",{"a":1,"w":[7517,7728]}],["曲迂","qūyū","弯绕。比喻隐晦，不显明。",{"a":1,"w":[7517,9628]}],["曳衒","yèxuàn","谓夫妇二人牵引过市叫卖。",{"a":1,"w":[8838,12032]}],["书方","shūfāng","记录送死物件数目的方板。",{"a":1,"w":[81,2257]}],["曹郎","cáoláng","即部曹。部属各司的官吏。",{"a":1,"w":[8358,8101]}],["曾思","céngsī","反覆思考。曾，通“增”。",{"a":1,"w":[2420,7586]}],["替差","tìchà","越分。替，“僭”的古字。",{"a":1,"w":[2368,121]}],["朅伽","qiègā","1) 犀牛。\n2) 剑。",{"a":1,"w":[14414,8571]}],["月成","yuèchéng","上古记载每月成就的文书。",{"a":1,"w":[101,517]}],["月旗","yuèqí","旗名。绘月于旗上，故名。",{"a":1,"w":[101,7796]}],["月窗","yuèchuāng","山洞岩穴内透光的大窍孔。",{"a":1,"w":[101,8301]}],["月粮","yuèliáng","古代每月支给兵丁的口粮。",{"a":1,"w":[101,8088]}],["月郭","yuèguō","月廓。月亮的轮廓、形状。",{"a":1,"w":[101,8959]}],["朋工","pénggōng","一种劳动互助组织的成员。",{"a":1,"w":[8128,7411]}],["朋帮","péngbāng","一种群众互助合作的形式。",{"a":1,"w":[8128,192]}],["服宠","fúchǒng","犹宠服。引申为重用贤人。",{"a":1,"w":[4619,8782]}],["服禫","fúdàn","服丧期满。禫，除服之祭。",{"a":1,"w":[4619,87507]}],["朔庭","shuòtíng","犹北庭。指北方异族政权。",{"a":1,"w":[8952,7760]}],["朝儒","cháorú","朝中的儒士。指在朝之官。",{"a":1,"w":[1357,8257]}],["朝宿","cháosù","谓供诸侯朝见天子时住宿。",{"a":1,"w":[1357,7825]}],["期丧","qīsàng","犹期服。为期一年的丧服。",{"a":1,"w":[1299,8016]}],["木李","mùlǐ","果名。即榠樝，又名木梨。",{"a":1,"w":[7435,7880]}],["木梆","mùbāng","用挖空的木头做成的梆子。",{"a":1,"w":[7435,11402]}],["木钵","mùbō","木制的钵。僧人所用食器。",{"a":1,"w":[7435,10148]}],["木厘","mùlí","清代专向木商征税的局卡。",{"a":1,"w":[7435,8618]}],["木阁","mùgé","即栈道。又称栈阁、阁道。",{"a":1,"w":[7435,8208]}],["末厥","mòjué","宋时俗语。谓卑劣，卑贱。",{"a":1,"w":[2329,8425]}],["末科","mòkē","谓科举考试及第的最下等。",{"a":1,"w":[2329,512]}],["末缀","mòzhuì","缀于榜末。指及第的末等。",{"a":1,"w":[2329,9248]}],["末见","mòjiàn","浅薄的见解。多用作谦词。",{"a":1,"w":[2329,76]}],["末进","mòjìn","犹后辈，后学。自谦之词。",{"a":1,"w":[2329,71]}],["札吏","zhálì","旧时官府撰拟公文的吏员。",{"a":1,"w":[8726,8898]}],["札嘴","zházuǐ","太平军中口语。矛的枪头。",{"a":1,"w":[8726,609]}],["朱跗","zhūfū","红色花萼。跗，通“柎”。",{"a":1,"w":[7906,19679]}],["朱车","zhūchē","红漆的车子，富贵家所乘。",{"a":1,"w":[7906,32]}],["朱镳","zhūbiāo","两端有红色佩饰的马嚼子。",{"a":1,"w":[7906,18613]}],["朱驳","zhūbó","骏马名。其毛色黄赤相杂。",{"a":1,"w":[7906,8526]}],["朱鱼","zhūyú","红色的鱼。多指红色金鱼。",{"a":1,"w":[7906,526]}],["机案","jī'àn","泛指案桌。机，通“几”。",{"a":1,"w":[7405,7610]}],["杌床","wùchuáng","一种用绳编制的轻便坐具。",{"a":1,"w":[17922,183]}],["材知","cáizhī","才能智慧。知，同“智”。",{"a":1,"w":[7585,7492]}],["村戏","cūnxì","犹社戏。乡村演的草台戏。",{"a":1,"w":[1430,3341]}],["村球","cūnqiú","指古代民间球赛所用的球。",{"a":1,"w":[1430,83]}],["杜房","dùfáng","唐杜如晦、房玄龄的并称。",{"a":1,"w":[7680,7555]}],["束急","shùjí","犹束湿。喻驭下苛酷急切。",{"a":1,"w":[1407,569]}],["东幸","dōngxìng","封建时代谓皇帝亲临东方。",{"a":1,"w":[87,8065]}],["东朔","dōngshuò","汉武帝侍臣东方朔的省称。",{"a":1,"w":[87,8952]}],["东灵","dōnglíng","旧时迷信称拘鬼魂的阴差。",{"a":1,"w":[87,7588]}],["东鞮","dōngdī","古代泛指东方的少数民族。",{"a":1,"w":[87,16645]}],["东髽","dōngzhuā","谓奔丧在东厢房以麻束发。",{"a":1,"w":[87,75448]}],["杳若","yǎoruò","杳然。形容渺茫不见踪影。",{"a":1,"w":[14142,4652]}],["杷推","pátuī","用杷推聚。形容数量极多。",{"a":1,"w":[12947,586]}],["松友","sōngyǒu","以松树为友。谓隐居避世。",{"a":1,"w":[2295,7735]}],["松籁","sōnglài","风吹松树发出的自然声韵。",{"a":1,"w":[2295,19549]}],["板桌","bǎnzhuō","只有板面而无抽屉的桌子。",{"a":1,"w":[1305,8416]}],["板桐","bǎntóng","古代传说仙人所住之山名。",{"a":1,"w":[1305,8334]}],["枉步","wǎngbù","犹劳步。称人走访的敬词。",{"a":1,"w":[9134,1337]}],["枉滞","wǎngzhì","指不得申雪的冤屈或冤案。",{"a":1,"w":[9134,8309]}],["枉妆","wǎngzhuāng","乱其妆饰。枉，通“狂”。",{"a":1,"w":[9134,8268]}],["林庐","línlú","林中茅屋。多指隐居之所。",{"a":1,"w":[7469,9988]}],["林溆","línxù","山林与水滨。指隐居之地。",{"a":1,"w":[7469,41464]}],["林濠","línháo","犹林壑。指景物幽深之处。",{"a":1,"w":[7469,20406]}],["枝萼","zhī'è","枝上的花萼。喻旁支宗族。",{"a":1,"w":[4696,9181]}],["枯皮","kūpí","指老年人干瘦粗糙的皮肤。",{"a":1,"w":[8333,1291]}],["枯萃","kūcuì","干枯憔悴。萃，通“悴”。",{"a":1,"w":[8333,9398]}],["枯莲","kūlián","指枯老的莲叶。亦指莲实。",{"a":1,"w":[8333,7819]}],["枯黯","kū'àn","憔悴而灰暗。多形容面色。",{"a":1,"w":[8333,14689]}],["架鳌","jià'áo","犹言占鳌头。喻应试得中。",{"a":1,"w":[1341,13761]}],["枷棒","jiābàng","枷与杖。旧时的两种刑具。",{"a":1,"w":[12092,2361]}],["染戕","rǎnqiāng","血染戈矛。表示誓师杀敌。",{"a":1,"w":[3355,20276]}],["柔恶","róu'è","指外似温柔内心恶劣的人。",{"a":1,"w":[8134,7620]}]]