":1,"w":[134,7428]}],["耕足","gēngzú","arable layer; tilth; agric horizon",{"a":1,"w":[2416,4625]}],["脏骨","zànggǔ","visceroskeleton; splanchnoskeleton",{"a":1,"w":[696,7537]}],["薄缎","báoduàn","satin mousseline; sheer silk satin",{"a":1,"w":[2319,11199]}],["说瞄","shuōmiáo","specification; instruction; legend",{"a":1,"w":[68,8445]}],["透冕","tòumiǎn","varnish paint; transparent varnish",{"a":1,"w":[2307,9800]}],["鞋钳","xiéqián","shoe pincers; shoe-maker’s pincers",{"a":1,"w":[685,8489]}],["㔑","chì","(same as 㓼) an incised wound; cuts",{"a":1}],["㯏","gǔ","(same as 穀) grains; corns; cereals",{"a":1}],["㸼","","(same as 犎) the zebu; or humped-ox"],["䍒","mǒu","(corrupted form) net; web; network",{"a":1}],["䑵","mù","(corrupted form of 艒) a small boat",{"a":1}],["䕹","zá","a curtain; a shade; screen; blinds",{"a":1}],["䙻","","to steal a look; to steal a glance"],["䟽","","(same as 疏) scattered or dispersed"],["蹆","tuǐ","(Cant.) to move in a straight line",{"a":1}],["素锅","sùguō","一种冬天食用的冷菜品. 一般是用猪手, 海带, 白菜, 藕等炖制而成",{"a":1,"w":[7468,3384]}],["泡会","pàohuì","participate in a very long meeting",{"a":1,"w":[4678,18]}],["七伐","qīfá","语出《书‧牧誓》：“夫子勖哉，不愆于四伐五伐，六伐七伐，乃止齐焉。”",{"a":1,"w":[134,8087]}],["不营","bùyíng","1) 不惑；不受迷惑。\n2) 不求。\n3) 不量度。\n4) 不建造。",{"a":1,"w":[0,7572]}],["丙魏","bǐngwèi","丙吉、魏相的并称。两人均为汉宣帝时丞相，以知大体、为政宽平名重当时。",{"a":1,"w":[4760,8322]}],["中父","zhōngfù","I\n同“仲父”。\n才德一般的父亲。\nII\n同“仲父”。\n父亲的次弟。",{"a":1,"w":[7,7846]}],["中遘","zhōnggòu","同“中冓”。\n唐刘禹锡《历阳事七十韵》：“口语成中遘，毛衣阻上征。”",{"a":1,"w":[7,23059]}],["丹旗","dānqí","同“丹旗”。\n三国魏应玚《驰射赋》：“树应鞞于路左，建丹旗于表路。”",{"a":1,"w":[7710,7796]}],["主命","zhǔmìng","1) 古代征战之前向庙主请命。\n2) 主掌号令。\n3) 主人的命令。",{"a":1,"w":[7425,4622]}],["乘查","chéngchá","同“乘槎”。\n唐孟浩然《岁暮海上作》诗：“借问乘查人，沧洲复谁在？”",{"a":1,"w":[3366,601]}],["乘障","chéngzhàng","同“乘鄣”。\n南朝宋鲍照《拟古》诗之一：“晚节从世务，乘障远和戎。”",{"a":1,"w":[3366,7656]}],["九藏","jiǔcáng","1) 人体中的九种内脏。\n2) 泛指内脏。\n3) 形脏和神脏的合称。",{"a":1,"w":[143,4688]}],["二丘","èrqiū","1) 圆丘与方丘。古时天子祭天地之处。\n2) 指苏州虎丘山与闾丘公。",{"a":1,"w":[91,7868]}],["二司","èrsī","1) 指汉王尊、王骏。二人皆为司隶校尉，故称。\n2) 指司徒、司空。",{"a":1,"w":[91,7476]}],["五就","wǔjiù","1) 五匝。\n2) 《孟子‧告子下》：“五就汤，五就桀者，伊尹也。”",{"a":1,"w":[106,95]}],["井乘","jǐngchéng","古代按甸(六十四井)为单位来摊派军赋(包括车马、兵甲、人员)的制度。",{"a":1,"w":[4671,3366]}],["交输","jiāoshū","古代的一种衣饰。把整幅布帛对角裁开，分别垂挂衣服后摆两边，若燕尾状。",{"a":1,"w":[535,1352]}],["仙蜕","xiāntuì","1) 道教称人升仙后留下的遗体。实即干尸。\n2) 引申谓仙人的遗物。",{"a":1,"w":[7740,11622]}],["任上","rènshàng","1) 谓居职理事。\n2) 指任职的时期。\n3) 任所。任职的所在地。",{"a":1,"w":[1331,9]}],["伊吕","yīlǚ","商伊尹辅商汤，西周吕尚佐周武王，皆有大功，后因并称伊吕泛指辅弼重臣。",{"a":1,"w":[7475,8345]}],["伊皋","yīgāo","伊尹，商代名相，皋陶，舜之大臣，掌刑狱之事。后常并称，喻指良相贤臣。",{"a":1,"w":[7475,10318]}],["伏箱","fúxiāng","驾车。伏，通“服”。语本《诗‧小雅‧大东》：“睆彼牵牛，不以服箱。”",{"a":1,"w":[7729,2354]}],["伏道","fúdào","1) 暗道，隐秘的通道。\n2) 指利用地形埋伏军队以袭击敌人的策略。",{"a":1,"w":[7729,511]}],["仓扁","cāngbiǎn","仓公扁鹊的并称。一为汉代人，一为春秋时人，均为名医。因亦以泛称良医。",{"a":1,"w":[8035,4716]}],["假候","jiǎhòu","古代对边境县人民实行军事编制，设伍、里、连、邑四级，一邑之长称假候。",{"a":1,"w":[562,7622]}],["伟节","wěijié","1) 高尚的节操。\n2) 喻指朝廷派出的大吏。节，符节，官吏的凭证。",{"a":1,"w":[9196,540]}],["伧子","cāngzi","1) 晋南北朝时，南人对北人或南渡北人的蔑称。\n2) 指鄙陋的庸人。",{"a":1,"w":[21665,1]}],["免选","miǎnxuǎn","宋代铨选制的一项规定。选人不经守选而直接赴吏部注授差遣，称“免选”。",{"a":1,"w":[7679,588]}],["全材","quáncái","1) 完美的、全能的材料。\n2) 在一定范围内，各方面都擅长的人才。",{"a":1,"w":[531,7585]}],["八物","bāwù","1) 用不同方法烹饪的八种精美食物。\n2) 犹八类。\n3) 谓八卦。",{"a":1,"w":[145,7412]}],["六印","liùyìn","1) 谓六国相印。\n2) 六将军印。\n3) 唐时官马身上的六种印记。",{"a":1,"w":[141,4649]}],["六桥","liùqiáo","浙江省杭州西湖外湖苏堤上之六桥：映波、锁澜、望山、压堤、东浦、跨虹。",{"a":1,"w":[141,1435]}],["六监","liùjiān","王莽时之司中、太御、太卫、奋武、军正、大赘，位皆上卿，号称“六监”。",{"a":1,"w":[141,7644]}],["初笄","chūjī","古代女子十五岁，始加笄。见《礼记‧内则》。后因以“初笄”指女子成年。",{"a":1,"w":[1400,13748]}],["创病","chuàngbìng","伤病。亦谓伤病者。旧题汉李陵《答苏武书》：“陵振臂一呼，创病皆起。”",{"a":1,"w":[7933,67]}],["功衰","gōngshuāi","古丧服名。谓斩衰、齐衰之丧在练祭之后所穿的丧服，其级别与“大功”同。",{"a":1,"w":[7516,7950]}],["勾乙","gōuyǐ","在报刊书籍的某些词句两端画上像“乙”的记号，表示要抄录下来作为资料。",{"a":1,"w":[8034,3373]}],["匪兕","fěisì","《诗‧小雅‧何草不黄》：“匪兕匪虎，率彼旷野。哀我征夫，朝夕不暇。”",{"a":1,"w":[8863,20710]}],["匪窟","fěikū","盗匪盘踞的地方。京剧《智取威虎山》第七场：“在匪窟日夜里思念母亲。”",{"a":1,"w":[8863,9601]}],["十辈","shíbèi","1) 从事同一或同类事务的前后十人。十，约数。\n2) 指同类的十物。",{"a":1,"w":[93,3502]}],["厎柱","dǐzhù","砥柱。古山名。即河南省三门峡市黄河中的三门山，今因修水库而山已不见。",{"a":1,"w":[15856,7685]}],["司文","sīwén","1) 官署名。犹今之礼宾司。\n2) 司文郎的省称。\n3) 掌管文教。",{"a":1,"w":[7476,7415]}],["同队","tóngduì","1) 犹同群。\n2) 同一队伍或同一队列。如：编队时，我和小王同队。",{"a":1,"w":[4611,570]}],["吴刀","wúdāo","1) 传说舜殛鲧所用之刀。\n2) 泛指宝刀。\n3) 吴地所产之剪刀。",{"a":1,"w":[8110,1369]}],["咕咙","gūlóng","1) 象声词。\n2) 犹咕哝。小声说话。多指自言自语，并带不满情绪。",{"a":1,"w":[9926,37116]}],["咷笑","táoxiào","《易‧同人》：“同人先号咷而后笑，大师克相遇。”后以“咷笑”指悲欢。",{"a":1,"w":[57471,185]}],["啼魂","tíhún","指杜鹃鸟。古代传说杜鹃鸟乃上古蜀王望帝(杜宇)所化，至春啼鸣，故称。",{"a":1,"w":[10453,8394]}],["严尊","yánzūn","1) 尊崇。\n2) 犹尊严。\n3) 敬词。用于称有身份、地位的对方。",{"a":1,"w":[2349,7922]}],["严训","yánxùn","1) 严厉训导；严厉管教。\n2) 指严厉的训斥。\n3) 父训；父命。",{"a":1,"w":[2349,7853]}],["四圭","sìguī","古代贵族祭天所用的礼器。由整块玉雕成，中央为璧，四面锐出为圭，故称。",{"a":1,"w":[86,9153]}],["四存","sìcún","清初颜元着《存性》、《存学》、《存治》、《存人》四编，合称“四存”。",{"a":1,"w":[86,1349]}],["四校","sìxiào","1) 天子射猎时的四支扈从部队。\n2) 谓四面的军队，形容军队众多。",{"a":1,"w":[86,7600]}],["四试","sìshì","1) 古代诸侯、州伯定期考核官吏的制度。\n2) 指科举中的四级考试。",{"a":1,"w":[86,105]}],["圉空","yǔkōng","同“圄空”。\n《汉书‧王褒传》：“昔周公躬吐捉之劳，故有圉空之隆。”",{"a":1,"w":[11291,1274]}],["圜阙","huánquē","古代宫殿前的高建筑物。通常左右各一，建成高台，台上起楼观，上圆下方。",{"a":1,"w":[13026,8773]}],["地匣","dìxiá","即匣床。旧时牢狱中的一种刑具。施刑时，囚犯仰卧其上，手足被紧紧夹住。",{"a":1,"w":[10,10001]}],["地禁","dìjìn","1) 兵家语。谓防区内禁止随意通行。\n2) 谓地处禁中。禁，指宫禁。",{"a":1,"w":[10,7708]}],["坡颍","pōyǐng","苏轼，号东坡居士；苏辙，号颍滨遗老。故以“坡颍”为他们兄弟俩的并称。",{"a":1,"w":[4791,30520]}],["尘听","chéntīng","1) 尘俗之音。\n2) 谦词。犹言污耳。谓请人听自己的言辞或歌唱等。",{"a":1,"w":[7843,146]}],["寿骨","shòugǔ","1) 头盖骨。\n2) 相术用语。指耳后的头骨部分。\n3) 借指寿命。",{"a":1,"w":[7921,7537]}],["夏征","xiàzhēng","谓夏收后政府征收公粮。如：夏季作物因灾歉收者，在夏征时，可酌情减免。",{"a":1,"w":[1397,7581]}],["伙烦","huǒfán","同“夥繁”。\n宋苏辙《论黄河东流札子》：“北京宫阙所在，兵民夥烦。”",{"a":1,"w":[2401,2397]}],["夷越","yíyuè","1) 古国名。即于越。\n2) 古代对长江中下游以南各族聚居地区之称。",{"a":1,"w":[7910,597]}],["奇突","qítū","犹奇特。徐念慈《余之小说观》：“﹝小说之题名﹞不嫌其奇突而谲诡也。”",{"a":1,"w":[7460,7750]}],["妖丽","yāolì","1) 艳丽。\n2) 指艳丽的女子或花朵。\n3) 形容歌声之婉转动听。",{"a":1,"w":[8617,7634]}],["娥英","éyīng","1) 娥皇、女英的并称。相传为帝尧二女，帝舜之二妃。\n2) 女官名。",{"a":1,"w":[10163,7637]}],["孤都","gūdōu","1) 古人对圆头东西的称呼。\n2) 形容因生气或愁苦而撅着嘴的样子。",{"a":1,"w":[7996,130]}],["安贞","ānzhēn","静而正。语本《易‧坤》：“安贞吉……《彖》曰：安贞之吉，应地无疆。”",{"a":1,"w":[2261,8844]}],["宣授","xuānshòu","1) 宣布和授予。\n2) 指用皇帝制书的形式委命官职。\n3) 传授。",{"a":1,"w":[7827,8099]}],["宣旬","xuānxún","巡抚各地，宣扬德教。语出《诗‧大雅‧江汉》：“王命召虎，来旬来宣。”",{"a":1,"w":[7827,9247]}],["容当","róngdāng","表敬之辞。恳请对方给予某种行动的机会。多用于向对方表示自己该怎麽做。",{"a":1,"w":[7524,552]}],["写心","xiěxīn","1) 抒发内心感情。\n2) 谓描写人的内心世界。\n3) 舒心，开心。",{"a":1,"w":[172,1279]}],["宝箧","bǎoqiè","1) 藏玉玺的小箱子。借指玉玺，旧时以喻政权。\n2) 藏珍宝的小箱。",{"a":1,"w":[2313,15648]}],["小弱","xiǎoruò","1) 弱小。\n2) 指弱小的国家。\n3) 幼弱。\n4) 指幼弱的人。",{"a":1,"w":[16,2376]}],["尾琐","wěisuǒ","1) 细碎琐屑，微小。\n2) 形容衰微。\n3) 犹猥琐，庸俗不大方。",{"a":1,"w":[7474,9120]}],["属城","shǔchéng","1) 下属的城邑。\n2) 指下属的地方官员。\n3) 指地方负责官员。",{"a":1,"w":[1268,1353]}],["山斤","shānjīn","佛教语。高山的斤数。谓以斤两衡量须弥山的重量。喻佛法广大或佛寿无量。",{"a":1,"w":[45,714]}],["岷峨","mín'é","1) 岷山和峨眉山的并称。\n2) 特指峨眉山。以其在岷山之南，故称。",{"a":1,"w":[15066,9923]}],["崇侈","chóngchǐ","1) 奢侈。\n2) 谓崇尚奢侈。\n3) 高大华丽。\n4) 崇高伟大。",{"a":1,"w":[8311,9324]}],["昆轴","kūnzhóu","即蜀冈，在江苏省。语本南朝宋鲍照《芜城赋》：“柂以漕渠，轴以崑岗。”",{"a":1,"w":[8191,7648]}],["嵬然","wéirán","1) 屹立貌。\n2) 引申为庄严貌，端庄貌。\n3) 犹块然。独处貌。",{"a":1,"w":[13978,7451]}],["巉刻","chánkè","1) 险峻陡峭。\n2) 形容言词尖刻。\n3) 形容诗文风格清峭瘦硬。",{"a":1,"w":[21337,626]}],["巡茶","xúnchá","巡察茶政。古代茶税为重要的国课，明曾专设巡茶御史负责监察茶叶的销售。",{"a":1,"w":[7981,157]}],["左绵","zuǒmián","1) 晋左思《蜀都赋》：“于东则左绵巴中，百濮所充。”\n2) 地名。",{"a":1,"w":[154,8228]}],["巾拂","jīnfú","1) 巾和拂，古代舞蹈道具。\n2) 指巾舞和拂舞。\n3) 泛指舞蹈。",{"a":1,"w":[8285,8565]}],["帷甲","wéijiǎ","谓张设帷幕以藏甲兵。语本《左传‧昭公二十七年》：“及飨日，帷诸门左。",{"a":1,"w":[11988,3330]}],["帷荒","wéihuāng","古代棺饰之一，为布帛制的外层棺罩，覆于内衬罩“褚”与竹罩“池”之上。",{"a":1,"w":[11988,7797]}],["常宗","chángzōng","1) 永恒的大宗。嫡长子所传之宗，祖庙永不迁，故称。\n2) 佛教语。",{"a":1,"w":[99,7624]}],["干贽","gànzhì","古时初见尊长时所送的礼物。凡鸡、鹜、凫、雁之属，干者谓之腒，即干贽。",{"a":1,"w":[46,14613]}],["幽阴","yōuyīn","1) 阴静；幽深。\n2) 阴暗。\n3) 指阴间。\n4) 用以指阴魂。",{"a":1,"w":[8098,576]}],["庶馐","shùxiū","同“庶羞”。\n明何景明《拟古诗》之十三：“何必倾庶馐，浊酤聊与适。”",{"a":1,"w":[8722,27018]}],["厢悬","xiāngxuán","古代礼乐制度。悬钟磬类乐器于厢室中，谓之“厢悬”。其悬法因等级而异。",{"a":1,"w":[9106,4694]}],["庐垩","lú'è","古人服丧时所居的墓旁小屋。垩，垩室。亲者、贵者居庐，疏者、贱者居垩。",{"a":1,"w":[9988,10950]}],["御坐","yùzuò","亦作“御座”。\n1) 侍坐。\n2) 皇帝的宝座。\n3) 帝王的星座。",{"a":1,"w":[7809,128]}],["怨魄","yuànpò","1) 指杜鹃鸟。相传杜鹃为古蜀帝杜宇怨魂所化，故称。\n2) 指月亮。",{"a":1,"w":[3431,9063]}],["惟良","wéiliáng","贤良；贤能的官吏。语出《书‧君陈》：“呜呼，臣人咸若时，惟良显哉。”",{"a":1,"w":[9009,7645]}],["愆素","qiānsù","谓越过原来计划。语本《左传‧宣公十一年》：“事三旬而成，不愆于素。”",{"a":1,"w":[10996,7468]}],["感切","gǎnqiè","1) 犹感化。\n2) 亲切动人。\n3) 深切感动。\n4) 伤感凄切。",{"a":1,"w":[7473,2276]}],["悬山","xuánshān","我国传统建筑双坡屋顶形式之一。特点是屋面两侧伸出山墙之外。也称挑山。",{"a":1,"w":[4694,45]}],["悬引","xuányǐn","元、明、清时贩卖盐茶等，以若干斤为一引，按引课税，其悬欠的税称悬引。",{"a":1,"w":[4694,2281]}],["承华","chénghuá","1) 汉马监、马厩名。\n2) 太子宫门名。\n3) 指太子宫室或太子。",{"a":1,"w":[7576,7503]}],["把色","bǎsè","1) 宋元杂剧、金院本演出时的乐工。\n2) 指伎乐的乐官。也称色长。",{"a":1,"w":[1321,2266]}],["拜洗","bàixǐ","古代的一种礼仪。谓主人为宾客洗爵时，宾客于西阶上北面而拜，表示感谢。",{"a":1,"w":[7752,161]}],["授孑","shòujié","授予兵器。语本《左传‧庄公四年》：“楚武王荆尸，授师孑焉，以伐随。”",{"a":1,"w":[8099,13218]}],["控送","kòngsòng","喻行文流畅自如。语本《诗‧郑风‧大叔于田》：“抑磬控忌，抑纵送忌”。",{"a":1,"w":[7501,137]}],["揉斫","róuzhuó","砍削烤揉。亦用以称耒耜。语出《易‧系辞下》：“斫木为耜，揉木为耒。”",{"a":1,"w":[5043,11020]}],["摄官","shèguān","1) 任职的谦词。表示暂时代理。\n2) 暂行代理的非正式任命的官员。",{"a":1,"w":[7746,2293]}]]