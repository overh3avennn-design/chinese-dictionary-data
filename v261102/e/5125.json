人之谓。",{"a":1,"w":[4618,11758]}],["记史","jìshǐ","指职掌章表书牍的吏员。",{"a":1,"w":[110,7661]}],["讷直","nèzhí","谓言语迟钝，品格正直。",{"a":1,"w":[9956,1294]}],["设纚","shèlí","用帛为行冠礼的人束发。",{"a":1,"w":[7479,14953]}],["许张","xǔzhāng","唐代许远、张巡的并称。",{"a":1,"w":[7709,1333]}],["许郭","xǔguō","东汉许劭、郭太的并称。",{"a":1,"w":[7709,8959]}],["许鄙","xǔbǐ","古代传说中的善相马者。",{"a":1,"w":[7709,9507]}],["诃辱","hērǔ","大声斥责，使觉得羞耻。",{"a":1,"w":[10266,8418]}],["注赞","zhùzàn","关于言行的说明和赞语。",{"a":1,"w":[7606,8033]}],["訾讆","zīwèi","谓诋毁贤者而赞誉恶者。",{"a":1,"w":[9517,79091]}],["诈注","zhàzhù","谓登记户口时弄虚作假。",{"a":1,"w":[8297,7606]}],["诏囚","zhàoqiú","奉皇帝命令拘禁的囚犯。",{"a":1,"w":[9242,9361]}],["诐憸","bìxiān","指谄佞奸邪的世俗之论。",{"a":1,"w":[22846,21799]}],["询闻","xúnwén","闻讯。询，用同“讯”。",{"a":1,"w":[8379,629]}],["诣入","yìrù","造诣，达到的艺术境界。",{"a":1,"w":[15360,4615]}],["试铨","shìquán","谓经过考试；量才授官。",{"a":1,"w":[105,10543]}],["诗梦","shīmèng","如诗一般的梦境，美梦。",{"a":1,"w":[2369,2386]}],["诗源","shīyuán","喻关于诗的理论、主张。",{"a":1,"w":[2369,7816]}],["诗祖","shīzǔ","诗的某一流派的创始人。",{"a":1,"w":[2369,7723]}],["诗舌","shīshé","吟诗之口。舌，借指口。",{"a":1,"w":[2369,7844]}],["诗运","shīyùn","犹诗风。指诗歌的风骨。",{"a":1,"w":[2369,3313]}],["诟租","gòuzū","谓骂骂咧咧地催交租税。",{"a":1,"w":[18586,665]}],["诡祠","guǐcí","淫祠，祭祀邪神的祠庙。",{"a":1,"w":[8845,10439]}],["诡越","guǐyuè","谓行事怪诞，超越常理。",{"a":1,"w":[8845,597]}],["诠第","quándì","犹诠次。诠，通“铨”。",{"a":1,"w":[15752,125]}],["诠除","quánchú","犹诠授。诠，通“铨”。",{"a":1,"w":[15752,4635]}],["诘蹶","jíjué","犹竭蹶。形容境况窘迫。",{"a":1,"w":[10718,9501]}],["该该","gāigāi","喜笑貌。该，通“咳”。",{"a":1,"w":[672]}],["诓赚","kuāngzhuàn","谓以甜言蜜语进行诈骗。",{"a":1,"w":[39464,2536]}],["认族","rènzú","谓同姓不宗而认成同族。",{"a":1,"w":[3370,4632]}]]