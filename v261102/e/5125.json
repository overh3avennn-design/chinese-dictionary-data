[["粉颈","fěnjǐng","指妇女洁白细腻的颈项。",{"a":1,"w":[7613,8141]}],["粉饵","fěn'ěr","一种用米粉制作的食品。",{"a":1,"w":[7613,9420]}],["粥糜","zhōumí","粥。糜，谓煮米使糜烂。",{"a":1,"w":[4875,9609]}],["粮斛","liánghú","粮食。以斛计量，故称。",{"a":1,"w":[8088,9602]}],["系吝","xìlìn","谓有所眷恋，不能割舍。",{"a":1,"w":[1277,11060]}],["红埃","hóng'āi","犹红尘。指飞扬的尘土。",{"a":1,"w":[534,7754]}],["红壁","hóngbì","红墙。亦指赤色的山壁。",{"a":1,"w":[534,7850]}],["红铺","hóngpù","明代称警卫皇城的哨所。",{"a":1,"w":[534,4756]}],["纡组","yūzǔ","系佩官印。谓身居官位。",{"a":1,"w":[11098,558]}],["纸帊","zhǐpà","铺垫或覆盖盛器的纸片。",{"a":1,"w":[622,42386]}],["纸火","zhǐhuǒ","香烛纸锭之类的迷信品。",{"a":1,"w":[622,1284]}],["素将","sùjiāng","宿将。久经战阵的将领。",{"a":1,"w":[7468,3328]}],["素管","sùguǎn","指管乐器。亦泛指乐器。",{"a":1,"w":[7468,1278]}],["素帘","sùlián","白色的帘子。借指瀑布。",{"a":1,"w":[7468,8925]}],["紫皇","zǐhuáng","道教传说中最高的神仙。",{"a":1,"w":[3348,7732]}],["紫绂","zǐfú","贵官系印用的紫色丝绳。",{"a":1,"w":[3348,21975]}],["紫闼","zǐtà","指宫廷。闼，宫中小门。",{"a":1,"w":[3348,12908]}],["累胝","lèizhī","谓手足重茧。形容辛劳。",{"a":1,"w":[173,21546]}],["絁缦","shīmàn","无花纹图案的粗质缯帛。",{"a":1,"w":[74886,13287]}],["絁袍","shīpáo","用粗质丝织物做的袍子。",{"a":1,"w":[74886,9451]}],["终具","zhōngjù","送终之具，指棺、椁等。",{"a":1,"w":[7638,7505]}],["终复","zhōngfù","终而复始，谓循环相继。",{"a":1,"w":[7638,7461]}],["弦师","xiánshī","对弹奏弦乐器者的尊称。",{"a":1,"w":[4726,7489]}],["组冕","zǔmiǎn","组绶和冠冕。借指官位。",{"a":1,"w":[558,9800]}],["组就","zǔjiù","古代冕旒上彩色丝绳串。",{"a":1,"w":[558,95]}],["结绶","jiéshòu","佩系印绶。谓出仕为官。",{"a":1,"w":[2271,10706]}],["绝哭","juékū","悲痛哭泣。谓伤心之极。",{"a":1,"w":[4627,728]}],["绝轨","juéguǐ","犹远迹。指先贤的事迹。",{"a":1,"w":[4627,7822]}],["绦线","tāoxiàn","泛指杂色丝带丝线之类。",{"a":1,"w":[10964,1282]}],["绦脱","tāotuō","条脱。古代的一种臂饰。",{"a":1,"w":[10964,2312]}],["绡縠","xiāohú","泛指轻纱之类的丝织品。",{"a":1,"w":[22878,34089]}],["绿琴","lǜqín","绿绮琴之省称。泛指琴。",{"a":1,"w":[605,3367]}],["绸绸","chóuchóu","密集貌。绸，通“稠”。",{"a":1,"w":[9638]}],["绶花","shòuhuā","花名。蔓生如绶，故名。",{"a":1,"w":[10706,20]}],["绾组","wǎnzǔ","系结组绶。谓佩挂官印。",{"a":1,"w":[15694,558]}],["绮船","qǐchuán","画舫。装饰华丽的游船。",{"a":1,"w":[9776,621]}],["绵劣","miánliè","谓才能薄弱，智力低下。",{"a":1,"w":[8228,8543]}],["绵痼