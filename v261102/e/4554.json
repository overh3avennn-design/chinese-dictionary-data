闶","wěikāng","谓高大的建筑物重叠。形容其多。",{"a":1,"w":[9889,57121]}],["狮负","shīfù","宝石名。即猫睛石，俗称猫儿眼。",{"a":1,"w":[9073,4638]}],["独专","dúzhuān","1) 单独占有。\n2) 独擅。",{"a":1,"w":[7561,7548]}],["获夷","huòyí","能俘获夷狄者。一说是古之壮士。",{"a":1,"w":[2355,7910]}],["获隽","huòjuàn","会试得中。亦泛指科举考试得中。",{"a":1,"w":[2355,15963]}],["猎渔","lièyú","犹渔猎。比喻泛览博涉(书卷)。",{"a":1,"w":[8294,8354]}],["献羔","xiàngāo","古祭礼之一。进献羔羊以祭司寒。",{"a":1,"w":[3435,11158]}],["献鸠","xiànjiū","进献鸠鸟。以示尊老、奉养老者。",{"a":1,"w":[3435,8570]}],["玄川","xuánchuān","指黑河，即张掖河，在今甘肃省。",{"a":1,"w":[7911,7897]}],["玄渚","xuánzhǔ","1) 深池。\n2) 水中洲渚。",{"a":1,"w":[7911,13440]}],["玄蚪","xuándǒu","黑墨写的蝌蚪文，指先秦古文字。",{"a":1,"w":[7911,24234]}],["玄露","xuánlù","1) 清露。\n2) 比喻美酒。",{"a":1,"w":[7911,4674]}],["玄鬓","xuánbìn","1) 黑色鬓发。\n2) 指蝉。",{"a":1,"w":[7911,10863]}],["玄黎","xuánlí","即悬黎，美玉名。玄，通“悬”。",{"a":1,"w":[7911,8227]}],["率道","lǜdào","I\n遵循正道。\nII\n犹领导。",{"a":1,"w":[7458,511]}],["玉婘","yùquán","对人眷属的美称。婘，通“眷”。",{"a":1,"w":[2294]}],["玉户","yùhù","玉饰的门户，亦用作门户的美称。",{"a":1,"w":[2294,2320]}],["玉文","yùwén","玉简上的文字或用作文字的美称。",{"a":1,"w":[2294,7415]}],["玉梯","yùtī","1) 犹玉楼。\n2) 犹玉栏。",{"a":1,"w":[2294,8006]}],["玉箧","yùqiè","玉饰的小箱。亦用作小箱的美称。",{"a":1,"w":[2294,15648]}],["玉笼","yùlóng","玉饰的鸟笼。亦用为鸟笼的美称。",{"a":1,"w":[2294,7956]}],["玉轫","yùrèn","车轮垫木的美称。后常借指车子。",{"a":1,"w":[2294,13175]}],["玉闼","yùtà","华美的门。指帝王或仙人的居所。",{"a":1,"w":[2294,12908]}],["王内","wángnèi","指路门以内王及后夫人所居之处。",{"a":1,"w":[2278,1287]}],["玫陛","méibì","犹玉陛，玉阶。帝王宫殿的台阶。",{"a":1,"w":[9967,10492]}],["玷冒","diànmào","忝冒。自谦之词。犹言滥竽充数。",{"a":1,"w":[14339,3400]}],["珍盘","zhēnpán","盘子的美称。亦借指味美的菜肴。",{"a":1,"w":[8037,2285]}],["珠顶","zhūdǐng","用东珠装饰的帽顶，上衔红宝石。",{"a":1,"w":[7784,2298]}],["珩组","hángzǔ","系佩玉的组绶，有官位者的佩饰。",{"a":1,"w":[45892,558]}],["班墨","bānmò","战国时鲁人公输班和墨翟的并称。",{"a":1,"w":[135,7667]}],["理孙","lǐsūn","顺畅，顺通。孙，“逊”的古字。",{"a":1,"w":[4609,7936]}],["琝砆","mínfū","泛指似玉之石。喻不堪大用之材。",{"a":1,"w":[103393]}],["琰琬","yǎnwǎn","1) 美玉。\n2) 比喻美好。",{"a":1,"w":[30166,44766]}],["瑜琏","yúliǎn","玉制礼器。比喻德才兼备的人材。",{"a":1,"w":[9512,19902]}],["瑶斝","yáojiǎ","玉制的酒杯。亦用作酒杯的美称。",{"a":1,"w":[9687,50889]}],["瑶杯","yáobēi","玉制的酒杯。亦用作酒杯的美称。",{"a":1,"w":[9687,199]}],["瑶源","yáoyuán","帝王的族系。泛指家世不凡的人。",{"a":1,"w":[9687,7816]}],["瑶篚","yáofěi","饰以美玉的筐子。用盛祭奉之物。",{"a":1,"w":[9687,55203]}],["瑶辂","yáolù","美玉装饰的车子，特指帝王之车。",{"a":1,"w":[9687,14323]}],["瑶钗","yáochāi","1) 玉钗。\n2) 借指美女。",{"a":1,"w":[9687,10709]}],["璧除","bìchú","玉除。用美玉砌成或装饰的台阶。",{"a":1,"w":[8965,4635]}],["环拱","huángǒng","1) 犹环绕。\n2) 犹禁卫。",{"a":1,"w":[1320,8219]}],["琼池","qióngchí","1) 池的美称。\n2) 仙池。",{"a":1,"w":[8471,7815]}],["琼琇","qióngxiù","1) 美玉。\n2) 比喻贤才。",{"a":1,"w":[8471,106454]}],["瓦埴","wǎzhí","把细黏土制成瓦器。埴，细黏土。",{"a":1,"w":[7533,17873]}],["瓮齑","wèngjī","瓮装的黄齑(咸菜)。以喻薄禄。",{"a":1,"w":[10187,23399]}],["甘临","gānlín","《易‧临》：“甘临，无攸利。”",{"a":1,"w":[7681,7625]}],["生櫱","shēngniè","活的枝条。亦用以指生存的希望。",{"a":1,"w":[508,71976]}],["生台","shēngtái","寺院施舍饭食供禽虫啄食的台案。",{"a":1,"w":[508,1306]}],["用挟","yòngxié","周浃。普遍深入。挟，同“浃”。",{"a":1,"w":[26,9195]}],["田具","tiánjù","1) 狩猎用具。\n2) 农具。",{"a":1,"w":[4668,7505]}],["畎田","quǎntián","亦作“甽田”。\n在田中开小沟。",{"a":1,"w":[23738,4668]}],["畏匡","wèikuāng","《论语‧子罕》：“子畏于匡。”",{"a":1,"w":[8606,9197]}],["留笺","liújiān","指人臣死时留下的奏章。即遗表。",{"a":1,"w":[590,9999]}],["留运","liúyùn","停止运行。一说，犹留连、留滞。",{"a":1,"w":[590,3313]}],["畤畦","zhìqí","畦畤。泛指古代帝王祭祀的场所。",{"a":1,"w":[39975,13583]}],["略约","lüèyuē","1) 简略配制。\n2) 约略。",{"a":1,"w":[7658,1330]}],["番塞","fānsāi","指与少数民族或外国交界的要地。",{"a":1,"w":[4735,4630]}],["番奴","fānnú","旧称少数民族或外国人为奴仆者。",{"a":1,"w":[4735,8153]}],["番次","fāncì","1) 依次。\n2) 分批轮流。",{"a":1,"w":[4735,102]}],["番氓","fānmáng","旧时对少数民族普通民众的称呼。",{"a":1,"w":[4735,10282]}],["画檐","huàyán","亦作“画檐”。\n有画饰的屋檐。",{"a":1,"w":[625,9322]}],["画翣","huàshà","有彩画的棺饰，古代出殡时用之。",{"a":1,"w":[625,24163]}],["畬刀","shēdāo","指用火种刀耕的方法来耕种土地。",{"a":1,"w":[26618,1369]}],["畬耕","shēgēng","指采用刀耕火种的方法耕种田地。",{"a":1,"w":[26618,2416]}],["畯望","jùnwàng","指德高望重的人。畯，通“峻”。",{"a":1,"w":[24945,7556]}],["当壮","dāngzhuàng","1) 强壮。\n2) 指强壮者。",{"a":1,"w":[552,8135]}],["迭掌","diézhǎng","1) 合掌。\n2) 相继执掌。",{"a":1,"w":[8155,7833]}],["疏丧","shūsàng","关系疏远者或远宗、远亲的丧事。",{"a":1,"w":[7743,8016]}],["疏逸","shūyì","1) 淡泊超逸。\n2) 散失。",{"a":1,"w":[7743,8116]}],["疑止","yízhǐ","停止，有所不为。疑，通“凝”。",{"a":1,"w":[8055,4656]}],["疲老","pílǎo","1) 衰老。\n2) 困倦劳顿。",{"a":1,"w":[8586,55]}],["疵贱","cījiàn","1) 卑贱。\n2) 卑贱的人。",{"a":1,"w":[10139,8426]}],["疽疮","jūchuāng","1) 毒疮。\n2) 比喻祸患。",{"a":1,"w":[10949,8769]}],["病齿","bìngchǐ","牙病；牙齿痛。亦指有病的牙齿。",{"a":1,"w":[67,7577]}],["痊疴","quánkē","1) 痊愈。\n2) 使病痊愈。",{"a":1,"w":[21176,14677]}],["痟疾","xiāojí","1) 消渴病。\n2) 头痛病。",{"a":1,"w":[36811,7794]}],["痼瘵","gùzhài","积久难治的病。亦指患痼疾的人。",{"a":1,"w":[16723,20098]}],["疮疾","chuāngjí","泛指疥癣痈疽等皮肤及外科疾患。",{"a":1,"w":[8769,7794]}],["瘦悴","shòucuì","1) 消瘦憔悴。\n2) 瘦悴。",{"a":1,"w":[1486,11042]}],["疟龟","nüèguī","龟的一种。用以烧灰，可治老疟。",{"a":1,"w":[11515,7684]}],["疠痎","lìjiē","恶性疟疾。亦指患恶性疟疾的人。",{"a":1,"w":[12669,120601]}],["痴笨","chībèn","亦作“痴笨”。\n迟钝，不灵活。",{"a":1,"w":[8690,2544]}],["痴话","chīhuà","亦作“痴话”。\n不明事理的话。",{"a":1,"w":[8690,120]}],["登戒","dēngjiè","佛教语。指佛教信徒出家为僧尼。",{"a":1,"w":[2316,3377]}],["发字","fāzì","谓解释多音多义字在文中的音义。",{"a":1,"w":[522,84]}],["白枣","báizǎo","枣子的一种。其子白乃熟，故名。",{"a":1,"w":[24,8507]}],["白泉","báiquán","传说中的白色泉水。亦泛指清泉。",{"a":1,"w":[24,3461]}],["白灿","báicàn","雪白的光彩。形容银锭等的色泽。",{"a":1,"w":[24,13013]}]]