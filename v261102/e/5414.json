,["阴凝冰坚","yīn níngbīng jiān","阴气始凝结而为霜，渐积聚乃成坚冰。比喻小人渐渐得势，地位渐趋稳固。",{"a":1,"w":[576,201506,7849]}],["阴凝坚冰","yīn níng jiānbīng","阴气始凝结而为霜，渐积聚乃成坚冰。比喻小人渐渐得势，地位渐趋稳固。",{"a":1,"w":[576,7665,115808]}],["以佚待劳","yǐyìdàiláo","多指作战时采取守势，养精蓄锐，让敌人来攻，然后乘其疲劳，战而胜之。",{"a":1,"w":[2262,10701,3350,7526]}],["以火止沸","yǐhuǒzhǐfèi","比喻处理方法不对，不但不能制止，反而助长已成的气势。同以汤止沸”。",{"a":1,"w":[2262,1284,223699]}],["以日为年","yǐrìwéinián","过一日如同过一年的时间那样漫长难熬。形容心情焦急。亦作以日为岁”。",{"a":1,"w":[2262,50,550,92]}],["以微知著","yǐwēizhīzhù","微微小；著显著。从事物露出的苗头，可以推知它的发展趋向或他的实质。",{"a":1,"w":[2262,149626,7908]}],["以噎废飡","yǐyēfèicān","由于吃饭打噎，便不敢再进食。比喻因偶然受到挫折，就停止应做的事情。",{"a":1,"w":[2262,10955,7711,79881]}],["以噎废餐","yǐyēfèicān","由于吃饭打噎，便不敢再进食。比喻因偶然受到挫折，就停止应做的事情。",{"a":1,"w":[2262,10955,7711,4763]}],["以一奉百","yǐyīfèngbǎi","奉供养。用一个人生产的物品供养一百个人。指生产的人少，消费的人多。",{"a":1,"w":[2262,5,7971,133]}],["以不济可","yǐfǒujìkě","指用否定错误意见的办法，帮助国君走上成功之路。不，同否”。济，成。",{"a":1,"w":[202234,7522,3310]}],["饴含抱孙","yíhánbàosūn","含着饴糖逗小孙子。形容老人自娱晚年，不问他事的乐趣。同含饴弄孙”。",{"a":1,"w":[16832,2351,2374,7936]}],["一噎止餐","yīyēzhǐcān","犹因噎废食。比喻要做的事情由于出了点小毛病或怕出问题就索性不去干。",{"a":1,"w":[5,10955,4656,4763]}],["一匡九合","yīkuāngjiǔhé","春秋时管仲辅助齐桓公一匡天下，九合诸侯”，建立霸业◇亦指立国大事。",{"a":1,"w":[143426,48532]}],["摇尾求食","yáowěiqiúshí","老虎被关进笼圈里，向人摇尾巴求取食物。比喻人的地位降低，向人乞求。",{"a":1,"w":[38511,113525]}],["瑶池女使","yáochínǚshǐ","传说西王母住在瑶池，以青鸟为使者，向汉武帝传递消息◇指传信的使者。",{"a":1,"w":[84906,98,1332]}],["曳尾泥涂","yèwěinítú","①比喻在污浊的环境里苟且偷生。同曳尾涂中”。②比喻卑鄙龌龊的行为。",{"a":1,"w":[8838,7474,76362]}],["妍蚩好恶","yánchīhǎo'è","妍美丽。蚩通媸”，丑陋，丑恶。美丽、丑陋、好与坏。原指写作的得失。",{"a":1,"w":[237281,101084]}],["选色征歌","xuǎn sè zhēnggē","挑选美女，征召歌伎。指放荡的生活方式。亦作选歌试舞”、选舞征歌”。",{"a":1,"w":[588,2266,243727]}],["炫玉贾石","xuànyùgǔshí","炫夸耀；贾卖。拿玉吸引人，卖出的却是石头。比喻说的和做的不相符合。",{"a":1,"w":[10387,2294,8056,7419]}],["形影相依","xíngyǐngxiāngyī","①指在孤寂的处境中相依相伴。②形容孤单无依。③互相依靠，紧密相连。",{"a":1,"w":[39810,19931]}],["心如槁木","xīn rú gǎomù","犹心若死灰。形容不为外物所动的一种精神状态。现多用以形容灰心失意。",{"a":1,"w":[1279,4614,62715]}],["心痒难挠","xīnyǎngnánnáo","指心中有某种意念或情绪起伏不定，无法克制。形容高兴得不知如何才好。",{"a":1,"w":[56450,117,8681]}],["献曝之忱","xiànpùzhīchén","献贡献之意；曝晒太阳。比喻以物品或意见献之于人，所表达的自谦之意。",{"a":1,"w":[286936,2254,13463]}],["武艺超群","wǔyì chāoqún","武艺武术上的本领。也指军事、战斗的本领。形容武艺高强，超出一般人。",{"a":1,"w":[28500,29637]}],["物以群分","wùyǐqúnfēn","同类的东西聚在一起。指坏人彼此臭味相投，勾结在一起。同物以类聚”。",{"a":1,"w":[7412,2262,1348,15]}],["握素披黄","wòsùpīhuáng","犹言握铅抱椠。素，白绢，古代用以书写。黄，雌黄，古代用以校点书籍。",{"a":1,"w":[3463,7468,3456,530]}],["丸泥封关","wánnífēngguān","丸泥一点泥，比喻少；封封锁。形容地势险要，只要少量兵力就可以把守。",{"a":1,"w":[100820,217212]}],["推己及物","tuī jǐ jíwù","用自己的心意去推想别人的心意。指设身处地替别人着想。同推己及人”。",{"a":1,"w":[586,7767,61098]}],["推涛作浪","tuītāozuòlàng","作兴起。推动波涛，掀起浪头。比喻助长坏人坏事，煽动情绪，制造事端。",{"a":1,"w":[586,11504,4608,7832]}],["天付良缘","tiān fù liángyuán","付给予。上天给予的美好姻缘或缘份。也指难得的好机会。同天假良缘”。",{"a":1,"w":[19,1402,67116]}],["天经地纬","tiānjīngdìwěi","①指天地间理所当然、无可非议的道理。②引申为以天地为法度治理天下。",{"a":1,"w":[19,7421,640454]}],["俗谚口碑","súyàn kǒubēi","俗通俗。谚谚语。口碑指流传的口头俗语。广泛流传的通俗的谚语和俗语。",{"a":1,"w":[176394,25179]}],["耸肩缩背","sǒngjiānsuōbèi","两肩耸起，背脊弯曲。形容衰老的状态。也形容因怕冷而缩做一团的样子。",{"a":1,"w":[38444,7640,565]}],["水陆毕陈","shuǐlù bì chén","水陆指水陆所产的珍贵食物。各种山珍海味全都陈列出来。形容菜肴丰富。",{"a":1,"w":[10370,8120,7893]}],["兽穷则啮","shòuqióngzéniè","指野兽陷于绝境必然进行搏噬反扑。亦喻人陷入困窘之境，便会竭力反击。",{"a":1,"w":[8325,2372,3323,10765]}],["授柄于人","shòubǐngyúrén","犹言授人以柄。比喻将权力交给别人或让人抓住缺点、失误，使自己被动。",{"a":1,"w":[8099,7964,4621,3]}],["视险若夷","shìxiǎnruòyí","走在危险的地方就象走在平地一样。比喻平安地渡过困境。同视险如夷”。",{"a":1,"w":[7494,4634,4652,7910]}],["上勤下顺","shàngqínxiàshùn","勤勤奋。顺顺从，服从。作领导的勤奋工作，下面的人就会顺从他的领导。",{"a":1,"w":[9,7857,17,4660]}],["三复斯言","sānfù sī yán","三复多次反复；斯言这句话。反复朗读并体会这句话。形容对它极为重视。",{"a":1,"w":[86648,7406,7440]}],["熔于一炉","róng yú yīlú","熔化在同一个炉内。比喻多种事物相互间结合紧密，浑然一体，难分难解。",{"a":1,"w":[8790,4621,23227]}],["日削月杒","rìxuēyuèrèn","杒缩小，减少。日日削减，月月缩小。形容逐渐缩小。也指时时受到搜刮。",{"a":1,"w":[50,4765,101,78988]}],["人穷智短","rénqióngzhìduǎn","穷困厄；短短小。指人一到无路可走的时候，思想迟钝，办法也就不多了。",{"a":1,"w":[3,2372,729240]}],["情深友于","qíng shēn yǒuyú","友于本指兄弟相爱，后亦为兄弟的”代称。比喻情谊比兄弟之间还要深厚。",{"a":1,"w":[7490,1343,100502]}],["秋荼密网","qiūtú mì wǎng","荼茅草上的白花。秋天繁茂的茅草白花，网眼细密的鱼网。比喻刑罚繁苛。",{"a":1,"w":[187440,2299,559]}],["巧伪趋利","qiǎowěiqūlì","巧奸诈。伪虚伪。趋追求，靠近、趋向。奸诈虚伪，唯利是图，唯势是从。",{"a":1,"w":[166721,89181]}],["骑鹤维扬","qí hè wéiyáng","比喻欲集做官、发财、成仙于一身，或形容贪婪、妄想。同骑鹤上扬州”。",{"a":1,"w":[674,8240,63148]}],["骑鹤扬州","qí hè yángzhōu","比喻欲集做官、发财、成仙于一身，或形容贪婪、妄想。同骑鹤上扬州”。",{"a":1,"w":[674,8240,18021]}],["骑扬州鹤","qí yángzhōu hè","比喻欲集做官、发财、成仙于一身，或形容贪婪、妄想。同骑鹤上扬州”。",{"a":1,"w":[674,18021,8240]}],["平地起雷","píngdìqǐléi","犹言平地一声雷。比喻突然发生的重大变动。也比喻名声或地位突然升高。",{"a":1,"w":[11262,232128]}],["破觚斫雕","pò gū zhuódiāo","斫，大锄；引申为用刀、斧等砍。比喻删繁杂而从简易，去浮华而尚质朴。",{"a":1,"w":[1325,13403,138220]}],["批吭捣虚","pīhángdǎoxū","比喻抓住敌人的要害乘虚而入。亦指有缝便钻，从中取利。同批亢捣虚”。",{"a":1,"w":[2363,12379,84703]}],["女中尧舜","nǚzhōngyáoshùn","尧舜传说中的上古贤明君主。妇女中的贤明人物。古代多称颂执政的女王。",{"a":1,"w":[37581,31416]}],["鸟入樊笼","niǎorùfánlóng","樊笼鸟笼，比喻不自由的境地。飞鸟进了笼子。比喻自投罗网，陷入困境。",{"a":1,"w":[581,4615,240368]}],["南蛮鴃舌","nánmánjuéshé","鴃即伯劳。原为孟子讥讽楚人许行说话如鸟语◇用以讥笑操南方方言的人。",{"a":1,"w":[64972,198680]}],["默化潜移","mòhuàqiányí","指人的思想或性格不知不觉受到感染、影响而发生了变化。同潜移默化”。",{"a":1,"w":[53839,39386]}],["买犊卖刀","mǎidúmàidāo","犹言卖剑买牛。原指放下武器，从事耕种◇比喻改业务农或坏人改恶从善。",{"a":1,"w":[194,10334,634,1369]}],["买牛息戈","mǎiniúxīgē","犹言卖剑买牛。原指放下武器，从事耕种◇比喻改业务农或坏人改恶从善。",{"a":1,"w":[194,1346,7510,7639]}],["乱首垢面","luànshǒu gòumiàn","犹蓬头垢面。旧时形容贫苦人生活生活条件很坏的样子。也泛指没有修饰。",{"a":1,"w":[130623,38975]}],["漏泄春光","lòuxièchūnguāng","原指柳叶首先透露春天到来的信息，后比喻男女私情泄露，或秘密被察觉。",{"a":1,"w":[25421,19653]}],["六趣轮回","liùqùlúnhuí","佛教语。指众生轮回的六大去处，即在这六道中轮回生死。同六道轮回”。",{"a":1,"w":[151746,22574]}],["龙蹲虎踞","lóng dūn hǔjù","犹言龙盘虎踞∶像盘绕的龙，蹲伏的虎。特指南京。亦形容地势雄伟险要。",{"a":1,"w":[1308,3595,31258]}],["蠡酌管窥","lízhuó guǎnkuī","用瓢量海水，从竹管里看天。比喻见识浅薄，对事物的观察和了解很片面。",{"a":1,"w":[752646,26437]}],["口是心苗","kǒu shì xīnmiáo","犹言为心声。言语是思想的反映，从一个人的话里可以知道他的思想感情。",{"a":1,"w":[47,48,218200]}],["绝世超伦","juéshì chāolún","绝世当世所没有，指冠绝当世；超伦超过同辈的人。冠绝当世，超过同辈。",{"a":1,"w":[42777,75268]}],["绝薪止火","jué xīn zhǐhuǒ","绝断绝；薪柴草。断绝柴草，使火停止燃烧。比喻从根本上彻底解决问题。",{"a":1,"w":[4627,8398,72476]}],["臼杵之交","jiùchǔ zhī jiāo","臼石制的舂米器具。杵舂米的木棒。臼与杵不相离。比喻非常要好的朋友。",{"a":1,"w":[197299,2254,535]}],["救焚益薪","jiùfényìxīn","焚火灾；薪柴草。添加木柴去救火。比喻采取错误的方法使问题更加严重。",{"a":1,"w":[1409,9179,7724,8398]}],["井蛙醯鸡","jǐngwā xījī","醯鸡昆虫名，即蠛蠓，常用以形容细小的东西。比喻眼界不广，见识浅薄。",{"a":1,"w":[356722,45070]}],["敬贤礼士","jìngxiánlǐshì","礼以礼相待，尊重；士古时称有学问的人。尊重品德高尚、学识出众的人。",{"a":1,"w":[8118,8050,3342,7542]}],["进退失踞","jìntuì shī jù","前进和后退都失去了依据。形容无处容身。也指进退两难。同进退无据”。",{"a":1,"w":[12556,7527,12088]}],["进退亡据","jìntuìwángjù","前进和后退都失去了依据。形容无处容身。也指进退两难。同进退无据”。",{"a":1,"w":[12556,7763,4642]}],["襟江带湖","jīnjiāngdàihú","襟衣襟；带衣带。形容江河湖泊之间相互萦绕交错，如同衣襟和衣带一样。",{"a":1,"w":[8612,2327,542,645]}],["俭存奢失","jiǎncúnshēshī","俭节俭。存留存。奢奢侈。节俭的人就是能留存下来，奢侈的人必然败亡。",{"a":1,"w":[9141,1349,9225,7527]}],["蠖屈求伸","huòqū qiú shēn","蠖昆虫名，行时屈伸其体。比喻人不遇时，则屈身求隐，待来日再展宏图。",{"a":1,"w":[155950,598,3412]}],["毁誉不一","huǐyùbùyī","毁誉诋毁和称赞；不一不一样，不一致。有人说好，有人说坏，说法不一。",{"a":1,"w":[61308,11520]}],["浑金白玉","hún jīn báiyù","比喻天然美质，未加修饰。多用来形容人的品质淳朴善良。同浑金璞玉”。",{"a":1,"w":[8369,1270,14519]}],["涣发大号","huànfādàhào","犹言涣汗大号。指帝王号令，如人之汗，一出不复收。也指帝王发布号令。",{"a":1,"w":[13803,522,16230]}],["画地成图","huàdìchéngtú","在地上画出地图，来说明山川河岳等地理形势。形容信手拈来，才能出众。",{"a":1,"w":[35611,432925]}],["胡越之祸","húyuè zhī huò","古代中原的胡国和越国之间经常发生战事，因此用胡越之祸”来比喻战祸。",{"a":1,"w":[85215,2254,8225]}],["狐媚猿攀","húmèi yuán pān","像狐狸那样善于迷惑人，像猿猴那样善于攀高。比喻不择手段地追求名利。",{"a":1,"w":[116866,9346,8491]}],["鹤鸣九皋","hèmíngjiǔgāo","九皋深泽∽鸣于湖泽的深处，它的声音很远都能听见。比喻贤士身隐名著。",{"a":1,"w":[76582,160542]}],["何所不至","hésuǒbùzhì","①用反问的语气表示无所不至。指没有达不到的地方。②指什么坏事都干。",{"a":1,"w":[41066,50734]}],["寡鹄孤鸾","guǎhú gūluán","孤鸾无偶的友鸾，比喻死去了配偶的男子；寡鹄比喻寡妇。指失偶的男女。",{"a":1,"w":[145173,150499]}],["顾盼生姿","gùpàn shēng zī","姿姿色，姿态。回首抬眼之间就有美妙的姿色。形容眉目传神，姿态动人。",{"a":1,"w":[91311,508,8460]}],["孤鸾寡鹄","gūluán guǎhú","孤鸾无偶的友鸾，比喻死去了配偶的男子；寡鹄比喻寡妇。指失偶的男女。",{"a":1,"w":[150499,145173]}],["格杀弗论","géshāfúlùn","指把拒捕、行凶或违反禁令的人当场打死而不以杀人论罪。同格杀勿论”。",{"a":1,"w":[30898,7630,7480]}],["高节清风","gāojiéqīngfēng","高节高尚的气节；清风清廉的作风。气节高尚，作风清廉。比喻人品高洁。",{"a":1,"w":[37856,16006]}],["高世骇俗","gāoshì hài sú","高世超出世人；骇惊吓，震惊。具有令一般人吃惊的才能。比喻才智超群。",{"a":1,"w":[174426,9473,7904]}],["甘死如饴","gānsǐ rú yí","甘情愿；饴饴糖。甘愿去死，就像吃糖一般。形容不怕死，把死作为快事。",{"a":1,"w":[198467,4614,16832]}],["浮云蔽日","fúyún bìrì","浮云遮住太阳。原比喻奸佞之徒蒙蔽君主◇泛指小人当道，社会一片黑暗。",{"a":1,"w":[22415,108629]}],["凤泊鸾漂","fèngbóluánpiāo","飘、泊随流飘荡。原形容书法笔势潇洒飘逸，后比喻夫妻离散或文人失意。",{"a":1,"w":[7768,8463,9528,7976]}],["否极阳回","pǐjíyánghuí","犹言否极泰来。《泰》卦内阳而外阴，故称阳。指坏运到了头好运就来了。",{"a":1,"w":[8585,1303,7484,79]}],["风雨连床","fēngyǔliánchuáng","指兄弟或亲友久别后重逢，共处一室倾心交谈的欢乐之情。同风雨对床”。",{"a":1,"w":[10397,1288,183]}],["焚林而田","fénlín'értián","烧毁树林以猎取野兽。比喻取之不留余地，只顾眼前利益，不顾长远利益。",{"a":1,"w":[9179,7469,2267,4668]}],["分我杯羹","fēnwǒbēigēng","羹肉汁。楚、汉相争时，刘邦答项羽的话。比喻从别人那里分享一分利益。",{"a":1,"w":[15,139,199,9089]}],["杜绝言路","dùjué yánlù","杜绝断绝，阻塞；言路进言之路。堵塞和断绝一切进言之路，指不纳谏言。",{"a":1,"w":[5859,97408]}],["登高能赋","dēnggāo néng fù","赋写作。登得高，看得远，能够描绘形状，铺陈事势。指国家的有用人才。",{"a":1,"w":[28573,41,8218]}],["大江东去","dàjiāngdōngqù","长江的水往东奔流而去◇借用为词牌名。多表示陈迹消逝，历史向前发展。",{"a":1,"w":[47010,277114]}],["撮土焚香","cuōtǔfénxiāng","撮土用手把土聚拢成堆。指旧时迷信的人在野外撮土代替香炉，烧香敬神。",{"a":1,"w":[92663,57046]}],["触目如故","chùmù rúgù","触目目光所及。故旧的，过去的，本来的。满眼看到的都是过去的老样子。",{"a":1,"w":[34772,40054]}],["处实效功","chǔshíxiàogōng","处办理。效效验，效果。功功绩，成效。处理事情从实际出发，讲究功效。",{"a":1,"w":[2272,52200,7516]}],["愁红惨绿","chóuhóngcǎnlǜ","红、绿指花、叶。指经过风雨摧残的残花败叶。多寄以对身世凄凉的感情。",{"a":1,"w":[3481,534,245220]}],["愁红怨绿","chóuhóngyuànlǜ","红、绿指花、叶。指经过风雨摧残的残花败叶。多寄以对身世凄凉的感情。",{"a":1,"w":[3481,534,3431,605]}],["尺泽之鲵","chǐzézhīní","尺泽一尺见方的水面；鲵一种小鱼。小水洼中的小鱼。比喻见识短浅的人。",{"a":1,"w":[111264,2254,19138]}],["称家有无","chènjiāyǒuwú","称适合，相符。与家庭经济情况相符。指办理婚、丧等事不可过奢或过俭。",{"a":1,"w":[613,28,20780]}],["乘虚迭出","chéngxūdiéchū","虚空虚、弱点。迭屡次。指军事上向对方没有设防或兵力薄弱的地方进攻。",{"a":1,"w":[104950,64081]}],["沉疴宿疾","chénkēsùjí","疴病；宿长久的。指重病和老病。也比喻积久而成，为害甚大的社会弊端。",{"a":1,"w":[54165,282580]}],["惝恍迷离","chǎng huǎng mílí","惝恍也作惝况”，失意的样子。迷离凝不清。指茫然若失而凝不清的样子。",{"a":1,"w":[64803,18653]}],["草藄禽猘","cǎoqíqínzhì","藄除草；猘杀。如同割除野草，捕杀禽兽一般。比喻肆意屠戮，无所顾惜。",{"a":1,"w":[521,8747,49272]}],["插架万轴","chājiàwànzhóu","插架将藏书安放在书架上。轴古代书卷中的杆，借指书籍。形容藏书丰富。",{"a":1,"w":[155591,568,7648]}],["采葑采菲","cǎifēngcǎifēi","比喻不因其所短而舍其所长。葑即蔓青，叶和根、茎地可食，但根茎味苦。",{"a":1,"w":[7528,30965,7892]}],["惨绿愁红","cǎnlǜchóuhóng","红、绿指花、叶。指经过风雨摧残的残花败叶。多寄以对身世凄凉的感情。",{"a":1,"w":[245220,3481,534]}],["灿若繁星","cànruòfánxīng","灿灿烂。繁众多。亮晶晶的就像天上众多的星星。比喻才能出从的人很多。",{"a":1,"w":[13013,4652,38176]}],["不教之教","bùjiàozhījiào","不以直接的教育方式而进行的教育。指在日常言行中很自然地进行的薰陶。",{"a":1,"w":[0,77,2254]}],["鞭擗进里","biānpǐjìnlǐ","意指深入剖析，使靠近最里层。形容探求透彻，深入精微。同鞭辟近里”。",{"a":1,"w":[8162,17338,71,30]}],["鞭擗向里","biānpǐxiànglǐ","意指深入剖析，使靠近最里层。形容探求透彻，深入精微。同鞭辟近里”。",{"a":1,"w":[8162,17338,537,30]}],["辩才无阂","biàncái wú hé","佛教语。指菩萨为人说法，义理通达，言辞流利，后泛指口才好，能辩论。",{"a":1,"w":[48158,2255,18797]}],["白水鉴心","bái shuǐjiàn xīn","白水清水；鉴照。清澈的水能照见人的心。形容人心像明净的水一样纯洁。",{"a":1,"w":[20537,8039,1279]}],["拔新领异","báxīnlǐngyì","拔抽出；新新意；领具有；异指独特之处。指创立新意，提出独特的见解。",{"a":1,"w":[3360,80,1361,7464]}],["傲睨得志","àonìdézhì","傲睨傲慢地斜眼看。得志愿望实现。形容因实现愿望而看不起一切的神情。",{"a":1,"w":[195084,31593]}],["傲贤慢士","àoxiánmànshì","贤有才德的人；士读书人和有才干的人。用傲慢的态度对待有德有才的人。",{"a":1,"w":[9025,8050,182,7542]}],["阿平绝倒","āpíngjuédǎo","以之比喻对对方的言论极为佩服。亦用为讥讽言论极为乖谬，常贻笑大方。",{"a":1,"w":[502322,96419]}],["吃闭门羮","chī bìmén gēng","拒绝进门，不受欢迎比喻串门时，主人不在家，被拒绝进门或受其他冷遇。",{"a":1,"w":[108,12769,444045]}],["一甲一名","yī jiǎ yīmíng","1) 科举一甲中的第一名，即状元。\n2) 泛指第一等，含讽刺意味。",{"a":1,"w":[5,3330,15862]}],["七策五成","qī cè wǔchéng","传说春秋末越大夫范蠡向其师计然学谋略七，用其五佐越即获成功，故云。",{"a":1,"w":[134,7673,73072]}],["乜乜些些","miē miē xiēxiē","1) 装痴作呆。\n2) 犹言眉来眼去。\n3) 朦朦胧胧，昏昏沉沉。",{"a":1,"w":[32111,70107]}],["予末小子","yǔ mò xiǎozi","1) 古代帝王对先王或长辈的自称。\n2) 常人对先辈、长者的自称。",{"a":1,"w":[8145,2329,10127]}],["五夜元宵","wǔyè yuánxiāo","自宋初以来，将庆赏元宵花灯的时间由三夜改为五夜，称为“五夜元宵”。",{"a":1,"w":[214065,17422]}],["五祖七真","wǔzǔ qī zhēn","道教语。指全真道的北五祖、南五祖和七真人。见元李道谦《七真年谱》。",{"a":1,"w":[78361,134,85]}],["五行大布","wǔxíng dàbù","北周武帝建德三年铸造的钱币。铜质，圆形方孔，篆书“五行大布”四字。",{"a":1,"w":[10893,57108]}],["刘宠一钱","liúchǒngyīqián","东汉会稽太守刘宠将内迁为大臣，山阴县有五、六老人各赠百钱为他送行。",{"a":1,"w":[8276,8782,84186]}],["匹马丘牛","pǐmǎqiūniú","春秋时鲁国交纳田赋，规定每丘出戎马一匹，牛三头，谓之“匹马丘牛”。",{"a":1,"w":[50586,7868,1346]}],["十九信条","shíjiǔ xìntiáo","指1911年(宣统三年)11月清政府颁布的《宪法重大信条十九条》。",{"a":1,"w":[11680,50267]}],["山堂香水","shān táng xiāngshuǐ","“山、堂、香、水”分别是旧时民间秘密社团的组织名称，泛指帮会组织。",{"a":1,"w":[45,7695,14670]}],["山头廷尉","shāntóu tíngwèi","东晋将军苏峻不听朝廷征召，疑庾亮欲害己，勒兵自守。朝廷遣使讽谕之。",{"a":1,"w":[27204,29842]}],["文昌缠斗","wénchāng chándòu","谓运命上应文昌星。因文昌六星在北斗魁前，如筐形，似缠绕北斗，故云。",{"a":1,"w":[17101,158437]}],["东方圣人","dōngfāng shèngrén","古代对中国德才最高人物的誉称。在不同时代不同情况下，所指对象各异。",{"a":1,"w":[732,12294]}],["弃农经商","qì nóngjīng shāng","放弃农业，经营商业。如：我国古代以农为本，反对弃农经商，舍本逐末。",{"a":1,"w":[7931,54133,7485]}],["江东三罗","jiāngdōng sān luó","指晚唐罗隐、罗邺、罗虬。三人皆浙江人，同应举，又以诗名相近，故称。",{"a":1,"w":[31007,74,7420]}],["池鹅夜击","chí'éyèjī","唐代安史之乱后，吴元济继李希烈、吴少诚、吴少阳等人之后，割据淮西。",{"a":1,"w":[7815,8359,631,7506]}],["无香火情","wú xiānghuǒqíng","谓背弃盟誓之情。古时为表示信守诺言，常于神前燃点香火以盟誓，故称。",{"a":1,"w":[2255,402884]}],["犊车麈尾","dúju zhǔwěi","《晋书‧王导传》：“初，曹氏性妒，导甚惮之，乃密营别馆，以处众妾。",{"a":1,"w":[318251,494970]}],["玉圭金臬","yùguī jīn niè","比喻重要的准则或法度。圭，观测日影的仪器；臬，靶子。金玉言其贵重。",{"a":1,"w":[242116,1270,16201]}],["玉女披衣","yùnǚ pīyī","自然景观名。在今江西萍乡市芦溪镇郊外。指雨前山石间涌现的云雾奇景。",{"a":1,"w":[27587,94604]}],["皂王老爷","zào wánglǎo yé","灶神的俗称。河北梆子《喜荣归》：“[崔平]：待我谢谢皂王老爷吧。”",{"a":1,"w":[8161,32880,8575]}],["相对新亭","xiāngduì xīn tíng","西晋末，中原战乱，王室渡江流亡东南。过江人士，每暇日常至新亭饮宴。",{"a":1,"w":[3531,80,8241]}],["祝鮀之佞","zhùtuózhīnìng","《论语‧雍也》：“不有祝鮀之佞，而有宋朝之美，难乎免于今之世矣。”",{"a":1,"w":[1473,84929,2254,10272]}],["细雨和风","xìyǔ héfēng","1) 细润的雨，和煦的风。\n2) 用以比喻和婉不粗暴的方式或态度。",{"a":1,"w":[36701,25992]}],["群口铄金","qún kǒu shuòjīn","同“众口铄金”。\n形容舆论影响的强大或比喻人多口杂，足以混淆是非。",{"a":1,"w":[343142,64489]}],["羿氏舛射","yìshìchuǎnshè","《太平御览》卷八二引晋皇甫谧《帝王世纪》：“帝羿有穷氏从吴贺北游。",{"a":1,"w":[38928,7429,12109,3312]}],["脂油点灯","zhīyóu diǎndēng","步行的隐语。古人点油灯用布条作捻子。布捻是步辇的谐声，步辇即步行。",{"a":1,"w":[38208,30959]}],["蒲草毛窝","púcǎo máowō","一种蒲草编成的深帮圆头鞋子，里面杂有鸡毛、芦花等物，宜于雪地行走。",{"a":1,"w":[62322,229686]}],["蛇头蝎尾","shétóu xiēwěi","指蛇蝎之毒。蛇之毒在牙咬，蝎螫毒在尾刺，故称。亦泛指毒害人的东西。",{"a":1,"w":[20985,16312]}]]