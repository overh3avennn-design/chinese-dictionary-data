[["醉舆","zuìyú","唐代宫中取锦彩结成用以供醉人代步的一种兜子。",{"a":1,"w":[3387,8330]}],["醒水","xǐngshuǐ","1) 指秧苗插下后复苏存活。\n2) 犹警觉。",{"a":1,"w":[2424,11]}],["醴水","lǐshuǐ","1) 水名。醴，通“澧”。\n2) 甘美的水。",{"a":1,"w":[12653,11]}],["重戴","zhòngdài","1) 折上巾又加以帽。\n2) 既有伞又戴帽。",{"a":1,"w":[49,2394]}],["重举","zhòngjǔ","I\n谓举动慎重。\nII\n重新提出；再次列举。",{"a":1,"w":[49,606]}],["野场","yěchǎng","1) 指田野和谷场，借指农事。\n2) 旷野。",{"a":1,"w":[4626,544]}],["野程","yěchéng","1) 山野的道路。\n2) 谓行旅经过的途程。",{"a":1,"w":[4626,7453]}],["野酌","yězhuó","1) 指村野人自制的酒。\n2) 饮酒于郊野。",{"a":1,"w":[4626,9372]}],["金幡","jīnfān","1) 缕金的旌旗。\n2) 用银箔制作的幡胜。",{"a":1,"w":[1270,10797]}],["金汋","jīnzhuó","道教炼丹术中内丹名。传说用以炼金，服之长生。",{"a":1,"w":[1270,30767]}],["金钿","jīndiàn","I\n指嵌有金花的妇人首饰。\nII\n用金镶嵌。",{"a":1,"w":[1270,14893]}],["针喇","zhēnlǎ","亦作“针喇”。\n胡说，乱说。一说，刺人的话。",{"a":1,"w":[2324,8558]}],["钧石","jūnshí","钧和石。古代重量单位。三十斤为钧，四钧为石。",{"a":1,"w":[9707,7419]}],["铃索","língsuǒ","1) 系铃的绳索。\n2) 引申指警报、边警。",{"a":1,"w":[3441,7470]}],["钿秋","diànqiū","镶嵌金、银、玉、贝等物，勒于牛马股后的革带。",{"a":1,"w":[14893,1391]}],["钜桥","jùqiáo","商纣王时之粮仓名。仓址在今河北省曲周县东北。",{"a":1,"w":[11171,1435]}],["鉏犁","chúlí","1) 锄和犁。借指耕作。\n2) 铲除，整治。",{"a":1,"w":[13454,8411]}],["铅田","qiāntián","指含铅地层比较连续而且分布范围较广的铅产地。",{"a":1,"w":[8158,4668]}],["钩窗","gōuchuāng","古代的一种内有托柱、外有钩阑的方格眼隔扇窗。",{"a":1,"w":[7696,8301]}],["铜齐","tóngqí","指铜在合金中的剂量、比例。齐，后通作“剂”。",{"a":1,"w":[4724,1347]}],["铣珧","xǐyáo","弓之两端饰金者名铣，饰蚌者名珧。因泛指宝弓。",{"a":1,"w":[9531,25340]}],["铢秤","zhūchèng","宋代以铢为最小计量单位的秤。二十四铢为一两。",{"a":1,"w":[12406,5052]}],["销偃","xiāoyǎn","1) 消歇停止。\n2) 销毁武器，停止战争。",{"a":1,"w":[7663,9432]}],["铓锷","máng'è","1) 刀剑等的尖端。\n2) 比喻突出的才华。",{"a":1,"w":[32322,33803]}],["锡锡","xīxī","象声词。形容金属碰撞或拨弦乐器演奏时的声响。",{"a":1,"w":[8582]}],["锻锡","duànxī","1) 古时锻炼金属时掺锡。\n2) 指冶炼锡。",{"a":1,"w":[9192,8582]}],["钟张","zhōngzhāng","三国魏锺繇、东汉张芝的并称。二人皆以善书名。",{"a":1,"w":[1410,1333]}],["镐饮","gǎoyǐn","《诗‧小雅‧鱼藻》：“王在在镐，岂乐饮酒。”",{"a":1,"w":[11514,7871]}],["镂管","lòuguǎn","1) 雕花的笔管。\n2) 乐器。刻花的竹管。",{"a":1,"w":[9850,1278]}],["铁利","tiělì","部族名。原为唐黑水靺鞨诸部之一。后服属渤海。",{"a":1,"w":[1298,4606]}],["锧笮","zhìzé","斧和凿。古代腰斩和黥刑的刑具。笮，通“凿”。",{"a":1,"w":[37642,28088]}],["门僧","ménsēng","指约定为大户人家做礼忏，平时并有往来的僧道。",{"a":1,"w":[53,8830]}],["门宇","ményǔ","大门口的建筑整体(包括门屋、门楼、门墙等)。",{"a":1,"w":[53,7949]}],["门瓣","ménbàn","犹门环。门铺所衔的舌瓣，用它敲击门铺以叫门。",{"a":1,"w":[53,8169]}],["闲子","xiánzi","亦作“闲子”。\n指唐末城市中游荡劫掠的歹徒。",{"a":1,"w":[3381,1]}],["闲拔","xiánbá","亦作“间拔”。\n谓按一定的间隔拔去多余的苗。",{"a":1,"w":[3381,3360]}],["闲离","xiánlí","亦作“间离”。\n1) 犹离间。\n2) 脱离。",{"a":1,"w":[3381,543]}],["闵参","mǐncān","孔子弟子闵子骞、曾参的并称。两人以孝行着称。",{"a":1,"w":[10057,7543]}],["关席","guānxí","坐主位。设酒宴待客，主人最后落座，故称关席。",{"a":1,"w":[65,7836]}],["防杜","fángdù","1) 防范杜绝(祸患等)。\n2) 遮掩灭绝。",{"a":1,"w":[1302,7680]}],["降路","jiànglù","I\n投降的道路。\nII\n降辂。路，通“辂”。",{"a":1,"w":[2305,54]}],["限钱","xiànqián","金时货币制度。指官方限定私人贮藏的现钱数量。",{"a":1,"w":[7616,138]}],["陟明","zhìmíng","谓进用贤能。语本《书‧舜典》：“黜陟幽明。”",{"a":1,"w":[12183,7431]}],["陡恁","dǒunèn","1) 忽然如此。\n2) 竟然这样；简直这样。",{"a":1,"w":[10121,12413]}],["除巳","chúsì","指农历三月上巳节。旧俗于此日祓除不洁，故称。",{"a":1,"w":[4635,11064]}],["除馑","chújǐn","佛教语。指出家人。僧尼断贪欲，除六情，故称。",{"a":1,"w":[4635,58374]}],["阴戎","yīnróng","1) 古代少数民族名。\n2) 泛指少数民族。",{"a":1,"w":[576,8500]}],["陶阮","táoruǎn","晋陶渊明和三国魏阮籍的并称。两人皆为大诗人。",{"a":1,"w":[7848,11124]}],["陷将","xiànjiāng","I\n将领被俘或阵亡。\nII\n将领被俘或阵亡。",{"a":1,"w":[7914,3328]}],["隋宫","suígōng","指隋炀帝下扬州时兴建的离宫行苑。又称江都宫。",{"a":1,"w":[13252,4679]}],["隔品","gépǐn","I\n指官位相差一品。\nII\n指官位相差一品。",{"a":1,"w":[2332,3321]}],["隔搔","gésāo","I\n见“隔靴搔痒”。\nII\n见“隔靴搔痒”。",{"a":1,"w":[2332,9846]}],["陨队","yǔnduì","1) 陨落。死亡的婉称。\n2) 毁坏；败坏。",{"a":1,"w":[8185,570]}],["随园","suíyuán","1) 清袁枚的别墅名。\n2) 清袁枚的别号。",{"a":1,"w":[1375,4715]}],["险竿","xiǎngān","杂技名。爬上高竿，并在高竿上做各种杂技表演。",{"a":1,"w":[4634,9280]}],["隐暧","yǐn'ài","1) 指草木浓盛茂密貌。\n2) 指文义隐晦。",{"a":1,"w":[7652,12401]}],["隶省","lìshěng","汉字隶变的一种。篆字简省后的隶定称“隶省”。",{"a":1,"w":[8847,607]}],["雁户","yànhù","1) 指流动无定的民户。\n2) 猎凫雁之户。",{"a":1,"w":[9300,2320]}],["雅篆","yǎzhuàn","问别人字号时的敬称。私人印章多用篆字，故称。",{"a":1,"w":[7788,9979]}],["雅旧","yǎjiù","1) 故旧。\n2) 旧谊。\n3) 指有旧谊。",{"a":1,"w":[7788,1396]}],["雌甲","cíjiǎ","年逾花甲之同庚者二人，其幼者之甲子为雌甲子。",{"a":1,"w":[10657,3330]}],["雍泮","yōngpàn","辟雍与泮宫。泛指古代天子或诸侯所设立的大学。",{"a":1,"w":[9147,12829]}],["杂拟","zánǐ","古诗诗体之一种。指各种模拟前人作品所写的诗。",{"a":1,"w":[4680,7659]}],["杂歌","zágē","1) 指古诗中的歌或行。\n2) 苗族指山歌。",{"a":1,"w":[4680,208]}],["离坼","líchè","1) 谓土地因缺乏水分而龟裂。\n2) 拆散。",{"a":1,"w":[543,15127]}],["离亲","líqīn","1) 谓与亲属相分离。\n2) 离间亲属关系。",{"a":1,"w":[543,1338]}],["离黍","líshǔ","《诗‧王风‧黍离序》：“《黍离》，闵宗周也。",{"a":1,"w":[543,8827]}],["雪窝","xuěwō","1) 积雪的洞穴。\n2) 积雪的洼地、谷地。",{"a":1,"w":[616,4714]}],["云樯","yúnqiáng","1) 帆樯。其高入云，故称。\n2) 借指船。",{"a":1,"w":[554,68828]}],["云涧","yúnjiàn","1) 云气弥漫的山间。\n2) 指隐者的居处。",{"a":1,"w":[554,17942]}],["云积","yúnjī","1) 云朵堆积。\n2) 如云堆积。比喻盛多。",{"a":1,"w":[554,7496]}],["雷杼","léizhù","传说中雷神用以发霹雳的工具。其形如梭，故名。",{"a":1,"w":[3319,13082]}],["雷气","léiqì","1) 形容威武雄壮的气概。\n2) 雷火之气。",{"a":1,"w":[3319,510]}],["电烻","diànyàn","I\n如闪电之光。谓色红而光亮。\nII\n闪电。",{"a":1,"w":[12]}],["电谢","diànxiè","1) 比喻迅速消逝。\n2) 打电报表示谢意。",{"a":1,"w":[12,7570]}],["电露","diànlù","1) 闪电和露水。借指天地。\n2) 喻短暂。",{"a":1,"w":[12,4674]}],["霆雷","tíngléi","1) 迅雷。比喻巨大的声威。\n2) 喻盛怒。",{"a":1,"w":[13634,3319]}],["震夙","zhènsù","《诗‧大雅‧生民》：“载震载夙，载生载育。”",{"a":1,"w":[7751,9924]}],["震维","zhènwéi","震，指东方。维，地维，指地。震维，东方之地。",{"a":1,"w":[7751,7432]}],["霓襟","níjīn","1) 指道士的衣服。\n2) 比喻鲜艳的车帷。",{"a":1,"w":[10817,8612]}],["霜庭","shuāngtíng","1) 日月光照下的庭院。\n2) 秋天的庭院。",{"a":1,"w":[8258,7760]}],["霜简","shuāngjiǎn","1) 古代御史弹劾大臣的奏章。\n2) 竹笏。",{"a":1,"w":[8258,7804]}],["霜缟","shuānggǎo","1) 白绢。\n2) 洁白貌。\n3) 指月光。",{"a":1,"w":[8258,12506]}],["霜艳","shuāngyàn","亦作“霜艳”。\n1) 霜浓。\n2) 明洁貌。",{"a":1,"w":[8258,8710]}],["霞采","xiácǎi","亦作“霞彩”。\n1) 彩霞。\n2) 喻彩旗。",{"a":1,"w":[4805,7528]}],["雾帐","wùzhàng","1) 如帐幔的云雾。\n2) 轻柔如雾的帐帷。",{"a":1,"w":[3421,8011]}],["霸蛮","bàmán","1) 方言。勉强。\n2) 方言。坚决；执拗。",{"a":1,"w":[8096,8711]}],["灵枣","língzǎo","1) 犹仙枣。\n2) 枣的一种。形大而甜美。",{"a":1,"w":[7588,8507]}],["灵蔡","língcài","卜卦用的大龟。蔡，本大龟所出地名，后指大龟。",{"a":1,"w":[7588,9087]}],["青兕","qīngsì","青兕牛。古代犀牛类兽名。一角，青色，重千斤。",{"a":1,"w":[3320,20710]}],["青扈","qīnghù","即桑扈。俗名青雀。背青黑色，腹下蓝色，故称。",{"a":1,"w":[3320,9990]}],["青煤","qīngméi","松烟。指松柴燃烧时生成的黑烟。为制墨的原料。",{"a":1,"w":[3320,3422]}],["青烛","qīngzhú","即南天烛。植物名。道家炮制青精饭的原料之一。",{"a":1,"w":[3320,8450]}],["青甲","qīngjiǎ","草木初生时的外皮。亦指新绽开的草木的叶、芽。",{"a":1,"w":[3320,3330]}],["青躔","qīngchán","古代指春季日月星辰运行的度次。借指司春之神。",{"a":1,"w":[3320,20339]}],["青霾","qīngmái","犹阴霾。大气混浊呈浅蓝色或微黄色的天气现象。",{"a":1,"w":[3320,21654]}],["静士","jìngshì","1) 隐居之士。\n2) 沉静稳重的青年男子。",{"a":1,"w":[1386,7542]}],["非地","fēidì","1) 犹言是非之地。\n2) 不适宜去的地方。",{"a":1,"w":[2265,10]}],["靡旌","míjīng","旌旗披靡。本谓战车疾驱之状。借指疾驱之战车。",{"a":1,"w":[8373,9840]}],["靡碎","mísuì","1) 糜烂粉碎。\n2) 分崩离析，瓦解崩溃。",{"a":1,"w":[8373,3359]}],["靡响","míxiǎng","本义为靡靡之音，借指辞藻华丽而无风骨的诗赋。",{"a":1,"w":[8373,639]}],["鞠尘","jūchén","酒麴所生的霉菌。色淡黄，如尘。鞠，通“麴”。",{"a":1,"w":[10161,7843]}],["韦曲","wéiqū","1) 地名。\n2) 借指风景秀丽的游览胜地。",{"a":1,"w":[7839,7517]}],["韩白","hánbái","古代名将汉韩信和秦白起的并称。以善用兵着称。",{"a":1,"w":[8332,24]}],["韬发","tāofā","古礼，未成年者用帻巾包扎头发，谓之“韬发”。",{"a":1,"w":[11243,522]}],["鞴鹰","bèiyīng","蹲在臂套上的苍鹰。比喻摆脱羁绊欲展鸿图的人。",{"a":1,"w":[35204,8542]}],["顶笔","dǐngbǐ","古代朝见，插笔于冠，以备记事，谓之“顶笔”。",{"a":1,"w":[2298,619]}],["顶费","dǐngfèi","转让或取得企业经营权或房屋租赁权所付出的钱。",{"a":1,"w":[2298,1316]}],["顶颡","dǐngsǎng","谓食物抵撞到喉头。形容饱食到极点而吞咽不下。",{"a":1,"w":[2298,16684]}],["项里","xiànglǐ","在今浙江绍兴西南二十里，世传为项羽流寓之处。",{"a":1,"w":[2342,30]}],["顺节","shùnjié","1) 顺应节奏。\n2) 顺从节令；依照时令。",{"a":1,"w":[4660,540]}],["颀甫","qífǔ","即圻父。古官名。掌封圻内兵甲。颀，通“圻”。",{"a":1,"w":[20382,8778]}],["顿老","dùnlǎo","明代金陵琵琶手。名噪一时，人称“琵琶顿老”。",{"a":1,"w":[1370,55]}],["愿嚏","yuàntì","《诗‧邶风‧终风》：“寤言不寐，愿言则嚏。”",{"a":1,"w":[3393,14521]}],["颡泚","sǎngcǐ","《孟子‧滕文公上》：“其颡有泚，睨而不视。”",{"a":1,"w":[16684,30701]}],["颠陷","diānxiàn","1) 下陷。\n2) 覆灭。\n3) 指使覆灭。",{"a":1,"w":[8660,7914]}],["类锡","lèixī","《诗‧大雅‧既醉》：“孝子不匮，永锡尔类。”",{"a":1,"w":[1323,8582]}],["显允","xiǎnyǔn","1) 英明信诚。\n2) 显扬。允，语气助词。",{"a":1,"w":[3347,8599]}],["显昭","xiǎnzhāo","1) 使显扬昭着。\n2) 指有显着德才的人。",{"a":1,"w":[3347,8522]}],["显义","xiǎnyì","1) 发扬正义。\n2) 谓显着而重要的事义。",{"a":1,"w":[3347,7437]}],["风壤","fēngrǎng","犹风土。指一个地方特有的自然环境和风俗习惯。",{"a":1,"w":[44,8583]}],["风矩","fēngjǔ","1) 风度，气派。\n2) 文章的风采和法式。",{"a":1,"w":[44,8181]}],["风菜","fēngcài","1) 药草名。\n2) 一种供制腌菜用的蔬菜。",{"a":1,"w":[44,111]}],["飙飙","biāobiāo","1) 风吹貌。\n2) 显赫貌。形容声势盛大。",{"a":1,"w":[11470]}],["飞盏","fēizhǎn","1) 谓传杯痛饮。\n2) 谓传杯斟酒行酒令。",{"a":1,"w":[56,10030]}],["飞翮","fēihé","1) 飞鸟。\n2) 古冠名。\n3) 名马名。",{"a":1,"w":[56,26963]}],["饷午","xiǎngwǔ","1) 吃午饭。\n2) 中午。饷，用同“晌”。",{"a":1,"w":[9898,8095]}],["养爷","yǎngyé","旧时照料或抚养孩子的奴仆，孩子尊称其为养爷。",{"a":1,"w":[582,8575]}],["余态","yútài","1) 无穷的美好姿态。\n2) 指残留的姿色。",{"a":1,"w":[7597,7619]}],["余智","yúzhì","1) 充足的智慧。\n2) 指小谋略、小手段。",{"a":1,"w":[7597,7798]}],["余泽","yúzé","1) 指大水泽。\n2) 指遗留给后人的德泽。",{"a":1,"w":[7597,7607]}],["饯尸","jiànshī","祔祭时献酒给代表死者受祭的尸。古代一种祭礼。",{"a":1,"w":[12085,7967]}],["馆殿","guǎndiàn","昭文馆、集贤院、史馆和集贤殿、右文殿的统称。",{"a":1,"w":[7919,8493]}],["飨象","xiǎngxiàng","比喻难以捉摸，无可明辨的事物。飨，通“响”。",{"a":1,"w":[11128,7500]}],["馋唾","chántuò","1) 口水。\n2) 比喻他人说过的一言半语。",{"a":1,"w":[5199,10006]}],["马纲","mǎgāng","指成批的马编纲运输，宋代或把马百匹编为一纲。",{"a":1,"w":[1273,8152]}],["马靳","mǎjìn","指马身前部。靳，古代车上夹辕两马当胸的皮革。",{"a":1,"w":[1273,20105]}],["驰光","chíguāng","1) 光芒飞射。喻迅疾。\n2) 流逝的时光。",{"a":1,"w":[8375,1271]}],["驼脂","tuózhī","指骆驼背部驼峰内的脂肪。又称峰子油，可入药。",{"a":1,"w":[8671,7903]}],["骋力","chěnglì","1) 施展才力；效力。\n2) 炫示强大有力。",{"a":1,"w":[11912,1276]}],["骑气","qíqì","1) 如骑兵阵的云气。\n2) 谓乘云气飞行。",{"a":1,"w":[674,510]}],["骑羊","qíyáng","典出汉刘向《列仙传‧葛由》：“葛由，羌人也。",{"a":1,"w":[674,1387]}],["骄憨","jiāohān","年幼不懂事而又天真可爱的样子。骄，通“娇”。",{"a":1,"w":[8457,12006]}],["惊秋","jīngqiū","1) 秋令蓦地来到。\n2) 喻迅速凋零衰败。",{"a":1,"w":[7978,1391]}],["骨榇","gǔchèn","死人埋葬后经过腐烂剩下来的骨头。亦借指尸体。",{"a":1,"w":[7537,19806]}],["高揖","gāoyī","双手抱拳高举过头作揖。古代作为辞别时的礼节。",{"a":1,"w":[35,10571]}],["鬓花","bìnhuā","1) 插戴于鬓边的花朵。\n2) 花白的鬓发。",{"a":1,"w":[10863,20]}],["闹蛾","nào'é","古代一种头饰。剪丝绸或乌金纸为花或草虫之形。",{"a":1,"w":[2352,8746]}],["郁嵂","yùlǜ","1) 形容山势曲折蜿蜒。\n2) 烟气升腾貌。",{"a":1,"w":[8084,47205]}],["鬼质","guǐzhì","1) 谓形貌粗野丑陋。\n2) 指形质丑恶者。",{"a":1,"w":[3340,7436]}],["魔宫","mógōng","1) 魔鬼之宫。\n2) 喻恶势力盘踞的地方。",{"a":1,"w":[7979,4679]}],["鱼孽","yúniè","古代迷信谓鱼类的某些不常见现象所预示的灾异。",{"a":1,"w":[526,9764]}],["鲁儒","lǔrú","鲁国儒生。亦泛指儒家学说的信奉者、儒派学者。",{"a":1,"w":[7564,8257]}],["鲁雉","lǔzhì","典出《后汉书‧鲁恭传》：“﹝鲁恭﹞拜中牟令。",{"a":1,"w":[7564,9135]}],["鲠塞","gěngsāi","1) 哽咽气塞。鲠，通“哽”。\n2) 阻塞。",{"a":1,"w":[13292,4630]}],["鲞鹤","xiǎnghè","鳓鱼鯗。因鳓鱼头上有骨，合之如鹤喙形，故称。",{"a":1,"w":[46690,8240]}],["鸟明","niǎomíng","相传为伏羲氏的六佐之一。执掌为民谋福利的事。",{"a":1,"w":[581,7431]}],["鸟乡","niǎoxiāng","宋时鄂州崇阳县雷家洞、石门洞民所居住的乡村。",{"a":1,"w":[581,3375]}],["鳦降","yǐjiàng","《诗‧商颂‧玄鸟》：“天命玄鸟，降而生商。”",{"a":1,"w":[103712,2305]}],["凤质","fèngzhì","1) 指人的美好品质。\n2) 指美妙的乐音。",{"a":1,"w":[7768,7436]}],["鸿材","hóngcái","1) 大才；卓越的才能。\n2) 上等的材料。",{"a":1,"w":[8788,7585]}],["鸿泽","hóngzé","1) 巨大的恩泽。多指皇恩。\n2) 古泽名。",{"a":1,"w":[8788,7607]}],["鹈梁","tíliáng","《诗‧曹风‧候人》：“维鹈在梁，不濡其翼。”",{"a":1,"w":[21849,7890]}],["鹄山","gǔshān","黄鹄山的省称。即今武汉市蛇山。鹄，通“鹤”。",{"a":1,"w":[10801,45]}],["鹤焰","hèyàn","亦作“鹤焰”。\n烛火。因烛台竦立如鹤，故称。",{"a":1,"w":[8240,8874]}],["鹤谶","hèchèn","白色预兆物。对旧王朝主凶，而对新王朝则主吉。",{"a":1,"w":[8240,17142]}],["鹢路","yìlù","《左传‧僖公十六年》：“六鹢退飞，过宋都。”",{"a":1,"w":[17157,54]}],["鹪蚊","jiāowén","焦螟与蚊虫。比喻极微小的东西。鹪，通“焦”。",{"a":1,"w":[13028,9095]}],["鸾翅","luánchì","1) 鸾鸟的翅羽。借指鸾鸟。\n2) 指排箫。",{"a":1,"w":[9528,8002]}],["麇聚","jūnjù","I\n谓似獐那样依类相聚。\nII\n群集；聚集。",{"a":1,"w":[26452,2309]}],["丽亿","lìyì","《诗‧大雅‧文王》：“商之孙子，其丽不亿。”",{"a":1,"w":[7634,774]}],["麴法","qūfǎ","1) 征酒税的法律。\n2) 酿酒制曲的方法。",{"a":1,"w":[12759,2258]}],["麻林","málín","成片长着的麻。常用以形容刀、枪之类密集众多。",{"a":1,"w":[7550,7469]}],["黄案","huáng'àn","1) 尚书省的案卷、文书。\n2) 黄色盘案。",{"a":1,"w":[530,7610]}],["黄烟","huángyān","1) 黄色的烟尘、云雾。\n2) 旱烟；烟丝。",{"a":1,"w":[530,1376]}],["鼓延","gǔyán","两个传说中的人物。相传为炎帝之孙伯陵的儿子。",{"a":1,"w":[3352,7649]}],["鼓纛","gǔdào","战鼓与大旗。古时皇帝册封少数民族首领的信物。",{"a":1,"w":[3352,20021]}],["齻牙","diānyá","智牙。牙床末端最后长出的两对臼齿。旧称真牙。",{"a":1,"w":[116339,2308]}],["龙禁","lóngjìn","1) 指皇帝所居之禁中。\n2) 旧时忌日名。",{"a":1,"w":[1308,7708]}],["龙盐","lóngyán","药名。传说乃龙精液生成。又称吉吊脂、紫稍花。",{"a":1,"w":[1308,2404]}],["龟王","guīwáng","1) 传说中指龟中之王。\n2) 见“龟主”。",{"a":1,"w":[7684,2278]}],["傣剧","dǎijù","傣族戏曲剧种之一，流行于云南傣族聚居的地区。",{"a":1,"w":[26621,4703]}],["甜密","tiánmì","形容感到幸