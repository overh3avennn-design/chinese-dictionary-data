54670]}],["璇弁","xuánbiàn","亦作“璿弁”。\n玉饰的皮冠。",{"a":1,"w":[15184,10962]}],["璇机","xuánjī","亦作“琁机”。\n见“璇玑”。",{"a":1,"w":[15184,7405]}],["璇耀","xuányào","亦作“璿耀”。\n见“璇曜”。",{"a":1,"w":[15184,8716]}],["璇题","xuántí","亦作“琁题”。\n玉饰的椽头。",{"a":1,"w":[15184,615]}],["琏璐","liǎnlù","谓玉相连属。以喻逶迤的雪峰。",{"a":1,"w":[19902,21743]}],["璧立","bìlì","犹壁立，陡立。璧，通“壁”。",{"a":1,"w":[8965,3314]}],["璧阴","bìyīn","光阴。因光阴贵逾金玉，故称。",{"a":1,"w":[8965,576]}],["环拥","huányōng","1) 犹环抱。\n2) 包围。",{"a":1,"w":[1320,8340]}],["玺诰","xǐgào","诏令的一种。用以授官或加封。",{"a":1,"w":[11285,13565]}],["琼佩","qióngpèi","亦作“琼佩”。\n玉制的佩饰。",{"a":1,"w":[8471,7810]}],["琼户","qiónghù","饰玉的门户。形容华美的居室。",{"a":1,"w":[8471,2320]}],["琼敷","qióngfū","1) 喻佳句。\n2) 玉饰。",{"a":1,"w":[8471,8799]}],["琼笥","qióngsì","玉饰的书箱。多指佛经、道书。",{"a":1,"w":[8471,23512]}],["琼肌","qióngjī","莹洁似玉的肌肤。多形容女子。",{"a":1,"w":[8471,7900]}],["琼都","qióngdōu","1) 京都。\n2) 指仙都。",{"a":1,"w":[8471,130]}],["瓦沼","wǎzhǎo","互盆般的水池。形容池小而浅。",{"a":1,"w":[7533,8803]}],["瓶筲","píngshāo","瓶与筲皆小器，以喻才微量狭。",{"a":1,"w":[671,20738]}],["甃甓","zhòupì","1) 井壁。\n2) 指砖壁。",{"a":1,"w":[42595,50574]}],["甍栋","méngdòng","1) 屋梁。\n2) 喻重臣。",{"a":1,"w":[59641,5083]}],["甑窐","zèngguī","陶制烹饪器。泛指粗陋的瓦器。",{"a":1,"w":[13267]}],["甘乳","gānrǔ","甘甜的乳汁。比喻有益的东西。",{"a":1,"w":[7681,7719]}],["生劫","shēngjié","1) 挟持。\n2) 犹强盗。",{"a":1,"w":[508,8458]}],["用奇","yòngqí","指军事上运用出人意料的策略。",{"a":1,"w":[26,7460]}],["由巢","yóucháo","许由与巢父的并称。泛指隐士。",{"a":1,"w":[1342,8435]}],["由绎","yóuyì","谓任用之而使其尽力施展才能。",{"a":1,"w":[1342,10031]}],["甲刃","jiǎrèn","铠甲和刀刃。喻指竹叶及枝干。",{"a":1,"w":[3330,8927]}],["申展","shēnzhǎn","1) 犹辗转。\n2) 伸展。",{"a":1,"w":[7635,7565]}],["甸圻","diānqí","同“甸畿”。\n圻，通“畿”。",{"a":1,"w":[8533,19571]}],["町崖","tīngyá","田区崖岸。引申为约束，限制。",{"a":1,"w":[9620,8942]}],["界隔","jiègé","1) 隔开。\n2) 犹界限。",{"a":1,"w":[4639,2332]}],["畎垄","quǎnlǒng","亦作“甽垄”。\n见“畎陇”。",{"a":1,"w":[23738,9394]}],["畎遂","quǎnsuì","亦作“甽遂”。\n田中小水沟。",{"a":1,"w":[23738,8193]}],["畔宫","pàngōng","泮宫。古代诸侯王所设的大学。",{"a":1,"w":[4942,4679]}],["留司","liúsī","唐人称分司东都洛阳者为留司。",{"a":1,"w":[590,7476]}],["留府","liúfǔ","职官和官署名。犹留台、留任。",{"a":1,"w":[590,7706]}],["畜民","chùmín","商代奴隶主对农业奴隶的蔑称。",{"a":1,"w":[8349,7434]}],["毕时","bìshí","指农事完毕之时。即冬闲之时。",{"a":1,"w":[8120,1280]}],["毕结","bìjié","完成束发之礼。谓已长大成人。",{"a":1,"w":[8120,2271]}],["略获","lüèhuò","1) 俘获。\n2) 指游猎。",{"a":1,"w":[7658,2355]}],["番学","fānxué","古代供外国留学生就学的学堂。",{"a":1,"w":[4735,13]}],["画凭","huàpíng","在用做凭证的官方文书上签字。",{"a":1,"w":[625,3452]}],["异目","yìmù","1) 犹另眼。\n2) 异名。",{"a":1,"w":[7464,7465]}],["畸功","jīgōng","指以不正当手段而取得的功绩。",{"a":1,"w":[9048,7516]}],["畸畯","jījùn","异行卓识之士。畯，通“俊”。",{"a":1,"w":[9048,24945]}],["畸鬼","jīguǐ","谓只重祷祀鬼神而不自我修饬。",{"a":1,"w":[9048,3340]}],["疆潦","jiānglǎo","土质坚硬容易引起涝害的土地。",{"a":1,"w":[8674,10083]}],["叠暴","diébào","人激动时筋一根一根地鼓起来。",{"a":1,"w":[8025,7675]}],["迭翠","diécuì","层叠的翠绿色。指层叠的山色。",{"a":1,"w":[8155,7928]}],["疋夫","pǐfū","古代指男性平民。亦泛指常人。",{"a":1,"w":[20188,7409]}],["疏杼","shūzhù","即衰墙。属于诸侯一级的障壁。",{"a":1,"w":[7743,13082]}],["疑迟","yíchí","迟疑。犹豫不决，拿不定主意。",{"a":1,"w":[8055,3395]}],["疙疤","gēbā","疮口或伤口愈合后留下的痕迹。",{"a":1,"w":[9549,5267]}],["疲瘁","pícuì","1) 犹疲悴。\n2) 弊病。",{"a":1,"w":[8586,12175]}],["疾亟","jíjí","1) 疾革。\n2) 急迫地。",{"a":1,"w":[7794,12396]}],["疾官","jíguān","有疾者所居之馆舍。官，房舍。",{"a":1,"w":[7794,2293]}],["病魅","bìngmèi","迷信谓因鬼魅作祟而呈现病态。",{"a":1,"w":[67,10470]}],["痕瑕","hénxiá","瘢痕，斑点。比喻缺点，毛病。",{"a":1,"w":[8873,9428]}],["瘛瘲","chìzòng","惊风；痫病。亦泛指手足痉挛。",{"a":1,"w":[395236,257503]}],["瘢疣","bānyóu","疤痕和赘疣。比喻过失，缺点。",{"a":1,"w":[10452,9391]}],["瘦减","shòujiǎn","1) 减缩。\n2) 犹瘦损。",{"a":1,"w":[1486,2328]}],["癃痹","lóngbì","衰弱，关节或肌肉疼痛、麻木。",{"a":1,"w":[32250,10283]}],["痫疾","xiánjí","即癫痫。俗称羊痫风或羊角风。",{"a":1,"w":[13492,7794]}],["痴求","chīqiú","亦作“痴求”。\n痴心的请求。",{"a":1,"w":[8690,598]}],["发旦","fādàn","周武王姬发、周公姬旦的并称。",{"a":1,"w":[522,8414]}],["发缄","fājiān","揭开器物或书札的扎束或封口。",{"a":1,"w":[522,10315]}],["发蛰","fāzhé","冬眠的动物到了春天开始活动。",{"a":1,"w":[522,12784]}],["发课","fākè","起课。旧时卜卦、占算法之一。",{"a":1,"w":[522,187]}],["白剧","báijù","我国少数民族白族的一个剧种。",{"a":1,"w":[24,4703]}],["白氐","báidī","古代少数民族名。西夷的一部。",{"a":1,"w":[24,14482]}],["百什","bǎishén","犹什百。有百倍或十倍的差别。",{"a":1,"w":[133,7488]}],["百宵","bǎixiāo","很多个夜晚。谓相当长的时间。",{"a":1,"w":[133,9364]}],["百戎","bǎiróng","古代对西方各少数民族的总称。",{"a":1,"w":[133,8500]}],["百箭","bǎijiàn","一百支箭。亦喻无数忧烦痛苦。",{"a":1,"w":[133,4666]}],["的耗","dehào","确实的消息。后多用于坏消息。",{"a":1,"w":[2,7916]}],["皇爷","huángyé","封建社会中臣下对皇帝的称呼。",{"a":1,"w":[7732,8575]}],["皈向","guīxiàng","亦作“皈向”。\n趋向；归附。",{"a":1,"w":[26329,537]}],["皋亭","gāotíng","山名。在今浙江省杭州市北郊。",{"a":1,"w":[10318,8241]}],["皮钱","píqián","明代所铸的一种薄而小的铜钱。",{"a":1,"w":[1291,138]}],["盗具","dàojù","为盗之具。指谋取私利的手段。",{"a":1,"w":[8038,7505]}],["盗决","dàojué","私自开通水道；非法决裂堤岸。",{"a":1,"w":[8038,7574]}],["盗禄","dàolù","窃取禄位。亦指窃取禄位之人。",{"a":1,"w":[8038,8602]}],["监户","jiānhù","指因犯罪没入官中为奴的民户。",{"a":1,"w":[7644,2320]}],["监郡","jiānjùn","监察郡县。亦指监察郡县之官。",{"a":1,"w":[7644,9030]}],["盘受","pánshòu","犹受盘。承受工商企业的转让。",{"a":1,"w":[2285,1324]}],["盘泊","pánpō","1) 滞留。\n2) 犹盘踞。",{"a":1,"w":[2285,8463]}],["盘肴","pányáo","亦作“盘肴”。\n盘盛的肴馔。",{"a":1,"w":[2285,12919]}],["荡陈","dàngchén","冲击敌方军阵。陈，同“阵”。",{"a":1,"w":[7756,7893]}],["直梦","zhímèng","醒后所见与梦中同，谓之直梦。",{"a":1,"w":[1294,2386]}],["直干","zhígàn","亦作“直干”。\n挺直的树干。",{"a":1,"w":[1294,46]}],["直舍","zhíshě","古代官员在禁中当值办事之处。",{"a":1,"w":[1294,7531]}],["相强","xiāngqiáng","亦作“相强”。\n勉强；强迫。",{"a":1,"w":[7427,1314]}],["盼遇","pànyù","亦作“盻遇”。\n眷顾，恩遇。",{"a":1,"w":[10589,2367]}],["省耗","shěnghào","五代时征收田赋的一种附加税。",{"a":1,"w":[607,7916]}],["看玩","kànwán","亦作“看翫”。\n观赏；玩耍。",{"a":1,"w":[122,648]}],["看发","kànfā","清朝男人所蓄辫子周围的短发。",{"a":1,"w":[122,522]}],["真堂","zhēntáng","影堂。奉祀祖先名人遗像之所。",{"a":1,"w":[85,7695]}],["真然","zhēnrán","1) 真的。\n2) 犹自然。",{"a":1,"w":[85,7451]}],["眩形","xuànxíng","幻术；变戏法。眩，通“幻”。",{"a":1,"w":[9899,4612]}],["眯语","mīyǔ","亦作“眯语”。\n呓语；梦话。",{"a":1,"w":[5242,7447]}],["眼尘","yǎnchén","眼前的尘土。比喻一时的小事。",{"a":1,"w":[551,7843]}],["众事","zhòngshì","众多的政务。亦泛指各种事情。",{"a":1,"w":[7688,33]}],["众匿","zhòngnì","各种罪恶。匿，“慝”的古字。",{"a":1,"w":[7688,9684]}],["众垤","zhòngdié","一群小土堆。比喻平凡的事物。",{"a":1,"w":[7688,37242]}],["众揖","zhòngyī","谓对同等爵位之多人总行一揖。",{"a":1,"w":[7688,10571]}],["督篆","dūzhuàn","总督的大印。借指总督的官位。",{"a":1,"w":[8063,9979]}],["睾鼓","gāogǔ","鼓名。即鼛鼓。睾，通“鼛”。",{"a":1,"w":[21675,3352]}],["睿旨","ruìzhǐ","圣人的意旨。后称皇帝的诏令。",{"a":1,"w":[12154,9200]}],["瞽妄","gǔwàng","瞽说妄议。指不切实际的言论。",{"a":1,"w":[15332,8584]}],["蒙聋","ménglóng","目不见，耳不闻。喻糊里糊涂。",{"a":1,"w":[4647,9524]}],["矢死","shǐsǐ","誓死。谓下定决心，宁可死去。",{"a":1,"w":[8270,1329]}],["知常","zhīcháng","了解社会常规；了解自然法则。",{"a":1,"w":[7492,99]}],["短黄","duǎnhuáng","蔬菜名。即矮黄。薹菜的一种。",{"a":1,"w":[577,530]}],["石堤","shídī","亦作“石堤”。\n石筑的堤防。",{"a":1,"w":[7419,9344]}],["石师","shíshī","犹硕师，大师。石，通“硕”。",{"a":1,"w":[7419,7489]}],["石炮","shípào","抛石机；以机发石的一种战具。",{"a":1,"w":[7419,4644]}],["石磐","shípán","磐石，大石。比喻坚固的基业。",{"a":1,"w":[7419,12257]}],["石祖","shízǔ","奇石之祖。谓奇石中之最奇者。",{"a":1,"w":[7419,7723]}],["石棱","shíléng","石头的棱角。也指多棱的山石。",{"a":1,"w":[7419,8100]}],["矹硉","wùlù","山石突出貌。喻胸中不平之气。",{"a":1,"w":[106023,76174]}],["砉欻","huòchuā","象声词。形容微小飘忽的声音。",{"a":1,"w":[42596,18544]}],["砌台","qìtái","古代王侯家用以登临观赏之台。",{"a":1,"w":[9902,1306]}],["砎石","jièshí","坚硬的石头。比喻耿介的气质。",{"a":1,"w":[179549,7419]}],["砯砯","pīngpīng","象声词。形容水流石罅等声响。",{"a":1}],["砰啪","pēngpā","象声词。形容碰撞、轰响等声。",{"a":1,"w":[18940,14799]}],["炮墩","pàodūn","用沙袋和小船构成的简易炮台。",{"a":1,"w":[4644,8891]}],["砚槽","yàncáo","砚端贮水处。凹陷如槽，故名。",{"a":1,"w":[10108,7986]}],["硰石","shāshí","古地名。在今山西省宁武县境。",{"a":1,"w":[7419]}],["碎乳","suìrǔ","古代钟面上隆起如乳头的纹饰。",{"a":1,"w":[3359,7719]}],["碧洞","bìdòng","1) 石洞。\n2) 指道观。",{"a":1,"w":[8659,3374]}],["碧溪","bìxī","亦作“碧谿”。\n绿色的溪流。",{"a":1,"w":[8659,4874]}],["碧簪","bìzān","碧玉簪。比喻苍翠陡峭的山峰。",{"a":1,"w":[8659,9760]}],["碧组","bìzǔ","草名。色碧，纹理似组，故名。",{"a":1,"w":[8659,558]}],["碧蹄","bìtí","马蹄。亦借指骑兵或一般部队。",{"a":1,"w":[8659,8653]}],["碧鲈","bìlú","即鲈鱼。因背部青灰色，故称。",{"a":1,"w":[8659,8389]}],["确货","quèhuò","犹榷货。旧指官府专卖的货物。",{"a":1,"w":[8047,2304]}],["磊垝","lěiguǐ","亦作“磥垝”。\n见“磊嵬”。",{"a":1,"w":[13173,34103]}],["磊魁","lěikuí","亦作“磥魁”。\n见“磊隗”。",{"a":1,"w":[13173,8560]}],["磐固","pángù","如磐石般稳固。形容不可动摇。",{"a":1,"w":[12257,7552]}],["磐错","páncuò","盘根错节。比喻事情繁难复杂。",{"a":1,"w":[12257,147]}],["砖口","zhuānkǒu","方言。冬天手脚上冻裂的口子。",{"a":1,"w":[4857,47]}],["碛北","qìběi","旧称蒙古高原大沙漠以北地区。",{"a":1,"w":[12115,132]}],["磨骨","mógǔ","比喻残酷折磨，极言为害之烈。",{"a":1,"w":[4677,7537]}],["硗戛","qiāojiá","形容文句佶屈聱牙，生硬晦涩。",{"a":1,"w":[16246,11712]}],["祆主","xiānzhǔ","古代祆教祈祷日主演幻术的人。",{"a":1,"w":[21393,7425]}],["祔藏","fùcáng","为附祭而存放(先祖的神位)。",{"a":1,"w":[24118,4688]}],["祔食","fùshí","合食，受祭时和祖先共享祭品。",{"a":1,"w":[24118,7466]}],["秘印","mìyìn","佛教语。谓与佛心秘密相印契。",{"a":1,"w":[7938,4649]}],["秘纬","mìwěi","记述神秘事物之书；谶纬之书。",{"a":1,"w":[7938,8757]}],["秘著","mìzhù","六朝人对秘书、著作郎的并称。",{"a":1,"w":[7938,7908]}],["祖录","zǔlù","佛教禅宗所记祖师言谈的语录。",{"a":1,"w":[7723,1380]}],["祝官","zhùguān","古代掌管祭祀祝祷等事宜之官。",{"a":1,"w":[1473,2293]}],["神匾","shénbiǎn","悬挂在神庙门顶或墙上的匾额。",{"a":1,"w":[3316,16420]}],["神瞽","shéngǔ","上古乐官。旧谓能知天道的人。",{"a":1,"w":[3316,15332]}],["祠具","cíjù","祭祀时所用的器具。或称祠器。",{"a":1,"w":[10439,7505]}],["祥肉","xiángròu","亲丧满十三月祭祀时所供之肉。",{"a":1,"w":[8467,116]}],["票钞","piàochāo","古纸币的一种。通用于明清时。",{"a":1,"w":[142,8820]}],["祭哜","jìjì","古代行祭礼时举食器至齿示尝。",{"a":1,"w":[8417,37866]}]]