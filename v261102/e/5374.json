苍","mǎngcāng cāng","1) 一望无际。\n2) 空阔；迷茫。",{"a":1,"w":[177671,8328]}],["蛟绡纱","jiāoxiāoshā","传说鲛人所织的丝织品。蛟，通“鲛”。",{"a":1,"w":[14013,22878,8800]}],["蛱蝶粉","jiádié fěn","蝶翅和体表密被的鳞片，易落，呈粉状。",{"a":1,"w":[10087,7613]}],["虱建草","shījiàncǎo","亦作“虱建草”。\n能除虮虱的一种草。",{"a":1,"w":[9142,1345,521]}],["蜡糖人","là tángrén","以染色蜡液加入饴糖中所制成的小偶人。",{"a":1,"w":[8142,120450]}],["里马房","lǐmǎ fáng","明代宫中监官典簿奉旨拷打内犯的处所。",{"a":1,"w":[23617,7555]}],["亲事官","qīnshì guān","唐代官名，在政府部门中干办具体事务。",{"a":1,"w":[41862,2293]}],["观风使","guānfēng shǐ","1) 官名。\n2) 指清代的学政使。",{"a":1,"w":[68516,1332]}],["讨顺风","tǎo shùnfēng","指旧时船家于出航前祭神以求一路顺风。",{"a":1,"w":[8102,13636]}],["许由津","xǔyóujīn","指颍水。相传许由洗耳于颍水滨，故称。",{"a":1,"w":[7709,1342,7884]}],["详定官","xiángdìngguān","殿试时复查并最后评定试卷等第的考官。",{"a":1,"w":[8449,2259,2293]}],["说诨经","shuōhùnjīng","宋代“说话”类别之一。演讲宗教故事。",{"a":1,"w":[68,19440,7421]}],["调阵子","tiáozhèn zi","古代戏曲术语。表示舞台上的战争场面。",{"a":1,"w":[311730,1]}],["谢允礼","xièyǔnlǐ","旧俗男方答谢女方同意订婚所送的财礼。",{"a":1,"w":[7570,8599,3342]}],["谢公笺","xiègōngjiān","一种样式的纸。为宋谢景初初创，故称。",{"a":1,"w":[7570,4610,9999]}],["警夜钟","jǐngyè zhōng","指古代宫中代替鼓漏以促宫人早起的钟。",{"a":1,"w":[140131,1410]}],["护宝都","hùbǎodōu","宋时警卫解县、安邑两盐池的武装组织。",{"a":1,"w":[4643,2313,130]}],["豁虎跳","huōhǔtiào","一种类似虎跳的动作。常用以形容欢跃。",{"a":1,"w":[8714,3337,1404]}],["贵易交","guìyìjiāo","谓显贵后忘弃贫贱时的朋友，另结新知。",{"a":1,"w":[167,7463,535]}],["买服钱","mǎifú qián","要守丧期间的寡妇除丧服再嫁所出的钱。",{"a":1,"w":[86749,138]}],["越王鸟","yuèwáng niǎo","一种水鸟。产于广东、广西及越南一带。",{"a":1,"w":[34836,581]}],["赵中贵","zhào zhōngguì","指秦宦官赵高。为宦官奸诈弄权的典型。",{"a":1,"w":[8536,143291]}],["赵夫子","zhào fūzǐ","对善于说趣话、喜欢胡编乱造者的谑称。",{"a":1,"w":[8536,11872]}],["跟斗翻","gēndǒu fān","指旧社会本利成倍滚上去的一种高利贷。",{"a":1,"w":[31014,2337]}],["踏摇娘","tàyáoniáng","1) 见“踏谣娘”。\n2) 指歌女。",{"a":1,"w":[4781,2377,8089]}],["身外身","shēnwài shēn","佛教语。指由正身变化产生出来的身体。",{"a":1,"w":[31248,7456]}],["迦奢草","jiāshēcǎo","梵语的音译。一种茅草，常作坐具等用。",{"a":1,"w":[9866,9225,521]}],["逆风家","nìfēng jiā","赞誉德才超卓的人，谓其名声逆风远播。",{"a":1,"w":[35378,28]}],["连云梯","lián yúntī","高耸入云的梯子。喻指险峻陡峭的山道。",{"a":1,"w":[1288,29718]}],["