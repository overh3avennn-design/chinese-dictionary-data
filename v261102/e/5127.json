":[7663,7461]}],["销朽","xiāoxiǔ","谓形销骨朽，泯灭无存。",{"a":1,"w":[7663,9194]}],["销氛","xiāofēn","谓消除恶气，平定祸乱。",{"a":1,"w":[7663,9649]}],["销膏","xiāogāo","指灯烛燃烧时耗费油膏。",{"a":1,"w":[7663,8048]}],["鋐鋐","hónghóng","象声词。形容声音宏大。",{"a":1,"w":[138895]}],["锋焰","fēngyàn","锋颖光焰; 锋芒气焰。",{"a":1,"w":[8275,8874]}],["锋巨","fēngjù","锋锷。借指刀剑等武器。",{"a":1,"w":[8275,7862]}],["锋钲","fēngzhēng","利剑和铜钲。借指战乱。",{"a":1,"w":[8275,21823]}],["铓辉","mánghuī","刀剑尖端、刃口的光辉。",{"a":1,"w":[32322,8317]}],["录橐","lùtuó","谓抄家，清点登记财产。",{"a":1,"w":[1380,10553]}],["锥匕","zhuībǐ","喻细小之物。匕，箭头。",{"a":1,"w":[7992,15468]}],["铮鍧","zhēnghōng","象声词。形容声音洪亮。",{"a":1,"w":[16562,86108]}],["铮枪","zhēngqiāng","象声词。玉石等撞击声。",{"a":1,"w":[16562,3338]}],["锭药","dìngyào","制成锭子状的小块药物。",{"a":1,"w":[9058,579]}],["钱黥","qiánqíng","在面孔上黥刺钱形图纹。",{"a":1,"w":[138,19615]}],["錣策","zhuìcè","上端带有铁针的赶马杖。",{"a":1,"w":[61146,7673]}],["锦凡","jǐnfán","锦帆。凡，用同“帆”。",{"a":1,"w":[7982,8150]}],["锢籍","gùjí","谓废为庶人，居留原籍。",{"a":1,"w":[13047,7983]}],["锢见","gùjiàn","犹成见。锢，通“固”。",{"a":1,"w":[13047,76]}],["错兵","cuòbīng","犹用兵。错，通“措”。",{"a":1,"w":[147,2282]}],["错守","cuòshǒu","置守。一说，轮番守卫。",{"a":1,"w":[147,2338]}],["错躬","cuògōng","犹置身。错，通“措”。",{"a":1,"w":[147,9213]}],["锻坊","duànfāng","旧时的手工业打铁作坊。",{"a":1,"w":[9192,8643]}],["钟气","zhōngqì","谓凝聚天地间灵秀之气。",{"a":1,"w":[1410,510]}],["钟笙","zhōngshēng","乐钟声和相应和的笙乐。",{"a":1,"w":[1410,11466]}],["镕调","róngdiào","指立意炼句，调和韵律。",{"a":1,"w":[14710,1290]}],["锁袱","suǒfú","用鸟兽细毛制成的衣饰。",{"a":1,"w":[3368,13843]}],["镐宴","gǎoyàn","谓天下太平，君臣同乐。",{"a":1,"w":[11514,8323]}],["锵鎯","qiāngláng","象声词。形容金属响声。",{"a":1,"w":[24620,172433]}],["镜浦","jìngpǔ","像镜子一样清澈的水面。",{"a":1,"w":[7535,8719]}],["鐏俎","zūnzǔ","樽俎。借指宴席，宴会。",{"a":1,"w":[229320,12968]}],["钟彝","zhōngyí","指青铜礼器。彝，彝器。",{"a":1,"w":[1410,9828]}],["镫火","dènghuǒ","灯火。古代油灯的火头。",{"a":1,"w":[13444,1284]}],["镯镂","zhuólòu","属镂。剑名。泛指宝剑。",{"a":1,"w":[17824,9850]}],["铁什","tiěshén","指古代车饰之铁制杂具。",{"a":1,"w":[1298,7488]}],["铁帚","tiězhǒu","铁扫帚。比喻人民力量。",{"a":1,"w":[1298,11203]}],["铁摆","tiěbǎi","契丹语的音译。犹嵩高。",{"a":1,"w":[1298,2366]}],["铁限","tiěxiàn","铁门限。借指大的铁棒。",{"a":1,"w":[1298,7616]}],["铁鹿","tiělù","船上收放篷帆的铁辘轳。",{"a":1,"w":[1298,8199]}],["铛旋","dāngxuán","即铛。一种古代的炊器。",{"a":1,"w":[15637,7532]}],["铸客","zhùkè","从事铸造业的工商业者。",{"a":1,"w":[8547,7618]}],["鉴观","jiànguān","亦作“鉴观”。\n察视。",{"a":1,"w":[8039,7514]}],["鑢锤","lǜchuí","磋磨锤打。引申为治理。",{"a":1,"w":[50859,4810]}],["炉櫜","lúgāo","冶炉旁吹火令炽的风箱。",{"a":1,"w":[7902,19354]}],["凿窒","záozhì","开通窒塞。谓心境舒畅。",{"a":1,"w":[8504,9664]}],["长列","zhǎngliè","十二支中“未”的别称。",{"a":1,"w":[515,2268]}],["长壬","zhǎngrén","十二支中“酉”的别称。",{"a":1,"w":[515,11059]}],["长旓","zhǎngshāo","指旒饰下垂较长的旌旗。",{"a":1,"w":[515,143907]}],["长王","zhǎngwáng","十二支中“酉”的别称。",{"a":1,"w":[515,2278]}],["长蔬","zhǎngshū","长期食蔬菜，不吃荤腥。",{"a":1,"w":[515,9834]}],["长蛾","zhǎng'é","指妇女所画细长的眉毛。",{"a":1,"w":[515,8746]}],["长襦","zhǎngrú","较长之短衣。襦，短衣。",{"a":1,"w":[515,16232]}],["门选","ménxuǎn","根据门第高低选任官员。",{"a":1,"w":[53,588]}],["闭修","bìxiū","谓修明政治，自守其国。",{"a":1,"w":[4684,1339]}],["闭壁","bìbì","关闭城门。谓只守不战。",{"a":1,"w":[4684,7850]}],["闭肆","bìsì","谓关闭铺子，停止营业。",{"a":1,"w":[4684,8346]}],["闭蓄","bìxù","谓埋藏于内心而不外露。",{"a":1,"w":[4684,8173]}],["开嗣","kāisì","开拓，继承；为展延续。",{"a":1,"w":[31,9449]}],["开屯","kāitún","谓屯聚人员，开垦荒地。",{"a":1,"w":[31,8563]}],["开厅","kāitīng","旧指在妓院中设席宴客。",{"a":1,"w":[31,3439]}],["开延","kāiyán","谓开启贤路，延揽人才。",{"a":1,"w":[31,7649]}],["开忏","kāichàn","谓开始诵经拜忏的活动。",{"a":1,"w":[31,13549]}],["开统","kāitǒng","谓开创世代相继的皇统。",{"a":1,"w":[31,7442]}],["闳俊","hóngjùn","谓气魄阔大，才气出众。",{"a":1,"w":[12278,8835]}],["闳约","hóngyuē","谓内容丰富，言词简炼。",{"a":1,"w":[12278,1330]}],["闲休","xiánxiū","指辞退工作。谓歇息去。",{"a":1,"w":[3381,7670]}],["闲伺","xiáncì","亦作“间伺”。\n窥测。",{"a":1,"w":[3381,8912]}],["闲侦","xiánzhēn","亦作“间侦”。\n刺探。",{"a":1,"w":[3381,8691]}],["闲口","xiánkǒu","亦作“闲口”。\n闲话。",{"a":1,"w":[3381,47]}],["闲执","xiánzhí","亦作“间执”。\n堵塞。",{"a":1,"w":[3381,7826]}],["闲奥","xián'ào","亦作“闲奥”。\n幽深。",{"a":1,"w":[3381,7481]}],["闲毁","xiánhuǐ","亦作“间毁”。\n诽谤。",{"a":1,"w":[3381,4749]}],["闲缺","xiánquē","亦作“间缺”。\n空隙。",{"a":1,"w":[3381,1412]}],["闲邑","xiányì","古代指未被封赐的土地。",{"a":1,"w":[3381,8731]}],["闲错","xiáncuò","亦作“间错”。\n间杂。",{"a":1,"w":[3381,147]}],["闲阻","xiánzǔ","亦作“间阻”。\n阻隔。",{"a":1,"w":[3381,7747]}],["阁主","gézhǔ","寺院中专管佛阁的和尚。",{"a":1,"w":[8208,7425]}],["阁标","gébiāo","明督师大学士所辖军队。",{"a":1,"w":[8208,7449]}],["阁诏","gézhào","搁置诏书。谓不奉诏命。",{"a":1,"w":[8208,9242]}],["闺戒","guījiè","旧指妇女应遵守的戒条。",{"a":1,"w":[9497,3377]}],["阅心","yuèxīn","谓各种情感交集于内心。",{"a":1,"w":[8211,1279]}],["阅见","yuèjiàn","逐一地看到。指经历过。",{"a":1,"w":[8211,76]}],["阉洁","yānjié","割除动物的睾丸或卵巢。",{"a":1,"w":[12977,8263]}],["闱箔","wéibó","内室的门帘。借指妇女。",{"a":1,"w":[11278,11753]}],["阑逸","lányì","犹出格。谓言语没遮拦。",{"a":1,"w":[9419,8116]}],["闿切","kǎiqiè","恳切。闓，用同“剀”。",{"a":1,"w":[52070,2276]}],["闯破","chuǎngpò","突然进来碰见而被揭穿。",{"a":1,"w":[3542,1325]}],["阱坑","jǐngkēng","陷阱。比喻苦难的深渊。",{"a":1,"w":[9964,4706]}],["防团","fángtuán","防御使、团练使的并称。",{"a":1,"w":[1302,1336]}],["防绝","fángjué","防止杜绝(坏事发生)。",{"a":1,"w":[1302,4627]}],["阻乱","zǔluàn","谓武人拥兵或恃险作乱。",{"a":1,"w":[7747,1360]}],["阻异","zǔyì","谓意见不和，产生嫌隙。",{"a":1,"w":[7747,7464]}],["阿夷","āyí","古代獠族对妇女的称呼。",{"a":1,"w":[7414,7910]}],["阿鹜","āwù","三国魏荀攸之妾的小名。",{"a":1,"w":[7414,15016]}],["陋固","lòugù","谓孤陋寡闻，浅见薄识。",{"a":1,"w":[9064,7552]}],["陋诚","lòuchéng","愚诚，愚忠。自谦之词。",{"a":1,"w":[9064,8307]}],["陌纸","mòzhǐ","指纸钱。陌，通“佰”。",{"a":1,"w":[9732,622]}],["降乩","jiàngjī","谓扶乩时神灵降下旨意。",{"a":1,"w":[2305,35091]}],["降死","jiàngsǐ","由死罪降免减等为徒刑。",{"a":1,"w":[2305,1329]}],["降玺","jiàngxǐ","谓降敕褒奖，下诏勉励。",{"a":1,"w":[2305,11285]}],["限米","xiànmǐ","古代按规定应出的税米。",{"a":1,"w":[7616,557]}],["除孝","chúxiào","指守孝期满后脱去丧服。",{"a":1,"w":[4635,8298]}],["陬澨","zōushì","僻远处。犹言天涯海角。",{"a":1,"w":[13625,45247]}],["阴基","yīnjī","房基。因在地下，故称。",{"a":1,"w":[576,7423]}],["阴岸","yīn'àn","背阳的水岸。河的南岸。",{"a":1,"w":[576,3418]}],["阴微","yīnwēi","谓短浅的，说不出口的。",{"a":1,"w":[576,7512]}],["阴台","yīntái","在北郊的祭祀土神之台。",{"a":1,"w":[576,1306]}],["阴谐","yīnxié","鸟名。一说虫名。即蝔。",{"a":1,"w":[576,8105]}],["陈戎","chénróng","部署军队，以兵戎相见。",{"a":1,"w":[7893,8500]}],["陈雷","chénléi","东汉陈重和雷义的并称。",{"a":1,"w":[7893,3319]}],["陵场","língchǎng","陵墓周围的场地；陵园。",{"a":1,"w":[7966,544]}],["陵社","língshè","陵庙与社稷。借指国家。",{"a":1,"w":[7966,3327]}],["陵薮","língsǒu","山陵和湖泽。泛指山野。",{"a":1,"w":[7966,10471]}],["陵逾","língyú","僭越，超出规定的范围。",{"a":1,"w":[7966,8781]}],["陵陂","língbēi","山坡；地势较高的田地。",{"a":1,"w":[7966,10251]}],["陵霞","língxiá","犹凌云。比喻超然物外。",{"a":1,"w":[7966,4805]}],["陶物","táowù","谓教化培育，使人成材。",{"a":1,"w":[7848,7412]}],["陶远","táoyuǎn","谓教化之泽，流传久远。",{"a":1,"w":[7848,103]}],["陆郎","lùláng","指南朝陈后主宠臣陆瑜。",{"a":1,"w":[7605,8101]}],["阳榭","yángxiè","高台；高大无室的厅堂。",{"a":1,"w":[7484,14090]}],["阳霁","yángjì","谓日出雨止，天气放晴。",{"a":1,"w":[7484,12997]}],["阳类","yánglèi","迷信称属于阳间的物类。",{"a":1,"w":[7484,1323]}],["隃墨","shùmò","隃麋产的墨。借指名墨。",{"a":1,"w":[22243,7667]}],["隈蔚","wēiwèi","山势曲折，树木茂密貌。",{"a":1,"w":[14037,10050]}],["隍陴","huángpí","城壕与女墙。借指城池。",{"a":1,"w":[26885,50949]}],["阶檐","jiēyán","台阶和屋檐。指进门处。",{"a":1,"w":[7773,9322]}],["阶迎","jiēyíng","在阶前迎接，表示敬意。",{"a":1,"w":[7773,8235]}],["陨丘","yǔnqiū","传说中燧人氏四佐之一。",{"a":1,"w":[8185,7868]}],["陨踬","yǔnzhì","跌倒；崩塌。借指死亡。",{"a":1,"w":[8185,16495]}],["隙蠹","xìdù","隙缝和蛀虫。比喻隐患。",{"a":1,"w":[8385,9819]}],["障吝","zhànglìn","围堤占夺水面并加守护。",{"a":1,"w":[7656,11060]}],["随璞","suípú","指随侯之珠与和氏之璧。",{"a":1,"w":[1375,11839]}],["险肤","xiǎnfū","谓恶意中伤的谣传之言。",{"a":1,"w":[4634,8232]}],["隐佯","yǐnyáng","谓隐蔽真情，佯装不知。",{"a":1,"w":[7652,9931]}],["隐忿","yǐnfèn","心怀忿恨；心中的忿恨。",{"a":1,"w":[7652,10017]}],["隐疵","yǐncī","微小的不足之处；小过。",{"a":1,"w":[7652,10139]}],["隶汉","lìhàn","即汉隶。指汉代的隶书。",{"a":1,"w":[8847,7539]}],["隼击","sǔnjī","比喻疾速而猛烈地攻击。",{"a":1,"w":[20908,7506]}],["雄剧","xióngjù","谓地位重要而事务繁重。",{"a":1,"w":[7818,4703]}],["雄宕","xióngdàng","谓气魄宏伟，感情奔放。",{"a":1,"w":[7818,14535]}],["雅奴","yǎnú","丫环。雅，用同“丫”。",{"a":1,"w":[7788,8153]}],["雅鬟","yǎhuán","丫鬟。雅，用同“丫”。",{"a":1,"w":[7788,17780]}],["雉库","zhìkù","雉门及库门。泛指宫阙。",{"a":1,"w":[9135,3332]}],["隽蔚","juànwèi","谓意味深长，富有文采。",{"a":1,"w":[15963,10050]}],["雍畤","yōngzhì","古代祭五方天帝的祭坛。",{"a":1,"w":[9147,39975]}],["雕目","diāomù","形容眼睛睁圆如雕之目。",{"a":1,"w":[8192,7465]}],["虽马","suīmǎ","兽名。神话中的独角马。",{"a":1,"w":[4886,1273]}],["双表","shuāngbiǎo","华表。通常成对，故称。",{"a":1,"w":[1309,536]}],["雚蒲","guànpú","芦苇和蒲草。泛指水草。",{"a":1,"w":[130388,8305]}],["杂奏","zázòu","谓俳优及歌舞交相融合。",{"a":1,"w":[4680,4777]}],["杂污","záwū","谓杂乱污秽，不合礼义。",{"a":1,"w":[4680,7785]}],["杂耕","zágēng","谓屯田之兵与居民杂居。",{"a":1,"w":[4680,2416]}],["雍培","yōngpéi","犹培育。雝，通“壅”。",{"a":1,"w":[9147,8053]}],["鸡肤","jīfū","形容老年人发皱的皮肤。",{"a":1,"w":[578,8232]}],["离苑","líyuàn","古代帝王离宫中的园林。",{"a":1,"w":[543,9274]}],["雩蜡","yúlà","年终祭神。亦泛指祭神。",{"a":1,"w":[16328,8142]}],["雪履","xuělǚ","在雪地行走所穿的鞋子。",{"a":1,"w":[616,7942]}],["雪荠","xuějì","荠菜花开呈白色，故称。",{"a":1,"w":[616,8907]}],["雪藕","xuě'ǒu","嫩藕。嫩藕色白，故称。",{"a":1,"w":[616,10957]}],["雪赞","xuězàn","亦作“雪赞”。\n咏雪。",{"a":1,"w":[616,8033]}],["云冻","yúndòng","谓天气寒冷时阴云凝聚。",{"a":1,"w":[554,3397]}],["云岑","yúncén","云雾缭绕的山峰。高山。",{"a":1,"w":[554,8832]}],["云村","yúncūn","云气笼罩的村落、山村。",{"a":1,"w":[554,1430]}],["云楶","yúnjié","有云状纹饰的柱头斗栱。",{"a":1,"w":[554,96346]}],["云标","yúnbiāo","云的顶端。比喻极高处。",{"a":1,"w":[554,7449]}],["云祥","yúnxiáng","祥云。表示吉祥的云彩。",{"a":1,"w":[554,8467]}],["云箔","yúnbó","云帘。天宫以云为帘幕。",{"a":1,"w":[554,11753]}],["云萃","yúncuì","从四面八方聚集在一起。",{"a":1,"w":[554,9398]}],["云鸡","yúnjī","传说中随仙道升天之鸡。",{"a":1,"w":[554,578]}],["零烟","língyān","指被烽火熏染后的残迹。",{"a":1,"w":[181,1376]}],["零铃","línglíng","词牌名。即《雨淋铃》。",{"a":1,"w":[181,3441]}],["雹神","báoshén","传说中指主管降雹的神。",{"a":1,"w":[17199,3316]}],["电旆","diànpèi","舒卷如闪电之光的旗帜。",{"a":1,"w":[12,14637]}],["电碓","diànduì","利用电力舂米谷的设备。",{"a":1,"w":[12,23380]}],["电釂","diànjiào","闪电般地喝干杯中之酒。",{"a":1,"w":[12,58612]}],["需滞","xūzhì","指授职后迟迟不能赴任。",{"a":1,"w":[7998,8309]}],["霄明","xiāomíng","人名。相传为舜的女儿。",{"a":1,"w":[9823,7431]}],["霄渊","xiāoyuān","犹霄壤。比喻相去极远。",{"a":1,"w":[9823,8649]}],["霄驾","xiāojià","犹云车。仙人以云为车。",{"a":1,"w":[9823,7879]}],["震筵","zhènyán","帝王的坐席。借指朝廷。",{"a":1,"w":[7751,9831]}],["霓袖","níxiù","彩袖。也借指歌伎舞女。",{"a":1,"w":[10817,8688]}],["霜木","shuāngmù","指树身白色如霜的古木。",{"a":1,"w":[8258,7435]}],["霜村","shuāngcūn","指白色月光笼罩的山村。",{"a":1,"w":[8258,1430]}],["霜标","shuāngbiāo","高雅贞洁的风度、品格。",{"a":1,"w":[8258,7449]}],["霜禽","shuāngqín","霜鸟。指白鸥、白鹭等。",{"a":1,"w":[8258,8747]}],["霜笛","shuāngdí","霜天笛声；凄怨的笛声。",{"a":1,"w":[8258,9468]}],["霜脊","shuāngjí","刀剑的脊。亦借指刀剑。",{"a":1,"w":[8258,8277]}],["霜角","shuāngjiǎo","边寒地区戍卒吹的号角。",{"a":1,"w":[8258,533]}],["霜电","shuāngdiàn","霜和雷电。喻严正刚烈。",{"a":1,"w":[8258,12]}],["霞佩","xiápèi","仙女的饰物。借指仙女。",{"a":1,"w":[4805,7810]}],["霣祚","yǔnzuò","殒寿，死亡。祚，年寿。",{"a":1,"w":[61678,11222]}],["雾扃","wùjiōng","比喻深居，与外界隔绝。",{"a":1,"w":[3421,15982]}],["雾氛","wùfēn","亦作“雾雰”。\n雾气。",{"a":1,"w":[3421,9649]}],["雾鬣","wùliè","浓密的鬣毛。亦借指马。",{"a":1,"w":[3421,10816]}],["露会","lùhuì","在晚上刚下露水时相会。",{"a":1,"w":[4674,18]}],["露泄","lùxiè","亦作“露泄”。\n泄露。",{"a":1,"w":[4674,8074]}],["霸相","bàxiāng","指能助君主称霸的相臣。",{"a":1,"w":[8096,7427]}],["霸衿","bàjīn","指地方上有权势的士绅。",{"a":1,"w":[8096,11664]}],["灵兔","língtù","指传说中月宫中的玉兔。",{"a":1,"w":[7588,3426]}],["灵匮","língkuì","犹金匮。国家藏书之柜。",{"a":1,"w":[7588,13942]}],["灵蚌","língbàng","即蚌。因能产珠，故称。",{"a":1,"w":[7588,10359]}],["青刀","qīngdāo","形容尖长如刀的青蒲叶。",{"a":1,"w":[3320,1369]}],["青吹","qīngchuī","风吹林木声。借指清风。",{"a":1,"w":[3320,637]}],["青坛","qīngtán","帝王春日郊祭用的土台。",{"a":1,"w":[3320,8465]}],["青幻","qīnghuàn","谓其色青苍，其形奇幻。",{"a":1,"w":[3320,8567]}],["青氐","qīngdī","古代少数民族氐的一支。",{"a":1,"w":[3320,14482]}],["青洲","qīngzhōu","即青邱。传说中的仙洲。",{"a":1,"w":[3320,7759]}],["青缴","qīngjiǎo","系在箭上的青色生丝绳。",{"a":1,"w":[3320,8608]}],["青翳","qīngyì","传说中翳鸟的彩色毛羽。",{"a":1,"w":[3320,9715]}],["青薪","qīngxīn","刚砍伐下的树木、树枝。",{"a":1,"w":[3320,8398]}],["青锡","qīngxī","即锡。锡色青灰，故称。",{"a":1,"w":[3320,8582]}],["青靠","qīngkào","黑色的紧身窄袖武士服。",{"a":1,"w":[3320,656]}],["青鲂","qīngfáng","鱼。体呈银灰色，故称。",{"a":1,"w":[3320,10418]}],["靛颔","diànhàn","鸟名。颔下蓝色，故称。",{"a":1,"w":[12308,12334]}],["静乱","jìngluàn","平定变乱；使安定宁静。",{"a":1,"w":[1386,1360]}],["静晦","jìnghuì","静处韬晦。指隐退不仕。",{"a":1,"w":[1386,9596]}],["非世","fēishì","谓诋毁世俗，讥刺世事。",{"a":1,"w":[2265,7462]}],["靡倾","míqīng","随顺着向某一方面流动。",{"a":1,"w":[8373,7714]}],["面佥","miànqiān","(书画)封面上的题签。",{"a":1,"w":[523,13347]}],["革木","gémù","古乐器名，鞀鼓与柷敔。",{"a":1,"w":[7633,7435]}],["革听","gétīng","改变听闻。指提高名声。",{"a":1,"w":[7633,146]}],["靳巧","jìnqiǎo","谓保守技艺，不肯外传。",{"a":1,"w":[20105,1421]}],["靳色","jìnsè","犹吝色。舍不得的神情。",{"a":1,"w":[20105,2266]}],["鞅郁","yāngyù","犹抑郁。鞅，通“怏”。",{"a":1,"w":[14511,8084]}],["鞋襻","xiépàn","鞋帮上用以系扣的物件。",{"a":1,"w":[685,15471]}],["鞠恧","jūnǜ","谓弯着身子，低声下气。",{"a":1,"w":[10161,58046]}],["鞬弭","jiānmǐ","弓箭的代称。借指武器。",{"a":1,"w":[21370,11160]}],["鞭叱","biānchì","鞭挞呵斥。引申为驱使。",{"a":1,"w":[8162,11061]}],["鞭哨","biānshào","赶车时鸣鞭吆喝的声音。",{"a":1,"w":[8162,4821]}],["鞭拊","biānfǔ","鞭杖。古代刑罚之一种。",{"a":1,"w":[8162,11862]}],["鞮汗","dīhàn","指古代北方的少数民族。",{"a":1,"w":[16645,2403]}],["鞯勒","jiānlēi","鞍鞯与笼头。泛指马具。",{"a":1,"w":[69812,7571]}],["鞯盖","jiāngài","鞍鞯和车盖。借指车驾。",{"a":1,"w":[69812,2289]}],["鞯辔","jiānpèi","鞍鞯和辔头。借指马具。",{"a":1,"w":[69812,13007]}],["韧战","rènzhàn","坚决、持久不断的战斗。",{"a":1,"w":[9489,7438]}],["韔弓","chànggōng","谓弛弓弦将弓放入弓袋。",{"a":1,"w":[56180,8097]}],["韬弦","tāoxián","藏起弓箭。指息兵停战。",{"a":1,"w":[11243,4726]}],["韬戈","tāogē","收藏兵器。引申指息兵。",{"a":1,"w":[11243,7639]}],["韬旗","tāoqí","收藏军旗。谓息兵罢战。",{"a":1,"w":[11243,7796]}],["韬钥","tāoyào","藏起管笛。指停止奏乐。",{"a":1,"w":[11243,9086]}],["鞴扞","bèigǎn","古代射箭时用的皮臂套。",{"a":1,"w":[35204,10482]}],["韶理","sháolǐ","谓持续不断地演习奏乐。",{"a":1,"w":[10368,4609]}],["韵梅","yùnméi","宋时对植物果实的雅称。",{"a":1,"w":[8313,7563]}],["响拚","xiǎngpàn","击掌作声以示热烈响应。",{"a":1,"w":[639,11580]}],["响玉","xiǎngyù","碰击时能发声响的玉石。",{"a":1,"w":[639,2294]}],["顶冕","dǐngmiǎn","头戴冕旒。谓登上皇位。",{"a":1,"w":[2298,9800]}],["顺桓","shùnhuán","汉顺帝、汉桓帝的并称。",{"a":1,"w":[4660,10927]}],["顺欲","shùnyù","顺从自己的心欲或意志。",{"a":1,"w":[4660,7872]}],["顺泽","shùnzé","谓顺合礼乐而富有文采。",{"a":1,"w":[4660,7607]}],["顺祗","shùnzhī","指地神。祗，同“只”。",{"a":1,"w":[4660,11397]}],["顺考","shùnkǎo","谓考校古事，择善而行。",{"a":1,"w":[4660,148]}],["顺趋","shùnqū","谓顺着地势而流赴某处。",{"a":1,"w":[4660,8388]}],["顺阴","shùnyīn","谓顺随阴影；顺着暗处。",{"a":1,"w":[4660,576]}],["顺阳","shùnyáng","谓顺从阳气，顺应天道。",{"a":1,"w":[4660,7484]}],["顺默","shùnmò","谓顺从其势而沉默不语。",{"a":1,"w":[4660,8064]}],["颂子","sòngzi","偈颂。佛经中的唱颂词。",{"a":1,"w":[8972,1]}],["颂只","sòngzhǐ","用歌颂的方式祭祀地神。",{"a":1,"w":[8972,612]}],["颂论","sònglùn","颂和论两种文体的并称。",{"a":1,"w":[8972,7480]}],["顽提","wántí","指童年。顽，通“玩”。",{"a":1,"w":[8595,561]}],["顿夺","dùnduó","谓违反情理地强行断绝。",{"a":1,"w":[1370,4759]}],["顿锡","dùnxī","谓僧人住止。锡，锡杖。",{"a":1,"w":[1370,8582]}],["领峤","lǐngjiào","山峰。领，古“岭”字。",{"a":1,"w":[1361,16760]}],["领干","lǐnggàn","比喻起带头和支撑作用。",{"a":1,"w":[1361,46]}],["颉羌","jiéqiāng","古时泛指少数民族首领。",{"a":1,"w":[12843,9597]}],["颐朵","yíduǒ","犹朵颐。谓向往，羡馋。",{"a":1,"w":[9868,3538]}],["头梢","tóushāo","亦作“头稍”。\n头发。",{"a":1,"w":[509,4867]}],["头牲","tóushēng","牲畜、家禽之类的俗称。",{"a":1,"w":[509,9334]}],["颓坌","tuíbèn","颓垣断壁上堆积的尘埃。",{"a":1,"w":[8639,30425]}],["题旌","tíjīng","题书表彰。多用于死者。",{"a":1,"w":[615,9840]}],["题亲","tíqīn","犹提亲。题，通“提”。",{"a":1,"w":[615,1338]}],["题销","tíxiāo","谓上奏经皇帝批准报销。",{"a":1,"w":[615,7663]}],["题面","tímiàn","谓寓藏文章旨意的标题。",{"a":1,"w":[615,523]}],["颜法","yánfǎ","指唐颜真卿的书写技法。",{"a":1,"w":[8117,2258]}],["颜题","yántí","指古代头巾覆额面部分。",{"a":1,"w":[8117,615]}],["颛寝","zhuānqǐn","犹颛房。颛，通“专”。",{"a":1,"w":[11459,8791]}],["颠旄","diānmáo","指头发。旄，通“毛”。",{"a":1,"w":[8660,13837]}],["顾券","gùquàn","旧时指临时雇佣的工役。",{"a":1,"w":[4700,4758]}],["顾姑","gùgū","蒙古贵族妇女所戴冠名。",{"a":1,"w":[4700,8085]}],["显问","xiǎnwèn","谓明显之事而故意询问。",{"a":1,"w":[3347,113]}],["显魂","xiǎnhún","迷信谓人死后灵魂出现。",{"a":1,"w":[3347,8394]}],["风虚","fēngxū","体内虚弱，而外感风邪。",{"a":1,"w":[44,7779]}],["风骊","fēnglí","传说中疾驰如风的神马。",{"a":1,"w":[44,10672]}],["飒洒","sàsǎ","象声词。多用以状风声。",{"a":1,"w":[12545,3533]}],["飞棋","fēiqí","不拘常规的出奇的棋艺。",{"a":1,"w":[56,8184]}],["飞辩","fēibiàn","谓发挥口才，高谈阔论。",{"a":1,"w":[56,7873]}],["飞闼","fēità","高楼上的门。借指高楼。",{"a":1,"w":[56,12908]}],["飞驲","fēirì","犹飞驿。策动驿马疾驰。",{"a":1,"w":[56,68419]}],["食重","shízhòng","指装载粮食等的辎重车。",{"a":1,"w":[7466,49]}]]