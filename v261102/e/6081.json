132328,29388]}],["星驰电走","xīngchí diàn zǒu","驰奔驰；走跑。象星疾驰，如电急闪。形容极其迅速。",{"a":1,"w":[60948,12,107]}],["新昏宴尔","xīnhūn yàn'ěr","极言新婚欢乐。燕，宴，安乐的样子。同新婚燕尔”。",{"a":1,"w":[425192,205580]}],["心腹之病","xīnfù zhī bìng","指体内致命的疾病。比喻严重的隐患。同心腹之疾”。",{"a":1,"w":[13732,2254,67]}],["消声灭迹","xiāoshēng mièjì","不公开讲话，不出头露面。形容隐藏起来，不再出现。",{"a":1,"w":[34467,44881]}],["消声匿影","xiāoshēng nì yǐng","不公开讲话，不出头露面。形容隐藏起来，不再出现。",{"a":1,"w":[34467,9684,7513]}],["鸮心鹾舌","xiāoxīncuóshé","鸮鸟的心，黄鹂的鸣声。比喻居心狠毒，但说话动听。",{"a":1,"w":[11204,1279,30687,7844]}],["鸮心鹂舌","xiāoxīnlíshé","鸮鸟的心，黄鹂的鸣声。比喻居心狠毒，但说话动听。",{"a":1,"w":[11204,1279,21189,7844]}],["箫韶九成","xiāo sháo jiǔchéng","箫韶虞舜时的乐章；九成九章。指箫韶音乐奏了九章。",{"a":1,"w":[10829,10368,28265]}],["小枉大直","xiǎowǎngdàzhí","在小的方面不妨有些枉曲，在大的方面必须保持正直。",{"a":1,"w":[16,9134,4,1294]}],["小黠大痴","xiǎoxiádàchī","黠聪明而狡猾。小处狡黠精明，而大处往往糊涂失算。",{"a":1,"w":[16,14601,4,8690]}],["乡书难寄","xiāngshūnánjì","乡书家书。家书很难寄回家中。比喻与家乡消息隔绝。",{"a":1,"w":[177645,117,2358]}],["想望风采","xiǎngwàngfēngcǎi","想望仰慕。风采风度神采。非常仰慕其人，渴望一见。",{"a":1,"w":[152077,27168]}],["先号后笑","xiānhàohòuxiào","①指命运先凶后吉。②指文章或著作结尾比开头精彩。",{"a":1,"w":[89,78,43,185]}],["衔悲茹恨","xiánbēirúhèn","衔含。茹吃。胸中藏有悲痛与仇恨。亦作衔悲蓄恨”。",{"a":1,"w":[789393,8598,3477]}],["显亲扬名","xiǎnqīnyángmíng","显显赫；亲父母；扬传扬。指使双亲显耀，名声传扬。",{"a":1,"w":[179272,41881]}],["席履丰厚","xí lǚ fēnghòu","比喻祖上遗产丰富。也形容生活优裕。同席丰履厚”。",{"a":1,"w":[7836,7942,61242]}],["席薪枕块","xí xīn zhěnkuài","旧时居丧者以薪草为席，以土块为枕，以示哀苦之意。",{"a":1,"w":[7836,8398,60311]}],["系马埋轮","xìmǎmáilún","指敌人进攻时，系住马，埋车轮于地，以示固守不退。",{"a":1,"w":[132870,73673]}],["勿怠勿忘","wù dài wùwàng","勿不要；怠懈怠；忘忘记。告诫不要懈怠，不要忘记。",{"a":1,"w":[3457,9710,18742]}],["误作非为","wùzuòfēiwéi","犹言胡作非为。不顾法纪或舆论，毫无顾忌地做坏事。",{"a":1,"w":[307412,42743]}],["西赆南琛","xījìnnánchēn","谓四方皆来朝贡为西赆南琛”。赆，贡物。琛，珍宝。",{"a":1,"w":[51,21738,226517]}],["西颦东效","xīpíndōngxiào","西施捧心、东施效颦。比喻以丑陋学美好而愈显其丑。",{"a":1,"w":[51,20943,87,7590]}],["无相无作","wúxiāngwúzuò","①佛教语。指弃绝众相，不事造作。②泛指不务空言。",{"a":1,"w":[31287,196182]}],["无与比伦","wúyǔbǐlún","指事物非常完美，没有能跟它相比的。同无与伦比”。",{"a":1,"w":[118838,24350]}],["五尺童子","wǔchǐtóngzǐ","五尺古代尺短，所以以五尺指儿童的身高。泛指儿童。",{"a":1,"w":[106,2347,15853]}],["无其伦比","wúqílúnbǐ","指事物非常完美，没有能跟它相比的。同无与伦比”。",{"a":1,"w":[2255,3315,12858]}],["无恶不为","wú'èbùwéi","没有哪件坏事不干的。指干尽了坏事。同无恶不作”。",{"a":1,"w":[202241,9892]}],["无恶不造","wú'èbùzào","没有哪件坏事不干的。指干尽了坏事。同无恶不作”。",{"a":1,"w":[202241,203204]}],["唯利是求","wéi lìshì qiú","以利为着眼点。指一心只顾谋取利益。同唯利是视”。",{"a":1,"w":[8212,33556,598]}],["忘年之契","wàngniánzhīqì","即不拘年岁行辈产差异而结交的朋友。同忘年之好”。",{"a":1,"w":[50068,2254,8094]}],["亡国之器","wángguózhīqì","指象箸、玉杯之类的器皿，古代作为骄奢亡国的象征。",{"a":1,"w":[18161,2254,7410]}],["土偶蒙金","tǔ'ǒuméngjīn","在泥塑人像外面涂上金粉。比喻因袭模仿，徒有其表。",{"a":1,"w":[58346,4647,1270]}],["推心致腹","tuīxīn zhì fù","把赤诚的心交给人家。比喻真心待人。同推心置腹”。",{"a":1,"w":[113871,7666,7842]}],["同源异派","tóngyuányìpài","指起始、发端相同而趋向、终结不同。同同源异流”。",{"a":1,"w":[18666,7464,1368]}],["涕泗交下","tìsì jiāoxià","眼泪鼻涕一起流下。形容痛哭的样子。同涕泗交流”。",{"a":1,"w":[117186,156545]}],["天崩地解","tiānbēngdìjiě","比喻重大的事变。也形容巨大的声响。同天崩地坼”。",{"a":1,"w":[257796,39573]}],["天崩地坍","tiānbēngdìtān","比喻重大的事变。也形容巨大的声响。同天崩地坼”。",{"a":1,"w":[257796,10,13299]}],["天崩地陷","tiānbēngdìxiàn","比喻重大的事变。也形容巨大的声响。同天崩地坼”。",{"a":1,"w":[257796,63458]}],["太平无象","tàipíng wú xiàng","指太平盛世并无一定标志◇讽刺反动统治者粉饰升平。",{"a":1,"w":[8694,2255,7500]}],["随声吠影","suíshēng fèi yǐng","比喻一经他人唆使，便不分是非曲直，对人大加攻击。",{"a":1,"w":[110288,11211,7513]}],["随物赋形","suíwùfùxíng","指针对客观事物本身的不同形态给予形象生动的描绘。",{"a":1,"w":[1375,7412,8218,4612]}],["嵩生岳降","sōngshēngyuèjiàng","嵩指嵩山；岳高大的山；降降生。比喻大人物的出生。",{"a":1,"w":[10447,508,8765,2305]}],["宋才潘面","sòngcáipānmiàn","宋玉的才华，潘岳的容貌。比喻才华出众，仪容俊美。",{"a":1,"w":[8357,603,8658,523]}],["束蕴乞火","shùyùnqǐhuǒ","比喻求助于人。也比喻为人排难解纷。同束缊请火”。",{"a":1,"w":[1407,9347,9371,1284]}]]