3]}],["轮笔","lúnbǐ","谓轮流主管考试事宜。",{"a":1,"w":[2280,619]}],["轮輮","lúnróu","名车牙。车轮的外框。",{"a":1,"w":[2280,59230]}],["轮头","lúntóu","一种使弄枪棒的套数。",{"a":1,"w":[2280,509]}],["輮蹈","róudǎo","践踏。輮，通“蹂”。",{"a":1,"w":[59230,8509]}],["輴轩","chūnxuān","行驶在泥路上的车子。",{"a":1,"w":[117954,8869]}],["輷鞫","hōngjū","众车行进时的隆隆声。",{"a":1,"w":[86531,10558]}],["输场","shūchǎng","唐代转运物资的货场。",{"a":1,"w":[1352,544]}],["转目","zhuǎnmù","转眼。形容时间短促。",{"a":1,"w":[1293,7465]}],["轿帏","jiàowéi","围在轿子四周的帷幔。",{"a":1,"w":[10040,13815]}],["轿幰","jiàoxiǎn","围在轿子四周的帷幔。",{"a":1,"w":[10040,55854]}],["轿行","jiàoxíng","出租轿子的营业机构。",{"a":1,"w":[10040,8]}],["轰炮","hōngpào","开炮。炮，同“炮”。",{"a":1,"w":[8041,4644]}],["轰隐","hōngyǐn","象声词。形容众车声。",{"a":1,"w":[8041,7652]}],["轠轠","léiléi","象声词。形容车马声。",{"a":1}],["轹蹙","lìcù","欺凌。蹙，同“蹴”。",{"a":1,"w":[15302,10026]}],["辜雠","gūchóu","罪恶昭彰，人所同仇。",{"a":1,"w":[9843,9496]}],["辟旋","pìxuán","犹便旋。盘桓；徘徊。",{"a":1,"w":[8072,7532]}],["辟盟","pìméng","谓开诚心，歃血立盟。",{"a":1,"w":[8072,7953]}],["辟若","pìruò","譬如。辟，通“譬”。",{"a":1,"w":[8072,4652]}],["办给","bàngěi","谓办事迅捷，不拖沓。",{"a":1,"w":[610,112]}],["辨断","biànduàn","分辨裁断；分辨判断。",{"a":1,"w":[8004,1335]}],["辞博","cíbó","富于文才，知识广博。",{"a":1,"w":[7757,7502]}],["辞穷","cíqióng","谓因理亏而无言可答。",{"a":1,"w":[7757,2372]}],["辞谒","cíyè","因辞别而谒见，拜别。",{"a":1,"w":[7757,9577]}],["辩利","biànlì","言辞流利，能言善辩。",{"a":1,"w":[7873,4606]}],["辩动","biàndòng","以雄辩的口才折服人。",{"a":1,"w":[7873,6]}],["辩黠","biànxiá","能言善辩，灵巧聪明。",{"a":1,"w":[7873,14601]}],["农校","nóngxiào","农业专科学校的简称。",{"a":1,"w":[7612,7600]}],["农歌","nónggē","山歌，田夫野老之歌。",{"a":1,"w":[7612,208]}],["迂步","yūbù","敬词。犹枉驾，屈驾。",{"a":1,"w":[9628,1337]}],["迎祀","yíngsì","谓摆设香案迎神而祭。",{"a":1,"w":[8235,9915]}],["迎黑","yínghēi","方言。天将黑，傍晚。",{"a":1,"w":[8235,549]}],["近佳","jìnjiā","犹近好。常用于书信。",{"a":1,"w":[574,8154]}],["近弼","jìnbì","接近帝王的辅弼之臣。",{"a":1,"w":[574,10394]}],["返掌","fǎnzhǎng","翻转手掌。极言容易。",{"a":1,"w":[8365,7833]}],["迫唶","pòzé","狭窄。唶，通“窄”。",{"a":1,"w":[8059,26649]}],["迫究","pòjiū","紧逼追问；严厉追究。",{"a":1,"w":[8059,7647]}],["迭暴","diébào","眼睛圆睁凸出的样子。",{"a":1,"w":[