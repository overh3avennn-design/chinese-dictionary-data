9,8726]}],["诗穷","shīqióng","指文人遭际坎坷，生活贫困。",{"a":1,"w":[2369,2372]}],["诡士","guǐshì","诡奇之士。指能施幻术的人。",{"a":1,"w":[8845,7542]}],["诠品","quánpǐn","评论；品评。诠，通“铨”。",{"a":1,"w":[15752,3321]}],["诠藻","quánzǎo","品评，评量。诠，通“铨”。",{"a":1,"w":[15752,8076]}],["诠补","quánbǔ","编次和补齐。诠，通“铨”。",{"a":1,"w":[15752,1363]}],["该歪","gāiwāi","方言。好凶，带有惊叹之意。",{"a":1,"w":[672,3464]}],["诛事","zhūshì","对行为或所做的事加以谴责。",{"a":1,"w":[9317,33]}],["诮呵","qiàohē","责备；呵斥。如：诮呵之词。",{"a":1,"w":[20147,4926]}],["诚贯","chéngguàn","诚实的习惯。贯，同“惯”。",{"a":1,"w":[8307,8062]}],["误书","wùshū","文字上有错误的书籍；误字。",{"a":1,"w":[4712,81]}],["诰券","gàoquàn","皇帝赐封臣下所颁发的文书。",{"a":1,"w":[13565,4758]}],["诰书","gàoshū","皇帝诰封臣下所颁发的文书。",{"a":1,"w":[13565,81]}],["诰章","gàozhāng","皇帝给臣下封官授爵的诏令。",{"a":1,"w":[13565,4661]}],["说论","shuōlùn","1) 学说。\n2) 辩论。",{"a":1,"w":[68,7480]}],["谁们","shuímen","方言。疑问代词。哪一些人。",{"a":1,"w":[216,190]}],["调顺","diàoshùn","1) 理顺。\n2) 和顺。",{"a":1,"w":[1290,4660]}],["谄冒","chǎnmào","谄谀、嫉妒。冒，通“媢”。",{"a":1,"w":[10747,3400]}],["诿諈","wěizhuì","1) 烦重。\n2) 委托。",{"a":1,"w":[15758,172400]}],["请实","qǐngshí","实情；真相。请，通“情”。",{"a":1,"w":[160,7457]}],["诤心","zhèngxīn","争高下之心。诤，通“争”。",{"a":1,"w":[18128,1279]}],["诤竞","zhèngjìng","竞争；争论。诤，通“争”。",{"a":1,"w":[18128,8144]}],["诤薮","zhèngsǒu","争讼的渊薮。诤，通“争”。",{"a":1,"w":[18128,10471]}],["谅实","liàngshí","1) 真诚。\n2) 料定。",{"a":1,"w":[9547,7457]}],["论奏","lùnzòu","指官吏上奏，论述自己意见。",{"a":1,"w":[7480,4777]}],["论酬","lùnchóu","1) 答谢。\n2) 议论。",{"a":1,"w":[7480,8667]}],["谘式","zīshì","谓征询如何才合乎礼仪规范。",{"a":1,"w":[14458,3311]}],["谘承","zīchéng","谓与人商议并接受他人意见。",{"a":1,"w":[14458,7576]}],["讽动","fěngdòng","用暗示的言行来鼓动和影响。",{"a":1,"w":[9928,6]}],["诸番","zhūfān","旧时指西北边境各少数民族。",{"a":1,"w":[7881,4735]}],["诸谢","zhūxiè","指晋谢安、谢石、谢玄等人。",{"a":1,"w":[7881,7570]}],["诸贲","zhūbēn","古代勇士专诸和孟贲的并称。",{"a":1,"w":[7881,9392]}],["谋宪","móuxiàn","楷模，榜样。谋，通“模”。",{"a":1,"w":[8000,8343]}],["谋犹","móuyóu","计谋，谋略。犹，通“猷”。",{"a":1,"w":[8000,8070]}],["谦志","qiānzhì","谦让之志；不敢承当的心意。",{"a":1,"w":[9618,7626]}],["谦泰","qiāntài","《谦》《泰》均《易》卦名。",{"a":1,"w":[9618,