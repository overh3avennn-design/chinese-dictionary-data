}],["宫吕","gōnglǚ","宫调与律吕。泛指音调声律。",{"a":1,"w":[4679,8345]}],["宫帷","gōngwéi","宫殿里的围幕。亦借指王宫。",{"a":1,"w":[4679,11988]}],["宫庸","gōngyōng","宫墉。禁城的墙垣。指皇室。",{"a":1,"w":[4679,8352]}],["宫詹","gōngzhān","即太子詹事。属东宫詹事府。",{"a":1,"w":[4679,9415]}],["宫议","gōngyì","宫廷内部对国家大事的讨论。",{"a":1,"w":[4679,7521]}],["宫隅","gōngyú","谓建于宫墙四角的高大围屏。",{"a":1,"w":[4679,9362]}],["宫靴","gōngxuē","古时大臣上朝时所穿的靴子。",{"a":1,"w":[4679,9886]}],["宫点","gōngdiǎn","宫漏的水滴。藉以表示时间。",{"a":1,"w":[4679,64]}],["宫龙","gōnglóng","道教五行神之一，人面龙身。",{"a":1,"w":[4679,1308]}],["害胜","hàishèng","犹嫉贤。谗害胜过自己的人。",{"a":1,"w":[3353,1373]}],["家姬","jiājī","私家蓄养的歌伎舞女或侍妾。",{"a":1,"w":[28,8824]}],["宸历","chénlì","旧指承天应运而在位的帝王。",{"a":1,"w":[11471,7643]}],["宿系","sùxì","指长期关押不予判决的囚犯。",{"a":1,"w":[7825,1277]}],["宿责","sùzé","宿债，旧债。责，同“债”。",{"a":1,"w":[7825,7765]}],["寂莫","jìmò","同“寂寞”。\n沉寂；无声。",{"a":1,"w":[9244,7446]}],["寄贶","jìkuàng","对亲友托人致送礼品的敬词。",{"a":1,"w":[2358,17788]}],["富族","fùzú","拥有大量资财的家族；富家。",{"a":1,"w":[1388,4632]}],["寒姿","hánzī","犹言鄙陋之姿，孤寒的姿色。",{"a":1,"w":[7631,8460]}],["察书","cháshū","谓校正勘定他人书写的文字。",{"a":1,"w":[7567,81]}],["寡兄","guǎxiōng","少有的兄长。言其贤明过人。",{"a":1,"w":[8272,8404]}],["寡嗛","guǎqiǎn","缺乏，不足，嗛，同“歉”。",{"a":1,"w":[8272,15718]}],["寡智","guǎzhì","亦作“寡知”。\n缺少智慧。",{"a":1,"w":[8272,7798]}],["寡营","guǎyíng","欲望少，不为个人营谋打算。",{"a":1,"w":[8272,7572]}],["寝寝","qǐnqǐn","渐渐，逐渐。寝，通“寖”。",{"a":1,"w":[8791]}],["审编","shěnbiān","谓审核在编制的人丁赋役等。",{"a":1,"w":[7781,2326]}],["写像","xiěxiàng","1) 画像。\n2) 铸像。",{"a":1,"w":[172,589]}],["写目","xiěmù","谓尽目力之所及，纵情观览。",{"a":1,"w":[172,7465]}],["寮亮","liáoliàng","谓声音响亮。寮，通“嘹”。",{"a":1,"w":[10125,641]}],["宝倌","bǎoguān","旧时宝局中开宝和出宝的人。",{"a":1,"w":[2313,15658]}],["宝堑","bǎoqiàn","指佛教圣地或寺庙周围的沟。",{"a":1,"w":[2313,10204]}],["宝枕","bǎozhěn","指三国魏甄后的玉镂金带枕。",{"a":1,"w":[2313,8523]}],["宝母","bǎomǔ","传说能引聚明珠宝贝的宝石。",{"a":1,"w":[2313,4637]}],["宝笥","bǎosì","贮藏重要或珍贵物品的箱箧。",{"a":1,"w":[2313,23512]}],["宝络","bǎoluò","即璎珞。用珠玉串成的颈饰。",{"a":1,"w":[2313,7837]}],["宝纛","bǎodào","皇帝出行乘舆上所建的旗帜。",{"a":1,"w":[2313,20021]}],["宝衢","bǎoqú","通道的美称。亦指光明大道。",{"a":1,"w":[2313,12917]}],["宝谕","bǎoyù","旧时对居高位者指示的尊称。",{"a":1,"w":[2313,9439]}],["宝录","bǎolù","1) 珍藏。\n2) 帝位。",{"a":1,"w":[2313,1380]}],["封圭","fēngguī","诸侯始受封时天子所赐之圭。",{"a":1,"w":[600,9153]}],["封峦","fēngluán","1) 封禅。\n2) 观名。",{"a":1,"w":[600,13974]}],["封留","fēngliú","原指汉高祖封张良为留侯事。",{"a":1,"w":[600,590]}],["尊阁","zūngé","对人妻子的敬称。阁，内室。",{"a":1,"w":[7922,8208]}],["寻尝","xúncháng","1) 平时。\n2) 平常。",{"a":1,"w":[7855,2455]}],["小牲","xiǎoshēng","用作祭祀牺牲的羊、犬、豕。",{"a":1,"w":[16,9334]}],["小绥","xiǎosuí","古代诸侯田猎时所立的旗旌。",{"a":1,"w":[16,8836]}],["少色","shǎosè","少年的气色。喻生气或豪情。",{"a":1,"w":[126,2266]}],["尺薪","chǐxīn","长一尺的柴火，言其量极少。",{"a":1,"w":[2347,8398]}],["尺表","chǐbiǎo","古代用以测日影的一种仪器。",{"a":1,"w":[2347,536]}],["尾腔","wěiqiāng","语末高昂或故意拖长的音调。",{"a":1,"w":[7474,8012]}],["尸图","shītú","检验尸体受伤部位的报告书。",{"a":1,"w":[7967,1301]}],["屏围","píngwéi","I\n屏风。\nII\n犹围绕。",{"a":1,"w":[7852,1403]}],["屏言","píngyán","辨言，巧言。屏，通“辨”。",{"a":1,"w":[7852,7440]}],["层碧","céngbì","层层青色。亦指重叠的青山。",{"a":1,"w":[575,8659]}],["属词","shǔcí","谓连缀字句为文章。指写作。",{"a":1,"w":[1268,596]}],["山笼","shānlóng","盛茶叶果品之类山货的竹器。",{"a":1,"w":[45,7956]}],["山额","shān'é","1) 山顶。\n2) 额头。",{"a":1,"w":[45,7720]}],["岳阡","yuèqiān","亦作“岳阡”。\n山上墓道。",{"a":1,"w":[8765,12395]}],["峨嶪","éyè","高大貌。亦以形容文笔挺拔。",{"a":1,"w":[9923,127550]}],["峰岠","fēngjù","犹岳峙。比喻人品高洁刚正。",{"a":1,"w":[8122,48502]}],["峻命","jùnmìng","大命。指天帝或帝王的命令。",{"a":1,"w":[9365,4622]}],["峻烈","jùnliè","1) 猛烈。\n2) 严厉。",{"a":1,"w":[9365,7947]}],["崇伯","chóngbó","夏禹父鲧。因封于崇，故称。",{"a":1,"w":[8311,7608]}],["崩沦","bēnglún","1) 塌毁。\n2) 衰落。",{"a":1,"w":[8619,9545]}],["崩迫","bēngpò","1) 迫切。\n2) 奔忙。",{"a":1,"w":[8619,8059]}],["崭崖","zhǎnyá","陡峻的山崖。比喻性情高傲。",{"a":1,"w":[19417,8942]}],["崭凿","zhǎnzáo","开凿；挖掘。崭，通“錾”。",{"a":1,"w":[19417,8504]}],["峤外","jiàowài","即岭外，指五岭以南的地区。",{"a":1,"w":[16760,36]}],["峣阙","yáoquē","指皇宫大门。因高大，故称。",{"a":1,"w":[18882,8773]}],["岭徼","lǐngjiǎo","指五岭以南地区。徼，边界。",{"a":1,"w":[8515,10328]}],["岩岫","yánxiù","1) 山洞。\n2) 峰峦。",{"a":1,"w":[7558,21492]}],["岩龉","yányǔ","亦作“岩龉”。\n险峻不齐。",{"a":1,"w":[7558,47284]}],["巡尉","xúnwèi","官名。负责巡捕盗贼的县尉。",{"a":1,"w":[7981,9085]}],["巡远","xúnyuǎn","唐代名臣张巡、许远的并称。",{"a":1,"w":[7981,103]}],["巨璞","jùpú","大块的璞玉。形容石质之美。",{"a":1,"w":[7862,11839]}],["巨丽","jùlì","极其美好的事物；极其美好。",{"a":1,"w":[7862,7634]}],["帔子","pèizi","古代妇女披在肩背上的服饰。",{"a":1,"w":[25519,1]}],["帖头","tiētóu","差役。旧时供官府差遣的人。",{"a":1,"w":[8250,509]}],["帝孙","dìsūn","星名。即织女星。一称天孙。",{"a":1,"w":[7840,7936]}],["帝学","dìxué","即国学。国家所设立的学校。",{"a":1,"w":[7840,13]}],["帝狩","dìshòu","谓天子巡视诸侯所守的地方。",{"a":1,"w":[7840,11242]}],["席荐","xíjiàn","席子和草荐。亦泛指铺垫物。",{"a":1,"w":[7836,8795]}],["帐词","zhàngcí","即幛词。写在贺幛上的颂词。",{"a":1,"w":[8011,596]}],["带冕","dàimiǎn","大带和冠冕。借指高官尊位。",{"a":1,"w":[542,9800]}],["常恒","chánghéng","1) 永久。\n2) 一般。",{"a":1,"w":[99,7973]}],["幕梁","mùliáng","西夏一种以木为架的小帐幕。",{"a":1,"w":[7877,7890]}],["幡戟","fānjǐ","旌旗和棨戟。泛指前驱仪仗。",{"a":1,"w":[10797,8766]}],["平宽","píngkuān","平和宽容。指人的性情态度。",{"a":1,"w":[525,2323]}],["年物","niánwù","农历新年用以馈赠亲友之物。",{"a":1,"w":[92,7412]}],["干佐","gànzuǒ","谓主管某项事务的辅佐官员。",{"a":1,"w":[46,7955]}],["干僮","gàntóng","南北朝时为官吏服役的僮仆。",{"a":1,"w":[46,12655]}],["幻戏","huànxì","1) 魔术。\n2) 变化。",{"a":1,"w":[8567,3341]}],["幽宗","yōuzōng","犹玄宗。指佛道的深奥义理。",{"a":1,"w":[8098,7624]}],["幽揵","yōuqián","谓深奥的法门。喻佛教经典。",{"a":1,"w":[8098,26549]}],["幽绪","yōuxù","郁结于心的深切连绵的思绪。",{"a":1,"w":[8098,8338]}],["幽鉴","yōujiàn","犹玄鉴。喻微妙高深的见解。",{"a":1,"w":[8098,8039]}],["几务","jǐwù","机要的事务。多指军国大事。",{"a":1,"w":[136,7448]}],["几诃","jǐhē","呵察，查问。几，通“讥”。",{"a":1,"w":[136,10266]}],["序累","xùlèi","谓分别高下排列。累，犹序。",{"a":1,"w":[7598,173]}],["底兵","dǐbīng","谓磨砺兵器。底，通“砥”。",{"a":1,"w":[2290,2282]}],["府廪","fǔlǐn","官府供应的粮食。廪，廪粟。",{"a":1,"w":[7706,9825]}],["庭砌","tíngqì","1) 庭阶。\n2) 庭院。",{"a":1,"w":[7760,9902]}],["庶氏","shùshì","I\n犹他氏。\nII\n官名。",{"a":1,"w":[8722,7429]}],["庶隶","shùlì","庶人和隶人。泛指操贱业者。",{"a":1,"w":[8722,8847]}],["康涂","kāngtú","犹坦途，大道。指生死之道。",{"a":1,"w":[7742,7866]}],["康靖","kāngjìng","1) 安宁。\n2) 安康。",{"a":1,"w":[7742,9378]}],["庸浅","yōngqiǎn","平庸浅陋。常用作自谦之词。",{"a":1,"w":[8352,2400]}],["庸驽","yōngnú","平庸无能。常用作自谦之词。",{"a":1,"w":[8352,14621]}],["厩尹","jiùyǐn","1) 官名。\n2) 复姓。",{"a":1,"w":[28967,10344]}],["厩律","jiùlǜ","有关牛马管理、税收的律令。",{"a":1,"w":[28967,7544]}],["廉乐","liánlè","战国名将廉颇和乐毅的并称。",{"a":1,"w":[8138,1340]}],["廉考","liánkǎo","查办，审理。廉，通“覝”。",{"a":1,"w":[8138,148]}],["廉视","liánshì","察看，检查。廉，通“覝”。",{"a":1,"w":[8138,7494]}],["庙市","miàoshì","设在寺庙内或其附近的集市。",{"a":1,"w":[8514,555]}],["庙战","miàozhàn","朝廷对于战事的筹划和决策。",{"a":1,"w":[8514,7438]}],["庙攻","miàogōng","用朝廷制订的策略制胜敌人。",{"a":1,"w":[8514,7761]}],["广居","guǎngjū","宽大的住所。儒家用以喻仁。",{"a":1,"w":[3324,7611]}],["广青","guǎngqīng","汉代名将李广、卫青的并称。",{"a":1,"w":[3324,3320]}],["廪增","lǐnzēng","廪膳生员与增广生员的并称。",{"a":1,"w":[9825,3357]}],["廪帑","lǐntǎng","指仓储的粮食和库存的金帛。",{"a":1,"w":[9825,17732]}],["建茶","jiànchá","福建省建溪一带所产的名茶。",{"a":1,"w":[1345,157]}],["弄童","nòngtóng","娈童。指被侮弄的美貌男童。",{"a":1,"w":[630,7929]}],["弄颦","nòngpín","故作愁容以媚人。颦，皱眉。",{"a":1,"w":[630,20943]}],["弈赫","yìhè","盛大显赫貌。弈，通“奕”。",{"a":1,"w":[13100,7566]}],["弊恶","bì'è","1) 恶劣。\n2) 破旧。",{"a":1,"w":[8552,7620]}],["弓弹","gōngdàn","以弹弓发射弹丸的一种游戏。",{"a":1,"w":[8097,3318]}],["吊恶","diào'è","亦作“吊恶”。\n引起恶心。",{"a":1,"w":[4693,7620]}],["吊奠","diàodiàn","亦作“吊奠”。\n吊唁祭奠。",{"a":1,"w":[4693,9667]}],["吊猴","diàohóu","亦作“吊猴”。\n掉唇弄舌。",{"a":1,"w":[4693,3417]}],["弟门","dìmén","古代天子宫的南门。即雉门。",{"a":1,"w":[7917,53]}],["弦徽","xiánhuī","琴弦与琴徽。借指丝弦乐器。",{"a":1,"w":[4726,9151]}],["弭棹","mǐzhào","亦作“弭櫂”。\n停泊船只。",{"a":1,"w":[11160,12826]}],["弱腕","ruòwàn","柔细的手腕。指女子的手腕。",{"a":1,"w":[2376,9173]}],["弥侈","míchǐ","靡侈，奢侈。弥，通“靡”。",{"a":1,"w":[8175,9324]}],["形援","xíngyuán","指军事布局上的声援、呼应。",{"a":1,"w":[4612,7930]}],["征两","zhēngliǎng","即征车。两，“辆”的古字。",{"a":1,"w":[7581,96]}],["待禄","dàilù","持禄，守禄。待，通“持”。",{"a":1,"w":[3350,8602]}],["待亏","dàikuī","亏待，待人不公平或不尽心。",{"a":1,"w":[3350,3415]}],["徇恩","xùn'ēn","舍身以报恩。徇，通“殉”。",{"a":1,"w":[9647,7704]}],["徇书","xùnshū","谓拚命读书。徇，通“殉”。",{"a":1,"w":[9647,81]}],["径衢","jìngqú","小道与歧路。比喻头绪繁多。",{"a":1,"w":[7769,12917]}],["得衷","dézhōng","同“得中”。\n适当，适宜。",{"a":1,"w":[520,9229]}],["从目","cóngmù","竖着眼睛。形容凶恶的样子。",{"a":1,"w":[124,7465]}],["德道","dédào","得道，获道。德，通“得”。",{"a":1,"w":[7416,511]}],["彻官","chèguān","犹达官。姓名达于天子之官。",{"a":1,"w":[8591,2293]}],["彻重","chèzhòng","谓撤去丧礼中暂代神主之物。",{"a":1,"w":[8591,49]}],["徼伺","jiǎocì","谓窥伺希冀。徼，通“侥”。",{"a":1,"w":[10328,8912]}],["徼绕","jiǎorào","缠绕；错综。徼，通“缴”。",{"a":1,"w":[10328,3443]}],["忍许","rěnxǔ","认可，认为。忍，通“认”。",{"a":1,"w":[3408,7709]}],["忤嫚","wǔmān","亦作“忤慢”。\n违抗怠慢。",{"a":1,"w":[12959,14774]}],["念思","niànsī","1) 怀念。\n2) 考虑。",{"a":1,"w":[1422,7586]}],["怒恼","nùnǎo","1) 恼怒。\n2) 激怒。",{"a":1,"w":[8124,9662]}],["急晷","jíguǐ","急速的日影。喻飞驰的时光。",{"a":1,"w":[569,14972]}],["怪哉","guàizāi","古代传说出于狱中的昆虫名。",{"a":1,"w":[2379,8849]}],["恒旸","héngyáng","亦作“恒阳”。\n久晴不雨。",{"a":1,"w":[7973,25682]}],["恐栗","kǒnglì","亦作“恐栗”。\n恐惧战栗。",{"a":1,"w":[7807,8177]}],["恢广","huīguǎng","1) 扩展。\n2) 宏富。",{"a":1,"w":[8717,3324]}],["恩借","ēnjiè","谓帝、后给予的恩惠和宽容。",{"a":1,"w":[7704,650]}],["恩异","ēnyì","帝王对臣子特别优待的规定。",{"a":1,"w":[7704,7464]}],["息响","xīxiǎng","呼吸的声音。喻细微的声响。",{"a":1,"w":[7510,639]}],["悄戚","qiāoqī","亦作“悄戚”。\n悲痛忧伤。",{"a":1,"w":[11036,9077]}],["悖缪","bèimóu","亦作“悖谬”。\n背理荒谬。",{"a":1,"w":[9088,9670]}],["悲吟","bēiyín","1) 哀叹。\n2) 悲歌。",{"a":1,"w":[8341,8955]}],["惑蔽","huòbì","1) 糊涂。\n2) 蒙蔽。",{"a":1,"w":[8601,8083]}],["惛乱","hūnluàn","1) 昏乱。\n2) 纷乱。",{"a":1,"w":[15144,1360]}],["惛愦","hūnkuì","糊涂；不明事理；迷糊不清。",{"a":1,"w":[15144,27364]}]]