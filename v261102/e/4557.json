[["长家","zhǎngjiā","1) 一家之长。\n2) 管家。",{"a":1,"w":[515,28]}],["长游","zhǎngyóu","什长和游宗。谓乡中之行政长官。",{"a":1,"w":[515,1317]}],["长艾","zhǎng'ài","1) 老年。\n2) 指老年人。",{"a":1,"w":[515,7682]}],["长灵","zhǎnglíng","1) 谓神思。\n2) 指神灵。",{"a":1,"w":[515,7588]}],["门燎","ménliáo","古代竖立于宫门、庙门外的火炬。",{"a":1,"w":[53,9349]}],["闳豁","hónghuō","1) 宽敞。\n2) 宽宏豁达。",{"a":1,"w":[12278,8714]}],["闰运","rùnyùn","犹乱世。旧指运数不正常的时世。",{"a":1,"w":[11427,3313]}],["闲伴","xiánbàn","亦作“闲伴”。\n清闲中的伙伴。",{"a":1,"w":[3381,8391]}],["闲唠","xiánláo","亦作“闲唠”。\n方言。犹闲谈。",{"a":1,"w":[3381,11669]}],["闲暮","xiánmù","亦作“闲暮”。\n指寂寞的晚年。",{"a":1,"w":[3381,8841]}],["闲朝","xiáncháo","春秋时指诸侯三年朝见天子一次。",{"a":1,"w":[3381,1357]}],["闲瞧","xiánqiáo","亦作“闲瞧”。\n轻视；瞧不起。",{"a":1,"w":[3381,3618]}],["闲簉","xiánzào","亦作“间簉”。\n犹言位居副佐。",{"a":1,"w":[3381,42310]}],["闲余","xiányú","亦作“闲余”。\n指空闲的时间。",{"a":1,"w":[3381,7597]}],["闵悼","mǐndào","1) 怜恤伤悼。\n2) 忧伤。",{"a":1,"w":[10057,11178]}],["阁浅","géqiǎn","船只进入水浅的地方，不能行驶。",{"a":1,"w":[8208,2400]}],["闺薄","guībáo","闺房的帘幕。借指妇女的私生活。",{"a":1,"w":[9497,2319]}],["闺阈","guīyù","1) 指家庭。\n2) 指内宫。",{"a":1,"w":[9497,10455]}],["阒如","qùrú","1) 空虚貌。\n2) 寂静貌。",{"a":1,"w":[56575,4614]}],["关谘","guānzī","1) 征询。\n2) 禀报请示。",{"a":1,"w":[65,14458]}],["阐济","chǎnjì","谓为国创立并完成(治国大道)。",{"a":1,"w":[11420,7522]}],["防逻","fángluó","防卫巡逻。亦指防守巡逻之士卒。",{"a":1,"w":[1302,8262]}],["阿屯","ātún","[英atom]“原子”的旧译。",{"a":1,"w":[7414,8563]}],["阿谤","ābàng","大声喝叱和毁谤。阿，通“诃”。",{"a":1,"w":[7414,9810]}],["附见","fùjiàn","谓见于正本的附录或正传的附传。",{"a":1,"w":[7718,76]}],["陋弱","lòuruò","谓文章立论见识浅陋，音调柔靡。",{"a":1,"w":[9064,2376]}],["阵士","zhènshì","亦作“陈士”。\n谓临阵之将士。",{"a":1,"w":[2333,7542]}],["除差","chúchà","除去疾病，病愈。差，通“瘥”。",{"a":1,"w":[4635,121]}],["除暗","chú'àn","去除不可告人之心; 去除私心。",{"a":1,"w":[4635,2340]}],["阴册","yīncè","寺庙中记录各家死者姓名的簿册。",{"a":1,"w":[576,3413]}],["阴怪","yīnguài","1) 指月亮。\n2) 犹妖怪。",{"a":1,"w":[576,2379]}],["阴敝","yīnbì","谓不受阳光照射。敝，通“蔽”。",{"a":1,"w":[576,8875]}],["阴淫","yīnyín","1) 阴气过分。\n2) 淫靡。",{"a":1,"w":[576,7901]}],["阴疾","yīnjí","1) 暗中疾恨。\n2) 疝气。",{"a":1,"w":[576,7794]}],["阴马","yīnmǎ","汉时方士阴长生和马明生的并称。",{"a":1,"w":[576,1273]}],["阴鸟","yīnniǎo","鸣阴之鸟。因其将雨则鸣，故称。",{"a":1,"w":[576,581]}],["陈俎","chénzǔ","陈设俎豆。意谓会盟，止息干戈。",{"a":1,"w":[7893,12968]}],["陆皮","lùpí","晚唐诗人陆龟蒙和皮日休的并称。",{"a":1,"w":[7605,1291]}],["阳主","yángzhǔ","神名。古代主宰宇宙的八神之一。",{"a":1,"w":[7484,7425]}],["阳魂","yánghún","日的别称。亦指日的魂魄、精气。",{"a":1,"w":[7484,8394]}],["隅团","yútuán","宋代的地方武装。用以地方自卫。",{"a":1,"w":[9362,1336]}],["隅镇","yúzhèn","边隅要镇。亦指戍守边镇的武官。",{"a":1,"w":[9362,4701]}],["隆密","lóngmì","1) 深厚亲密。\n2) 茂密。",{"a":1,"w":[7876,2299]}],["障恼","zhàngnǎo","亦作“障脑”。\n佛教语。烦恼。",{"a":1,"w":[7656,9662]}],["障隧","zhàngsuì","边塞上的烽火台。隧，通“燧”。",{"a":1,"w":[7656,8814]}],["随鸾","suíluán","臣下随皇帝出行。鸾，通“銮”。",{"a":1,"w":[1375,9528]}],["隐官","yǐnguān","专说隐语廋辞以供皇帝取乐的人。",{"a":1,"w":[7652,2293]}],["隐讽","yǐnfěng","用暗示性的语言加以劝告或指责。",{"a":1,"w":[7652,9928]}],["隐过","yǐnguò","不为人知的过失，不明显的过失。",{"a":1,"w":[7652,25]}],["雁塞","yànsāi","1) 山名\n2) 泛指北方边塞",{"a":1,"w":[9300,4630]}],["雄鸠","xióngjiū","1) 即鹘鸠。\n2) 即布谷。",{"a":1,"w":[7818,8570]}],["雅合","yǎhé","1) 正好相合。\n2) 雅会。",{"a":1,"w":[7788,1269]}],["雅契","yǎqì","1) 十分契合。\n2) 交情。",{"a":1,"w":[7788,8094]}],["雅然","yǎrán","1) 严正貌。\n2) 犹公然。",{"a":1,"w":[7788,7451]}],["雅音","yǎyīn","正音，有益于风教的诗歌和音乐。",{"a":1,"w":[7788,7498]}],["雉随","zhìsuí","指雉随晋孝子萧芝上朝、下朝事。",{"a":1,"w":[9135,1375]}],["雒棠","luòtáng","山名。古代传说是太阳所入之山。",{"a":1,"w":[19031,9234]}],["雕搜","diāosōu","谓刻意修饰文辞。搜，通“锼”。",{"a":1,"w":[8192,3416]}],["雕辇","diāoniǎn","饰有浮雕、彩绘的车；华美的车。",{"a":1,"w":[8192,10459]}],["双甄","shuāngzhēn","古代打猎或作战阵形的左右两翼。",{"a":1,"w":[1309,10660]}],["雚泽","guànzé","地名。泽中芦苇丛生，因以为名。",{"a":1,"w":[130388,7607]}],["杂治","zázhì","1) 会审。\n2) 综合治理。",{"a":1,"w":[4680,2283]}],["杂览","zálǎn","封建社会指儒家经典以外的著作。",{"a":1,"w":[4680,8265]}],["鸡园","jīyuán","指鸡头摩寺。佛教传说中的圣地。",{"a":1,"w":[578,4715]}],["离玦","líjué","雕有螭形的玉玦。离，通“螭”。",{"a":1,"w":[543,20683]}],["离珂","líkē","指离人乘的马匹。珂，马勒饰品。",{"a":1,"w":[543,14944]}],["离索","lísuǒ","1) 离群索居。\n2) 萧索。",{"a":1,"w":[543,7470]}],["雨冻","yǔdòng","1) 指冰雹。\n2) 指雪花。",{"a":1,"w":[159,3397]}],["雨足","yǔzú","1) 雨量充足。\n2) 雨脚。",{"a":1,"w":[159,4625]}],["雪粉","xuěfěn","1) 细雪。\n2) 白色粉末。",{"a":1,"w":[616,7613]}],["雪台","xuětái","古台名。故址在今河南开封东南。",{"a":1,"w":[616,1306]}],["雪除","xuěchú","1) 清除。\n2) 昭雪赦免。",{"a":1,"w":[616,4635]}],["云娥","yún'é","1) 仙女。\n2) 泛指美女。",{"a":1,"w":[554,10163]}],["云客","yúnkè","云游四方的人。指隐者或出家人。",{"a":1,"w":[554,7618]}],["云浪","yúnlàng","1) 如云之浪。\n2) 亭名。",{"a":1,"w":[554,7832]}],["云軿","yúnpíng","神仙所乘之车。以云为之，故云。",{"a":1,"w":[554,36094]}],["云阿","yún'ā","云深处。指高山之上，深山之中。",{"a":1,"w":[554,7414]}],["云腾","yúnténg","如云腾涌。比喻崛起，奋发有为。",{"a":1,"w":[554,7985]}],["霆策","tíngcè","疾雷闪电。策，马鞭。比喻闪电。",{"a":1,"w":[13634,7673]}],["霜凌","shuānglíng","1) 寒霜侵凌。\n2) 冰凌。",{"a":1,"w":[8258,8382]}],["霜女","shuāngnǚ","即青女。神话传说中的霜雪之神。",{"a":1,"w":[8258,98]}],["霜居","shuāngjū","孀居。夫死守寡。霜，通“孀”。",{"a":1,"w":[8258,7611]}],["霜橘","shuāngjú","即橘子。因其经霜后成熟，故称。",{"a":1,"w":[8258,8816]}],["霜菅","shuāngjiān","霜后枯萎的菅草。用以比喻白发。",{"a":1,"w":[8258,13249]}],["霜鈇","shuāngfū","白亮锋利的斧钺。喻严明的刑法。",{"a":1,"w":[8258,28077]}],["霞影","xiáyǐng","1) 云霞之影。\n2) 霞光。",{"a":1,"w":[4805,7513]}],["霞舒","xiáshū","如彩霞舒展。形容事物轻柔美艳。",{"a":1,"w":[4805,7870]}],["雾乱","wùluàn","I\n纷乱貌。\nII\n黑暗纷乱。",{"a":1,"w":[3421,1360]}],["露柱","lùzhù","指旌表门第立柱柱端的龙形部分。",{"a":1,"w":[4674,7685]}],["灵奥","líng'ào","1) 神奇奥妙。\n2) 幽深。",{"a":1,"w":[7588,7481]}],["灵极","língjí","1) 指君主。\n2) 指君位。",{"a":1,"w":[7588,1303]}],["灵猋","língbiāo","1) 神灵之风。\n2) 暴风。",{"a":1,"w":[7588,24766]}],["青后","qīnghòu","即青帝。东方之神。亦借指东方。",{"a":1,"w":[3320,43]}],["青孱","qīngcàn","青葱高峻。孱，通“巉”。高貌。",{"a":1,"w":[3320,17664]}],["青室","qīngshì","为青草或苔藓之色映绿了的居室。",{"a":1,"w":[3320,1359]}],["青尊","qīngzūn","盛酒的酒杯。酒别名绿蚁，故称。",{"a":1,"w":[3320,7922]}],["青标","qīngbiāo","1) 清秀标致。\n2) 高洁。",{"a":1,"w":[3320,7449]}],["青澒","qīnghòng","丹砂所化的水银。呈青色，故称。",{"a":1,"w":[3320,27408]}],["青舸","qīnggě","即青雀舫。泛指雕饰华丽的游船。",{"a":1,"w":[3320,35910]}],["青览","qīnglǎn","旧时书信客套语。敬称对方阅览。",{"a":1,"w":[3320,8265]}],["静姝","jìngshū","娴静美好。借指娴静美好的女子。",{"a":1,"w":[1386,23036]}],["静邃","jìngsuì","1) 静穆幽深。\n2) 深沉。",{"a":1,"w":[1386,11821]}],["非复","fēifù","1) 不再是。\n2) 不像是。",{"a":1,"w":[2265,7461]}],["革僚","géliáo","中国少数民族名。即今之仡佬族。",{"a":1,"w":[7633,9351]}],["靸戟","sǎjǐ","古兵器。皇帝及后妃的仪仗之一。",{"a":1,"w":[41738,8766]}],["鞋粉","xiéfěn","擦在鞋面上用的粉，有各种颜色。",{"a":1,"w":[685,7613]}],["巩殿","gǒngdiàn","成弧形的殿宇。巩，用同“拱”。",{"a":1,"w":[10420,8493]}],["鞞柝","bǐngtuò","小鼓和木梆。军中用于打更巡夜。",{"a":1,"w":[31663,17914]}],["鞠遣","jūqiǎn","谓判决发付行刑。鞠，通“鞫”。",{"a":1,"w":[10161,8864]}],["鞫誓","jūshì","古代军旅的誓言。鞫，通“鞠”。",{"a":1,"w":[10558,8615]}],["鞭靴","biānxuē","鞭子和鞋子。借指寻常轻贱之物。",{"a":1,"w":[8162,9886]}],["鞹鞃","kuòhóng","指车轼当中用皮革包裹的把手处。",{"a":1,"w":[133282,98159]}],["韦藩","wéifān","皮制的车篷。古代无爵禄者所用。",{"a":1,"w":[7839,9005]}],["韐带","gédài","古代蔽膝上的皮带。也称韎韐带。",{"a":1,"w":[112505,542]}],["韩柳","hánliǔ","唐代古文家韩愈和柳宗元的并称。",{"a":1,"w":[8332,7802]}],["韩碑","hánbēi","指唐代韩愈撰写的《平淮西碑》。",{"a":1,"w":[8332,9627]}],["韬采","tāocǎi","隐藏美丽的光泽。比喻埋没才华。",{"a":1,"w":[11243,7528]}],["韶风","sháofēng","1) 和风。\n2) 比喻美德。",{"a":1,"w":[10368,44]}],["韵字","yùnzì","韵脚用字。亦指诗词之类的韵文。",{"a":1,"w":[8313,84]}],["顺听","shùntīng","1) 听从。\n2) 谓听得进。",{"a":1,"w":[4660,146]}],["顺养","shùnyǎng","1) 顺性怡养。\n2) 驯养。",{"a":1,"w":[4660,582]}],["须遂","xūsuì","复姓。见《左传‧庄公十七年》。",{"a":1,"w":[7629,8193]}],["顽凶","wánxiōng","1) 愚妄不顺。\n2) 恶人。",{"a":1,"w":[8595,4750]}],["顽虚","wánxū","愚钝而懦弱的人，多作自谦之辞。",{"a":1,"w":[8595,7779]}],["顽钱","wánqián","谓以钱作注赌博。顽，通“玩”。",{"a":1,"w":[8595,138]}],["顽驽","wánnú","愚笨而才能低下。多作自谦之辞。",{"a":1,"w":[8595,14621]}],["颁历","bānlì","亦作“颁历”。\n颁布下年新历。",{"a":1,"w":[9839,7643]}],["顿困","dùnkùn","犹困顿。谓生计或境遇艰难窘迫。",{"a":1,"w":[1370,1437]}],["颇罗","pǒluó","口敞底浅的饮酒器。亦泛指酒杯。",{"a":1,"w":[4897,7420]}],["颇颇","pǒpǒ","1) 犹频频。\n2) 犹很是。",{"a":1,"w":[4897]}],["领表","lǐngbiǎo","同“领外”。\n领，古“岭”字。",{"a":1,"w":[1361,536]}],["颐光","yíguāng","犹韬光。谓颐养精神，藏才不露。",{"a":1,"w":[9868,1271]}],["头谷","tóugǔ","指借给他人用以索取利息的稻谷。",{"a":1,"w":[509,7701]}],["颓索","tuísuǒ","1) 颓唐孤独。\n2) 衰竭。",{"a":1,"w":[8639,7470]}],["题扇","tíshàn","谓题写字画于扇上。作留念之赠。",{"a":1,"w":[615,3380]}],["题括","tíkuò","谓命题以概括全篇(诗文)旨意。",{"a":1,"w":[615,8668]}],["题比","tíbǐ","八股文中的一股。通称“起股”。",{"a":1,"w":[615,38]}],["颜徐","yánxú","唐代书法家颜真卿和徐浩的并称。",{"a":1,"w":[8117,8626]}],["颜李","yánlǐ","唐代书法家颜真卿、李邕的并称。",{"a":1,"w":[8117,7880]}],["颜武","yánwǔ","指(砚石)正面的尺寸。谓格局。",{"a":1,"w":[8117,7504]}],["颛征","zhuānzhēng","谓受命自主征伐。颛，通“专”。",{"a":1,"w":[11459,7581]}],["颠首","diānshǒu","枝头微微抖动，摇曳。形容依恋。",{"a":1,"w":[8660,2310]}],["类多","lèiduō","1) 犹偏多。\n2) 犹大多。",{"a":1,"w":[1323,21]}],["类帖","lèitiē","即法帖。名家书法的拓本或印本。",{"a":1,"w":[1323,8250]}],["显阳","xiǎnyáng","1) 宫门名。\n2) 宫殿名。",{"a":1,"w":[3347,7484]}],["风珂","fēngkē","指马勒上随风摆动的玉制装饰品。",{"a":1,"w":[44,14944]}],["风鬣","fēngliè","马的鬣毛随风蓬松状。借指骏马。",{"a":1,"w":[44,10816]}],["飘迅","piāoxùn","1) 短促。\n2) 飘忽迅疾。",{"a":1,"w":[3467,9463]}],["飞景","fēijǐng","1) 指日光。\n2) 宝剑名。",{"a":1,"w":[56,4676]}],["飞荣","fēiróng","1) 落花。\n2) 迅速发迹。",{"a":1,"w":[56,7887]}],["飞桨","fēijiǎng","疾速划动的桨。亦借指飞快的船。",{"a":1,"w":[56,4827]}],["飞浮","fēifú","1) 舟行貌。\n2) 上升貌。",{"a":1,"w":[56,4670]}],["飞煽","fēishān","1) 升腾炽盛。\n2) 闪烁。",{"a":1,"w":[56,10861]}],["飞神","fēishén","犹神游。谓形体不动而心神向往。",{"a":1,"w":[56,3316]}],["飞雨","fēiyǔ","1) 飞飘的雨。\n2) 骤雨。",{"a":1,"w":[56,159]}],["食事","shíshì","1) 吃喝之事。\n2) 为事。",{"a":1,"w":[7466,33]}],["飧牵","sūnqiān","熟食和牲口。一说为牢礼的一种。",{"a":1,"w":[13243,4731]}],["饮海","yǐnhǎi","饮马于海。谓军队进攻达到海边。",{"a":1,"w":[7871,528]}],["饮药","yǐnyào","1) 喝药。\n2) 特指服毒。",{"a":1,"w":[7871,579]}],["饰好","shìhǎo","1) 犹美化。\n2) 犹美好。",{"a":1,"w":[7951,58]}],["饰容","shìróng","整饬容貌、仪表。饰，通“饬”。",{"a":1,"w":[7951,7524]}],["饰羔","shìgāo","谓刷拭祭祀所用的小羊使之清洁。",{"a":1,"w":[7951,11158]}],["饷事","xiǎngshì","亦作“饟事”。\n掌管军粮之事。",{"a":1,"w":[9898,33]}],["饷军","xiǎngjūn","亦作“饟军”。\n给军队发粮饷。",{"a":1,"w":[9898,7467]}],["餐事","cānshì","1) 指吃饭。\n2) 指饭食。",{"a":1,"w":[4763,33]}],["余栗","yúlì","事后还有的害怕。栗，通“栗”。",{"a":1,"w":[7597,8177]}],["余税","yúshuì","指农家以自给之余剩交纳的赋税。",{"a":1,"w":[7597,3343]}],["馅草","xiàncǎo","菜馅。比喻事物内部包藏的东西。",{"a":1,"w":[9711,521]}],["馔馈","zhuànkuì","1) 进献肴馔。\n2) 肴馔。",{"a":1,"w":[10570,8692]}],["饥切","jīqiè","谓食物十分缺乏，生活至为艰苦。",{"a":1,"w":[8569,2276]}],["饥雷","jīléi","饥饿时腹鸣有声。饥，通“饥”。",{"a":1,"w":[8569,3319]}],["飨报","xiǎngbào","为报功德而祭祀。飨，通“享”。",{"a":1,"w":[11128,1318]}],["飨射","xiǎngshè","古礼。宴饮宾客并举行射箭之礼。",{"a":1,"w":[11128,3312]}],["馋嚼","chánjué","1) 谓吃。\n2) 比喻尝试。",{"a":1,"w":[5199,9180]}],["香城","xiāngchéng","1) 指佛国。\n2) 指仙境。",{"a":1,"w":[1311,1353]}],["香婆","xiāngpó","南宋酒楼以小炉炷香为供的老妇。",{"a":1,"w":[1311,8137]}],["香橘","xiāngjú","1) 橘名。\n2) 橙之一种。",{"a":1,"w":[1311,8816]}],["香表","xiāngbiǎo","即黄表。指祭祀时烧化的黄表纸。",{"a":1,"w":[1311,536]}],["马容","mǎróng","行军时乘马居前以壮军容的军官。",{"a":1,"w":[1273,7524]}],["马领","mǎlǐng","桑根露出地面者。传说能毒死人。",{"a":1,"w":[1273,1361]}],["驮背","tuóbèi","I\n驼背。\nII\n谓牲口载负。",{"a":1,"w":[10335,565]}],["驰指","chízhǐ","驱驰于指顾之间。形容动作快速。",{"a":1,"w":[8375,1312]}],["驽良","núliáng","指驽马与良马。亦指低劣和优良。",{"a":1,"w":[14621,7645]}],["驾龙","jiàlóng","谓仙道乘龙飞行。亦指得道成仙。",{"a":1,"w":[7879,1308]}],["骈赋","piánfù","指汉代以后向骈文方向发展的赋。",{"a":1,"w":[9675,8218]}],["骈赘","piánzhuì","骈枝赘疣。比喻多余无用的东西。",{"a":1,"w":[9675,9061]}],["骇悉","hàixī","惊悉。一般用以指人死亡的消息。",{"a":1,"w":[9473,8908]}],["騃呐","áinà","愚笨而言语迟钝。呐，通“讷”。",{"a":1,"w":[52269,11607]}],["骛鼓","wùgǔ","指古代军中指挥驰骛进击的鼓声。",{"a":1,"w":[13411,3352]}],["骞扑","qiānpū","枝叶上下拍打貌。骞，通“骞”。",{"a":1,"w":[13269,4767]}],["腾茂","téngmào","1) 犹远扬。\n2) 犹兴旺。",{"a":1,"w":[7985,8915]}],["驩腾","huānténg","欢喜得手舞足蹈。驩，通“欢”。",{"a":1,"w":[20929,7985]}],["骨录","gǔlù","谓载入仙人名籍，具有仙风道骨。",{"a":1,"w":[7537,1380]}],["体敌","tǐdí","谓彼此地位相等，不分上下尊卑。",{"a":1,"w":[7417,7944]}],["高卬","gāo'áng","指地势高。与“低洼”相对而言。",{"a":1,"w":[35,13309]}],["高圆","gāoyuán","1) 指天空。\n2) 指太阳。",{"a":1,"w":[35,2301]}],["高奋","gāofèn","1) 高涨振奋。\n2) 高飞。",{"a":1,"w":[35,8299]}],["高构","gāogòu","高大的建筑物。比喻很大的成就。",{"a":1,"w":[35,7540]}],["髡笞","kūnchī","古代刑罚。剃去须发，鞭打身体。",{"a":1,"w":[28259,13171]}],["髦期","máoqī","暮年，衰老之年。髦，通“耄”。",{"a":1,"w":[10415,1299]}],["发笄","fājī","女子丧装。“发”乃“髽”之误。",{"a":1,"w":[522,13748]}],["髹工","xiūgōng","从事油漆器物、门窗等工作的人。",{"a":1,"w":[441764,7411]}],["斗韵","dòuyùn","谓联句或赋诗填词时以险韵竞胜。",{"a":1,"w":[7477,8313]}],["闹香","nàoxiāng","闷香。一种熏人能使之昏迷的香。",{"a":1,"w":[2352,1311]}],["郁岪","yùfú","山势高险貌。一说形容山气暗昧。",{"a":1,"w":[8084,65992]}]