[["睹物怀人","dǔwùhuáirén","看到与故人有关的东西， 而引起对他的怀念。 明·汤显祖·还魂记·第二十五出： “睹物怀人， 人去物华销尽， 道的个仙果难成， 名花易陨。 ”亦作“睹物思人”。",{"a":1,"w":[10531,7412,7749,3]}],["祭亡如在","jì wúrú zài","祭奠死者时， 宛如死者就在眼前。 形容祭奠时非常真诚。 后汉书·卷三·肃宗孝章帝纪： “乐以迎来， 哀以送往， 虽祭亡如在， 而空虚不知所裁， 庶或飨之。 ”",{"a":1,"w":[8417,101219,52]}],["祸稔恶盈","huò rěn'è yíng","稔， 酝酿、 累积。 祸稔恶盈指长期为害作恶， 罪孽深重。 宋·王楙·野客丛书·卷十·宣帝待霍氏： “今霍氏祸稔恶盈， 帝岂不能治之哉？ ”亦作“祸盈恶稔”。",{"a":1,"w":[8225,247037,8251]}],["终南别业","zhōngnán biéyè","诗名。 唐王维作。 五言律诗。 全诗为： “中岁颇好道， 晚家南山陲。 兴来每独往， 胜事空自知。 行到水穷处， 坐看云起时。 偶然值林叟， 谈笑无还期。 ”",{"a":1,"w":[153930,140149]}],["经义杂记","jīngyì zájì","书名。 清臧琳撰， 三十卷。 为其三十年来随手札记的读书心得， 每卷有标目而不分门类， 故称为“杂记”。 对于经籍的文字、 义理、 声音、 训诂， 多所辨证。",{"a":1,"w":[36479,121312]}],["罡神泥鬼","gāngshénníguǐ","比喻游手好闲， 惹事生非的人。 野叟曝言·第三十三回： “衙门里书房差役， 街坊上总甲排年， 合那些罡神泥鬼， 掮鹰放鹞的人， 那一个不要来分使几个钱儿？ ”",{"a":1,"w":[52023,3316,4651,3340]}],["菲食卑宫","fēishíbēigōng","比喻贤明的君主不重视物质的享受， 专心于国事的整治。 见“卑宫菲食”条。 梁书·卷四十五·王僧辩传： “高祖菲食卑宫， 春秋九十， 屈志凝威， 愤终贼乎。 ”",{"a":1,"w":[7892,7466,8402,4679]}],["薰穴求君","xūnxuéqiújūn","本指战国时越人三世弑其君， 王子搜患之， 逃往丹奴肯继任国君， 越人以艾薰丹穴， 王子搜乃被迫出穴登位的故事。 见庄子·让王。 后比喻强迫他人做不愿做的事情。",{"a":1,"w":[9237,8147,598,7831]}],["衣冠子女","yīguān zǐnǚ","出身官宦之家的子女。 唐·薛调·无双传： “我闻宫嫔选在掖庭， 多是衣冠子女。 ”明·凌濛初·红拂记·楔子： “则俺姓张行一， 家住东吴， 本是衣冠子女。 ”",{"a":1,"w":[19910,1882]}],["诛凶殄逆","zhūxiōngtiǎnnì","殄， 灭绝。 诛凶殄逆指讨伐残暴叛逆的人。 唐·陈子昂·请措刑科： “圣人诛凶殄逆， 济人宁乱， 必资刑杀， 以清天下。 ”亦作“诛暴讨逆”、 “诛凶讨逆”。",{"a":1,"w":[9317,4750,12931,7762]}],["贻笑万世","yíxiào wànshì","受世世代代的人所讥笑。 宋·刘敞·上仁宗论温成立忌： “岂可以一时之宠， 独决圣心， 义有僭失， 贻笑万世， 亏损盛明。 ”亦作“贻笑千古”、 “贻笑千秋”。",{"a":1,"w":[72700,22422]}],["身膏鼎镬","shēn gāo dǐnghuò","鼎镬， 古代的酷刑， 用鼎镬烹煮罪犯。 身膏鼎镬指身受鼎镬烹煮的酷刑。 大宋宣和遗事·亨集： “万一不从， 便身膏鼎镬， 亦得与龙逢、 比干游于地下足矣。 ”",{"a":1,"w":[7456,8048,36061]}],["转忧成喜","zhuǎnyōuchéngxǐ","忧虑的心情转为喜悦。 红楼梦·第五十八回： “藕官正没了主意， 见了宝玉也正添了畏惧， 忽听他反替掩饰， 心内转忧成喜。 ”亦作“转愁为喜”、 “转忧为喜”。",{"a":1,"w":[1293,8112,517,7727]}],["造言惑众","zàoyán huòzhòng","制造谣言， 迷惑群众。 清·壮者·扫迷帚·第十回： “老兄六尺须眉， 何苦同妇人女子一般识见， 造言惑众， 说得天花乱坠， 凿凿有据呢！ ”亦作“造谣惑众”。",{"a":1,"w":[36927,44502]}],["门神户尉","ménshén hùwèi","正门上所贴有守护作用的神画像。 元·关汉卿·窦娥冤·第四折： “门神户尉不放我进去， 我是廉访使窦天章女孩儿， 因我屈死， 父亲不知， 特来托一梦与他咱。 ”",{"a":1,"w":[38034,186186]}],["音信杳然","yīnxìn yǎorán","没有任何音讯、 消息。 明·叶宪祖·鸾鎞记·第二十三出： “目今又当大比之年， 此时想已放榜， 怎么音信杳然？ 难道我相公又下第了不成？ ”亦作“杳无音信”。",{"a":1,"w":[17201,115379]}],["领如蝤蛴","lǐng rú qiúqí","蝤蛴， 天牛的幼虫， 身长而色白。 领如蝤蛴形容美人的脖子洁白纤长。 语出诗经·卫风·硕人： “手如柔荑， 肤如凝脂， 领如蝤蛴， 齿如瓠犀， 螓首蛾眉。 ”",{"a":1,"w":[1361,4614,78983]}],["风静浪平","fēngjìnglàngpíng","原指无风无浪， 后比喻平静无事。 三国演义·第九十一回： “次日， 孔明引大军俱到泸水南岸， 但见云收雾散， 风静浪平。 ”亦作“平风静浪”、 “风平浪静”。",{"a":1,"w":[44,1386,7832,525]}],["首尾贯通","shǒuwěi guàntōng","前后接连相通。 宋·王观国·学林·卷七·古赋题： “左思作三都赋序曰： “余既思摹二京而赋三都。 ”盖亦拟张衡二京而为三都赋……此赋首尾贯通， 亦一赋也。 ”",{"a":1,"w":[22160,13908]}],["民族艺师","mínzú yìshī","mín zú yì shī\n指教育部「重要民族艺术艺师」。民国七十八年，教育仿照日本、韩国的「人间国宝」、「国家文化财」的精神，设置此制度，象征国家最高荣誉。",{"a":1,"w":[1487,31809]}],["九七大限","jiǔ qīdà xiàn","jiǔ qī dà xiàn\n指英国因南京条约获得的香港岛，及北京条约获得的九龙半岛，连同租期已满的新界，必须一并于西元一九九七年七月一日归还中国大陆的限期。",{"a":1,"w":[143,13275,7616]}],["汽保设备","qì bǎo shèbèi","汽保设备就是指用于汽车维修保养的各类设备，也包括维修工具，这些设备有时也被叫做汽车维修设备，因为当前车主越来越重视汽车保养，维修与保养二个概念已经相提并列了。",{"a":1,"w":[8032,1292,1419]}],["把持包办","bǎchí bāobàn","（独揽专断，不让他人参加） keep everything in one’s own hand (hands); control and monopolize",{"a":1,"w":[19639,33682]}],["百锻千炼","bǎiduànqiānliàn","wrought by a hundred times and refined by a thousand times; thoroughly tempered",{"a":1,"w":[133,9192,587,8149]}],["病情危笃","bìngqíng wēidǔ","be dangerously ill; One’s disease is serious.; One’s sickness becomes critical.",{"a":1,"w":[6089,163331]}],["才不胜任","cáibù shèngrèn","ability inadequate for the position; talents not equal to the post; incompetent",{"a":1,"w":[25973,23363]}],["淬掌读书","cuì zhǎng dúshū","awake oneself by burning the palm when studying at night; study very diligently",{"a":1,"w":[10469,7833,330]}],["存心叵测","cúnxīn pǒcè","harbour evil intent; cherish unscrupulous intentions; with concealed intentions",{"a":1,"w":[39582,56069]}],["错脚难返","cuòjiǎonánfǎn","A false step is hard to retract -- to be difficult to return to the right path.",{"a":1,"w":[147,602,117,8365]}],["大泼冷水","dà pōlěngshuǐ","pour cold water on sb.; throw a wet blanket on (over) ...; damp down enthusiasm",{"a":1,"w":[4,45145]}],["锻炼品行","duànliàn pǐnxíng","form and train character through experience as blacksmith fires and shapes iron",{"a":1,"w":[1865,35873]}],["风静云闲","fēngjìngyúnxián","There is no wind and the clouds stand still.; There is neither wind nor clouds.",{"a":1,"w":[44,1386,554,3381]}],["甘挑重担","gān tiāozhòngdàn","be ready to take on heavy responsibilities; take the heaviest burden on oneself",{"a":1,"w":[7681,75934]}],["各逞其能","gèchěngqínéng","Each one displays that in which he excels.; Each one shows his special prowess.",{"a":1,"w":[1406,9682,3315,41]}],["害多利少","hài duōlì shǎo","more harm than good; do more harm than good; more disadvantages than advantages",{"a":1,"w":[3353,13338,126]}],["挥师出击","huīshī chūjī","send out an army to war; dispatch troops to fight; push troops onward to attack",{"a":1,"w":[292878,20817]}],["兼业承包","jiānyè chéngbāo","contracting for a number of specialized occupations to be done at the same time",{"a":1,"w":[198695,5423]}],["碌碌尘寰","lùlù chénhuán","be toiling in the red dust of the earthly world -- busy with miscellaneous work",{"a":1,"w":[13094,348200]}],["乱中脱身","luàn zhōng tuōshēn","make good one’s escape in the ensuing confusion; slip away in the ensuing chaos",{"a":1,"w":[1360,7,101993]}],["命薄如纸","mìngbáo rú zhǐ","one’s luck as thin as paper -- brevity of life; extremely unlucky in one’s life",{"a":1,"w":[106898,4614,622]}],["努力不倦","nǔlì bùjuàn","persevere in an effort; make indefatigable efforts to ...; strive without cease",{"a":1,"w":[825,25951]}],["请客作东","qǐngkè zuòdōng","stand one’s hand; act as host to sb.; pay the piper; play the host; stand treat",{"a":1,"w":[1091,84913]}],["曲直不分","qūzhí bùfēn","not distinguish between right and wrong; Right and wrong are not discriminated.",{"a":1,"w":[49831,9884]}],["似梦非梦","shìmèngfēimèng","It was a dream and yet not a dream.; It is like a dream and yet it is no dream.",{"a":1,"w":[7803,2386,2265]}],["颂古诽今","sònggǔfěi