16]}],["谷仙","gǔxiān","古方士谓种谷求金之术。",{"a":1,"w":[7701,7740]}],["积因","jīyīn","谓累积构成事物的条件。",{"a":1,"w":[7496,4624]}],["积坏","jīhuài","积久形成的衰败或败坏。",{"a":1,"w":[7496,163]}],["积幼","jīyòu","谓抚养子息，久而成人。",{"a":1,"w":[7496,8210]}],["积昏","jīhūn","谓暮色深浓，昏暗无光。",{"a":1,"w":[7496,4748]}],["积众","jīzhòng","谓不遗细小，积少成多。",{"a":1,"w":[7496,7688]}],["积轻","jīqīng","长期被轻视；长期轻视。",{"a":1,"w":[7496,595]}],["颖首","yǐngshǒu","把柱子的顶端砍成尖状。",{"a":1,"w":[9499,2310]}],["穑臣","sèchén","古代称管理农事的大臣。",{"a":1,"w":[15370,8045]}],["秽垢","huìgòu","污浊。比喻过失、缺点。",{"a":1,"w":[9258,9205]}],["秽身","huìshēn","佛教语。称凡夫之肉身。",{"a":1,"w":[9258,7456]}],["稆麦","lǚmài","落粒自生的麦，野生麦。",{"a":1,"w":[133439,7800]}],["穴井","xuéjǐng","因地陷而天然形成之井。",{"a":1,"w":[8147,4671]}],["穴人","xuérén","在洞穴中采钟乳石的人。",{"a":1,"w":[8147,3]}],["穴岫","xuéxiù","山谷和峰峦。指隐居处。",{"a":1,"w":[8147,21492]}],["穹阶","qióngjiē","高台阶。借指高官显爵。",{"a":1,"w":[9984,7773]}],["空嚣","kōngxiāo","谓不学无术，徒尚空谈。",{"a":1,"w":[1274,11589]}],["空缘","kōngyuán","佛教语。谓以性空为缘。",{"a":1,"w":[1274,7628]}],["空胸","kōngxiōng","谓腹内空虚，没有学识。",{"a":1,"w":[1274,3364]}],["穿望","chuānwàng","切盼。望穿眼睛的意思。",{"a":1,"w":[153,7556]}],["突贯","tūguàn","军事用语。突破而穿越。",{"a":1,"w":[7750,8062]}],["窗寮","chuāngliáo","窗里面的窗。亦泛指窗。",{"a":1,"w":[8301,10125]}],["窗绡","chuāngxiāo","蒙在窗上的细薄纺织品。",{"a":1,"w":[8301,22878]}],["窠窠","kēkē","犹簇簇，团团。聚集貌。",{"a":1,"w":[11633]}],["窠绫","kēlíng","一种织有团花的丝织品。",{"a":1,"w":[11633,12774]}],["穷海","qiónghǎi","僻远的海边。亦指大海。",{"a":1,"w":[2372,528]}],["穷罄","qióngqìng","空然无物。谓一无所有。",{"a":1,"w":[2372,10860]}],["穷闾","qiónglǘ","陋巷；穷人所居的里巷。",{"a":1,"w":[2372,9516]}],["窑神","yáoshén","旧称主宰砖瓦窑的神灵。",{"a":1,"w":[8374,3316]}],["窥朝","kuīcháo","窥伺朝廷。指伺机篡权。",{"a":1,"w":[8879,1357]}],["窥纪","kuījì","传说中的黄帝七辅之一。",{"a":1,"w":[8879,7653]}],["窍藏","qiàocáng","人体九窍和五脏的并称。",{"a":1,"w":[9246,4688]}],["立仗","lìzhàng","设立仪仗。亦即指仪仗。",{"a":1,"w":[3314,8596]}],["竦勇","sǒngyǒng","谓声音陡然升高而加强。",{"a":1,"w":[10593,8286]}],["竭愚","jiéyú","自谦之词。谓尽其愚见。",{"a":1,"w":[8647,8545]}],["端闱","duānwéi","皇宫的正门。亦指朝廷。",{"a":1,"w":[4659,11278]}],["竹弩","zhúnǔ","一种用