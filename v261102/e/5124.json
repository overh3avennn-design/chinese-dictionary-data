2]}],["磬地","qìngdì","犹全国。磬，通“罄”。",{"a":1,"w":[11487,10]}],["磬虫","qìngchóng","一种鸣声如击磬的秋虫。",{"a":1,"w":[11487,7601]}],["磴栈","dèngzhàn","在山岩上用木架成的路。",{"a":1,"w":[17114,9542]}],["磻礡","pánbó","广大无边。亦借指大地。",{"a":1,"w":[32137,123860]}],["硗秃","qiāotū","贫瘠多石不生草木之地。",{"a":1,"w":[16246,4862]}],["礧硠","léiláng","亦作“礌硠”。\n大声。",{"a":1,"w":[26874,66529]}],["示梦","shìmèng","谓灵魂在梦中以事示人。",{"a":1,"w":[593,2386]}],["祈衈","qí'èr","古时杀牲取血涂祭之礼。",{"a":1,"w":[9277,73074]}],["祉佑","zhǐyòu","福佑。佑，谓神灵护助。",{"a":1,"w":[12523,11619]}],["佑统","yòutǒng","谓神佑国统，传于后世。",{"a":1,"w":[11619,7442]}],["佑飨","yòuxiǎng","谓享受祭献，佑助降福。",{"a":1,"w":[11619,11128]}],["祔主","fùzhǔ","以死者神位附祭于先祖。",{"a":1,"w":[24118,7425]}],["祔安","fù'ān","谓将死者合葬而使之安。",{"a":1,"w":[24118,2261]}],["祔庙","fùmiào","祔祭后死者于先祖之庙。",{"a":1,"w":[24118,8514]}],["秘水","mìshuǐ","唐代称秘书省中的茶水。",{"a":1,"w":[7938,11]}],["秘远","mìyuǎn","犹幽远。形容风度飘逸。",{"a":1,"w":[7938,103]}],["秘馆","mìguǎn","即秘阁。帝王藏书之所。",{"a":1,"w":[7938,7919]}],["祖子","zǔzi","嫁接时作根株用的花木。",{"a":1,"w":[7723,1]}],["祖洲","zǔzhōu","古代传说中的十洲之一。",{"a":1,"w":[7723,7759]}],["祖祠","zǔcí","祭祀和供奉祖先的祠堂。",{"a":1,"w":[7723,10439]}],["祖台","zǔtái","旧时对高级官吏的尊称。",{"a":1,"w":[7723,1306]}],["祖衣","zǔyī","佛教语。指僧人的礼服。",{"a":1,"w":[7723,7536]}],["祖言","zǔyán","犹祖述。谓阐述；发扬。",{"a":1,"w":[7723,7440]}],["祗直","zhīzhí","宋时对值班人员的称呼。",{"a":1,"w":[11397,1294]}],["祛禳","qūráng","为消除邪恶灾异而祭祀。",{"a":1,"w":[10069,15582]}],["祝付","zhùfù","嘱咐。祝，用同“嘱”。",{"a":1,"w":[1473,1402]}],["祝币","zhùbì","祭祀时用作祭品的玉帛。",{"a":1,"w":[1473,7943]}],["祝物","zhùwù","一种以符咒变物的巫术。",{"a":1,"w":[1473,7412]}],["祝衄","zhùnǜ","祭祀时杀牲酹血而祈祷。",{"a":1,"w":[1473,17765]}],["祝除","zhùchú","谓削除。祝，通“斸”。",{"a":1,"w":[1473,4635]}],["神口","shénkǒu","谓口才敏捷，吐词若神。",{"a":1,"w":[3316,47]}],["神孙","shénsūn","后嗣的美称。多称君主。",{"a":1,"w":[3316,7936]}],["神欲","shényù","心神的意向，精神活动。",{"a":1,"w":[3316,7872]}],["神素","shénsù","指古代质朴无华的精神。",{"a":1,"w":[3316,7468]}],["神藉","shénjí","祭祀时摆设供品的垫物。",{"a":1,"w":[3316,8459]}],["神馆","shénguǎn","神仙或神灵所居的馆所。",{"a":1,"w":[3316,7919]}],["祠典","cídiǎn","祀典，有关祭祀的典制。",{"a":1,"w":