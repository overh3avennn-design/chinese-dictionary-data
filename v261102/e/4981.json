]}],["鳅魽","qiūhán","泥鳅和蚶子。泛指小鱼鲜。",{"a":1,"w":[27564]}],["鳖咳","biēké","比喻言语不清，意思难明。",{"a":1,"w":[10009,3535]}],["鸟囮","niǎo'é","引诱其他飞鸟相随的活鸟。",{"a":1,"w":[581,35009]}],["鸟巾","niǎojīn","古代吊唁时戴的暗色头巾。",{"a":1,"w":[581,8285]}],["鸟战","niǎozhàn","谓如鸟之飞聚，突然而战。",{"a":1,"w":[581,7438]}],["鸟穷","niǎoqióng","鸟飞无路。形容处境困难。",{"a":1,"w":[581,2372]}],["鸟窜","niǎocuàn","如鸟飞窜。形容四下逃散。",{"a":1,"w":[581,4918]}],["鸟贼","niǎozéi","对唐李靖弟李客师的戏称。",{"a":1,"w":[581,4718]}],["鸟逝","niǎoshì","如鸟飞逝。形容很快消失。",{"a":1,"w":[581,9482]}],["凫分","fúfēn","双凫相背分飞。比喻分离。",{"a":1,"w":[14408,15]}],["凤喈","fèngjiē","凤鸾和鸣。比喻夫妇和乐。",{"a":1,"w":[7768,47423]}],["凤墀","fèngchí","宫殿前的台阶。借指朝廷。",{"a":1,"w":[7768,29081]}],["凤屧","fèngxiè","即凤鞋。借指美女的足迹。",{"a":1,"w":[7768,62700]}],["凤掖","fèngyē","古代皇后或皇太子的宫室。",{"a":1,"w":[7768,9820]}],["凤杼","fèngzhù","对织机的美称。借指织女。",{"a":1,"w":[7768,13082]}],["凤梁","fèngliáng","雕绘着凤凰等饰物的屋梁。",{"a":1,"w":[7768,7890]}],["凤环","fènghuán","古代妇女发髻上环形饰物。",{"a":1,"w":[7768,1320]}],["鸢蹲","yuāndūn","鸱蹲。比喻瑟缩局促之态。",{"a":1,"w":[9269,3595]}],["鸢鸣","yuānmíng","鸢鸟鸣叫。古人以为风候。",{"a":1,"w":[9269,7935]}],["鸮鵩","xiāofú","鸮鸟与鹏鸟。一说即鸮鸟。",{"a":1,"w":[11204,111743]}],["鸱龟","chīguī","形如鸱鸟的龟。鸟首虺尾。",{"a":1,"w":[12921,7684]}],["鴳爵","yànjué","亦作“鷃爵”。\n即鴳雀。",{"a":1,"w":[20919,8494]}],["鸿枢","hóngshū","旧谓中央政权的显要之职。",{"a":1,"w":[8788,8314]}],["鸿归","hóngguī","鸿雁归飞。形容笔势俊逸。",{"a":1,"w":[8788,2317]}],["鸿轩","hóngxuān","鸿雁高飞。比喻举止不凡。",{"a":1,"w":[8788,8869]}],["鵁衔","jiāoxián","谓池鹭之子衔其母翅而飞。",{"a":1,"w":[142653,8703]}],["鵩入","fúrù","谓鹏鸟入舍，为不祥之兆。",{"a":1,"w":[111743,4615]}],["雕坊","diāofāng","唐代宫廷豢养猎雕的地方。",{"a":1,"w":[8192,8643]}],["鹊门","quèmén","扁鹊之门。泛指医家之门。",{"a":1,"w":[9090,53]}],["鹊驭","quèyù","传说中由喜鹊驾驭的车子。",{"a":1,"w":[9090,11578]}],["鹊验","quèyàn","谓鹊鸟所报喜讯得以应验。",{"a":1,"w":[9090,7568]}],["鹊鹊","quèquè","象声词。形容鹊的鸣叫声。",{"a":1,"w":[9090]}],["鹓甃","yuānzhòu","用砖石砌得很整齐的路径。",{"a":1,"w":[20415,42595]}],["鹓羽","yuānyǔ","鹓凤。比喻才德出众的人。",{"a":1,"w":[20415,7878]}],["鹓鸑","yuānyuè","传说中的瑞鸟。比喻贤臣。",{"a":1,"w":[20415,257482]}],["鹖苏","hésū","鶡尾作的流苏。用以饰冠。",{"a":1,"w":[28850,7525]}],["莺华","yīnghuá","花开莺啼。泛指美好春景。",{"a":1,"w":[8499,7503]}],["鹤塞","hèsāi","地名。在今江西省九江市。",{"a":1,"w":[8240,4630]}],["鹤孤","hègū","谓孤寂。鹤性孤高，故称。",{"a":1,"w":[8240,7996]}],["鹤性","hèxìng","鹤的习性。指高洁的情性。",{"a":1,"w":[8240,1275]}],["鹤开","hèkāi","如鹤展翅。比喻文风飘逸。",{"a":1,"w":[8240,31]}],["鹘翅","gǔchì","谓鹘振翅飞行，矫健迅捷。",{"a":1,"w":[16222,8002]}],["鹘起","gǔqǐ","如鹘飞起。比喻气势旺盛。",{"a":1,"w":[16222,29]}],["鹞坊","yàofāng","唐代宫廷饲养猎鹞的官署。",{"a":1,"w":[14247,8643]}],["鷩毳","bìcuì","古礼服鷩冕与毳冕的并称。",{"a":1,"w":[39686,15257]}],["鹰坊","yīngfāng","古代宫廷饲养猎鹰的官署。",{"a":1,"w":[8542,8643]}],["鹰鹗","yīng'è","猛禽。比喻才智出众的人。",{"a":1,"w":[8542,20708]}],["鸾封","luánfēng","鸾镜之匣关闭。谓失情侣。",{"a":1,"w":[9528,600]}],["鸾幰","luánxiǎn","鸾车上的帷幔。借指鸾车。",{"a":1,"w":[9528,55854]}],["鸾扃","luánjiōng","鸾车前的横木。借指鸾车。",{"a":1,"w":[9528,15982]}],["鸾軿","luánpíng","对贵妇人所乘之车的美称。",{"a":1,"w":[9528,36094]}],["鸾集","luánjí","鸾鸟栖集。比喻贤士相聚。",{"a":1,"w":[9528,4628]}],["咸泉","xiánquán","含盐分的泉水，可以制盐。",{"a":1,"w":[2422,3461]}],["鹾税","cuóshuì","政府对产销食盐所征的税。",{"a":1,"w":[30687,3343]}],["盐徒","yántú","指因贩卖私盐受罚的刑徒。",{"a":1,"w":[2404,7813]}],["鹿浅","lùqiǎn","指鹿在夏天新生浅毛的皮。",{"a":1,"w":[8199,2400]}],["鹿辂","lùlù","鹿车前的横木。借指鹿车。",{"a":1,"w":[8199,14323]}],["麋首","míshǒu","指长寿者。麋，通“眉”。",{"a":1,"w":[14270,2310]}],["丽祸","lìhuò","遭受灾祸。丽，通“罹”。",{"a":1,"w":[7634,8225]}],["麟符","línfú","古代朝廷颁发的麟形符节。",{"a":1,"w":[8990,7841]}]]