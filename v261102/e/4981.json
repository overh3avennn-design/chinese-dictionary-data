14511]}],["马馆","mǎguǎn","清代隶属兵部的掌马机构。",{"a":1,"w":[1273,7919]}],["驳轹","bólì","车轮交错碾过。比喻陵藉。",{"a":1,"w":[8526,15302]}],["駜駽","bìxuān","强壮的铁青马。泛指骏马。",{"a":1,"w":[131779,311704]}],["驼钮","tuóniǔ","印章上端为骆驼形的印钮。",{"a":1,"w":[8671,9176]}],["骈族","piánzú","谓一人获罪，并诛其亲族。",{"a":1,"w":[9675,4632]}],["骇轰","hàihōng","象声词。形容鼓声等轰响。",{"a":1,"w":[9473,8041]}],["骏懋","jùnmào","优异超群。骏，通“俊”。",{"a":1,"w":[10268,13375]}],["骏敏","jùnmǐn","秀美灵敏。骏，通“俊”。",{"a":1,"w":[10268,7965]}],["骏爽","jùnshuǎng","秀拔清朗。骏，通“俊”。",{"a":1,"w":[10268,4855]}],["騄耳","lù'ěr","亦作“騄駬”。\n良马名。",{"a":1,"w":[61394,7509]}],["骑步","qíbù","谓跨坐在岩石上向前移动。",{"a":1,"w":[674,1337]}],["骞衣","qiānyī","提起衣裳。骞，通“褰”。",{"a":1,"w":[13269,7536]}],["腾口","téngkǒu","同“滕口”。\n张口放言。",{"a":1,"w":[7985,47]}],["腾摧","téngcuī","犹言忽高忽低，忽上忽下。",{"a":1,"w":[7985,9210]}],["腾清","téngqīng","将东西移尽，使空无所有。",{"a":1,"w":[7985,4617]}],["腾闻","téngwén","上闻，使皇帝或朝廷闻知。",{"a":1,"w":[7985,629]}],["驺发","zōufā","发射良箭。驺，通“菆”。",{"a":1,"w":[13319,522]}],["骚奴","sāonú","旧时对北方游牧民的蔑称。",{"a":1,"w":[8664,8153]}],["骚策","sāocè","指《离骚》和《战国策》。",{"a":1,"w":[8664,7673]}],["骚魂","sāohún","指屈原。泛指死去的诗人。",{"a":1,"w":[8664,8394]}],["骡纲","luógāng","结队而行驮载货物的骡群。",{"a":1,"w":[17089,8152]}],["骖左","cānzuǒ","即左骖。服马左边的骖马。",{"a":1,"w":[14958,154]}],["驱爵","qūjué","驱赶鸟雀。爵，通“雀”。",{"a":1,"w":[7995,8494]}],["骄爱","jiāo'ài","娇美可爱。骄，通“娇”。",{"a":1,"w":[8457,131]}],["惊沫","jīngmò","指激浪溅起的浪花、泡沫。",{"a":1,"w":[7978,8693]}],["惊目","jīngmù","使人见而惊奇；引人注目。",{"a":1,"w":[7978,7465]}],["驿尘","yìchén","驿马扬起的飞尘。指驿骑。",{"a":1,"w":[9950,7843]}],["驴鞍","lǘ'ān","放在驴背上供骑坐的器具。",{"a":1,"w":[8826,9598]}],["驩乍","huānzhà","欢跃喧腾。驩，通“欢”。",{"a":1,"w":[20929,9481]}],["驩动","huāndòng","喜悦激动。驩，通“欢”。",{"a":1,"w":[20929,6]}],["驩愉","huānyú","欢乐愉快。驩，通“欢”。",{"a":1,"w":[20929,9418]}],["驩笑","huānxiào","欢乐地笑。驩，通“欢”。",{"a":1,"w":[20929,185]}],["驩哗","huānhuā","欢笑喧哗。驩，通“欢”。",{"a":1,"w":[20929,11924]}],["驩逸","huānyì","欢乐安逸。驩，通“欢”。",{"a":1,"w":[20929,8116]}],["驩游","huānyóu","欢聚嬉游。驩，通“欢”。",{"a":1,"w":[20929,1317]}],["髁身","kēshēn","光着身子。髁，通“裸”。",{"a":1,"w":[274