8,8107]}],["霜散","shuāngsàn","指成霜状结晶的白色药末。",{"a":1,"w":[8258,2286]}],["霜桐","shuāngtóng","即梧桐。梧桐皮白，故称。",{"a":1,"w":[8258,8334]}],["霜碛","shuāngqì","北方碛卤之地。借指北方。",{"a":1,"w":[8258,12115]}],["霜翼","shuāngyì","在降霜的夜空中飞行的鸟。",{"a":1,"w":[8258,4645]}],["霜脐","shuāngqí","指蟹。蟹霜后肥美，故称。",{"a":1,"w":[8258,9822]}],["霜讯","shuāngxùn","即霜信。霜期来临的消息。",{"a":1,"w":[8258,8024]}],["霜镜","shuāngjìng","明镜。喻明察清廉的官吏。",{"a":1,"w":[8258,7535]}],["雾阁","wùgé","云雾笼罩的楼阁。言其高。",{"a":1,"w":[3421,8208]}],["露奏","lùzòu","奏章。奏章不加封，故称。",{"a":1,"w":[4674,4777]}],["霸柄","bàbǐng","犹把柄。喻指凭藉或依据。",{"a":1,"w":[8096,7964]}],["霭峰","ǎifēng","山峰名。在安徽省黟县南。",{"a":1,"w":[15948,8122]}],["灵席","língxí","设有神主以供奉祀的台子。",{"a":1,"w":[7588,7836]}],["灵母","língmǔ","神母。传说中白帝子之母。",{"a":1,"w":[7588,4637]}],["灵纲","línggāng","犹王纲。朝廷的纲纪法度。",{"a":1,"w":[7588,8152]}],["灵蠵","língxī","即蠵。甲用以占卜，故称。",{"a":1,"w":[7588,56984]}],["灵輤","língqiàn","灵车上的饰物。借指灵车。",{"a":1,"w":[7588,254520]}],["灵阶","língjiē","对修道者住所台阶的美称。",{"a":1,"w":[7588,7773]}],["青北","qīngběi","即青丘。传说中的古国名。",{"a":1,"w":[3320,132]}],["青坊","qīngfāng","即青宫。皇太子所居之处。",{"a":1,"w":[3320,8643]}],["青墩","qīngdūn","长满青草的土堆。指坟墓。",{"a":1,"w":[3320,8891]}],["青屏","qīngpíng","青色屏障。喻挺拔的山峰。",{"a":1,"w":[3320,7852]}],["青死","qīngsǐ","谓庄稼未黄熟就干旱而死。",{"a":1,"w":[3320,1329]}],["青湓","qīngpén","指源出江西青盆山的湓浦。",{"a":1,"w":[3320,40076]}],["青炬","qīngjù","指磷火。磷火色绿，故称。",{"a":1,"w":[3320,10692]}],["青祝","qīngzhù","谓出青词以授祠官使祭告。",{"a":1,"w":[3320,1473]}],["青符","qīngfú","道教徒用青藤纸画的符箓。",{"a":1,"w":[3320,7841]}],["青霭","qīng'ǎi","指云气。因其色紫，故称。",{"a":1,"w":[3320,15948]}],["青鬟","qīnghuán","黑色环形发髻。借指美人。",{"a":1,"w":[3320,17780]}],["青鹢","qīngyì","水鸟名。即鹢。俗称青雀。",{"a":1,"w":[3320,17157]}],["靖享","jìngxiǎng","谓周密地考虑，以使称职。",{"a":1,"w":[9378,8182]}],["靖步","jìngbù","犹安步，徐步。缓缓步行。",{"a":1,"w":[9378,1337]}],["靖约","jìngyuē","清静简约。靖，通“静”。",{"a":1,"w":[9378,1330]}],["靓审","jìngshěn","精密周详。靓，通“靖”。",{"a":1,"w":[14018,7781]}],["靓雅","jìngyǎ","幽静文雅。靓，通“静”。",{"a":1,"w":[14018,7788]}],["静悟","jìngwù","佛教语。谓于静定中领悟。",{"a":1,"w":[1386,8707]}],["静众","jìngzhòn