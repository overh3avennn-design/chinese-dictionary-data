30,4751]}],["纳贽","nàzhì","初次拜见长者时馈赠礼物。",{"a":1,"w":[7454,14613]}],["紞然","dǎnrán","象声词。形容似击鼓之声。",{"a":1,"w":[54670,7451]}],["素壁","sùbì","白色的墙壁、山壁、石壁。",{"a":1,"w":[7468,7850]}],["素帐","sùzhàng","白色帐幕。一般用于丧事。",{"a":1,"w":[7468,8011]}],["素腕","sùwàn","白晰的手腕。多用于女子。",{"a":1,"w":[7468,9173]}],["紫岩","zǐyán","紫色山崖。多指隐者所居。",{"a":1,"w":[3348,7558]}],["累席","lèixí","多层坐垫。形容生活优裕。",{"a":1,"w":[173,7836]}],["绌约","chùyuē","绌退穷困。绌，通“黜”。",{"a":1,"w":[15971,1330]}],["绌臣","chùchén","贬逐之臣。绌，通“黜”。",{"a":1,"w":[15971,8045]}],["结驩","jiéhuān","亦作“结欢”。与人交好。",{"a":1,"w":[2271,20929]}],["绦索","tāosuǒ","用作装饰的丝带丝绳之类。",{"a":1,"w":[10964,7470]}],["给舍","gěishě","给事中及中书舍人的并称。",{"a":1,"w":[112,7531]}],["绛膜","jiàngmó","红色薄膜。多指果的内皮。",{"a":1,"w":[11965,4711]}],["絻钺","miǎnyuè","古代礼冠和兵器。喻奖惩。",{"a":1,"w":[46699,13368]}],["绡绮","xiāoqǐ","泛指有花纹的轻薄丝织物。",{"a":1,"w":[22878,9776]}],["绿罽","lǜjì","绿色毛毡。比喻绿色草地。",{"a":1,"w":[605,25509]}],["绿舌","lǜshé","茶叶。以其形似舌，故名。",{"a":1,"w":[605,7844]}],["绸厚","chóuhòu","稠密深厚。绸，通“稠”。",{"a":1,"w":[9638,2336]}],["纲船","gāngchuán","旧时成批载运货物之船队。",{"a":1,"w":[8152,621]}],["缀疣","zhuìyóu","赘疣。比喻多余无用之物。",{"a":1,"w":[9248,9391]}],["绮诗","qǐshī","指描写男女爱情的香艳诗。",{"a":1,"w":[9776,2369]}],["绵丽","miánlì","犹靡丽。多形容词藻华美。",{"a":1,"w":[8228,7634]}],["线靴","xiànxuē","线制的靴。古代妇人所穿。",{"a":1,"w":[1282,9886]}],["缘心","yuánxīn","佛教语。谓攀缘事物之心。",{"a":1,"w":[7628,1279]}],["緪幅","gēngfú","犹通篇。谓文章从头到尾。",{"a":1,"w":[30303,3454]}],["练文","liànwén","比喻像白练飘动般的波纹。",{"a":1,"w":[633,7415]}],["练祥","liànxiáng","小祥与大祥。均古代祭礼。",{"a":1,"w":[633,8467]}],["练衲","liànnà","漂染过的僧衣。借指僧人。",{"a":1,"w":[633,13498]}],["缊韨","yūnfú","古代祭服上的浅赤色蔽膝。",{"a":1,"w":[13161,67942]}],["县联","xiànlián","指椽子和屋檐木相接之处。",{"a":1,"w":[2279,7455]}],["缪卜","móubo","虔诚占卜。缪，通“穆”。",{"a":1,"w":[9670,8005]}],["缠商","chánshāng","我国西北部缠回之经商者。",{"a":1,"w":[8409,7485]}],["缨笏","yīnghù","冠带和手板。亦借指官吏。",{"a":1,"w":[9033,11446]}],["缨组","yīngzǔ","结冠的丝带。亦借指官宦。",{"a":1,"w":[9033,558]}],["纤弓","xiāngōng","比喻旧时女子缠过的小脚。",{"a":1,"w":[7725,8097]}],["纤笋","xiānsǔn","比喻旧时缠足女子的小脚。",{"a":1,"w":[7725,8811]}],["纤经","xiānjīng","细丝。亦指细丝结成的网。",{"a":1,"w":[7725,7421]}],["纤质","xiānzhì","犹弱质。亦比喻才能低下。",{"a":1,"w":[7725,7436]}],["罪籍","zuìjí","罪犯的名册。亦泛指罪戾。",{"a":1,"w":[4686,7983]}],["罪谪","zuìzhé","古代官吏因罪降调或流放。",{"a":1,"w":[4686,11409]}],["骂倨","màjù","箕踞而骂。倨，通“踞”。",{"a":1,"w":[3558,14170]}],["罢直","bàzhí","值班供职完毕。直，当值。",{"a":1,"w":[8239,1294]}],["罗闉","luóyīn","古时军营周围的宵禁设施。",{"a":1,"w":[7420,98669]}],["羁心","jīxīn","亦作“羇心”。\n犹旅思。",{"a":1,"w":[9726,1279]}],["羁鞿","jījī","驭马之具。喻牵制、束缚。",{"a":1,"w":[9726,72494]}],["羁鸿","jīhóng","亦作“羇鸿”。\n犹征鸿。",{"a":1,"w":[9726,8788]}],["羊求","yángqiú","汉高士羊仲、求仲的并称。",{"a":1,"w":[1387,598]}],["美懋","měimào","犹美盛。借指美盛的业绩。",{"a":1,"w":[1310,13375]}],["羞月","xiūyuè","形容女子貌美，月见亦羞。",{"a":1,"w":[8434,101]}],["群戏","qúnxì","百戏。古代的散乐、杂技。",{"a":1,"w":[1348,3341]}],["义谋","yìmóu","合宜的谋猷；正义的谋画。",{"a":1,"w":[7437,8000]}],["羸毁","léihuǐ","指身体因哀伤过度而成疾。",{"a":1,"w":[10990,4749]}],["羹藜","gēnglí","煮野菜羹。泛指饮食粗劣。",{"a":1,"w":[9089,8930]}],["羹饘","gēngzhān","菜羹和粥。饘，粥之稠者。",{"a":1,"w":[9089,71975]}],["翁博","wēngbó","同“滃渤”。\n盛大宽广。",{"a":1,"w":[8165,7502]}],["翁妈","wēngmā","方言。对老年妇女的尊称。",{"a":1,"w":[8165,8503]}],["翔博","xiángbó","详实广博。翔，通“详”。",{"a":1,"w":[8986,7502]}],["翔鸿","xiánghóng","高飞的鸿雁。喻当朝之士。",{"a":1,"w":[8986,8788]}],["翠蛟","cuìjiāo","翠色蛟龙。形容滚滚流水。",{"a":1,"w":[7928,14013]}],["翚构","huīgòu","檐角朝上如鸟飞的建筑物。",{"a":1,"w":[23353,7540]}],["翰迹","hànjì","犹笔迹。多指文辞、书牍。",{"a":1,"w":[8206,8080]}],["翻空","fānkōng","形容作文构思时奇想联翩。",{"a":1,"w":[2337,1274]}],["老佣","lǎoyōng","年老的佣工。常用为詈词。",{"a":1,"w":[55,9002]}],["老满","lǎomǎn","方言。兄弟中最小的一个。",{"a":1,"w":[55,592]}],["老驴","lǎolǘ","詈词。谓人老而愚蠢如驴。",{"a":1,"w":[55,8826]}],["考判","kǎopàn","考试定等。常指铨选官吏。",{"a":1,"w":[148,4687]}],["耍事","shuǎshì","可以开玩笑或轻忽的事情。",{"a":1,"w":[4823,33]}],["耗稻","hàodào","方言。谓锄去稻田之杂草。",{"a":1,"w":[7916,9000]}],["耘耨","yúnnòu","犹耕耘。一般指中耕措施。",{"a":1,"w":[11115,13417]}],["耽禅","dānchán","耽味禅悦。亦谓潜心学佛。",{"a":1,"w":[9595,8805]}],["圣范","shèngfàn","圣人和帝王的仪范或画像。",{"a":1,"w":[7587,7808]}],["聘使","pìnshǐ","奉命聘问。亦指聘问之使。",{"a":1,"w":[8784,1332]}],["