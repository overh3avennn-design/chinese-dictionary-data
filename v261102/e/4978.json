4,16684]}],["白鹰","báiyīng","白羽之鹰。古代以为瑞物。",{"a":1,"w":[24,8542]}],["皂钱","zàoqián","旧时迷信，烧给鬼的纸钱。",{"a":1,"w":[8161,138]}],["皇乱","huángluàn","惊慌失措。皇，通“惶”。",{"a":1,"w":[7732,1360]}],["皇娥","huáng'é","传说中古帝少昊氏的母亲。",{"a":1,"w":[7732,10163]}],["皇急","huángjí","惊恐急迫。皇，通“惶”。",{"a":1,"w":[7732,569]}],["皇惧","huángjù","惊慌恐惧。皇，通“惶”。",{"a":1,"w":[7732,8069]}],["皇王","huángwáng","指古圣王。后亦泛指皇帝。",{"a":1,"w":[7732,2278]}],["皇庄","huángzhuāng","明清两代皇室直辖的庄田。",{"a":1,"w":[7732,7932]}],["皇衢","huángqú","专供皇帝车马所行的道路。",{"a":1,"w":[7732,12917]}],["皇迫","huángpò","惊恐急遽。皇，通“惶”。",{"a":1,"w":[7732,8059]}],["皓日","hàorì","明亮的太阳。亦比喻君主。",{"a":1,"w":[11454,50]}],["皓兽","hàoshòu","白色的兽。古代以为瑞物。",{"a":1,"w":[11454,8325]}],["皴染","cūnrǎn","指中国画技法皴法和渲染。",{"a":1,"w":[14378,3355]}],["盗摩","dàomó","谓偷磨金属钱币以取其屑。",{"a":1,"w":[8038,7669]}],["盗明","dàomíng","犹掠美。谓窃取他人智慧。",{"a":1,"w":[8038,7431]}],["盗穵","dàowā","私自偷挖。穵，通“挖”。",{"a":1,"w":[8038,180230]}],["盗迹","dàojì","盗贼的行迹；盗窃的痕迹。",{"a":1,"w":[8038,8080]}],["盗跨","dàokuà","亦作“盗夸”。\n犹盗夸。",{"a":1,"w":[8038,4710]}],["盏托","zhǎntuō","指配套使用的茶盏和托盘。",{"a":1,"w":[10030,4618]}],["盟香","méngxiāng","古人对神盟誓时所燃的香。",{"a":1,"w":[7953,1311]}],["监解","jiānjiě","辨别明白。监，通“鉴”。",{"a":1,"w":[7644,4620]}],["监言","jiānyán","鉴戒之言。监，通“鉴”。",{"a":1,"w":[7644,7440]}],["盘坫","pándiàn","古代祭祀时放饮器的托底。",{"a":1,"w":[2285,32260]}],["盥馈","guànkuì","谓侍奉尊者盥洗及进膳食。",{"a":1,"w":[14244,8692]}],["荡瀁","dàngyàng","亦作“荡漾”。\n波动貌。",{"a":1,"w":[7756,22389]}],["目断","mùduàn","犹望断。一直望到看不见。",{"a":1,"w":[7465,1335]}],["目瞠","mùchēng","即瞠目。形容惊讶的样子。",{"a":1,"w":[7465,21127]}],["盲妹","mángmèi","旧指眼睛失明的卖唱女子。",{"a":1,"w":[8164,8430]}],["盲左","mángzuǒ","春秋鲁太史左丘明的代称。",{"a":1,"w":[8164,154]}],["盲聩","mángkuì","眼瞎耳聋。比喻愚昧无知。",{"a":1,"w":[8164,23646]}],["直史","zhíshǐ","正直的史官；史官的直笔。",{"a":1,"w":[1294,7661]}],["直弦","zhíxián","其直如弦。比喻为人耿直。",{"a":1,"w":[1294,4726]}],["相厉","xiānglì","互相劝勉。厉，通“励”。",{"a":1,"w":[7427,8111]}],["相司","xiāngsī","互相侦察。司，通“伺”。",{"a":1,"w":[7427,7476]}],["相甲","xiāngjiǎ","宋代登进士第五甲的代称。",{"a":1,"w":[7427,3330]}],["相尽","xiāngjǐn","彼此畅