,11321]}],["毕劫","bìjié","犹毕强。敏捷而强劲。",{"a":1,"w":[8120,8458]}],["畦棱","qíléng","田间土垄。泛指田园。",{"a":1,"w":[13583,8100]}],["番夷","fānyí","旧指边境的少数民族。",{"a":1,"w":[4735,7910]}],["画笺","huàjiān","供作画用的精美纸张。",{"a":1,"w":[625,9999]}],["画鱼","huàyú","用有钩的杖划水取鱼。",{"a":1,"w":[625,526]}],["畯明","jùnmíng","贤明。畯，通“俊”。",{"a":1,"w":[24945,7431]}],["畯臣","jùnchén","贤臣。畯，通“俊”。",{"a":1,"w":[24945,8045]}],["当才","dāngcái","才能与所任之事相当。",{"a":1,"w":[552,603]}],["当处","dāngchù","本处；就在那个地方。",{"a":1,"w":[552,2272]}],["畿县","jīxiàn","旧称京都近旁的县份。",{"a":1,"w":[11313,2279]}],["疋乐","pǐlè","雅乐。古代所谓正乐。",{"a":1,"w":[20188,1340]}],["疏孽","shūniè","庶孽。旧指妾生之子。",{"a":1,"w":[7743,9764]}],["疏愚","shūyú","粗疏笨拙；懒散愚昧。",{"a":1,"w":[7743,8545]}],["疏簿","shūbù","旧时僧道募捐的册子。",{"a":1,"w":[7743,8320]}],["疏舛","shūchuǎn","粗略紊乱；疏漏错乱。",{"a":1,"w":[7743,12109]}],["疏香","shūxiāng","清淡的芳香。指梅花。",{"a":1,"w":[7743,1311]}],["疑闷","yímèn","疑惑不解；怀疑纳闷。",{"a":1,"w":[8055,8255]}],["疑玉","yíyù","被人误认为石的璞玉。",{"a":1,"w":[8055,2294]}],["疵毛","cīmáo","吹毛求疵；挑毛拣刺。",{"a":1,"w":[10139,70]}],["疵陋","cīlòu","谓见闻浅陋而好非议。",{"a":1,"w":[10139,9064]}],["疾固","jígù","谓憎恶世俗固塞鄙陋。",{"a":1,"w":[7794,7552]}],["疾瘯","jícù","患皮肤病。指患小病。",{"a":1,"w":[7794,165253]}],["疾秽","jíhuì","体内因病产生的脏物。",{"a":1,"w":[7794,9258]}],["疾跳","jítiào","方言。犹精悍，机灵。",{"a":1,"w":[7794,1404]}],["病像","bìngxiàng","疾病表现出来的症状。",{"a":1,"w":[67,589]}],["病骸","bìnghái","犹病体。用于老年人。",{"a":1,"w":[67,11857]}],["痛念","tòngniàn","谓顾念其痛而抚慰之。",{"a":1,"w":[1417,1422]}],["痞蹇","pǐjiǎn","胸腹郁结，阻滞不通。",{"a":1,"w":[14849,9722]}],["痹下","bìxià","低下。痹，通“庳”。",{"a":1,"w":[10283,17]}],["疡微","yángwēi","溃疡。喻腐朽的现象。",{"a":1,"w":[10719,7512]}],["瘣疾","huìjí","中医指妇女子宫下垂。",{"a":1,"w":[32440,7794]}],["瘦薄","shòubáo","犹瘠薄。土地不肥沃。",{"a":1,"w":[1486,2319]}],["瘦黑","shòuhēi","肌体消瘦，容颜黝黑。",{"a":1,"w":[1486,549]}],["疟渴","nüèkě","中医谓暑疟壮热烦渴。",{"a":1,"w":[11515,236]}],["瘴茅","zhàngmáo","芒茅黄枯时节之瘴疠。",{"a":1,"w":[13064,8079]}],["瘴乡","zhàngxiāng","指南方有瘴气的地方。",{"a":1,"w":[13064,3375]}],["癃废","lóngfèi","衰老病弱，肢体残废。",{"a":1,"w":[32250,7711]}],["癃残","lóngcán","衰老病弱，