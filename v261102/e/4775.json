":[12209,56000]}],["钽铌矿砂","tǎn ní kuàngshā","tantalum and niobium ore; tantalum niobium ore",{"a":1,"w":[619048,8419]}],["铜铵合剂","tóng ǎn héjì","Cal-cop 10; For-Cop 80; For-Cop 80 NC; Oxy-Cop",{"a":1,"w":[4724,10952,13660]}],["陈皮桃条","chénpí táotiáo","preserved peach strip with orange peel extract",{"a":1,"w":[62470,323439]}],["顶端培养","dǐngduān péiyǎng","growing point culture; apical meristem culture",{"a":1,"w":[17674,2524]}],["颉抗作用","jié kàng zuòyòng","antagonism; antagonistic action; counteraction",{"a":1,"w":[12843,7660,640]}],["众喣漂山","zhòngxǔpiāoshān","喣吹气。许多人吹气，能使山漂走。比喻说坏话的人多了，能使人受到很大的损害。也比喻人多力量大。",{"a":1,"w":[7688,48905,7976,45]}],["衣不解带","yībùjiědài","解带解开衣带，指脱衣。因事过度操劳，以致不能脱衣安睡。也形容看护病人十分辛劳（多指对长辈）。",{"a":1,"w":[7536,12975,542]}],["依翠偎红","yīcuìwēihóng","指同年轻女子厮混的风流韵事。翠，翡翠一类饰物；红，脂粉脣膏一类化妆品。翠”与红”均借指女人。",{"a":1,"w":[7713,7928,14479,534]}],["一介不取","yījièbùqǔ","一介一粒芥菜子，形容微小。一点儿小东西也不拿。形容廉洁、守法，不是自己应该得到的一点都不要。",{"a":1,"w":[40583,21228]}],["衙官屈宋","yáguān qūsòng","衙官军府的属官；屈屈原；宋宋玉。要以屈原、宋玉为属官。原为自夸文章好◇也用以称赞别人的文采。",{"a":1,"w":[159863,190555]}],["兴云致雨","xīngyúnzhìyǔ","兴云布下云彩。致雨使下雨。神话传说，神龙有布云作雨的能力。借喻乐曲诗文，声势雄壮，不同凡响。",{"a":1,"w":[7545,554,7666,159]}],["心烦技痒","xīnfán jìyǎng","烦烦燥；技痒指某人想表现其技艺以显示于人。形容擅长及爱好某种技艺，一遇机会就急于表现的情态。",{"a":1,"w":[19837,109232]}],["心膂股肱","xīnlǚ gǔgōng","膂脊骨。股大腿。肱胳膊上从肩到肘的部分。心、膂、股、肱都是人体的重要部分，比喻亲近得力之人。",{"a":1,"w":[123738,72429]}],["逍遥事外","xiāoyáo shìwài","①指犯法者没有受到法律制裁。亦泛指做坏事或与坏事有牵连的人不受追查。②指置身事外，毫不关心。",{"a":1,"w":[19475,33058]}],["萧郎陌路","xiāolángmòlù","萧郎旧时泛指女子所爱恋的男子；陌路过路人。比喻女子对原来爱恋的男子视若路人，不愿或不能接近。",{"a":1,"w":[170970,28389]}],["嘻笑怒骂","xīxiào nùmà","①指嬉戏、欢笑、愤怒、詈骂等不同的情绪表现。②指不拘守规格，率情任意地发挥表现。③嘲弄辱骂。",{"a":1,"w":[111884,74430]}],["息迹静处","xījìjìngchù","息止息；迹行迹，脚印；处处所。要想不见行迹，只有自己静止不动。引申为要想人不知，除非己莫为。",{"a":1,"w":[106374,1386,2272]}],["贪贿无艺","tānhuì wúyì","贿财物；艺标准、准则，引伸为法度、限度。贪求财物没有限度。指反动的统治阶级无限制地搜刮民财。",{"a":1,"w":[181975,86169]}],["檀郎谢女","tánlángxiènǚ","檀郎晋代潘岳小名檀奴，姿仪美好；谢女晋代谢道蕴，聪慧过人，代指才女。指才貌双全的夫妇或情侣。",{"a":1,"w":[122682,7570,98]}],["事齐事楚","shìqíshìchǔ","事侍奉；齐、楚春秋时两大强国。依附齐国呢？还是依附楚国？比喻处在两强之间，不能得罪任何一方。",{"a":1,"w":[33,1347,7905]}],["扇火止沸","shànhuǒzhǐfèi","沸沸腾，指水滚开。用扇风助长火势的办法来停止水沸腾。比喻采取的办法与希望达到的目的正好相反。",{"a":1,"w":[3380,1284,223699]}],["三盈三虚","sānyíngsānxū","盈满。虚空。指孔子的满门弟子，被少正卯讲学所吸引，多次离开孔子之门。形容讲学效果好，影响大。",{"a":1,"w":[74,8251,7779]}],["三户亡秦","sānhùwángqín","三户几户人家；亡灭。虽只几户人家，也能灭掉秦国。比喻正义而暂时弱小的力量，对暴力的必胜信心。",{"a":1,"w":[74,2320,7763,8261]}],["肉眼凡夫","ròuyǎnfánfū","肉眼佛经中说有，天、肉慧、法佛五眼，肉眼为肉身之眼，也泛指俗眼；凡夫指凡人。指尘世平常的人。",{"a":1,"w":[18480,77598]}],["鸣锣喝道","míngluóhèdào","封建时代官吏出门时，前面开路的人敲锣喝令行人让路。比喻为某种事物的出现，制造声势，开辟道路。",{"a":1,"w":[269118,45610]}],["敛后疏前","liǎnhòushūqián","指列阵周密则牢固，前锋队形疏朗则利于战斗◇世将我国古代这一陆战列阵原则概括成敛后疏前”四字。",{"a":1,"w":[8878,43,7743,60]}],["交臂历指","jiāobìlìzhǐ","交臂两手反缚；历指古代拶指的刑罚。象罪犯两手反缚、受拶指的刑罚一般。形容痛苦万状，毫无自由。",{"a":1,"w":[38084,148617]}],["鹪鹩一枝","jiāoliáoyīzhī","鹪鹩小鸟名，以麻发为窝，系于树枝。鹪鹩做窝，只占用一根树枝。比喻一个安身之处或一个工作位置。",{"a":1,"w":[13351,25260]}],["假道灭虢","jiǎdàomièguó","假借；道道路；虢春秋时诸侯国，在今山西平陆及河南三门峡一带。泛指用借路的名义而灭亡这个国家。",{"a":1,"w":[34012,4709,15502]}],["及笄年华","jíjīniánhuá","笄古代盘头发用的簪子。古代女子已订婚者十五而笄；未订婚者二十而笄。指少女到了可以出嫁的年龄。",{"a":1,"w":[128090,31411]}],["极口项斯","jíkǒu xiàng sī","指满口赞誉。项斯、唐代诗人，为杨敬之所器重，敬之赠诗有平生不解藏人善，到处逢人说项斯”之句。",{"a":1,"w":[89649,2342,7406]}],["红腐贯朽","hóngfǔguànxiǔ","红腐粮食经久腐坏，颜色变成红赤色。贯朽穿铜线的绳索因天长日久而朽烂。形容资财充足，钱粮无数。",{"a":1,"w":[100146,8062,9194]}],["桂林杏苑","guìlín xìng yuàn","古时乡试例在农历八月举行，考中称折桂；会试例在农历三月举行，考中称探杏。因以之指乡试、会试。",{"a":1,"w":[16074,9579,9274]}],["光前绝后","guāng qián juéhòu","光光大，扩充；绝断绝。扩充了前人所不及的事，做出了后人难以做到的事。形容功业伟大或成就卓著。",{"a":1,"w":[1271,60,27203]}],["顾影弄姿","gùyǐngnòngzī","顾影看着自己的身影；弄姿做出各种姿态。对着自己的身影，做出各种姿态。形容卖弄身形，自我欣赏。",{"a":1,"w":[66196,61478]}],["范张鸡黍","fàn zhāng jīshǔ","范范式；张张劭；鸡禽类；黍草本植物，指黍子。范式、张劭一起喝酒食鸡。比喻朋友之间含义与深情。",{"a":1,"w":[7808,1333,125738]}],["顿首再拜","dùnshǒu zàibài","顿首以头叩地而拜；再拜拜两次。古代的一种跪拜礼。亦指旧时信札中常用作向对方表示敬意的客套语。",{"a":1,"w":[57958,69426]}],["董狐直笔","dǒnghú zhíbǐ","董狐春秋时晋国的史官。直笔根据事实，如实记载。指敢于秉笔直书，尊重史实，不阿权贵的正直史家。",{"a":1,"w":[103917,169954]}],["迭矩重规","diéjǔchóngguī","规与规相重，矩矩与相迭，度数相同，完全符合。原比喻动静合乎法度或上下相合，后形容模仿、重复。",{"a":1,"w":[8155,8181,49,7549]}],["叠矩重规","diéjǔchóngguī","规与规相重，矩矩与相迭，度数相同，完全符合。原比喻动静合乎法度或上下相合，后形容模仿、重复。",{"a":1,"w":[8025,8181,49,7549]}],["德言容功","déyán róng gōng","德妇德，品德。言言辞。容容貌。功女红（旧指女子所做的针线活）。封建礼教要求妇女应具备的品德。",{"a":1,"w":[66834,7524,7516]}],["单兵孤城","dānbīnggūchéng","单兵寡弱无援的军队；孤城孤立无依的城池。形容军队及其驻军的城池孤立无依，势力单薄，没有外援。",{"a":1,"w":[26723,96345]}],["嗔目切齿","chēnmùqiēchǐ","chēn mù qiè chǐ 嗔目发怒时睁大眼睛。瞪大眼睛，咬紧牙齿。形容极端愤怒的样子。",{"a":1,"w":[318242,23539]}],["猜枚行令","cāiméixínglìng","猜枚一种酒令，原指手中握若干小物件供人猜测单双、数目等。现亦指划拳。行令行酒令∪酒时行酒令。",{"a":1,"w":[103071,44836]}],["剥床及肤","bōchuángjífū","剥六十四卦之一，坤下艮上，意即剥落、烂；及到。原指损害及于肌肤◇形容迫切的灾害或深切的痛苦。",{"a":1,"w":[8572,183,7593,8232]}],["擘两分星","bòliǎngfēnxīng","指很小的重量都分辨得清清楚楚。比喻准确清楚。两，较小的重量单位；星，秤杆上标记斤两的小点子。",{"a":1,"w":[12672,52643,7443]}],["五花判事","wǔhuā pànshì","唐宋时，中书省各官员，对军国大事因所见不同，须分别在文书上签具意见并署名，谓之“五花判事”。",{"a":1,"w":[18964,141532]}],["佉卢虱咤","qūlú shī zhà","亦作“佉卢”。\n译作“佉路瑟吒”。梵语的音译，佛教传说中的人物，曾创制横书左行的古印度文字。",{"a":1,"w":[107302,9142,11097]}],["前三后四","qiánsān hòu sì","隋唐至宋风俗，以冬至、元正、寒食为大节，放假七日，其中节前三日，节后四日，俗称“前三后四”。",{"a":1,"w":[29150,43,86]}],["完白山人","wán báishān rén","清代着名书法家、篆刻家邓石如的别号。因其居皖公山下，故称。参阅《清史稿‧艺术传二‧邓石如》。",{"a":1,"w":[604,12420,3]}],["山公酩酊","shān gōng mǐngdǐng","同“山简醉”。\n唐李白《鲁郡尧祠送窦明府薄华还西京》诗：“高阳小饮真琐琐，山公酩酊如何我？”",{"a":1,"w":[61578,59213]}],["悬弧射矢","xuánhú shè shǐ","古俗生子，除在门左悬弧外，满三天，还要由“射人以桑弧蓬矢六，射天地四方。”见《礼记‧内则》。",{"a":1,"w":[193995,3312,8270]}]]