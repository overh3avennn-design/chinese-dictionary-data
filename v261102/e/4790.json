[["赭魁","zhěkuí","草名。有汁赤如赭，可染色。",{"a":1,"w":[10645,8560]}],["赴曲","fùqū","应合曲调的节奏旋律；合拍。",{"a":1,"w":[8928,7517]}],["起伯","qǐbó","兴起并称霸。伯，通“霸”。",{"a":1,"w":[29,7608]}],["起牌","qǐpái","斗牌时将牌从桌面上拈起来。",{"a":1,"w":[29,2344]}],["起节","qǐjié","谓负有皇命的使节动身起程。",{"a":1,"w":[29,540]}],["起颇","qǐpǒ","战国名将白起和廉颇的并称。",{"a":1,"w":[29,4897]}],["趁意","chènyì","称心；满意。趁，通“称”。",{"a":1,"w":[3570,7482]}],["趁贴","chèntiē","谓过求贴切。趁，通“衬”。",{"a":1,"w":[3570,2356]}],["趑趑","zīzī","欲进又退、小心翼翼的样子。",{"a":1,"w":[60189]}],["赵宋","zhàosòng","指宋朝。因皇室姓赵，故称。",{"a":1,"w":[8536,8357]}],["趋俗","qūsú","随合时俗，与世俗同流合污。",{"a":1,"w":[8388,7904]}],["趋营","qūyíng","亦作“趍营”。\n奔走钻营。",{"a":1,"w":[8388,7572]}],["趋锵","qūqiāng","形容朝拜、进谒时步趋中节。",{"a":1,"w":[8388,24620]}],["趾错","zhǐcuò","履迹交错。比喻人来往之多。",{"a":1,"w":[9001,147]}],["跂立","qílì","踮起脚跟而立。谓可以盼见。",{"a":1,"w":[15287,3314]}],["跋滞","bázhì","谓排除危难。跋，通“拔”。",{"a":1,"w":[9818,8309]}],["跑碴","pǎochá","谓忙于一些引起争执的事情。",{"a":1,"w":[166,10093]}],["距战","jùzhàn","抗击；抵御。距，通“拒”。",{"a":1,"w":[7632,7438]}],["距逆","jùnì","违背；拒绝。距，通“拒”。",{"a":1,"w":[7632,7762]}],["跨刀","kuàdāo","挎着腰刀。跨，用同“挎”。",{"a":1,"w":[4710,1369]}],["跨历","kuàlì","谓经历过不同的朝代或时期。",{"a":1,"w":[4710,7643]}],["跪乘","guìchéng","在车上跪着驾乘。表示敬意。",{"a":1,"w":[4980,3366]}],["跱跖","zhìzhí","停步踏足。喻笛声乍起于地。",{"a":1,"w":[159772,9805]}],["局躬","júgōng","犹言弯腰曲背。喻惶恐不安。",{"a":1,"w":[2291,9213]}],["踏场","tàchǎng","按照乐调节拍在戏台上舞蹈。",{"a":1,"w":[4781,544]}],["踏筵","tàyán","以脚踏地为节拍，当宴歌舞。",{"a":1,"w":[4781,9831]}],["踏赏","tàshǎng","亦作“蹋赏”。\n踏青赏景。",{"a":1,"w":[4781,2415]}],["踏雨","tàyǔ","亦作“蹋雨”。\n冒雨而行。",{"a":1,"w":[4781,159]}],["践妖","jiànyāo","应验怪异现象所预示的兆头。",{"a":1,"w":[8701,8617]}],["践灭","jiànmiè","摧残，除灭。践，通“剪”。",{"a":1,"w":[8701,4709]}],["踞见","jùjiàn","踞坐而见客。形容待人傲慢。",{"a":1,"w":[12088,76]}],["踧笮","cùzé","压榨，挤压。踧，通“蹙”。",{"a":1,"w":[34207,28088]}],["踧迫","cùpò","逼迫；欺压。踧，通“蹙”。",{"a":1,"w":[34207,8059]}],["踩屣","cǎixǐ","亦作“跴屣”。\n趿着鞋走。",{"a":1,"w":[3567,15726]}],["踩界","cǎijiè","方言。丈量田地后划定界线。",{"a":1,"w":[3567,4639]}],["踩追","cǎizhuī","亦作“跴追”。\n跟踪追寻。",{"a":1,"w":[3567,1408]}],[