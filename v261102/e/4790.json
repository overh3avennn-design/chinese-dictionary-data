":1,"w":[574,34013]}],["近庙","jìnmiào","古时谓高祖以下祖先的宗庙。",{"a":1,"w":[574,8514]}],["近谤","jìnbàng","照应，照料。谤，通“傍”。",{"a":1,"w":[574,9810]}],["返攻","fǎngōng","谓反正的人向原属营垒进攻。",{"a":1,"w":[8365,7761]}],["迢断","tiáoduàn","犹超断。谓超脱罪行的判决。",{"a":1,"w":[21283,1335]}],["迫筰","pòzuó","迫促；急促。筰，通“迮”。",{"a":1,"w":[8059,37014]}],["回扃","huíjiōng","犹回车。扃，谓兵车前横木。",{"a":1,"w":[79,15982]}],["迷性","míxìng","佛教语。指不明佛道的心性。",{"a":1,"w":[1384,1275]}],["迸伏","bèngfú","隐伏，逃匿。迸，通“屏”。",{"a":1,"w":[13835,7729]}],["迸地","bèngdì","1) 落地。\n2) 破土。",{"a":1,"w":[13835,10]}],["迸阶","bèngjiē","穿阶。从台阶缝隙中冒出来。",{"a":1,"w":[13835,7773]}],["追班","zhuībān","谓百官按位次排列谒见皇帝。",{"a":1,"w":[1408,135]}],["追养","zhuīyǎng","谓祭祀死者，继尽孝养之道。",{"a":1,"w":[1408,582]}],["逃限","táoxiàn","旧指不能遵照期限完纳钱粮。",{"a":1,"w":[3455,7616]}],["逆尸","nìshī","犹迎尸。古代祭祀仪式之一。",{"a":1,"w":[7762,7967]}],["逆斥","nìchì","1) 排斥。\n2) 预测。",{"a":1,"w":[7762,8735]}],["逆曳","nìyè","谓受迫而不能按照正道行事。",{"a":1,"w":[7762,8838]}],["逆牲","nìshēng","犹迎牲。古代祭祀仪式之一。",{"a":1,"w":[7762,9334]}],["逆见","nìjiàn","1) 预见。\n2) 迎见。",{"a":1,"w":[7762,76]}],["逋刻","būkè","旧指交易中的拖欠刻剥现象。",{"a":1,"w":[11530,626]}],["逐凌","zhúlíng","谓驱赶对方，并凌驾于其上。",{"a":1,"w":[7970,8382]}],["途毙","túbì","谓因贫病冻饿而死在道路上。",{"a":1,"w":[8207,9775]}],["逖慕","tìmù","仰慕，仰望思慕。表示恭敬。",{"a":1,"w":[18378,8745]}],["通域","tōngyù","指交通发达、风气开通之地。",{"a":1,"w":[518,7823]}],["通怀","tōnghuái","谓互相交流情意，抒发胸怀。",{"a":1,"w":[518,7749]}],["通衔","tōngxián","两人以上共同领受某一职责。",{"a":1,"w":[518,8703]}],["逞笔","chěngbǐ","放任笔墨；毫无拘束地写作。",{"a":1,"w":[9682,619]}],["速拙","sùzhuō","指智力的高下；聪明或笨拙。",{"a":1,"w":[7497,9782]}],["造谊","zàoyì","谓创立新义。谊，通“义”。",{"a":1,"w":[1319,9604]}],["逢池","féngchí","古泽名。在今河南开封东南。",{"a":1,"w":[4797,7815]}],["连案","lián'àn","谓食案相接。形容关系亲密。",{"a":1,"w":[1288,7610]}],["连舰","liánjiàn","连结在一起的大型军用船只。",{"a":1,"w":[1288,8497]}],["连踪","liánzōng","踪迹相连。比喻追随，相随。",{"a":1,"w":[1288,8226]}],["连毂","liángǔ","一车接一车。形容车辆众多。",{"a":1,"w":[1288,9869]}],["进拜","jìnbài","按一定的礼节给人加官升爵。",{"a":1,"w":[71,7752]}],["进叙","jìnxù","谓按等级次第以进职或奖功。",{"a":1,"w":[71,8462]}],["进率","jìnlǜ",