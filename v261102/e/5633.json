[["卖富差贫","màifùchàpín","指对于富人，得钱便予以免除差役；对于穷人，便任意征派劳役。",{"a":1,"w":[154808,121,7999]}],["卖官贩爵","màiguān fàn jué","形容政治腐败，统治阶级靠出卖官职来搜刮财富。同卖官鬻爵”。",{"a":1,"w":[78445,8945,8494]}],["烈火辨日","lièhuǒ biàn rì","在烈火中能辨别玉的好坏。比喻在关键时刻能看出一个人的节操。",{"a":1,"w":[35294,8004,50]}],["临难铸兵","línnànzhùbīng","临到危难时，方才铸造兵器。比喻平时不作准备，临时才想办法。",{"a":1,"w":[35647,8547,2282]}],["两鼠斗穴","liǎngshǔdòuxué","比喻敌对双方在地势险狭的地方相遇，只有勇往直前的才能获胜。",{"a":1,"w":[96,3351,7477,8147]}],["立人达人","lìrén dárén","立建树，成就；达发达，显贵。旧指帮助人建立功业，提高地拉。",{"a":1,"w":[15891,13453]}],["连天烽火","liántiān fēnghuǒ","烽火古时边防报警的烟火，比喻战火或战争。形容战火烧遍各地。",{"a":1,"w":[29251,20752]}],["窥间伺隙","kuījiànsìxì","窥暗中观察；伺守候，等待机会。暗中观察，准备伺机采取行动。",{"a":1,"w":[145611,323621]}],["恐后无凭","kǒng hòu wúpíng","怕以后没有个凭证。旧时契约文书的套语，常与立次存照”连用。",{"a":1,"w":[7807,43,30944]}],["开柙出虎","kāixiáchūhǔ","柙关猛兽的木笼。原指负责看管的人未尽责任◇多比喻放纵坏人。",{"a":1,"w":[31,21440,22,3337]}],["慨当以慷","kǎidāngyǐkāng","与慷慨”意思相同，指充满正气，情绪激动。当以”无实际意义。",{"a":1,"w":[10398,552,2262,16943]}],["侃侃谔谔","kǎnkǎn è'è","侃侃理直气壮，从容不迫；谔谔说话正直。说话正直，理直气壮。",{"a":1,"w":[54711,50698]}],["尻舆神马","kāo yú shénmǎ","指以尻为车舆而神游◇为随心所欲遨游自然之典。同尻轮神马”。",{"a":1,"w":[14476,8330,30358]}],["举无遗策","jǔ wúyí cè","举提出；策计谋、办法。提出的计谋没有失算的。形容足智多谋。",{"a":1,"w":[606,18630,7673]}],["九牛一毫","jiǔ niúyī háo","九条牛身上的一根毛。比喻极大数量中极微小的数量，微不足道。",{"a":1,"w":[143,52617,7913]}],["鲸吸牛饮","jīng xī niúyǐn","鲸吸像鲸鱼吸水一样。如鲸吸百川，似牛饮池水。比喻放量狂饮。",{"a":1,"w":[9055,2331,286652]}],["敬上爱下","jìngshàng'àixià","敬尊敬。尊敬在己之上者，爱护在己之下者。形容待人谦恭有礼。",{"a":1,"w":[138631,131,17]}],["进退无门","jìntuì wúmén","前进无路，后退无门。形容处境十分困难，进退两难，无处容身。",{"a":1,"w":[12556,17910]}],["荆棘铜驼","jīngjí tóng tuó","铜驼铜制的骆驼，古代置于宫门外。形容国土沦陷后残破的景象。",{"a":1,"w":[14350,4724,8671]}],["惊鸿艳影","jīnghóngyànyǐng","惊鸿轻捷飞起的鸿雁。形容女子轻盈艳丽的身影。多就远望而言。",{"a":1,"w":[124035,8710,7513]}],["进本退末","jìnběntuìmò","本根本；末枝节。指重视根本、主要的东西，抑制直接、次要的。",{"a":1,"w":[71,42,1371,2329]}],["金口御言","jīnkǒu yù yán","旧时用以指天子之言◇泛指说话正确，不能改变。同金口玉音”。",{"a":1,"w":[18997,7809,7440]}],["金石之功","jīnshízhīgōng","金指钟鼎类。石指碑碣类。刻在钟鼎碑碣之上，永不磨灭的功勋。",{"a":1,"w":[10584,2254,7516]}],["金台市骏","jīntáishìjùn","犹言千金市骨。指不惜以高价买养骏马。比喻延揽贤才十分诚恳。",{"a":1,"w":[168571,183415]}],["结不解缘","jiébùjiěyuán","缘缘分。形容男女热恋，不能分开。也指两者有不可分开的缘分。",{"a":1,"w":[194568,7628]}],["郊寒岛瘦","jiāohándǎoshòu","本指孟郊、贾岛简啬孤峭的诗歌风格◇用以形容诗文类似的意境。",{"a":1,"w":[9158,7631,4689,1486]}],["矫尾厉角","jiǎowěilìjiǎo","形容逞强好胜、趾高气扬的模样。矫尾，翘尾巴。厉角，磨头角。",{"a":1,"w":[8697,7474,8111,533]}],["兼包并畜","jiānbāobìngchù","把不同内容、不同性质的东西收下来，保存起来。同兼收并蓄”。",{"a":1,"w":[282952,1377,8349]}],["蒹葭伊人","jiānjiā yīrén","蒹葭初生的芦苇；伊人那个人。指一心寻求思恋而不曾会面的人。",{"a":1,"w":[86156,74633]}],["俭腹高谈","jiǎnfù gāotán","俭腹腹中空空，比喻知识匮乏。腹中知识匮乏，却喜欢高谈阔论。",{"a":1,"w":[222296,38400]}],["寄兴寓情","jìxìngyùqíng","寄寄托；寓含；兴兴致。指作品中寄托饱含了作者的兴致与情怀。",{"a":1,"w":[2358,7545,134165]}],["济窍飘风","jìqiàopiāofēng","指大风止则所有的窍孔都空寂无声◇比喻毫无影响与作用的事物。",{"a":1,"w":[7522,9246,160539]}],["饥附饱飏","jīfùbǎoyáng","附依附，归附；扬飞扬。不得志时即来依附，得志时便远走高飞。",{"a":1,"w":[8569,7718,654,72942]}],["火伞高张","huǒsǎn gāo zhāng","火伞比喻夏天太阳酪烈；张展开。形容夏天烈日当空，十分炎热。",{"a":1,"w":[195044,362821]}],["击钟陈鼎","jīzhōngchéndǐng","钟古代乐器；鼎古代炊器。击钟列鼎而食。形容贵族的豪华排场。",{"a":1,"w":[7506,1410,7893,8230]}],["击筑悲歌","jīzhùbēigē","击敲击；筑古乐器名。敲击着筑，唱着悲壮的歌。形容慷慨悲歌。",{"a":1,"w":[118593,108753]}],["浑浑沌沌","húnhún dùndùn","混杂、不分明的样子，也指糊涂无知的样子，形容迷糊，不清醒。",{"a":1,"w":[55651,128103]}],["黄麻紫书","huángmá zǐshū","皇帝的文告，用黄麻纸书写，用紫泥封缄，故称。同黄麻紫泥”。",{"a":1,"w":[17458,193983]}],["恍然若失","huǎngránruòshī","恍恍惚惚的好像失去了什么似的。形容心神不宁，不知如何是好。",{"a":1,"w":[41449,4652,7527]}],["恢廓大度","huīkuòdàdù","恢廓宽大，开阔。心胸开阔，气量宏大，不计较个人的利害得失。",{"a":1,"w":[103519,46022]}],["画卵雕薪","huàluǎn diāo xīn","在鸡蛋、薪木上雕画图形。是古代富豪生活穷奢极侈的一种表现。",{"a":1,"w":[269928,8192,8398]}],["红装素裹","hóngzhuāng sùguǒ","指衣着淡雅的妇女。也形容雪后天晴，红日和白雪相映衬的景色。",{"a":1,"w":[534,532,116907]}],["函盖乾坤","hángàiqiánkūn","佛教语。原指泯合无间◇指言语诗文契理或一心专志而绝无杂念。",{"a":1,"w":[7764,2289,19162]}],["国之干城","guózhīgānchéng","干城批御敌的武器和工具，这里比喻捍卫者。国家主权的捍卫者。",{"a":1,"w":[23,2254,40226]}],["海内无双","hǎinèiwúshuāng","海内四海之内，旧指中国，现亦指世界各地。四海之内独一无二。",{"a":1,"w":[44389,22688]}],["海水难量","hǎishuǐnánliáng","海水是不可以去量的。比喻不可根据某人的现状就低估他的未来。",{"a":1,"w":[2614,265768]}],["诡秘莫测","guǐmìmòcè","诡秘神秘不可知；莫测无法捉摸。指人的行为态度神秘难以揣测。",{"a":1,"w":[59160,29351]}],["贵不可言","guìbùkěyán","旧时多用以称人贵有帝王、母后之相。此话不能直言，故婉称之。",{"a":1,"w":[167,168593]}],["贵远鄙近","guìyuǎnbǐjìn","以为与当世相隔久远的就珍贵，相隔近的就低贱。同贵远贱近”。",{"a":1,"w":[167,103,219395]}],["瞽言萏议","gǔyán dàn yì","萏议草野之人的议论。盲人和草野平民的言论。常用作自谦之辞。",{"a":1,"w":[170959,86098,7521]}],["孤标独步","gūbiāo dúbù","孤标独特的标格；独步超群出众，独一无二。形容品格极其清高。",{"a":1,"w":[174466,24341]}],["歌莺舞燕","gēyīngwǔyàn","歌声宛转如黄莺，舞姿轻盈如飞燕。亦形容景色宜人，形势大好。",{"a":1,"w":[208,8499,3356,7821]}],["高不可登","gāobùkědēng","形容难以达到。也形容人高高在上，使人难接近。同高不可攀”。",{"a":1,"w":[35,8014,2316]}],["高人一筹","gāorén yīchóu","高人比一般人高；筹筹码。比一般人高出一个筹码。指胜过别人。",{"a":1,"w":[13077,14042]}],["高枕安寝","gāozhěn ānqǐn","垫高枕头安心地睡觉。形容无忧无虑。平安无事。同高枕而卧”。",{"a":1,"w":[23412,413516]}],["改是成非","gǎishìchéngfēi","是正确的，对的；非错误的。把正确的改成错误的。指颠倒是非。",{"a":1,"w":[620,48,517,2265]}],["甘棠遗爱","gāntáng yí'ài","甘棠木名，即棠梨；遗留；爱恩惠恩泽。旧时颂扬离去的地方官。",{"a":1,"w":[87797,71673]}],["负老携幼","fùlǎoxiéyòu","背着老人，带着孩子。形容百姓全体出动，流离失所的悲惨情景。",{"a":1,"w":[4638,55,8623,8210]}],["扶摇万里","fúyáowànlǐ","扶摇急剧盘旋而上的暴风。暴风从下而上盘旋很高，风势急且大。",{"a":1,"w":[41787,11357]}],["俯拾仰取","fǔshíyǎngqǔ","低头拾地上的东西，抬头拿上面的东西。形容一举一动都有收获。",{"a":1,"w":[46565,4742,580]}],["釜中游鱼","fǔzhōngyóuyú","在锅里游着的鱼。比喻处在绝境中的人。也比喻即将灭亡的事物。",{"a":1,"w":[9506,37186,526]}],["风中秉烛","fēngzhōngbǐngzhú","秉拿着。风中拿着烛易灭。比喻临近死亡的人或行将消灭的事物。",{"a":1,"w":[44,7,71698]}],["返朴还真","fǎnpǔhuánzhēn","去掉外饰，还其本质。比喻回复原来的自然状态。同返朴归真”。",{"a":1,"w":[8365,9097,129,85]}],["恩不放债","ēnbùfàngzhài","对亲人不宜放债。意指免因钱财交往而致发生怨怼。恩，指亲人。",{"a":1,"w":[7704,0,63871]}],["发蒙振聩","fāméngzhènkuì","声音很大，连耳聋的人也听得见。比喻用语言文字唤醒麻木的人。",{"a":1,"w":[53990,7579,23646]}],["发言盈庭","fāyányíngtíng","盈满。形容好多人聚在一起议论，意见纷纷，得不出一致的结论。",{"a":1,"w":[1968,152986]}],["发综指示","fāzōngzhǐshì","猎人发现野兽的踪迹，指示猎狗跟踪追捕。比喻在后面操纵指挥。",{"a":1,"w":[522,257756,593]}],["蠹众木折","dùzhòngmùzhé","蛀虫多了，木头就要折断。比喻不利的因素多了，就能造成灾祸。",{"a":1,"w":[9819,7688,7435,2292]}],["断雁孤鸿","duànyàn gūhóng","鸿鸿雁。离了群的孤独大雁。比喻孤身独处，多指未成婚的男子。",{"a":1,"w":[171221,184009]}],["钝学累功","dùnxuélèigōng","钝迟钝，笨拙；累积聚。愚笨的人只要刻苦学习，也能取得成就。",{"a":1,"w":[8549,13,173,7516]}],["独异于人","dú yìyú rén","独独自，单独；异不同。独自与别人不同的。一般指不同于世俗。",{"a":1,"w":[7561,55897,3]}],["冬日夏云","dōngrì xià yún","冬天的太阳，夏天的云层。比喻人态度温和可亲，使人愿意接近。",{"a":1,"w":[31532,1397,554]}],["动人心魄","dòngrén xīnpò","魄迷信者指依附人形体而存在的精神。形容使人感动或令人震惊。",{"a":1,"w":[1911,135639]}],["动心忍性","dòngxīn rěnxìng","动心使内心惊动；忍性使性格坚韧。指不顾外界阻力，坚持下去。",{"a":1,"w":[30136,88321]}],["鼎镬如饴","dǐnghuò rú yí","饴麦芽糖，糖浆。受酷刑像吃糖一样。形容无所畏惧，视死如归。",{"a":1,"w":[36061,4614,16832]}],["鼎食钟鸣","dǐngshízhōngmíng","钟古代乐器；鼎古代炊器。击钟列鼎而食。形容贵族的豪华排场。",{"a":1,"w":[72926,108163]}],["簟纹如水","diànwénrúshuǐ","簟竹。竹席细密的纹理像清凉的水一样。常用以形容夏夜的清凉。",{"a":1,"w":[25859,7745,4614,11]}],["瞪眼咋舌","dèngyǎnzéshé","睁着眼睛，说不出话来。形容神情紧张或很吃惊。同瞪目结舌”。",{"a":1,"w":[15940,92117]}],["砥砺琢磨","dǐlìzhuómó","琢磨雕刻和打磨玉石。比喻磨练自己的品德，在学业上不断上进。",{"a":1,"w":[31861,6742]}],["谠言直声","dǎngyán zhíshēng","谠言公正的言论；直正直的。公正的、正直的、理直气壮的言论。",{"a":1,"w":[287344,135702]}],["大事去矣","dàshìqùyǐ","去失去。形容事情无法挽回了。多指政权丧失，国家灭亡等大事。",{"a":1,"w":[3735,61,8637]}],["大辩不言","dàbiànbùyán","大辩善于辩论。有口才、善于辩论的人，并不多说话以显示自己。",{"a":1,"w":[95632,14788]}],["刺心刻骨","cìxīnkègǔ","①犹刻骨铭心。指感念至深。②亦作刺心切骨”。内心极其悲愤。",{"a":1,"w":[110573,32887]}],["簇锦团花","cù jǐn tuánhuā","簇聚成团。锦有花纹的丝织品。形容五色缤纷，繁华艳丽的景象。",{"a":1,"w":[9140,7982,37593]}],["摧坚陷阵","cuījiān xiànzhèn","摧击溃；坚锋芒，引伸为精锐；陷攻入。攻入并摧毁敌军的阵地。",{"a":1,"w":[199806,47746]}],["纯一不杂","chúnyībùzá","纯纯粹；一单一；杂驳杂，不纯洁。形容纯粹、单一，没有杂质。",{"a":1,"w":[31611,221213]}],["楚得楚弓","chǔdéchǔgōng","楚国人丢失弓，拾到的仍是楚国人。比喻虽有所失，而利未外溢。",{"a":1,"w":[7905,520,8097]}],["持满戒盈","chímǎn jiè yíng","端盛满之水而留心不外溢。比喻居高位而能警戒自己不骄傲自满。",{"a":1,"w":[149313,3377,8251]}],["车尘马足","chēchénmǎzú","①指车马奔波。亦喻人世俗事。②指代车骑。敬称对方时亦用之。",{"a":1,"w":[32,7843,594694]}],["猖獗一时","chāngjué yīshí","猖獗凶猛而放肆。形容坏人或反动势力一时间显得特别凶猛放肆。",{"a":1,"w":[47441,4910]}],["阐扬光大","chǎnyángguāngdà","发扬光大。指使美好的事物在原来基础上不断发展、扩大和提高。",{"a":1,"w":[91099,24763]}],["藏怒宿怨","cángnùsùyuàn","藏、宿存留。把愤怒和怨恨藏留在心里。指心怀怨恨，久久难消。",{"a":1,"w":[298152,147486]}],["才短思涩","cáiduǎnsīsè","才才识。短短浅。涩迟钝。见识短浅，思路迟钝。指写作能力差。",{"a":1,"w":[146947,7586,9490]}],["不羞当面","bùxiūdāngmiàn","羞羞耻。不把面对面的批评当作羞侮。表示原意倾听别人的批评。",{"a":1,"w":[263465,5774]}],["伯歌季舞","bógējìwǔ","伯大哥；季小弟。哥哥唱歌，弟弟跳舞。比喻兄弟之间亲密无间。",{"a":1,"w":[7608,208,2321,3356]}],["伯玉知非","bóyùzhīfēi","伯玉蘧瑗，字伯玉，春秋时卫国人；非不对。比喻知道以前不对。",{"a":1,"w":[7608,2294,23402]}],["薄情无义","bóqíngwúyì","薄淡薄。感情淡薄，没有情义。常指对于生离死别的事无动于衷。",{"a":1,"w":[45986,51381]}],["补阙灯檠","bǔquēdēngqíng","阙缺；灯檠灯架。没有灯架，用人充作灯架。旧时讽刺男人惧内。",{"a":1,"w":[101630,48101]}],["辨日炎凉","biànrìyánliáng","古代传说中辩论太阳离地远近的故事◇以之形容儿童的聪明早慧。",{"a":1,"w":[8004,50,50034]}],["表里为奸","biǎolǐwéijiān","表里内外；奸虚伪狡诈。比喻用勾结、欺诈等不正当手段做坏事。",{"a":1,"w":[36467,550,8125]}],["比翼连枝","bǐyìliánzhī","比翼鸟名。传说此鸟一目一翼，须两两齐飞。比喻夫妇亲密不离。",{"a":1,"w":[104663,86941]}],["笔诛墨伐","bǐzhūmòfá","笔、墨指文字。诛谴责。伐声讨。通过文字加以谴责，进行声讨。",{"a":1,"w":[619,9317,7667,8087]}],["奔走呼号","bēnzǒuhūháo","奔走奔跑◆号叫喊。一面奔跑，一面呼唤。形容处于困境而求援。",{"a":1,"w":[16915,45394]}],["暴内陵外","bàonèilíngwài","暴残害；陵同凌”，侵犯，凌侮。对内残害百姓，对外欺压弱小。",{"a":1,"w":[7675,1287,7966,36]}],["班衣戏彩","bān yī xìcǎi","指身穿彩衣，作婴儿戏耍以娱父母◇以之为老养父母的孝亲典故。",{"a":1,"w":[135,7536,81096]}],["斑衣戏彩","bānyīxìcǎi","指身穿彩衣，作婴儿戏耍以娱父母◇以之为老养父母的孝亲典故。",{"a":1,"w":[231624,81096]}],["半路修行","bànlùxiūxíng","原指成年后才出家做和尚或尼姑。比喻中途改行，从事另一工作。",{"a":1,"w":[31400,48994]}],["百喙难辩","bǎihuìnánbiàn","喙嘴，借指人的嘴。指纵有众多百口也很难辩解。同百口莫辩”。",{"a":1,"w":[133,8793,117,7873]}],["百举百全","bǎijǔbǎiquán","每次行动都能完成其事，形容事事得心应手，都能取得好的效果。",{"a":1,"w":[133,606,531]}],["白话八股","báihuà bāgǔ","用白话写的类似旧时八股式的文章。比喻指应命而写的刻板文章。",{"a":1,"w":[13796,17919]}],["暗度金针","àndùjīnzhēn","度通渡”，过渡，引申为传授◇用于比喻秘诀。又借指幕后交易。",{"a":1,"w":[265461,15111]}],["傲霜斗雪","àoshuāngdòuxuě","傲视寒霜，抗击白雪。形容不畏严寒。比喻人身处逆境而不屈服。",{"a":1,"w":[60459,7477,616]}],["八窗玲珑","bā chuāng línglóng","①指四壁窗户轩敞，室内通彻明亮。②比喻通达明澈的修养境界。",{"a":1,"w":[145,8301,16549]}],["阿世盗名","ēshìdàomíng","阿世曲意博取世人的欢心。用博取世人的欢心的方法来窃取名誉。",{"a":1,"w":[286713,107249]}],["一切有情","yīqiè yǒuqíng","佛教指一切众生。有情，梵语Sattva的意译，旧译为众生。",{"a":1,"w":[1691,18516]}],["一问一临","yīwènyīlín","古礼，君对士的疾病要慰问一次，对士的丧事要临吊一次，故称。",{"a":1,"w":[123882,5,7625]}],["丁真永草","dīngzhēnyǒngcǎo","南朝梁丁觇善隶书，南朝陈智永善草书，当时人称“丁真永草”。",{"a":1,"w":[4646,85,8131,521]}],["九白之贡","jiǔbáizhīgòng","清代外蒙古每年例贡朝廷白色驼、马共九匹，称为“九白之贡”。",{"a":1,"w":[143,24,2254,8007]}],["五色诊病","wǔsè zhěnbìng","中医据五脏反映在面部的五种气色，以诊断疾病。参见“五色”。",{"a":1,"w":[13954,37466]}],["六犯清音","liù fàn qīngyīn","明清戏曲中串合十数曲为一曲的曲名之一。此由六曲组成，故名。",{"a":1,"w":[141,4667,56880]}],["匹妇不获","pǐfù bùhuò","《书‧咸有一德》：“匹夫匹妇，不获自尽，民主罔与成厥功。”",{"a":1,"w":[107829,36750]}],["同考试官","tóng kǎoshìguān","元代称科举考试时协同考试官工作的官员。相当于明清的副主考。",{"a":1,"w":[4611,593836]}],["吴中四士","wúzhōng sì shì","唐之包融、贺知章、张旭、张若虚四人同时知名，均吴人，故称。",{"a":1,"w":[359901,86,7542]}],["吾家先生","wú jiā xiānsheng","宋哲学家邵雍负盛名，晚年躬耕不仕，时人称之为“吾家先生”。",{"a":1,"w":[349370,238]}],["单线联系","dānxiàn liánxì","秘密工作者之间的一种联络方式。即成员间只进行纵的个别联系。",{"a":1,"w":[18204,1714]}],["太阴炼形","tàiyīn liànxíng","道教谓使死者炼形于地下，爪发潜长，尸体如生，久之成道之术。",{"a":1,"w":[27493,180763]}],["寓兵于农","yùbīngyúnóng","谓给农民以一定军事训练，平时务农，战时参战。或指军队屯垦。",{"a":1,"w":[9167,2282,4621,7612]}],["封金刊玉","fēngjīnkānyù","古时帝王封禅，在玉版上刻字涂金，用金绳系联，并以金泥加封。",{"a":1,"w":[600,1270,8644,2294]}],["年庚日甲","niángēng rì jiǎ","泛指年份和日期。古代用干支纪年及纪日。庚、甲在此虚指干支。",{"a":1,"w":[113513,50,3330]}],["戴炭篓子","dài tànlǒuzi","犹言戴高帽子。谓受人吹捧。炭篓子细而高，形似高帽子，故云。",{"a":1,"w":[2394,129249]}],["水老鼠花","shuǐlǎoshǔ huā","一种水上燃放的花炮。点着后在水面乱窜，喷出各种颜色的火花。",{"a":1,"w":[684872,20]}],["江夏八俊","jiāng xià bājùn","指东汉刘表、陈翔、范滂、孔昱、范康、檀敷、张俭、岑晊八人。",{"a":1,"w":[839201,222183]}],["泗州和尚","sì zhōu héshang","唐西域高僧僧伽大师，曾在泗州临淮县建造寺院，人称泗州和尚。",{"a":1,"w":[16866,4663,10414]}],["渊明醉石","yuānmíngzuìshí","江州德化县楚城乡(在今江西省九江市)，乃晋陶渊明所居之地。",{"a":1,"w":[8649,7431,3387,7419]}],["浓圈密点","nóngquānmìdiǎn","在文字旁加上许多圆圈或点。常用以标示值得注意或精采的部分。",{"a":1,"w":[2398,2325,2299,64]}],["烧头炉香","shāotóulúxiāng","旧时礼神拜佛，信徒争上第一炉香，以示虔诚，称“烧头炉香”。",{"a":1,"w":[2303,509,7902,1311]}],["独用将军","dúyòng jiāngjūn","草名。根叶可入药。见明李时珍《本草纲目‧草五‧独用将军》。",{"a":1,"w":[120097,4955]}],["玉人吹箫","yùrén chuīxiāo","传说春秋时秦有箫史善吹箫，穆公女弄玉慕之，穆公遂以女妻之。",{"a":1,"w":[52798,29895]}],["生知安行","shēngzhī ānxíng","“生而知之”、“安而行之”之省。古以为圣人方能具有的资质。",{"a":1,"w":[103362,61397]}],["发荣滋长","fā róng zīzhǎng","1) 草木繁茂地萌发生长。\n2) 比喻某些事物茁壮地成长。",{"a":1,"w":[522,7887,274602]}],["眉南面北","méi nánmiàn běi","1) 形