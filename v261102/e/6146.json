[["重熙累盛","chóngxīlěishèng","形容累世圣明有德，天下升平昌盛。同重熙累洽”。",{"a":1,"w":[49,9824,173,4746]}],["重熙累叶","chóngxīlěiyè","形容累世圣明有德，天下升平昌盛。同重熙累洽”。",{"a":1,"w":[49,9824,263258]}],["雉头狐腋","zhìtóuhúyè","以雉头狐腋做成的裘衣。形容穿着讲究，生活奢侈。",{"a":1,"w":[184239,98843]}],["止渴望梅","zhǐkě wàng méi","犹望梅止渴。比喻用空想安慰自己。同止渴思梅”。",{"a":1,"w":[32915,7556,7563]}],["指手顿脚","zhǐ shǒu dùnjiǎo","一面指着骂，一面跺着脚。形容蛮横不讲理的样子。",{"a":1,"w":[1312,34,124463]}],["指天为誓","zhǐtiānwéishì","誓发誓。指着天誓。表示意志坚决或对人表示忠诚。",{"a":1,"w":[1312,19,550,8615]}],["真知卓见","zhēnzhīzhuójiàn","指正确而深刻的认识和高明的见解。同真知灼见”。",{"a":1,"w":[56874,229237]}],["震聋发聩","zhènlóngfākuì","使昏昧糊涂，不明事理的人，为之震惊，受到启发。",{"a":1,"w":[317993,522,23646]}],["战不旋踵","zhànbùxuánzhǒng","旋转。踵脚后跟。打仗时不向后转。形容勇猛向前。",{"a":1,"w":[7438,50322]}],["战无不克","zhànwúbùkè","攻战没有不取胜的。形容强大无比，可以战胜一切。",{"a":1,"w":[7438,11748,516]}],["张大其辞","zhāngdàqící","把原来的事情夸大。形容言过其实。同张大其词”。",{"a":1,"w":[29164,3315,7757]}],["张皇其事","zhānghuángqíshì","把原来的事情夸大。形容言过其实。同张大其词”。",{"a":1,"w":[63961,3315,33]}],["折槁振落","zhégǎozhènluò","把枯树枝折断，把枯树叶摇下来。比喻轻易不费力。",{"a":1,"w":[2292,10871,178263]}],["折节读书","zhéjiédúshū","折节改变过去的志趣和行为。改变旧习，发愤读书。",{"a":1,"w":[79834,330]}],["折节下士","zhéjiéxiàshì","折节屈己下人。屈己下人，尊重有见识有能力的人。",{"a":1,"w":[79834,21293]}],["瞻望咨嗟","zhānwàng zījiē","咨嗟赞叹。左顾右看，不停地赞美。形容感触颇深。",{"a":1,"w":[199825,189132]}],["云涌飙发","yúnyǒngbiāofā","飙狂风。云阵奔涌，狂风发作。形容文章气势磅礴。",{"a":1,"w":[554,8855,11470,522]}],["远求骐骥","yuǎnqiúqíjì","骐骥良马。到远方去寻求良马。比喻各处访求人材。",{"a":1,"w":[103,598,84943]}],["月缺花残","yuèquēhuācán","形容衰败零落的景象。也比喻感情破裂，两相离异。",{"a":1,"w":[101,1412,20,7814]}],["悦目娱心","yuèmù yú xīn","使眼睛高兴，使心里快乐。形容使人感到美好快乐。",{"a":1,"w":[38281,9325,1279]}],["蝇集蚁附","yíng jí yǐfù","犹蝇营蚁聚。比喻不顾谦耻，趋炎附势，到处钻营。",{"a":1,"w":[9117,4628,49088]}],["蝇攒蚁附","yíngcuányǐfù","犹蝇营蚁聚。比喻不顾谦耻，趋炎附势，到处钻营。",{"a":1,"w":[9117,5014,49088]}],["引咎责躬","yǐnjiù zé gōng","主动承担错误的责任并作自我批评。同引咎自责”。",{"a":1,"w":[103624,7765,9213]}],["引狼自卫","yǐn láng zìwèi","犹言引虎自卫。比喻企图依仗恶人，结果反受其害。",{"a":1,"w":[2281,7960,13010]}],["饮冰食檗","yǐnbīngshíbò","喝冷水，吃苦味的东西。形容生活清苦，为人清白。",{"a":1,"w":[54576,7466,13092]}],["隐约其词","yǐnyuēqící","指语意隐晦不明或说话躲躲闪闪。亦作隐约其辞”。",{"a":1,"w":[6950,3315,596]}],["轶事遗闻","yìshì yíwén","世人不大知道的事纪传说。多指不见于正式记载的。",{"a":1,"w":[153388,380878]}],["逸尘断鞅","yìchénduànyāng","指马奔跑时扬起尘土，挣断马鞅。形容马跑得很快。",{"a":1,"w":[8116,7843,1335,14511]}],["以义割恩","yǐ yì gē'ēn","义道义。用大义割断私恩。指秉公办事，不殉私情。",{"a":1,"w":[2262,7437,251311]}],["以泽量尸","yǐzéliángshī","指尸体遍野，可以沼泽为单位计量。极言死人之多。",{"a":1,"w":[2262,7607,2263,7967]}],["以直抱怨","yǐ zhí bàoyuàn","别人对自己有仇怨，自己以大公无私的态度对待之。",{"a":1,"w":[2262,1294,4235]}],["以铢称镒","yǐzhūchēngyì","用铢同镒相比，表示力量极不相称，处于绝对劣势。",{"a":1,"w":[2262,12406,613,28417]}],["议不反顾","yìbùfǎngù","指为了正义奋勇向前，不回头、后退。议，通义”。",{"a":1,"w":[7521,68345,4700]}],["易口以食","yìkǒuyǐshí","犹易子而食。口，丁口。形容灾民极其悲惨的生活。",{"a":1,"w":[7463,47,2262,7466]}],["以荷析薪","yǐ hé xīxīn","原指父亲劈柴，儿子不能承受担当◇比喻继承父业。",{"a":1,"w":[2262,7677,62372]}],["以水济水","yǐshuǐjǐshuǐ","用水来给水增味。比喻随声附和，对事情没有好处。",{"a":1,"w":[2262,11,721035]}],["以文乱法","yǐwénluànfǎ","文指儒家的经典。引用儒家的经典，非议国家法令。",{"a":1,"w":[2262,7415,1360,2258]}],["以丰补歉","yǐfēngbǔqiàn","把丰年积余的粮食储备起来，留待灾年歉收时使用。",{"a":1,"w":[2262,7828,1363,9546]}],["衣紫腰黄","yī zǐ yāohuáng","身穿紫袍，腰佩金银鱼袋。大官装束，亦指做大官。",{"a":1,"w":[7536,3348,65296]}],["衣紫腰金","yī zǐ yāojīn","身穿紫袍，腰佩金银鱼袋。大官装束，亦指做大官。",{"a":1,"w":[7536,3348,87828]}],["衣紫腰银","yīzǐyāoyín","身穿紫袍，腰佩金银鱼袋。大官装束，亦指做大官。",{"a":1,"w":[7536,3348,2364,1350]}],["一喷一醒","yīpēnyīxǐng","原指斗鸡用水喷，使之清醒后再斗◇比喻推动督促。",{"a":1,"w":[5,3372,2424]}],["一射之地","yīshèzhīdì","一箭所能达到的距离，约当一百二十至一百五十步。",{"a":1,"w":[109404,2254,10]}],["一岁载赦","yīsuìzàishè","一年之中再次赦罪。指赦免过滥。亦作一岁再赦”。",{"a":1,"w":[37515,7491,10293]}],["一阶半级","yījiē bàn jí","阶、级是封建时代的等级品位。指非常低微的官职。",{"a":1,"w":[44848,97,564]}],["药店飞龙","yàodiàn fēilóng","飞龙指中药龙骨。药店里的龙骨。比喻人瘦骨嶙峋。",{"a":1,"w":[1247,17136]}],["曳兵弃甲","yè bīng qìjiǎ","拖着兵器，丢掉铠甲。形容打败仗逃跑时的狼狈相。",{"a":1,"w":[8838,2282,33511]}],["夜行被绣","yèxíngbèixiù","指身穿锦绣衣服在黑夜行走。比喻显贵不为人所知。",{"a":1,"w":[25936,1327,4793]}],["燕语莺啼","yànyǔyīngtí","莺黄鹂。燕子的话语，黄鹂的歌声。形容大好春光。",{"a":1,"w":[94616,257713]}],["掩眼捕雀","yǎnyǎnbǔquè","遮着眼睛捉麻雀。比喻自己骗自己。同掩目捕雀”。",{"a":1,"w":[8167,551,4778,7583]}],["燕舞莺啼","yànwǔyīngtí","莺黄鹂。燕子在飞舞，黄莺在鸣叫。形容春光明媚。",{"a":1,"w":[7821,3356,257713]}],["严陈以待","yánchényǐdài","指做好充分战斗准备，等待着敌人。同严阵以待”。",{"a":1,"w":[2349,7893,16031]}],["沿门持钵","yánmén chí bō","原指僧、尼挨门向人求布施，后泛指到处乞求施舍。",{"a":1,"w":[74849,7617,10148]}],["烟聚波属","yānjùbōshǔ","如烟之相聚，波之相接。比喻接连而来，聚集甚多。",{"a":1,"w":[1376,2309,7433,1268]}],["熊经鸟申","xióng jīng niǎoshēn","古代一种导引养生之法。状如熊之攀枝，鸟之伸脚。",{"a":1,"w":[3442,7421,130346]}],["刑期无刑","xíngqīwúxíng","刑罚在于教育人恪守法律，从而达到不用开的目的。",{"a":1,"w":[49613,448291]}],["形容憔悴","xíngróng qiáocuì","憔悴；精神萎靡，面色不好。身体瘦弱，面色枯黄。",{"a":1,"w":[2779,43734]}],["形输色授","xíngshūsèshòu","指以举止、神态传递倾慕之情。多以形容男女相悦。",{"a":1,"w":[4612,1352,2266,8099]}],["凶终隙未","xiōngzhōngxìwèi","指交道不永，朋友最终变成仇人。隙，嫌隙，仇恨。",{"a":1,"w":[4750,7638,8385,7559]}],["汹涌彭湃","xiōngyǒngpéngpài","波浪翻腾，互相撞击。亦比喻声势浩大，不可阻挡。",{"a":1,"w":[6284,149964]}],["心头撞鹿","xīntóuzhuànglù","心里像有小鹿在撞击。形容惊慌或激动时心跳剧烈。",{"a":1,"w":[13999,3401,8199]}],["新学小生","xīnxué xiǎoshēng","指治学时间不长，见闻浅陋、经验不足的后生晚辈。",{"a":1,"w":[49802,20942]}],["兴废继绝","xīngfèijìjué","使灭绝的重新振兴起来，延续下去。同兴灭继绝”。",{"a":1,"w":[109812,184238]}],["兴亡继绝","xīngwángjìjué","使灭绝的重新振兴起来，延续下去。同兴灭继绝”。",{"a":1,"w":[38913,184238]}],["心腹之忧","xīnfù zhī yōu","犹心腹之疾。指体内致命的疾病。比喻严重的隐患。",{"a":1,"w":[13732,2254,8112]}],["销魂荡魄","xiāohún dàng pò","形容因羡慕或爱好某种事物而着迷。同销魂夺魄”。",{"a":1,"w":[64819,7756,9063]}],["橡皮钉子","xiàngpídìngzǐ","犹软钉子。比喻以婉转隐晦的方式进行斥责或拒绝。",{"a":1,"w":[2568,12668]}],["鲜车健马","xiānchējiànmǎ","谓车辆鲜丽，辕马壮健。形容豪富。同鲜车怒马”。",{"a":1,"w":[2339,32,8022,1273]}],["袭人故智","xírén gùzhì","袭因袭，套用。智指计算。套用别人使用过的计策。",{"a":1,"w":[34042,86039]}],["洗垢匿瑕","xǐgòunìxiá","洗涤玉的污垢时，遮盖其斑点。比喻对人有所包涵。",{"a":1,"w":[62693,9684,9428]}],["下坂走丸","xiàbǎnzǒuwán","从山坡上滚下弹丸。比喻顺势无阻，敏捷而无停滞。",{"a":1,"w":[17,20438,107,4757]}],["西窗剪烛","xīchuāngjiǎnzhú","原指思念远方妻子，盼望相聚夜语◇泛指亲友聚谈。",{"a":1,"w":[51,8301,787397]}],["息黥补劓","xīqíngbǔyì","指修整面容残缺，恢复本来面目◇用以喻改过自新。",{"a":1,"w":[7510,19615,1363,44668]}],["无怨无德","wúyuàn wúdé","既没有怨恨，也没有恩德。指彼此间没有恩怨关系。",{"a":1,"w":[56157,40317]}],["梧桐断角","wútóngduànjiǎo","指梧桐虽是柔木而可以断坚硬之角。比喻柔能胜刚。",{"a":1,"w":[17112,1335,533]}],["五尺竖子","wǔchǐshùzǐ","指尚未成年的儿童。古尺短，故称。同五尺之童”。",{"a":1,"w":[106,2347,42792]}],["五尺之僮","wǔchǐzhītóng","指尚未成年的儿童。古尺短，故称。同五尺之童”。",{"a":1,"w":[106,2347,2254,12655]}],["无毛大虫","wúmáodàchóng","没有毛的老虎。比喻光从表面不易看破的凶恶之物。",{"a":1,"w":[16906,56940]}],["无伤无臭","wúshāngwúxiù","没有声音，没有气味。比喻没有名声，不被人知道。",{"a":1,"w":[27820,96723]}],["无所不作","wúsuǒbùzuò","没有不干的事情。指什么坏事都干。同无所不为”。",{"a":1,"w":[9220,34961]}],["文章盖世","wénzhānggàishì","盖世超过世人。指文章好得无与伦比，谁都赶不上。",{"a":1,"w":[1642,29838]}],["蜗角虚名","wōjiǎoxūmíng","蜗角蜗牛的角，比喻细微。微小而没有作用的名声。",{"a":1,"w":[82637,29628]}],["为民父母","wéimínfùmǔ","这作为，充当；父母即父母官。担任地方行政长官。",{"a":1,"w":[23529,1629]}],["托公行私","tuōgōngxíngsī","犹言假公济私。假借公家的名义，谋取私人的利益。",{"a":1,"w":[4618,56062,7692]}],["拖男带女","tuōnándàinǚ","带领着男儿女儿。多形容旅途的辛苦或生计的艰难。",{"a":1,"w":[4707,170,542,98]}],["蛙蟆胜负","wāmáshèngfù","青蛙与蛤蟆斗争的胜负。比喻不足介意的荣哀得失。",{"a":1,"w":[9708,12410,4060]}],["颓垣废井","tuíyuán fèijǐng","倒塌了的墙，废弃不用的井。形容荒凉破败的景象。",{"a":1,"w":[64269,74361]}],["退如山移","tuìrúshānyí","退却时象一座山在移动。比喻遇到变故，沉着镇静。",{"a":1,"w":[1371,4614,45,2306]}],["偷鸡盗狗","tōujī dào gǒu","指偷窃的行为。也指不正经的勾当。同偷鸡摸狗”。",{"a":1,"w":[34790,8038,171]}],["添油炽薪","tiānyóu chì xīn","犹言火上加油。比喻人为地激化矛盾，使事态严重。",{"a":1,"w":[37047,11111,8398]}],["涕泪交下","tìlèi jiāoxià","鼻涕眼泪同时流下，形容极度哀痛。同涕泪交零”。",{"a":1,"w":[614233,156545]}],["涕泗纵横","tìsìzònghéng","眼泪鼻涕满脸乱淌。形容极度悲伤。同涕泗横流”。",{"a":1,"w":[117186,5313]}],["剔抽秃揣","tīchōutūchuǎi","形容着急时眼睛迅速转动，或仔细打量别人的样子。",{"a":1,"w":[9422,2350,4862,9537]}],["薮中荆曲","sǒuzhōngjīngqǔ","比喻品质不好的人，处在恶劣的环境中会变得更坏。",{"a":1,"w":[10471,7,8436,7517]}],["随时施宜","suíshí shī yí","根据当时的情况，采取适当的措施。同随时制宜”。",{"a":1,"w":[965,7507,7984]}],["遂迷不并","suìmíbùbìng","执迷不悟; 坚持错误而不觉悟。亦作遂迷忘反”。",{"a":1,"w":[8193,1384,0,1377]}],["死欲速朽","sǐyùsùxiǔ","指人死了以后尸体腐朽得越快越好。人死入土为安。",{"a":1,"w":[1329,7872,7497,9194]}],["驷马仰秣","sìmǎyǎngmò","驾车的马驻足仰首，谛听琴声。形容音乐美妙动听。",{"a":1,"w":[29846,131520]}],["俟河之清","sìhézhīqīng","俟等待。等待黄河变清。比喻期望的事情不能实现。",{"a":1,"w":[13324,585,2254,4617]}],["松萝共倚","sōngluógòngyǐ","女萝多附生于松树，故因以比喻夫妻相处和睦融洽。",{"a":1,"w":[21643,2273,8677]}],["斯事体大","sīshìtǐdà","斯此；体体制，规模。这件事性质重要，关系重大。",{"a":1,"w":[7406,24915,4]}],["霜气横秋","shuāngqìhéngqiū","霜秋霜。气志气。比喻志气凛然，像秋霜一样严峻。",{"a":1,"w":[8258,510,4653,1391]}],["水满金山","shuǐ mǎn jīnshān","神话故事。金山，在江苏省镇江市。同水漫金山”。",{"a":1,"w":[11,592,12430]}],["水剩山残","shuǐshèngshāncán","多指亡国或经过变乱后国土分裂、山河残破的景象。",{"a":1,"w":[11,2434,45,7814]}],["誓死不贰","shìsǐbù'èr","立誓至死不生二心。形容忠贞不渝或意志坚定专一。",{"a":1,"w":[37328,68939]}],["噬脐无及","shìqí wújí","自咬腹脐够不着。比喻后悔不及。亦作噬脐莫及”。",{"a":1,"w":[68002,56576]}],["恃勇轻敌","shì yǒng qīngdí","恃倚仗，仗恃。仗着自己勇敢而不把对手放在心上。",{"a":1,"w":[10634,8286,179592]}],["时运不齐","shíyùnbùjì","齐同济”。遭遇逆境，命运不好。亦作时运不济”。",{"a":1,"w":[34250,14525]}],["识微见几","shíwēijiànjǐ","看到事物的苗头而能认识和察见事物的本质和发展。",{"a":1,"w":[4658,7512,173930]}],["拾掇无遗","shíduōwúyí","拾取得干干净净，没有一点遗留。拾掇采检，拾取。",{"a":1,"w":[84624,18630]}],["食不充口","shíbùchōngkǒu","不能吃饱肚子。形容生活艰难困苦。同食不餬口”。",{"a":1,"w":[7466,0,7722,47]}],["使性谤气","shǐxìng bàng qì","发脾气；撒气。亦作使性傍气”。亦作使性掼气”。",{"a":1,"w":[37360,9810,510]}],["施而不费","shī'érbùfèi","施给人好处；费耗费。给人好处，自己却无所损失。",{"a":1,"w":[7507,2267,32929]}],["石烂江枯","shílànjiāngkū","直到石头变土，江水干涸。比喻不可能发生的事情。",{"a":1,"w":[7419,3399,2327,8333]}],["时乖运拙","shíguāi yùn zhuō","拙劣，不好。时运不顺，命运不佳。指处境不顺利。",{"a":1,"w":[99063,3313,9782]}],["生众食寡","shēngzhòngshíguǎ","众多；寡少。生产的多，消费的少。形容财富充足。",{"a":1,"w":[508,7688,7466,8272]}],["尸禄素飡","shīlù sù cān","指空食俸禄而不尽其职，无所事事。同尸禄素餐”。",{"a":1,"w":[100256,7468,79881]}],["失魂丧魄","shīhúnsàngpò","①形容心烦意乱，精神恍惚。②形容极度惊恐不安。",{"a":1,"w":[77208,127121]}],["神意自若","shényìzìruò","神情脸色毫无异样。形容态度镇静。同神色自若”。",{"a":1,"w":[85781,23419]}],["身名两泰","shēnmíngliǎngtài","名誉、地位都安稳。形容生活舒泰。同身名俱泰”。",{"a":1,"w":[7456,560,96,7662]}],["深奸巨猾","shēn jiān jùhuá","犹老奸巨猾。形容世故深而手段极其奸诈狡猾的人。",{"a":1,"w":[1343,8125,148994]}],["缮甲治兵","shàn jiǎ zhìbīng","缮甲修治铠甲。比喻作军事准备。亦作缮甲厉兵”。",{"a":1,"w":[11032,3330,106332]}],["筛锣擂鼓","shāiluóléigǔ","敲锣打鼓。形容大声吵闹。也比喻竭力把事情夸大。",{"a":1,"w":[107357,37643]}],["山栖谷饮","shānqīgǔyǐn","栖息于山中，汲取山谷的泉水来喝。形容隐居生活。",{"a":1,"w":[45,361886,7871]}],["桑户桊枢","sānghù quānshū","以桑枝为门，木条为枢。形容居处简陋，家境贫寒。",{"a":1,"w":[212927,201767]}],["如醉如狂","rúzuìrúkuáng","形容神态失常，不能自制。亦指为某人某事所倾倒。",{"a":1,"w":[4614,3387,3382]}],["入海算沙","rùhǎisuànshā","①到海底数沙子。比喻白费功夫。②又喻用力精勤。",{"a":1,"w":[21676,573,7472]}],["若丧考妣","ruòsàngkǎobǐ","丧死去；考父亲；妣母亲∶象死了父母一样地伤心。",{"a":1,"w":[4652,8016,143327]}],["日中必湲","rìzhōngbìyuán","比喻做事应该当机立断，不失时机。同日中必彗”。",{"a":1,"w":[17573,3335,54557]}],["柔茹寡断","róurú guǎduàn","柔茹柔软。指处事软弱，不果断。亦作柔懦寡断”。",{"a":1,"w":[136828,69667]}],["如获至珍","rúhuòzhìzhēn","形容对所得到的东西非常珍视喜爱。同如获至宝”。",{"a":1,"w":[4614,2355,3346,8037]}],["如雷灌耳","rúléiguàn'ěr","①形容声音大（多指语音）。②形容人的名声很大。",{"a":1,"w":[63899,8179,7509]}],["仁义君子","rén yì jūnzǐ","原指好心肠的正派人，后泛指能热心帮助别人的人。",{"a":1,"w":[16754,4860]}],["任重道悠","rènzhòngdàoyōu","比喻责任重大，要经历长期的奋斗。同任重道远”。",{"a":1,"w":[22457,511,8963]}],["日旰忘食","rìgànwàngshí","天色已晚仍顾不上吃饭。形容专心致志，勤勉不懈。",{"a":1,"w":[50,28176,150299]}],["日角龙庭","rìjiǎolóngtíng","旧时相术家指天庭隆起为龙庭。称之为帝王的贵相。",{"a":1,"w":[151982,105167]}],["人喊马嘶","rén hǎn mǎsī","人喊叫，马嘶鸣。形容纷乱扰攘或热闹欢腾的情景。",{"a":1,"w":[3,765,185975]}],["人面狗心","rénmiàn gǒuxīn","①比喻容貌美好而才学低下的人。②犹言人面兽心。",{"a":1,"w":[12487,391250]}],["人神同嫉","rénshéntóngjí","人与神都憎恨厌恶。极言民怨之甚。同人神共嫉”。",{"a":1,"w":[44432,4611,12776]}],["人语马嘶","rényǔmǎsī","人叫喊，马嘶鸣。形容纷乱扰攘或热闹欢腾的情景。",{"a":1,"w":[106254,185975]}],["染丝之变","rǎnsī zhī biàn","比喻本来相同的人或事物因受环境影响而变得不同。",{"a":1,"w":[148169,2254,539]}],["人多阙少","rénduōquèshǎo","指求官职的人多而空额少。阙，旧时指官职的空额。",{"a":1,"w":[3,21,8773,126]}],["趋时奉势","qūshífèngshì","迎合时尚，依附权势。多用作贬义。同趋时附势”。",{"a":1,"w":[175674,7971,7642]}],["琼岛春云","qióngdǎo chūn yún","即琼华岛。明代北京八景之一。亦指北京十景之一。",{"a":1,"w":[381138,1378,554]}],["青裙缟袂","qīngqúngǎomèi","青布裙、素色衣。谓贫妇的服饰。借指农妇，贫妇。",{"a":1,"w":[3320,8880,12506,15354]}],["轻才好施","qīngcáihàoshī","指人不把钱财放在眼里，乐于慷慨解囊，急公好义。",{"a":1,"w":[595,37394,7507]}],["强本弱支","qiángběnruòzhī","比喻削减地方势力，加强中央权力。同强本弱枝”。",{"a":1,"w":[126616,2376,1328]}],["乞浆得酒","qǐjiāngdéjiǔ","讨杯水喝，却得到了酒。比喻得到的超过所要求的。",{"a":1,"w":[9371,7883,520,594]}],["气决泉达","qìjué quán dá","如气之逸出，泉水之流泻。比喻事情进行非常顺利。",{"a":1,"w":[189413,3461,7430]}],["泣涕如雨","qìtìrúyǔ","泣低声哭；涕鼻涕。眼泪像雨一样。形容极度悲伤。",{"a":1,"w":[380326,58302]}],["七鄐八手","qīchùbāshǒu","亦作七足八手”。形容动作忙乱，许多人一齐动手。",{"a":1,"w":[134,149930,145,34]}],["飘风骤雨","piāofēngzhòuyǔ","飘风疾风。骤迅疾，猛快。来势急遽而猛烈的风雨。",{"a":1,"w":[160539,80141]}],["飘洋航海","piāoyáng hánghǎi","渡过海洋。多指去异国他乡或远处。同飘洋过海”。",{"a":1,"w":[312124,10122]}],["牝哹鸣辰","pìnfúmíngchén","母鸡报晓。旧时比喻妇女窃权乱政。同牝鸡司晨”。",{"a":1,"w":[12259,7935,8629]}],["牝鸡晨鸣","pìnjī chén míng","母鸡报晓。旧时比喻妇女窃权乱政。同牝鸡司晨”。",{"a":1,"w":[35115,8733,7935]}],["破璧毁珪","pòbìhuǐguī","璧、珪均为玉。把玉破坏掉。比喻破坏美好的东西。",{"a":1,"w":[1325,8965,4749,20848]}],["浓桃艳李","nóngtáoyànlǐ","桃花浓丽，李花鲜艳。比喻人容貌俊美，神采焕发。",{"a":1,"w":[2398,3386,8710,7880]}],["拈酸泼醋","niān suān pōcù","产生嫉妒情绪。多指在男女关系上。同拈酸吃醋”。",{"a":1,"w":[11497,2277,203609]}],["能谋善断","néngmóushànduàn","善擅长；断决断。形容人能不断思考，并善于判断。",{"a":1,"w":[41,8000,109693]}],["目染耳濡","mùrǎn'ěrrú","因耳目经常接触而受到感染，影响。同目攋耳染”。",{"a":1,"w":[7465,3355,7509,10135]}],["名韟利鞚","mínggāolìkòng","犹名缰利锁。比喻名利束缚人就象缰绳和锁链一样。",{"a":1,"w":[560,4606,86649]}],["明火持杖","mínghuǒ chí zhàng","形容公开抢劫或肆无忌惮地干坏事。同明火执仗”。",{"a":1,"w":[15112,7617,8427]}],["明火执械","mínghuǒ zhí xiè","形容公开抢劫或肆无忌惮地干坏事。同明火执仗”。",{"a":1,"w":[15112,7826,7801]}],["明如指掌","míng rú zhǐzhǎng","形容对情况非常清楚，好象指着自己的手掌给人看。",{"a":1,"w":[7431,4614,35151]}],["明扬仄陋","míngyáng zèlòu","明察荐举出身微贱而德才兼备的人。同明扬侧陋”。",{"a":1,"w":[106153,413176]}],["面北眉南","miànběiméinán","指脸面相背，互不理睬。形容相处不合，各不照面。",{"a":1,"w":[523,132,7988,90]}],["民安物阜","mín'ānwùfù","阜多。社会安定，物资丰富。形容太平盛世的景象。",{"a":1,"w":[7434,2261,7412,9656]}],["昧地瞒天","mèidìmántiān","欺骗天地。比喻昧着良心，隐瞒事实或以谎言骗人。",{"a":1,"w":[9075,10,10018,19]}],["觅迹寻踪","mì jì xúnzōng","觅找；踪迹，脚印，指行踪。到处寻找别人的行踪。",{"a":1,"w":[10275,8080,7855,8226]}],["芒寒色正","mánghánsèzhèng","指星光清冷色纯正。也借以称颂人的品行高洁正直。",{"a":1,"w":[8347,129884,62]}],["盲风晦雨","mángfēnghuìyǔ","指非常急骤凶猛的风雨。比喻困境。同盲风怪雨”。",{"a":1,"w":[412939,828364]}],["马壮人强","mǎzhuàngrénqiáng","犹言人强马壮。形容军队的战斗力很强或军容很盛。",{"a":1,"w":[1273,219246,1314]}],["乱作胡为","luànzuòhúwéi","犹胡作非为。不顾法纪或舆论，毫无顾忌地做坏事。",{"a":1,"w":[1360,4608,48902]}],["纶巾羽扇","guānjīnyǔshàn","拿着羽毛扇子，戴着青丝绶的头巾。形容态度从容。",{"a":1,"w":[107354,34826]}],["鸾孤凤寡","luángūfèngguǎ","比喻夫妻离散。也比喻人失偶孤居。同鸾孤凤只”。",{"a":1,"w":[9528,7996,7768,8272]}],["龙攀凤附","lóngpānfèngfù","犹言攀龙附凤。指巴结投靠有权势的人以获取富贵。",{"a":1,"w":[1308,8491,7768,7718]}],["列土封疆","liètǔfēngjiāng","列同裂”；封疆划定疆界。帝王将土地分封给大臣。",{"a":1,"w":[93288,25552]}],["裂眦嚼齿","lièzìjiáochǐ","眦眼眶。瞪眼欲裂，牙齿紧咬。比喻愤怒到了极点。",{"a":1,"w":[196586,9180,7577]}],["林籁泉韵","lín lài quányùn","风吹林木和泉石相激而产生的悦耳声音。泛指天籁。",{"a":1,"w":[7469,19549,222104]}],["临池学书","línchí xué shū","临靠近，挨着；池砚池；书书法。指刻苦练习书法。",{"a":1,"w":[104876,13,81]}],["麟角凤毛","línjiǎofèngmáo","麟的角，凤的毛。比喻稀有而又难得之人才或事物。",{"a":1,"w":[42605,68673]}],["凌弱暴寡","língruòbàoguǎ","凌侵犯；暴欺负、践踏。侵犯弱小的，欺侮孤单的。",{"a":1,"w":[8382,2376,7675,8272]}],["连更彻夜","liángēngchèyè","犹连夜。形容办事赶紧，毫不拖延。同连更晓夜”。",{"a":1,"w":[1288,611,64995]}],["连更星夜","liángēngxīngyè","犹连夜。形容办事赶紧，毫不拖延。同连更晓夜”。",{"a":1,"w":[1288,611,65709]}],["帘窥壁听","liánkuībìtīng","帘布帘；窥偷看；壁墙壁；听偷听。指窃听与偷看。",{"a":1,"w":[8925,8879,7850,146]}],["礼顺人情","lǐ shùn rénqíng","指礼是顺乎人之常情，人与人共处必须遵守的规范。",{"a":1,"w":[3342,4660,9138]}],["历世摩钝","lìshìmódùn","激励世人，使鲁钝的人奋发有为。亦作历世磨钝”。",{"a":1,"w":[67717,7669,8549]}],["腊尽春回","làjìnchūnhuí","腊指腊月，即农历十二月。腊月过去，春天又来了。",{"a":1,"w":[8052,4675,1378,79]}],["夸强道会","kuāqiángdàohuì","会能。夸耀自己能力强、本事大。亦作夸强说会”。",{"a":1,"w":[3470,1314,60243]}],["匡时济世","kuāngshíjìshì","匡纠正。济救助。挽救动荡的局势。使其转危为安。",{"a":1,"w":[176910,131530]}],["狂风怒号","kuángfēngnùháo","怒愤怒，发怒；号号叫。大风刮得像发怒一样号叫。",{"a":1,"w":[22715,50038]}],["慷慨输将","kāngkǎishūjiāng","毫不吝啬地捐献财物帮助人。多用在对社会对群众。",{"a":1,"w":[5629,150048]}],["扛鼎拔山","gāngdǐngbáshān","扛双手举起。拔起大山，举起重鼎。形容力气很大。",{"a":1,"w":[44525,76026]}],["渴而掘井","kě ér juéjǐng","到口渴才掘井。比喻事先没有准备，临时才想办法。",{"a":1,"w":[236,2267,38155]}],["刻鹄成鹜","kèhú chéng wù","比喻模仿的虽然不逼真，但还相似。同刻鹄类鹜”。",{"a":1,"w":[94029,517,15016]}],["坑绷拐骗","kēngbēngguǎipiàn","指以欺手段捞取钱财，陷害他人。亦作坑蒙拐骗”。",{"a":1,"w":[4706,8678,51061]}],["抉目东门","juémù dōngmén","抉剔出；目眼睛。指忠臣被谗诛杀。同抉目吴门”。",{"a":1,"w":[105286,102955]}],["抉目胥门","juémù xū mén","抉剔出；目眼睛。指忠臣被谗诛杀。同抉目吴门”。",{"a":1,"w":[105286,9768,53]}],["抉目悬门","juémù xuánmén","抉剔出；目眼睛。指忠臣被谗诛杀。同抉目吴门”。",{"a":1,"w":[105286,106759]}],["绝长继短","juéchángjìduǎn","绝截断。截取长的，补充短的。比喻用长处补短处。",{"a":1,"w":[4627,515,7780,577]}],["绝长续短","juéchángxùduǎn","绝截断。截取长的，补充短的。比喻用长处补短处。",{"a":1,"w":[4627,515,7651,577]}],["君命无二","jūn mìng wú'èr","指君主的命令不可更改。形容君命有绝对的权威性。",{"a":1,"w":[7831,4622,15058]}],["拘神遣将","jūshénqiǎnjiàng","拘拘使。指力量无穷。神通广大，能指挥天兵天将。",{"a":1,"w":[8339,3316,78505]}],["举目千里","jǔmù qiānlǐ","放眼远眺，可以见到很远之处。形容视野广阔辽远。",{"a":1,"w":[91348,9306]}],["举一废百","jǔyīfèibǎi","举提出；废弃。提出一点，废弃许多。指认识片面。",{"a":1,"w":[606,5,7711,133]}],["句斟字酌","jùzhēnzìzhuó","指写文章或说话时慎重细致，一字一句地推敲琢磨。",{"a":1,"w":[646,11637,84,9372]}],["据高临下","jùgāolínxià","凭借高处俯控低处，指凭仗优势地位足以控制别人。",{"a":1,"w":[4642,35,7625,17]}],["九回肠断","jiǔhuícháng duàn","形容痛苦、忧虑、愁闷已经到了极点。同九回肠”。",{"a":1,"w":[349970,1335]}],["鲸波怒浪","jīngbō nù làng","犹言惊涛骇浪。比喻险恶的环境或尖锐激烈的斗争。",{"a":1,"w":[263252,8124,7832]}],["鲸波鼍浪","jīngbō tuó làng","比喻险恶的环境或尖锐激烈的斗争。同鲸涛鼍浪”。",{"a":1,"w":[263252,46381,7832]}],["鲸涛鼍浪","jīngtāotuólàng","犹言惊涛骇浪。比喻险恶的环境或尖锐激烈的斗争。",{"a":1,"w":[9055,11504,46381,7832]}],["敬事后食","jìngshìhòushí","指凡事应当先尽力去做，待有功绩后才能享受俸禄。",{"a":1,"w":[115421,43,7466]}],["靖谮庸回","jìngzènyōnghuí","语言善巧而行动乖违。犹口是行非。同靖言庸回”。",{"a":1,"w":[9378,16428,8352,79]}],["进退双难","jìntuìshuāngnán","比喻事情无法决定，因而难以行动。同进退两难”。",{"a":1,"w":[12556,1309,117]}],["进退迍邅","jìntuì zhūnzhān","犹言进退两难。比喻事情无法决定，因而难以行动。",{"a":1,"w":[12556,180828]}],["惊慌无措","jīnghuāng wúcuò","由于惊慌，一下子不知怎么办才好。同惊惶失措”。",{"a":1,"w":[33614,36942]}],["借书留真","jièshū liú zhēn","指借别人的书，抄写后留下正本，把抄本还给别人。",{"a":1,"w":[68308,590,85]}],["将取固予","jiāngqǔgùyǔ","固，同姑”。要想得到，必先给予。同将夺固与”。",{"a":1,"w":[3328,580,7552,8145]}],["皎阳似火","jiǎoyángshìhuǒ","皎白而亮。太阳像火一样燃烧。多形容夏日的炎热。",{"a":1,"w":[15125,7484,7803,1284]}],["矫世厉俗","jiǎoshìlìsú","改变颓废的世风，鼓励淳厚的民俗。同矫世励俗”。",{"a":1,"w":[191731,8111,7904]}],["江山如故","jiāngshān rúgù","故从前。高山大河面貌依旧。多用于比喻物是人非。",{"a":1,"w":[11107,40054]}],["兼程并进","jiānchéngbìngjìn","兼两倍的；并合并。加快步伐，一天走两天的路程。",{"a":1,"w":[36234,44669]}],["剪烛西窗","jiǎnzhúxīchuāng","原指思念远方妻子，盼望相聚夜语◇泛指亲友聚谈。",{"a":1,"w":[787397,51,8301]}],["假公营私","jiǎgōngyíngsī","假借公家的名义，谋取私人的利益。同假公济私”。",{"a":1,"w":[562,24880,7692]}],["计功补过","jìgōngbǔguò","计考定；失过失。考定一个人的功绩以弥补其过失。",{"a":1,"w":[46044,61289]}],["计将安出","jìjiāng'ānchū","计计策，计谋；安怎么，怎样。如何制定计谋呢？。",{"a":1,"w":[7428,3328,2261,22]}],["计日而俟","jìrì'érsì","可以数着日子等待。形容为时不远。同计日而待”。",{"a":1,"w":[55944,2267,13324]}],["计日可期","jìrìkěqī","可以数着日子等待。形容为时不远。同计日而待”。",{"a":1,"w":[55944,39170]}],["计日以待","jìrìyǐdài","可以数着日子等待。形容为时不远。同计日而待”。",{"a":1,"w":[55944,16031]}],["计日以期","jìrìyǐqī","可以数着日子等待。形容为时不远。同计日而待”。",{"a":1,"w":[55944,83575]}],["纪群之交","jìqúnzhījiāo","纪、群人名，陈纪是陈群的父亲。比喻累世之交情。",{"a":1,"w":[7653,1348,2254,535]}],["箕山之操","jīshānzhīcāo","旧时用以称誉不愿在乱世做官的人。同箕山之节”。",{"a":1,"w":[8764,45,2254,7592]}],["箕山之志","jīshānzhīzhì","旧时用以称誉不愿在乱世做官的人。同箕山之节”。",{"a":1,"w":[8764,45,2254,7626]}],["急功好利","jígōnghàolì","急于求成，贪图眼前的成效和利益。同急功近利”。",{"a":1,"w":[569,7516,63175]}],["急拍繁弦","jípāifánxián","犹言急管繁弦。形容各种乐器同时演奏的热闹情景。",{"a":1,"w":[207253,8553,4726]}],["鸡鸣候旦","jīmíng hòu dàn","怕失晓而耽误正事，天没亮就起身。同鸡鸣戒旦”。",{"a":1,"w":[19850,7622,8414]}]]