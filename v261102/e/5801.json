3]}],["啸傲风月","xiào'àofēngyuè","啸傲随意长啸吟咏游乐。在江湖山野中自由自在地吟咏游赏。",{"a":1,"w":[166695,14678]}],["向风慕义","xiàngfēngmùyì","指向往其教化，仰慕其礼义。或指向往其风度，仰慕其义行。",{"a":1,"w":[19631,211208]}],["闲言淡语","xiányándànyǔ","①无关紧要的话。②犹闲言冷语。没有根据的讥刺他人的话。",{"a":1,"w":[45760,2378,7447]}],["衔沙填海","xiánshātiánhǎi","犹言衔石填海。比喻为实现既定目标，坚韧不拔地奋斗到底。",{"a":1,"w":[8703,7472,33585]}],["衔玉贾石","xiányùjiǎshí","给人看的是玉，卖给人的却是石头，义同挂羊头，卖狗肉”。",{"a":1,"w":[8703,2294,8056,7419]}],["显露头角","xiǎnlùtóujiǎo","露显露。头上的角已明显地突出来了。指初显露优异的才能。",{"a":1,"w":[29083,16785]}],["系风捕景","xìfēngbǔjǐng","①比喻不可能做到的事。②比喻不露形迹。亦作系风捕影”。",{"a":1,"w":[1277,44,121861]}],["武偃文修","wǔyǎnwénxiū","文治已实行，武备已停止。形容天下太平。亦作文修武偃”。",{"a":1,"w":[7504,9432,7415,1339]}],["无名之璞","wúmíng zhī pú","指未出名的璞玉。比喻不为人知的才识之士。同无名之朴”。",{"a":1,"w":[10034,2254,11839]}],["无根而固","wúgēn ér gù","固牢固。没有根柢却能牢固。比喻有共同的思想感情作基础。",{"a":1,"w":[20288,2267,7552]}],["无迹可求","wújìkěqiú","没有踪迹可以寻求。多指处事为文不着痕迹。同无迹可寻”。",{"a":1,"w":[114593,3310,598]}],["文采风流","wéncǎifēngliú","横溢的才华与潇洒的风度。亦指才华横溢与风度潇洒的人物。",{"a":1,"w":[22150,9920]}],["闻名丧胆","wénmíngsàngdǎn","听见名字就吓破了胆。形容威名很大，使人听到即甚为恐惧。",{"a":1,"w":[14957,67238]}],["汪洋大肆","wāngyángdàsì","形容文章、言论书法等气势豪放，潇洒自如。同汪洋自肆”。",{"a":1,"w":[47679,5928]}],["汪洋闳肆","wāngyáng hóng sì","形容文章、言论书法等气势豪放，潇洒自如。同汪洋自肆”。",{"a":1,"w":[47679,12278,8346]}],["汪洋恣肆","wāngyáng zìsì","形容文章、言论书法等气势豪放，潇洒自如。同汪洋自肆”。",{"a":1,"w":[47679,207257]}],["亡国之社","wángguózhīshè","已亡国家的祠社。古代天子将其作为亡国的象征，以自儆戒。",{"a":1,"w":[18161,2254,3327]}],["头破血淋","tóupòxuèlín","头被打破，流出了血。形容受到严重打击或遭到惨败的样子。",{"a":1,"w":[509,57640,4782]}],["投膏止火","tóugāozhǐhuǒ","用油去浇灭火，火反而烧得更旺。比喻举措失当，适得其反。",{"a":1,"w":[2288,8048,72476]}],["投山窜海","tóushāncuànhǎi","山、海，荒凉边远之地。指有罪而被放逐到荒凉边远的地区。",{"a":1,"w":[2288,45,4918,528]}],["廷争面折","tíngzhēngmiànzhé","廷争在朝廷上争论；面折当面指责别人的过失。指直言敢谏。",{"a":1,"w":[124271,45695]}],["通达谙练","tōngdá ānliàn","通达明白；谙练熟悉，熟练。深知人情事理，处理问题老练。",{"a":1,"w":[23283,163208]}],["同年而校","tóngnián'érxiào","犹言相提并论。把不同的人或不同的事放在一起谈论或看待。",{"a":1,"w":[33800,2267,7600]}],["同日而道","tóngrì'érdào","把不同的人或不同的事放在一起谈论或看待。同同日而论”。",{"a":1,"w":[25854,2267,511]}],["同日而言","tóngrì'éryán","把不同的人或不同的事放在一起谈论或看待。同同日而论”。",{"a":1,"w":[25854,11957]}],["天愁地惨","tiānchóudìcǎn","天地都感到愁苦、凄惨。形容极其悲惨（多用作渲染气氛）。",{"a":1,"w":[19,3481,10,4840]}],["所向皆靡","suǒxiàng jiē mí","比喻力量所达到的地方，一切障碍全被扫除。同所向披靡”。",{"a":1,"w":[43657,4819,8373]}],["随声趋和","suíshēngqūhé","自己没有主见，别人怎么说，就跟着怎么说。见随声附和”。",{"a":1,"w":[110288,8388,39]}],["顺天应时","shùntiānyīngshí","顺顺从。应适应。时时机。指上要遵从天命，下要适应时机。",{"a":1,"w":[31161,21670]}],["水菜不交","shuǐcàibùjiāo","比喻彼此经济上没有往来。旧时指官吏清廉。同水米无干”。",{"a":1,"w":[103251,0,535]}],["水底摸月","shuǐdǐmōyuè","比喻去做根本做不到的事情，只能白费力气。同水中捞月”。",{"a":1,"w":[15072,2447,101]}],["水阔山高","shuǐkuòshāngāo","阔宽，广阔，指有广阔的水面和高大的山脉隔着，不得相通。",{"a":1,"w":[11,4766,45,35]}],["水米无干","shuǐmǐwúgàn","比喻彼此经济上没有往来。旧时指官吏清廉。同水米无交”。",{"a":1,"w":[52282,66835]}],["守道安贫","shǒudào ānpín","坚守正道，安于贫穷。旧时用来颂扬贫困而有节操的士大夫。",{"a":1,"w":[105410,39410]}],["事火咒龙","shìhuǒzhòulóng","比喻荒诞不经之事。事火，指祀火为神；咒龙，指咒龙请雨。",{"a":1,"w":[33,1284,10446,1308]}],["诗以言志","shī yǐyán zhì","用诗歌表达自己的思想和志趣。亦作诗言志”、诗以道志”。",{"a":1,"w":[2369,17607,7626]}],["十寒一暴","shíhányībào","冻十天，晒一天。比喻做事时而抓紧，时而懈怠，进展不快。",{"a":1,"w":[93,7631,5,7675]}],["十十五五","shí shíwǔwǔ","①指十个一群，五个一组。形容错乱不齐。②指每十里五里。",{"a":1,"w":[93,354980]}],["绳厥祖武","shéng jué zǔwǔ","绳继续；武足迹。踏着祖先的足迹继续前进。比喻继承祖业。",{"a":1,"w":[7867,8425,85803]}],["身无长处","shēnwúchángchù","除一身之外再没有多余的东西。原指生活俭朴。现形容贫穷。",{"a":1,"w":[7456,2255,2210]}],["身遥心迩","shēnyáoxīn'ěr","犹言身远心近。指身体相隔虽远，但是双方的心却贴得很近。",{"a":1,"w":[7456,8326,1279,10495]}],["深计远虑","shēnjìyuǎnlǜ","犹深思远虑。谋划周密，考虑长远。指计划周到，具有远见。",{"a":1,"w":[251541,32669]}],["深扃固钥","shēnjiōnggùyào","把门窗关紧锁严。比喻把事物的真相隐藏起来而不使之外露。",{"a":1,"w":[1343,15982,7552,9086]}],["深惟重虑","shēnwéizhònglǜ","犹深思熟虑。谋划周密，考虑长远。指计划周到，具有远见。",{"a":1,"w":[155124,49,8360]}],["韶华如驶","sháohuárúshǐ","韶华美好的时光，常指春光。形容美好的春光如马飞驰而过。",{"a":1,"w":[48284,4614,8139]}],["舌战群儒","shézhàn qún rú","舌战激烈争辩；儒指读书人。指同很多人辩论，并驳倒对方。",{"a":1,"w":[254292,1348,8257]}],["三头两面","sāntóuliǎngmiàn","看对方的脸色而改变态度。比善于迎和奉承和玩弄两面手法。",{"a":1,"w":[18638,12560]}],["三媒六证","sānméiliùzhèng","旧时婚姻，由父母包办，还必须有媒人介绍。表示郑重其事。",{"a":1,"w":[74,8288,141,1334]}],["如丘而止","rú qiū érzhǐ","如到达；丘丘陵；止止步。指遇到困难则停下来，不求上进。",{"a":1,"w":[4614,7868,29551]}],["如锥画沙","rúzhuīhuàshā","象用锥子在沙上画出来似的。形容书法笔力匀整而不露锋芒。",{"a":1,"w":[4614,140454]}],["日月合壁","rìyuèhébì","日月同时上升，出现于阴历的朔日。古人以为是国家的瑞兆。",{"a":1,"w":[11286,1269,7850]}],["如火燎原","rúhuǒliáoyuán","燎烧；原原野。如火在原野燃烧。比喻声势很大，难于阻抑。",{"a":1,"w":[38249,25756]}],["请自隗始","qǐngzìwěishǐ","自从；隗郭隗自称。原指拿自己做一个榜样◇比喻自愿带头。",{"a":1,"w":[160,2256,42025,7683]}],["轻骑减从","qīngqíjiǎncóng","行装简单，跟随的人少（多指有地位的人）。同轻车简从”。",{"a":1,"w":[57203,2328,124]}],["清渭浊泾","qīngwèizhuójīng","古以为渭水清，泾水浊。也比喻两者相比较，是非好坏分明。",{"a":1,"w":[4617,13751,8559,12068]}],["切切在心","qièqièzàixīn","切切形容情意恳切真挚。牢牢地记在心里。形容殷切的思念。",{"a":1,"w":[13654,13447]}],["亲贤远佞","qīnxiányuǎnnìng","佞巧言谄媚的人。亲近有才能的贤人，疏远阿谀奉承的小人。",{"a":1,"w":[73028,103,10272]}],["青鸟殷勤","qīngniǎoyīnqín","青鸟古代传说中传送信件的使者。比喻常通信息，传递消息。",{"a":1,"w":[56106,20868]}],["青紫被体","qīngzǐpītǐ","青紫古时公卿服饰，借喻高官显爵；被同披”。指身居高官。",{"a":1,"w":[44365,1327,7417]}],["强弩末矢","qiángnǔmòshǐ","比喻强大的力量已经衰弱，起不了什么作用。同强弩之末”。",{"a":1,"w":[117192,2329,8270]}],["墙花路柳","qiánghuālùliǔ","墙边的花，路旁的柳。比喻不被人尊重的女子。旧时指妓女。",{"a":1,"w":[670,20,54,7802]}],["巧作名目","qiǎo zuò míngmù","指巧立名目。变着法定出一些名目来达到某种不正当的目的。",{"a":1,"w":[1421,4608,29812]}],["戚戚具尔","qīqī jù'ěr","戚戚互相亲爱的样子。具俱，都。尔迩，靠近。指兄弟友爱。",{"a":1,"w":[43672,87674]}],["欺硬怕软","qīyìngpàruǎn","欺欺凌。怕害怕。欺凌强硬的，害怕软弱的。指吃硬不吃软。",{"a":1,"w":[8777,3339,686,3349]}],["耆年硕德","qíniánshuòdé","耆古称六十岁为耆，泛指年高。硕大。比喻年高而德望很重。",{"a":1,"w":[317546,226820]}],["飘蓬断梗","piāopéng duàngěng","飘飞的蓬草和随波逐流的断树枝。比喻到处漂泊，行踪无定。",{"a":1,"w":[99900,156454]}],["平澹无奇","píngdànwúqí","指事物或诗文平平常常，没有吸引人的地方。同平淡无奇”。",{"a":1,"w":[193648,2255,7460]}],["批风抹月","pīfēngmòyuè","犹言吟风弄月。指诗人以风花雪月为吟诵的题材以状其闲适。",{"a":1,"w":[2363,44,8295,101]}],["披榛采兰","pīzhēncǎilán","披拔开；榛丛生的荆棘。拨开荆棘，采摘兰草。比喻盐人才。",{"a":1,"w":[3456,10541,7528,7450]}],["攀藤揽葛","pānténglǎngě","手拉葛藤向上。形容在险峻的山路上攀登。亦作攀藤附葛”。",{"a":1,"w":[8491,7799,8780,8321]}],["牛蹄中鱼","niútízhōngyú","牛蹄是指牛蹄印里的积水。牛蹄印坑里的鱼。比喻死期迫近。",{"a":1,"w":[25365,7,526]}],["沤珠槿艳","ōuzhūjǐnyàn","比喻短暂的幻景。沤珠，水泡。槿，木槿花，鲜艳而易凋谢。",{"a":1,"w":[13414,7784,19597,8710]}],["嗫嗫嚅嚅","niè nièrú rú","犹吞吞吐吐。想说，但又不痛痛快快地说。形容说话有顾虑。",{"a":1,"w":[43867,118588,39301]}],["纳贡称臣","nàgòngchēngchén","缴纳贡品，自称为臣下◇来也用以比喻心悦诚服，甘拜下风。",{"a":1,"w":[78859,141557]}],["摩肩击毂","mójiānjīgǔ","肩膀和肩膀相摩，车轮和车轮相撞。形容行人车辆往来拥挤。",{"a":1,"w":[7669,3459,212826]}],["明推暗就","míngtuī àn jiù","表面上推拒，暗地里接受。形容装腔作势、假意拒绝的样子。",{"a":1,"w":[292271,2340,95]}],["偭规错矩","miǎnguīcuòjǔ","偭违背；规、矩标准、法则和习惯。指违背改变正常的法则。",{"a":1,"w":[83111,7549,147,8181]}],["美玉无瑕","měiyù wúxiá","瑕玉斑。美玉上面没有一点羞。比喻人或事物完美的无缺点。",{"a":1,"w":[48595,24001]}],["茫茫苦海","mángmáng kǔhǎi","茫茫辽阔深远的样子；苦海苦难深重如海。无穷无尽的苦难。",{"a":1,"w":[5830,78180]}],["鹿车共挽","lùchēgòngwǎn","鹿车古时的一种小车；挽拉。旧时称赞夫妻同心，安贫乐道。",{"a":1,"w":[102130,2273,8944]}],["鹿驯豕暴","lùxùnshǐbào","意指一会儿像鹿一样柔驯，一会儿像猪一样凶暴。形容狡诈。",{"a":1,"w":[8199,9709,10916,7675]}],["履险若夷","lǚxiǎnruòyí","走险路如行平地。比喻不畏困难或本领高强。同履险如夷”。",{"a":1,"w":[136840,4652,7910]}],["龙威虎震","lóngwēi hǔ zhèn","形容气势奔放雄壮。常形容书法笔势的遒劲有力，灵活舒展。",{"a":1,"w":[112594,3337,7751]}]]