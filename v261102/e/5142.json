255,185714,2272]}],["五音六律","wǔyīnliùlǜ","五音指宫、商、角、征、羽五个音阶；六律定乐器的标准。指古代音律◇也泛指音乐。",{"a":1,"w":[38903,76163]}],["同浴讥裸","tóngyùjīluǒ","在一起洗澡却讥笑别人赤身露体。比喻自己跟别人有同样的问题，却以此而讥嘲别人。",{"a":1,"w":[4611,8336,10295,8384]}],["天覆地载","tiānfùdìzǎi","覆盖；载承受。象天覆盖万物，地承受一切一样。比喻范围极广大。也比喻恩泽深厚。",{"a":1,"w":[19,7864,10,7491]}],["探竿影草","tàngānyǐngcǎo","探竿、影草、都是渔民使鱼聚集后下网捕捞之法。佛教禅宗借以喻启发性的随宜施教。",{"a":1,"w":[7690,9280,7513,521]}],["唐虞之治","tángyú zhī zhì","唐虞唐尧、虞舜，传说中的古代圣帝贤君。旧指上古政治清明，人民康乐的理想时代。",{"a":1,"w":[158861,2254,2283]}],["淘沙得金","táoshādéjīn","用水选的方法从沙子里取得真金。比喻除去杂质，提取精华。也比喻费力大而成效少。",{"a":1,"w":[61083,520,1270]}],["随方逐圆","suífāngzhúyuán","①指立身行事无定则。②根据物体的形状、地形的高低等作出与之相适应的设计构造。",{"a":1,"w":[1375,2257,7970,2301]}],["拭目而待","shìmù'érdài","拭擦；待等待。擦亮眼睛等着瞧。形容期望很迫切。也表示确信某件事情一定会出现。",{"a":1,"w":[12020,7465,2267,3350]}],["豕突狼奔","shǐtūlángbēn","豕猪；突猛冲。象猪那样冲撞，象狼那样奔跑。形容成群的坏人乱冲乱撞，到处搔扰。",{"a":1,"w":[10916,7750,7960,8195]}],["什袭而藏","shíxí'ércáng","什形容多；袭量词，套，层。将物品层层包裹，珍重地藏好。形容极珍重地收藏物品。",{"a":1,"w":[231844,2267,4688]}],["什袭珍藏","shíxízhēncáng","什形容多；袭量词，套，层。将物品层层包裹，珍重地藏好。形容极珍重地收藏物品。",{"a":1,"w":[231844,29702]}],["声求气应","shēngqiúqìyìng","应应和，共鸣；求寻找。同类的事物相互感应。比喻志趣相投的人自然地结合在一起。",{"a":1,"w":[3317,598,307044]}],["舌尖口快","shéjiān kǒukuài","尖尖锐，锋利。快锐利，爽快。形容口舌伶俐，说话爽快。也指说话尖刻，不肯让人。",{"a":1,"w":[14990,43471]}],["三徙成都","sānxǐchéngdōu","相传舜三度迁移，百姓慕德而从，所至处自成都邑。形容圣人到处都受到百姓的拥戴。",{"a":1,"w":[74,10225,23004]}],["入竟问禁","rùjìngwènjìn","竟境的古字；禁禁忌。进入一个国家或地区，先要问清楚那里有什么禁令，以免触犯。",{"a":1,"w":[4615,8770,49001]}],["任重至远","rènzhòngzhìyuǎn","愿意指负载沉重而可以到达远方◇比喻抱负远大，能闯出新的天地，做出宏伟的业绩。",{"a":1,"w":[22457,3346,103]}],["劝百讽一","quànbǎifěngyī","形容规讽正道的言辞远远及不上劝诱奢靡的言辞。意在使人警戒，但结果却适得其反。",{"a":1,"w":[3484,133,9928,5]}],["情深骨肉","qíngshēngǔròu","骨肉比喻至亲。形容朋友之间的情谊比亲人还要深厚。亦作情逾骨肉”、情愈骨肉”。",{"a":1,"w":[7490,1343,16021]}],["挈瓶之智","qièpíng zhī zhì","挈瓶汲水用的容量小的瓶子。比喻浅薄的知识或智谋。亦作智类挈瓶”、挈瓶之知”。",{"a":1,"w":[164263,2254,7798]}],["青蝇点素","qīngyíng diǎn sù","青蝇苍蝇，比喻进谗言的人；素白色的生绢。苍蝇玷污素练。指小人用谗言诬害好人。",{"a":1,"w":[177710,64,7468]}],["骑者善堕","qízhěshànduò","惯于骑马的人常常会从马上摔下来。比喻善长某一技艺的人，往往因大意而招致失败。",{"a":1,"w":[674,1285,7657,8768]}],["破甑不顾","pòzèngbùgù","甑古代一种瓦制炊器；顾回头看。甑落地已破，不再看它。比喻既成事实，不再追悔。",{"a":1,"w":[189343,3785]}],["飘茵随溷","piāoyīnsuíhùn","比喻由于偶然的机缘而有富贵贫贱的不同命运。亦多指女子堕落风尘。同飘茵堕溷”。",{"a":1,"w":[3467,10767,1375,17220]}],["平易近民","píngyì jìn mín","对人和蔼可亲，没有架子，使人容易接近。也指文字浅显，容易了解。同平易近人”。",{"a":1,"w":[34402,574,7434]}],["批逆龙鳞","pī nì lónglín","传说龙喉下有逆鳞径尺，有触之必怒而杀人。常以喻弱者触怒强者或臣下触犯君主等。",{"a":1,"w":[2363,7762,36045]}],["飘籵坠溷","piāofánzhuìhùn","比喻由于偶然的机缘而有富贵贫贱的不同命运。亦多指女子堕落风尘。同飘茵堕溷”。",{"a":1,"w":[3467,217721,4826,17220]}],["绵言细语","miányánxìyǔ","绵柔软。绵言柔和的语言。细语低细的语句。指说话时声音柔和细微，使人容易接受。",{"a":1,"w":[8228,7440,41815]}],["蒙袂辑屦","méngmèijíjù","袂袖子；辑拖着不使脱落；屦鞋。用袖子蒙着脸，脚上拖着鞋。形容十分困乏的样子。",{"a":1,"w":[4647,15354,8220,10982]}],["猫鼠同乳","māoshǔtóngrǔ","比喻官吏失职，包庇下属干坏事。也比喻上下狼狈为奸。同猫鼠同眠, 猫鼠同处”。",{"a":1,"w":[191,3351,4611,7719]}],["枚速马工","méi sù mǎgōng","工工巧；速速度快。原指枚皋文章写得多，司马相如文章写得工◇用于称赞各有长处。",{"a":1,"w":[5016,7497,81461]}],["屡变星霜","lǚ biànxīng shuāng","星霜星辰运转，一年循环一次，每年秋季降霜，因此以星霜指代年岁。表示岁月更换。",{"a":1,"w":[9826,21819,8258]}],["凛如霜雪","lǐn rú shuāngxuě","比喻待人接物毫无感情，象冰霜一样冷。也比喻态度严正，不可接近。同凛若冰霜”。",{"a":1,"w":[11079,4614,89334]}],["凛若秋霜","lǐnruòqiūshuāng","比喻待人接物毫无感情，象冰霜一样冷。也比喻态度严正，不可接近。同凛若冰霜”。",{"a":1,"w":[11079,4652,52951]}],["连枝比翼","liánzhībǐyì","比翼比翼鸟，即鹣鹣。传此鸟一目一翼，两只必须并列在一起飞。比喻男女成双成对。",{"a":1,"w":[86941,104663]}],["怜贫敬老","lián pín jìnglǎo","老年老的人；怜怜恤。尊敬老人，怜恤家境困苦的人。形容人有恭谨慈爱的美好品德。",{"a":1,"w":[9532,7999,47840]}],["老马恋栈","lǎomǎ liànzhàn","恋留恋；栈马栈。老马不妒忌离开马栈。比喻老年人恋念旧情。也指年老还贪恋官位。",{"a":1,"w":[67902,28892]}],["劳思逸淫","láosīyìyín","逸安逸。指参加实际劳动，才能想到爱惜物力，知道节俭；贪图安逸就容易放荡堕落。",{"a":1,"w":[7526,7586,8116,7901]}],["狂瞽之言","kuánggǔ zhī yán","狂狂妄。瞽瞎眼，盲目。指愚妄无知的言论。旧时常用作自谦之辞。亦作狂瞽之说”。",{"a":1,"w":[129170,2254,7440]}],["攫戾执猛","juélìzhíměng","攫捉取。戾暴戾。执抓住。猛凶猛。能够捕获擒拿暴戾、凶猛的敌人。形容勇猛无敌。",{"a":1,"w":[15499,9083,7826,4814]}],["开合自如","kāihézìrú","合按照，适合；自如不受阻碍和拘束。打开闭合不受拘束，形容按照自己的意愿办事。",{"a":1,"w":[31745,21398]}],["疚心疾首","jiùxīn jíshǒu","疚久病，忧虑。因歉疚而内心不安。心中不安，头痛脑胀。形容十分悲痛忧愁或不安。",{"a":1,"w":[222069,33839]}],["救经引足","jiùjīngyǐnzú","引拉；经缢死。救上吊的人却去拉他的脚。比喻行动与目的相反，越做越离目的越远。",{"a":1,"w":[1409,7421,2281,4625]}],["敬老怜贫","jìnglǎo lián pín","老年老的人；怜怜恤。尊敬老人，怜恤家境困苦的人。形容人有恭谨慈爱的美好品德。",{"a":1,"w":[47840,9532,7999]}],["敬事不暇","jìngshìbùxiá","敬恭敬。事侍奉，为他人效劳。暇空闲。恭敬地为他人奔走效劳，忙得没有闲暇之时。",{"a":1,"w":[115421,20261]}],["经纶济世","jīnglúnjìshì","指具有治理国家，经世济民的才能。经纶整理丝缕，引申为处理国家大事。济世救世。",{"a":1,"w":[39114,131530]}],["极重不反","jízhòngbùfǎn","指长期形成的风俗、习惯、弊端或某种局面难以改变。用于消极方面。同极重难返”。",{"a":1,"w":[1303,49,68345]}],["黄河水清","huánghé shuǐ qīng","黄河之水常年混浊，如果变得清澈则被视为祥瑞的征兆。也比喻罕见的、难得的事情。",{"a":1,"w":[1973,11,4617]}],["鸿蒙初辟","hóngméngchūpì","鸿蒙古人认为天地开辟之前是一团浑沌的元气。开天辟地。指刚刚开始出现人类世界。",{"a":1,"w":[55002,1400,8072]}],["侯服玉食","hóufúyùshí","侯服王侯之服；玉食珍美食品。穿王侯的衣服，吃珍贵的食物。形容豪华奢侈的生活。",{"a":1,"w":[109646,49249]}],["褐衣蔬食","hèyīshūshí","褐衣粗布衣服；蔬食粗糙的饭食。穿的是粗布衣服，吃的是粗茶淡饭。形容生活困苦。",{"a":1,"w":[222037,92609]}],["好骑者堕","hàoqízhěduò","惯于骑马的人常常会从马上摔下来。比喻善长某一技艺的人，往往因大意而招致失败。",{"a":1,"w":[58,674,1285,8768]}],["过市招摇","guòshìzhāoyáo","市闹市，指人多的地方；招摇张扬炫耀。指在公开场合大摇大摆显示声势，引人注意。",{"a":1,"w":[25,555,26056]}],["贵不期骄","guìbùqījiāo","指显贵的人尽管不希望自己染上骄恣专横的习气，但它仍然在不知不觉中滋长起来了。",{"a":1,"w":[167,19781,8457]}],["贵不召骄","guìbùzhàojiāo","指显贵的人尽管不希望自己染上骄恣专横的习气，但它仍然在不知不觉中滋长起来了。",{"a":1,"w":[167,0,8854,8457]}],["观望不前","guānwàngbùqián","不前不敢上前。事情尚难确定时，怀着犹豫不定的心情，观察事物的发展，暂不前进。",{"a":1,"w":[58022,0,60]}],["鼓舌摇唇","gǔshé yáo chún","鼓动嘴唇，摇动舌头。形容利用口才进行煽动或游说。亦泛指大发议论（多含贬义）。",{"a":1,"w":[84707,2377,8248]}],["高才大学","gāocáidàxué","高才才能杰出。大学学识渊博。才能高超，学识渊博。亦作高才博学”、高才硕学”。",{"a":1,"w":[69542,175]}],["甘贫守分","gānpínshǒufēn","甘贫甘愿贫困。守分保守本分，不思非分之想，不作非分之事。甘受贫困，遵守本分。",{"a":1,"w":[506331,86322]}],["封胡羯末","fēnghújiémò","均为兄弟的小名封指谢韶，胡指谢朗，羯指谢玄，末指谢川◇用以称美兄弟子侄之辞。",{"a":1,"w":[600,7554,12273,2329]}],["丰度翩翩","fēngdùpiānpiān","丰度风采气度。翩翩洒脱的样子。形容神态举止文雅优美，超逸洒脱。同风度翩翩”。",{"a":1,"w":[32687,43886]}],["风鬟雾鬓","fēnghuánwùbìn","鬟环形发髻；鬓脸旁靠近耳朵的头发。形容女子头发的美。也形容女子头发蓬松散乱。",{"a":1,"w":[44,17780,3421,10863]}],["放刁撒泼","fàngdiāosāpō","放使用；刁无赖，刁滑；撒泼蛮不讲理。指使用刁钻狡猾的一套手段。形容极不讲理。",{"a":1,"w":[107280,28092]}],["多藏厚亡","duōcánghòuwáng","厚大；亡损失。指积聚很多财物而不能周济别人，引起众人的怨恨，最后会损失更大。",{"a":1,"w":[21,4688,2336,7763]}],["堕甑不顾","duòzèngbùgù","甑古代一种瓦制炊器；顾回头看。甑落地已破，不再看它。比喻既成事实，不再追悔。",{"a":1,"w":[8768,13267,3785]}],["叨在知己","tāozàizhījǐ","叨谦词，表示辱没他人，自觉惭愧；知己友谊深厚的朋友。有愧于作为您的知己朋友。",{"a":1,"w":[9519,52,12582]}],["戴鸡佩豚","dàijīpèitún","戴雄鸡形的帽子，佩野猪形的饰物。雄鸡野猪皆好斗，古时以冠带像其形，表示好勇。",{"a":1,"w":[2394,578,7810,9948]}],["丹青不渝","dānqīngbùyú","丹、青丹砂、青雘，是古代绘画中常用的两种颜料，不易褪色。始终不渝，光明显著。",{"a":1,"w":[37961,20062]}],["单鹄寡凫","dānhúguǎfú","鹄天鹅；凫罢鸭。孤单的天鹅，独居的野鸭。原是古代的琴曲名◇比喻失去配偶的人。",{"a":1,"w":[2269,10801,8272,14408]}],["寸辖制轮","cùn xiázhì lún","比喻控制事物的关键虽小而极重要。辖，固定车轮与车轴位置，插入轴端孔穴的销钉。",{"a":1,"w":[3402,92994,2280]}],["刍荛之言","chúráo zhī yán","刍荛割草打柴的人。割草打柴人的话。指普遍百姓的浅陋言辞。也用作讲话者的谦词。",{"a":1,"w":[45081,2254,7440]}],["础泣而雨","chǔqì'éryǔ","柱子的基石泣湿了，就是要下雨的征候。比喻见到一点迹象，就能知道它的发展方向。",{"a":1,"w":[8772,9273,2267,159]}],["础润而雨","chǔrùn'éryǔ","柱子的基石润湿了，就是要下雨的征候。比喻见到一点迹象，就能知道它的发展方向。",{"a":1,"w":[8772,7847,2267,159]}],["抽刀断水","chōudāo duànshuǐ","抽刀拔出刀来。水流水。抽出刀来要斩断流水。比喻无济于事，反会加速事态的发展。",{"a":1,"w":[128182,105825]}],["尺蠖求伸","chǐhuòqiúshēn","尺蠖虫名，体长约二三寸，屈伸而行。尺蠖用弯曲来求得伸展。比喻以退为进的策略。",{"a":1,"w":[49714,598,3412]}],["陈善闭邪","chénshànbìxié","陈述说；善善法美政；闭堵塞。臣下对君主陈述善法美政，借以堵塞君主的邪心妄念。",{"a":1,"w":[7893,7657,4684,8201]}],["操刀伤锦","cāodāo shāng jǐn","操刀和割锦本不是一回事，后人并而为一，比喻才能太低，不能胜任责任重大的事情。",{"a":1,"w":[110290,1358,7982]}],["不立文字","bùlìwénzì","佛家语，指禅家悟道，不涉文字不依经卷，唯以师徒心心相印，理解契合，传法授受。",{"a":1,"w":[94843,1539]}],["不如归去","bùrúguīqù","杜鹃鸟的叫声很象不如归去”。旧时常用以作思归或催人归去之辞。也表示消极求退。",{"a":1,"w":[684937,61]}],["渤澥桑田","bóxiè sāngtián","渤澥，渤海的古称。大海变成桑田，桑田变成大海。犹沧海桑田。比喻世事变化巨大。",{"a":1,"w":[224233,26785]}],["不臣之心","bùchénzhīxīn","不臣不守臣子的本分，封建社会中不忠君。意指不忠君的思想◇也指犯上作乱的野心。",{"a":1,"w":[97919,10744]}],["闭门读书","bìméndúshū","关起门来在家里读书。原意是独自学习，而不与别人切磋◇也用以形容专心埋头苦读。",{"a":1,"w":[12769,330]}],["把薪助火","bǎxīnzhùhuǒ","把握住。拿着柴草助长火势。比喻某种行动作法会增加对方的力量或助长事态的加剧。",{"a":1,"w":[1321,8398,7672,1284]}],["爱人以德","àirényǐdé","爱人爱护别人；德德行。按照道德标准去爱护人。泛指对人不偏私偏爱，不姑息迁就。",{"a":1,"w":[1145,2262,7416]}],["安常习故","ānchángxígù","习习惯；故旧例。安于常规，习惯旧例。形容按照常规和老套办事，守旧而不思变革。",{"a":1,"w":[2261,99,7678,7486]}],["六义附庸","liùyì fùyōng","谓赋。古人认为赋这种文体乃《诗经》“六义”中“赋”的流衍，故以“附庸”相喻。",{"a":1,"w":[146146,21784]}],["南北合套","nánběi hé tào","在一个套曲里兼用南曲和北曲的一种体式。最初南北曲的曲牌不能出现在同一套曲内。",{"a":1,"w":[3703,1269,584]}],["严将军头","yán jiāngjūn tóu","典出《三国志‧蜀志‧张飞传》：“﹝张飞﹞至江州，破璋将巴郡太守严颜，生获颜。",{"a":1,"w":[2349,1078271]}],["大轰大嗡","dàhōngdàwēng","形容不注重实际，只在形式上轰轰烈烈。如：我们干工作要脚踏实地，不要大轰大嗡。",{"a":1,"w":[4,8041,24042]}],["大头娃娃","dàtóu wáwa","一种表演用的套在头上的道具。因其外形是儿童的头脸，故称。常用于谐趣性的舞蹈。",{"a":1,"w":[9688,5177]}],["寸晷风檐","cùnguǐ fēng yán","喻考场应试。寸晷，时间短暂；风檐，挡风的屋檐。旧时应考，各居简陋小屋，故云。",{"a":1,"w":[506119,44,9322]}],["层层加码","céngcéng jiāmǎ","谓逐级增加任务和逐级提出各种要求等。如：任务要明确，省以下各级不得层层加码。",{"a":1,"w":[34126,72262]}],["山鸡映水","shānjī yìng shuǐ","同“山鸡照影”。\n南朝陈徐陵《鸳鸯赋》：“山鸡映水那自得，孤鸾照镜不成双。”",{"a":1,"w":[33862,8723,11]}],["张潘左陆","zhāngpānzuǒlù","西晋文学家张载、张协、张亢兄弟，潘岳、潘尼叔侄，左思，陆机，陆云兄弟的并称。",{"a":1,"w":[1333,8658,154,7605]}],["揜麛取犊","yǎnmíqǔdú","捕杀幼兽。语出《礼记‧曲礼下》：“国君春田不围泽，大夫不掩群，士不取麛卵。”",{"a":1,"w":[16115,51701,580,10334]}],["敦煌变文","dūnhuáng biànwén","敦煌石室中所藏的讲唱体通俗文学作品。是中国唐五代时期一种重要的民间文学形式。",{"a":1,"w":[24591,123729]}],["旬中空亡","xún zhōngkōng wáng","古代用干支纪日，十干配十二支，一旬中余二支，称“旬中空亡”。迷信认为是凶辰。",{"a":1,"w":[9247,18055,7763]}]]