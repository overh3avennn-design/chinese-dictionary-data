281]}],["铨柄","quánbǐng","选拔、任用、考核官吏的职权。",{"a":1,"w":[10543,7964]}],["铭镌","míngjuān","铭刻。亦指铭刻的文字或图案。",{"a":1,"w":[9413,14209]}],["衔碑","xiánbēi","含悲的隐语。碑，音同“悲”。",{"a":1,"w":[8703,9627]}],["锐上","ruìshàng","指脑袋尖。常形容人性格刚毅。",{"a":1,"w":[8551,9]}],["锋犯","fēngfàn","指近体诗中有些警句难作对仗。",{"a":1,"w":[8275,4667]}],["锄剃","chútì","锄地除草。引申为铲除、消灭。",{"a":1,"w":[9844,10554]}],["铺监","pùjiān","旧时监狱勒索犯人钱财的名目。",{"a":1,"w":[4756,7644]}],["钱郎","qiánláng","唐代诗人钱起、郎士元的并称。",{"a":1,"w":[138,8101]}],["锦念","jǐnniàn","敬称他人对自己的挂念，关注。",{"a":1,"w":[7982,1422]}],["锦笮","jǐnzé","丝质的缆绳。泛指华美的缆绳。",{"a":1,"w":[7982,28088]}],["锦贉","jǐndàn","书册或字画卷轴卷头上贴的绫。",{"a":1,"w":[7982,144084]}],["锡蛇","xīshé","银蛇的别名。中医用为解毒药。",{"a":1,"w":[8582,3363]}],["错辅","cuòfǔ","谓安排辅助者。错，通“措”。",{"a":1,"w":[147,7940]}],["炼颜","liànyán","指经过修炼而常保青春的容颜。",{"a":1,"w":[8149,8117]}],["鍖然","chěnrán","不自满的样子。鍖，通“欿”。",{"a":1,"w":[7451]}],["锻湅","duànliàn","犹熟练。湅，煮丝绢使之软熟。",{"a":1,"w":[9192,94439]}],["钟龙","zhōnglóng","1) 竹名。\n2) 泛指竹。",{"a":1,"w":[1410,1308]}],["锁缰","suǒjiāng","枷锁和缰绳。比喻名利的束缚。",{"a":1,"w":[3368,20306]}],["镜囊","jìngnáng","盛镜子和其他梳妆用具的袋子。",{"a":1,"w":[7535,7777]}],["铙管","náoguǎn","鼓吹中的横笛。亦借指鼓吹曲。",{"a":1,"w":[24923,1278]}],["钟呗","zhōngbei","指作法事时的撞钟声和诵经声。",{"a":1,"w":[1410,12101]}],["镰采","liáncǎi","亦作“镰采”。\n用镰刀采集。",{"a":1,"w":[10164,7528]}],["铁仙","tiěxiān","比喻体格健壮而神采飘逸的人。",{"a":1,"w":[1298,7740]}],["铁钵","tiěbō","僧徒的食器。用铁制成，故称。",{"a":1,"w":[1298,10148]}],["铸定","zhùdìng","熔铸成型。引申为注定，决定。",{"a":1,"w":[8547,2259]}],["铸镕","zhùróng","铸造熔炼。引申为培育，造就。",{"a":1,"w":[8547,14710]}],["鑉炉","hélú","即“钾炉”。一种穿孔的小箭。",{"a":1,"w":[7902]}],["鉴亮","jiànliàng","亦作“鉴亮”。\n审察并原谅。",{"a":1,"w":[8039,641]}],["鉴衡","jiànhéng","亦作“鉴衡”。\n鉴别，评定。",{"a":1,"w":[8039,7728]}],["鉴诫","jiànjiè","亦作“鉴诫”。\n见“监戒”。",{"a":1,"w":[8039,11479]}],["凿室","záoshì","在屋壁上穿洞。指行窃的行为。",{"a":1,"w":[8504,1359]}],["长嫡","zhǎngdí","旧时指正妻所生的长子或长女。",{"a":1,"w":[515,10209]}],["长楸","zhǎngqiū","高大的楸树。古代常种于道旁。",{"a":1,"w":[515,12329]}],["长终","zhǎngzhōng","1) 永久。\n2) 谓死亡。",{"a":1,"w":[515,7638]}],["长裾","zhǎngjū","