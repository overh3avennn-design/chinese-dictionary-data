]}],["起拨","qǐbō","起驳，用小船将货物运至岸上。",{"a":1,"w":[29,4720]}],["起樯","qǐqiáng","把樯帆竖起来。指启碇，开船。",{"a":1,"w":[29,68828]}],["起认","qǐrèn","谓失主认领从盗窝取出之赃物。",{"a":1,"w":[29,3370]}],["趁闲","chènxián","亦作“趁闲”。\n乘空闲时间。",{"a":1,"w":[3570,3381]}],["越溪","yuèxī","传说为越国美女西施浣纱之处。",{"a":1,"w":[597,4874]}],["越诺","yuènuò","古代西域出产的一种上等织物。",{"a":1,"w":[597,7495]}],["赶闲","gǎnxián","亦作“赶闲”。\n谓趁着空闲。",{"a":1,"w":[1440,3381]}],["赶骚","gǎnsāo","詈语。指女性出外玩耍、招摇。",{"a":1,"w":[1440,8664]}],["赵母","zhàomǔ","指战国时赵国大将赵括的母亲。",{"a":1,"w":[8536,4637]}],["趋士","qūshì","亦作“趍士”。\n谓礼贤下士。",{"a":1,"w":[8388,7542]}],["趋操","qūcāo","亦作“趍操”。\n行为；操行。",{"a":1,"w":[8388,7592]}],["趫雄","qiáoxióng","矫捷强壮。也指矫捷强壮的人。",{"a":1,"w":[17809,7818]}],["趹蹄","juétí","旧传为瑞兽，君主仁孝则出现。",{"a":1,"w":[119749,8653]}],["趼足","jiǎnzú","生老趼的脚。引申指艰苦跋涉。",{"a":1,"w":[27522,4625]}],["趾美","zhǐměi","谓继承发扬前辈的事业和美德。",{"a":1,"w":[9001,1310]}],["趿履","tālǚ","1) 拖着鞋。\n2) 拖鞋。",{"a":1,"w":[28380,7942]}],["跂脚","qíjiǎo","1) 瘸腿。\n2) 跷起脚。",{"a":1,"w":[15287,602]}],["跛蹩","bǒbié","1) 跛行。\n2) 指驽马。",{"a":1,"w":[11946,11322]}],["距国","jùguó","介于大国之间两面受敌的国家。",{"a":1,"w":[7632,23]}],["距恶","jù'è","制止为非作歹。距，通“拒”。",{"a":1,"w":[7632,7620]}],["距破","jùpò","谓抵抗并打败。距，通“拒”。",{"a":1,"w":[7632,1325]}],["距言","jùyán","拒不接受进言。距，通“拒”。",{"a":1,"w":[7632,7440]}],["距险","jùxiǎn","据守险要之地。距，通“拒”。",{"a":1,"w":[7632,4634]}],["跳石","tiàoshí","矗出水面的石头，可供人跨渡。",{"a":1,"w":[1404,7419]}],["踏颓","tàtuí","亦作“蹋颓”。\n谓履于险地。",{"a":1,"w":[4781,8639]}],["踏踘","tàjū","亦作“蹋踘”。\n见“踏鞠”。",{"a":1,"w":[4781,180209]}],["踏踧","tàcù","亦作“蹋踧”。\n见“踏蹴”。",{"a":1,"w":[4781,34207]}],["踏踶","tàdì","亦作“蹋踶”。\n见“踏蹄”。",{"a":1,"w":[4781,50975]}],["踏蹀","tàdié","亦作“蹋蹀”。\n顿足，踏地。",{"a":1,"w":[4781,19583]}],["踏道","tàdào","1) 犹探路。\n2) 台阶。",{"a":1,"w":[4781,511]}],["踏云","tàyún","亦作“蹋云”。\n腾云，驾云。",{"a":1,"w":[4781,554]}],["践伐","jiànfá","犹剪伐，诛灭。践，通“剪”。",{"a":1,"w":[8701,8087]}],["踧眉","cùméi","皱眉。忧虑貌。踧，通“蹙”。",{"a":1,"w":[34207,7988]}],["踊现","yǒngxiàn","亦作“踊现”。\n冒出；突现。",{"a":1,"w":[11141,7487]}],["蹇亢","jiǎnkàng","犹言耿直高傲。蹇，通“謇”。",{"a":1,"w":[9722,9121]}],["蹇直","jiǎnzhí","犹言忠贞耿直。蹇，通“謇”。",{"a":1,"w":[9722,1294]}],["蹇足","jiǎnzú","1) 跛足。\n2) 指驽马。",{"a":1,"w":[9722,4625]}],["蹋翅","tàchì","耷拉着翅膀。颓丧无所作为貌。",{"a":1,"w":[16367,8002]}],["蹋翼","tàyì","耷拉着翅膀。颓丧无所作为貌。",{"a":1,"w":[16367,4645]}],["蹙零","cùlíng","宋时官府向百姓加征的杂税名。",{"a":1,"w":[10026,181]}],["蹝绳","xǐshéng","杂技名。在悬空的长绳上行走。",{"a":1,"w":[40359,7867]}],["蹲舞","dūnwǔ","古代中亚民族的一种舞蹈动作。",{"a":1,"w":[3595,3356]}],["蹴踖","cùjí","I\n窘迫貌。\nII\n恭敬貌。",{"a":1,"w":[11681,38100]}],["跷然","qiāorán","亦作“蹻然”。\n形容不踏实。",{"a":1,"w":[11022,7451]}],["蹼蹬","pǔdēng","象声词。形容跌倒着地的声音。",{"a":1,"w":[26668,5380]}],["躅蹢","zhúdí","徘徊不前。引申为觊觎、窥伺。",{"a":1,"w":[11359,31434]}],["躐升","lièshēng","亦作“躐陞”。\n谓越级升迁。",{"a":1,"w":[14059,1362]}],["蹑电","nièdiàn","追逐雷电之光。形容速度极快。",{"a":1,"w":[11010,12]}],["车牛","chēniú","指牛车。为旧时交通运载工具。",{"a":1,"w":[32,1346]}],["轧然","yàrán","形容物之间相磨擦发出的声音。",{"a":1,"w":[8410,7451]}],["轩怒","xuānnù","形容气势雄浑强盛而足以动人。",{"a":1,"w":[8869,8124]}],["软绢","ruǎnjuàn","一种质地柔薄而坚韧的丝织品。",{"a":1,"w":[3349,10923]}],["轸辙","zhěnzhé","喻指范围界限。轸，通“畛”。",{"a":1,"w":[11130,9154]}],["轺旆","yáopèi","轺车上的一种旗。亦指代车子。",{"a":1,"w":[46680,14637]}],["轼辙","shìzhé","宋代文学家苏轼和苏辙的并称。",{"a":1,"w":[13005,9154]}],["轻屦","qīngjù","轻便的鞋子。代指轻盈的脚步。",{"a":1,"w":[595,10982]}],["轻绵","qīngmián","1) 絮棉。\n2) 薄棉衣。",{"a":1,"w":[595,8228]}],["轻蝉","qīngchán","1) 蝉翼。\n2) 指蝉鬓。",{"a":1,"w":[595,8931]}],["轮镳","lúnbiāo","车轮和马具。借指战车和军马。",{"a":1,"w":[2280,18613]}],["毂兵","gǔbīng","犹构兵。交战。毂，通“构”。",{"a":1,"w":[9869,2282]}],["辕缚","yuánfù","指辂木。因其缚于辕上，故名。",{"a":1,"w":[10456,9799]}],["辘轴","lùzhóu","农具名。用以平场圃或碾稻麦。",{"a":1,"w":[12622,7648]}],["辔靷","pèiyǐn","御马的缰绳和引车前行的皮带。",{"a":1,"w":[13007,77531]}],["辛刻","xīnkè","辛辣峻刻(多指文辞或言语)。",{"a":1,"w":[7882,626]}],["辟嫌","pìxián","犹避讳。指有所顾忌而不直言。",{"a":1,"w":[8072,4812]}],["辟居","pìjū","犹僻处。谓在荒远的地方居住。",{"a":1,"w":[8072,7611]}],["办东","bàndōng","犹作东。指作请客宴饮的主人。",{"a":1,"w":[610,87]}],["辞布","cíbù","谓市场上为钱物而引起的争讼。",{"a":1,"w":[7757,1283]}],["辞满","címǎn","旧指官吏任期届满，自求解退。",{"a":1,"w":[7757,592]}],["辞绂","cífú","犹辞官。绂，古代系印的绶带。",{"a":1,"w":[7757,21975]}],["辞达","cídá","谓文辞或言辞的表述明白畅达。",{"a":1,"w":[7757,7430]}],["辩善","biànshàn","谓在任何环境里都能处之泰然。",{"a":1,"w":[7873,7657]}],["农泽","nóngzé","即桃林，因其在弘农县，故称。",{"a":1,"w":[7612,7607]}],["迍厄","zhūn'è","亦作“迍厄”。\n灾难；挫折。",{"a":1,"w":[45822,8300]}],["迎承","yíngchéng","1) 仰承。\n2) 指迎合。",{"a":1,"w":[8235,7576]}],["近上","jìnshàng","接近君上，接近上层；等级高。",{"a":1,"w":[574,9]}],["近台","jìntái","乒乓球运动谓接近身前的台面。",{"a":1,"w":[574,1306]}],["近要","jìnyào","指接近皇帝的重要官职或官员。",{"a":1,"w":[574,72]}],["近觑","jìnqù","1) 近看。\n2) 犹近视。",{"a":1,"w":[574,12408]}],["迤延","yíyán","亦作“迤延”。\n见“迤涎”。",{"a":1,"w":[12338,7649]}],["迫逼","pòbī","犹逼迫。谓施加压力使人屈从。",{"a":1,"w":[8059,4792]}],["述修","shùxiū","亦作“述修”。\n修治；修明。",{"a":1,"w":[8246,1339]}],["回屏","huípíng","即围屏。一种可以摺叠的屏风。",{"a":1,"w":[79,7852]}],["迷团","mítuán","谜团；疑团。迷，用同“谜”。",{"a":1,"w":[1384,1336]}],["迷榖","mígǔ","传说中木名。佩其花不会迷惑。",{"a":1,"w":[1384,36798]}],["迷蕨","míjué","一种形状似蕨的草。嫩叶可食。",{"a":1,"w":[1384,8229]}],["迸珠","bèngzhū","散落珍珠。多形容水滴飞溅貌。",{"a":1,"w":[13835,7784]}],["追恤","zhuīxù","亦作“追恤”。\n谓补行抚恤。",{"a":1,"w":[1408,8783]}],["追拜","zhuībài","1) 改封。\n2) 犹追封。",{"a":1,"w":[1408,7752]}],["追逮","zhuīdǎi","1) 犹追捕。\n2) 追逼。",{"a":1,"w":[1408,9694]}],["退殿","tuìdiàn","旧指君王视朝完毕而退出殿堂。",{"a":1,"w":[1371,8493]}],["退言","tuìyán","犹言退有后言。谓背后有非议。",{"a":1,"w":[1371,7440]}],["退责","tuìzé","减免债务。责，“债”的本字。",{"a":1,"w":[1371,7765]}],["逃田","táotián","田主逃跑而收不到赋税的土地。",{"a":1,"w":[3455,4668]}],["逃背","táobèi","1) 败逃。\n2) 犹叛逃。",{"a":1,"w":[3455,565]}],["逆修","nìxiū","佛教谓预修佛事以求死后之福。",{"a":1,"w":[7762,1339]}],["逆封","nìfēng","旧俗以信的封筒倒封表示凶信。",{"a":1,"w":[7762,600]}],["逆暑","nìshǔ","犹迎夏。迎接暑气到来的祭礼。",{"a":1,"w":[7762,9309]}],["逆氛","nìfēn","不祥的云气。多喻凶灾、祸乱。",{"a":1,"w":[7762,9649]}],["逆焰","nìyàn","亦作“逆焰”。\n叛逆的气焰。",{"a":1,"w":[7762,8874]}],["逐熟","zhúshú","旧指灾民往丰熟地区流亡乞食。",{"a":1,"w":[7970,642]}],["通词","tōngcí","1) 传话。\n2) 指译员。",{"a":1,"w":[518,596]}],["逛游","guàngyóu","亦作“逛游”。\n转游；闲游。",{"a":1,"w":[2699,1317]}],["速熟","sùshú","谓农作物生长期短、成熟较快。",{"a":1,"w":[7497,642]}],["逢留","féngliú","青海省贵德县境内黄河的别名。",{"a":1,"w":[4797,590]}],["连最","liánzuì","旧指考评政绩、军功连续为上。",{"a":1,"w":[1288,140]}],["连栅","liánzhà","连延的栅栏。古代作战的工事。",{"a":1,"w":[1288,8487]}],["连疆","liánjiāng","1) 犹连片。\n2) 接壤。",{"a":1,"w":[1288,8674]}],["连真","liánzhēn","连写的真书(楷书)，即行书。",{"a":1,"w":[1288,85]}],["进俎","jìnzǔ","进献盛放着牛羊等肉食的礼器。",{"a":1,"w":[71,12968]}],["进戍","jìnshù","谓军队开进某地执行卫戍任务。",{"a":1,"w":[71,9666]}],["进窥","jìnkuī","谓进军而窥伺敌人以有所图谋。",{"a":1,"w":[71,8879]}],["进竭","jìnjié","犹言尽心竭力。进，通“尽”。",{"a":1,"w":[71,8647]}],["进辖","jìnxiá","谓进升职位并属上级机构管辖。",{"a":1,"w":[71,8767]}],["逴远","chuōyuǎn","1) 辽远。\n2) 犹超越。",{"a":1,"w":[22075,103]}],["逸怠","yìdài","谓贪图安乐而不勤于修身治国。",{"a":1,"w":[8116,9710]}],["逼尖","bījiān","谓压紧声带，发出尖细的声音。",{"a":1,"w":[4792,4691]}],["逼齿","bīchǐ","指因寒冷或害怕而牙齿打冷颤。",{"a":1,"w":[4792,7577]}],["逾贯","yúguàn","超过一千钱。古以千钱为一贯。",{"a":1,"w":[8781,8062]}],["遁亡","dùnwáng","1) 逃亡。\n2) 犹散失。",{"a":1,"w":[10189,7763]}],["遁叟","dùnsǒu","隐居的老翁。为唐陆希声自号。",{"a":1,"w":[10189,10993]}],["遁芝","dùnzhī","道教指人体五脏、九孔和八脉。",{"a":1,"w":[10189,8348]}],["遇臣","yùchén","即愚臣。谦称。遇，通“愚”。",{"a":1,"w":[2367,8045]}],["游烛","yóuzhú","指夜游用以照明的火炬或蜡烛。",{"a":1,"w":[1317,8450]}],["游薄","yóubáo","犹言泊舟游乐。薄，通“泊”。",{"a":1,"w":[1317,2319]}],["过月","guòyuè","怀孕的时间超过正常所须月份。",{"a":1,"w":[25,101]}],["过楼","guòlóu","临河房屋悬于河面部分的楼屋。",{"a":1,"w":[25,174]}],["过岁","guòsuì","1) 度日。\n2) 犹过年。",{"a":1,"w":[25,195]}],["遐载","xiázài","历代以来的记载。指历史记载。",{"a":1,"w":[9544,7491]}],["道店","dàodiàn","开在路旁专供旅客食宿的小店。",{"a":1,"w":[511,675]}],["道誉","dàoyù","指精通经义、道行高深的声誉。",{"a":1,"w":[511,8368]}],["达览","dálǎn","指书信送到并为接收者所阅读。",{"a":1,"w":[7430,8265]}],["遥送","yáosòng","谓注视着离去的人一直到远处。",{"a":1,"w":[8326,137]}],["逊事","xùnshì","1) 犹慎事。\n2) 辞职。",{"a":1,"w":[8043,33]}],["遵道","zūndào","遵循正道。亦以比喻遵循法度。",{"a":1,"w":[8941,511]}],["迁让","qiānràng","从原来的地方搬走，让给别人。",{"a":1,"w":[8003,627]}],["选序","xuǎnxù","谓选拔人才和升官晋级的程序。",{"a":1,"w":[588,7598]}],["选昏","xuǎnhūn","选择婚姻对象。昏，通“婚”。",{"a":1,"w":[588,4748]}],["选汰","xuǎntài","通过挑选把其中的一部分淘汰。",{"a":1,"w":[588,9623]}],["选甚","xuǎnshèn","管甚，论甚。犹言不管，不论。",{"a":1,"w":[588,8109]}],["选译",