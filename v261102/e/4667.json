[["丰肴","fēngyáo","亦作“丰肴”。\n丰盛的菜肴。",{"a":1,"w":[7828,12919]}],["丰颐","fēngyí","丰满的下巴。旧时视为有威容。",{"a":1,"w":[7828,9868]}],["艳女","yànnǚ","美艳的女子。多指歌女、舞女。",{"a":1,"w":[8710,98]}],["艳私","yànsī","艳姬和私宠。指后妃、外戚等。",{"a":1,"w":[8710,7692]}],["艳体","yàntǐ","指文词华美的诗歌。多指情诗。",{"a":1,"w":[8710,7417]}],["豨神","xīshén","传说中的兽名，状如犀而角小。",{"a":1,"w":[23588,3316]}],["豪分","háofēn","比喻细微之物。豪，通“毫”。",{"a":1,"w":[8028,15]}],["豪幸","háoxìng","指受君主宠爱而横行不法的人。",{"a":1,"w":[8028,8065]}],["豪拔","háobá","谓毫毛尖突出。豪，通“毫”。",{"a":1,"w":[8028,3360]}],["豪风","háofēng","1) 犹威风。\n2) 狂风。",{"a":1,"w":[8028,44]}],["豫严","yùyán","预先端正仪容，以示严肃恭敬。",{"a":1,"w":[8254,2349]}],["豹饰","bàoshì","古人衣袖上用豹皮制成的缘饰。",{"a":1,"w":[8732,7951]}],["貂珠","diāozhū","貂尾和珍珠。古代显贵者之饰。",{"a":1,"w":[9573,7784]}],["貂蟟","diāoliáo","蟪蛄的别名。蟪蛄，蝉的一种。",{"a":1,"w":[9573,28112]}],["貔狸","pílí","黄鼠。古时契丹称黄鼠为貔狸。",{"a":1,"w":[40250,8918]}],["貘屏","mòpíng","画有貘的屏风。旧谓可避风邪。",{"a":1,"w":[14534,7852]}],["贞器","zhēnqì","坚硬的器物。喻有大用的材器。",{"a":1,"w":[8844,7410]}],["贞根","zhēngēn","指竹根。竹有坚贞之节，故称。",{"a":1,"w":[8844,2297]}],["贞济","zhēnjì","谓有桢干之才，可以济成大事。",{"a":1,"w":[8844,7522]}],["贞美","zhēnměi","纯正美好。亦指纯正美好之人。",{"a":1,"w":[8844,1310]}],["负慝","fùtè","居心邪恶。亦指居心邪恶的人。",{"a":1,"w":[4638,11677]}],["负衡","fùhéng","谓驾车。衡，车辕头上的横木。",{"a":1,"w":[4638,7728]}],["财使","cáishǐ","谓裁决并任用。财，通“裁”。",{"a":1,"w":[7700,1332]}],["财采","cáicǎi","1) 钱财。\n2) 指财运。",{"a":1,"w":[7700,7528]}],["贫心","pínxīn","使心纯清。谓不以外物累其心。",{"a":1,"w":[7999,1279]}],["贫旅","pínlǚ","旅居而贫。亦指贫穷的旅居者。",{"a":1,"w":[7999,7730]}],["贪兵","tānbīng","为贪求土地财货而出征的军队。",{"a":1,"w":[8190,2282]}],["贪猾","tānhuá","贪婪狡猾。亦指贪婪狡猾的人。",{"a":1,"w":[8190,12647]}],["贯天","guàntiān","犹滔天。形容罪恶、灾祸极大。",{"a":1,"w":[8062,19]}],["贯族","guànzú","冠族；望族。贯，用同“冠”。",{"a":1,"w":[8062,4632]}],["责家","zéjiā","1) 负债人。\n2) 债主。",{"a":1,"w":[7765,28]}],["责居","zéjū","谓贬谪到某处居住或罢官闲居。",{"a":1,"w":[7765,7611]}],["赀囊","zīnáng","钱袋。指钱财。赀，通“资”。",{"a":1,"w":[11328,7777]}],["贰职","èrzhí","1) 副职。\n2) 任副职。",{"a":1,"w":[10098,7609]}],["贵秩","guìzhì","尊贵的职位。秩，官职的品级。",{"a":1,"w":[167,9216]}],["贬量