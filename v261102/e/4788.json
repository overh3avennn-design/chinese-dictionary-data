2257]}],["窊樽","wāzūn","指中间凹下状如酒器的岩石。",{"a":1,"w":[32596,10450]}],["窗稿","chuānggǎo","旧称私塾中学生习作的诗文。",{"a":1,"w":[8301,8822]}],["窠役","kēyì","各种名目的劳役。又称色役。",{"a":1,"w":[11633,7861]}],["窨酒","xūnjiǔ","在地窖里藏过的酒。指陈酒。",{"a":1,"w":[16403,594]}],["穷冗","qióngrǒng","犹言穷忙。多用于自谦之词。",{"a":1,"w":[2372,9654]}],["穷城","qióngchéng","历尽边城。亦指边城；危城。",{"a":1,"w":[2372,1353]}],["穷厮","qióngsī","旧时对贫穷、卑微者的蔑称。",{"a":1,"w":[2372,9389]}],["穷戚","qióngqī","窘迫；困厄。戚，通“蹙”。",{"a":1,"w":[2372,9077]}],["穷观","qióngguān","1) 大观。\n2) 遍游。",{"a":1,"w":[2372,7514]}],["穷踧","qióngcù","窘迫；困厄。踧，通“蹙”。",{"a":1,"w":[2372,34207]}],["窥睨","kuīnì","偷眼斜视。引申为伺机作恶。",{"a":1,"w":[8879,18180]}],["窜散","cuànsàn","1) 逃散。\n2) 走散。",{"a":1,"w":[4918,2286]}],["窦径","dòujìng","洞穴和小路。比喻旁门邪道。",{"a":1,"w":[9031,7769]}],["竟界","jìngjiè","边缘；边界。竟，通“境”。",{"a":1,"w":[8770,4639]}],["竦戎","sǒngróng","谓劝戒戎人。竦，通“怂”。",{"a":1,"w":[10593,8500]}],["竭情","jiéqíng","1) 尽心。\n2) 刻意。",{"a":1,"w":[8647,7490]}],["端右","duānyòu","指宰辅重臣。亦特指尚书令。",{"a":1,"w":[4659,178]}],["竹嘂","zhújiào","旧时巡夜者击以报更的竹梆。",{"a":1,"w":[7655,66942]}],["竹牙","zhúyá","亦作“竹芽”。\n笋的别称。",{"a":1,"w":[7655,2308]}],["竹笮","zhúzé","引舟的竹索。笮，通“筰”。",{"a":1,"w":[7655,28088]}],["竻城","lèchéng","古城名。在今广东省新兴县。",{"a":1,"w":[66273,1353]}],["笄珈","jījiā","原指妇人首饰。亦代指妇女。",{"a":1,"w":[13748,20549]}],["笠檐","lìyán","指笠帽周围下覆冒出的部分。",{"a":1,"w":[10898,9322]}],["笠蓑","lìsuō","斗笠与蓑衣。借指劳动人民。",{"a":1,"w":[10898,10237]}],["符厌","fúyàn","指道士巫师符咒厌胜的法术。",{"a":1,"w":[7841,8372]}],["符曹","fúcáo","古代官署中主管印信的处所。",{"a":1,"w":[7841,8358]}],["笨谜","bènmí","使人无法领悟的拙劣的谜语。",{"a":1,"w":[2544,9803]}],["笵埴","fànzhí","以模子浇制黏土。借指仿效。",{"a":1,"w":[45436,17873]}],["笔孽","bǐniè","谓以刀笔害人而造成的罪孽。",{"a":1,"w":[619,9764]}],["筋马","jīnmǎ","筋骨强健而不过于肥壮的马。",{"a":1,"w":[8060,1273]}],["笋蒂","sǔndì","竹的杈丫。蒂，枝梗连结处。",{"a":1,"w":[8811,8392]}],["策贼","cèzéi","谓根据迹象推测，查获盗贼。",{"a":1,"w":[7673,4718]}],["筠管","yúnguǎn","竹管。亦用以指笔管、毛笔。",{"a":1,"w":[16293,1278]}],["笺记","jiānjì","古代文体名。给长官的书启。",{"a":1,"w":[9999,110]}],["棰辔","chuípèi","马鞭和缰绳。泛指御马之具。",{"a":1,"w":[16887,13007]}],["节察","jiéchá","宋代节度使、观察使的合称。",{"a":1,"w":[540,7567]}],["节错","jiécuò","树木根节盘错。喻事情复杂。",{"a":1,"w":[540,147]}],["范镕","fànróng","铸造器物。比喻控制，调节。",{"a":1,"w":[7808,14710]}],["篇翰","piānhàn","犹篇章，篇简。一般指诗文。",{"a":1,"w":[703,8206]}],["篇韵","piānyùn","《玉篇》和《广韵》的并称。",{"a":1,"w":[703,8313]}],["筑蹈","zhùdǎo","捣土并以足踏之，使之坚实。",{"a":1,"w":[7896,8509]}],["篷篙","pénggāo","船帆和篙子。比喻行船生涯。",{"a":1,"w":[9193,16489]}],["簇饤","cùdìng","堆叠在食具中供陈设的食品。",{"a":1,"w":[9140,20627]}],["簉鹭","zàolù","形容百官朝见时整齐的行列。",{"a":1,"w":[42310,10351]}],["簪冕","zānmiǎn","冠簪和礼帽。喻指在朝为官。",{"a":1,"w":[9760,9800]}],["簰筏","páifá","用木和竹编的水上交通工具。",{"a":1,"w":[129630,12143]}],["簸秕","bǒbǐ","见“簸之扬之，糠秕在前”。",{"a":1,"w":[10411,12726]}],["签兵","qiānbīng","即签军。发签征调民丁入伍。",{"a":1,"w":[3396,2282]}],["簿状","bùzhuàng","记载官吏身份、资历的簿册。",{"a":1,"w":[8320,7511]}],["箓籍","lùjí","指道教的秘文与仙人的名籍。",{"a":1,"w":[15097,7983]}],["籁竽","làiyú","谓箫与竽，用竹制的管乐器。",{"a":1,"w":[19549,19081]}],["笼狎","lóngxiá","将动物畜养于笼中加以戏弄。",{"a":1,"w":[7956,9671]}],["笼禽","lóngqín","笼中之鸟。比喻不自由之身。",{"a":1,"w":[7956,8747]}],["笼箧","lóngqiè","竹箱。大的称笼，小的称箧。",{"a":1,"w":[7956,15648]}],["签筹","qiānchóu","更筹。古代计时报更的竹签。",{"a":1,"w":[3396,8478]}],["龠牡","yuèmǔ","锁闩；锁钥。龠，通“钥”。",{"a":1,"w":[17493,8408]}],["篱援","líyuán","谓竹篱上端。援，有攀触意。",{"a":1,"w":[9792,7930]}],["米贴","mǐtiē","米价补贴。是一种生活津贴。",{"a":1,"w":[557,2356]}],["粉节","fěnjié","带有白粉的竹节。亦借指竹。",{"a":1,"w":[7613,540]}],["粉题","fěntí","傅有白粉的前额。题，额头。",{"a":1,"w":[7613,615]}],["粥卖","zhōumài","出卖，出售。粥，同“鬻”。",{"a":1,"w":[4875,634]}],["红蚕","hóngcán","老熟的蚕，体呈红色，故称。",{"a":1,"w":[534,8576]}],["纡徊","yūhuái","同“纡回”。\n曲折；回环。",{"a":1,"w":[11098,24539]}],["纡洄","yūhuí","同“纡回”。\n曲折；回旋。",{"a":1,"w":[11098,14968]}],["纥奚","gēxī","复姓。见《通志‧氏族五》。",{"a":1,"w":[21201,9911]}],["纳拜","nàbài","低头拜见。纳，用同“捺”。",{"a":1,"w":[7454,7752]}],["纳赂","nàlù","1) 行贿。\n2) 受贿。",{"a":1,"w":[7454,11779]}],["纯和","chúnhé","纯正平和。多指性格或气质。",{"a":1,"w":[2373,39]}],["纯茂","chúnmào","1) 善美。\n2) 茂盛。",{"a":1,"w":[2373,8915]}],["纰罽","pījì","古代氐族人所制的兽毛织物。",{"a":1,"w":[15893,25509]}],["纱縠","shāhú","精细、轻薄的丝织品的通称。",{"a":1,"w":[8800,34089]}],["素幭","sùmiè","古代盖在车前横木上的白绸。",{"a":1,"w":[7468,87510]}],["素扇","sùshàn","洁白而没有写字绘画的扇子。",{"a":1,"w":[7468,3380]}],["素牍","sùdú","犹素书。指书札。亦指书籍。",{"a":1,"w":[7468,12670]}],["素畜","sùchù","(又读chù)见“素蓄”。",{"a":1,"w":[7468,8349]}],["素疹","sùzhěn","宿疹，旧病。疹，通“疢”。",{"a":1,"w":[7468,9143]}],["素叶","sùyè","1) 白叶。\n2) 落叶。",{"a":1,"w":[7468,7426]}],["素静","sùjìng","犹素净。谓色彩淡雅不浓艳。",{"a":1,"w":[7468,1386]}],["素骖","sùcān","驾车的白马。一般用于丧事。",{"a":1,"w":[7468,14958]}],["素鳞","sùlín","白色的鱼。亦用作鱼的泛称。",{"a":1,"w":[7468,7924]}],["纺缉","fǎngjī","纺丝和缉麻。泛指纺织之事。",{"a":1,"w":[8881,9251]}],["紫渊","zǐyuān","1) 水名。\n2) 深渊。",{"a":1,"w":[3348,8649]}],["累纸","lèizhǐ","接连许多张纸。多用于书信。",{"a":1,"w":[173,622]}],["终丧","zhōngsàng","谓服满父母去世后三年之丧。",{"a":1,"w":[7638,8016]}],["组缋","zǔhuì","丝织品上的彩色刺绣或绘饰。",{"a":1,"w":[558,16193]}],["结轶","jiéyì","犹结辙。形容车辆络绎不绝。",{"a":1,"w":[2271,11934]}],["絜清","jiéqīng","1) 清洁。\n2) 清白。",{"a":1,"w":[15154,4617]}],["絮袄","xù'ǎo","内充丝绵或棉絮的冬季上衣。",{"a":1,"w":[8894,11240]}],["统子","tǒngzi","作衣服用的毛皮料子的俗称。",{"a":1,"w":[7442,1]}],["统临","tǒnglín","统治；统领。临，居上视下。",{"a":1,"w":[7442,7625]}],["丝抹","sīmǒ","指弦乐器。后讹称“细末”。",{"a":1,"w":[7515,8295]}],["绛服","jiàngfú","赤色之服。古官服常用绦色。",{"a":1,"w":[11965,4619]}],["绛氛","jiàngfēn","亦作“绦雰”。\n赤色雾气。",{"a":1,"w":[11965,9649]}],["絺纩","chīkuàng","葛布与丝绵。指夏衣与冬衣。",{"a":1,"w":[30642,16028]}],["缀兵","zhuìbīng","指用以牵制敌方兵力的军队。",{"a":1,"w":[9248,2282]}],["缀跲","zhuìjiá","跌倒。比喻辩论时突遭窒碍。",{"a":1,"w":[9248,146913]}],["绫纨","língwán","绫与纨。指薄而细的丝织品。",{"a":1,"w":[12774,14076]}],["缘契","yuánqì","犹缘分。一般指交友的缘分。",{"a":1,"w":[7628,8094]}],["缑峰","gōufēng","即缑氏山。多指修道成仙处。",{"a":1,"w":[74153,8122]}],["缑蒯","gōukuǎi","即蒯缑。谓以草绳缠绕剑柄。",{"a":1,"w":[74153,20763]}],["缇油","tíyóu","古代车轼前屏泥的红色油布。",{"a":1,"w":[15338,547]}],["缇绣","tíxiù","赤缯与文绣。指高贵丝织品。",{"a":1,"w":[15338,4793]}],["缣箱","jiānxiāng","存放书画的箱子。亦指书画。",{"a":1,"w":[25036,2354]}],["缊絮","yūnxù","乱麻旧絮。泛指粗陋的衣服。",{"a":1,"w":[13161,8894]}],["缊袯","yūnbó","粗麻布短衣。泛指贫者之衣。",{"a":1,"w":[13161,128611]}],["缟綦","gǎoqí","“缟衣綦巾”之省。浅色服。",{"a":1,"w":[12506,11645]}],["縢牒","téngdié","犹言金缄玉牒。指帝王族谱。",{"a":1,"w":[22536,10089]}],["县帅","xiànshuài","县令、县长，主一县之政者。",{"a":1,"w":[2279,2452]}],["县空","xiànkōng","悬在空中。比喻不接触实际。",{"a":1,"w":[2279,1274]}],["县耜","xiànsì","悬耜。谓闲置农具，不耕作。",{"a":1,"w":[2279,25320]}],["缪结","móujié","纠结在一起。缪，通“纠”。",{"a":1,"w":[9670,2271]}],["繇文","yáowén","占卜的文辞。繇，通“籀”。",{"a":1,"w":[11625,7415]}],["繜绌","zūnchù","撙节。抑制。繜，通“撙”。",{"a":1,"w":[15971]}],["缋人","huìrén","《周礼》官名。掌画绘之事。",{"a":1,"w":[16193,3]}],["绳文","shéngwén","指上古时代用以记事的绳结。",{"a":1,"w":[7867,7415]}],["系械","xìxiè","加脚镣手铐等刑具拘禁起来。",{"a":1,"w":[1277,7801]}],["茧税","jiǎnshuì","官府所征的有关丝麻的赋税。",{"a":1,"w":[10851,3343]}],["缴驳","jiǎobó","1) 驳还。\n2) 驳议。",{"a":1,"w":[8608,8526]}],["绎络","yìluò","络绎。往来不绝；接连不断。",{"a":1,"w":[10031,7837]}],["纂就","zuǎnjiù","谓继承前人之事业而成就之。",{"a":1,"w":[10906,95]}],["罥索","juànsuǒ","秋千。亦指秋千架上的绳索。",{"a":1,"w":[45712,7470]}],["罩袖","zhàoxiù","方言。套在衣袖外面的套袖。",{"a":1,"w":[8168,8688]}],["置辨","zhìbiàn","1) 置辩。\n2) 辨别。",{"a":1,"w":[7529,8004]}],["署缺","shǔquē","本官出缺，由他官暂代其职。",{"a":1,"w":[8264,1412]}],["罢废","bàfèi","1) 废弃。\n2) 免职。",{"a":1,"w":[8239,7711]}],["罢驽","bànú","低劣的马。喻人的才能低下。",{"a":1,"w":[8239,14621]}],["罗潭","luótán","指汨罗江。在湖南省东北部。",{"a":1,"w":[7420,9794]}],["羁役","jīyì","亦作“羇役”。\n羁旅行役。",{"a":1,"w":[9726,7861]}],["羁思","jīsī","亦作“羇思”。\n羁旅之思。",{"a":1,"w":[9726,7586]}],["羁独","jīdú","亦作“羇独”。\n客居独处。",{"a":1,"w":[9726,7561]}],["羁穷","jīqióng","亦作“羇穷”。\n飘泊穷困。",{"a":1,"w":[9726,2372]}],["羁窭","jījù","亦作“羇窭”。\n飘泊贫困。",{"a":1,"w":[9726,14432]}],["羁管","jīguǎn","亦作“羇管”。\n拘禁管束。",{"a":1,"w":[9726,1278]}],["羁谴","jīqiǎn","亦作“羇谴”。\n贬谪流放。",{"a":1,"w":[9726,10673]}],["羁贱","jījiàn","亦作“羇贱”。\n飘泊贫贱。",{"a":1,"w":[9726,8426]}],["羁游","jīyóu","亦作“羇游”。\n羁旅无定。",{"a":1,"w":[9726,1317]}],["羁离","jīlí","亦作“羇离”。\n飘泊他乡。",{"a":1,"w":[9726,543]}],["羁魄","jīpò","亦作“羇魄”。\n旅人之心。",{"a":1,"w":[9726,9063]}],["羌零","qiānglíng","即先零羌，汉代西羌的一支。",{"a":1,"w":[9597,181]}],["美手","měishǒu","美妙的手。特指弹琴的妙手。",{"a":1,"w":[1310,34]}],["美箭","měijiàn","1) 好箭。\n2) 美竹。",{"a":1,"w":[1310,4666]}],["羝氲","dīyūn","同“愠羝”。\n腋气，狐臭。",{"a":1,"w":[38944,33739]}],["群昏","qúnhūn","佛教语。谓昏然无知的众生。",{"a":1,"w":[1348,4748]}],["群见","qúnjiàn","旧时诸贡举人到阙入对之谓。",{"a":1,"w":[1348,76]}],["羡钱","xiànqián","多余的钱。常指赋税的盈余。",{"a":1,"w":[9521,138]}],["义渊","yìyuān","仁义的渊海。喻仁义之深广。",{"a":1,"w":[7437,8649]}],["羵羊","fényáng","古代传说谓土中所生的精怪。",{"a":1,"w":[172159,1387]}],["羸骀","léidài","瘦弱驽钝的马。喻才能低下。",{"a":1,"w":[10990,16968]}],["羹藿","gēnghuò","以藿为羹。泛指粗粝的食物。",{"a":1,"w":[9089,12808]}],["羽嘉","yǔjiā","古代传说中飞行动物的远祖。",{"a":1,"w":[7878,8327]}],["羽巾","yǔjīn","道士戴的头巾。亦借指道士。",{"a":1,"w":[7878,8285]}],["羽民","yǔmín","古代传说中身上生羽毛的人。",{"a":1,"w":[7878,7434]}],["羽队","yǔduì","背着弓箭的队伍。羽，指箭。",{"a":1,"w":[7878,570]}],["翠軿","cuìpíng","古代贵族妇女乘用的翠帷车。",{"a":1,"w":[7928,36094]}],["翚甍","huīméng","两头上翘，状如鸟飞的屋脊。",{"a":1,"w":[23353,59641]}],["翳秽","yìhuì","指荆棘荒草等阻障通路之物。",{"a":1,"w":[9715,9258]}],["翘袖","qiàoxiù","举袖。指舞蹈中的一种姿势。",{"a":1,"w":[4880,8688]}],["翻却","fānquè","1) 倾覆。\n2) 反而。",{"a":1,"w":[2337,2314]}],["翻席","fānxí","一席未终，在别处另设一席。",{"a":1,"w":[2337,7836]}],["翻轩","fānxuān","屋宇前檐突起向上翻的部分。",{"a":1,"w":[2337,8869]}],["翼冯","yìféng","犹倚凭。冯，“凭”的古字。",{"a":1,"w":[4645,8535]}],["老易","lǎoyì","《老子》与《周易》的并称。",{"a":1,"w":[55,7463]}],["老湫","lǎojiǎo","湫泊。相传为云龙居处之所。",{"a":1,"w":[55,12779]}],["老癃","lǎolóng","谓年老手足麻痹，渐成废疾。",{"a":1,"w":[55,32250]}],["老确","lǎoquè","指文辞老练确凿，不求藻饰。",{"a":1,"w":[55,8047]}],["老艾","lǎo'ài","古代指五十岁以上的老年人。",{"a":1,"w":[55,7682]}],["老蟆","lǎomá","虾蟆。亦指传说的月中蟾蜍。",{"a":1,"w":[55,12410]}],["考斥","kǎochì","谓科考列入四等而予以斥退。",{"a":1,"w":[148,8735]}],["耕烟","gēngyān","农家的炊烟。借指隐居生活。",{"a":1,"w":[2416,1376]}],["耗荡","hàodàng","1) 挥霍。\n2) 损耗。",{"a":1,"w":[7916,7756]}],["耳雨","ěryǔ","谓年老聋聩，耳中常作雨声。",{"a":1,"w":[7509,159]}],["耶溪","yéxī","即若耶溪。传说西施浣纱处。",{"a":1,"w":[7530,4874]}],["圣牌","shèngpái","太平天国称腰牌为“圣牌”。",{"a":1,"w":[7587,2344]}],["圣瑞","shèngruì","古谓开国之君诞生时的祥瑞。",{"a":1,"w":[7587,8082]}],["圣轨","shèngguǐ","圣人的规范。多指儒家之教。",{"a":1,"w":[7587,7822]}],["聚唇","jùchún","撅起嘴唇。表示愤怒和怨恨。",{"a":1,"w":[2309,8248]}],["声焰","shēngyàn","亦作“声焰”。\n声威气焰。",{"a":1,"w":[3317,8874]}],["耸翠","sǒngcuì","形容山峦、树木等高耸苍翠。",{"a":1,"w":[5040,7928]}],["耸视","sǒngshì","敬畏地注视。耸，通“竦”。",{"a":1,"w":[5040,7494]}],["耸局","sǒngjú","惊惧不进貌。耸，通“悚”。",{"a":1,"w":[5040,2291]}],["听势","tīngshì","方言。听凭情势的发展变化。",{"a":1,"w":[146,7642]}],["肃振","sùzhèn","剧烈震动。有令人恐惧之意。",{"a":1,"w":[8439,7579]}],["肇域","zhàoyù","1) 疆界。\n2) 划分。",{"a":1,"w":[9721,7823]}],["肌雪","jīxuě","指女子像雪那样白润的肌肤。",{"a":1,"w":[7900,616]}],["肘掣","zhǒuchè","拉住胳膊。比喻牵制或留难。",{"a":1,"w":[9286,9713]}],["肥秩","féizhì","犹肥缺。指收入丰厚的官位。",{"a":1,"w":[2353,9216]}],["肥遗","féiyí","1) 鸟名。\n2) 蛇名。",{"a":1,"w":[2353,7664]}],["背依","bèiyī","谓背靠屏风。依，通“扆”。",{"a":1,"w":[565,7713]}],["背珥","bèi'ěr","指背谲、抱珥，即日旁云气。",{"a":1,"w":[565,11050]}],["胙余","zuòyú","古称祭祀完毕后所余的酒肉。",{"a":1,"w":[23284,7597]}],["胡耇","húgǒu","年老的人。亦指年老；高寿。",{"a":1,"w":[7554,163987]}],["胡运","húyùn","泛指非汉族人的气数、国运。",{"a":1,"w":[7554,3313]}],["胥怨","xūyuàn","相怨。多指百姓对上的怨恨。",{"a":1,"w":[9768,3431]}],["胥算","xūsuàn","封建官府中主管计算的吏员。",{"a":1,"w":[9768,573]}],["胯衫","kuàshān","古时宦者之服。亦借指宦者。",{"a":1,"w":[21815,9082]}],["脂盝","zhīlù","化妆用的盒子。亦泛指妆具。",{"a":1,"w":[7903,108404]}],["脱尸","tuōshī","灵魂脱离尸体，死亡的婉辞。",{"a":1,"w":[2312,7967]}],["腆嘿","tiǎnhēi","亦作“腆默”。\n羞惭不语。",{"a":1,"w":[11449,5333]}]]