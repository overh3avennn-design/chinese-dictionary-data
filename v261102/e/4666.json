[["祭酹","jìlèi","行祭时以酒洒地。亦泛指祭奠。",{"a":1,"w":[8417,37075]}],["禄荫","lùyīn","谓凭藉先人余荫而取得的禄位。",{"a":1,"w":[8602,8853]}],["禄鬼","lùguǐ","对着力追求官位俸禄者的蔑称。",{"a":1,"w":[8602,3340]}],["禁司","jìnsī","指主管防禁之事的部门或官员。",{"a":1,"w":[7708,7476]}],["禁额","jìn'é","禁苑中宫殿台观门楼上的匾额。",{"a":1,"w":[7708,7720]}],["禊川","xìchuān","古人修禊事活动所滨临的水流。",{"a":1,"w":[41207,7897]}],["福壤","fúrǎng","堪舆家所称地脉灵气所钟之地。",{"a":1,"w":[1365,8583]}],["福乡","fúxiāng","指神仙所居、福德所集的地方。",{"a":1,"w":[1365,3375]}],["禅人","chánrén","泛指修持佛学、皈依佛法的人。",{"a":1,"w":[8805,3]}],["禅味","chánwèi","谓入于禅定时安稳寂静的妙趣。",{"a":1,"w":[8805,7712]}],["礼引","lǐyǐn","举行典礼时引导宾主行礼之人。",{"a":1,"w":[3342,2281]}],["祷切","dǎoqiè","书信客套用语。表示祈求急切。",{"a":1,"w":[9677,2276]}],["禳田","rángtián","祭神祈求灾异不作，庄稼丰收。",{"a":1,"w":[15582,4668]}],["禾绢","héjuàn","1) 指皇帝。\n2) 谷穗。",{"a":1,"w":[8684,10923]}],["私褚","sīchǔ","私人储藏之物。褚，通“储”。",{"a":1,"w":[7692,15557]}],["秋酎","qiūzhòu","秋日祭祀宗庙所用的重酿醇酒。",{"a":1,"w":[1391,35509]}],["秋闺","qiūguī","秋日的闺房。指易引秋思之所。",{"a":1,"w":[1391,9497]}],["科差","kēchà","官府向民户征收财物或派劳役。",{"a":1,"w":[512,121]}],["秤色","chèngsè","指金银一类物品的分量和成色。",{"a":1,"w":[5052,2266]}],["秦仪","qínyí","战国纵横家苏秦和张仪的并称。",{"a":1,"w":[8261,7483]}],["秦桥","qínqiáo","相传秦始皇东游时所造的石桥。",{"a":1,"w":[8261,1435]}],["秦正","qínzhèng","指夏历十月。正，一年的开始。",{"a":1,"w":[8261,62]}],["秦乌","qínwū","战国末年燕太子丹，留质于秦。",{"a":1,"w":[8261,7520]}],["移窠","yíkē","谓婴儿生满一月后，移乳母处。",{"a":1,"w":[2306,11633]}],["禀生","bǐngshēng","1) 犹受生。\n2) 禀性。",{"a":1,"w":[9733,508]}],["种盐","zhǒngyán","1) 制盐。\n2) 做盐商。",{"a":1,"w":[1344,2404]}],["稽殿","jīdiàn","谓执行法令不及时，办事拖拉。",{"a":1,"w":[8842,8493]}],["积溜","jīliū","亦作“积溜”。\n滞积的水流。",{"a":1,"w":[7496,4717]}],["秽芜","huìwú","1) 杂草。\n2) 指杂乱。",{"a":1,"w":[9258,9520]}],["空涛","kōngtāo","指回荡于空中的浪涛般的声响。",{"a":1,"w":[1274,11504]}],["穾要","yàoyào","亦作“窔要”。\n秘奥，要旨。",{"a":1,"w":[50469,72]}],["窈娘","yǎoniáng","唐武则天时左司郎中乔知之婢。",{"a":1,"w":[14217,8089]}],["穷新","qióngxīn","有穷氏与王莽所建新朝的并称。",{"a":1,"w":[2372,80]}],["穷节","qióngjié","1) 喻老年。\n2) 季冬。",{"a":1,"w":[2372,540]}],["穷览","qiónglǎn","1) 遍观。\n2) 犹壮观。",{"a":1,"w":[2372,8265]}],["穷饿","qióng'è","穷困饥饿。亦指穷困饥饿之人。",{"a":1,"w":[2372,229]}],["穷鲠","qiónggěng","形容极端悲痛。鲠，通“哽”。",{"a":1,"w":[2372,13292]}],["竟尉","jìngwèi","古代边境武官。竟，通“境”。",{"a":1,"w":[8770,9085]}],["竹祖","zhúzǔ","带有笋芽的竹鞭。亦借指老竹。",{"a":1,"w":[7655,7723]}],["竹阴","zhúyīn","谓竹林中日光照射不到的地方。",{"a":1,"w":[7655,576]}],["笄导","jīdǎo","即簪导。一种首饰。用以束发。",{"a":1,"w":[13748,7493]}],["符授","fúshòu","谓官员罢任时将公物移交后任。",{"a":1,"w":[7841,8099]}],["笔偈","bǐjì","仿照佛家偈语编成的书法口诀。",{"a":1,"w":[619,18844]}],["笔悬","bǐxuán","文具名。用以悬挂毛笔的架子。",{"a":1,"w":[619,4694]}],["笔赛","bǐsài","报纸或刊物等举办的征文比赛。",{"a":1,"w":[619,4655]}],["筌象","quánxiàng","佛教语。指未超脱尘世的景象。",{"a":1,"w":[37827,7500]}],["策牍","cèdú","简策版牍。后指书写用的纸张。",{"a":1,"w":[7673,12670]}],["策目","cèmù","科举考试时，作策试用的题目。",{"a":1,"w":[7673,7465]}],["箭猺","jiànyáo","谓发髻上插有竹簪的瑶族女子。",{"a":1,"w":[4666,38487]}],["箴盥","zhēnguàn","古代妇女承姑奉盥，视为箴规。",{"a":1,"w":[13367,14244]}],["箸匕","zhùbǐ","筷和勺。均取食用具，常连用。",{"a":1,"w":[11900,15468]}],["节删","jiéshān","将文字中的某些部分予以删除。",{"a":1,"w":[540,9465]}],["篝衣","gōuyī","把衣服放在熏笼上烘干或烘暖。",{"a":1,"w":[15712,7536]}],["简亮","jiǎnliàng","1) 犹正直。\n2) 简明。",{"a":1,"w":[7804,641]}],["簪裾","zānjū","古代显贵者的服饰。借指显贵。",{"a":1,"w":[9760,19947]}],["帘旌","liánjīng","帘端所缀之布帛。亦泛指帘幕。",{"a":1,"w":[8925,9840]}],["籍圃","jípǔ","指籍田中种植果木瓜菜的园地。",{"a":1,"w":[7983,13245]}],["箨冠","tuòguān","竹皮冠。用竹笋皮制成的帽子。",{"a":1,"w":[32164,7694]}],["笼鞋","lóngxié","一种足趾露在外面的有孔凉鞋。",{"a":1,"w":[7956,685]}],["笼驾","lóngjià","谓拦道阻行。比喻影响、阻碍。",{"a":1,"w":[7956,7879]}],["签函","qiānhán","书卷的签牌与封套。泛指书籍。",{"a":1,"w":[3396,7764]}],["签省","qiānshěng","南北朝官职签帅和省事的并称。",{"a":1,"w":[3396,607]}],["篱门","límén","竹篱的门。常借指隐居的茅舍。",{"a":1,"w":[9792,53]}],["籯椟","yíngdú","籯和椟。泛指存放珍宝的器具。",{"a":1,"w":[60708,16044]}],["米糱","mǐniè","生芽的米麦。亦泛指米麦粮食。",{"a":1,"w":[557,257495]}],["粉拂","fěnfú","即粉扑。敷粉时用以蘸粉拍脸。",{"a":1,"w":[7613,8565]}],["粟秩","sùzhì","俸禄。古时以粟米支俸，故称。",{"a":1,"w":[8203,9216]}],["精芒","jīngmáng","1) 光芒。\n2) 犹精锐。",{"a":1,"w":[4629,8347]}],["糜乱","míluàn","1) 犹糜烂。\n2) 散乱。",{"a":1,"w":[9609,1360]}],["纪善","jìshàn","明代亲王属官名，掌讲授之职。",{"a":1,"w":[7653,7657]}],["红阳","hóngyáng","1) 古人名。\n2) 红日。",{"a":1,"w":[534,7484]}],["纳剌","nàlá","复姓。见《金史‧金国语解》。",{"a":1,"w":[7454,8630]}],["纳礼","nàlǐ","旧时婚礼中男方向女方送财礼。",{"a":1,"w":[7454,3342]}],["纮紞","hóngdǎn","古代垂于冠冕两旁悬瑱的带子。",{"a":1,"w":[32032,54670]}],["纮纲","hónggāng","1) 网索。\n2) 泛指网。",{"a":1,"w":[32032,8152]}],["纷回","fēnhuí","亦作“纷回”。\n变化繁多貌。",{"a":1,"w":[8527,79]}],["素雉","sùzhì","白色野鸡。古代以为祥瑞之兆。",{"a":1,"w":[7468,9135]}],["索放","suǒfàng","犹素放。白白放过；随便释放。",{"a":1,"w":[7470,63]}],["紫墀","zǐchí","殿庭台阶，以红色涂饰，故称。",{"a":1,"w":[3348,29081]}],["累屋","lèiwū","谓屋上造屋。多比喻反覆重叠。",{"a":1,"w":[173,3389]}],["细绿","xìlǜ","1) 嫩芽。\n2) 指细眉。",{"a":1,"w":[2287,605]}],["绌陟","chùzhì","谓人事之降升。绌，通“黜”。",{"a":1,"w":[15971,12183]}],["絜皋","jiégāo","即桔槔。井上汲水的一种工具。",{"a":1,"w":[15154,10318]}],["絜驾","jiéjià","谓乘车不徒行。形容安享富贵。",{"a":1,"w":[15154,7879]}],["丝斤","sījīn","指蚕丝。蚕丝以斤计量，故称。",{"a":1,"w":[7515,714]}],["绛符","jiàngfú","道教用以召神驱鬼的红色符箓。",{"a":1,"w":[11965,7841]}],["综物","zōngwù","1) 犹治事。\n2) 治民。",{"a":1,"w":[7835,7412]}],["绿秋","lǜqiū","磁性已消失的磁石，可作药材。",{"a":1,"w":[605,1391]}],["绻缱","quǎnqiǎn","缱绻。谓感情深切，难舍难分。",{"a":1,"w":[74523,80980]}],["绶囊","shòunáng","古代官吏系在腰间盛绶的口袋。",{"a":1,"w":[10706,7777]}],["网轩","wǎngxuān","网户，装饰有网状雕刻的门窗。",{"a":1,"w":[559,8869]}],["缀辂","zhuìlù","金辂。古代天子所乘的一种车。",{"a":1,"w":[9248,14323]}],["线鸡","xiànjī","阉鸡。指阉割鸡或阉割过的鸡。",{"a":1,"w":[1282,578]}],["缘夤","yuányín","夤缘。攀附上升。谓拉拢关系。",{"a":1,"w":[7628,34231]}],["缘领","yuánlǐng","旧时称用在衣领上的珠翠饰物。",{"a":1,"w":[7628,1361]}],["缑岭","gōulǐng","即缑氏山。多指修道成仙之处。",{"a":1,"w":[74153,8515]}],["练形","liànxíng","方士修炼形体，以求超脱成仙。",{"a":1,"w":[633,4612]}],["练影","liànyǐng","指日、月、水波等的白色光影。",{"a":1,"w":[633,7513]}],["缇盎","tí'àng","缇齐与盎齐。均酒名。泛指酒。",{"a":1,"w":[15338,12348]}],["繀车","suìchē","缫丝车。有收丝的转轮，故名。",{"a":1,"w":[32]}],["缪戾","móulì","亦作“缪盭”。\n错乱；违背。",{"a":1,"w":[9670,9083]}],["织罗","zhīluó","罗织。谓虚构罪名，陷害无辜。",{"a":1,"w":[4705,7420]}],["绳地","shéngdì","清代称以绳为计量单位的土地。",{"a":1,"w":[7867,10]}],["绳坐","shéngzuò","1) 正坐。\n2) 指绳床。",{"a":1,"w":[7867,128]}],["绳矩","shéngjǔ","墨绳与矩尺。比喻规矩、标准。",{"a":1,"w":[7867,8181]}],["缨蕤","yīngruí","冠上饰物。亦借指文人士大夫。",{"a":1,"w":[9033,14150]}],["才属","cáishǔ","仅能连续。形容声气微弱乏力。",{"a":1,"w":[603,1268]}],["纤末","xiānmò","1) 犹末梢。\n2) 细小。",{"a":1,"w":[7725,2329]}],["纤缴","xiānjiǎo","系在箭上的细生丝绳，射鸟用。",{"a":1,"w":[7725,8608]}],["罗囿","luóyòu","传说中的天苑，神话中的园林。",{"a":1,"w":[7420,12728]}],["罗幡","luófān","宋代新春时戴在头上的装饰物。",{"a":1,"w":[7420,10797]}],["罗袂","luómèi","丝罗的衣袖。亦指华丽的衣着。",{"a":1,"w":[7420,15354]}],["羁客","jīkè","亦作“羇客”。\n旅客；旅人。",{"a":1,"w":[9726,7618]}],["羁寓","jīyù","亦作“羇寓”。\n寄居；旅居。",{"a":1,"w":[9726,9167]}],["羁愁","jīchóu","亦作“羇愁”。\n旅人的愁思。",{"a":1,"w":[9726,3481]}],["羁怀","jīhuái","亦作“羇怀”。\n寄旅的情怀。",{"a":1,"w":[9726,7749]}],["羁络","jīluò","1) 马络头。\n2) 控制。",{"a":1,"w":[9726,7837]}],["羁缨","jīyīng","马络头和缰绳。喻拘系，束缚。",{"a":1,"w":[9726,9033]}],["羁雌","jīcí","亦作“羇雌”。\n失偶的雌鸟。",{"a":1,"w":[9726,10657]}],["羔犊","gāodú","小羊和小牛。常比喻弱的一方。",{"a":1,"w":[11158,10334]}],["羝乳","dīrǔ","公羊产乳。喻不可能发生之事。",{"a":1,"w":[38944,7719]}],["群士","qúnshì","1) 百官。\n2) 众士人。",{"a":1,"w":[1348,7542]}],["群室","qúnshì","春秋时代指都邑中的所有住户。",{"a":1,"w":[1348,1359]}],["义海","yìhǎi","义理的渊海。喻义理博大精深。",{"a":1,"w":[7437,528]}],["羽渊","yǔyuān","池潭名。传说鲧死后化黄熊处。",{"a":1,"w":[7878,8649]}],["羽磬","yǔqìng","传说中的瀛洲石磬，因轻而鸣。",{"a":1,"w":[7878,11487]}],["习陈","xíchén","演习战阵之事。陈，通“阵”。",{"a":1,"w":[7678,7893]}],["翠茵","cuìyīn","谓绿草如茵。亦指茂密的绿草。",{"a":1,"w":[7928,10767]}],["翳酿","yìniàng","古代一种去邪消灾的祭祷活动。",{"a":1,"w":[9715,8806]}],["翘举","qiàojǔ","1) 上举。\n2) 犹特出。",{"a":1,"w":[4880,606]}],["翼瓦","yìwǎ","谓屋瓦整齐铺列，如鸟翼相覆。",{"a":1,"w":[4645,7533]}],["耆耋","qídié","1) 老年。\n2) 指老人。",{"a":1,"w":[8495,27975]}],["端意","duānyì","专意。谓心思专用于某一方面。",{"a":1,"w":[4659,7482]}],["耕坛","gēngtán","古时天子行藉田礼所用的土台。",{"a":1,"w":[2416,8465]}],["耕耰","gēngyōu","耕田翻土。亦用以喻辛勤工作。",{"a":1,"w":[2416,26227]}],["锄粟","chúsù","传说井田制中一井所纳的税粟。",{"a":1,"w":[9844,8203]}],["耳择","ěrzé","用耳选择所闻。意谓非礼勿听。",{"a":1,"w":[7509,8066]}],["耳决","ěrjué","犹耳闻。只凭传闻即加决断意。",{"a":1,"w":[7509,7574]}],["耿贾","gěngjiǎ","东汉初名臣耿弇和贾复的并称。",{"a":1,"w":[11102,8056]}],["耿邓","gěngdèng","东汉初名臣耿弇和邓禹的并称。",{"a":1,"w":[11102,10432]}],["圣笤","shèngtiáo","表示吉兆的卦。笤，一种卜具。",{"a":1,"w":[7587,51487]}],["联吟","liányín","犹联句。两人或多人共作一诗。",{"a":1,"w":[7455,8955]}],["联肩","liánjiān","并肩。喻行动一致，关系密切。",{"a":1,"w":[7455,3459]}],["肃陈","sùchén","肃然陈列。形容有威势的样子。",{"a":1,"w":[8439,7893]}],["肆祀","sìsì","祭名。谓以全牛全羊祭祀祖先。",{"a":1,"w":[8346,9915]}],["肉试","ròushì","谓以兽躯试验刀剑锋刃之利钝。",{"a":1,"w":[116,105]}],["肘翼","zhǒuyì","胳膊肘和羽翼，比喻切近之地。",{"a":1,"w":[9286,4645]}],["胄监","zhòujiān","即国子监。亦指国子监的生员。",{"a":1,"w":[15090,7644]}],["胇胃","fèiwèi","古大傩时所扮十二驱疫神之一。",{"a":1,"w":[444060,3465]}],["背利","bèilì","指负担很重的或长时期的利息。",{"a":1,"w":[565,4606]}],["胡嘌","húpiào","1) 乱唱。\n2) 谓乱说。",{"a":1,"w":[7554,11948]}],["胥母","xūmǔ","山名。即今江苏省吴县莫厘山。",{"a":1,"w":[9768,4637]}],["脂灰","zhīhuī","以油脂和石灰，犹今油灰之类。",{"a":1,"w":[7903,3344]}],["脽丘","shuíqiū","地名。在今山西省万荣县境内。",{"a":1,"w":[119305,7868]}],["腐胁","fǔxié","谓由于沉湎于酒而使胸部溃烂。",{"a":1,"w":[7770,8936]}],["腕脱","wàntuō","手腕脱位。形容书写忙迫紧张。",{"a":1,"w":[9173,2312]}],["腥氛","xīngfēn","犹妖氛。用以指黑暗凶残势力。",{"a":1,"w":[5241,9649]}],["腰棚","yāopéng","旧时戏园或戏场中两旁的看棚。",{"a":1,"w":[2364,8961]}],["腰袱","yāofú","系于腰部的包袱。多用以藏钱。",{"a":1,"w":[2364,13843]}],["腰铡","yāozhá","犹腰斩。一种处死犯人的酷刑。",{"a":1,"w":[2364,20668]}],["膀浪","bǎnglàng","宋代口语。形容说话不着边际。",{"a":1,"w":[8994,7832]}],["肤札","fūzhá","文身，在皮肤上刺出各种图形。",{"a":1,"w":[8232,8726]}],["肤躁","fūzào","轻浮狡猾。亦指轻浮狡猾之徒。",{"a":1,"w":[8232,9259]}],["胶淤","jiāoyū","指水道因泥沙沉积而不能畅通。",{"a":1,"w":[7702,9875]}],["膺臆","yīngyì","胸臆。多指个人的思想或见解。",{"a":1,"w":[10336,11972]}],["卧甲","wòjiǎ","不解甲而卧。有枕戈待敌之意。",{"a":1,"w":[7997,3330]}],["临途","líntú","本为即将上路，借指离开人世。",{"a":1,"w":[7625,8207]}],["至纫","zhìrèn","书信中的套语。表示深感对方。",{"a":1,"w":[3346,10516]}],["至临","zhìlín","谓处于极好的地位以居高临下。",{"a":1,"w":[3346,7625]}],["举口","jǔkǒu","1) 犹众口。\n2) 张口。",{"a":1,"w":[606,47]}],["举籍","jǔjí","统计人口、田亩等以登记成册。",{"a":1,"w":[606,7983]}],["旧匹","jiùpǐ","谓世代有婚姻之谊。匹，匹配。",{"a":1,"w":[1396,3427]}],["旧生","jiùshēng","犹先儒。生，古时为儒者之称。",{"a":1,"w":[1396,508]}],["舌举","shéjǔ","舌翘起而不能动。指理屈词穷。",{"a":1,"w":[7844,606]}],["舜琴","shùnqín","五弦琴。相传为舜为创，故云。",{"a":1,"w":[11756,3367]}],["舞商","wǔshāng","舞蹈着的商羊。指下雨的预兆。",{"a":1,"w":[3356,7485]}],["般比","bānbǐ","比拟，比得上。般，通“班”。",{"a":1,"w":[7939,38]}],["船骥","chuánjì","船与良马。比喻治国贤能之臣。",{"a":1,"w":[621,9554]}],["良乐","liánglè","春秋时晋王良和秦伯乐的并称。",{"a":1,"w":[7645,1340]}],["艾褐","àihè","印染、绘画等所用的一种颜料。",{"a":1,"w":[7682,8166]}],["艿稗","nǎibài","泛指杂草。亦以喻芜杂的事物。",{"a":1,"w":[54582,10625]}],["花宵","huāxiāo","花烛之夜。指结婚那天的晚上。",{"a":1,"w":[20,9364]}],["刍论","chúlùn","浅陋的议论。多用为自谦之辞。",{"a":1,"w":[10080,7480]}],["苞蒙","bāoméng","草木丛生貌。亦指丛生的草木。",{"a":1,"w":[8067,4647]}],["若如","ruòrú","1) 若干。\n2) 如；像。",{"a":1,"w":[4652,4614]}],["苦煎","kǔjiān","形容身心备受折磨。煎，煎熬。",{"a":1,"w":[2322,4846]}],["英濩","yīnghuò","古乐《五英》、《濩》的并称。",{"a":1,"w":[7637,21211]}],["荃荪","quánsūn","香草。古代常用以喻贤良的人。",{"a":1,"w":[31567,19256]}],["草架","cǎojià","草图。古代构筑前设计的图样。",{"a":1,"w":[521,1341]}],["荆姬","jīngjī","指楚地的美女。亦用以喻名花。",{"a":1,"w":[8436,8824]}],["荆宝","jīngbǎo","即和氏璧。亦用以喻美好资质。",{"a":1,"w":[8436,2313]}],["荆笄","jīngjī","用荆枝制成的发簪。借指贫妇。",{"a":1,"w":[8436,13748]}],["菜骨","càigǔ","犹瘦骨。长年蔬食而骨瘦体弱。",{"a":1,"w":[111,7537]}],["华珰","huádāng","华美的椽头的装饰。珰，瓦当。",{"a":1,"w":[7503,20393]}],["万庾","wànyǔ","谓谷物丰盛。庾，露天的谷仓。",{"a":1,"w":[568,15859]}],["葆和","bǎohé","保持恬淡平和。葆，通“保”。",{"a":1,"w":[11938,39]}],["葆盖","bǎogài","古代车子上用鸟羽装饰的车盖。",{"a":1,"w":[11938,2289]}],["苇笮","wěizé","用苇草制成的绳索。笮，竹索。",{"a":1,"w":[9735,28088]}],["蒲博","púbó","古代的一种博戏。亦泛指赌博。",{"a":1,"w":[8305,7502]}],["蒸薪","zhēngxīn","1) 木柴。\n2) 烧柴火。",{"a":1,"w":[7703,8398]}],["蓹儿","yù'ér","古地名。在今浙江省嘉兴市南。",{"a":1,"w":[7408]}],["蕃朝","fāncháo","指异国之朝廷。蕃，通“番”。",{"a":1,"w":[9068,1357]}],["薄暝","báomíng","犹薄暮。傍晚，天将黑的时候。",{"a":1,"w":[2319,17265]}],["蓝蔚","lánwèi","深蓝色。亦用以借指天、水等。",{"a":1,"w":[623,10050]}],["藘蕠","lǘrú","形容植物的根生长得错综牵连。",{"a":1,"w":[99276]}],["薮牧","sǒumù","畜牧之地。亦指从事畜牧之人。",{"a":1,"w":[10471,8148]}],["藰莅","liúlì","象声词。风吹树木发出的声响。",{"a":1,"w":[752864,11809]}],["兰烬","lánjìn","烛之余烬。因状似兰心，故称。",{"a":1,"w":[7450,15206]}],["虎兕","hǔsì","虎与犀牛。比喻凶恶残暴的人。",{"a":1,"w":[3337,20710]}],["虎吓","hǔxià","1) 犹吓唬。\n2) 诈骗。",{"a":1,"w":[3337,3550]}],["虎箓","hǔlù","有虎形纹饰的符箓，道士所佩。",{"a":1,"w":[3337,15097]}],["虎阱","hǔjǐng","捕虎的陷阱。比喻艰险的境地。",{"a":1,"w":[3337,9964]}],["虐敛","nüèliǎn","犹暴敛。大肆搜刮人民的财富。",{"a":1,"w":[8532,8878]}],["虐焰","nüèyàn","亦作“虐焰”。\n残暴的气焰。",{"a":1,"w":[8532,8874]}],["处妇","chùfù","待在家中的妇女。指征夫之妻。",{"a":1,"w":[2272,7957]}],["虚莽","xūmǎng","丘墟和草莽。指衰败荒芜之地。",{"a":1,"w":[7779,9464]}],["虚豁","xūhuō","1) 旷达。\n2) 犹虚空。",{"a":1,"w":[7779,8714]}],["虚鄙","xūbǐ","虚伪卑鄙。亦指虚伪卑鄙之人。",{"a":1,"w":[7779,9507]}],["虏官","lǔguān","古时蜀人对北人仕蜀者的贬称。",{"a":1,"w":[10399,2293]}],["虞褚","yúchǔ","指唐代书法家虞世南与褚遂良。",{"a":1,"w":[8652,15557]}],["虹泉","hóngquán","瀑布。远望如高悬天际，故称。",{"a":1,"w":[9919,3461]}],["蚊眉","wénméi","蚊子的眉毛。比喻极小的地方。",{"a":1,"w":[9095,7988]}],["蚊翼","wényì","蚊虫的翅膀。比喻极小的事物。",{"a":1,"w":[9095,4645]}],["蚤寡","zǎoguǎ","妇女年少丧夫。蚤，通“早”。",{"a":1,"w":[9661,8272]}],["蛇灵","shélíng","谓灵蛇之珠。比喻卓越的才能。",{"a":1,"w":[3363,7588]}],["蛉川","língchuān","“蜻蛉川”的省称。\n在云南。",{"a":1,"w":[14158,7897]}],["蛋划","dànhuà","蛋人用的小船。蛋，同“蜑”。",{"a":1,"w":[628,2311]}],["蛑贼","móuzéi","吃禾苗的两种害虫。亦喻坏人。",{"a":1,"w":[71607,4718]}],["蜀鹿","shǔlù","即涿鹿。相传黄帝诛蚩尤于此。",{"a":1,"w":[8443,8199]}],["蜂牖","fēngyǒu","即蜂窠。比喻窄小而众多的窗。",{"a":1,"w":[7959,16356]}],["蜜勿","mìwù","机密，机要。蜜，用同“密”。",{"a":1,"w":[8157,3457]}],["蜩蝉","tiáochán","1) 即蝉。\n2) 指宦官。",{"a":1,"w":[24051,8931]}],["虾虹","xiāhóng","指彩色的云气。虾，通“霞”。",{"a":1,"w":[8057,9919]}],["虾蚾","xiāpí","亦作“蛤蚾”。\n蟾蜍的别名。",{"a":1,"w":[8057]}],["虾蛤","xiāhá","1) 兽名。\n2) 虾和蛤。",{"a":1,"w":[8057,9223]}],["蝮蝎","fùxiē","蝮蛇与蝎子。泛指毒蛇、毒虫。",{"a":1,"w":[10756,10033]}],["蜗蚓","wōyǐn","蜗牛与蚯蚓。亦喻微小的事物。",{"a":1,"w":[13793,18034]}],["螟蜮","míngyù","螟和蜮，危害禾苗的两种害虫。",{"a":1,"w":[13926,24016]}],["虫响","chóngxiǎng","1) 指蝉声。\n2) 虫鸣。",{"a":1,"w":[7601,639]}],["蛏肠","chēngcháng","福建、广东人对蛏子肉的俗称。",{"a":1,"w":[36992,3392]}],["蟹泉","xièquán","泉名。在今山西省永济县境内。",{"a":1,"w":[8486,3461]}],["蚁接","yǐjiē","像蚂蚁般往来连接。极言其多。",{"a":1,"w":[8267,548]}],["虿毒","chàidú","虿尾之毒。亦比喻祸害，毒害。",{"a":1,"w":[22872,3322]}],["虿锋","chàifēng","虿尾的毒刺。比喻凶恶的气焰。",{"a":1,"w":[22872,8275]}],["蜡彩","làcǎi","涂过蜡的彩绸。比喻光润鲜艳。",{"a":1,"w":[8142,7795]}],["蜡鞭","làbiān","谓以蜡润鞭。比喻外美而中腐。",{"a":1,"w":[8142,8162]}],["蜡鼻","làbí","鹞鹰的一种。鼻根色黄，故名。",{"a":1,"w":[8142,7737]}],["蠡种","lízhǒng","春秋越大夫范蠡、文种的并称。",{"a":1,"w":[11897,1344]}],["蛊事","gǔshì","犹故事。指旧日的典章制度等。",{"a":1,"w":[10485,33]}],["蛊术","gǔshù","指祈祷鬼神、诅咒等厌魅邪术。",{"a":1,"w":[10485,7471]}],["蚕台","cántái","养蚕器具。用以安放团匾养蚕。",{"a":1,"w":[8576,1306]}],["蠹简","dùjiǎn","被虫蛀坏的书。泛指破旧书籍。",{"a":1,"w":[9819,7804]}],["蛮獠","mánliáo","旧时对西南方少数民族的蔑称。",{"a":1,"w":[8711,11985]}],["蛮锦","mánjǐn","西南和南方少数民族所织的锦。",{"a":1,"w":[8711,7982]}],["血荫","xuèyīn","指血液瘀结而隐约显现的印痕。",{"a":1,"w":[1354,8853]}],["行垣","xíngyuán","古代防御战具，用以布阵阻塞。",{"a":1,"w":[8,10422]}],["行旃","xíngzhān","帝王或高官出行时所树的大旗。",{"a":1,"w":[8,11507]}],["行绋","xíngfú","谓执绋助葬。绋，引柩的绳索。",{"a":1,"w":[8,20543]}],["行馆","xíngguǎn","旧时官员出行在外的临时居所。",{"a":1,"w":[8,7919]}],["卫索","wèisuǒ","晋代书法家卫瓘和索靖的并称。",{"a":1,"w":[7546,7470]}],["冲替","chōngtì","宋代公文习用语。谓贬降官职。",{"a":1,"w":[2284,2368]}],["冲缓","chōnghuǎn","指冲要和平缓两种相对的地形。",{"a":1,"w":[2284,7961]}],["衡厄","héng'è","喻束缚；压迫。厄，通“轭”。",{"a":1,"w":[7728,8300]}],["衰德","shuāidé","道德衰败。亦指道德衰败的人。",{"a":1,"w":[7950,7416]}],["衰懦","shuāinuò","衰弱怯懦。亦指衰弱怯懦的人。",{"a":1,"w":[7950,14055]}],["衽服","rènfú","左衽之服。指少数民族的服装。",{"a":1,"w":[12788,4619]}],["衿士","jīnshì","指秀才。亦泛指年轻的读书人。",{"a":1,"w":[11664,7542]}],["袀袯","jūnbó","一色粗布衣服。借指庶民百姓。",{"a":1,"w":[39923,128611]}],["袃蒯","chàikuǎi","刺鲠。比喻心里的嫌隙或不快。",{"a":1,"w":[20763]}],["袖琴","xiùqín","可置于怀袖中的琴。极言其小。",{"a":1,"w":[8688,3367]}],["衮球","gǔnqiú","古代置于被褥中以取暖的炉子。",{"a":1,"w":[12193,83]}],["里弦","lǐxián","胡琴上靠里的比较粗的那根弦。",{"a":1,"w":[30,4726]}],["里棺","lǐguān","古丧礼谓以缣帛缀着棺材里壁。",{"a":1,"w":[30,9589]}],["裒艺","póuyì","犹裒割。搜刮。艺，同“蓺”。",{"a":1,"w":[25717,7650]}],["补叙","bǔxù","对前面所漏叙的加以补充叙述。",{"a":1,"w":[1363,8462]}],["补缉","bǔjī","I\n修补。\nII\n整理编辑。",{"a":1,"w":[1363,9251]}],["褞褐","yǔnhè","破旧的以乱麻旧絮充内的袍子。",{"a":1,"w":[8166]}],["褭袅","niǎoniǎo","亦作“袅嫋”。\n纤长柔美貌。",{"a":1,"w":[82220,13134]}],["褭窕","niǎotiǎo","亦作“袅窕”。\n动摇不停貌。",{"a":1,"w":[82220,15230]}],["褭篆","niǎozhuàn","亦作“袅篆”。\n指香的烟缕。",{"a":1,"w":[82220,9979]}],["褭丝","niǎosī","亦作“袅丝”。\n香灰的别称。",{"a":1,"w":[82220,7515]}],["襚礼","suìlǐ","指吊丧者赠送死者的衣衾等物。",{"a":1,"w":[75622,3342]}],["袭替","xítì","袭职与替职。亦专指袭荫官职。",{"a":1,"w":[7990,2368]}],["西零","xīlíng","汉代羌族的一支。亦泛称羌人。",{"a":1,"w":[51,181]}],["覃转","tánzhuǎn","古代官吏因遇国家庆典而升调。",{"a":1,"w":[14222,1293]}],["覆伞","fùsǎn","覆盖的伞。比喻覆盖万物的天。",{"a":1,"w":[7864,1432]}],["见告","jiàngào","1) 告知。\n2) 告诉我。",{"a":1,"w":[76,7591]}],["规彩","guīcǎi","佛教称佛像顶上圆轮状的光彩。",{"a":1,"w":[7549,7795]}],["角奔","jiǎobēn","竞相奔走。多指为名利而争竞。",{"a":1,"w":[533,8195]}],["觙","jí","jí\n同“汲”。\n人名用字。",{"a":1}],["觚椠","gūqiàn","古代用木削成以备书写的简牍。",{"a":1,"w":[13403,19419]}],["解星","jiěxīng","旧时术数家指能化凶为吉的星。",{"a":1,"w":[4620,7443]}],["解束","jiěshù","脱落，散开。喻纲纪废弛解体。",{"a":1,"w":[4620,1407]}],["解由","jiěyóu","宋元时官吏调任时的证明文书。",{"a":1,"w":[4620,1342]}],["解贡","jiěgòng","古代地方向朝廷选拔荐送人才。",{"a":1,"w":[4620,8007]}],["解遣","jiěqiǎn","1) 犹押送。\n2) 遣散。",{"a":1,"w":[4620,8864]}],["解鞅","jiěyāng","1) 驻马。\n2) 指放马。",{"a":1,"w":[4620,14511]}],["解骑","jiěqí","1) 下马。\n2) 会骑马。",{"a":1,"w":[4620,674]}],["觥酌","gōngzhuó","1) 饮酒。\n2) 指酒杯。",{"a":1,"w":[14627,9372]}],["觞弊","shāngbì","谓觞饮舞弊。饮酒时以为笑乐。",{"a":1,"w":[10771,8552]}],["触氏","chùshì","《庄子》寓言中的蜗角小国名。",{"a":1,"w":[7734,7429]}],["计幕","jìmù","指起草文书，参与谋议的幕府。",{"a":1,"w":[7428,7877]}],["计辟","jìpì","计司辟差。谓由三司直接任命。",{"a":1,"w":[7428,8072]}],["讧讧","hònghòng","1) 哄闹声。\n2) 乱貌。",{"a":1,"w":[24319]}],["讦难","jiénán","诘难，论辩。讦，用同“诘”。",{"a":1,"w":[21911,117]}],["记曹","jìcáo","掌表章文檄书记的官署或官员。",{"a":1,"w":[110,8358]}],["讹倪","éní","I\n乖邪貌。\nII\n乖邪貌。",{"a":1,"w":[9405,12757]}],["讹落","éluò","I\n犹讹脱。\nII\n犹讹脱。",{"a":1,"w":[9405,2275]}],["讼见","sòngjiàn","谓为众人所见。讼，通“公”。",{"a":1,"w":[8092,76]}],["诀箓","juélù","指道教的修炼秘诀和符箓之书。",{"a":1,"w":[10509,15097]}],["设悬","shèxuán","设置悬挂钟、磬等乐器的架子。",{"a":1,"w":[7479,4694]}],["设班","shèbān","古代官员上朝时，依等第排班。",{"a":1,"w":[7479,135]}],["设移","shèyí","附设在楼阁或正堂旁边的小屋。",{"a":1,"w":[7479,2306]}],["设笄","shèjī","谓用簪子束发。古代成年之礼。",{"a":1,"w":[7479,13748]}],["许郑","xǔzhèng","东