[["肾脏癌","shènzàng ái","病名。 发生于肾脏的恶性肿瘤。 可分为成人肾实质癌、 肾盂癌、 小孩肾原细胞癌。 成人肾实质癌最常见， 大都到晚期才有血尿、 腹痛、 腰痛、 肿块、 恶心、 呕吐、 贫血、 体重减轻等症状的发生。 小孩肾原细胞癌或称为“韦恩氏瘤”， 是小孩子生殖泌尿系统最常见的瘤。",{"a":1,"w":[43030,9185]}],["赵元昊","zhàoyuánhào","人名。 （西元1103～1148） 西夏开国君主。 李继迁孙， 又名曩霄， 因先世宋赐赵姓， 故称为“赵元昊”。 雄毅大略， 不甘臣服于宋， 遂称帝， 建国号夏。 宋伐之不能克， 乃封为夏国主。 曾订定官制、 军制、 法律及创制西夏文字。 卒谥武烈皇帝， 庙号景宗。",{"a":1,"w":[8536,104,13001]}],["闸道器","zhádàoqì","zhá dào qì\n一种特定目的的电脑，目的在连接两个或更多的网路，完成讯息分封从一个网路到另一个网路的通道绕路。为英语Gateway 的义译。如IP闸道器在它所连的网路中为IP资料通报选择路径。从一个闸道器到另一个闸道器，直到分封可以透过实体网路直接到达目的地。",{"a":1,"w":[8461,192400]}],["倍赏","bèishǎng","[doubly award sth. to sb.] 加倍赏赐",{"a":1,"w":[2381,2415]}],["火犁","huǒlí","[ploughing tractor][方]: 农用犁田拖拉机",{"a":1,"w":[1284,8411]}],["狉獉","pīzhēn","[natural wildenness] 草木丛杂, 野兽出没",{"a":1,"w":[37632,78105]}],["痼病","gùbìng","[chronic diseae] 指病邪顽固难以治愈的慢性疾病",{"a":1,"w":[16723,67]}],["遛马","liúmǎ","[walk a horse] 引马缓行、 溜达, 以解乏或消病",{"a":1,"w":[11685,1273]}],["上站","shàngzhàn","mountain station, upper station",{"a":1,"w":[9,114]}],["叶葱","yècōng","shallot",{"a":1,"w":[7426,8364]}],["定边","dìngbiān","sensing",{"a":1,"w":[2259,553]}],["廓线","kuòxiàn","profile",{"a":1,"w":[9651,1282]}],["支索","zhīsuǒ","reeving",{"a":1,"w":[1328,7470]}],["次型","cìxíng","subtype",{"a":1,"w":[102,2315]}],["砖格","zhuāngé","checker",{"a":1,"w":[4857,7422]}],["器套","qìtào","housing",{"a":1,"w":[7410,584]}],["壶菌","hújūn","chytrid",{"a":1,"w":[3500,7623]}],["复征","fùzhēng","complex",{"a":1,"w":[7461,7581]}],["干眼","gànyǎn","dry eye",{"a":1,"w":[46,551]}],["激元","jīyuán","excimer",{"a":1,"w":[7541,104]}],["筋弛","jīnchí","flaccidity of tendon and muscle",{"a":1,"w":[8060,8456]}],["转筛","zhuǎnshāi","scalper",{"a":1,"w":[1293,8556]}],["脂体","zhītǐ","adipoid",{"a":1,"w":[7903,7417]}],["红胶","hóngjiāo","red gum",{"a":1,"w":[534,7702]}],["假蹄","jiǎtí","dewclaw",{"a":1,"w":[562,8653]}],["复诉","fùsù","revivor",{"a":1,"w":[7461,7817]}],["店务","diànwù","matters connected with the shop",{"a":1,"w":[675,7448]}],["顶线","dǐngxiàn","ceiling",{"a":1,"w":[2298,1282]}],["淀素","d