[["阳州","yángzhōu","1) 古九州之一。\n2) 古地名。",{"a":1,"w":[7484,4663]}],["隆曦","lóngxī","谓阴晴。隆，丰隆，云师。曦，日光。",{"a":1,"w":[7876,12196]}],["隆亲","lóngqīn","所尊崇的和所亲爱的。指君王与父母。",{"a":1,"w":[7876,1338]}],["队率","duìlǜ","古代军中小官名。为一队兵卒的首领。",{"a":1,"w":[570,7458]}],["随仇","suíchóu","跟着朋友一起将朋友的仇敌视为仇敌。",{"a":1,"w":[1375,8387]}],["随龙","suílóng","谓东宫僚佐官吏随太子即位而得重用。",{"a":1,"w":[1375,1308]}],["险奥","xiǎn'ào","1) 深险之区。\n2) 奇特深奥。",{"a":1,"w":[4634,7481]}],["险曲","xiǎnqū","1) 崎岖曲折。\n2) 邪恶不正。",{"a":1,"w":[4634,7517]}],["隐幽","yǐnyōu","1) 幽静偏僻。\n2) 深奥隐晦。",{"a":1,"w":[7652,8098]}],["隐业","yǐnyè","供隐退安居之用的产业。如田亩之类。",{"a":1,"w":[7652,7418]}],["隳堕","huīduò","1) 失败，不成功。\n2) 败落。",{"a":1,"w":[14103,8768]}],["雄侈","xióngchǐ","1) 谓好大喜功。\n2) 犹宏丽。",{"a":1,"w":[7818,9324]}],["雄势","xióngshì","1) 犹雄壮。\n2) 勇猛的气势。",{"a":1,"w":[7818,7642]}],["雄方","xióngfāng","题诗的大木版。方，古代书写用的版。",{"a":1,"w":[7818,2257]}],["雄郁","xióngyù","1) 雄健沉郁。\n2) 壮丽郁勃。",{"a":1,"w":[7818,8084]}],["雅令","yǎlìng","1) 高雅酒令。\n2) 典雅美善。",{"a":1,"w":[7788,3329]}],["雅器","yǎqì","1) 指乐器。\n2) 大才，高才。",{"a":1,"w":[7788,7410]}],["雅裁","yǎcái","1) 雅正的风度。\n2) 犹佳作。",{"a":1,"w":[7788,7851]}],["雅诂","yǎgǔ","1) 犹训诂。\n2) 指训诂著作。",{"a":1,"w":[7788,26409]}],["隽伟","juànwěi","I\n优美而宏伟。\nII\n卓异非凡。",{"a":1,"w":[15963,9196]}],["隽快","juànkuài","1) 健壮敏捷。\n2) 优美畅达。",{"a":1,"w":[15963,155]}],["隽李","juànlǐ","地名。在今浙江省嘉兴市西南七十里。",{"a":1,"w":[15963,7880]}],["隽雅","juànyǎ","I\n优美典雅。\nII\n谓高雅脱俗。",{"a":1,"w":[15963,7788]}],["雌弦","cíxián","弦乐器上较细的弦，音阶属高音部位。",{"a":1,"w":[10657,4726]}],["雍雅","yōngyǎ","1) 雍容闲雅。\n2) 古乐章名。",{"a":1,"w":[9147,7788]}],["雍食","yōngshí","犹饔飧。早餐和晚餐。雍，通“饔”。",{"a":1,"w":[9147,7466]}],["雕扞","diāogǎn","亦作“雕悍”。\n像雕一样迅猛强悍。",{"a":1,"w":[8192,10482]}],["雕车","diāochē","饰有雕花、彩绘的车；装饰华丽的车。",{"a":1,"w":[8192,32]}],["双龟","shuāngguī","古代印章镌有龟钮。双龟谓兼掌二印。",{"a":1,"w":[1309,7684]}],["杂俗","zású","1) 各种习俗。\n2) 粗俗不纯。",{"a":1,"w":[4680,7904]}],["杂引","záyǐn","1) 各种琴曲。\n2) 多方引用。",{"a":1,"w":[4680,2281]}],["鸡台","jītái","台名。在扬州。相传隋炀帝常游于此。",{"a":1,"w":[578,1306]}],["离志","lízhì","1) 异心。\n2) 离别时的心情。",{"a":1,"w":[543,7626]}],["离房","lífáng","1) 犹别室。\n2) 指众多人家。",{"a":1,"w":[543,7555]}],["离书","líshū","古代脱离夫妇关系的文书。也称休书。",{"a":1,"w":[543,81]}],["难素","nánsù","中医医书《难经》和《素问》的并称。",{"a":1,"w":[117,7468]}],["雨潦","yǔlǎo","I\n大雨积水。\nII\n见“雨涝”。",{"a":1,"w":[159,10083]}],["雩敛","yúliǎn","为祈雨行祭而向百姓收取的所需财用。",{"a":1,"w":[16328,8878]}],["雪筱","xuěxiǎo","即新竹。因竹上有浓厚的白粉，故称。",{"a":1,"w":[616,17731]}],["雪丝","xuěsī","1) 白色丝头。\n2) 比喻白发。",{"a":1,"w":[616,7515]}],["雪翎","xuělíng","1) 白色羽毛。\n2) 用来指鹤。",{"a":1,"w":[616,11307]}],["云舄","yúnxì","1) 绣鞋。\n2) 仙道着的鞋子。",{"a":1,"w":[554,17774]}],["云辂","yúnlù","有云状纹饰的车子。多指天子的车乘。",{"a":1,"w":[554,14323]}],["需头","xūtóu","指章奏空出首幅，以供诏旨批答之用。",{"a":1,"w":[7998,509]}],["霓骑","níqí","传说中仙人以云霓为坐骑。借指仙人。",{"a":1,"w":[10817,674]}],["霜实","shuāngshí","经霜的果实。亦指霜后才甘美的果实。",{"a":1,"w":[8258,7457]}],["霜朱","shuāngzhū","指橘红色。因橘经霜后才变红，故称。",{"a":1,"w":[8258,7906]}],["霜溪","shuāngxī","亦作“霜谿”。\n寒溪，清冷的溪流。",{"a":1,"w":[8258,4874]}],["霜蓄","shuāngxù","即今之蔓菁菜。霜后味尤甘美，故称。",{"a":1,"w":[8258,8173]}],["霞表","xiábiǎo","云霞之外，高空。亦喻远离尘俗之处。",{"a":1,"w":[4805,536]}],["雾滃","wùwēng","1) 云雾四起。\n2) 比喻盛多。",{"a":1,"w":[3421,24606]}],["露颗","lùkē","1) 水灵灵的果子。\n2) 露珠。",{"a":1,"w":[4674,3582]}],["霸池","bàchí","池名。在汉文帝陵墓灞陵之上，故称。",{"a":1,"w":[8096,7815]}],["灵俗","língsú","仙人和凡人。借指各种不同身份的人。",{"a":1,"w":[7588,7904]}],["灵味","língwèi","1) 美味。\n2) 有奇效的药材。",{"a":1,"w":[7588,7712]}],["灵封","língfēng","1) 神仙境界。\n2) 冥中辖境。",{"a":1,"w":[7588,600]}],["灵庙","língmiào","庙宇寺观。因其供奉神灵仙佛，故称。",{"a":1,"w":[7588,8514]}],["灵润","língrùn","1) 雨露的美称。\n2) 喻恩德。",{"a":1,"w":[7588,7847]}],["灵盘","língpán","指汉武帝时设置的铜仙人所捧承露盘。",{"a":1,"w":[7588,2285]}],["灵蠯","língpí","一种狭长的蚌。古时用以祭祀，故称。",{"a":1,"w":[7588,207274]}],["灵警","língjǐng","1) 空灵精妙。\n2) 灵敏机警。",{"a":1,"w":[7588,7594]}],["青晕","qīngyūn","中心较浓周围渐淡的青黑色圆形斑痕。",{"a":1,"w":[3320,3516]}],["青李","qīnglǐ","1) 李子的一种。\n2) 法帖名。",{"a":1,"w":[3320,7880]}],["青环","qīnghuán","青色玉环。常用以喻环绕四周的碧水。",{"a":1,"w":[3320,1320]}],["青盘","qīngpán","1) 青瓷盘盎。\n2) 喻指荷叶。",{"a":1,"w":[3320,2285]}],["青筠","qīngyún","1) 青竹。\n2) 喻坚贞的志节。",{"a":1,"w":[3320,16293]}],["青蔓","qīngmàn","即芜菁。俗称大头菜，根块可供蔬食。",{"a":1,"w":[3320,8562]}],["靓闲","jìngxián","1) 幽静安闲。\n2) 俊美闲雅。",{"a":1,"w":[14018,3381]}],["静外","jìngwài","淡漠世事，自外于尘俗。谓隐遁避世。",{"a":1,"w":[1386,36]}],["静狱","jìngyù","犹虑囚。详细地审理狱囚而为之平反。",{"a":1,"w":[1386,8200]}],["静简","jìngjiǎn","1) 娴静平易。\n2) 清静简约。",{"a":1,"w":[1386,7804]}],["静虚","jìngxū","1) 清净无欲。\n2) 恬淡平和。",{"a":1,"w":[1386,7779]}],["非辜","fēigū","1) 犹非罪。\n2) 指无罪之人。",{"a":1,"w":[2265,9843]}],["靡滥","mílàn","1) 流动泛滥。\n2) 浮靡失实。",{"a":1,"w":[8373,8319]}],["靡饰","míshì","过分的文饰。亦指烦琐的礼仪或规定。",{"a":1,"w":[8373,7951]}],["面奉","miànfèng","1) 当面受命。\n2) 当面呈献。",{"a":1,"w":[523,7971]}],["面讦","miànjié","1) 当面攻讦。\n2) 亲自审讯。",{"a":1,"w":[523,21911]}],["鞋扇","xiéshàn","没有缝的鞋帮。鞋帮一双四扇，故称。",{"a":1,"w":[685,3380]}],["韦裳","wéishang","皮制的下裙。旧时牧人或卑贱者之服。",{"a":1,"w":[7839,9272]}],["韬尘","tāochén","埋藏于尘土之中。谓埋伏而不为人知。",{"a":1,"w":[11243,7843]}],["韬碧","tāobì","失去青碧之色。谓(大雪)覆盖青山。",{"a":1,"w":[11243,8659]}],["韬精","tāojīng","1) 掩藏才华。\n2) 隐藏光芒。",{"a":1,"w":[11243,4629]}],["响字","xiǎngzì","指诗词中读音响亮、形象鲜明的字眼。",{"a":1,"w":[639,84]}],["响犀","xiǎngxī","犀牛角所制的棒槌，击物能应声回响。",{"a":1,"w":[639,8848]}],["顺令","shùnlìng","1) 遵循教令。\n2) 顺从节令。",{"a":1,"w":[4660,3329]}],["顺笔","shùnbǐ","在写某一事物时，顺便写到另一事物。",{"a":1,"w":[4660,619]}],["顺举","shùnjǔ","1) 顺势起飞。\n2) 趁势举事。",{"a":1,"w":[4660,606]}],["预事","yùshì","1) 参与其事。\n2) 干预其事。",{"a":1,"w":[7614,33]}],["预奉","yùfèng","1) 预先奉承。\n2) 预先接受。",{"a":1,"w":[7614,7971]}],["预虑","yùlǜ","1) 预先谋划。\n2) 预先考虑。",{"a":1,"w":[7614,8360]}],["顽顿","wándùn","犹顽钝。圆滑无骨气。顿，通“钝”。",{"a":1,"w":[8595,1370]}],["顿剉","dùncuò","犹顿挫。指诗意跌宕转折，回旋起伏。",{"a":1,"w":[1370,16166]}],["顿官","dùnguān","古代为安置冗员而设的无实职的官位。",{"a":1,"w":[1370,2293]}],["顿摔","dùnshuāi","1) 犹顶撞。\n2) 折挫；折磨。",{"a":1,"w":[1370,3543]}],["顿整","dùnzhěng","1) 安置；安排。\n2) 犹整顿。",{"a":1,"w":[1370,1355]}],["颇我","pǒwǒ","犹彼我。谓我是彼非。颇，通“彼”。",{"a":1,"w":[4897,139]}],["颇极","pǒjí","1) 犹竭尽。\n2) 极为，非常。",{"a":1,"w":[4897,1303]}],["领南","lǐngnán","指五岭以南的地区。领，古“岭”字。",{"a":1,"w":[1361,90]}],["领览","lǐnglǎn","1) 领会，明白。\n2) 犹拜读。",{"a":1,"w":[1361,8265]}],["颐气","yíqì","谓下巴的动向和面部的表情。犹意旨。",{"a":1,"w":[9868,510]}],["颓倚","tuíyǐ","1) 垂头倚靠。\n2) 坍塌倾侧。",{"a":1,"w":[8639,8677]}],["颜杨","yányáng","书法家唐颜真卿和五代杨凝式的并称。",{"a":1,"w":[8117,8318]}],["颛阃","zhuānkǔn","专主京城以外的权事。颛，通“专”。",{"a":1,"w":[11459,13395]}],["颠翻","diānfān","1) 使沦陷。\n2) 跌倒；倒翻。",{"a":1,"w":[8660,2337]}],["颠跌","diāndiē","1) 困顿挫折。\n2) 瘸着走路。",{"a":1,"w":[8660,4818]}],["类出","lèichū","1) 分别列出。\n2) 大多出自。",{"a":1,"w":[1323,22]}],["风宣","fēngxuān","1) 广泛传播。\n2) 风教广布。",{"a":1,"w":[44,7827]}],["风艳","fēngyàn","1) 风姿艳丽。\n2) 风雅艳丽。",{"a":1,"w":[44,8710]}],["飘沦","piāolún","1) 飘泊沦落。\n2) 颓丧消沉。",{"a":1,"w":[3467,9545]}],["飘转","piāozhuǎn","1) 回旋飘飞。\n2) 飘泊转徙。",{"a":1,"w":[3467,1293]}],["飞光","fēiguāng","1) 飞逝的光阴。\n2) 犹耀光。",{"a":1,"w":[56,1271]}],["食陈","shíchén","1) 吃陈粮。\n2) 饮用陈茶叶。",{"a":1,"w":[7466,7893]}],["饥凶","jīxiōng","五谷不熟，年成很坏。饥，通“饥”。",{"a":1,"w":[8569,4750]}],["饰棺","shìguān","古人按等级以不同织物装饰覆盖棺柩。",{"a":1,"w":[7951,9589]}],["饷边","xiǎngbiān","亦作“饟边”。\n以钱粮供给边防军。",{"a":1,"w":[9898,553]}],["饷饭","xiǎngfàn","1) 给饭。\n2) 往田地里送饭。",{"a":1,"w":[9898,169]}],["养徒","yǎngtú","1) 教养弟子。\n2) 聚养徒众。",{"a":1,"w":[582,7813]}],["养恬","yǎngtián","培养恬静寡欲的思想；过恬静的生活。",{"a":1,"w":[582,11930]}],["馁败","něibài","1) 腐烂变质。\n2) 气馁心灰。",{"a":1,"w":[11425,2345]}],["余兵","yúbīng","1) 收藏的兵器。\n2) 犹残兵。",{"a":1,"w":[7597,2282]}],["余步","yúbù","1) 犹信步。\n2) 余裕的地步。",{"a":1,"w":[7597,1337]}],["余闰","yúrùn","1) 指闰月。\n2) 谓额外施恩。",{"a":1,"w":[7597,11427]}],["余馥","yúfù","1) 指残花。\n2) 不尽的芳香。",{"a":1,"w":[7597,11491]}],["饶远","ráoyuǎn","谓国都近郊之民受地比远地之民优厚。",{"a":1,"w":[8550,103]}],["首坐","shǒuzuò","1) 犹首犯。\n2) 首席；首领。",{"a":1,"w":[2310,128]}],["香焰","xiāngyàn","亦作“香焰”。\n焚香时出现的烟火。",{"a":1,"w":[1311,8874]}],["驰仰","chíyǎng","书信表敬语。表示对对方的向往仰慕。",{"a":1,"w":[8375,4742]}],["驰使","chíshǐ","1) 急驰出使。\n2) 速派使者。",{"a":1,"w":[8375,1332]}],["驰射","chíshè","1) 骑马射箭。\n2) 追逐射猎。",{"a":1,"w":[8375,3312]}],["驰景","chíjǐng","1) 谓日光飞驰。\n2) 指日光。",{"a":1,"w":[8375,4676]}],["驳尧","bóyáo","指汉光武帝议郊祀，杜林力驳祀尧事。",{"a":1,"w":[8526,9836]}],["驳审","bóshěn","1