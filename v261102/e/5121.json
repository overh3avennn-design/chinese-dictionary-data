":1,"w":[7631,11234]}],["寓彩","yùcǎi","丧葬用品。纸制的彩绸。",{"a":1,"w":[9167,7795]}],["寓镪","yùqiāng","用白金水涂过的纸冥钱。",{"a":1,"w":[9167,22239]}],["寖染","jìnrǎn","相互影响；熏染，熏陶。",{"a":1,"w":[126023,3355]}],["察推","chátuī","官名。观察推官的省称。",{"a":1,"w":[7567,586]}],["察辞","chácí","谓审察言辞的真伪虚实。",{"a":1,"w":[7567,7757]}],["寡为","guǎwèi","谓听任自然，少事施为。",{"a":1,"w":[8272,550]}],["寡能","guǎnéng","谓缺少从事末业的技能。",{"a":1,"w":[8272,41]}],["寡貌","guǎmào","谓朴质自然，不加矫饰。",{"a":1,"w":[8272,8217]}],["寥索","liáosuǒ","犹萧索。不热闹；冷落。",{"a":1,"w":[11552,7470]}],["实租","shízū","实际地租。对虚租而言。",{"a":1,"w":[7457,665]}],["写鞚","xiěkòng","放松辔头。谓纵马奔驰。",{"a":1,"w":[172,86649]}],["宽息","kuānxī","谓宽松而得到休养生息。",{"a":1,"w":[2323,7510]}],["寰法","huánfǎ","战国时环形的秦式货币。",{"a":1,"w":[12225,2258]}],["宠契","chǒngqì","谓趣味投合而受到尊崇。",{"a":1,"w":[8782,8094]}],["宝姥","bǎolǎo","称女仙中年貌不年轻者。",{"a":1,"w":[2313,11209]}],["宝祠","bǎocí","谓视为珍宝，虔敬奉祀。",{"a":1,"w":[2313,10439]}],["宝铉","bǎoxuàn","晋干宝和宋徐铉的并称。",{"a":1,"w":[2313,27742]}],["寸名","cùnmíng","卑微的姓名。自谦之词。",{"a":1,"w":[3402,560]}],["封叙","fēngxù","按等级次第晋爵或奖功。",{"a":1,"w":[600,8462]}],["封角","fēngjiǎo","封缄；封束。角，缄束。",{"a":1,"w":[600,533]}],["封隧","fēngsuì","坟墓的别称。隧，墓道。",{"a":1,"w":[600,8814]}],["专静","zhuānjìng","纯朴敦厚，沉静不浮躁。",{"a":1,"w":[7548,1386]}],["小佞","xiǎonìng","才智低下而卑谄善辩者。",{"a":1,"w":[16,10272]}],["小岘","xiǎoxiàn","山名。在安徽省含山县。",{"a":1,"w":[16,27285]}],["小桡","xiǎoráo","短桨。常用以代称小船。",{"a":1,"w":[16,10333]}],["小真","xiǎozhēn","小像。小幅真容的简称。",{"a":1,"w":[16,85]}],["小诵","xiǎosòng","指年小时所诵习的典传。",{"a":1,"w":[16,9112]}],["小讳","xiǎohuì","幼时小名，多指帝王言。",{"a":1,"w":[16,9336]}],["尚右","shàngyòu","以右为尊。详“尚左”。",{"a":1,"w":[7776,178]}],["尤讳","yóuhuì","犹大讳。指帝王等死亡。",{"a":1,"w":[7739,9336]}],["尨然","mángrán","高大貌。尨，通“庞”。",{"a":1,"w":[16407,7451]}],["就禄","jiùlù","领受俸禄。指出仕任职。",{"a":1,"w":[95,8602]}],["尹班","yǐnbān","汉代尹敏与班彪的并称。",{"a":1,"w":[10344,135]}],["尺缣","chǐjiān","长一尺的绢。极言其少。",{"a":1,"w":[2347,25036]}],["屈声","qūshēng","指因受屈而形成的声誉。",{"a":1,"w":[7898,3317]}],["屈色","qūsè","谓屈意表示赞同或欣悦。",{"a":1,"w":[7898,2266]}],["屏篷","píngpéng","古代传说中的一种野兽。",{"a":1,"w":[7852,9193]}],["屏阈","píngyù","犹门户。比喻奥秘之处。",{"a":1,"w":[7852,10455]}],["屐履","jīlǚ","谓着履作游屐(登临)。",{"a":1,"w":[17317,7942]}],["扉屦","fēijù","草鞋。常泛指行旅用品。",{"a":1,"w":[12873,10982]}],["屠工","túgōng","以宰杀牲畜为职业的人。",{"a":1,"w":[9023,7411]}],["屯住","túnzhù","亦作“屯驻”。\n驻守。",{"a":1,"w":[8563,144]}],["屯慝","túntè","指阴惨之气。慝，阴气。",{"a":1,"w":[8563,11677]}],["山侣","shānlǚ","山中知交。指隐逸之士。",{"a":1,"w":[45,10478]}],["山夔","shānkuí","传说中的山中独脚怪兽。",{"a":1,"w":[45,25779]}],["山寇","shānkòu","旧时称占山为王的强人。",{"a":1,"w":[45,9047]}],["山步","shānbù","山脚水旁人家聚居之处。",{"a":1,"w":[45,1337]}],["山猺","shānyáo","旧时对山区瑶族的蔑称。",{"a":1,"w":[45,38487]}],["山臣","shānchén","隐逸之士对君王的自称。",{"a":1,"w":[45,8045]}],["山舍","shānshě","山中住宅；山中的房舍。",{"a":1,"w":[45,7531]}],["岐社","qíshè","周文王所立的周室神社。",{"a":1,"w":[11416,3327]}],["岳婿","yuèxù","亦作“岳婿”。\n山名。",{"a":1,"w":[8765,12002]}],["岳只","yuèzhǐ","亦作“岳只”。\n山神。",{"a":1,"w":[8765,612]}],["岷益","mínyì","古代泛指四川北部地区。",{"a":1,"w":[15066,7724]}],["峚山","mìshān","山名。在陕西省商县境。",{"a":1,"w":[45]}],["崖砦","yázhài","依山崖构筑的防守工事。",{"a":1,"w":[8942,20835]}],["岭雁","lǐngyàn","岭南来的雁。借喻书信。",{"a":1,"w":[8515,9300]}],["巉岨","chánqū","险峻。亦指险峻的山岩。",{"a":1,"w":[21337,116107]}],["巉巀","chánjié","险峻貌。亦指险峻的山。",{"a":1,"w":[21337]}],["岩庙","yánmiào","高大的宗庙。借指朝廷。",{"a":1,"w":[7558,8514]}],["巡司","xúnsī","巡检司。职掌地方治安。",{"a":1,"w":[7981,7476]}],["巢繇","cháoyáo","即巢由。繇，通“由”。",{"a":1,"w":[8435,11625]}],["巢薮","cháosǒu","指盗匪或敌人盘踞之地。",{"a":1,"w":[8435,10471]}],["左螭","zuǒchī","唐门下省起居郎的别称。",{"a":1,"w":[154,14698]}],["左谏","zuǒjiàn","唐代左谏议大夫的简称。",{"a":1,"w":[154,9148]}],["巨巾","jùjīn","大巾。用以蔽膝或盖头。",{"a":1,"w":[7862,8285]}],["巨德","jùdé","大德，谓品德高洁出众。",{"a":1,"w":[7862,7416]}],["巨枣","jùzǎo","传说中仙人所食之大枣。",{"a":1,"w":[7862,8507]}],["巨雀","jùquè","亦作“巨爵”。\n大鸟。",{"a":1,"w":[7862,7583]}],["市宠","shìchǒng","博取别人的喜爱或恩宠。",{"a":1,"w":[555,8782]}],["市阓","shìhuì","市场的门。亦借指市场。",{"a":1,"w":[555,34962]}],["帆楫","fānjí","船帆和桨。多泛指船只。",{"a":1,"w":[8810,19523]}],["希年","xīnián","古稀之年，古指七十岁。",{"a":1,"w":[7538,92]}],["帝则","dìzé","天帝或天子所定的法则。",{"a":1,"w":[7840,3323]}],["帝晖","dìhuī","帝王的光辉。指代皇帝。",{"a":1,"w":[7840,11534]}],["帝纮","dìhóng","王道；帝王治国的纲纪。",{"a":1,"w":[7840,32032]}],["帝阁","dìgé","天帝或帝王所居的殿阁。",{"a":1,"w":[7840,8208]}],["帝党","dìdǎng","指支持皇帝的政治集团。",{"a":1,"w":[7840,4685]}],["师昭","shīzhāo","司马师、司马昭的并称。",{"a":1,"w":[7489,8522]}],["常随","chángsuí","长随。官吏的随从人员。",{"a":1,"w":[99,1375]}],["幔省","mànshěng","用帐幔张盖的临时官署。",{"a":1,"w":[10557,607]}],["幕屋","mùwū","用帷幕临时围成的房屋。",{"a":1,"w":[7877,3389]}],["幡竿","fāngān","系幡的杆。 悬旛的竿。",{"a":1,"w":[10797,9280]}],["幢戟","chuángjǐ","旌旗和戈戟。泛指仪卫。",{"a":1,"w":[5413,8766]}],["幢翳","chuángyì","古时用羽毛装饰的车盖。",{"a":1,"w":[5413,9715]}],["幰衣","xiǎnyī","御尘的布幔。又名遮尘。",{"a":1,"w":[55854,7536]}],["平刑","píngxíng","公平地处理案件；断案。",{"a":1,"w":[525,7716]}],["平晓","píngxiǎo","犹平明。天刚亮的时候。",{"a":1,"w":[525,8614]}],["平衢","píngqú","平坦的四通八达的大路。",{"a":1,"w":[525,12917]}],["年统","niántǒng","指《春秋》纪年的统系。",{"a":1,"w":[92,7442]}],["年翁","niánwēng","科举时代称同年的父亲。",{"a":1,"w":[92,8165]}],["年耆","niánqí","年老。古代年六十曰耆。",{"a":1,"w":[92,8495]}],["幸措","xìngcuò","谓将侥幸之人置于左右。",{"a":1,"w":[8065,7987]}],["幻翳","huànyì","佛教语。谓假象的障蔽。",{"a":1,"w":[8567,9715]}],["幻蕴","huànyùn","佛教语。谓空幻的身心。",{"a":1,"w":[8567,9347]}],["幽忆","yōuyì","指深藏心中的思想感情。",{"a":1,"w":[8098,8798]}],["幽朴","yōupǔ","谓地位低微，资质朴陋。",{"a":1,"w":[8098,9097]}],["幽馨","yōuxīn","犹幽香。喻清高的情操。",{"a":1,"w":[8098,9550]}],["几察","jǐchá","犹稽查。几，通“讥”。",{"a":1,"w":[136,7567]}],["庀工","pǐgōng","谓召集工匠，开始动工。",{"a":1,"w":[40330,7411]}],["底老","dǐlǎo","旧时市井隐语。指妻子。",{"a":1,"w":[2290,55]}],["府僚","fǔliáo","王府或府署辟置的僚属。",{"a":1,"w":[7706,9351]}],["府牌","fǔpái","府衙的差役。牌，牌军。",{"a":1,"w":[7706,2344]}],["府端","fǔduān","六朝称府署幕僚为府端。",{"a":1,"w":[7706,4659]}],["庠老","xiánglǎo","古代对地方学官的敬称。",{"a":1,"w":[23332,55]}],["度恕","dùshù","谓反省自身而宽厚待人。",{"a":1,"w":[513,10434]}],["庭阙","tíngquē","犹朝廷。庭，通“廷”。",{"a":1,"w":[7760,8773]}],["庰厕","bìngcè","隐蔽偏僻之地。指厕所。",{"a":1,"w":[8932]}],["厕填","cètián","谓诸物错杂，充填其中。",{"a":1,"w":[8932,2371]}],["厢子","xiāngzi","箱子。厢，用同“箱”。",{"a":1,"w":[9106,1]}],["厢嵌","xiāngqiàn","镶嵌。厢，用同“镶”。",{"a":1,"w":[9106,8979]}],["廉卓","liánzhuó","指为官清廉而政绩优异。",{"a":1,"w":[8138,8642]}],["廉部","liánbù","即廉镇。廉，通“覝”。",{"a":1,"w":[8138,1295]}],["廊牙","lángyá","廊檐下像牙齿般的装饰。",{"a":1,"w":[10038,2308]}],["荫授","yīnshòu","子弟承荫而被授以官职。",{"a":1,"w":[8853,8099]}],["厨船","chúchuán","操办、供应膳食的船只。",{"a":1,"w":[8889,621]}],["庙学","miàoxué","旧指设于孔庙内的学校。",{"a":1,"w":[8514,13]}],["庙濯","miàozhuó","即庙祧。濯，通“祧”。",{"a":1,"w":[8514,11458]}],["废市","fèishì","停止营业，停止做生意。",{"a":1,"w":[7711,555]}],["废身","fèishēn","犹舍身、弃身。谓出家。",{"a":1,"w":[7711,7456]}],["廪缣","lǐnjiān","粮食和布帛。泛指给养。",{"a":1,"w":[9825,25036]}],["庐九","lújiǔ","庐江、九江二郡的并称。",{"a":1,"w":[9988,143]}],["庐伍","lúwǔ","按军队建制编列的居民。",{"a":1,"w":[9988,8730]}],["弓兆","gōngzhào","《周礼》卜师四兆之一。",{"a":1,"w":[8097,8519]}],["吊问","diàowèn","吊祭死者，慰问其家属。",{"a":1,"w":[4693,113]}],["吊棒","diàobàng","亦作“吊棒”。\n调情。",{"a":1,"w":[4693,2361]}],["吊赙","diàofù","往丧家吊唁并送以财物。",{"a":1,"w":[4693,16557]}],["引袋","yǐndài","招文袋。犹今之公文袋。",{"a":1,"w":[2281,2395]}],["弛罟","chígǔ","谓网开三面。喻施恩德。",{"a":1,"w":[8456,18478]}],["弢光","tāoguāng","谓隐藏才华，不使外露。",{"a":1,"w":[49867,1271]}],["弢弓","tāogōng","藏弓入弢。谓平息兵事。",{"a":1,"w":[49867,8097]}],["弧剌","húlá","犹狐剌。形容歪斜不正。",{"a":1,"w":[8058,8630]}],["弩团","nǔtuán","古代军队中的弓箭部队。",{"a":1,"w":[9962,1336]}],["张具","zhāngjù","即帐具。张，通“帐”。",{"a":1,"w":[1333,7505]}],["张炽","zhāngchì","(张zhāng)炽盛。",{"a":1,"w":[1333,11111]}],["张独","zhāngdú","张家口、独石口的并称。",{"a":1,"w":[1333,7561]}],["张眉","zhāngméi","舒展眉毛。神情兴奋貌。",{"a":1,"w":[1333,7988]}],["张老","zhānglǎo","春秋晋大夫张孟之别称。",{"a":1,"w":[1333,55]}],["张蔡","zhāngcài","东汉张衡和蔡邕的并称。",{"a":1,"w":[1333,9087]}],["强僭","qiángjiàn","谓仗势做超越本分的事。",{"a":1,"w":[1314,11371]}],["彀当","gòudāng","勾当。事情。常指坏事。",{"a":1,"w":[15909,552]}],["弹枉","dànwǎng","弹劾枉法者，纠正偏颇。",{"a":1,"w":[3318,9134]}],["弹激","dànjī","谓激烈率直地予以抨击。",{"a":1,"w":[3318,7541]}],["弹爵","dànjué","犹弹雀。爵，通“雀”。",{"a":1,"w":[3318,8494]}],["彝教","yíjiào","常教，永久不变的教化。",{"a":1,"w":[9828,77]}],["彝斝","yíjiǎ","泛指古代祭祀用的酒器。",{"a":1,"w":[9828,50889]}],["彝乐","yílè","指宗庙祭享常用的乐章。",{"a":1,"w":[9828,1340]}],["形虚","xíngxū","谓使一切形器归于虚无。",{"a":1,"w":[4612,7779]}],["雕甿","diāoméng","谓受摧折而残存的农夫。",{"a":1,"w":[8192,100112]}],["雕癠","diāojì","谓人口减少，民生困苦。",{"a":1,"w":[8192,115603]}],["雕虚","diāoxū","谓地方残破、户口空虚。",{"a":1,"w":[8192,7779]}],["彰赫","zhānghè","谓真相毕露，十分明显。",{"a":1,"w":[10342,7566]}],["役召","yìzhào","谓召令服役；召唤役使。",{"a":1,"w":[7861,8854]}],["役费","yìfèi","劳役和战费。亦指战费。",{"a":1,"w":[7861,1316]}],["役门","yìmén","犹役户。指寻常百姓家。",{"a":1,"w":[7861,53]}],["征布","zhēngbù","征收的税款。布，货币。",{"a":1,"w":[7581,1283]}],["后蹑","hòuniè","追踪于后。喻步其后尘。",{"a":1,"w":[43,11010]}],["徙系","xǐxì","谓将人转移到某地拘禁。",{"a":1,"w":[10225,1277]}],["从然","cóngrán","自由自在，放纵无拘束。",{"a":1,"w":[124,7451]}],["从臣","cóngchén","随从之臣下；侍从之臣。",{"a":1,"w":[124,8045]}],["御穷","yùqióng","对付困窘; 对付贫穷。",{"a":1,"w":[7809,2372]}],["御衮","yùgǔn","穿上衮服。谓帝王听政。",{"a":1,"w":[7809,12193]}],["复胙","fùzuò","谓正祭后的第二天再祭。",{"a":1,"w":[7461,23284]}],["循卓","xúnzhuó","谓吏治清明，政绩卓着。",{"a":1,"w":[7778,8642]}],["循走","xúnzǒu","谓循墙而走。表示恭谨。",{"a":1,"w":[7778,107]}],["微昧","wēimèi","幽隐；不明；模糊不清。",{"a":1,"w":[7512,9075]}],["微赜","wēizé","指事理的微妙幽深之处。",{"a":1,"w":[7512,16600]}],["征取","zhēngqǔ","征收索取; 征求取得。",{"a":1,"w":[7581,580]}],["征守","zhēngshǒu","谓天子征召守国的诸侯。",{"a":1,"w":[7581,2338]}],["征要","zhēngyào","犹证据。要，核实之辞。",{"a":1,"w":[7581,72]}],["彻行","chèxíng","指以百人为一行的队列。",{"a":1,"w":[8591,8]}],["徼谻","jiǎojí","伺对方疲顿而加以拦截。",{"a":1,"w":[10328,123569]}],["忍爱","rěn'ài","隐忍住情爱，不使外露。",{"a":1,"w":[3408,131]}],["忘劳","wàngláo","不感觉劳苦；不知疲倦。",{"a":1,"w":[206,7526]}],["忠圣","zhōngshèng","指忠臣中品德最高的人。",{"a":1,"w":[8280,7587]}],["忿兵","fènbīng","谓不忍小故而愤怒用兵。",{"a":1,"w":[10017,2282]}],["急桨","jíjiǎng","疾速划桨。亦指快行舟。",{"a":1,"w":[569,4827]}],["恛惶","huíhuáng","惶恐不安，心神不定貌。",{"a":1,"w":[10727]}],["恩数","ēnshù","指朝廷赐予的封号等级。",{"a":1,"w":[7704,527]}],["恩军","ēnjūn","明代称充军戍边的罪人。",{"a":1,"w":[7704,7467]}],["息燧","xīsuì","熄灭烽火。指停止战事。",{"a":1,"w":[7510,10061]}],["悌友","tìyǒu","谓兄弟姊妹间亲密和睦。",{"a":1,"w":[17076,7735]}],["悖叛","bèipàn","亦作“悖畔”。\n背叛。",{"a":1,"w":[9088,8958]}],["悗夺","mánduó","谓设法使之放弃其主张。",{"a":1,"w":[64849,4759]}],["悲悸","bēijì","谓声音悲伤得令人惊恐。",{"a":1,"w":[8341,12746]}],["情火","qínghuǒ","谓如火一般热烈的爱情。",{"a":1,"w":[7490,1284]}],["惉懘","zhānchì","声音不和谐；烦乱不安。",{"a":1,"w":[442275,141619]}],["恶觉","èjué","佛教语。谓不好的思想。",{"a":1,"w":[7620,4665]}],["惶栗","huánglì","亦作“惶栗”。\n恐惧。",{"a":1,"w":[10727,8177]}],["愍隶","mǐnlì","犹氓隶。服苦役的奴隶。",{"a":1,"w":[13317,8847]}],["意巧","yìqiǎo","谓运用心意所得的善巧。",{"a":1,"w":[7482,1421]}],["愚臣","yúchén","大臣对君主自称的谦词。",{"a":1,"w":[8545,8045]}],["愚衷","yúzhōng","谦称自己的心意、心愿。",{"a":1,"w":[8545,9229]}],["爱果","àiguǒ","佛教语。谓爱欲之果报。",{"a":1,"w":[131,7445]}],["爱流","àiliú","谓汇聚如流的众多情欲。",{"a":1,"w":[131,519]}],["感愕","gǎn'è","指表现出来的惊讶神态。",{"a":1,"w":[7473,15755]}],["愧佩","kuìpèi","谓对人钦佩，自愧不如。",{"a":1,"w":[9311,7810]}],["恺献","kǎixiàn","军事胜利献功时奏恺乐。",{"a":1,"w":[14439,3435]}],["栗锐","lìruì","谓具有令人战栗的锐气。",{"a":1,"w":[8177,8551]}],["慈纶","cílún","皇帝对母亲旨意的敬称。",{"a":1,"w":[8234,9177]}],["慊吝","qiànlìn","谓觉得为难，不允所请。",{"a":1,"w":[24205,11060]}],["慕殉","mùxùn","因仰慕其人而为之殉死。",{"a":1,"w":[8745,9777]}],["惨黩","cǎndú","昏暗貌。惨，通“黪”。",{"a":1,"w":[4840,11772]}],["慢怛","màndá","谓心胸广大，忧民之忧。",{"a":1,"w":[182,11800]}],["慧义","huìyì","佛教语。谓佛法的义谛。",{"a":1,"w":[8718,7437]}],["凭亿","píngyì","犹满怀。亿，通“臆”。",{"a":1,"w":[3452,774]}],["凭居","píngjū","据以为居处。犹言盘踞。",{"a":1,"w":[3452,7611]}],["憩脚","qìjiǎo","歇脚。指行进中的休息。",{"a":1,"w":[20457,602]}],["宪意","xiànyì","旧时称上司心意的敬词。",{"a":1,"w":[8343,7482]}],["宪简","xiànjiǎn","指御史弹奏所用的白简。",{"a":1,"w":[8343,7804]}],["宪驾","xiànjià","旧时对上级官员的敬称。",{"a":1,"w":[8343,7879]}],["懈话","xièhuà","不经心的话；泄气的话。",{"a":1,"w":[11231,120]}],["惩革","chénggé","谓鉴于前失而有所改变。",{"a":1,"w":[8807,7633]}],["怀危","huáiwēi","心存危惧。谓常恐获罪。",{"a":1,"w":[7749,7654]}],["悬度","xuándù","谓无根据地揣测、估计。",{"a":1,"w":[4694,513]}],["悬注","xuánzhù","倾流而下；从高处下注。",{"a":1,"w":[4694,7606]}],["忏陈","chànchén","犹忏悔。陈，自陈己过。",{"a":1,"w":[13549,7893]}],["恋班","liànbān","留恋官位。班，指朝班。",{"a":1,"w":[8204,135]}],["戍堡","shùbǎo","边防驻军的营垒、城堡。",{"a":1,"w":[9666,7946]}],["戎棨","róngqǐ","军中仪仗。用以称主帅。",{"a":1,"w":[8500,30771]}],["戎缮","róngshàn","指备战与修缮宫室之事。",{"a":1,"w":[8500,11032]}],["成哀","chéng'āi","汉成帝与汉哀帝的并称。",{"a":1,"w":[517,8386]}],["成庄","chéngzhuāng","周成王与周庄王的并称。",{"a":1,"w":[517,7932]}],["或或","huòhuò","迷惑貌。或，通“惑”。",{"a":1,"w":[664]}],["戗水","qiāngshuǐ","逆水。逆着水流的方向。",{"a":1,"w":[13624,11]}],["战克","zhànkè","亦作“战克”。\n战胜。",{"a":1,"w":[7438,516]}],["战瘢","zhànbān","作战受伤所留下的疤痕。",{"a":1,"w":[7438,10452]}],["户扃","hùjiōng","自外关闭门户用的门栓。",{"a":1,"w":[2320,15982]}],["房露","fánglù","古曲名。一名《防露》。",{"a":1,"w":[7555,4674]}],["扆旒","yǐliú","皇帝的代称。旒，帝冕。",{"a":1,"w":[22043,14816]}],["手镘","shǒumàn","以手持镘。谓作泥水工。",{"a":1,"w":[34,19033]}],["打垛","dǎduǒ","赌气。垛，借作“赌”。",{"a":1,"w":[66,9691]}],["扦蒂","qiāndì","瓜果和枝茎接连的部分。",{"a":1,"w":[11941,8392]}],["扣天","kòutiān","以手指天。多以表诚心。",{"a":1,"w":[4699,19]}],["扶曳","fúyè","搀扶着走。多指困顿貌。",{"a":1,"w":[3458,8838]}],["批帖","pītiē","旧时官府出的证明文书。",{"a":1,"w":[2363,8250]}],["批扞","pīgǎn","亦作“批扞”。\n抨击。",{"a":1,"w":[2363,10482]}],["批禀","pībǐng","经上级官府批过的禀帖。",{"a":1,"w":[2363,9733]}],["承守","chéngshǒu","谓继承守护先祖的家业。",{"a":1,"w":[7576,2338]}],["承祀","chéngsì","主持祭祀。指继承帝位。",{"a":1,"w":[7576,9915]}],["承萼","chéng'è","指物件承托的联结部分。",{"a":1,"w":[7576,9181]}],["把蟹","bǎxiè","手持蟹螯。谓饮酒吃蟹。",{"a":1,"w":[1321,8486]}],["抑厌","yìyàn","亦作“抑压”。\n压制。",{"a":1,"w":[8091,8372]}],["抑远","yìyuǎn","谓抑制感情，与之疏远。",{"a":1,"w":[8091,103]}],["投殒","tóuyǔn","投身殒命。谓以死相报。",{"a":1,"w":[2288,13189]}],["披厦","pīshà","正屋旁依墙所搭的小屋。",{"a":1,"w":[3456,9236]}],["抱兜","bàodōu","一种附有钱包的阔腰带。",{"a":1,"w":[2374,4737]}],["抱案","bào'àn","抱持案牍。谓办理公文。",{"a":1,"w":[2374,7610]}],["抱风","bàofēng","犹捕风。比喻无效行动。",{"a":1,"w":[2374,44]}],["抵扞","dǐgǎn","亦作“抵扞”。\n抗拒。",{"a":1,"w":[7874,10482]}],["抵玉","dǐyù","犹抵鹊。比喻大材小用。",{"a":1,"w":[7874,2294]}]]