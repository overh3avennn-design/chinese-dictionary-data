[["共持","gòngchí","1) 共同拿着。\n2) 共同扶持。",{"a":1,"w":[2273,7617]}],["共鲧","gònggǔn","共工与鲧的并称。鲧，也写作“鲧”。",{"a":1,"w":[2273,37710]}],["具区","jùqū","古泽薮名，即太湖。又名震泽、笠泽。",{"a":1,"w":[7505,1296]}],["典律","diǎnlǜ","1) 典章律令。\n2) 主管音律。",{"a":1,"w":[7636,7544]}],["典教","diǎnjiào","1) 典章教化。\n2) 主管教育。",{"a":1,"w":[7636,77]}],["兼临","jiānlín","谓在上位的人对在下者广加包涵容纳。",{"a":1,"w":[8290,7625]}],["冒妄","màowàng","1) 犹假冒。\n2) 冒昧不自量。",{"a":1,"w":[3400,8584]}],["冒袭","màoxí","1) 冒名承袭。\n2) 盲目承袭。",{"a":1,"w":[3400,7990]}],["冒赏","màoshǎng","1) 冒功受赏。\n2) 用作谦词。",{"a":1,"w":[3400,2415]}],["冗泛","rǒngfàn","1) 犹泛泛，一般。\n2) 多余。",{"a":1,"w":[9654,8013]}],["冠绅","guānshēn","1) 比喻仕宦。\n2) 戴帽束带。",{"a":1,"w":[7694,9994]}],["冥椿","míngchūn","冥灵与大椿的并称，传说中的古树名。",{"a":1,"w":[8508,10732]}],["冥索","míngsuǒ","1) 暗中寻找。\n2) 潜心探究。",{"a":1,"w":[8508,7470]}],["冥缘","míngyuán","佛教语。谓隐微难见的三世因缘果报。",{"a":1,"w":[8508,7628]}],["冥缅","míngmiǎn","1) 谓玄妙难明。\n2) 幽远貌。",{"a":1,"w":[8508,8621]}],["冥色","míngsè","1) 浅黑色。\n2) 暮色，夜色。",{"a":1,"w":[8508,2266]}],["冥迹","míngjì","1) 指玄理。\n2) 隐身，隐居。",{"a":1,"w":[8508,8080]}],["冬事","dōngshì","冬季的大事。古指冬祭、处决犯人等。",{"a":1,"w":[1390,33]}],["冰桥","bīngqiáo","河上结冰坚固，可以行走，谓之冰桥。",{"a":1,"w":[2318,1435]}],["凋悴","diāocuì","1) 衰败憔悴。\n2) 衰落破败。",{"a":1,"w":[12187,11042]}],["凋枯","diāokū","1) 凋谢枯萎。\n2) 指人死亡。",{"a":1,"w":[12187,8333]}],["凝厉","nínglì","1) 冷冻寒凉。\n2) 庄重严厉。",{"a":1,"w":[7665,8111]}],["凝洁","níngjié","1) 庄重高洁。\n2) 柔滑洁白。",{"a":1,"w":[7665,8263]}],["凡吏","fánlì","1) 平庸官吏。\n2) 一般差役。",{"a":1,"w":[8150,8898]}],["凡猥","fánwěi","1) 平庸鄙陋。\n2) 平常的人。",{"a":1,"w":[8150,9889]}],["凶命","xiōngmìng","1) 犹恶运。\n2) 不祥的命令。",{"a":1,"w":[4750,4622]}],["凶墟","xiōngxū","将叛臣的宫室夷而为污池，谓之凶墟。",{"a":1,"w":[4750,11687]}],["出拔","chūbá","1) 犹言超脱。\n2) 犹言出众。",{"a":1,"w":[22,3360]}],["分任","fēnrèn","1) 分别担任。\n2) 分别承担。",{"a":1,"w":[15,1331]}],["切戒","qièjiè","1) 务须避免。\n2) 严肃告戒。",{"a":1,"w":[2276,3377]}],["刑仵","xíngwǔ","犹仵作。旧时官署中检验死伤的吏役。",{"a":1,"w":[7716,24094]}],["刑伤","xíngshāng","1) 杀伤。\n2) 受刑后的创伤。",{"a":1,"w":[7716,1358]}],["列亭","liètíng","古时排列在边境上侦察敌情的了望所。",{"a":1,"w":[2268,8241]}],["列门","lièmén","1) 水渠。\n2) 指家族各分支。",{"a":1,"w":[2268,53]}],["别姓","biéxìng","1) 其他族姓。\n2) 分建族姓。",{"a":1,"w":[69,719]}],["别食","biéshí","1) 另享封禄。\n2) 分别进食。",{"a":1,"w":[69,7466]}],["删夷","shānyí","1) 削除；剪除。\n2) 犹删除。",{"a":1,"w":[9465,7910]}],["刷荡","shuādàng","1) 洗濯; 荡涤。\n2) 荡除。",{"a":1,"w":[2365,7756]}],["刺奸","cìjiān","督察奸吏。后为行使此种职责的官名。",{"a":1,"w":[2300,8125]}],["削稿","xuēgǎo","1) 犹削草。\n2) 谓删改定稿。",{"a":1,"w":[4765,8822]}],["削约","xuēyuē","1) 犹削减。\n2) 稀疏细小貌。",{"a":1,"w":[4765,1330]}],["剔拨","tībō","1) 犹点拨，开导。\n2) 拨动。",{"a":1,"w":[9422,4720]}],["剖散","pōusàn","1) 解剖分散。\n2) 割裂抛散。",{"a":1,"w":[8592,2286]}],["刚厉","gānglì","1) 威猛暴厉。\n2) 刚正严厉。",{"a":1,"w":[636,8111]}],["刚折","gāngzhé","谓刚直不阿，敢于当面指摘人的过失。",{"a":1,"w":[636,2292]}],["副宪","fùxiàn","清代都察院副长官左副都御史的别称。",{"a":1,"w":[4673,8343]}],["创痏","chuàngwěi","1) 疮伤；受伤。\n2) 喻祸害。",{"a":1,"w":[7933,54539]}],["札青","zháqīng","在手臂上刺上图案花纹，用颜色涂之。",{"a":1,"w":[8726,3320]}],["功次","gōngcì","指功绩的大小、官阶升迁的先后顺序。",{"a":1,"w":[7516,102]}],["劫烧","jiéshāo","佛教谓世界毁灭时大火燃烧至二禅天。",{"a":1,"w":[8458,2303]}],["劫胁","jiéxié","1) 威逼胁迫。\n2) 指胁从者。",{"a":1,"w":[8458,8936]}],["勒停","lēitíng","1) 强制停止。\n2) 勒令停职。",{"a":1,"w":[7571,624]}],["勒功","lēigōng","把记功文字刻在石上。亦指建立功勋。",{"a":1,"w":[7571,7516]}],["勒毕","lēibì","古小说中的国名。传说其国之人善言。",{"a":1,"w":[7571,8120]}],["勒面","lēimiàn","古代马面饰。用白黑二色的熟皮制成。",{"a":1,"w":[7571,523]}],["动举","dòngjǔ","1) 推动举起。\n2) 举止动作。",{"a":1,"w":[6,606]}],["劳扰","láorǎo","1) 劳苦烦扰。\n2) 烦劳打扰。",{"a":1,"w":[7526,7972]}],["勤雨","qínyǔ","1) 谓以不雨为忧。\n2) 多雨。",{"a":1,"w":[7857,159]}],["匏革","páogé","笙和鼓。皆八音之一。借指各种乐器。",{"a":1,"w":[14434,7633]}],["北卷","běijuǎn","明清科举对北方各省会试试卷的统称。",{"a":1,"w":[132,2296]}],["北烛","běizhú","1) 即北烛仙人。\n2) 神女名。",{"a":1,"w":[132,8450]}],["北畤","běizhì","即黑帝祠，汉高祖时置，祀黑帝之处。",{"a":1,"w":[132,39975]}],["北社","běishè","大社以北六里所建的祭祀土神的社坛。",{"a":1,"w":[132,3327]}],["匹纸","pǐzhǐ","我国古代一种供作画写字用的优质纸。",{"a":1,"w":[3427,622]}],["区盖","qūgài","即丘盖。谓疑而不明。区，通“丘”。",{"a":1,"w":[1296,2289]}],["午香","wǔxiāng","旧俗阴历五月每日中午用以祭祀的香。",{"a":1,"w":[8095,1311]}],["卉衣","huìyī","1) 即卉服。\n2) 泛指粗布衣。",{"a":1,"w":[13145,7536]}],["占辞","zhàncí","I\n占卜的记录。\nII\n口述言辞。",{"a":1,"w":[647,7757]}],["印齿","yìnchǐ","指印章凸出可沾印泥的部分。犹印面。",{"a":1,"w":[4649,7577]}],["危反","wēifǎn","诡反。犹言阴谋叛乱。危，通“诡”。",{"a":1,"w":[7654,2260]}],["危坠","wēizhuì","1) 犹危亡。\n2) 见“危堕”。",{"a":1,"w":[7654,4826]}],["卷梁","juǎnliáng","古代冠内用以支撑而呈弯曲状的横脊。",{"a":1,"w":[2296,7890]}],["卷领","juǎnlǐng","领翻于外。古人认为是较原始的服式。",{"a":1,"w":[2296,1361]}],["却生","quèshēng","1) 死而复苏。\n2) 后退贪生。",{"a":1,"w":[2314,508]}],["厚货","hòuhuò","丰厚的财物。特指行贿或致酬的钱财。",{"a":1,"w":[2336,2304]}],["参奉","cānfèng","1) 犹参与。\n2) 参拜，谒见。",{"a":1,"w":[7543,7971]}],["参究","cānjiū","1) 参验考究。\n2) 弹劾查究。",{"a":1,"w":[7543,7647]}],["参罚","cānfá","I\n见“参伐”。\nII\n弹劾处罚。",{"a":1,"w":[7543,3430]}],["参署","cānshǔ","谓为官。多指代理、暂任或试充官职。",{"a":1,"w":[7543,8264]}],["参虎","cānhǔ","即参星。为西方白虎七宿之一，故称。",{"a":1,"w":[7543,3337]}],["参体","cāntǐ","1) 犹并立。\n2) 谓体例相近。",{"a":1,"w":[7543,7417]}],["及难","jínán","1) 指灾难发生时。\n2) 遇祸。",{"a":1,"w":[7593,117]}],["友教","yǒujiào","指不执师徒之礼，以朋友的身分教授。",{"a":1,"w":[7735,77]}],["反书","fǎnshū","I\n报告叛乱的文书。\nII\n翻书。",{"a":1,"w":[2260,81]}],["取境","qǔjìng","谓因客观事物的作用而产生某种意境。",{"a":1,"w":[580,7721]}],["取类","qǔlèi","谓取用类似事物以说明本体。犹比喻。",{"a":1,"w":[580,1323]}],["受名","shòumíng","1) 获得名称。\n2) 获得名声。",{"a":1,"w":[1324,560]}],["丛秽","cónghuì","1) 犹荒芜。\n2) 丛生的恶草。",{"a":1,"w":[4787,9258]}],["古峭","gǔqiào","1) 古朴端肃。\n2) 古朴简劲。",{"a":1,"w":[1322,10907]}],["古常","gǔcháng","1) 古制常法。\n2) 古朴寻常。",{"a":1,"w":[1322,99]}],["古简","gǔjiǎn","1) 古代汗简。\n2) 古朴简练。",{"a":1,"w":[1322,7804]}],["叱吸","chìxī","犹呼吸。指气流在众窍中的出没往返。",{"a":1,"w":[11061,2331]}],["司搏","sībó","伺机捕捉；侦察捉拿。司，通“伺”。",{"a":1,"w":[7476,8455]}],["合弩","hénǔ","即连弩。装有机栝，可数矢并发的弓。",{"a":1,"w":[1269,9962]}],["合祧","hétiāo","合祀于祧庙。祧，祀远祖、始祖之庙。",{"a":1,"w":[1269,17234]}],["合簪","hézān","犹同僚。簪，簪缨，古代官吏的冠饰。",{"a":1,"w":[1269,9760]}],["合杂","hézá","1) 混杂；嘈杂。\n2) 犹交错。",{"a":1,"w":[1269,4680]}],["同恤","tóngxù","1) 一同忧伤。\n2) 共同匡救。",{"a":1,"w":[4611,8783]}],["名通","míngtōng","1) 名言通论。\n2) 通达合理。",{"a":1,"w":[560,518]}],["吏政","lìzhèng","1) 官吏的政绩。\n2) 犹政事。",{"a":1,"w":[8898,7478]}],["吏职","lìzhí","1) 官吏的职责。\n2) 指官职。",{"a":1,"w":[8898,7609]}],["吏鬼","lìguǐ","指祠官。古代掌管祭祀、祠庙的官员。",{"a":1,"w":[8898,3340]}],["君师","jūnshī","古代君、师皆尊，故常以君师称天子。",{"a":1,"w":[7831,7489]}],["吟想","yínxiǎng","1) 沉吟想念。\n2) 吟味深思。",{"a":1,"w":[8955,156]}],["吧喳","bazhā","象声词。形容东西落地或撞击的声音。",{"a":1,"w":[203,11418]}],["含育","hányù","1) 收容养育。\n2) 包容化育。",{"a":1,"w":[2351,7738]}],["含露","hánlù","1) 带着露水。\n2) 口衔露水。",{"a":1,"w":[2351,4674]}],["吱溜","zhīliū","象声词。形容迅速滑动或移动的声音。",{"a":1,"w":[12439,4717]}],["吴口","wúkǒu","指吴地的美女。古称男曰丁，女曰口。",{"a":1,"w":[8110,47]}],["吴吟","wúyín","1) 谓吟唱吴歌。\n2) 指吴歌。",{"a":1,"w":[8110,8955]}],["吴绢","wújuàn","古代吴地所产的绢。以质地轻薄着名。",{"a":1,"w":[8110,10923]}],["吻吮","wěnshǔn","1) 谓用口吹奏。\n2) 犹吻吸。",{"a":1,"w":[3451,12751]}],["吽吽","hōnghōng","1) 牛鸣声。\n2) 发怒出声貌。",{"a":1,"w":[23365]}],["告牒","gàodié","1) 告发的文书。\n2) 即告身。",{"a":1,"w":[7591,10089]}],["周施","zhōushī","1) 普遍安设。\n2) 周济施舍。",{"a":1,"w":[563,7507]}],["周致","zhōuzhì","1) 周到严格。\n2) 完备精致。",{"a":1,"w":[563,7666]}],["周防","zhōufáng","1) 谨密防患。\n2) 四周防护。",{"a":1,"w":[563,1302]}],["周鼓","zhōugǔ","指石鼓文。古人以为刻于周代，故称。",{"a":1,"w":[563,3352]}],["呼鸣","hūmíng","1) 鸣叫。\n2) 指叫声或响声。",{"a":1,"w":[7783,7935]}],["命姓","mìngxìng","赐姓氏；建立姓氏。谓赐姓以示褒崇。",{"a":1,"w":[4622,719]}],["命术","mìngshù","1) 算命之术。\n2) 肾的别名。",{"a":1,"w":[4622,7471]}],["咀谯","jǔqiáo","1) 犹咀嚼。\n2) 玩味；钻研。",{"a":1,"w":[11266,14550]}],["和媚","hémèi","1) 温和美好。\n2) 和顺谄媚。",{"a":1,"w":[39,9523]}],["和弱","héruò","1) 调和抑制。\n2) 温和文弱。",{"a":1,"w":[39,2376]}],["和泰","hétài","1) 温和安祥。\n2) 和顺太平。",{"a":1,"w":[39,7662]}],["咎毁","jiùhuǐ","1) 归咎，诋毁。\n2) 犹咎悔。",{"a":1,"w":[9750,4749]}],["咨疑","zīyí","1) 询问疑难。\n2) 嗟叹诧异。",{"a":1,"w":[8646,8055]}],["咽噱","yànjué","犹嗢噱。谓读书有会心处而欢乐不止。",{"a":1,"w":[9066,20521]}],["哀念","āiniàn","1) 悲伤的意念。\n2) 犹怜悯。",{"a":1,"w":[8386,1422]}],["唐文","tángwén","指古代圣贤的礼乐制度。唐，指唐尧。",{"a":1,"w":[7869,7415]}],["启銮","qǐluán","起驾。旧指皇帝登舆出行。銮，銮舆。",{"a":1,"w":[7875,13822]}],["善否","shànfǒu","1) 善恶；好坏。\n2) 犹褒贬。",{"a":1,"w":[7657,8585]}],["善熟","shànshú","1) 犹丰收。\n2) 和善，和气。",{"a":1,"w":[7657,642]}],["喝月","hēyuè","喝令月亮；喝斥月亮。形容气概豪迈。",{"a":1,"w":[202,101]}],["丧资","sàngzī","1) 失去财产。\n2) 失去路费。",{"a":1,"w":[8016,7444]}],["单使","dānshǐ","1) 单身出使。\n2) 单身使者。",{"a":1,"w":[2269,1332]}],["单帐","dānzhàng","1) 单层的帐子。\n2) 即帐单。",{"a":1,"w":[2269,8011]}],["单简","dānjiǎn","1) 单份的书简。\n2) 犹简单。",{"a":1,"w":[2269,7804]}],["单至","dānzhì","寓言中的人名。词义本为轻率的样子。",{"a":1,"w":[2269,3346]}],["嗛然","qiǎnrán","I\n不满足貌。\nII\n自得的样子。",{"a":1,"w":[15718,7451]}],["嗣宗","sìzōng","三国魏阮籍的字。“竹林七贤”之一。",{"a":1,"w":[9449,7624]}],["嗣武","sìwǔ","犹言足迹相连。喻指接续他人的事业。",{"a":1,"w":[9449,7504]}],["叹笑","tànxiào","1) 嗟叹讥笑。\n2) 赞赏欢笑。",{"a":1,"w":[8742,185]}],["嘉答","jiādá","表示赞许的答覆。多用于上级对下级。",{"a":1,"w":[8327,3407]}],["嘲调","cháodiào","I\n嘲弄调笑。\nII\n嘲讽的才情。",{"a":1,"w":[10741,1290]}],["嘶歕","sīpēn","(马)边嘘气边嘶叫。歕，同“喷”。",{"a":1,"w":[11796,441733]}],["噶霏","gáfēi","英文coffee的旧译名。即咖啡。",{"a":1,"w":[10332,17624]}],["嚬蛾","pín'é","1) 微皱的眉头。\n2) 皱眉头。",{"a":1,"w":[28640,8746]}],["严两","yánliǎng","装饰华丽的车辆。两，“辆”的古字。",{"a":1,"w":[2349,96]}],["严察","yánchá","1) 严厉苛察。\n2) 严格察查。",{"a":1,"w":[2349,7567]}],["严核","yánhé","1) 严谨明察。\n2) 严厉苛察。",{"a":1,"w":[2349,7551]}],["严静","yánjìng","1) 宁静。\n2) 严明而不纷扰。",{"a":1,"w":[2349,1386]}],["嚾呼","huānhū","1) 喧闹；喊叫。\n2) 犹欢呼。",{"a":1,"w":[126341,7783]}],["嗫嗫","nièniè","1) 多言。\n2) 形容声音轻细。",{"a":1,"w":[43867]}],["囊载","nángzài","装入囊中运走。犹言尽其所有而取之。",{"a":1,"w":[7777,7491]}],["四察","sìchá","指用目、耳、口、心察真伪，审正邪。",{"a":1,"w":[86,7567]}],["四忌","sìjì","1) 四种忌讳。\n2) 四种忌讳。",{"a":1,"w":[86,8540]}],["四祸","sìhuò","指穷兵黩武造成的四大祸殃危害其国。",{"a":1,"w":[86,8225]}],["四蔽","sìbì","1) 四面遮蔽。\n2) 四种弊端。",{"a":1,"w":[86,8083]}],["四辰","sìchén","1) 犹四时。\n2) 指四个时辰。",{"a":1,"w":[86,8629]}],["国恩","guó'ēn","指封建时代王朝或君主所赐予的恩惠。",{"a":1,"w":[23,7704]}],["国邸","guódǐ","汉诸侯王为朝觐而在京城设立的住所。",{"a":1,"w":[23,10202]}],["围守","wéishǒu","1) 包围监守。\n2) 设围防守。",{"a":1,"w":[1403,2338]}],["土候","tǔhòu","亦作“土堠”。\n古代记里程的土堆。",{"a":1,"w":[1300,7622]}],["在告","zàigào","官吏在休假期中。告，古时官吏休假。",{"a":1,"w":[52,7591]}],["地烛","dìzhú","古代国有大事，设于宫门地上的烛炬。",{"a":1,"w":[10,8450]}],["坤厚","kūnhòu","1) 谓大地博厚。\n2) 指大地。",{"a":1,"w":[9337,2336]}],["垂精","chuíjīng","1) 发射光芒。\n2) 犹言致力。",{"a":1,"w":[7786,4629]}],["垂绥","chuísuí","1) 美玉名。\n2) 枝叶下垂貌。",{"a":1,"w":[7786,8836]}],["垂芒","chuímáng","1) 伸出芒刺。\n2) 焕发光芒。",{"a":1,"w":[7786,8347]}],["埃雾","āiwù","1) 尘雾。\n2) 喻世俗的污浊。",{"a":1,"w":[7754,3421]}],["城肆","chéngsì","1) 城中市场。\n2) 泛指城市。",{"a":1,"w":[1353,8346]}],["执定","zhídìng","1) 犹坚持。\n2) 牢牢地拿着。",{"a":1,"w":[7826,2259]}],["基扃","jījiōng","1) 泛指城阙。\n2) 借指基业。",{"a":1,"w":[7423,15982]}],["堂戺","tángshì","厅堂与台阶。戺，阶旁斜石。指堂前。",{"a":1,"w":[7695,77511]}],["堂赠","tángzèng","古代年终驱送瘟疫和不祥的一种礼俗。",{"a":1,"w":[7695,3514]}],["坚卓","jiānzhuó","1) 犹坚贞。\n2) 谓准确卓绝。",{"a":1,"w":[7849,8642]}],["堆纱","duīshā","用薄绢摺叠缝制成花朵或某种装饰物。",{"a":1,"w":[3333,8800]}],["塞蔽","sāibì","1) 犹闭塞。\n2) 堵塞，遮蔽。",{"a":1,"w":[4630,8083]}],["墓阙","mùquē","古代陵墓前的石建筑，通常左右各一。",{"a":1,"w":[4932,8773]}],["墩官","dūnguān","辽代御宴时被赐坐的官员称“墩官”。",{"a":1,"w":[8891,2293]}],["坏隤","huàituí","1) 坍塌。\n2) 春秋鲁国邑名。",{"a":1,"w":[163,14945]}],["外顺","wàishùn","1) 外貌和顺。\n2) 表面顺从。",{"a":1,"w":[36,4660]}],["夙构","sùgòu","亦作“夙构”。\n谓事先拟就或备好。",{"a":1,"w":[9924,7540]}],["多易","duōyì","谓常把事情看得太容易；多轻易行事。",{"a":1,"w":[21,7463]}],["大仆","dàpū","周官名。掌传达王命、侍从出入等事。",{"a":1,"w":[4,9072]}],["大榷","dàquè","1) 亦作“大榷”。\n2) 大略。",{"a":1,"w":[4,12198]}],["大盈","dàyíng","1) 极其充盈。\n2) 即大盈库。",{"a":1,"w":[4,8251]}],["大询","dàxún","古谓君向臣民征询对国家大事的意见。",{"a":1,"w":[4,8379]}],["大谊","dàyì","1) 正道；大原则。\n2) 要旨。",{"a":1,"w":[4,9604]}],["大讳","dàhuì","1) 大禁忌。\n2) 谓天子之死。",{"a":1,"w":[4,9336]}],["天壁","tiānbì","高耸入天的崖壁。极言山崖峭壁之高。",{"a":1,"w":[19,7850]}],["天怪","tiānguài","云气的不正常变化。古人据以测吉凶。",{"a":1,"w":[19,2379]}],["天槎","tiānchá","古代神话中指可在天地间往来的木筏。",{"a":1,"w":[19,10503]}],["天逸","tiānyì","1) 天性放逸。\n2) 天然超绝。",{"a":1,"w":[19,8116]}],["天霄","tiānxiāo","1) 天上的云气。\n2) 指天空。",{"a":1,"w":[19,9823]}],["夷务","yíwù","清代后期指与外国有关系的各种事务。",{"a":1,"w":[7910,7448]}],["夷泰","yítài","1) 平坦通畅。\n2) 平和闲静。",{"a":1,"w":[7910,7662]}],["奇颖","qíyǐng","1) 非常聪明。\n2) 奇特新颖。",{"a":1,"w":[7460,9499]}],["奇险","qíxiǎn","1) 奇特险怪。\n2) 非常险要。",{"a":1,"w":[7460,4634]}],["奉屈","fèngqū","1) 犹言屈驾。\n2) 请受委屈。",{"a":1,"w":[7971,7898]}],["奏正","zòuzhèng","1) 奏请判处。\n2) 奏请更正。",{"a":1,"w":[4777,62]}],["奔驹","bēnjū","1) 奔跑之马。\n2) 比喻光阴。",{"a":1,"w":[8195,10684]}],["奥僻","àopì","1) 幽隐偏僻。\n2) 古奥冷僻。",{"a":1,"w":[7481,9462]}],["奥折","àozhé","1) 古奥曲折。\n2) 幽深曲折。",{"a":1,"w":[7481,2292]}],["奥水","àoshuǐ","古水名。在今河南省泌阳、遂平县境。",{"a":1,"w":[7481,11]}],["妍冶","yányě","1) 华美。\n2) 指美丽的女子。",{"a":1,"w":[13038,8648]}],["妖玩","yāowán","1) 指美女。\n2) 怪异的玩好。",{"a":1,"w":[8617,648]}],["妙斫","miàozhuó","精妙的刀斧工。泛指功力精深的技能。",{"a":1,"w":[4764,11020]}],["妙气","miàoqì","1) 豪侠之气。\n2) 灵妙之气。",{"a":1,"w":[4764,510]}],["妥侑","tuǒyòu","《诗‧小雅‧楚茨》：“以妥以侑。”",{"a":1,"w":[8393,33698]}],["委坠","wěizhuì","1) 曲折，遥远。\n2) 下垂貌。",{"a":1,"w":[7519,4826]}],["委泊","wěipō","1) 犹停泊。\n2) 波涛冲击貌。",{"a":1,"w":[7519,8463]}],["姚魏","yáowèi","“姚黄魏紫”的省称。亦泛指牡丹花。",{"a":1,"w":[11353,8322]}],["奸憸","jiānxiān","1) 奸诈邪恶。\n2) 奸邪的人。",{"a":1,"w":[8125,21799]}],["奸权","jiānquán","亦作“奸权”。\n奸邪而有权势的人。",{"a":1,"w":[8125,4623]}],["姻眷","yīnjuàn","1) 姻亲。\n2) 犹姻缘，婚配。",{"a":1,"w":[8706,11163]}],["威焰","wēiyàn","亦作“威焰”。\n指显赫的威势气焰。",{"a":1,"w":[7646,8874]}],["娩难","miǎnnán","分娩。旧时分娩为妇女的灾难，故称。",{"a":1,"w":[12827,117]}],["婉仪","wǎnyí","1) 美好的仪态。\n2) 女官名。",{"a":1,"w":[9326,7483]}],["妇事","fùshì","谓妇女所从事的纺织、刺绣、缝纫等。",{"a":1,"w":[7957,33]}],["媒諓","méijiàn","亦作“媒谮”。\n谓藉故进谗诬陷人。",{"a":1,"w":[8288,179698]}],["嫩箭","nènjiàn","指兰花新抽的花茎。其形似箭，故名。",{"a":1,"w":[3551,4666]}],["婵嫣","chányān","1) 相连貌。\n2) 卯年的别称。",{"a":1,"w":[45309,23046]}],["娇冶","jiāoyě","1) 艳丽；妖媚。\n2) 指美女。",{"a":1,"w":[8704,8648]}],["孀雌","shuāngcí","失去配偶的雌性动物。喻守寡的妇女。",{"a":1,"w":[19311,10657]}],["孔宣","kǒngxuān","即孔子。因唐代追谥为文宣王，故称。",{"a":1,"w":[4636,7827]}],["存志","cúnzhì","1) 保全志向。\n2) 寄托志向。",{"a":1,"w":[1349,7626]}],["孝棚","xiàopéng","在灵堂前临时搭起的供吊唁用的帐棚。",{"a":1,"w":[8298,8961]}],["孤传","gūchuán","I\n单传。\nII\n孤独的驿站车马。",{"a":1,"w":[7996,1297]}],["孙庞","sūnpáng","孙膑和庞涓的并称。二人曾同学兵法。",{"a":1,"w":[7936,9333]}],["守祀","shǒusì","守宗庙、祀社稷山川的人。借指国君。",{"a":1,"w":[2338,9915]}],["守视","shǒushì","1) 看护；守卫。\n2) 犹注视。",{"a":1,"w":[2338,7494]}],["安休","ānxiū","1) 安宁。\n2) 犹安息。长眠。",{"a":1,"w":[2261,7670]}],["安翔","ānxiáng","1) 慢慢地飞翔。\n2) 舒缓貌。",{"a":1,"w":[2261,8986]}],["完壮","wánzhuàng","1) 完好坚固。\n2) 充实强劲。",{"a":1,"w":[604,8135]}],["完锐","wánruì","1) 完备精良。\n2) 坚固锐利。",{"a":1,"w":[604,8551]}],["宏峻","hóngjùn","1) 高大陡峭。\n2) 泛指高大。",{"a":1,"w":[8933,9365]}],["宏整","hóngzhěng","1) 宏伟整齐。\n2) 宏伟严谨。",{"a":1,"w":[8933,1355]}],["宏覆","hóngfù","普遍覆盖。谓普天之下无不受其庇护。",{"a":1,"w":[8933,7864]}],["宏邃","hóngsuì","1) 宏大幽深。\n2) 博大精深。",{"a":1,"w":[8933,11821]}],["官仓","guāncāng","1) 官府的仓廪。\n2) 指官粮。",{"a":1,"w":[2293,8035]}],["官口","guānkǒu","没入官府充当奴隶的罪犯家口或俘虏。",{"a":1,"w":[2293,47]}],["宜若","yíruò","表拟测或推断之词。犹言似乎；好象。",{"a":1,"w":[7984,4652]}],["客程","kèchéng","1) 旅程。\n2) 借指旅途生涯。",{"a":1,"w":[7618,7453]}],["客贾","kèjiǎ","商人。因贩卖货物而往来各地，故称。",{"a":1,"w":[7618,8056]}],["宫园","gōngyuán","1) 宫中的园林。\n2) 指王宫。",{"a":1,"w":[4679,4715]}],["宫宇","gōngyǔ","宫殿。指帝王居住的高大华丽的房屋。",{"a":1,"w":[4679,7949]}],["宫钥","gōngyào","帝王宫门的锁钥。常借称宫门、皇宫。",{"a":1,"w":[4679,9086]}],["宵月","xiāoyuè","1) 夜晚的月亮。\n2) 指夜晚。",{"a":1,"w":[9364,101]}],["宸象","chénxiàng","1) 指紫微垣。\n2) 借喻君王。",{"a":1,"w":[11471,7500]}],["宿兵","sùbīng","1) 驻扎军队。\n2) 旧日的兵。",{"a":1,"w":[7825,2282]}],["宿坛","sùtán","旧谓官员外出时寄宿神庙，设座理事。",{"a":1,"w":[7825,8465]}],["寄田","jìtián","古谓农田少的国家移民到别国去种田。",{"a":1,"w":[2358,4668]}],["寄处","jìchù","I\n寄居栖身。\nII\n寄送的处所。",{"a":1,"w":[2358,2272]}],["寅酉","yínyǒu","十二辰中寅时和酉时。故寅酉犹晨昏。",{"a":1,"w":[9870,10666]}],["密索","mìsuǒ","1) 精密思索。\n2) 秘密搜索。",{"a":1,"w":[2299,7470]}],["密运","mìyùn","1) 周密运筹。\n2) 暗中施行。",{"a":1,"w":[2299,3313]}],["寇逆","kòunì","1) 贼寇，叛逆。\n2) 指叛乱。",{"a":1,"w":[9047,7762]}],["富骆","fùluò","初唐着名诗人富嘉谟与骆宾王的并称。",{"a":1,"w":[1388,10938]}],["寒厉","hánlì","1) 形容严寒。\n2) 冷峻严厉。",{"a":1,"w":[7631,8111]}],["寒哀","hán'āi","即韩哀。相传为古代发明驭马术的人。",{"a":1,"w":[7631,8386]}],["寒穴","hánxué","指传说中西方极远处荒寒穴居的地方。",{"a":1,"w":[7631,8147]}],["寓祭","yùjì","谓象征性祭祀。借此祭彼，托物致祭。",{"a":1,"w":[9167,8417]}],["寖近","jìnjìn","1) 逐渐亲近。\n2) 逐渐接近。",{"a":1,"w":[126023,574]}],["察度","chádù","I\n观察长度。\nII\n犹审察测度。",{"a":1,"w":[7567,513]}],["察只","cházhǐ","宋代方言。当世无双，独一无二之意。",{"a":1,"w":[7567,612]}],["寡特","guǎtè","1) 谓孤立。\n2) 谓无所攀援。",{"a":1,"w":[8272,4607]}],["宁固","nínggù","1) 犹巩固。\n2) 谓安康长寿。",{"a":1,"w":[7508,7552]}],["审端","shěnduān","1) 检查修正。\n2) 详尽公正。",{"a":1,"w":[7781,4659]}],["审听","shěntīng","1) 细听。\n2) 指听讼、审案。",{"a":1,"w":[7781,146]}],["审鉴","shěnjiàn","1) 审察借鉴。\n2) 仔细鉴别。",{"a":1,"w":[7781,8039]}],["写状","xiězhuàng","1) 描摹形状。\n2) 撰写诉状。",{"a":1,"w":[172,7511]}],["宝函","bǎohán","指盛佛经、典册及贵重首饰等的匣子。",{"a":1,"w":[2313,7764]}],["宝阁","bǎogé","对佛寺殿阁的美称。亦指华丽的殿阁。",{"a":1,"w":[2313,8208]}],["封兽","fēngshòu","1) 古指大象。\n2) 泛指大兽。",{"a":1,"w":[600,8325]}],["封秩","fēngzhì","1) 封官授禄。\n2) 泛指官爵。",{"a":1,"w":[600,9216]}],["封发","fēngfā","指贾直言妻封束发髻、誓不改嫁之事。",{"a":1,"w":[600,522]}],["专己","zhuānjǐ","1) 固执己见。\n2) 独断专行。",{"a":1,"w":[7548,7767]}],["专直","zhuānzhí","1) 专心一意。\n2) 一意直行。",{"a":1,"w":[7548,1294]}],["尉律","wèilǜ","汉律令为廷尉所掌管，故称“尉律”。",{"a":1,"w":[9085,7544]}],["尊正","zūnzhèng","1) 尊敬。\n2) 对人妻的敬称。",{"a":1,"w":[7922,62]}],["寻端","xúnduān","1) 循着线索。\n2) 寻找事端。",{"a":1,"w":[7855,4659]}],["对籴","duìdí","向民户征购与其应缴赋税等额的粮食。",{"a":1,"w":[40,19032]}],["对见","duìjiàn","受皇帝召见。因见时有所奏对，故称。",{"a":1,"w":[40,76]}],["小屈","xiǎoqū","1) 稍受委屈。\n2) 稍稍理亏。",{"a":1,"w":[16,7898]}],["小廉","xiǎolián","小事上的廉洁。因非大德，故曰小廉。",{"a":1,"w":[16,8138]}],["小衍","xiǎoyǎn","谓以天数五与地数五相合而推衍卦义。",{"a":1,"w":[16,8283]}],["小辇","xiǎoniǎn","人力挽行的轻车，汉以后为帝王专乘。",{"a":1,"w":[16,10459]}],["小阕","xiǎoquè","1) 稍有空闲。\n2) 短篇的词。",{"a":1,"w":[16,27430]}],["小陋","xiǎolòu","1) 小而简陋。\n2) 矮小丑陋。",{"a":1,"w":[16,9064]}],["尨降","mángjiàng","古代相传高阳氏八个有才德的人之一。",{"a":1,"w":[16407,2305]}],["就室","jiùshì","1) 指夫妻同房。\n2) 指成家。",{"a":1,"w":[95,1359]}],["屋兽","wūshòu","我国古建筑屋脊上的一种兽形装饰物。",{"a":1,"w":[3389,8325]}],["展鞠","zhǎnjū","展衣和鞠衣。古代王后及命妇的礼服。",{"a":1,"w":[7565,10161]}],["屡迁","lǚqiān","1) 多次变易。\n2) 多次迁徙。",{"a":1,"w":[9826,8003]}],["屯备","túnbèi","1) 驻防。\n2) 指屯军的武备。",{"a":1,"w":[8563,7452]}],["屯列","túnliè","1) 布防，屯驻。\n2) 犹陈列。",{"a":1,"w":[8563,2268]}],["屯学","túnxué","对屯田军民讲习耕战之事的教学组织。",{"a":1,"w":[8563,13]}],["屯札","túnzhá","1) 亦作“屯札”。\n2) 驻扎。",{"a":1,"w":[8563,8726]}],["山库","shānkù","五代时一种用胶泥烧制而成的劣质钱。",{"a":1,"w":[45,3332]}],["山徼","shānjiǎo","1) 山地边塞。\n2) 山中地界。",{"a":1,"w":[45,10328]}],["山蛮","shānmán","旧指居住在山间的南方某些少数民族。",{"a":1,"w":[45,8711]}],["岱斗","dàidòu","泰山、北斗。比喻为众人所景仰的人。",{"a":1,"w":[12541,7477]}],["岳宗","yuèzōng","亦作“岳宗”。\n指五岳之中的嵩山。",{"a":1,"w":[8765,7624]}],["岳灵","yuèlíng","亦作“岳灵”。\n山岳的灵气、精气。",{"a":1,"w":[8765,7588]}],["峰牛","fēngniú","即封牛。一种颈上有肉块隆起的大牛。",{"a":1,"w":[8122,1346]}],["峻折","jùnzhé","1) 陡峭曲折。\n2) 严加斥责。",{"a":1,"w":[9365,2292]}],["峻整","jùnzhěng","1) 高峻整饬。\n2) 严肃庄重。",{"a":1,"w":[9365,1355]}],["崇壮","chóngzhuàng","1) 高大雄伟。\n2) 增高加大。",{"a":1,"w":[8311,8135]}],["崇宠","chóngchǒng","1) 尊崇宠信。\n2) 尊贵显耀。",{"a":1,"w":[8311,8782]}],["崇赫","chónghè","1) 高贵显赫。\n2) 高大显着。",{"a":1,"w":[8311,7566]}],["崎峗","qíwéi","1) 险峻貌。\n2) 指险峻的山。",{"a":1,"w":[10070]}],["崟岑","yíncén","1) 高耸。\n2) 指高耸的山峰。",{"a":1,"w":[30148,8832]}],["崩隤","bēngtuí","1) 崩裂倒塌。\n2) 形容陡峭。",{"a":1,"w":[8619,14945]}],["嵩京","sōngjīng","洛阳的别称。因嵩山在其东南，故称。",{"a":1,"w":[10447,7674]}],["嶕峣","jiāoyáo","1) 峻峭；高耸。\n2) 指高山。",{"a":1,"w":[182407,18882]}],["巡师","xúnshī","1) 宣示于军。\n2) 视察军队。",{"a":1,"w":[7981,7489]}],["巡拦","xúnlán","巡视稽察。亦指负责巡视稽察的差役。",{"a":1,"w":[7981,3529]}],["巡历","xúnlì","1) 巡行视察。\n2) 依次经历。",{"a":1,"w":[7981,7643]}],["巧捷","qiǎojié","1) 灵巧敏捷。\n2) 灵巧方便。",{"a":1,"w":[1421,7838]}],["巧饰","qiǎoshì","1) 工巧装饰。\n2) 诈伪粉饰。",{"a":1,"w":[1421,7951]}],["巨壮","jùzhuàng","1) 魁伟壮健。\n2) 粗大壮实。",{"a":1,"w":[7862,8135]}],["巨鹢","jùyì","大船的代称。古画鹢首于船头，故称。",{"a":1,"w":[7862,17157]}],["市死","shìsǐ","在闹市处死。指弃市，古代死刑之一。",{"a":1,"w":[555,1329]}],["市郭","shìguō","1) 城郭；城市。\n2) 犹市井。",{"a":1,"w":[555,8959]}],["布帊","bùpà","1) 布制的头巾。\n2) 布双幅。",{"a":1,"w":[1283,42386]}],["布絮","bùxù","1) 布和丝绵。\n2) 泛指棉衣。",{"a":1,"w":[1283,8894]}],["常沙","chángshā","佛教语。犹恒河沙数，形容数量极大。",{"a":1,"w":[99,7472]}],["币号","bìhào","古代作祭祀礼神用的玉帛等物的名称。",{"a":1,"w":[7943,78]}],["币余","bìyú","营造用料的剩余部分。币，通“敝”。",{"a":1,"w":[7943,7597]}],["幽密","yōumì","1) 秘密。\n2) 犹茂盛，茂密。",{"a":1,"w":[8098,2299]}],["幽扃","yōujiōng","1) 深锁的门户。\n2) 谓坟墓。",{"a":1,"w":[8098,15982]}],["幽折","yōuzhé","1) 幽深盘曲。\n2) 隐僻折拗。",{"a":1,"w":[8098,2292]}],["幽柔","yōuróu","1) 低微柔弱。\n2) 幽雅柔美。",{"a":1,"w":[8098,8134]}],["幽洁","yōujié","1) 雅静高洁。\n2) 幽雅清静。",{"a":1,"w":[8098,8263]}],["幽芬","yōufēn","1) 清香。\n2) 比喻盛德美名。",{"a":1,"w":[8098,8444]}],["幽蛰","yōuzhé","冬眠土中的虫类。喻草野或隐退之士。",{"a":1,"w":[8098,12784]}],["庇覆","bìfù","1) 掩盖；覆盖。\n2) 犹保护。",{"a":1,"w":[9114,7864]}],["府种","fǔzhǒng","浮肿。府，通“胕”。种，通“肿”。",{"a":1,"w":[7706,1344]}],["度宗","dùzōng","居尊位。指就天子位。度，同“宅”。",{"a":1,"w":[513,7624]}],["庸勋","yōngxūn","1) 酬赏有功的人。\n2) 功勋。",{"a":1,"w":[8352,8518]}],["庸昧","yōngmèi","谓资质愚钝，才识浅陋。常用作谦词。",{"a":1,"w":[8352,9075]}],["庸蔽","yōngbì","1) 犹庸暗。\n2) 谓庸鄙悖理。",{"a":1,"w":[8352,8083]}],["廉勇","liányǒng","1) 廉洁而果敢。\n2) 犹进退。",{"a":1,"w":[8138,8286]}],["廉监","liánjiān","即磏礛。磨玉的粗石。廉，通“磏”。",{"a":1,"w":[8138,7644]}],["廉角","liánjiǎo","1) 棱角。\n2) 喻方正的行为。",{"a":1,"w":[8138,533]}],["廉贾","liánjiǎ","指不贪眼前小利而谋长远厚利的商贾。",{"a":1,"w":[8138,8056]}],["厮禁","sījìn","1) 相缠磨。\n2) 谓牵缠于心。",{"a":1,"w":[9389,7708]}],["厂屋","chǎngwū","1) 棚舍。\n2) 无隔墙的房屋。",{"a":1,"w":[1401,3389]}],["废失","fèishī","1) 废弛缺失。\n2) 废弃衰亡。",{"a":1,"w":[7711,7527]}],["废斥","fèichì","1) 废黜屏斥。\n2) 荒芜废弃。",{"a":1,"w":[7711,8735]}],["废旷","fèikuàng","1) 荒废，不利用。\n2) 旷废。",{"a":1,"w":[7711,8662]}],["废籍","fèijí","1) 废员之名册。\n2) 指废员。",{"a":1,"w":[7711,7983]}],["延坐","yánzuò","1) 请坐。\n2) 受牵连而获罪。",{"a":1,"w":[7649,128]}]]