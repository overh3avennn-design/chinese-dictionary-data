358,8101]}],["仙居术","xiānjū shù","白术之一种。以产于浙江省仙居县得名。其根状茎，中医用以入药。",{"a":1,"w":[57000,7471]}],["伯通桥","bótōngqiáo","皋桥的别称。在今苏州市阊门内。相传汉皋伯通曾居此桥侧，故名。",{"a":1,"w":[7608,518,1435]}],["佛顶珠","fú dǐngzhū","1) 比喻懒散呆滞、推拨不动的人。\n2) 踢毽子的一种架式。",{"a":1,"w":[4682,80656]}],["来何暮","láihémù","本为东汉蜀郡百姓对太守廉范的颂辞，后用为赞扬地方官德政之典。",{"a":1,"w":[27,7627,8841]}],["做功德","zuògōng dé","1) 指请僧众诵经念佛以超度亡灵。\n2) 引申指说好话捧场。",{"a":1,"w":[64766,7416]}],["入草物","rùcǎowù","五代前蜀禁止珍奇之物出口，其粗劣之物入中原，谓之“入草物”。",{"a":1,"w":[4615,521,7412]}],["内文案","nèi wén'àn","旧社会在官署内签押房办公、与长官关系较密切、预闻机要的幕僚。",{"a":1,"w":[1287,46047]}],["内书房","nèi shūfáng","旧时富家宅院第二进院落的厢房。是主人读书起居和会见知交之所。",{"a":1,"w":[1287,6643]}],["半月泉","bànyuè quán","1) 泉名。在浙江绍兴县境。\n2) 泉名。在浙江省吴兴县境。",{"a":1,"w":[13469,3461]}],["同出身","tóng chūshēn","科举时代按照中式等第赐予的一种资历称号。在宋代为第四、五等。",{"a":1,"w":[4611,5427]}],["吴均体","wújūntǐ","南朝梁文学家吴均，文章清秀拔俗，时人或仿效之，称“吴均体”。",{"a":1,"w":[8110,7820,7417]}],["四不相","sìbù xiāng","即四不像。因形状奇特，在某些神话小说中被描写成有仙术的怪兽。",{"a":1,"w":[47489,7427]}],["四论宗","sìlùnzōng","佛教宗派名。指崇奉“四论”的一派。参见“四论”、“三论宗”。",{"a":1,"w":[86,7480,7624]}],["地行仙","dìxíngxiān","1) 原为佛典中所记的一种长寿的神仙。\n2) 比喻远行的人。",{"a":1,"w":[10,8,7740]}],["坑儒谷","kēngrú gǔ","秦始皇坑杀儒生之处。故址在今陕西临潼县城西南十公里之洪庆村。",{"a":1,"w":[35695,7701]}],["压酒囊","yājiǔ náng","宋时一些官吏额外支领作酿酒用的粮食。囊，指粮袋。亦泛指俸给。",{"a":1,"w":[180550,7777]}],["夔凤纹","kuífèngwén","古代青铜器上的夔凤形纹饰。也称夔凤。参阅《金石索‧夔凤豆》。",{"a":1,"w":[25779,1642793]}],["天童寺","tiāntóngsì","我国佛教“中华五山”之一，属禅宗。在浙江省宁波市东天童山上。",{"a":1,"w":[19,7929,4822]}],["娑罗笼","suōluó lóng","1) 木棉织品。\n2) 东南亚一带亦称圆筒长裙为“娑罗笼”。",{"a":1,"w":[30220,7956]}],["子云亭","ziyúntíng","在四川省绵阳县。相传为西汉学者扬雄读书处，扬雄字子云，故名。",{"a":1,"w":[1,554,8241]}],["小人儒","xiǎorénrú","指追求名望的儒者。一说指无远大见识，只追求眼前小功利的儒者。",{"a":1,"w":[9448,8257]}],["小挂千","xiǎoguàqiān","北京等地旧俗过春节时，店铺门前所粘有吉祥语的小红纸或小黄纸。",{"a":1,"w":[16,1393,587]}],["忘家狗","wàngjiāgǒu","《史记‧孔子世家》：“孔子适郑，与弟子相失，孔子独立郭东门。",{"a":1,"w":[206,28,171]}],["闷弓儿","mèn gōngr","1) 指声音不响亮、发射力不强的弓。\n2) 比喻猜不透的事。",{"a":1,"w":[8255,114538]}],["拆袜线","chāi wàxiàn","歇后语。袜子上拆下来的线，都是短的，用来讥讽人没有一点长处。",{"a":1,"w":[3473,283140]}],["挏马酒","dòng mǎjiǔ","马酪。因取马奶制成，故称“挏马”；因马酪味如酒，故称“酒”。",{"a":1,"w":[135846,275950]}],["扑索索","pū suǒsuǒ","1) 犹扑簌簌。泪水不断地下落貌。\n2) 犹扑簌簌。象声词。",{"a":1,"w":[4767,36713]}],["擅兴律","shàn xìnglǜ","我国古代关于处分未奉诏旨擅自发兵以及其他有关罪行的刑法条例。",{"a":1,"w":[9720,126834]}],["文官花","wénguān huā","1) 一种颜色屡变的花。又名弄色芙蓉。\n2) 锦带花的别名。",{"a":1,"w":[23357,20]}],["文溯阁","wénsùgé","清代专藏《四库全书》的书阁之一。在今辽宁省渖阳市清故宫之西。",{"a":1,"w":[7415,10662,8208]}],["方丈室","fāngzhàng shì","1) 一丈见方之室。极言室之狭小。\n2) 指寺院住持的居室。",{"a":1,"w":[75625,1359]}],["替戾冈","tìlìgāng","《晋书‧艺术传‧佛图澄》载：石勒将攻刘曜，群下咸谏以为不可。",{"a":1,"w":[2368,9083,8743]}],["月支藤","yuèzhī téng","葡萄的别称。葡萄原产于欧洲和亚洲西部，经西域传入中原，故称。",{"a":1,"w":[93500,7799]}],["望夫石","wàngfū shí","古迹名。各地多有，均属民间传说，谓妇人伫立望夫日久化而为石。",{"a":1,"w":[337346,7419]}],["柳仪曹","liǔ yícáo","唐柳宗元的别称。世称礼部郎官为仪曹，柳曾任礼部员外郎，故称。",{"a":1,"w":[7802,213044]}],["柴桑翁","cháisāng wēng","1) 指晋陶潜。因其晚年隐居柴桑，故称。\n2) 指晋刘遗民。",{"a":1,"w":[130636,8165]}],["梅花村","méihuā cūn","着名风景地。在广东省博罗县罗浮山飞云峰下。因梅树成林而得名。",{"a":1,"w":[5007,1430]}],["毛子檄","máozi xí","《后汉书‧刘平王望等传序》：“庐江毛义少节，家贫，以孝行称。",{"a":1,"w":[17309,12821]}],["水溜溜","shuǐliù liū","I\n形容水不停地往下滴的样子。\nII\n形容明亮而灵活的样子。",{"a":1,"w":[266249,4717]}],["永济渠","yǒngjì qú","隋大业四年(公元608年)为便利河北地区军事运输所开的运河。",{"a":1,"w":[186479,8761]}],["沙棠屐","shātáng jī","一种木屐。以沙棠木做底。底下一般有齿，便于践泥、踏雪及登山。",{"a":1,"w":[390701,17317]}],["洗心经","xǐxīn jīng","《易经》的代称。因《易‧系辞上》有“圣人以此洗心”句，故称。",{"a":1,"w":[47572,7421]}],["湛湛新","zhànzhàn xīn","清新。端木蕻良《早春》：“树林里真美呀，什麽都是湛湛新的。”",{"a":1,"w":[28786,80]}],["潘谷墨","pāngǔmò","宋时歙州人潘谷，制墨精妙，有墨仙之称，所制之墨称“潘谷墨”。",{"a":1,"w":[8658,7701,7667]}],["无比店","wúbǐ diàn","宋赵概致仕后，其官邸更为客邸，因其壮丽无比，时称“无比店”。",{"a":1,"w":[5942,675]}],["独松关","dúsōngguān","关名。在今浙江省余杭县西北独松岭上。关道险窄，旧为军事要地。",{"a":1,"w":[7561,2295,65]}],["献仙音","xiàn xiānyīn","词牌名。原为法曲之一种。有九十二字、九十一字、八十七字三体。",{"a":1,"w":[3435,136382]}],["玄坛菩","xuántán pú","“玄坛菩萨”的歇后语。歇后之“萨”与“杀”字音同。意谓杀掉。",{"a":1,"w":[245297,9769]}],["玉京山","yùjīng shān","1) 传说中元始天尊居住的仙山。\n2) 山名。在江西省北部。",{"a":1,"w":[90503,45]}],["甘州曲","gānzhōu qū","唐教坊曲名，后用为词牌。又名《甘州子》。单调三十三字，平韵。",{"a":1,"w":[335198,7517]}],["甘蔗棍","gānzhe gùn","即水火棍。旧时官厅仪仗之一。以涂红白或红黑相间的颜色，故名。",{"a":1,"w":[18063,8412]}],["生查子","shēngcházi","1) 唐教坊曲名。后用为词牌。\n2) 曲牌名。属南曲南吕宫。",{"a":1,"w":[508,601,1]}],["画眉府","huàméi fǔ","汉宣帝时，京兆尹张敞为妻画眉。后以“画眉府”代指京兆尹官署。",{"a":1,"w":[14846,7706]}],["白玉钩","báiyù gōu","1) 白玉制的帘钩。\n2) 白玉制的带钩。\n3) 喻指弯月。",{"a":1,"w":[14519,7696]}],["相斫书","xiāngzhuóshū","1) 记载战争的史书。多指《左传》。\n2) 指讲论兵法的书。",{"a":1,"w":[7427,11020,81]}],["禁宫花","jìngōng huā","药草王不留行的别称。见明李时珍《本草纲目‧草五‧王不留行》。",{"a":1,"w":[166774,20]}],["簸罗回","bǒluó huí","亦作“簸逻回”。\n1) 乐器名。即大角。\n2) 北魏歌曲名。",{"a":1,"w":[736752,79]}],["红芍药","hóng sháoyào","1) 词牌名。双调八十九字，仄韵。\n2) 曲牌名。属南吕调。",{"a":1,"w":[534,14430]}],["红点子","hóngdiǎn zi","清代官员委任状，在人名上要加朱点，后因称差使、官职为红点子。",{"a":1,"w":[18847,1]}],["缎疋库","duànpǐkù","清户部藏绸缎、绢布等物的库。见《清会典事例‧户部‧缎匹库》。",{"a":1,"w":[11199,20188,3332]}],["旧公烟","jiù gōngyān","指清末广东出产的“老公膏”，是用印度进口的鸦片烟熬成的烟膏。",{"a":1,"w":[1396,361857]}],["若耶溪","ruòyéxī","溪名。出浙江省绍兴市若耶山，北流入运河。相传为西施浣纱之所。",{"a":1,"w":[4652,7530,4874]}],["蛟女绢","jiāonǚjuàn","指唐时岭南所贡的生丝织物。蛟女，借指岭南妇女。蛟，通“鲛”。",{"a":1,"w":[14013,98,10923]}],["蟠桃宴","pántáo yàn","原指西王母在瑶池举行的蟠桃胜会。后借指庆祝宴会。多用于祝寿。",{"a":1,"w":[37570,8323]}],["词学科","cí xuékē","宋代科举名目之一。此科只试文辞，不贵记闻，与博学宏词科稍异。",{"a":1,"w":[596,3861]}],["语录体","yǔlù tǐ","用语录形式写成的作品。亦指模仿宋人《语录》的文白夹杂的文字。",{"a":1,"w":[21795,7417]}],["谁家子","shéijiā zi","1) 谁，何人。\n2) 犹言甚等样人；甚麽东西。带有轻蔑义。",{"a":1,"w":[54138,1]}],["护腊草","hùlàcǎo","草名。即乌拉草。产吉林、黑龙江一带，用以充垫皮靴中，可御寒。",{"a":1,"w":[4643,8052,521]}],["变大雅","biàndà yǎ","古人所谓六诗(大雅、小雅、正风、变风、变大雅、变小雅)之一。",{"a":1,"w":[135217,7788]}],["象牙牌","xiàngyá pái","南宋初，置节度使以下金字牙符，亦称象牙牌，以赐立战功的将帅。",{"a":1,"w":[11140,2344]}],["豹雾隐","bàowùyǐn","同“豹隐”。\n宋陆游《昼睡》诗：“静如豹雾隐，湛若珠藏渊。”",{"a":1,"w":[8732,3421,7652]}],["跑关东","pǎo guāndōng","旧社会里关内(多为山东一带)无法维持生活的农民逃到关外谋生。",{"a":1,"w":[166,14791]}],["踩钢索","cǎi gāngsuǒ","杂技名。走钢丝。演员在悬空的钢丝上来回走动，并表演各种动作。",{"a":1,"w":[3567,28886]}],["辰河戏","chénhéxì","戏曲剧种之一。流行于湖南沅江中游一带，该地区属古辰州，故名。",{"a":1,"w":[8629,585,3341]}],["透剑门","tòujiànmén","唐时军中杂技名。骑士迅速通过插有利刃之狭窄通道，而人马无伤。",{"a":1,"w":[2307,4730,53]}],["过君表","guòjūnbiǎo","古代五种驾驭车马的技术之一。指驾车经过天子表位时的致敬礼仪。",{"a":1,"w":[25,7831,536]}],["远乡牌","yuǎnxiāngpái","旧时客乡人的墓牌，牌上写明死者姓名履历，以备其家人前来认领。",{"a":1,"w":[103,3375,2344]}],["那里也","nàli yě","犹言哪里是、说什麽或说不上，常冠于所引成语、俗谚前，表否定。",{"a":1,"w":[435,123]}],["郭公砖","guōgōng zhuān","砖名。空心，以长而大者为贵。相传古代用作琴桌，琴声清泠可爱。",{"a":1,"w":[65468,4857]}],["重然灰","zhòngránhuī","《史记‧韩长孺列传》：“其后安国坐法抵罪，蒙狱吏田甲辱安国。",{"a":1,"w":[49,729702]}],["钗头凤","chāitóufèng","词牌名。本名《撷芳词》，因北宋徽宗政和间宫中有撷芳园，故名。",{"a":1,"w":[10709,509,7768]}],["银台司","yíntái sī","宋门下省所辖官署。掌管天下奏状案牍。司署设在银台门内，故名。",{"a":1,"w":[52457,7476]}],["激光气","jīguāng qì","化学气体元素“氡”的俗称。由镭衰变而成。医学上用以治疗癌症。",{"a":1,"w":[9044,510]}],["门外人","ménwài rén","1) 五代时，宦官专权，称百官为“门外人”。\n2) 门外汉。",{"a":1,"w":[25079,3]}],["开门钱","kāimén qián","旧俗迎娶新娘时，女方以开门放轿子入内的名义向男方索取的钱财。",{"a":1,"w":[13713,138]}],["降魔杵","xiángmó chǔ","佛教法器。佛寺中金刚塑像手执之杵。亦泛指古代的一种棒状武器。",{"a":1,"w":[100788,10054]}],["阳起山","yángqǐshān","山名。在山东齐州(今山东省济南市历城区)，因出阳起石而着名。",{"a":1,"w":[7484,29,45]}],["雷氏剑","léishìjiàn","传说三国吴未灭时，斗、牛二星之间常有紫气。及吴平，紫气愈明。",{"a":1,"w":[3319,7429,4730]}],["顺气丸","shùnqì wán","中成药丸。主治气闷不舒等症。亦比喻使人消气顺遂的话语或事情。",{"a":1,"w":[86410,4757]}],["顾山钱","gùshān qián","汉代妇女论罪后被遣还家，每月出钱雇人于山伐木，称“顾山钱”。",{"a":1,"w":[104069,138]}],["风月债","fēngyuè zhài","犹情债。指男女相恋产生的纠葛。旧谓男女相恋是前生欠债，故称。",{"a":1,"w":[14678,4698]}],["高丽伎","gāolí jì","隋时七部乐之一。采用高丽乐曲，配以十四种乐器，由十八人演奏。",{"a":1,"w":[16504,11385]}],["齿鸟类","chǐ niǎolèi","古代的鸟类，有牙齿，没有翅膀，脚很发达。化石多在白垩系发现。",{"a":1,"w":[7577,32422]}],["合谷穴","hégǔ xué","针灸穴位名。在手背第一、二掌骨间隙之中点处。主治头面部疾病。",{"a":1,"w":[138657,8147]}],["涂四杯","túsìbēi","国内应用最广泛的一种粘度杯, 按GB/T 1723-93设计",{"a":1,"w":[7866,86,199]}],["红擦树","hóngcāshù","Sextonia rubra ( Ocotea rubra)",{"a":1,"w":[534,2396,109]}],["氚设施","chuān shèshī","fuhtufn gj ghjbpdjlcnde nhbnbz",{"a":1,"w":[26493,2474]}],["乘法逆","chéngfǎ nì","multiplicative inverse (math.)",{"a":1,"w":[19004,7762]}],["催肥剂","cuīféi jì","(animal) fattening preparation",{"a":1,"w":[229135,7584]}],["兵器术","bīngqì shù","martial arts involving weapons",{"a":1,"w":[10772,7471]}],["创见性","ch