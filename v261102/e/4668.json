[["陷坎","xiànkǎn","I\n即陷阱。\nII\n即陷阱。",{"a":1,"w":[7914,8156]}],["陷击","xiànjī","I\n犹攻击。\nII\n犹攻击。",{"a":1,"w":[7914,7506]}],["陷机","xiànjī","I\n犹陷阱。\nII\n犹陷阱。",{"a":1,"w":[7914,7405]}],["陆谢","lùxiè","晋陆机和南朝宋谢灵运的并称。",{"a":1,"w":[7605,7570]}],["陆门","lùmén","陆地上的城门。对水城门而言。",{"a":1,"w":[7605,53]}],["阳夏","yángxià","指夏季。夏季阳气旺盛，故称。",{"a":1,"w":[7484,1397]}],["阳政","yángzhèng","指宫廷以外的政事，国内政事。",{"a":1,"w":[7484,7478]}],["隅楼","yúlóu","筑于城角的楼。多为了望之用。",{"a":1,"w":[9362,174]}],["隆冲","lóngchōng","临车与冲车。古代攻守战车名。",{"a":1,"w":[7876,2284]}],["隈枝","wēizhī","果木名。实似荔枝，味甘可食。",{"a":1,"w":[14037,4696]}],["隔并","gébìng","I\n犹隔并。\nII\n犹隔并。",{"a":1,"w":[2332,1377]}],["障累","zhànglèi","佛教语。谓恶业的妨碍和烦恼。",{"a":1,"w":[7656,173]}],["隐录","yǐnlù","谓从簿录上消失。指隐退不仕。",{"a":1,"w":[7652,1380]}],["隶楷","lìkǎi","字体名。带有隶书笔法的楷书。",{"a":1,"w":[8847,11853]}],["隶释","lìshì","谓用楷书录写隶字并加以解释。",{"a":1,"w":[8847,7824]}],["雄繁","xióngfán","指地位重要、任务繁杂的州郡。",{"a":1,"w":[7818,8553]}],["雄鬼","xióngguǐ","鬼雄。对为国牺牲战士的褒称。",{"a":1,"w":[7818,3340]}],["雄鸷","xióngzhì","凶猛的鸷鸟。比喻雄健，强悍。",{"a":1,"w":[7818,12445]}],["雅弦","yǎxián","亦作“雅弦”。\n指琴瑟之音。",{"a":1,"w":[7788,4726]}],["集德","jídé","成其德教。谓为君施德教于民。",{"a":1,"w":[4628,7416]}],["雉驯","zhìxùn","谓地方官施行仁政，泽及禽鸟。",{"a":1,"w":[9135,9709]}],["雌堂","cítáng","古时州一级地方长官听事之堂。",{"a":1,"w":[10657,7695]}],["雕卵","diāoluǎn","在蛋壳上雕刻花纹。形容奢侈。",{"a":1,"w":[8192,8378]}],["杂裳","záshang","古代下士穿的前黑后黄的下衣。",{"a":1,"w":[4680,9272]}],["杂话","záhuà","指胡乱编造的佳人才子的故事。",{"a":1,"w":[4680,120]}],["杂赋","záfù","旧时田赋以外的各种附加赋税。",{"a":1,"w":[4680,8218]}],["鸡招","jīzhāo","古代南方一种以鸡招魂的巫术。",{"a":1,"w":[578,4704]}],["离戎","líróng","古代我国西北地区的少数民族。",{"a":1,"w":[543,8500]}],["雪滩","xuětān","水中砂石堆。因呈白色，故称。",{"a":1,"w":[616,9232]}],["氛雺","fēnwù","昏暗污浊之气。喻世乱和灾祸。",{"a":1,"w":[9649,302028]}],["云摩","yúnmó","形容其多如云，一个接着一个。",{"a":1,"w":[554,7669]}],["云旝","yúnkuài","古代军中的一种发石攻城器械。",{"a":1,"w":[554,61119]}],["云潭","yúntán","温泉潭。上有蒸气如云，故称。",{"a":1,"w":[554,9794]}],["云卧","yúnwò","高卧于云雾缭绕之中。谓隐居。",{"a":1,"w":[554,7997]}],["云赴","yúnfù","如云奔赴。形容众人奋力前往。",{"a":1,"w":[554,8928]}],["云郊","yúnjiāo","云外，天外。比喻极远的地方。",{"a":1,"w":[554,9158]}],["云鼛","yúngāo","有云形图饰，悬在高处的大鼓。",{"a":1,"w":[554,94930]}],["雷觞","léishāng","刻有雷纹图饰的酒器。借指酒。",{"a":1,"w":[3319,10771]}],["雷訇","léihōng","隆隆的雷声。比喻巨大的声响。",{"a":1,"w":[3319,16185]}],["电策","diàncè","闪电。闪电之光如鞭形，故名。",{"a":1,"w":[12,7673]}],["电顷","diànqǐng","一闪电之间。比喻极短的时间。",{"a":1,"w":[12,9233]}],["霄见","xiāojiàn","犹言夜明如昼。霄，通“宵”。",{"a":1,"w":[9823,76]}],["霅氏","zhàshì","传说中上古孟舒国先主的姓氏。",{"a":1,"w":[28889,7429]}],["震赫","zhènhè","1) 显赫。\n2) 使震惊。",{"a":1,"w":[7751,7566]}],["霍人","huòrén","地名。在今山西省繁峙县东郊。",{"a":1,"w":[7805,3]}],["霜营","shuāngyíng","边塞的军营。边塞天寒，故称。",{"a":1,"w":[8258,7572]}],["霜籼","shuāngxiān","指籼米。其色雪白如霜，故称。",{"a":1,"w":[8258,51204]}],["霜群","shuāngqún","雁群。大雁群飞于霜天，故称。",{"a":1,"w":[8258,1348]}],["霜盖","shuānggài","傲霜挺立，树冠如车盖的松柏。",{"a":1,"w":[8258,2289]}],["霜鸦","shuāngyā","即乌鸦。乌鸦凶猛贪残，故称。",{"a":1,"w":[8258,8753]}],["霞床","xiáchuáng","华美的床。传说中仙人的寝具。",{"a":1,"w":[4805,183]}],["霞绷","xiábēng","清代吉林彩灯名。俗又称糠灯。",{"a":1,"w":[4805,8678]}],["霞缯","xiázēng","美艳的丝织物。亦以形容群花。",{"a":1,"w":[4805,18172]}],["露木","lùmù","指经受着风霜露雪考验的树木。",{"a":1,"w":[4674,7435]}],["露簟","lùdiàn","竹席。因其清凉如沾露，故称。",{"a":1,"w":[4674,25859]}],["靇靇","lónglóng","同“隆隆”。\n象声词。雷声。",{"a":1}],["灵君","língjūn","1) 指神灵。\n2) 指心。",{"a":1,"w":[7588,7831]}],["灵居","língjū","神仙住处；修道学仙者的住处。",{"a":1,"w":[7588,7611]}],["灵昧","língmèi","犹言贤、不肖。借指全体人民。",{"a":1,"w":[7588,9075]}],["灵畤","língzhì","即畤。古代祭祀天地五帝之处。",{"a":1,"w":[7588,39975]}],["灵鹊","língquè","即喜鹊。俗称鹊能报喜，故称。",{"a":1,"w":[7588,9090]}],["青墀","qīngchí","宫殿前的青色台阶。借指宫廷。",{"a":1,"w":[3320,29081]}],["青币","qīngbì","青帛。古代春祭时的献礼之一。",{"a":1,"w":[3320,7943]}],["青榜","qīngbǎng","青黑色的匾额。借指官府衙门。",{"a":1,"w":[3320,8885]}],["青狼","qīngláng","指天狼星。喻凶残贪狠的朝臣。",{"a":1,"w":[3320,7960]}],["青筐","qīngkuāng","1) 竹筐。\n2) 指蟹壳。",{"a":1,"w":[3320,5162]}],["青缟","qīnggǎo","青色和白色。代表东方和西方。",{"a":1,"w":[3320,12506]}],["青雾","qīngwù","雾气，烟雾。雾色如紫，故称。",{"a":1,"w":[3320,3421]}],["青鵽","qīngduò","青色的鵽鸠。传说中忘母之鸟。",{"a":1,"w":[3320,82279]}],["静业","jìngyè","佛教语。即净业。清净的善业。",{"a":1,"w":[1386,7418]}],["非唯","fēiwéi","亦作“非惟”。\n不只；不仅。",{"a":1,"w":[2265,8212]}],["面禳","miànráng","谓向四方祈祷，以求消除殃祸。",{"a":1,"w":[523,15582]}],["面谏","miànjiàn","当面直言规劝。常用于臣对君。",{"a":1,"w":[523,9148]}],["巩卫","gǒngwèi","环绕、护卫。巩，用同“拱”。",{"a":1,"w":[10420,7546]}],["鞬辀","jiānzhōu","谓束住车辕，使车子停止前进。",{"a":1,"w":[21370,37367]}],["鞭行","biānxíng","竹根在地下延伸生长，谓鞭行。",{"a":1,"w":[8162,8]}],["鞭辔","biānpèi","鞭子和马笼头。借指随从效力。",{"a":1,"w":[8162,13007]}],["鞭靮","biāndí","鞭子和马缰绳。借指随从效力。",{"a":1,"w":[8162,151619]}],["缰系","jiāngxì","系马的缰绳。比喻拘束，束缚。",{"a":1,"w":[20306,1277]}],["缰锁","jiāngsuǒ","缰绳和锁链。比喻束缚，拘束。",{"a":1,"w":[20306,3368]}],["鞑妖","dáyāo","太平天国对清朝统治者的蔑称。",{"a":1,"w":[16971,8617]}],["韦絮","wéixù","裹着在车轮外缘的皮革和丝绵。",{"a":1,"w":[7839,8894]}],["韩岳","hányuè","南宋名将韩世忠和岳飞的并称。",{"a":1,"w":[8332,8765]}],["韩欧","hán'ōu","唐代韩愈和宋代欧阳修的并称。",{"a":1,"w":[8332,7621]}],["韬霞","tāoxiá","掩盖霞光。谓失去彩色的光芒。",{"a":1,"w":[11243,4805]}],["韬鳞","tāolín","鱼潜于深水。比喻人隐退深藏。",{"a":1,"w":[11243,7924]}],["顶指","dǐngzhǐ","做针线活时戴在手指上的工具。",{"a":1,"w":[2298,1312]}],["顶收","dǐngshōu","后任官吏代偿的前任所欠公款。",{"a":1,"w":[2298,541]}],["项珠","xiàngzhū","挂于颈项的珠串。多用作项饰。",{"a":1,"w":[2342,7784]}],["顺孝","shùnxiào","尽心奉养父母，顺从父母意志。",{"a":1,"w":[4660,8298]}],["顽家","wánjiā","方言。指土娼。顽，通“玩”。",{"a":1,"w":[8595,28]}],["领直","lǐngzhí","古代宫禁中统领值宿卫士之官。",{"a":1,"w":[1361,1294]}],["头锣","tóuluó","古时仪仗队中，列于首位之锣。",{"a":1,"w":[509,11422]}],["颗恰","kēqià","谓安详稳重。颗，用同“款”。",{"a":1,"w":[3582,8243]}],["额编","ébiān","谓按额定的数字编制(册子)。",{"a":1,"w":[7720,2326]}],["颜采","yáncǎi","1) 容貌。\n2) 指面子。",{"a":1,"w":[8117,7528]}],["颜钩","yángōu","唐颜杲卿，玄宗时为常山太守。",{"a":1,"w":[8117,7696]}],["颜颜","yányán","1) 虚饰貌。\n2) 高貌。",{"a":1,"w":[8117]}],["颛事","zhuānshì","擅自处理事情。颛，通“专”。",{"a":1,"w":[11459,33]}],["颛美","zhuānměi","独自享受美名。颛，通“专”。",{"a":1,"w":[11459,1310]}],["愿王","yuànwáng","谓许愿的对象。指上帝、神仙。",{"a":1,"w":[3393,2278]}],["颠童","diāntóng","形容老人头发稀少。童，秃发。",{"a":1,"w":[8660,7929]}],["类叙","lèixù","谓按人或事物的性质比类叙事。",{"a":1,"w":[1323,8462]}],["顾笔","gùbǐ","指晋代画家顾恺之的绘画技法。",{"a":1,"w":[4700,619]}],["显相",