6,7868]}],["桑叉","sāngchā","以桑木做的叉。古代祭祀用品。",{"a":1,"w":[8026,3369]}],["梁坏","liánghuài","梁栋倾坏。比喻有为之人死亡。",{"a":1,"w":[7890,163]}],["梁岷","liángmín","梁山与岷山的并称。代指蜀地。",{"a":1,"w":[7890,15066]}],["梁摧","liángcuī","梁栋摧折。比喻有为之人死去。",{"a":1,"w":[7890,9210]}],["梁桷","liángjué","泛指房屋的梁与椽。桷，椽子。",{"a":1,"w":[7890,18906]}],["梃杻","tǐngchǒu","泛指刑具。梃，杖；杻，手铐。",{"a":1,"w":[14562,25376]}],["梅首","méishǒu","鱼名。即梅童。参见“梅童”。",{"a":1,"w":[7563,2310]}],["梗强","gěngqiáng","强横凶暴。亦指强横凶暴的人。",{"a":1,"w":[8222,1314]}],["条议","tiáoyì","指分条陈述意见的奏疏或文书。",{"a":1,"w":[556,7521]}],["枭黠","xiāoxiá","凶恶狡猾。亦指凶恶狡猾的人。",{"a":1,"w":[10374,14601]}],["梢当","shāodāng","制作碗碟盘等漆器的一道工序。",{"a":1,"w":[4867,552]}],["梵乐","fànlè","指佛教音乐，包括佛曲呗赞等。",{"a":1,"w":[9152,1340]}],["梵释","fànshì","指色界诸天王及欲界帝释天王。",{"a":1,"w":[9152,7824]}],["梵铃","fànlíng","佛寺或佛塔檐角上所悬的铃铎。",{"a":1,"w":[9152,3441]}],["弃外","qìwài","谓弃置朝外。外，指京畿以外。",{"a":1,"w":[7931,36]}],["棋仙","qíxiān","指棋艺高超、以弈棋为乐的人。",{"a":1,"w":[8184,7740]}],["棋博","qíbó","犹博弈。棋，围棋；博，六博。",{"a":1,"w":[8184,7502]}],["棐几","fěijǐ","用棐木做的几桌。亦泛指几桌。",{"a":1,"w":[49113,136]}],["棐德","fěidé","指不道德的事。棐，同“非”。",{"a":1,"w":[49113,7416]}],["棐谌","fěichén","同“棐忱”。\n谌，通“忱”。",{"a":1,"w":[49113,38658]}],["棒香","bàngxiāng","用细竹棍或细木棍做芯子的香。",{"a":1,"w":[2361,1311]}],["枣圈","zǎoquān","枣脯的一种。其形如圈，故称。",{"a":1,"w":[8507,2325]}],["枣糗","zǎoqiǔ","枣子和糗。古时用为祭供之品。",{"a":1,"w":[8507,12460]}],["棘荆","jíjīng","荆棘。泛指丛生的带刺小灌木。",{"a":1,"w":[7772,8436]}],["棚民","péngmín","指清代在山上搭棚居住的流民。",{"a":1,"w":[8961,7434]}],["栈师","zhànshī","旧称店堂、仓库里工作的职员。",{"a":1,"w":[9542,7489]}],["栖寄","qījì","亦作“栖寄”。\n安身，寄住。",{"a":1,"w":[8477,2358]}],["栖翔","qīxiáng","亦作“栖翔”。\n止息与飞翔。",{"a":1,"w":[8477,8986]}],["栖翼","qīyì","亦作“栖翼”。\n指安身之处。",{"a":1,"w":[8477,4645]}],["栖诚","qīchéng","亦作“栖诚”。\n谓寄托心志。",{"a":1,"w":[8477,8307]}],["栖鵀","qīrén","后因以“栖鵀”谓死亡的预兆。",{"a":1,"w":[8477,150957]}],["椎车","chuíchē","用整块圆木做车轮的简陋车子。",{"a":1,"w":[8683,32]}],["椒室","jiāoshì","后妃的居室。亦为后妃的代称。",{"a":1,"w":[8036,1359]}],["椰玉","yēyù","即椰子瓤。因其色洁白，故称。",{"a":1,"w":[8740,2294]}],["楚南","chǔnán","南楚。因楚在中原之南，故称。",{"a":1,"w":[7905,90]}],["楚庙","chǔmiào","指楚人奉祀祖宗和神明的庙舍。",{"a":1,"w":[7905,8514]}],["楚思","chǔsī","对故土楚地的情思。泛指乡思。",{"a":1,"w":[7905,7586]}],["楚杌","chǔwù","指春秋时楚国的史书《檮杌》。",{"a":1,"w":[7905,17922]}],["业次","yècì","1) 犹生业。\n2) 次序。",{"a":1,"w":[7418,102]}],["概准","gàizhǔn","用平物的量器刮平。极言其平。",{"a":1,"w":[8010,1315]}],["榆景","yújǐng","“桑榆晚景”之省。比喻晚年。",{"a":1,"w":[8831,4676]}],["榜运","bǎngyùn","指科考每榜人才的际遇、机运。",{"a":1,"w":[8885,3313]}],["构巢","gòucháo","构木为巢。远古人的居住方式。",{"a":1,"w":[7540,8435]}],["构赏","gòushǎng","犹奖赏，赏赐。构，通“购”。",{"a":1,"w":[7540,2415]}],["构云","gòuyún","连结云天。形容建筑物等极高。",{"a":1,"w":[7540,554]}],["乐衎","lèkàn","和乐。谓和睦欢乐或平和安适。",{"a":1,"w":[1340,20106]}],["樊鹿","fánlù","樊篱中的鹿。比喻失去自由者。",{"a":1,"w":[12033,8199]}],["标取","biāoqǔ","1) 斩取。\n2) 犹传取。",{"a":1,"w":[7449,580]}],["模勒","mólēi","仿照原样雕刻。亦指雕刻之文。",{"a":1,"w":[7602,7571]}],["树善","shùshàn","1) 结好。\n2) 犹行善。",{"a":1,"w":[109,7657]}],["树萱","shùxuān","种植萱草。萱草，俗名忘忧草。",{"a":1,"w":[109,11192]}],["樽斝","zūnjiǎ","泛指酒器。樽与斝均盛酒之器。",{"a":1,"w":[10450,50889]}],["机岳","jīyuè","晋代文学家陆机和潘岳的并称。",{"a":1,"w":[7405,8765]}],["横金","héngjīn","宋代标识官阶高低的一种佩戴。",{"a":1,"w":[4653,1270]}],["檀注","tánzhù","指胭脂、唇膏一类的化妆用品。",{"a":1,"w":[8676,7606]}],["栊枞","lóngcōng","古代攻守通用之器。或云木弩。",{"a":1,"w":[20496,12298]}],["次躔","cìchán","犹躔次。日月星辰运行的度次。",{"a":1,"w":[102,20339]}],["钦产","qīnchǎn","原指皇产，后亦指钦赐的产业。",{"a":1,"w":[8077,7441]}],["歇和","xiēhé","谓声音相和。亦谓行动相配合。",{"a":1,"w":[3462,39]}],["歌章","gēzhāng","歌曲。音乐一曲为一章，故称。",{"a":1,"w":[208,4661]}],["正棺","zhèngguān","将死人小敛之后，移放到堂上。",{"a":1,"w":[62,9589]}],["正田","zhèngtián","宋时“良农”自耕的五十亩田。",{"a":1,"w":[62,4668]}],["正赈","zhèngzhèn","旧时指用国库钱、粮救济灾民。",{"a":1,"w":[62,11273]}],["武干","wǔgàn","亦作“武干”。\n指军事才干。",{"a":1,"w":[7504,46]}],["武落","wǔluò","虎落。遮护城堡或营寨的竹篱。",{"a":1,"w":[7504,2275]}],["武貔","wǔpí","即虎貔。泛指猛兽，借指武士。",{"a":1,"w":[7504,40250]}],["岁仗","suìzhàng","谓每年元旦朝会时所用的仪仗。",{"a":1,"w":[195,8596]}],["岁殖","suìzhí","年产值。殖，通“直”，价值。",{"a":1,"w":[195,8073]}],["岁钥","suìyào","犹岁月。龠，指候气用的葭琯。",{"a":1,"w":[195,9086]}],["历碌","lìlù","1) 车轮声。\n2) 指车。",{"a":1,"w":[7643,9961]}],["历说","lìshuō","I\n一一陈述。\nII\n游说。",{"a":1,"w":[7643,68]}],["归全","guīquán","谓善终。不遭灾难，终其天年。",{"a":1,"w":[2317,531]}],["归孙","guīsūn","女子称侄子的儿子为“归孙”。",{"a":1,"w":[2317,7936]}],["归业","guīyè","回复原来的正业。主要指农业。",{"a":1,"w":[2317,7418]}],["归第","guīdì","1) 回家。\n2) 谓禁闭。",{"a":1,"w":[2317,125]}],["归处","guīchù","I\n归依。\nII\n归依之处。",{"a":1,"w":[2317,2272]}],["归鸿","guīhóng","归雁。诗文中多用以寄托归思。",{"a":1,"w":[2317,8788]}],["死籍","sǐjí","迷信谓阴司登录人死期的册籍。",{"a":1,"w":[1329,7983]}],["残机","cánjī","残剩着没有完成的织物的织机。",{"a":1,"w":[7814,7405]}],["残烧","cánshāo","1) 余烬。\n2) 指晚霞。",{"a":1,"w":[7814,2303]}],["殷柽","yīnchēng","河柳。茎呈赤黑色，又称赤柳。",{"a":1,"w":[8511,14553]}],["杀剁","shāduò","犹言该杀的，该死。叹息之词。",{"a":1,"w":[3331,13973]}],["毁慕","huǐmù","指居丧因慕念其亲而形容憔悴。",{"a":1,"w":[4749,8745]}],["毒疠","dúlì","导致疫病之毒气。疠，指疫气。",{"a":1,"w":[3322,12669]}],["毚鼎","chándǐng","鼎名。即春秋时鲁国所铸谗鼎。",{"a":1,"w":[28987,8230]}],["毛罽","máojì","毛毡。亦指毛毡制成的衣、靴。",{"a":1,"w":[70,25509]}],["民溃","mínkuì","旧时统治者对人民暴动的诬称。",{"a":1,"w":[7434,8651]}],["氛沴","fēnlì","1) 毒气。\n2) 喻寇乱。",{"a":1,"w":[9649,19178]}]]