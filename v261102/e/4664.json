[["庸凡","yōngfán","1) 平凡。\n2) 指庸俗。",{"a":1,"w":[8352,8150]}],["庸韦","yōngwéi","同“庸违”。\n韦，通“违”。",{"a":1,"w":[8352,7839]}],["庸音","yōngyīn","常音。喻指平庸的文辞和言论。",{"a":1,"w":[8352,7498]}],["廉空","liánkōng","查看有无缺少。廉，通“覝”。",{"a":1,"w":[8138,1274]}],["廉简","liánjiǎn","清廉简约。指不苟取，不扰民。",{"a":1,"w":[8138,7804]}],["廉肉","liánròu","指乐声的高亢激越与婉转圆润。",{"a":1,"w":[8138,116]}],["廉芒","liánmáng","犹锋芒。比喻刚直不挠之禀性。",{"a":1,"w":[8138,8347]}],["廉镇","liánzhèn","观察使的别称。廉，通“覝”。",{"a":1,"w":[8138,4701]}],["廖亮","liàoliàng","同“寥亮”。\n声音清晰响亮。",{"a":1,"w":[9456,641]}],["庙乐","miàolè","宗庙音乐。多用于祭祀或颂德。",{"a":1,"w":[8514,1340]}],["废彻","fèichè","1) 犹废去。\n2) 损毁。",{"a":1,"w":[7711,8591]}],["废阙","fèiquē","1) 指缺漏。\n2) 丧失。",{"a":1,"w":[7711,8773]}],["廨钱","xièqián","隋初官府用以放债收息的公款。",{"a":1,"w":[26657,138]}],["廪台","lǐntái","即鹿台。相传为商纣王自杀处。",{"a":1,"w":[9825,1306]}],["延喘","yánchuǎn","延长气息。比喻暂时维持生存。",{"a":1,"w":[7649,9101]}],["建疵","jiàncī","相传为有娀氏少女，帝喾之妃。",{"a":1,"w":[1345,10139]}],["弊蹻","bìjuē","破旧的草鞋。喻极无价值之物。",{"a":1,"w":[8552,13572]}],["弓胶","gōngjiāo","制弓六材之一。用以黏合弓干。",{"a":1,"w":[8097,7702]}],["引耳","yǐn'ěr","竖着耳朵。形容心神专注地听。",{"a":1,"w":[2281,7509]}],["张焰","zhāngyàn","(张zhāng)张大其气焰。",{"a":1,"w":[1333,8874]}],["弹文","dànwén","文体名。弹劾官员过错的奏疏。",{"a":1,"w":[3318,7415]}],["弹唇","dànchún","鼓唇动舌。指喋喋不休地说话。",{"a":1,"w":[3318,8248]}],["形况","xíngkuàng","1) 情况。\n2) 犹形容。",{"a":1,"w":[4612,7889]}],["彤壶","tónghú","朱漆漏壶。古代计时器的一种。",{"a":1,"w":[12059,3500]}],["彦圣","yànshèng","善美明达。亦指善美明达之士。",{"a":1,"w":[10735,7587]}],["彩艳","cǎiyàn","1) 绚丽。\n2) 指文采。",{"a":1,"w":[7795,8710]}],["征桡","zhēngráo","指远行的船。桡，桨，借指船。",{"a":1,"w":[7581,10333]}],["征鞭","zhēngbiān","马鞭。因用其驱马行进，故称。",{"a":1,"w":[7581,8162]}],["徂颜","cúyán","往日的容颜。谓年轻时的容颜。",{"a":1,"w":[13473,8117]}],["徇利","xùnlì","不惜身以求利。徇，通“殉”。",{"a":1,"w":[9647,4606]}],["徇质","xùnzhì","犹委质。出仕。质，通“贽”。",{"a":1,"w":[9647,7436]}],["律坐","lǜzuò","亦作“律座”。\n见“律座”。",{"a":1,"w":[7544,128]}],["后儒","hòurú","后世的儒者。亦以指二程朱子。",{"a":1,"w":[43,8257]}],["徐庾","xúyǔ","南朝陈徐陵和北周庾信的并称。",{"a":1,"w":[8626,15859]}],["从彝","cóngyí","古代祭器名。形近于鼎，故称。",{"a":1,"w":[124,9828]}],["御寨","yùzhài","帝王亲征或出巡时驻跸的营寨。",{"a":1,"w":[7809,9753]}],["复宇","fùyǔ","指层层的屋宇。复，通“复”。",{"a":1,"w":[7461,7949]}],["微磬","wēiqìng","谓上身稍向前倾折，表示恭敬。",{"a":1,"w":[7512,11487]}],["微陋","wēilòu","卑微鄙陋。亦指卑微鄙陋之人。",{"a":1,"w":[7512,9064]}],["微鲜","wēixiān","I\n精妙鲜明。\nII\n微少。",{"a":1,"w":[7512,2339]}],["征纳","zhēngnà","1) 召用。\n2) 犹征收。",{"a":1,"w":[7581,7454]}],["彻俎","chèzǔ","谓撤去祭祀时用以载牲的礼器。",{"a":1,"w":[8591,12968]}],["心号","xīnhào","古时战士所着戎衣胸背的符号。",{"a":1,"w":[1279,78]}],["忙身","mángshēn","事务繁忙的人。常用以称自己。",{"a":1,"w":[204,7456]}],["忠效","zhōngxiào","尽忠效力。亦指尽忠效力之人。",{"a":1,"w":[8280,7590]}],["忠智","zhōngzhì","忠诚而有才智。亦指忠智之人。",{"a":1,"w":[8280,7798]}],["念词","niàncí","指戏剧演出中的念台词或道白。",{"a":1,"w":[1422,596]}],["忽板","hūbǎn","旧时对出入妓院的清客的别称。",{"a":1,"w":[8123,1305]}],["急夫","jífū","旧称因工事急迫而调发的役夫。",{"a":1,"w":[569,7409]}],["恩庆","ēnqìng","谓帝王遇庆典时对臣下的封赏。",{"a":1,"w":[7704,8113]}],["悍顽","hànwán","凶暴顽劣。亦指凶暴顽劣的人。",{"a":1,"w":[9593,8595]}],["悼伤","dàoshāng","1) 哀伤。\n2) 犹悼亡。",{"a":1,"w":[11178,1358]}],["恶弱","èruò","1) 粗劣。\n2) 不吉利。",{"a":1,"w":[7620,2376]}],["愁损","chóusǔn","1) 忧伤。\n2) 犹愁杀。",{"a":1,"w":[3481,7604]}],["愁苗","chóumiáo","比喻白发。谓因愁而生，故称。",{"a":1,"w":[3481,7980]}],["愁鬓","chóubìn","发白的鬓发。因愁而白，故称。",{"a":1,"w":[3481,10863]}],["愆弊","qiānbì","指朝廷在政治上的过失与流弊。",{"a":1,"w":[10996,8552]}],["愎鸷","bìzhì","强悍凶狠。亦指强悍凶狠的人。",{"a":1,"w":[19765,12445]}],["愕梦","èmèng","惊愕而梦。后指可怖不祥之梦。",{"a":1,"w":[15755,2386]}],["愚傻","yúshǎ","1) 愚蠢。\n2) 痴呆貌。",{"a":1,"w":[8545,3522]}],["愚管","yúguǎn","浅陋；浅陋的见解。自谦之词。",{"a":1,"w":[8545,1278]}],["惬适","qièshì","1) 犹闲适。\n2) 舒服。",{"a":1,"w":[20907,7671]}],["慈念","cíniàn","出于慈爱的关心；慈爱的念头。",{"a":1,"w":[8234,1422]}],["慈恤","cíxù","仁慈顾惜。亦指仁慈怜悯之心。",{"a":1,"w":[8234,8783]}],["慌迫","huāngpò","1) 急迫。\n2) 犹焦急。",{"a":1,"w":[3488,8059]}],["慰吊","wèidiào","对遭遇丧灾之事的人表示慰问。",{"a":1,"w":[9360,4693]}],["宪量","xiànliàng","东汉黄宪，字叔度，器度宏大。",{"a":1,"w":[8343,2263]}],["应敕","yīngchì","在帝王左右侍候传达旨意的人。",{"a":1,"w":[2264,9734]}],["怀书","huáishū","指游说之士怀带书策进行干谒。",{"a":1,"w":[7749,81]}],["怀玺","huáixǐ","谓隐藏君主身份。玺，天子印。",{"a":1,"w":[7749,11285]}],["悬权","xuánquán","悬挂秤砣。比喻衡量利害得失。",{"a":1,"w":[4694,4623]}],["悬流","xuánliú","从高处下注的水流。多指瀑布。",{"a":1,"w":[4694,519]}],["戒敕","jièchì","1) 告戒。\n2) 即戒书。",{"a":1,"w":[3377,9734]}],["戒规","jièguī","宗教内部禁止某些行为的条规。",{"a":1,"w":[3377,7549]}],["或诸","huòzhū","犹或者。表示选择或并列关系。",{"a":1,"w":[664,7881]}],["戛玉","jiáyù","敲击玉片。形容声音清脆悦耳。",{"a":1,"w":[11712,2294]}],["战棚","zhànpéng","古代城墙上防守用的活动棚屋。",{"a":1,"w":[7438,8961]}],["戴鳻","dàibān","鸟名。即戴胜。参见“戴胜”。",{"a":1,"w":[2394,79191]}],["户豹","hùbào","豹之有文彩者。户，通“昈”。",{"a":1,"w":[2320,8732]}],["戽鱼","hùyú","戽干水沟或河塘里的水以取鱼。",{"a":1,"w":[19981,526]}],["戾园","lìyuán","戾太子的陵园。亦借指戾太子。",{"a":1,"w":[9083,4715]}],["戾契","lìqì","头不正貌。比喻奇邪不正之行。",{"a":1,"w":[9083,8094]}],["房杜","fángdù","唐名相房玄龄、杜如晦的并称。",{"a":1,"w":[7555,7680]}],["房陵","fánglíng","古地名。在今湖北省房县境内。",{"a":1,"w":[7555,7966]}],["手灵","shǒulíng","手指灵巧。谓做事细致而快速。",{"a":1,"w":[34,7588]}],["打谈","dǎtán","宋元时代称在街市演唱或说书。",{"a":1,"w":[66,1427]}],["扮桶","bàntǒng","打稻用的方形木桶，上大下小。",{"a":1,"w":[9019,8593]}],["扳位","bānwèi","打牌时用骰子等计数排定坐位。",{"a":1,"w":[8561,545]}],["承流","chéngliú","谓接受和继承良好的风尚传统。",{"a":1,"w":[7576,519]}],["抃蹈","biàndǎo","手舞足蹈。形容欢欣感激之状。",{"a":1,"w":[49028,8509]}],["抃跃","biànyuè","犹言手舞足蹈。表示欢欣鼓舞。",{"a":1,"w":[49028,8534]}],["把拱","bǎgǒng","尚未成材的树木。喻小的才能。",{"a":1,"w":[1321,8219]}],["折乏","zhéfá","1) 贫乏。\n2) 犹折罚。",{"a":1,"w":[2292,8129]}],["披檐","pīyán","正屋屋檐下搭建的附属建筑物。",{"a":1,"w":[3456,9322]}],["抬盘","táipán","犹桌面。多用以喻正式的场面。",{"a":1,"w":[2463,2285]}],["抱锣","bàoluó","宋代一种以大铜锣伴身的乐舞。",{"a":1,"w":[2374,11422]}],["拊床","fǔchuáng","拍床，捶床。表示奋起或悲痛。",{"a":1,"w":[11862,183]}],["抛废","pāofèi","1) 荒废。\n2) 犹抛荒。",{"a":1,"w":[8247,7711]}],["拍天","pāitiān","形容浪涛汹涌冲击，气势浩大。",{"a":1,"w":[1418,19]}],["拐仙","guǎixiān","传说中八仙之一铁拐李的别称。",{"a":1,"w":[4808,7740]}],["拓手","tuòshǒu","摹印石碑上文字、图画的技艺。",{"a":1,"w":[8911,34]}],["拔济","bájì","佛教语。犹济度。亦泛指拯救。",{"a":1,"w":[3360,7522]}],["拘弭","jūmǐ","即拘弥。古代西域诸城国之一。",{"a":1,"w":[8339,11160]}],["拫隔","héngé","谓排挤阻塞，使下情不能上达。",{"a":1,"w":[83454,2332]}],["拳握","quánwò","像握着的拳头大小。喻体积小。",{"a":1,"w":[8107,3463]}],["持颐","chíyí","以手托腮。形容神态专注安详。",{"a":1,"w":[7617,9868]}],["指月","zhǐyuè","佛教语。以指譬教，以月比法。",{"a":1,"w":[1312,101]}],["挑补","tiāobǔ","I\n挖补。\nII\n挑选补官。",{"a":1,"w":[2390,1363]}],["挼莎","ruáshā","亦作“挼挲”。\n揉搓，搓摩。",{"a":1,"w":[18996,8622]}],["捧拥","pěngyōng","1) 簇拥。\n2) 犹尊奉。",{"a":1,"w":[4934,8340]}],["舍拚","shěpàn","1) 舍弃。\n2) 豁出去。",{"a":1,"w":[7531,11580]}],["捷急","jiéjí","1) 捷给。\n2) 犹应急。",{"a":1,"w":[7838,569]}],["掇子","duōzi","竹兜子。旧时竹制的抬人工具。",{"a":1,"w":[10915,1]}],["掇醍","duōtí","得到醍醐灌顶。谓受教而觉悟。",{"a":1,"w":[10915,47892]}],["采听","cǎitīng","1) 探听。\n2) 犹采纳。",{"a":1,"w":[7528,146]}],["掩笑","yǎnxiào","掩口而笑；要笑而忍住不出声。",{"a":1,"w":[8167,185]}],["掩郁","yǎnyù","1) 不明貌。\n2) 隐匿。",{"a":1,"w":[8167,8084]}],["掾曹","yuàncáo","犹掾史。古代分曹治事，故称。",{"a":1,"w":[27955,8358]}],["拣罢","jiǎnbà","经挑选不合格的军士令其退伍。",{"a":1,"w":[5240,8239]}],["扬播","yángbō","1) 犹摇动。\n2) 吹拂。",{"a":1,"w":[7578,4713]}],["扬班","yángbān","汉代文学家扬雄和班固的并称。",{"a":1,"w":[7578,135]}],["换景","huànjǐng","戏剧演出中更换舞台上的场景。",{"a":1,"w":[599,4676]}],["换职","huànzhí","指翰林补外官改换京官的官衔。",{"a":1,"w":[599,7609]}],["损瘠","sǔnjí","消瘦羸弱。亦指消瘦羸弱的人。",{"a":1,"w":[7604,11234]}],["损短","sǔnduǎn","1) 减短。\n2) 犹毁谤。",{"a":1,"w":[7604,577]}],["抟泥","tuánní","捏弄泥团，以为器皿。喻粗陋。",{"a":1,"w":[12425,4651]}],["摽蕝","biāojué","植标以示其事。摽，通“标”。",{"a":1,"w":[11227,97083]}],["摽采","biāocǎi","标明条件选拔。摽，通“标”。",{"a":1,"w":[11227,7528]}],["撒脱","sātuō","1) 洒脱。\n2) 犹快意。",{"a":1,"w":[7915,2312]}],["掸尘","dǎnchén","1) 洗尘。\n2) 大扫除。",{"a":1,"w":[12529,7843]}],["拨剔","bōtī","1) 剔除。\n2) 犹拨冗。",{"a":1,"w":[4720,9422]}],["撰修","zhuànxiū","亦作“撰修”。\n书写；编撰。",{"a":1,"w":[9802,1339]}],["扑膘","pūbiāo","谓春天熊罴膘痒，登高木自坠。",{"a":1,"w":[4767,15724]}],["撼雷","hànléi","旧时一种决定献艺次序的方法。",{"a":1,"w":[12614,3319]}],["击咎","jījiù","古代称土星散变后的天体之一。",{"a":1,"w":[7506,9750]}],["操割","cāogē","执刀而割。比喻出仕处理政事。",{"a":1,"w":[7592,4723]}],["操剸","cāotuán","操刀细割。比喻认真处理政事。",{"a":1,"w":[7592,28706]}],["操执","cāozhí","1) 犹任事。\n2) 操守。",{"a":1,"w":[7592,7826]}],["擘李","bāilǐ","水果名。李的一种。熟则自裂。",{"a":1,"w":[12672,7880]}],["摈迹","bìnjì","息影，不露面。谓被排斥不用。",{"a":1,"w":[16853,8080]}],["掷丸","zhìwán","辽俗，于正旦抛掷饼团以惊鬼。",{"a":1,"w":[8819,4757]}],["攀愁","pānchóu","指离愁。古以折柳送别，故称。",{"a":1,"w":[8491,3481]}],["携角","xiéjiǎo","古音律名。姑洗三十四律之一。",{"a":1,"w":[8623,533]}],["攒造","zǎnzào","I\n汇总编制。\nII\n赶造。",{"a":1,"w":[5014,1319]}],["揽脚","lǎnjiǎo","方言。谓以驴马招揽客人雇用。",{"a":1,"w":[8780,602]}],["支革","zhīgé","肢体肌肤。支，“肢”的古字。",{"a":1,"w":[1328,7633]}],["收吏","shōulì","旧称负责收取钱物的低级官员。",{"a":1,"w":[541,8898]}],["收后","shōuhòu","犹殿后。谓走在队伍的最后面。",{"a":1,"w":[541,43]}],["收括","shōukuò","犹搜刮。用各种方法掠夺财物。",{"a":1,"w":[541,8668]}],["改官","gǎiguān","旧时官员晋升调任的一种制度。",{"a":1,"w":[620,2293]}],["放象","fàngxiàng","亦作“放像”。\n仿效；依据。",{"a":1,"w":[63,7500]}],["故刑","gùxíng","过去判刑而今仍在服劳役的人。",{"a":1,"w":[7486,7716]}],["故枝","gùzhī","旧的枝条。亦喻旧时栖居之处。",{"a":1,"w":[7486,4696]}],["故行","gùxíng","亦作“故步”。\n原来的步法。",{"a":1,"w":[7486,8]}],["救解","jiùjiě","予以援助，使脱离危险或困难。",{"a":1,"w":[1409,4620]}],["败功","bàigōng","犹败事。失败之事；败坏事情。",{"a":1,"w":[2345,7516]}],["叙阶","xùjiē","按资历或功绩提升官吏的品级。",{"a":1,"w":[8462,7773]}],["教读","jiàodú","1) 教书。\n2) 指教师。",{"a":1,"w":[77,186]}],["敝蹻","bìjuē","破旧的草鞋。喻极无价值之物。",{"a":1,"w":[8875,13572]}],["散栎","sànlì","不成材的树木。比喻无用之人。",{"a":1,"w":[2286,9104]}],["散赈","sànzhèn","为赈济灾民而分发粮食、财物。",{"a":1,"w":[2286,11273]}],["散麻","sànmá","服丧时，系在腰间的散垂之麻。",{"a":1,"w":[2286,7550]}],["整笏","zhěnghù","端正地握着朝笏。恭谨待命貌。",{"a":1,"w":[1355,11446]}],["敛马","liǎnmǎ","犹勒马。收住马缰，停止前进。",{"a":1,"w":[8878,1273]}],["文伯","wénbó","文章宗伯。对着名作家的敬称。",{"a":1,"w":[7415,7608]}],["文鸳","wényuān","即鸳鸯。以其羽毛华美，故称。",{"a":1,"w":[7415,10114]}],["斗盎","dòu'àng","大盎。盎，一种大腹敛口的盆。",{"a":1,"w":[7477,12348]}],["斛面","húmiàn","官吏收赋粮时的一种额外聚敛。",{"a":1,"w":[9602,523]}],["斜曦","xiéxī","傍晚的阳光。亦指西斜的太阳。",{"a":1,"w":[3361,12196]}],["斩挞","zhǎntà","斩杀与鞭挞。借指用刑法镇压。",{"a":1,"w":[8673,11783]}],["斩蛟","zhǎnjiāo","斩杀蛟龙。多谓勇士为民除害。",{"a":1,"w":[8673,14013]}],["断鸢","duànyuān","断线风筝。鸢，指鸢形的风筝。",{"a":1,"w":[1335,9269]}],["方屏","fāngpíng","一方的屏藩。指地方军政长官。",{"a":1,"w":[2257,7852]}],["施函","shīhán","将一段木头挖成空心制成的桶。",{"a":1,"w":[7507,7764]}],["旁剔","pángtī","谓警觉而四顾。剔，通“惕”。",{"a":1,"w":[3371,9422]}],["旅亭","lǚtíng","谓路边供旅人暂时休息的处所。",{"a":1,"w":[7730,8241]}],["旅农","lǚnóng","众农。指田农、山农、泽农等。",{"a":1,"w":[7730,7612]}],["旐翣","zhàoshà","丧葬时引柩的丹旐与饰棺的霎。",{"a":1,"w":[31186,24163]}],["旗尉","qíwèi","亦作“旗尉”。\n旗军的尉官。",{"a":1,"w":[7796,9085]}],["日幢","rìchuáng","晕的一种。大气中的光学现象。",{"a":1,"w":[50,5413]}],["旨诣","zhǐyì","谓文章的主旨达到完美的境界。",{"a":1,"w":[9200,15360]}],["昌历","chānglì","亦作“昌历”。\n昌盛的年代。",{"a":1,"w":[8186,7643]}],["春力","chūnlì","指春季温煦之气催发万物之力。",{"a":1,"w":[1378,1276]}],["春场","chūnchǎng","春季郊外为射猎而整出的空地。",{"a":1,"w":[1378,544]}],["春焙","chūnbèi","春茶，指经过焙制的春季茶叶。",{"a":1,"w":[1378,10424]}],["春闺","chūnguī","女子的闺房。亦指闺中的女子。",{"a":1,"w":[1378,9497]}],["昭宫","zhāogōng","宫殿名。相传为周穆王时所建。",{"a":1,"w":[8522,4679]}],["时劫","shíjié","1) 时代。\n2) 犹时机。",{"a":1,"w":[1280,8458]}],["时阳","shíyáng","1) 干旱。\n2) 指春天。",{"a":1,"w":[1280,7484]}],["晋帖","jìntiē","指晋人的书迹或其摹本、刻帖。",{"a":1,"w":[8291,8250]}],["晋绅","jìnshēn","旧时官宦的装束。亦借指官宦。",{"a":1,"w":[8291,9994]}],["晚晡","wǎnbū","指黄昏的景色。晡，黄昏时候。",{"a":1,"w":[184,36674]}],["晚籁","wǎnlài","夜晚或傍晚时的各种天然响声。",{"a":1,"w":[184,19549]}],["晚霁","wǎnjì","谓傍晚雪止或雨停，天气晴朗。",{"a":1,"w":[184,12997]}],["昼会","zhòuhuì","古代朝会仪中白昼举行的宴会。",{"a":1,"w":[9111,18]}],["曦避","xībì","谓向往与退避。曦，通“睎”。",{"a":1,"w":[12196,2388]}],["普同","pǔtóng","犹普通。一般。意谓不分彼此。",{"a":1,"w":[7547,4611]}],["智炬","zhìjù","佛教语。指能破除迷暗的智慧。",{"a":1,"w":[7798,10692]}],["智烛","zhìzhú","谓智慧能明察一切，如烛照物。",{"a":1,"w":[7798,8450]}],["晕红","yūnhóng","中心浓而四周渐淡的一团红色。",{"a":1,"w":[3516,534]}],["晕适","yūnshì","谓出现日晕或月晕的变异天象。",{"a":1,"w":[3516,7671]}],["暑暍","shǔyē","1) 犹中暑。\n2) 暑热。",{"a":1,"w":[9309,25764]}],["暖目","nuǎnmù","青睐；看重。与“冷眼”相对。",{"a":1,"w":[3424,7465]}],["畅颜","chàngyán","犹开颜。脸上现出高兴的样子。",{"a":1,"w":[8281,8117]}],["暮砧","mùzhēn","傍晚捣衣的砧声。砧，捣衣石。",{"a":1,"w":[8841,12607]}],["暴见","bàojiàn","1) 显现。\n2) 犹宣扬。",{"a":1,"w":[7675,76]}],["晓阳","xiǎoyáng","1) 犹明白。\n2) 朝阳。",{"a":1,"w":[8614,7484]}],["旷廓","kuàngkuò","1) 宽广。\n2) 犹空廓。",{"a":1,"w":[8662,9651]}],["曲屈","qūqū","1) 弯曲。\n2) 犹屈就。",{"a":1,"w":[7517,7898]}],["曲师","qūshī","I\n不义之师。\nII\n乐师。",{"a":1,"w":[7517,7489]}],["曲轸","qūzhěn","1) 犹曲垂。\n2) 垂念。",{"a":1,"w":[7517,11130]}],["更箭","gèngjiàn","浮在刻漏水上指示时间的箭头。",{"a":1,"w":[611,4666]}],["更造","gèngzào","1) 重造。\n2) 犹更始。",{"a":1,"w":[611,1319]}],["书诺","shūnuò","在文牍上签署表示同意的字样。",{"a":1,"w":[81,7495]}],["服贡","fúgòng","周代九贡之一。进贡丝麻织品。",{"a":1,"w":[4619,8007]}],["望邻","wànglín","指相隔稍远而可以相望的邻居。",{"a":1,"w":[7556,8316]}],["朝昼","cháozhòu","早晨与白天。亦指时间之短暂。",{"a":1,"w":[1357,9111]}],["朝蕣","cháoshùn","木槿的别名。亦喻时间的短暂。",{"a":1,"w":[1357,83306]}],["朝贤","cháoxián","朝中的贤人。常用以泛指朝臣。",{"a":1,"w":[1357,8050]}],["朝离","cháolí","即株离。古东方少数民族乐名。",{"a":1,"w":[1357,543]}],["期佺","qīquán","传说中仙人安期、偓佺的并称。",{"a":1,"w":[1299,62950]}],["木坡","mùpō","指勾栏中渐次加高的木制座席。",{"a":1,"w":[7435,4791]}],["木局","mùjú","元代督管木工的机构，属工部。",{"a":1,"w":[7435,2291]}],["木镞","mùzú","一种假箭，箭镞以木削制而成。",{"a":1,"w":[7435,26551]}],["末景","mòjǐng","1) 余辉。\n2) 喻晚年。",{"a":1,"w":[2329,4676]}],["朱箱","zhūxiāng","谓红色的车子。为显贵者所乘。",{"a":1,"w":[7906,2354]}],["朱销","zhūxiāo","勾销。因勾销多用朱笔，故称。",{"a":1,"w":[7906,7663]}],["朱韨","zhūfú","系印纽的红带子。亦借指官印。",{"a":1,"w":[7906,67942]}],["朴鲁","pǔlǔ","朴实鲁钝。有时用为自称谦词。",{"a":1,"w":[9097,7564]}],["杏殇","xìngshāng","谓杏的花苞凋落。喻婴儿夭折。",{"a":1,"w":[9579,14829]}],["村妆","cūnzhuāng","粗俗的打扮，借指粗俗的女子。",{"a":1,"w":[1430,8268]}],["村旆","cūnpèi","乡村酒店的酒旗。引申指酒店。",{"a":1,"w":[1430,14637]}],["杓口","biāokǒu","指厨师的烹调技术或菜肴味道。",{"a":1,"w":[9488,47]}],["杓棒","biāobàng","古时击球用的头部弯曲的棍棒。",{"a":1,"w":[9488,2361]}],["杜崔","dùcuī","东汉书法家杜度和崔瑗的并称。",{"a":1,"w":[7680,10711]}],["杜断","dùduàn","谓善于对事情作出妥当的决断。",{"a":1,"w":[7680,1335]}],["松窗","sōngchuāng","临松之窗。多以指别墅或书斋。",{"a":1,"w":[2295,8301]}],["松笠","sōnglì","指松树。因其枝叶如笠，故称。",{"a":1,"w":[2295,10898]}],["松钗","sōngchāi","松叶。因其双股如钗状，故名。",{"a":1,"w":[2295,10709]}],["松髯","sōngrán","指松叶。因其针状如髯，故称。",{"a":1,"w":[2295,10978]}],["板升","bǎnshēng","蒙语“房舍”之意。源于汉语。",{"a":1,"w":[1305,1362]}],["枉沐","wǎngmù","白白地蒙受。对人来访的敬词。",{"a":1,"w":[9134,9479]}],["枉邪","wǎngxié","邪恶不正。亦指邪恶不正的人。",{"a":1,"w":[9134,8201]}],