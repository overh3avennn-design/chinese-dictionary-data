5]}],["呵察","hēchá","喝止行人，稽查盘问。",{"a":1,"w":[4926,7567]}],["呼弄","hūnòng","犹糊弄。迷惑，欺骗。",{"a":1,"w":[7783,630]}],["呼拚","hūpàn","欢呼鼓掌。形容喜极。",{"a":1,"w":[7783,11580]}],["呼舞","hūwǔ","欢呼起舞。极言欢乐。",{"a":1,"w":[7783,3356]}],["命敕","mìngchì","犹敕命。皇帝的诏令。",{"a":1,"w":[4622,9734]}],["命爵","mìngjué","赐给爵位；赐给官职。",{"a":1,"w":[4622,8494]}],["命谥","mìngshì","所赐谥号；给予谥号。",{"a":1,"w":[4622,19720]}],["咀唔","jǔwú","犹龃龉。谓意见不合。",{"a":1,"w":[11266,16598]}],["和雨","héyǔ","犹细雨。与骤雨相对。",{"a":1,"w":[39,159]}],["咢布","èbù","谓阴阳之气相交四散。",{"a":1,"w":[27971,1283]}],["咮嚅","zhòurú","谓嘴笨，嗫嚅不能言。",{"a":1,"w":[59203,39301]}],["咯当","gēdāng","象声词。时钟走动声。",{"a":1,"w":[10229,552]}],["咳儿","ké'ér","孩儿。咳，通“孩”。",{"a":1,"w":[3535,7408]}],["咸夏","xiánxià","函夏。指中原，全国。",{"a":1,"w":[2422,1397]}],["咸黑","xiánhēi","古代传说中的乐师名。",{"a":1,"w":[2422,549]}],["咽哽","yàngěng","泣不成声；气塞声断。",{"a":1,"w":[9066,13847]}],["哀娱","āiyú","犹哀乐。悲伤与欢乐。",{"a":1,"w":[8386,9325]}],["哀平","āipíng","汉哀帝与平帝的并称。",{"a":1,"w":[8386,525]}],["哀闵","āimǐn","怜惜；同情。闵，悯。",{"a":1,"w":[8386,10057]}],["哃吓","tóngxià","犹恫吓。威吓，吓唬。",{"a":1,"w":[3550]}],["哇笑","waxiào","哇哇而笑。指小儿笑。",{"a":1,"w":[4903,185]}],["哈呀","hāya","叹词。表惊讶、惋惜。",{"a":1,"w":[3326,2503]}],["员圌","yuánchuán","浑圆。圌，通“团”。",{"a":1,"w":[1289,69969]}],["员幅","yuánfú","幅员。指范围、疆域。",{"a":1,"w":[1289,3454]}],["唁慰","yànwèi","对死者家属表示安慰。",{"a":1,"w":[25661,9360]}],["唃唃","gǔgǔ","象声词。禽鸟的鸣声。",{"a":1,"w":[586487]}],["唐猊","tángní","即唐夷。详“唐夷”。",{"a":1,"w":[7869,20473]}],["唐窖","tángjiào","冬天培植鲜花的暖窖。",{"a":1,"w":[7869,10629]}],["售迹","shòujì","犹发迹。谓扬名立业。",{"a":1,"w":[8329,8080]}],["啁咈","zhāofú","犹喧哗。多表示不满。",{"a":1,"w":[37283,31413]}],["啄菢","zhuóbào","谓禽鸟幼雏破壳而出。",{"a":1,"w":[9483,62228]}],["啄锄","zhuóchú","一种形状似镐的农具。",{"a":1,"w":[9483,9844]}],["商宜","shāngyí","谓商量如何适当处理。",{"a":1,"w":[7485,7984]}],["商曹","shāngcáo","掌管商业的行政机关。",{"a":1,"w":[7485,8358]}],["商祝","shāngzhù","习商礼而任司祭的人。",{"a":1,"w":[7485,1473]}],["问拟","wènnǐ","审问罪犯，拟定罪刑。",{"a":1,"w":[113,7659]}],["问军","wènjūn","充军。古代刑罚之一。",{"a":1,"w":[113,7467]}],["哑咿","yǎyī","小儿语声，借指小儿。",{"a":1,"w"