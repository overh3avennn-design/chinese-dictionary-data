:1,"w":[13173,7832,32100]}],["累累如珠","lěilěirúzhū","累累连接成串。一个紧接一个，就像一串珠子。",{"a":1,"w":[25441,4614,7784]}],["狼前虎后","lángqiánhǔhòu","前门赶走狼，后门来了虎。比喻坏人接踵而来。",{"a":1,"w":[7960,60,3337,43]}],["宽猛并济","kuānměngbìngjì","指政治措施要宽和严互相补充。同宽猛相济”。",{"a":1,"w":[2323,4814,1377,7522]}],["狂犬吠日","kuángquǎn fèirì","疯狗对着太阳乱叫。比喻坏人自不量力地叫嚣。",{"a":1,"w":[25184,78462]}],["昆山之玉","kūnshān zhī yù","昆山昆仑山。昆仑山的美玉。比喻杰出的人才。",{"a":1,"w":[36255,2254,2294]}],["拉捭摧藏","lābǎicuīcáng","拉摧折；捭两手排击；摧藏挫伤。指摧伤挫折。",{"a":1,"w":[514,34992,296204]}],["口腹之累","kǒufùzhīlěi","口腹指饮食；累连累。指因为饮食而受到牵累。",{"a":1,"w":[59212,2254,173]}],["口似悬河","kǒusìxuánhé","形容能说会辨，说起来没个完。同口若悬河”。",{"a":1,"w":[47,7803,70963]}],["苦不可言","kǔbùkěyán","痛苦或困苦到了极点，已经不能用言语来表达。",{"a":1,"w":[2322,168593]}],["可乘之隙","kěchéngzhīxì","隙空子，机会。可以被对方利用的弱点、空隙。",{"a":1,"w":[3310,3366,2254,8385]}],["克己慎行","kèjǐshènxíng","克己克制自己；慎谨慎。约束自己，小心做事。",{"a":1,"w":[23668,59760]}],["君辱臣死","jūnrǔchénsǐ","封建礼教认为，帝王遭受耻辱，臣僚应当死节。",{"a":1,"w":[7831,8418,8045,1329]}],["峻宇雕墙","jùnyǔ diāoqiáng","高大的屋宇和彩绘的墙壁。形容居处豪华奢侈。",{"a":1,"w":[143940,209195]}],["驹齿未落","jūchǐwèiluò","驹小马。小马的乳齿尚未更换。比喻人尚年幼。",{"a":1,"w":[234524,7559,2275]}],["举鼎拔山","jǔdǐng báshān","能将大鼎举起，能将高山拔动。比喻力大气壮。",{"a":1,"w":[73300,76026]}],["举国若狂","jǔguóruòkuáng","举全；狂狂欢。全国的人都激动得像发狂一样。",{"a":1,"w":[59513,4652,3382]}],["救过补阙","jiùguòbǔquē","阙同缺”，不足，缺点。挽救过错，弥补不足。",{"a":1,"w":[255182,101630]}],["救火拯溺","jiùhuǒzhěngnì","形容紧急救助陷于困境中的人。同救焚拯溺”。",{"a":1,"w":[21414,13555,9168]}],["惊心吊魄","jīngxīn diào pò","形容使人十分惊骇紧张到极点。同惊心动魄”。",{"a":1,"w":[25795,4693,9063]}],["鲸吞虎噬","jīngtūn hǔ shì","像鲸鱼和老虎一样吞食。多比喻吞并土地财物。",{"a":1,"w":[27119,359902]}],["井渫莫食","jǐngxièmòshí","比喻洁身自持，而不为人所知。同井渫不食”。",{"a":1,"w":[76813,7446,7466]}],["晋阳之甲","jìnyáng zhī jiǎ","指地方官吏因不满朝廷而举兵为兴晋阳之甲”。",{"a":1,"w":[196904,2254,3330]}],["惊魂落魄","jīnghúnluòpò","形容使人感受很深，震动很大。同惊魂丧魄”。",{"a":1,"w":[53979,21824]}],["惊魂摄魄","jīnghúnshèpò","形容使人感受很深，震动很大。同惊魂夺魄”。",{"a":1,"w":[53979,7746,9063]}],["惊魂失魄","jīnghún shī pò","形容使人感受很深，震动很大。同惊魂丧魄”。",{"a":1,"w":[53979,7527,9063]}],["矜功自伐","jīngōngzìfá","矜骄傲，自夸；伐自夸。自以为有功劳而夸耀。",{"a":1,"w":[8903,7516,100875]}],["矜名妒能","jīnmíngdùnéng","矜夸耀；妒嫉妒。夸耀自己的名声而嫉妒贤能。",{"a":1,"w":[8903,560,10231,41]}],["进可替不","jìnkětìbù","指向君主进献良策以废弃弊政。同进可替否”。",{"a":1,"w":[71,3310,2368,0]}],["今愁古恨","jīnchóugǔhèn","愁忧愁；恨怨恨。古今的恨事。形容感慨极多。",{"a":1,"w":[7811,3481,1322,3477]}],["金石不渝","jīnshíbùyú","像金石一样不可改变。形容坚守盟约、节操等。",{"a":1,"w":[10584,20062]}],["金石之坚","jīnshízhījiān","象金属和石头那样坚硬。形容极为坚硬或强固。",{"a":1,"w":[10584,2254,7849]}],["洁己从公","jiéjǐcónggōng","保持自身廉洁，一心奉行公事。同洁己奉公”。",{"a":1,"w":[196733,31635]}],["竭诚相待","jiéchéngxiāngdài","竭诚竭尽诚意；待对待。竭尽诚意地对待别人。",{"a":1,"w":[173895,14713]}],["解发佯狂","jiěfàyángkuáng","解发把头发散开；佯假装。散开头发假装癫狂。",{"a":1,"w":[270183,67256]}],["解衣抱火","jiěyībàohuǒ","比喻不解决问题，只招致危险。同解衣包火”。",{"a":1,"w":[40885,2374,1284]}],["浆酒霍肉","jiāngjiǔhuòròu","把酒肉当作水浆、豆叶一样。形容饮食的奢侈。",{"a":1,"w":[7883,594,7805,116]}],["僵李代桃","jiānglǐdàitáo","比喻代人受罪责或以此代彼。亦作僵桃代李”。",{"a":1,"w":[8872,7880,1313,3386]}],["降尊临卑","jiàngzūnlínbēi","尊贵的人委曲自己的身分与地位较低的人交往。",{"a":1,"w":[2305,7922,7625,8402]}],["交臂相失","jiāobìxiāngshī","犹言交臂失之。比喻遇到了机会而又当面错过。",{"a":1,"w":[38084,7427,7527]}],["骄侈暴佚","jiāochǐbàoyì","形容生活放纵奢侈，荒淫无度。同骄奢淫逸”。",{"a":1,"w":[425446,7675,10701]}],["骄侈淫虐","jiāochǐ yínnüè","形容生活放纵奢侈，荒淫无度。同骄奢淫逸”。",{"a":1,"w":[425446,337348]}],["骄奢放逸","jiāoshē fàngyì","形容生活放纵奢侈，荒淫无度。同骄奢淫逸”。",{"a":1,"w":[45987,144541]}],["骄泰淫泆","jiāotàiyínyì","形容生活放纵奢侈，荒淫无度。同骄奢淫逸”。",{"a":1,"w":[205248,106073]}],["骄佚奢淫","jiāoyìshēyín","形容生活放纵奢侈，荒淫无度。同骄奢淫逸”。",{"a":1,"w":[8457,10701,9225,7901]}],["矫情镇物","jiǎoqíngzhènwù","矫情克制情感。比喻故作镇静，使人无法猜度。",{"a":1,"w":[110194,164366]}],["见哭兴悲","jiànkūxīngbēi","见别人哭泣而引起自己的悲伤。指产生同情心。",{"a":1,"w":[76,728,7545,8341]}],["见义敢为","jiànyìgǎnwéi","看到正义的事，就勇敢地去做。同见义勇为”。",{"a":1,"w":[76,7437,1453,550]}],["兼包并容","jiānbāobìngróng","把各个方面全都容纳包括进来。同兼容并包”。",{"a":1,"w":[282952,1377,7524]}],["见德思齐","jiàndésīqí","见到德才兼备的人就想赶上他。同见贤思齐”。",{"a":1,"w":[76,7416,111833]}],["家常茶饭","jiāchángcháfàn","家庭中的日常饮食。多用以喻极为平常的事情。",{"a":1,"w":[5072,75046]}],["家道小康","jiādàoxiǎokāng","家道家境；小康中等水平。家庭经济比较宽裕。",{"a":1,"w":[37302,18366]}],["家给民足","jiājǐmínzú","给丰足，富裕。家家衣食充裕，人人生活富足。",{"a":1,"w":[58926,7434,4625]}],["嘉言善状","jiāyán shànzhuàng","有教育意义的好言语和好行为。同嘉言善行”。",{"a":1,"w":[55527,92647]}],["及第成名","jídì chéngmíng","及第科举时代考试中选。通过考试并得到功名。",{"a":1,"w":[28534,25302]}],["疾不可为","jíbùkěwéi","疾病；为治。病已不可医治。比喻已到了绝境。",{"a":1,"w":[7794,116295]}],["鸡肤鹤发","jīfūhèfà","皮肤发皱，头发苍白。指老人。同鸡皮鹤发”。",{"a":1,"w":[578,8232,27201]}],["积玉堆金","jīyùduījīn","金玉多得可以堆积起来。形容聚敛的财富极多。",{"a":1,"w":[7496,2294,3333,1270]}],["赍志而没","jīzhì'érmò","赍怀抱着，带着；殁死。志愿没有实现就死了。",{"a":1,"w":[105481,2267,94]}],["混俗和光","hùnsúhéguāng","同于尘俗，不露锋芒。指不求特异，与世无争。",{"a":1,"w":[4641,7904,53436]}],["击节称赏","jījiéchēngshǎng","节节拍；赏赞赏。形容对诗文、音乐等的赞赏。",{"a":1,"w":[215338,192818]}],["击节叹赏","jījiétànshǎng","节节拍；赏赞赏。形容对诗文、音乐等的赞赏。",{"a":1,"w":[215338,353537]}],["回船转舵","huíchuánzhuǎnduò","行船遇事的回原路。比喻掉转话头，缓和僵局。",{"a":1,"w":[148367,20872]}],["焕然如新","huànrán rú xīn","改变旧面貌，出现崭新的气象。同焕然一新”。",{"a":1,"w":[63222,4614,80]}],["黄冠草服","huángguàncǎofú","粗劣的衣着。借指平民百姓。有时指草野高逸。",{"a":1,"w":[28330,201297]}],["黄花晚节","huánghuāwǎnjié","黄花菊花；晚节晚年的节操。比喻人晚节高尚。",{"a":1,"w":[8949,37561]}],["挥翰临池","huīhàn línchí","翰鸟羽，借指毛笔；临池指写字。指运笔写字。",{"a":1,"w":[751430,104876]}],["隳肝尝胆","huīgānchángdǎn","犹言隳肝沥胆。比喻待人忠心耿耿，赤诚无比。",{"a":1,"w":[14103,4739,2455,3379]}],["画地成牢","huàdìchéngláo","比喻只许在限定的范围内活动。同画地为牢”。",{"a":1,"w":[35611,517,4824]}],["画地为狱","huàdìwéiyù","比喻只许在指定的范围内活动。同画地为牢”。",{"a":1,"w":[35611,550,8200]}],["画地作狱","huàdìzuòyù","比喻只许在指定的范围内活动。同画地为牢”。",{"a":1,"w":[35611,4608,8200]}],["花香鸟语","huāxiāngniǎoyǔ","鸟语鸟鸣如同讲话一般。形容春天动人的景象。",{"a":1,"w":[31698,74151]}],["闳意妙指","hóngyìmiàozhǐ","指宏大微妙的意旨。指，同旨”，意义，目的。",{"a":1,"w":[12278,7482,4764,1312]}],["鸿案鹿车","hóng'ànlùchē","比喻夫妻之间相互尊重，相互体贴，同甘共苦。",{"a":1,"w":[93883,102130]}],["狐鸣狗盗","hú míng gǒudào","指作恶偷盗之徒。旧时统治者对造反者的贬称。",{"a":1,"w":[8675,7935,70498]}],["鹤知夜半","hèzhīyèbàn","鹤夜半而鸣。比喻各有专长。也比喻偏知一隅。",{"a":1,"w":[8240,7492,88985]}],["恨海难填","hènhǎinántián","恨海怨恨如海；难填难于填塞。比喻怨气难平。",{"a":1,"w":[165272,117,2371]}],["横眉竖眼","héngméishùyǎn","指耸眉瞪眼，形容怒目相视，态度凶狠的样子。",{"a":1,"w":[26512,107828]}],["闳大不经","hóngdàbùjīng","指不着边际，不合常理；近乎荒诞，没有根据。",{"a":1,"w":[12278,12389,7421]}],["号唃大哭","hào gǔ dàkū","号唃也写作嚎啕”，大声哭叫。形容放声大哭。",{"a":1,"w":[78,586487,35408]}],["赫赫之功","hèhè zhī gōng","赫赫盛大显著貌。显赫的业绩。形容功劳极大。",{"a":1,"w":[37821,2254,7516]}],["汗流浃踵","hànliújiāzhǒng","汗出得多，流到脚跟。常形容极端恐惧或惭愧。",{"a":1,"w":[52329,11236,9174]}],["汗流接踵","hànliújiēzhǒng","汗出得多，流到脚跟。常形容极端恐惧或惭愧。",{"a":1,"w":[52329,28863]}],["汗流至踵","hànliúzhìzhǒng","汗出得多，流到脚跟。常形容极端恐惧或惭愧。",{"a":1,"w":[52329,3346,9174]}],["汗洽股栗","hànqiàgǔlì","汗流浃背，两腿颤抖。形容害怕、恐惧的样子。",{"a":1,"w":[2403,8828,217430]}],["豪横跋扈","háohéngbáhù","跋扈专横暴戾♂行凶暴，为非作歹，专横暴虐。",{"a":1,"w":[89345,26474]}],["归邪转曜","guīxiézhuǎnyào","曜光明。改除邪恶归依正道。亦作归邪反正”。",{"a":1,"w":[2317,8201,1293,10019]}],["诡变多端","guǐ biàn duōduān","诡变狡诈多变；端项目，点。形容坏主意很多。",{"a":1,"w":[8845,539,24892]}],["鬼计百端","guǐjì bǎi duān","指狡诈的计策很多，坏主意多。同鬼计多端”。",{"a":1,"w":[173959,53602]}],["关山阻隔","guānshān zǔgé","关隘山岭阻挡隔绝。形容路途艰难，往来不易。",{"a":1,"w":[35221,50156]}],["冠屦倒施","guànjùdǎoshī","比喻上下位置颠倒，尊卑不分。同冠履倒易”。",{"a":1,"w":[7694,10982,583,7507]}],["贯颐奋戟","guànyífènjǐ","颐下巴。两手捧颐而直入敌阵。形容英勇无畏。",{"a":1,"w":[8062,9868,8299,8766]}],["鼓唇摇舌","gǔchún yáo shé","耍嘴皮，嚼舌头。形容耍弄嘴皮进行挑拨煽动。",{"a":1,"w":[114583,412880]}],["故家乔木","gùjiāqiáomù","①指世家的人才、器物必定出众。②喻指乡贤。",{"a":1,"w":[70402,26703]}],["狗盗鼠窃","gǒudào shǔqiè","像鼠狗那样的盗贼。比喻成不了气候的反叛者。",{"a":1,"w":[70498,97080]}]]