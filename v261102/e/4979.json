[["胥隶","xūlì","封建官府中的小吏和差役。",{"a":1,"w":[9768,8847]}],["胸藏","xiōngcáng","胸中藏着。指有某种才能。",{"a":1,"w":[3364,4688]}],["能仁","néngrén","梵语的意译。即释迦牟尼。",{"a":1,"w":[41,7736]}],["脂辖","zhīxiá","脂车。多谓准备驾车远行。",{"a":1,"w":[7903,8767]}],["胁窝","xiéwō","即胳肢窝。喻旁边或隐处。",{"a":1,"w":[8936,4714]}],["脊杖","jízhàng","古时一种施于背部的杖刑。",{"a":1,"w":[8277,8427]}],["修檛","xiūzhuā","笙两侧的长管。亦借指笙。",{"a":1,"w":[1339,45821]}],["脱真","tuōzhēn","道教语。指元神脱离身体。",{"a":1,"w":[2312,85]}],["脱赠","tuōzèng","解物相赠。亦指以物相赠。",{"a":1,"w":[2312,3514]}],["脾家","píjiā","脾脏所在之处。泛指腹部。",{"a":1,"w":[9118,28]}],["腑冷","fǔlěng","腐烂散落。腑，通“腐”。",{"a":1,"w":[14020,115]}],["腓字","féizì","庇护怜爱。腓，通“庇”。",{"a":1,"w":[11011,84]}],["脑幕","nǎomù","犹脑筋。指脑中所呈现者。",{"a":1,"w":[7686,7877]}],["脚士","jiǎoshì","旧时奉官府差遣办事的人。",{"a":1,"w":[602,7542]}],["腹俭","fùjiǎn","胸中贫乏。比喻学问浅少。",{"a":1,"w":[7842,9141]}],["膈臆","géyì","犹肺腑，肝胆。比喻内心。",{"a":1,"w":[14044,11972]}],["膏渟","gāotíng","如膏的止水；水静止如膏。",{"a":1,"w":[8048,18636]}],["膏臊","gāosāo","犬膏。古代调味八珍之一。",{"a":1,"w":[8048,9582]}],["肤使","fūshǐ","指能圆满完成使命的使者。",{"a":1,"w":[8232,1332]}],["胶瑟","jiāosè","比喻固执拘泥，不知变通。",{"a":1,"w":[7702,8205]}],["膻乡","shānxiāng","借指匈奴地区或北方边地。",{"a":1,"w":[17743,3375]}],["膘浇","biāojiāo","加在面条上做浇头的肥肉。",{"a":1,"w":[15724,3541]}],["胪人","lúrén","即鸿胪。古代主宾客之官。",{"a":1,"w":[16861,3]}],["临乾","línqián","谓统治天下。乾，指君位。",{"a":1,"w":[7625,9029]}],["临厕","líncè","临近边侧。厕，通“侧”。",{"a":1,"w":[7625,8932]}],["临本","línběn","谓摹写出来的书画复制本。",{"a":1,"w":[7625,42]}],["临楮","línchǔ","临纸。楮，纸，多指信笺。",{"a":1,"w":[7625,12229]}],["临组","línzǔ","谓受命为官。组，指印绶。",{"a":1,"w":[7625,558]}],["临觞","línshāng","犹言面对着酒。觞，酒杯。",{"a":1,"w":[7625,10771]}],["自晦","zìhuì","自隐才能，不使声名彰着。",{"a":1,"w":[2256,9596]}],["自粥","zìzhōu","自卖其身。粥，同“鬻”。",{"a":1,"w":[2256,4875]}],["自累","zìlèi","自己束缚自己、牵累自己。",{"a":1,"w":[2256,173]}],["至哲","zhìzhé","犹圣哲。指最有智慧的人。",{"a":1,"w":[3346,8304]}],["至识","zhìshí","见闻广博而深明事理的人。",{"a":1,"w":[3346,4658]}],["至鉴","zhìjiàn","指极高的观察、鉴别能力。",{"a":1,"w":[3346,8039]}],["至愿","zhìyuàn","恳切的愿望；最大的愿望。",{"a":1,"w":[3346,3393]}],["致治","zhìzhì","使国家在政治上安定清平。",{"a":1,"w":[7666,2283]}],["台吏","táilì","古指中央政府机构的属官。",{"a":1,"w":[1306,8898]}],["兴谕","xīngyù","指诗歌创作手法的兴与比。",{"a":1,"w":[7545,9439]}],["旧治","jiùzhì","从前或原来所管辖的地区。",{"a":1,"w":[1396,2283]}],["舋鼓","xìngǔ","杀人或杀牲以血涂鼓行祭。",{"a":1,"w":[227494,3352]}],["舛张","chuǎnzhāng","犹乖张。怪僻，不近情理。",{"a":1,"w":[12109,1333]}],["舞末","wǔmò","宋代舞曲的一种终结形式。",{"a":1,"w":[3356,2329]}],["舞头","wǔtóu","领舞者。与“舞末”相对。",{"a":1,"w":[3356,509]}],["船宫","chuángōng","古代吴越建于船上的宫室。",{"a":1,"w":[621,4679]}],["良丁","liángdīng","旧指平民百姓中已成年者。",{"a":1,"w":[7645,4646]}],["芔陨","huìyǔn","纷纷坠落。芔，通“汇”。",{"a":1,"w":[129643,8185]}],["芥虿","jièchài","犹芥蒂。积在心中的不快。",{"a":1,"w":[8473,22872]}],["花毦","huā'ěr","用彩色羽毛制作的装饰物。",{"a":1,"w":[20,40323]}],["芳物","fāngwù","芳香之物。多指花卉草木。",{"a":1,"w":[8273,7412]}],["芳蚁","fāngyǐ","美酒。蚁，指酒滓或酒沫。",{"a":1,"w":[8273,8267]}],["苟求","gǒuqiú","任意求得；无原则地求取。",{"a":1,"w":[8774,598]}],["苦伪","kǔwěi","犹苦窳。质粗劣，不坚实。",{"a":1,"w":[2322,7945]}],["苦操","kǔcāo","在艰难困苦中坚守的节操。",{"a":1,"w":[2322,7592]}],["苦瘠","kǔjí","味苦贫穷。亦指土质硗薄。",{"a":1,"w":[2322,11234]}],["英儒","yīngrú","犹硕儒。学识渊博的儒士。",{"a":1,"w":[7637,8257]}],["英规","yīngguī","优良的法则；明智的策略。",{"a":1,"w":[7637,7549]}],["茗舌","míngshé","茶芽。谓茶芽嫩如雀舌者。",{"a":1,"w":[12941,7844]}],["草娘","cǎoniáng","鞑靼人称妓女为“草娘”。",{"a":1,"w":[521,8089]}],["荆革","jīnggé","荆条皮鞭。鞭笞用的刑具。",{"a":1,"w":[8436,7633]}],["荒愧","huāngkuì","惊慌愧耻。荒，通“慌”。",{"a":1,"w":[7797,9311]}],["荷扇","héshàn","荷叶。荷叶形似扇，故称。",{"a":1,"w":[7677,3380]}],["庄丽","zhuānglì","端庄而美丽；雄伟而美丽。",{"a":1,"w":[7932,7634]}],["菖歜","chāngchù","用菖蒲根切制成的腌制品。",{"a":1,"w":[11429,90004]}],["华色","huásè","美丽的容色；华丽的色彩。",{"a":1,"w":[7503,2266]}],["华镳","huábiāo","精美的马勒。亦用以指马。",{"a":1,"w":[7503,18613]}],["莱舞","láiwǔ","莱衣起舞。表示孝养双亲。",{"a":1,"w":[7830,3356]}],["萸尊","yúzūn","借指茱萸酒。尊，盛酒器。",{"a":1,"w":[12649,7922]}],["落脱","luòtuō","同“落拓”。\n放浪不羁。",{"a":1,"w":[2275,2312]}],["葆力","bǎolì","恃其勤苦。葆，通“保”。",{"a":1,"w":[11938,1276]}],["搜狝","sōuxiǎn","春猎与秋猎。亦泛指狩猎。",{"a":1,"w":[3416,38580]}],["蒙谷","ménggǔ","山名。古代传说日入之处。",{"a":1,"w":[4647,7701]}],["蒱且","púqiě","人名。相传其人善于射鸟。",{"a":1,"w":[56347,8093]}],["蒲姑","púgū","地名。在今山东博兴东北。",{"a":1,"w":[8305,8085]}],["蒸报","zhēngbào","谓与母辈或晚辈亲属淫乱。",{"a":1,"w":[7703,1318]}],["苍辂","cānglù","皇帝祀天时乘坐的一种车。",{"a":1,"w":[8328,14323]}],["蒿棘","hāojí","蒿草与荆棘。亦泛指野草。",{"a":1,"w":[8178,7772]}],["蓄内","xùnèi","蓄养内人。内人，妻妾等。",{"a":1,"w":[8173,1287]}],["蓄菟","xùtú","囿苑饲养的供射猎的兔子。",{"a":1,"w":[8173,11321]}],["蔋","dí","dí\n草木因干旱而死尽。",{"a":1}],["荫封","yīnfēng","旧指因先代的功勋而受封。",{"a":1,"w":[8853,600]}],["蔽薄","bìbáo","敝陋菲薄。蔽，通“敝”。",{"a":1,"w":[8083,2319]}],["蕃援","fānyuán","护卫辅助。蕃，通“藩”。",{"a":1,"w":[9068,7930]}],["蕉纱","jiāoshā","蕉布。亦指芭蕉茎的纤维。",{"a":1,"w":[8858,8800]}],["萧光","xiāoguāng","祭祀时燃艾蒿所生之香气。",{"a":1,"w":[8866,1271]}],["薄借","báojiè","即不借。一种麻制的草鞋。",{"a":1,"w":[2319,650]}],["薄徒","báotú","浅薄无知或浮薄轻佻的人。",{"a":1,"w":[2319,7813]}],["薇藿","wēihuò","薇和藿。贫苦人用以充饥。",{"a":1,"w":[9941,12808]}],["药封","yàofēng","旧时装有医生酬金的封袋。",{"a":1,"w":[579,600]}],["藩篆","fānzhuàn","藩司的官印。亦借指藩司。",{"a":1,"w":[9005,9979]}],["蕲王","qíwáng","宋名将韩世宗死后的封号。",{"a":1,"w":[14640,2278]}],["兰堂","lántáng","芳洁的厅堂。厅堂的美称。",{"a":1,"w":[7450,7695]}],["兰焚","lánfén","芳兰遭焚。喻高人受摧折。",{"a":1,"w":[7450,9179]}],["齑肠","jīcháng","谓食虀之肠。喻生活贫困。",{"a":1,"w":[23399,3392]}],["处业","chùyè","谓使人安居并有谋生之业。",{"a":1,"w":[2272,7418]}],["虚授","xūshòu","谓授职给德才不相称的人。",{"a":1,"w":[7779,8099]}],["虺易","huīyì","蜥蜴。易，“蜴”的古字。",{"a":1,"w":[14733,7463]}],["虺螫","huīshì","毒蛇咬。比喻被谗人诬陷。",{"a":1,"w":[14733,11281]}],["蚌江","bàngjiāng","蟹的一种。蚌，通“蜂”。",{"a":1,"w":[10359,2327]}],["蚤图","zǎotú","早日图谋。蚤，通“早”。",{"a":1,"w":[9661,1301]}],["蚤虑","zǎolǜ","及早思谋。蚤，通“早”。",{"a":1,"w":[9661,8360]}],["蚤临","zǎolín","及早莅临。蚤，通“早”。",{"a":1,"w":[9661,7625]}],["蚤蚊","zǎowén","跳蚤和蚊子。亦泛指小虫。",{"a":1,"w":[9661,9095]}],["蚤计","zǎojì","早作打算。蚤，通“早”。",{"a":1,"w":[9661,7428]}],["蚤退","zǎotuì","提早隐退。蚤，通“早”。",{"a":1,"w":[9661,1371]}],["蚩薄","chībáo","讥嘲鄙薄。蚩，通“嗤”。",{"a":1,"w":[12211,2319]}],["蚩谪","chīzhé","嗤笑谴责。蚩，通“嗤”。",{"a":1,"w":[12211,11409]}],["蛇母","shémǔ","传说汉高祖所斩白蛇之母。",{"a":1,"w":[3363,4637]}],["蛇脂","shézhī","蛇的脂肪。比喻人的心力。",{"a":1,"w":[3363,7903]}],["蛟室","jiāoshì","犹龙宫。亦借指大江大海。",{"a":1,"w":[14013,1359]}],["蜀精","shǔjīng","蜃精。相传为许真君所斩。",{"a":1,"w":[8443,4629]}],["蜂旗","fēngqí","古时画有蜂形图案的军旗。",{"a":1,"w":[7959,7796]}],["蜂溃","fēngkuì","像蜂群四处飞散那样逃亡。",{"a":1,"w":[7959,8651]}],["蜉结","fújié","如蜉蝣的集结。极言人多。",{"a":1,"w":[17254,2271]}],["蜚蛭","fēizhì","神话中的一种有四翼的虫。",{"a":1,"w":[10023,15419]}],["蜩鼹","tiáoyǎn","蝉与鼹鼠。比喻卑微的人。",{"a":1,"w":[24051,27372]}],["蝝灾","yuánzāi","亦作“蝝菑”。\n指蝗灾。",{"a":1,"w":[82860,3438]}],["虾臛","xiāhuò","亦作“蛤臛”。\n蛙肉羹。",{"a":1,"w":[8057,105982]}],["虱虫","shīchóng","亦作“虱虫”。\n即虱子。",{"a":1,"w":[9142,7601]}],["蝮毒","fùdú","如蝮蛇之毒。极言其狠毒。",{"a":1,"w":[10756,3322]}],["蝮蜪","fùtáo","虫名。蝗的未生翅的幼虫。",{"a":1,"w":[10756,126370]}],["蝶魄","diépò","比喻梦中超脱飘逸的心境。",{"a":1,"w":[8061,9063]}],["蜗疽","wōjū","一种毒疮。蜗，通“瘑”。",{"a":1,"w":[13793,10949]}],["蝹蜿","yūnwān","龙行貌。亦谓曲折起伏貌。",{"a":1,"w":[16872]}],["蝻蝗","nǎnhuáng","蝗的幼虫和蝗。泛指蝗虫。",{"a":1,"w":[58638,12775]}],["蛰燕","zhéyàn","冬季伏匿在岩穴中的燕子。",{"a":1,"w":[12784,7821]}],["蟠瘿","pányǐng","指树木上的囊状的赘生物。",{"a":1,"w":[12369,16393]}],["蟨蛩","juéqióng","两兽名。即蛩蛩巨虚和蟨。",{"a":1,"w":[81625,12429]}],["蝉媛","chányuàn","情思牵萦。蝉，通“婵”。",{"a":1,"w":[8931,20064]}],["蚕功","cángōng","亦作“蚕工”。\n犹蚕事。",{"a":1,"w":[8576,7516]}],["蛮床","mánchuáng","藤床。藤产于南方，故称。",{"a":1,"w":[8711,183]}],["蛮府","mánfǔ","旧指主管少数民族的官署。",{"a":1,"w":[8711,7706]}],["蛮村","máncūn","蛮人的村庄。亦泛指荒村。",{"a":1,"w":[8711,1430]}],["蛮箐","mánqìng","南方少数民族设置的竹弩。",{"a":1,"w":[8711,35155]}],["蛮蕉","mánjiāo","芭蕉。因产于南方，故称。",{"a":1,"w":[8711,8858]}],["蛮藤","mánténg","南方所产的藤。可编簟席。",{"a":1,"w":[8711,7799]}],["蛮鼓","mángǔ","南方一种大鼓。也叫蜀鼓。",{"a":1,"w":[8711,3352]}],["蠿蟊","zhuōmáo","也作“蝃蝥”。\n即蜘蛛。",{"a":1,"w":[362059,54970]}],["血卦","xuèguà","指《周易》八卦中的坎卦。",{"a":1,"w":[1354,9042]}],["行幰","xíngxiǎn","指行进的车子。幰，车幔。",{"a":1,"w":[8,55854]}],["行庵","xíng'ān","指一种如轿而略大的乘具。",{"a":1,"w":[8,11122]}],["行衙","xíngyá","大吏出行在外的办公处所。",{"a":1,"w":[8,9977]}],["衍辑","yǎnjí","犹广辑。广泛搜罗、编辑。",{"a":1,"w":[8283,8220]}],["街檐","jiēyán","临街房屋向外伸出的屋沿。",{"a":1,"w":[681,9322]}],["冲境","chōngjìng","冲要之地；交通发达地区。",{"