[["海军礼仪","hǎijūn lǐyí","舰艇及其舰员的礼节和仪式。通常有敬礼、悬挂满旗或满灯、分区列队、鸣放礼炮、鸣笛和舰艇下半旗、默哀等形式。分别表示尊敬、庆祝、欢迎、答谢和哀悼。用于日常工作和生活、节日庆典、迎送首长、外事活动及丧礼等。",{"a":1,"w":[4974,15374]}],["舰艇满旗","jiàntǐng mǎnqí","舰艇停泊时在昼间悬挂国旗、军旗，并从舰首通过桅杆横桁至舰尾挂满通信旗的隆重礼仪。通常在重大节日，阅兵，授旗、命名、授予荣誉称号等典礼，以及迎送国家、政府、军队领导人和重要外宾或其他隆重庆祝活动时举行。",{"a":1,"w":[5340,362359]}],["下车战斗","xiàchē zhàndòu","机械化步兵或伞兵离开乘坐的步兵战车、装甲输送车或伞兵战车徒步进行的战斗。通常在地形不利，受敌反坦克火力和障碍物威胁大时采用。步兵战车、装甲输送车或伞兵战车在步兵或伞兵之后跟进或跃进，以火力支援其战斗。",{"a":1,"w":[358,2402]}],["日人民报","rìrén mín bào","(vulgar) derogatory name (in which 日[rì] means 肏[cào]) for the \"People’s Daily\" 人民日报[Rén mín Rì bào]",{"a":1,"w":[105985,7434,1318]}],["月经规则术","yuèjīng guīzé shù","妇女的月经过期两周以内， 不论有无怀孕， 为要使月经来潮， 医师使用特制的容量一百西西空针筒， 前端接上一个塑胶吸头， 伸入子宫腔内， 吸取子宫内的胚胎和子宫内膜等， 以促使月经恢复正常的手术。 这种手术类似人工流产手术， 也可以说是变相的堕胎手术， 不过跟人工流产不同的地方， 是实施人工流产术之对象须有身孕， 同时须作局部或全身麻醉， 月经规则术则没有这么麻烦。",{"a":1,"w":[16216,2482,7471]}],["浪费金钱","làngfèi jīnqián","sink money; waste of money",{"a":1,"w":[1880,5396]}],["研精覃思","yánjīngtánsī","研研究；精细密；覃深入；思思考。精心研究，深入思考。",{"a":1,"w":[96820,14222,7586]}],["斐然向风","fěiránxiàngfēng","翩然地闻风归向。形容人们景仰对方的德政或良好的风尚。",{"a":1,"w":[38484,19631]}],["得尺得寸","déchǐdécùn","得取得，获得。指得到实实在在的好处，得多少就是多少。",{"a":1,"w":[520,2347,3402]}],["赤绳系足","chìshéngjìzú","赤绳红绳；系结、扣。旧指男女双方经由媒人介绍而成亲。",{"a":1,"w":[71912,1277,4625]}],["闹个不休","nào gè bùxiū","cause trouble persistently",{"a":1,"w":[2352,75,12497]}],["傻傻糊糊","shǎ shǎ húhu","[p]coll.[/p] silly; stupid",{"a":1,"w":[3522,14130]}],["链式炉箅","liànshì lúbì","endless grate; chain grate",{"a":1,"w":[13388,20104]}],["广东大青","guǎngdōng dàqīng","Clerodendrum kwangtungense",{"a":1,"w":[11159,12384]}],["拟单鳍鱼","nǐ dānqíyú","Parapriacanthus ransonneti",{"a":1,"w":[7659,204164]}],["两广树参","liǎngguǎng shù cān","Dendropanax parvifloroides",{"a":1,"w":[53957,62625]}],["窄叶青冈","zhǎiyè qīnggāng","Cyclobalanopsis augustinii",{"a":1,"w":[22353,16473]}],["轮叶白前","lúnyè báiqián","Vincetoxicum verticillatum",{"a":1,"w":[14963,24896]}],["内旋转隐斜视","nèixuán zhuǎn yǐn xiéshì","инциклофория, encyclophoria; incyclophoria;