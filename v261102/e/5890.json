08,9523]}],["以忍为阍","yǐrěnwéihūn","用忍耐作门。表示不轻易动怒而出言伤人，以免招来祸患。",{"a":1,"w":[2262,3408,550,15324]}],["遗世绝俗","yíshì juésú","遗世遗弃世间之事。脱离社会独立生活，不跟任何人往来。",{"a":1,"w":[60952,77881]}],["衣被群生","yìbèiqúnshēng","衣被给人衣穿，比喻加惠于人；群生众生。比喻恩惠广施。",{"a":1,"w":[107440,30915]}],["怡声下气","yíshēng xiàqì","怡声声音和悦；下气态度恭顺。形容声音柔和，态度恭顺。",{"a":1,"w":[97409,15411]}],["一步一趋","yībùyīqū","①形容紧跟着行走。②比喻事事模仿和追随别人。超贬意。",{"a":1,"w":[13369,5,8388]}],["摇手触禁","yáoshǒuchùjìn","摇动；触触犯。摇一下手就触犯禁令。比喻法令繁琐苛刻。",{"a":1,"w":[54016,7734,7708]}],["要言妙道","yàoyánmiàodào","要重要，中肯；妙神妙，深微。中肯的名言，深微的道理。",{"a":1,"w":[47041,4764,511]}],["羊羔美酒","yánggāoměijiǔ","羊羔酒名，因酿制材料中有羊肉，故名。味儿醇厚的好酒。",{"a":1,"w":[29627,62153]}],["燕俦莺侣","yànchóuyīnglǚ","比喻年轻的女伴。也比喻相爱的青年男女。同燕侣莺俦”。",{"a":1,"w":[7821,14795,8499,10478]}],["燕舞莺歌","yànwǔyīnggē","燕子在飞舞，黄莺在鸣叫。形容春光明媚。同燕舞莺啼”。",{"a":1,"w":[7821,3356,60102]}],["言信行果","yánxìnxíngguǒ","说了就一定守信用，做事一定办到。同言必信，行必果。”",{"a":1,"w":[7440,43726,7445]}],["岩居川观","yánjūchuānguān","居于岩穴而观赏川流。形容隐居生活悠闲自适，超然世外。",{"a":1,"w":[138284,322925]}],["寻花觅柳","xúnhuā mì liǔ","原指赏玩春天的景色◇旧小说用来指宿娼。同寻花问柳”。",{"a":1,"w":[41592,10275,7802]}],["学疏才浅","xuéshūcáiqiǎn","才能不高，学识不深（多用作自谦的话）。同学浅才疏”。",{"a":1,"w":[13,7743,603,2400]}],["血泪盈襟","xuèlèiyíngjīn","血泪悲痛的眼泪；盈满。眼泪流湿了衣襟。形容非常悲痛。",{"a":1,"w":[60806,8251,8612]}],["休明盛世","xiūmíngshèngshì","休明美好，清平；盛兴旺；世世代。美好清平的兴盛时代。",{"a":1,"w":[200034,37106]}],["朽竹篙舟","xiǔ zhúgāo zhōu","烂竹竿作篙推舟。比喻做事的工具或条件不佳，难能成就。",{"a":1,"w":[9194,400918,4790]}],["褎然举首","yòurán jǔshǒu","褎然出众的样子；举推举；首第一。指人的才能超出同辈。",{"a":1,"w":[226647,134350]}],["星飞电急","xīngfēi diàn jí","如流星飞落，如闪电急驰。形容十分急速或事情非常紧急。",{"a":1,"w":[45493,12,569]}],["腥闻在上","xīngwénzàishàng","腥闻原指酒肉的腥味，引伸为丑恶的名声。比喻丑名远扬。",{"a":1,"w":[291930,16462]}],["刑余之人","xíngyú zhī rén","余以后。指太监或受过宫刑的人。也指其他受刑致残的人。",{"a":1,"w":[148649,2254,3]}],["销魂夺魄","xiāohún duópò","神魂颠倒，失去常态。形容因羡慕或爱好某种事物而着迷。",{"a":1,"w":[64819,205215]}],["效颦学步","xiàopín xuébù","比喻盲目模仿而弄巧成拙。亦作东施效颦”、邯郸学步”。",{"a":1,"w":[27607,41206]}],["相鼠有皮","xiàngshǔyǒupí","相视。看看老鼠尚且还有皮。旧指人须知廉耻，要讲礼义。",{"a":1,"w":[7427,3351,14,1291]}],