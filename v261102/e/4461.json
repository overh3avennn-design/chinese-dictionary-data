:[7788,603]}],["雅韶","yǎsháo","雅乐和《韶》乐。泛指雅正的乐曲。",{"a":1,"w":[7788,10368]}],["集本","jíběn","1) 集子。\n2) 聚集的资本。",{"a":1,"w":[4628,42]}],["隽味","juànwèi","1) 美味。\n2) 深长的意味。",{"a":1,"w":[15963,7712]}],["隽爽","juànshuǎng","I\n优美明快。\nII\n英俊豪爽。",{"a":1,"w":[15963,4855]}],["雍父","yōngfù","传说中黄帝的臣僚，杵臼的发明者。",{"a":1,"w":[9147,7846]}],["雕钻","diāozuān","1) 谓刻意钻营。\n2) 刁钻。",{"a":1,"w":[8192,4692]}],["双隗","shuāngkuí","指春秋时廧咎如之二女叔隗、季隗。",{"a":1,"w":[1309,42025]}],["雚苇","guànwěi","1) 荻和苇。\n2) 泛指芦苇。",{"a":1,"w":[130388,9735]}],["杂犯","záfàn","古代指各专类罪名以外的其他罪名。",{"a":1,"w":[4680,4667]}],["杂经","zájīng","隋智果所分佛经三大类别中之一类。",{"a":1,"w":[4680,7421]}],["离枝","lízhī","I\n古国名。\nII\n见“离支”。",{"a":1,"w":[543,4696]}],["雩泉","yúquán","泉名。在山东省诸城市西南常山上。",{"a":1,"w":[16328,3461]}],["雩禜","yúyǒng","亦作“雩宗”。\n祭水旱之神的坛。",{"a":1,"w":[16328,108923]}],["雪帆","xuěfān","白色船帆。借指挂白色船帆的船只。",{"a":1,"w":[616,8810]}],["雪桃","xuětáo","1) 揩拭桃子。\n2) 水果名。",{"a":1,"w":[616,3386]}],["雪氅","xuěchǎng","用白色鸟羽制成的外套。也称鹤氅。",{"a":1,"w":[616,19516]}],["云垒","yúnlěi","1) 汉代官名。\n2) 指兵营。",{"a":1,"w":[554,8785]}],["云甍","yúnméng","高耸入云的屋脊。借指高大的房屋。",{"a":1,"w":[554,59641]}],["云纪","yúnjì","传说黄帝受命有云瑞，故以云纪事。",{"a":1,"w":[554,7653]}],["云虎","yúnhǔ","谓云龙风虎。比喻圣主贤臣之遇合。",{"a":1,"w":[554,3337]}],["云衲","yúnnà","1) 僧衣。\n2) 借指行脚僧。",{"a":1,"w":[554,13498]}],["零谢","língxiè","1) 凋落。\n2) 比喻人死亡。",{"a":1,"w":[181,7570]}],["雷毂","léigǔ","隆隆作响的车轮声。泛指轰隆之声。",{"a":1,"w":[3319,9869]}],["雷野","léiyě","谓战车的隆隆之声如雷般震动原野。",{"a":1,"w":[3319,4626]}],["电沫","diànmò","闪电和泡沫。比喻极易消失的事物。",{"a":1,"w":[12,8693]}],["震訇","zhènhōng","隆隆的雷声。喻皇帝的言论命令等。",{"a":1,"w":[7751,16185]}],["霜干","shuānggàn","亦作“霜干”。\n傲霜挺立的树干。",{"a":1,"w":[8258,46]}],["霜柑","shuānggān","指柑橘。因柑橘经霜后成熟，故称。",{"a":1,"w":[8258,9761]}],["霜籁","shuānglài","秋籁，秋声。草木摇落的肃杀之声。",{"a":1,"w":[8258,19549]}],["霜绡","shuāngxiāo","白绫。亦指画在白色绫子上的真容。",{"a":1,"w":[8258,22878]}],["霜霰","shuāngxiàn","1) 霜和霰。\n2) 喻恶势力。",{"a":1,"w":[8258,12446]}],["霜髭","shuāngzī","1) 白须。\n2) 指胡须变白。",{"a":1,"w":[8258,11579]}],["霞宿","xiásù","如同云霞的止宿。指无固定的住所。",{"a":1,"w":[4805,7825]}],["霞晕","xiáyūn","1) 彩霞。\n2) 脸上的红晕。",{"a":1,"w":[4805,3516]}],["霞色","xiásè","1) 云霞的颜色。\n2) 彩色。",{"a":1,"w":[4805,2266]}],["雾廓","wùkuò","廓清阴霾。喻平定叛乱，消除灾晦。",{"a":1,"w":[3421,9651]}],["露庭","lùtíng","庭院，院子。上无任何遮盖，故称。",{"a":1,"w":[4674,7760]}],["露辋","lùwǎng","即露车。辋，车轮的周边，借指车。",{"a":1,"w":[4674,30073]}],["霸楚","bàchǔ","指项羽。因曾自封西楚霸王，故称。",{"a":1,"w":[8096,7905]}],["灵姿","língzī","美好的姿态。亦指姿态优美的身躯。",{"a":1,"w":[7588,8460]}],["灵桃","língtáo","传说中的仙桃。三千年结一次果实。",{"a":1,"w":[7588,3386]}],["灵笈","língjí","装仙道秘籍的箱子。亦指仙道秘籍。",{"a":1,"w":[7588,20039]}],["灵镜","língjìng","即玉衡。古代用以观测星象的仪器。",{"a":1,"w":[7588,7535]}],["青夜","qīngyè","清夜。寂静的深夜。青，通“清”。",{"a":1,"w":[3320,631]}],["青幡","qīngfān","古代春令作劝耕、护花等用的青旗。",{"a":1,"w":[3320,10797]}],["青琼","qīngqióng","1) 即碧玉。\n2) 喻指茶叶。",{"a":1,"w":[3320,8471]}],["青篽","qīngyù","竹制的捕鸟笼子。借指笼养的鸟儿。",{"a":1,"w":[3320]}],["青缗","qīngmín","古代穿铜钱的青丝绳。亦借指钱币。",{"a":1,"w":[3320,16335]}],["青肝","qīnggān","指肝。肝属东方木位，主青，故称。",{"a":1,"w":[3320,4739]}],["青荼","qīngtú","青蓼。蔬类食物。味苦，食之明目。",{"a":1,"w":[3320,9963]}],["青闺","qīngguī","涂饰青漆的闺房。形容其豪华精致。",{"a":1,"w":[3320,9497]}],["青黎","qīnglí","1) 青黑色。\n2) 泛指土色。",{"a":1,"w":[3320,8227]}],["靖冥","jìngmíng","犹静暝。宁静幽深。靖，通“静”。",{"a":1,"w":[9378,8508]}],["靖柝","jìngtuò","停止击柝。谓太平无事，不须警戒。",{"a":1,"w":[9378,17914]}],["静慧","jìnghuì","佛教语。安静之智慧；清净之智慧。",{"a":1,"w":[1386,8718]}],["静棂","jìnglíng","坛静(道家奉经修事之处)的窗棂。",{"a":1,"w":[1386,21596]}],["静翳","jìngyì","1) 犹沉默。\n2) 寂静隐蔽。",{"a":1,"w":[1386,9715]}],["非觊","fēijì","非分的冀望。多指觊觎、谋夺帝位。",{"a":1,"w":[2265,28024]}],["靶牌","bǎpái","即靶子。练习射击或射箭的目标牌。",{"a":1,"w":[8964,2344]}],["靸拔","sǎbá","旧式鞋子后跟上的襻子，拔鞋时用。",{"a":1,"w":[41738,3360]}],["鞠院","jūyuàn","古代球场。四周以墙围成院，故称。",{"a":1,"w":[10161,571]}],["鞶缨","pányīng","古代天子诸侯或显贵者挽马的带饰。",{"a":1,"w":[31226,9033]}],["鞯汗","jiānhàn","鞍鞯。其饰垂于马的汗沟处，故称。",{"a":1,"w":[69812,2403]}],["韩才","háncái","谓西汉韩信的材质。才，通“材”。",{"a":1,"w":[8332,603]}],["韩杜","hándù","唐代古文家韩愈和诗人杜甫的并称。",{"a":1,"w":[8332,7680]}],["韬藉","tāojí","指衬垫包裹物品的布、缎之类东西。",{"a":1,"w":[11243,8459]}],["韶妙","sháomiào","1) 美妙。\n2) 指年少之时。",{"a":1,"w":[10368,4764]}],["韵令","yùnlìng","1) 词牌名。\n2) 泛指词曲。",{"a":1,"w":[8313,3329]}],["韵牌","yùnpái","标有诗韵的牌子。供作诗限韵之用。",{"a":1,"w":[8313,2344]}],["顶债","dǐngzhài","1) 承担债务。\n2) 犹抵债。",{"a":1,"w":[2298,4698]}],["项浦","xiàngpǔ","掩浦的别名。在今浙江省湖州市境。",{"a":1,"w":[2342,8719]}],["顺俯","shùnfǔ","俯身顺从。指接受民众意见、要求。",{"a":1,"w":[4660,8380]}],["顺羽","shùnyǔ","手贴着矢羽由上而下，将矢羽理齐。",{"a":1,"w":[4660,7878]}],["顺说","shùnshuō","顺着次序述说。亦谓顺着道理述说。",{"a":1,"w":[4660,68]}],["顽话","wánhuà","玩话，嬉笑的言语。顽，通“玩”。",{"a":1,"w":[8595,120]}],["顿毙","dùnbì","1) 倒毙。\n2) 指倒毙的人。",{"a":1,"w":[1370,9775]}],["顿杨","dùnyáng","明代金陵名妓顿文、杨玉香的并称。",{"a":1,"w":[1370,8318]}],["顿用","dùnyòng","谓使用后而不锋利。顿，通“钝”。",{"a":1,"w":[1370,26]}],["颇李","pǒlǐ","战国时赵国名将廉颇与李牧的并称。",{"a":1,"w":[4897,7880]}],["领首","lǐngshǒu","1) 带头。\n2) 指带头的人。",{"a":1,"w":[1361,2310]}],["颉斤","jiéjīn","唐代突厥族官名，又译为“俟斤”。",{"a":1,"w":[12843,714]}],["颔头","hàntóu","点头。表示允诺、赞许、领会等意。",{"a":1,"w":[12334,509]}],["颓挫","tuícuò","1) 坍塌挫毁。\n2) 犹颓折。",{"a":1,"w":[8639,8947]}],["颓敝","tuíbì","1) 破败。\n2) 败坏；衰敝。",{"a":1,"w":[8639,8875]}],["顉颐","qīnyí","下巴骨微向前伸貌。顉，通“顩”。",{"a":1,"w":[137110,9868]}],["颜柳","yánliǔ","唐代书法家颜真卿和柳公权的并称。",{"a":1,"w":[8117,7802]}],["颛君","zhuānjūn","谓专固君宠而擅权。颛，通“专”。",{"a":1,"w":[11459,7831]}],["颛学","zhuānxué","指自成一家的论述。颛，通“专”。",{"a":1,"w":[11459,13]}],["愿醮","yuànjiào","谓祈求神佛时许下设坛祭祀的愿心。",{"a":1,"w":[3393,12871]}],["颠堕","diānduò","1) 坠落。\n2) 见“颠隳”。",{"a":1,"w":[8660,8768]}],["颠实","diānshí","阗实。充实；塞满。颠，通“阗”。",{"a":1,"w":[8660,7457]}],["显应","xiǎnyīng","1) 显示感应。\n2) 犹显灵。",{"a":1,"w":[3347,2264]}],["显谥","xiǎnshì","昭彰帝王贵族大臣生前事迹的称号。",{"a":1,"w":[3347,19720]}],["风劝","fēngquàn","用委婉含蓄的方式进行开导、劝勉。",{"a":1,"w":[44,3484]}],["风瓢","fēngpiáo","指水瓢。古代常用以借指隐居生活。",{"a":1,"w":[44,9986]}],["风瘵","fēngzhài","指由致病因素“风”而引起的疾病。",{"a":1,"w":[44,20098]}],["风磴","fēngdèng","指山岩上的石级。岩高多风，故称。",{"a":1,"w":[44,17114]}],["风馨","fēngxīn","1) 风飘香气。\n2) 犹流芳。",{"a":1,"w":[44,9550]}],["风驭","fēngyù","指古代神话传说中由风驾驭的神车。",{"a":1,"w":[44,11578]}],["颬颬","xiāxiā","1) 张口吐气貌。\n2) 风声。",{"a":1}],["飘决","piāojué","指被洪水冲毁漂走。飘，通“漂”。",{"a":1,"w":[3467,7574]}],["飘齑","piāojī","切碎的菜末，用来加在其他菜肴上。",{"a":1,"w":[3467,23399]}],["飙骇","biāohài","1) 风猛。\n2) 谓迅猛兴起。",{"a":1,"w":[11470,9473]}],["飞甍","fēiméng","1) 指飞檐。\n2) 借指高楼。",{"a":1,"w":[56,59641]}],["飞产","fēichǎn","指隐匿田产，逃避赋役的一种手法。",{"a":1,"w":[56,7441]}],["飞翻","fēifān","1) 飞翔翻腾。\n2) 谓翻落。",{"a":1,"w":[56,2337]}],["飞诏","fēizhào","1) 指诏书。\n2) 飞传诏书。",{"a":1,"w":[56,9242]}],["食祭","shíjì","古礼，饮食前以少量酒食祭献先代。",{"a":1,"w":[7466,8417]}],["食称","shíchēng","粮食与人口相称。指百姓不缺口粮。",{"a":1,"w":[7466,613]}],["飧钱","sūnqián","古代于俸禄之外赐给官吏的饭食钱。",{"a":1,"w":[13243,138]}],["饬刑","chìxíng","饬正刑法。一说谓修缮监狱、刑具。",{"a":1,"w":[9634,7716]}],["饬牲","chìshēng","陈设祭祀用的牲畜。饬，通“饰”。",{"a":1,"w":[9634,9334]}],["饱阅","bǎoyuè","1) 尽情看。\n2) 充分经历。",{"a":1,"w":[654,8211]}],["饰巧","shìqiǎo","1) 装饰奇丽。\n2) 犹弄巧。",{"a":1,"w":[7951,1421]}],["饰治","shìzhì","1) 犹精制。\n2) 粉饰太平。",{"a":1,"w":[7951,2283]}],["饰美","shìměi","1) 打扮得漂亮。\n2) 华美。",{"a":1,"w":[7951,1310]}],["养茶","yǎngchá","谓以适度的沸水烹茶而使茶味纯正。",{"a":1,"w":[582,157]}],["餐玉","cānyù","服食玉屑。古代传说仙家以此延寿。",{"a":1,"w":[4763,2294]}],["余滥","yúlàn","谓笨而又不检点。余，用同“愚”。",{"a":1,"w":[7597,8319]}],["余苗","yúmiáo","1) 犹后裔。\n2) 各种禾苗。",{"a":1,"w":[7597,7980]}],["余躅","yúzhú","留下的足迹。比喻先人制订的法规。",{"a":1,"w":[7597,11359]}],["饧眼","tángyǎn","目光凝滞、蒙胧，半睁半闭的样子。",{"a":1,"w":[15398,551]}],["饶勇","ráoyǒng","1) 勇猛。\n2) 指骁勇的人。",{"a":1,"w":[8550,8286]}],["饶乐","ráolè","1) 犹逸乐。\n2) 富饶安乐。",{"a":1,"w":[8550,1340]}],["飨奠","xiǎngdiàn","祭奠。设酒食以祭。飨，通“享”。",{"a":1,"w":[11128,9667]}],["香绵","xiāngmián","1) 上等丝绵。\n2) 指柳絮。",{"a":1,"w":[1311,8228]}],["香钿","xiāngdiàn","古时妇女贴在额上鬓颊饰物的美称。",{"a":1,"w":[1311,14893]}],["马下","mǎxià","1) 神名。\n2) 指去官赋闲。",{"a":1,"w":[1273,17]}],["马赵","mǎzhào","三国时蜀国大将马超、赵云的并称。",{"a":1,"w":[1273,8536]}],["驮架","tuójià","安放在牲口背上用于驮东西的架子。",{"a":1,"w":[10335,1341]}],["驰恋","chíliàn","书信中用以表示对对方的向往思慕。",{"a":1,"w":[8375,8204]}],["驰溯","chísù","书信用语。表示对对方的向往思慕。",{"a":1,"w":[8375,10662]}],["驳辨","bóbiàn","1) 驳正辨明。\n2) 指争辩。",{"a":1,"w":[8526,8004]}],["驳阴","bóyīn","由于枝叶疏密而形成的斑驳的树阴。",{"a":1,"w":[8526,576]}],["骀藉","dàijí","I\n犹枕藉。\nII\n践踏；蹂躏。",{"a":1,"w":[16968,8459]}],["骇服","hàifú","亦作“駴服”。\n惊佩；惊讶诚服。",{"a":1,"w":[9473,4619]}],["駻突","hàntū","1) 指凶悍的马。\n2) 凶悍。",{"a":1,"w":[45741,7750]}],["骞期","qiānqī","失期，约期而失信。骞，通“愆”。",{"a":1,"w":[13269,1299]}],["骞骧","qiānxiāng","升腾。谓地位高升。骞，通“骞”。",{"a":1,"w":[13269,18267]}],["腾掷","téngzhì","1) 向上飞起貌。\n2) 腾跳。",{"a":1,"w":[7985,8819]}],["腾文","téngwén","1) 犹行文。\n2) 呈现文采。",{"a":1,"w":[7985,7415]}],["腾移","téngyí","1) 移动，迁移。\n2) 挪用。",{"a":1,"w":[7985,2306]}],["骖驔","cāndiàn","1) 马奔跑貌。\n2) 犹相随。",{"a":1,"w":[14958,125010]}],["驿信","yìxìn","驿使传递的信件。借指亲友的音信。",{"a":1,"w":[9950,529]}],["驿堠","yìhòu","古时筑在驿道旁用以计里程的土坛。",{"a":1,"w":[9950,18467]}],["驿禀","yìbǐng","谓驿站所需的经费。禀，通“廪”。",{"a":1,"w":[9950,9733]}],["驿络","yìluò","犹络绎。连续不断。驿，通“绎”。",{"a":1,"w":[9950,7837]}],["骰局","tóujú","用骰子进行赌博或游戏的一种集会。",{"a":1,"w":[27297,2291]}],["骴骨","cīgǔ","亦作“髊骨”。\n肉未烂光的骸骨。",{"a":1,"w":[73800,7537]}],["体当","tǐdāng","I\n犹体会。\nII\n谓治政得当。",{"a":1,"w":[7417,552]}],["体趣","tǐqù","1) 旨趣。\n2) 字体的风格。",{"a":1,"w":[7417,8238]}],["高揭","gāojiē","1) 犹高耸。\n2) 高高张贴。",{"a":1,"w":[35,4831]}],["高眠","gāomián","1) 高枕安眠。\n2) 指闲居。",{"a":1,"w":[35,8260]}],["高阜","gāofù","1) 高的土山。\n2) 犹高起。",{"a":1,"w":[35,9656]}],["髡裸","kūnluǒ","谓脱去衣帽，剃去头发，露顶光身。",{"a":1,"w":[28259,8384]}],["髡釱","kūndì","剃发并带上脚镣。古代的一种刑罚。",{"a":1,"w":[28259]}],["斗凑","dòucòu","1) 凑合。\n2) 连接，拼合。",{"a":1,"w":[7477,8789]}],["斗穴","dòuxué","以浅识竞胜。穴，穴见，一孔之见。",{"a":1,"w":[7477,8147]}],["闹茶","nàochá","1) 沏茶。\n2) 犹言闹新房。",{"a":1,"w":[2352,157]}],["闹麻","nàomá","方言。犹言闹翻天。形容气氛紧张。",{"a":1,"w":[2352,7550]}],["郁没","yùméi","1) 湮灭。\n2) 指郁悒而亡。",{"a":1,"w":[8084,94]}],["郁黩","yùdú","谓因某种物质薀积而产生侵蚀作用。",{"a":1,"w":[8084,11772]}],["鬼躁","guǐzào","指人将死前形体所表现的一种病态。",{"a":1,"w":[3340,9259]}],["魁硕","kuíshuò","1) 壮伟貌。\n2) 指大学者。",{"a":1,"w":[8560,9637]}],["魄兔","pòtù","传说中的月中白兔。魄，通“霸”。",{"a":1,"w":[9063,3426]}],["魄蜍","pòchú","传说中月中的蟾蜍。魄，通“霸”。",{"a":1,"w":[9063,16603]}],["魏两","wèiliǎng","魏太子。亦特指曹丕。两，贰；副。",{"a":1,"w":[8322,96]}],["魔民","mómín","佛教指魔界之民众，不入正道的鬼。",{"a":1,"w":[7979,7434]}],["魔浆","mójiāng","指酒。佛教认为饮酒不能修成正果。",{"a":1,"w":[7979,7883]}],["魔魅","mómèi","1) 魔鬼。\n2) 喻邪恶势力。",{"a":1,"w":[7979,10470]}],["魇蛊","yǎngǔ","以巫术、妖术使人遭灾或神智迷糊。",{"a":1,"w":[19742,10485]}],["鲲鸡","kūnjī","即《鶤鸡》。琴曲名。属古相和歌。",{"a":1,"w":[18397,578]}],["鲰士","zōushì","学识浅陋的书生。多作自称的谦词。",{"a":1,"w":[41788,7542]}],["鳖封","biēfēng","传说中的怪兽名。有两首，形似猪。",{"a":1,"w":[10009,600]}],["鸟旗","niǎoqí","古代军队旗帜的一种。旗上画鸟隼。",{"a":1,"w":[581,7796]}],["鸟服","niǎofú","《史记‧夏本纪》：“鸟夷皮服。”",{"a":1,"w":[581,4619]}],["鸠雨","jiūyǔ","下雨时节。俗谓鸠鸣为雨候，因称。",{"a":1,"w":[8570,159]}],["凤卣","fèngyǒu","古代盛酒器。以铸成凤凰形，故称。",{"a":1,"w":[7768,60440]}],["凤屏","fèngpíng","雕绘凤凰等饰物的屏风。置于床头。",{"a":1,"w":[7768,7852]}],["凤曲","fèngqū","本指萧史故事。后泛指美妙的乐曲。",{"a":1,"w":[7768,7517]}],["凤条","fèngtiáo","指梧桐枝。传说凤非梧不栖，因称。",{"a":1,"w":[7768,556]}],["凤盉","fènghé","古代酒器。因铸有凤形饰物，故名。",{"a":1,"w":[7768,123266]}],["凤簪","fèngzān","华美的簪。其上有凤形雕饰，因称。",{"a":1,"w":[7768,9760]}],["凤音","fèngyīn","比喻美妙的音乐。多指笙箫等细乐。",{"a":1,"w":[7768,7498]}],["鸣盛","míngshèng","1) 谓歌颂盛世。\n2) 着称。",{"a":1,"w":[7935,4746]}],["鸦忽","yāhū","源于阿拉伯语yāqūt。宝石名。",{"a":1,"w":[8753,8123]}],["鸮王","xiāowáng","鸮鸟之王。比喻凶狠专横的统治者。",{"a":1,"w":[11204,2278]}],["鸱苕","chīsháo","威猛的鸱鸟。苕，通“迢”。高貌。",{"a":1,"w":[12921,13004]}],["鸿化","hónghuà","宏大的教化。旧时歌颂帝王的套语。",{"a":1,"w":[8788,1272]}],["鸿池","hóngchí","池名。故址在今河南洛阳东二十里。",{"a":1,"w":[8788,7815]}],["鹅子","ézi","1) 鹅蛋。\n2) 雏鹅；小鹅。",{"a":1,"w":[8359,1]}],["鹄俟","gǔqí","如鹄引颈翘首而待。形容盼望殷切。",{"a":1,"w":[10801,13324]}],["鹄鹤","gǔhè","鹄和鹤。同以善高飞而羽洁白着称。",{"a":1,"w":[10801,8240]}],["鹏蜩","péngtiáo","鹏鸟和知了。比喻大小悬殊之二物。",{"a":1,"w":[10885,24051]}],["鹏虱","péngshī","大鹏与虱子。比喻大小悬殊之二物。",{"a":1,"w":[10885,9142]}],["鹏雕","péngdiāo","泛指能远举高飞的大鸟。比喻高位。",{"a":1,"w":[10885,8192]}],["鹊岸","què'àn","古地名。在今安徽铜陵西南鹊头镇。",{"a":1,"w":[9090,3418]}],["鹊岩","quèyán","岩名。在陕西省长安县南之韦曲山。",{"a":1,"w":[9090,7558]}],["莺帘","yīnglián","指歌者所居之帘幕。莺，比喻歌者。",{"a":1,"w":[8499,8925]}],["鹤位","hèwèi","《左传‧闵公二年》：“狄人伐卫。",{"a":1,"w":[8240,545]}],["鹤散","hèsàn","悠然自得貌。鹤态闲散自适，故称。",{"a":1,"w":[8240,2286]}],["鹤江","hèjiāng","水名。即今之吴淞江，也称苏州河。",{"a":1,"w":[8240,2327]}],["鹤版","hèbǎn","亦作“鹤板”。\n征聘贤士的诏书。",{"a":1,"w":[8240,3362]}],["鹤目","hèmù","鹤的眼睛。借指修道者的仙家气质。",{"a":1,"w":[8240,7465]}],["鹤篆","hèzhuàn","鹤的爪印。其形迹如同篆书，因称。",{"a":1,"w":[8240,9979]}],["鹤老","hèlǎo","鹤龄长，比喻有道者、隐逸者年老。",{"a":1,"w":[8240,55]}],["鹤静","hèjìng","鹤性安静，不躁动。有时泛指清静。",{"a":1,"w":[8240,1386]}],["鹤鸾","hèluán","鹤和鸾凤。皆为传说中仙人的坐骑。",{"a":1,"w":[8240,9528]}],["鸷腾","zhìténg","如鸷鸟飞腾。形容战士骁勇、迅猛。",{"a":1,"w":[12445,7985]}],["鹦螺","yīngluó","1) 鹦鹉螺。\n2) 指鹦鹉杯。",{"a":1,"w":[8422,7596]}],["鸾弦","luánxián","琴弦的美称。因琴声如鸾鸣，故称。",{"a":1,"w":[9528,4726]}],["鸾舟","luánzhōu","华美的游船。船首刻有飞鸾，故称。",{"a":1,"w":[9528,4790]}],["盐齑","yánjī","切碎后腌渍的菜。常喻指生活清苦。",{"a":1,"w":[2404,23399]}],["鹿觡","lùgé","1) 悬物的钩。\n2) 鹿的角。",{"a":1,"w":[8199,142535]}],["麟书","línshū","即麒麟书。后为对别人文字的尊称。",{"a":1,"w":[8990,81]}],["麟馔","línzhuàn","用麒麟肉作的肴馔。比喻珍贵食品。",{"a":1,"w":[8990,10570]}],["麡床","qíchuáng","以麡狼角做的坐床。后亦泛指坐床。",{"a":1,"w":[183]}],["麻絇","máqú","以麻线做成的可以穿系鞋带的鞋饰。",{"a":1,"w":[7550,35412]}],["黄墟","huángxū","1) 犹黄垆。\n2) 古代地名。",{"a":1,"w":[530,11687]}],["黄族","huángzú","1) 指黄种人。\n2) 指汉族。",{"a":1,"w":[530,4632]}],["黄犊","huángdú","1) 小牛。\n2) 蜗牛的别称。",{"a":1,"w":[530,10334]}],["黄卢","huánglú","1) 见“黄垆”。\n2) 水名。",{"a":1,"w":[530,7791]}],["黄骊","huánglí","《诗‧鲁颂‧駉》：“有黄有骊。”",{"a":1,"w":[530,10672]}],["黄麾","huánghuī","古代天子或大臣所乘车舆的装饰品。",{"a":1,"w":[530,12053]}],["黏接","niánjiē","谓以黏性糊状物将物体连接在一起。",{"a":1,"w":[8548,548]}],["黏牡","niánmǔ","谓以饴黏在门闩上，以便开启门户。",{"a":1,"w":[8548,8408]}],["黑蛟","hēijiāo","1) 黑色的蛟。\n2) 指墨汁。",{"a":1,"w":[549,14013]}],["黜削","chùxuē","罢免，削除。多指地位、官职而言。",{"a":1,"w":[10029,4765]}],["点逗","diǎndòu","本谓句读标点，亦用以指叙述写作。",{"a":1,"w":[64,3573]}],["黻裳","fúshang","古代祭服。绣有青黑色花纹的下裳。",{"a":1,"w":[25397,9272]}],["黼翣","fǔshà","古代出丧时所用的棺饰，上画斧形。",{"a":1,"w":[19936,24163]}],["鳌天","áotiān","传说中以鳌足为天柱所支撑的天体。",{"a":1,"w":[13761,19]}],["鳌海","áohǎi","大海。传说中鳌为海中神龟，因称。",{"a":1,"w":[13761,528]}],["鳌甲","áojiǎ","犹鼎甲。状元、榜眼、探花的合称。",{"a":1,"w":[13761,3330]}],["鼎札","dǐngzhá","犹大札。旧时书信中敬称人的来信。",{