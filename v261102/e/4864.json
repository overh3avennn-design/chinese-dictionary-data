:1,"w":[91267,2258]}],["招魂葬","zhāohún zàng","谓人死而不得其尸，用其生前所着衣冠，招其魂而葬。",{"a":1,"w":[40692,8823]}],["挂搭僧","guàdā sēng","亦作“挂搭僧”。\n1) 游方和尚。\n2) 替身。",{"a":1,"w":[87154,8830]}],["舍身崖","shěshēn yá","泰山崖名。旧时信佛者谓投身崖下可脱诸罪而登彼岸。",{"a":1,"w":[49561,8942]}],["扑剌剌","pū làlà","1) 象声词。多形容禽鸟拍翅声。\n2) 急奔貌。",{"a":1,"w":[4767,16114]}],["败龟板","bài guībǎn","龟甲的别名。见明李时珍《本草纲目‧介一‧龟甲》。",{"a":1,"w":[2345,79467]}],["文源阁","wényuángé","清代专藏《四库全书》的书阁之一。在北京圆明园内。",{"a":1,"w":[7415,7816,8208]}],["斜行字","xiéxíngzì","指飞行的雁阵。大雁飞行时多排成“人”字形，故称。",{"a":1,"w":[3361,8,84]}],["新文艺","xīnwén yì","指文学革命以后的文艺作品，如新诗、小说、戏剧等。",{"a":1,"w":[28998,7650]}],["日天子","rìtiān zi","佛教称观世音菩萨的化身。也称宝光天子、宝意天子。",{"a":1,"w":[52118,1]}],["昌华苑","chānghuá yuàn","五代时南汉于唐荔园故址修建的苑囿。在今广州市内。",{"a":1,"w":[753182,9274]}],["昔昔盐","xīxī yán","乐府曲辞名。始见于隋薛道衡。昔昔即夕夕。盐即引。",{"a":1,"w":[110925,2404]}],["昭信票","zhāo xìnpiào","清政府为偿付对日赔款于1898年发行的国内公债。",{"a":1,"w":[8522,190562]}],["昭君村","zhāojūn cūn","地名。在今湖北省兴山县南，相传为汉王昭君的故乡。",{"a":1,"w":[34567,1430]}],["时世装","shíshì zhuāng","1) 当代通行的服饰打扮。\n2) 同“时世妆”。",{"a":1,"w":[36629,532]}],["曲江会","qǔjiāng huì","唐时考中的进士，放榜后大宴于曲江亭，谓之曲江会。",{"a":1,"w":[152677,18]}],["会武宴","huìwǔyàn","行科举制度时，武科殿试放榜后，在兵部举行的公宴。",{"a":1,"w":[18,7504,8323]}],["有清头","yǒu qīngtou","1) 头脑清楚。\n2) 方言。懂得事理；有分寸。",{"a":1,"w":[14,38619]}],["木珊瑚","mù shānhú","枳椇的别名。见明李时珍《本草纲目‧果三‧枳椇》。",{"a":1,"w":[7435,9224]}],["木连理","mù liánlǐ","不同根的树，其上部枝干连生在一起。旧时视为祥瑞。",{"a":1,"w":[7435,21312]}],["杜陵屋","dù língwū","唐杜甫有《茅屋为秋风所破歌》，后因指破旧的房屋。",{"a":1,"w":[7680,215539]}],["杜丽娘","dùlìniáng","明汤显祖戏曲《牡丹亭》中的女主角，死而还魂复生。",{"a":1,"w":[7680,7634,8089]}],["东南美","dōngnán měi","《尔雅‧释地》：“东南之美者，有会稽之竹箭焉。”",{"a":1,"w":[895,1310]}],["桑根线","sānggēn xiàn","用桑根皮长纤维制成的线。古时作外科缝合手术用线。",{"a":1,"w":[158065,1282]}],["桔柏渡","júbǎidù","古渡名。在四川省昭化县境内白水江与嘉陵江合流处。",{"a":1,"w":[10740,7948,4780]}],["梅花坞","méihuā wù","地名。在江苏省宜兴县东南三十里。以盛植梅花着名。",{"a":1,"w":[5007,10171]}],["梵亚林","fàn yàlín","[英violin]或译作梵婀玲、梵哑铃。小提琴。",{"a":1,"w":[9152,56512]}],["栎橿子","lìjiāngzi","槲实的别名。见明李时珍《本草纲目‧果二‧槲实》。",{"a":1,"w":[9104,32097,1]}],["水火棍","shuǐhuǒgùn","旧时衙门差役所使用的上黑下红、上圆下略扁的木棍。",{"a":1,"w":[13036,8412]}],["水烟师","shuǐyān shī","旧时在庆吊礼仪中专司招待，给来宾倒茶、装烟的人。",{"a":1,"w":[22980,7489]}],["河泊所","hépōsuǒ","元代在建康、安庆、池州等处设置的掌收鱼税的官署。",{"a":1,"w":[585,8463,1281]}],["油炸桧","yóuzhá guì","即油炸果。相传老百姓痛恨南宋奸臣秦桧，故有此称。",{"a":1,"w":[4031,11378]}],["海龙君","hǎilóng jūn","即海龙王。传说龙宫中多珠宝，因用以喻极豪富的人。",{"a":1,"w":[24798,7831]}],["满本房","mǎnběnfáng","清代内阁属署，专处理满文文件的缮写、校阅等事务。",{"a":1,"w":[592,42,7555]}],["乌黑黑","wūhēi hēi","1) 犹黑压压。形容密集的人。\n2) 形容黑色。",{"a":1,"w":[6725,549]}],["无梁桶","wúliáng tǒng","桶无梁则提不起，故以“无梁桶”为“别提”的隐语。",{"a":1,"w":[51997,8593]}],["焦崖阁","jiāoyágé","古蜀道中的阁道名。在今陕西省洋县北五十里焦崖山。",{"a":1,"w":[7697,8942,8208]}],["烦恼薪","fánnǎo xīn","佛教语。烦恼遇智慧则灭，如薪逢火即烬，因以为喻。",{"a":1,"w":[2866,8398]}],["玉樊堂","yùfántáng","明夏完淳着有《玉樊堂词》，故后以玉樊堂指夏完淳。",{"a":1,"w":[2294,12033,7695]}],["玉菌子","yù jùnzi","菌类植物名。以其柄白色，伞灰色，晶莹如玉，故名。",{"a":1,"w":[2294,250336]}],["王子表","wángzǐ biǎo","《汉书》有《王子侯表》。借指记载帝王宗室之史册。",{"a":1,"w":[4029,536]}],["王陵戆","wánglíng gàng","汉王陵助高祖平天下，封安国侯。为人任气，好直言。",{"a":1,"w":[47043,17196]}],["白土粉","báitǔ fěn","白垩的别名。见明李时珍《本草纲目‧土一‧白垩》。",{"a":1,"w":[57277,7613]}],["白庭砂","báitíngshā","丹砂的一种。见明李时珍《本草纲目‧石三‧丹砂》。",{"a":1,"w":[24,7760,8419]}],["白朱砂","bái zhūshā","人乳的别名。见明李时珍《本草纲目‧人一‧乳汁》。",{"a":1,"w":[24,42245]}],["百子堂","bǎizǐ táng","1) 草豆蔻的别名。\n2) 旧时妇女求子的庙宇。",{"a":1,"w":[22104,7695]}],["百漏船","bǎilòuchuán","处处渗漏的船。喻极多烦恼的人生。佛教称烦恼为漏。",{"a":1,"w":[133,3354,621]}],["皇带子","huáng dàizi","清代宗室的别称。又称黄带子，因系金黄色带而得名。",{"a":1,"w":[7732,15224]}],["相国庄","xiàngguó zhuāng","指五代冯道居住的地方。故址在今河北省交河县东北。",{"a":1,"w":[39182,7932]}],["瞿塘贾","qútáng jiǎ","旧谓进川的商人。亦借指追求盈利、甘冒风险的商人。",{"a":1,"w":[216307,8056]}],["磕响头","kē xiǎngtóu","双膝跪下以额碰地出声。表示惶恐、感激等心理状态。",{"a":1,"w":[4991,639,509]}],["神拳教","shénquán jiào","清末秘密会社之一，因传习义和拳(即神拳)而得名。",{"a":1,"w":[107464,77]}],["竹笊篱","zhú zhàoli","用竹篾编成的杓形用具，能漏水，用来在汤里捞东西。",{"a":1,"w":[7655,111746]}],["简板对","jiǎnbǎn duì","古代律诗首联、颔联用对偶，似简板相对，称简板对。",{"a":1,"w":[476164,40]}],["纥逻敦","gēluódūn","青草。纥逻为突厥语青的音译，敦为草或草原的音译。",{"a":1,"w":[21201,8262,8068]}],["绿庄严","lǜ zhuāngyán","草名。玉簪之别名。见宋陶谷《清异录‧护阶君子》。",{"a":1,"w":[605,6113]}],["肩担戏","jiāndānxì","木偶戏，傀儡戏。因道具简单，一人携之可行，故称。",{"a":1,"w":[3459,7969,3341]}],["落解粥","luòjiězhōu","薄粥。旧时考试落第回家，只得吃些薄粥，因有此名。",{"a":1,"w":[2275,4620,4875]}],["藩篱草","fānlí cǎo","木槿的别称。见明李时珍《本草纲目‧木三‧木槿》。",{"a":1,"w":[76459,521]}],["蜒蚰螺","yányóu luó","蜗牛的别名。见明李时珍《本草纲目‧虫四‧蜗牛》。",{"a":1,"w":[85513,7596]}],["蝌蚪书","kēdǒu shū","古文字体的一种。笔画多头大尾小，形如蝌蚪，故称。",{"a":1,"w":[24926,81]}],["街道厅","jiēdào tīng","明清时掌管京城道路、沟渠的衙门。亦指该厅的长官。",{"a":1,"w":[1937,3439]}],["衣火光","yī huǒguāng","相传春秋时，楚庄王奢靡无度，欲以大夫礼厚葬爱马。",{"a":1,"w":[7536,31646]}],["西夜国","xīyèguó","汉西域诸国之一。故址在今新疆维吾尔自治区叶城县。",{"a":1,"w":[51,631,23]}],["西施山","xīshī shān","相传为西施教习歌舞处。在浙江绍兴城外。一名土城。",{"a":1,"w":[15202,45]}],["解烦兵","jiěfán bīng","三国吴所建的军队名号。寓战无不胜，能解困危之意。",{"a":1,"w":[251276,2282]}],["话岔儿","huà chàr","I\n话头，说话的头绪。\nII\n话头，说话的头绪。",{"a":1,"w":[120,18009]}],["说公案","shuō gōng'àn","宋代都市中说话(说书)题材之一。即讲说公案故事。",{"a":1,"w":[68,43332]}],["说兵机","shuō bīngjī","谓纸上谈兵，夸夸其谈。兵机，指用兵的智谋、计策。",{"a":1,"w":[68,24839]}],["豚肠草","túnchángcǎo","旋花的别名。见明李时珍《本草纲目‧草七‧旋花》。",{"a":1,"w":[9948,3392,521]}],["赤龙爪","chìlóng zhǎo","白棘的别名。见明李时珍《本草纲目‧木三‧白棘》。",{"a":1,"w":[59432,8126]}],["赵大郎","zhào dàláng","1) 指宋太祖赵匡胤。\n2) 泛指宋代赵家君王。",{"a":1,"w":[8536,50218]}],["赵官家","zhào guānjiā","1) 指宋代赵姓皇帝。\n2) 特指宋太祖赵匡胤。",{"a":1,"w":[8536,71486]}],["跋队斩","báduìzhǎn","唐末朱全忠在藩镇时所用的一种军法。跋，通“拔”。",{"a":1,"w":[9818,570,8673]}],["踹街马","chuàijiēmǎ","指仪仗队中前导的马。同色的二匹一排，也叫对子马。",{"a":1,"w":[17872,681,1273]}],["轩亭口","xuāntíngkǒu","在浙江绍兴城内，为近代民主革命烈士秋瑾就义之地。",{"a":1,"w":[8869,8241,47]}],["轩辕镜","xuānyuán jìng","1) 镜名。古人谓用之可以辟邪。\n2) 喻月亮。",{"a":1,"w":[32851,7535]}],["迷香洞","míxiāngdòng","1) 妓女接客的上等处所。\n2) 为妓院的美称。",{"a":1,"w":[1384,1311,3374]}],["连理杯","liánlǐ bēi","旧时结婚，新夫妇合饮之杯。喻结为夫妻或夫妇情好。",{"a":1,"w":[21312,199]}],["道人头","dào réntóu","枲耳的别名。见明李时珍《本草纲目‧草四‧枲耳》。",{"a":1,"w":[15055,509]}],["郄蝉草","qiècháncǎo","丹参的别名。见明李时珍《本草纲目‧草一‧丹参》。",{"a":1,"w":[20645,8931,521]}],["醉娘子","zuì niángzǐ","曲牌名。属双调。见明陶宗仪《辍耕录‧杂剧曲名》。",{"a":1,"w":[3387,151