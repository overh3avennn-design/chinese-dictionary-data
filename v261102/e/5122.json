8333,7770]}],["枯菀","kūwǎn","谓生死。菀，荣，指生。",{"a":1,"w":[8333,11362]}],["枯鳞","kūlín","枯鱼。亦喻处于困境者。",{"a":1,"w":[8333,7924]}],["枳句","zhǐjù","多曲的枳树。句，弯曲。",{"a":1,"w":[10623,646]}],["柁轮","duòlún","轮船、汽车等的方向盘。",{"a":1,"w":[24263,2280]}],["某们","mǒumen","犹我们。某是设代之词。",{"a":1,"w":[1585,190]}],["染院","rǎnyuàn","古代宫内掌染事的官署。",{"a":1,"w":[3355,571]}],["柔善","róushàn","指性格温柔的善良之人。",{"a":1,"w":[8134,7657]}],["柔蓝","róulán","柔和的蓝色。多形容水。",{"a":1,"w":[8134,623]}],["柝汲","tuòjí","巡夜和汲水。泛指劳作。",{"a":1,"w":[17914,10065]}],["柯干","kēgàn","亦作“柯干”。\n枝干。",{"a":1,"w":[8119,46]}],["柴告","cháigào","祭祀之一种。燔柴祷告。",{"a":1,"w":[7885,7591]}],["柴抟","cháituán","柴梱。束聚起来的树木。",{"a":1,"w":[7885,12425]}],["柴烟","cháiyān","柴禾燃烧时产生的烟气。",{"a":1,"w":[7885,1376]}],["柴荜","cháibì","柴门荜户。指穷人居所。",{"a":1,"w":[7885,17725]}],["栅墙","zhàqiáng","用铁条或木条围成的墙。",{"a":1,"w":[8487,670]}],["栘柳","yíliǔ","水杨的别名。又叫栘杨。",{"a":1,"w":[35563,7802]}],["根力","gēnlì","佛教语。指五根与五力。",{"a":1,"w":[2297,1276]}],["根捉","gēnzhuō","犹追捕。根，通“跟”。",{"a":1,"w":[2297,4941]}],["根业","gēnyè","佛教语。指根性与业力。",{"a":1,"w":[2297,7418]}],["根痼","gēngù","痼疾。久治不愈的疾病。",{"a":1,"w":[2297,16723]}],["格孽","géniè","方言。意谓争执，吵闹。",{"a":1,"w":[7422,9764]}],["桂户","guìhù","桂木造的门。言其华贵。",{"a":1,"w":[8044,2320]}],["桂柁","guìduò","桂木做的船柁。亦指船。",{"a":1,"w":[8044,24263]}],["桃卯","táomǎo","用桃木刻成的辟邪饰物。",{"a":1,"w":[3386,9094]}],["桄面","guāngmiàn","从桄榔树中提取的淀粉。",{"a":1,"w":[15494,523]}],["桎拲","zhìgǒng","谓刑具。拲，两手被铐。",{"a":1,"w":[17963,201363]}],["桑韦","sāngwéi","唐代民歌名。即桑条韦。",{"a":1,"w":[8026,7839]}],["桴栋","fúdòng","栋梁。比喻事物的支柱。",{"a":1,"w":[22950,5083]}],["桶盘","tǒngpán","一种盛肴馔的桶形盘子。",{"a":1,"w":[8593,2285]}],["桼雕","qīdiāo","复姓。后多作“漆雕”。",{"a":1,"w":[298128,8192]}],["梅洗","méixǐ","方言。指整治金属器皿。",{"a":1,"w":[7563,161]}],["梅润","méirùn","谓梅雨季节的潮湿空气。",{"a":1,"w":[7563,7847]}],["梆鼓","bānggǔ","梆子和鼓。报更的响器。",{"a":1,"w":[11402,3352]}],["枭棋","xiāoqí","古代博戏中的一种贵彩。",{"a":1,"w":[10374,8184]}],["枭狐","xiāohú","枭与狐。比喻险恶之徒。",{"a":1,"w":[10374,8675]}],["枭狼","xiāoláng","枭与狼。比喻凶恶之徒。",{"a":1,"w":[10374,7960]}],["梨条","lítiáo","用梨子所做的条状果脯。",{"a":1,"w":[3632,556]}],["梭叶","suōyè","钉在门上的梭形金属片。",{"a":1,"w":[8356,7426]}],["梵衲","fànnà","僧侣。衲，僧徒的代称。",{"a":1,"w":[9152,13498]}],["梵道","fàndào","佛教谓修净禅，断淫欲。",{"a":1,"w":[9152,511]}],["弃础","qìchǔ","废弃的柱礅。泛指废墟。",{"a":1,"w":[7931,8772]}],["弃禄","qìlù","舍弃俸禄。人死的婉词。",{"a":1,"w":[7931,8602]}],["棓枪","bàngqiāng","天棓星和天枪星的并称。",{"a":1,"w":[25665,3338]}],["枣糒","zǎobèi","用枣子和米蒸煮的饭食。",{"a":1,"w":[8507,53894]}],["棚垛","péngduǒ","指箭靶。棚，通“堋”。",{"a":1,"w":[8961,9691]}],["栋榱","dòngcuī","屋梁和椽子。借指房屋。",{"a":1,"w":[5083,29219]}],["栈羊","zhànyáng","在圈内加料精养的肥羊。",{"a":1,"w":[9542,1387]}],["森映","sēnyìng","谓繁密茂盛，交相掩映。",{"a":1,"w":[7907,8723]}],["森翳","sēnyì","谓枝叶繁茂，遮蔽光线。",{"a":1,"w":[7907,9715]}],["森鲜","sēnxiān","谓森然罗列，色彩鲜明。",{"a":1,"w":[7907,2339]}],["栖退","qītuì","亦作“栖退”。\n隐退。",{"a":1,"w":[8477,1371]}],["棹夫","zhàofū","亦作“櫂夫”。\n船夫。",{"a":1,"w":[12826,7409]}],["棹楫","zhàojí","船桨。长曰棹，短曰楫。",{"a":1,"w":[12826,19523]}],["棹舟","zhàozhōu","亦作“櫂舟”。\n划船。",{"a":1,"w":[12826,4790]}],["棺具","guānjù","葬死者所需的棺材等物。",{"a":1,"w":[9589,7505]}],["椅檀","yǐtán","椅木和檀木。泛指良材。",{"a":1,"w":[8825,8676]}],["椎拙","chuízhuō","质朴无文。谓不加修饰。",{"a":1,"w":[8683,9782]}],["椰席","yēxí","用椰子树叶编制的席子。",{"a":1,"w":[8740,7836]}],["椹斧","shènfǔ","砧和斧。古代杀人之具。",{"a":1,"w":[24259,8713]}],["椽栾","chuánluán","山名。在汉甘泉宫之南。",{"a":1,"w":[15100,10929]}],["椿岁","chūnsuì","大椿的年岁。比喻长寿。",{"a":1,"w":[10732,195]}],["杨岐","yángqí","谓歧途。喻错误的道路。",{"a":1,"w":[8318,11416]}],["杨荷","yánghé","古代楚地流行的歌曲名。",{"a":1,"w":[8318,7677]}],["楗柱","jiànzhù","河工以竹木所筑的柱桩。",{"a":1,"w":[23685,7685]}],["楚峤","chǔjiào","楚山。峤，尖峭的高山。",{"a":1,"w":[7905,16760]}],["楚招","chǔzhāo","《楚辞‧招魂》的省称。",{"a":1,"w":[7905,4704]}],["楚班","chǔbān","指春秋着名匠人公输般。",{"a":1,"w":[7905,135]}],["楚笋","chǔsǔn","指楚地所产之笋的笋衣。",{"a":1,"w":[7905,8811]}],["楚管","chǔguǎn","楚地之管。管，乐器名。",{"a":1,"w":[7905,1278]}],["楚蛮","chǔmán","古代指楚国境内的民族。",{"a":1,"w":[7905,8711]}],["楚贰","chǔ'èr","指楚国的储君(太子)。",{"a":1,"w":[7905,10098]}],["楚魄","chǔpò","指朝云暮雨的巫山神女。",{"a":1,"w":[7905,9063]}],["楞冲","léngchōng","指力量大而劲头足的人。",{"a":1,"w":[10003,2284]}],["业累","yèlèi","佛教语。指恶业的牵累。",{"a":1,"w":[7418,173]}],["楮帛","chǔbó","旧俗祭祀时焚化的纸钱。",{"a":1,"w":[12229,10327]}],["楮桃","chǔtáo","即楮实。参见“楮实”。",{"a":1,"w":[12229,3386]}],["楮火","chǔhuǒ","祭祀时焚烧纸钱的火光。",{"a":1,"w":[12229,1284]}],["极哀","jí'āi","极其悲哀；最大的悲哀。",{"a":1,"w":[1303,8386]}],["极荣","jíróng","非常光荣；最大的荣耀。",{"a":1,"w":[1303,7887]}],["极治","jízhì","谓政治修明，社会升平。",{"a":1,"w":[1303,2283]}],["概用","gàiyòng","谓不加区别，一概使用。",{"a":1,"w":[8010,26]}],["榆羹","yúgēng","用榆荚和榆面煮成的羹。",{"a":1,"w":[8831,9089]}],["榑槐","fúhuái","扶桑与槐树。借指公卿。",{"a":1,"w":[248306,8859]}],["榛路","zhēnlù","荆棘丛生之路。喻险途。",{"a":1,"w":[10541,54]}],["荣启","róngqǐ","春秋隐士荣启期的省称。",{"a":1,"w":[7887,7875]}],["荣庵","róng'ān","犹盛衰。庵，通“奄”。",{"a":1,"w":[7887,11122]}],["荣槁","rónggǎo","盛衰。亦指仕途的升沉。",{"a":1,"w":[7887,10871]}],["荣翰","rónghàn","惠函。敬称他人的来信。",{"a":1,"w":[7887,8206]}],["榷金","quèjīn","指国家对黄金实行专卖。",{"a":1,"w":[12198,1270]}],["槁磔","gǎozhé","谓死亡。磔，肢体分裂。",{"a":1,"w":[10871,13985]}],["槁积","gǎojī","指堆积的枯木等易燃物。",{"a":1,"w":[10871,7496]}],["盘多","pánduō","植物名。桑科无花果属。",{"a":1,"w":[2285,21]}],["槌砧","chuízhēn","铁锤和铁砧。锤锻之器。",{"a":1,"w":[10270,12607]}],["槌凿","chuízáo","谓用槌子凿子敲击穿通。",{"a":1,"w":[10270,8504]}],["枪斗","qiāngdòu","吸鸦片用的烟枪与烟斗。",{"a":1,"w":[3338,7477]}],["枪棓","qiāngbàng","天枪星和天棓星的并称。",{"a":1,"w":[3338,25665]}],["枪竿","qiānggān","竖立的枪身。代指兵器。",{"a":1,"w":[3338,9280]}],["枪筹","qiāngchóu","古代行酒令的一种用具。",{"a":1,"w":[3338,8478]}],["槐厅","huáitīng","唐宋时学士院中的厅名。",{"a":1,"w":[8859,3439]}],["槐江","huáijiāng","山名。见于《山海经》。",{"a":1,"w":[8859,2327]}],["槐铉","huáixuàn","犹槐鼎。铉，举鼎之具。",{"a":1,"w":[8859,27742]}],["槐龙","huáilóng","谓盘曲如龙的老槐枝柯。",{"a":1,"w":[8859,1308]}]]