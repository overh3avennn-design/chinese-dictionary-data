03]}],["救族","jiùzú","保全眷属。谓避免灾祸。",{"a":1,"w":[1409,4632]}],["敕条","chìtiáo","朝廷所颁列的法律条款。",{"a":1,"w":[9734,556]}],["败卜","bàibo","谓对神轻慢则占卜不灵。",{"a":1,"w":[2345,8005]}],["败官","bàiguān","败坏官职。谓居官不法。",{"a":1,"w":[2345,2293]}],["败神","bàishén","詈词。称败坏事情的人。",{"a":1,"w":[2345,3316]}],["叙降","xùjiàng","谓推测凶祸所降的地方。",{"a":1,"w":[8462,2305]}],["叙离","xùlí","犹叙别。叙述离别之情。",{"a":1,"w":[8462,543]}],["叙齿","xùchǐ","按年龄的长幼而定席次。",{"a":1,"w":[8462,7577]}],["教乘","jiàochéng","佛教语。指佛教、佛法。",{"a":1,"w":[77,3366]}],["敝庐","bìlú","破旧的房子。亦作谦辞。",{"a":1,"w":[8875,9988]}],["敝窦","bìdòu","弊端，营私违法的漏洞。",{"a":1,"w":[8875,9031]}],["散犯","sànfàn","单独或零散监禁的囚犯。",{"a":1,"w":[2286,4667]}],["散鼓","sàngǔ","设置为仪而不敲击之鼓。",{"a":1,"w":[2286,3352]}],["敦缛","dūnrù","形容文章风俗淳厚绵密。",{"a":1,"w":[8068,19177]}],["敧缺","jīquē","犹交错。敧，通“倚”。",{"a":1,"w":[61395,1412]}],["整身","zhěngshēn","谓身体端正，穿戴整齐。",{"a":1,"w":[1355,7456]}],["整舆","zhěngyú","整治车辆。谓作好战备。",{"a":1,"w":[1355,8330]}],["敷天","fūtiān","普天下。敷，通“溥”。",{"a":1,"w":[8799,19]}],["敷灾","fūzāi","耕种。敷，布，指播种。",{"a":1,"w":[8799,3438]}],["敷震","fūzhèn","谓陈述阐发而使之显明。",{"a":1,"w":[8799,7751]}],["数纪","shùjì","几十年。十二年为一纪。",{"a":1,"w":[527,7653]}],["敛瘗","liǎnyì","犹敛葬。敛，通“殓”。",{"a":1,"w":[8878,14440]}],["敛边","liǎnbiān","围棋术语。得边；夺边。",{"a":1,"w":[8878,553]}],["敛雾","liǎnwù","收敛云雾，使天色明朗。",{"a":1,"w":[8878,3421]}],["敛首","liǎnshǒu","犹俯首。形容非常驯服。",{"a":1,"w":[8878,2310]}],["文俗","wénsú","谓拘守礼法而安于习俗。",{"a":1,"w":[7415,7904]}],["文债","wénzhài","谓应约写文章而未交稿。",{"a":1,"w":[7415,4698]}],["文序","wénxù","习文的学校。序，学校。",{"a":1,"w":[7415,7598]}],["文楼","wénlóu","元代皇宫内钟楼的别名。",{"a":1,"w":[7415,174]}],["文闱","wénwéi","指科举考试。闱，试院。",{"a":1,"w":[7415,11278]}],["文陛","wénbì","宫阙的殿阶。借指朝廷。",{"a":1,"w":[7415,10492]}],["文鹢","wényì","船首画有鹢鸟形状的船。",{"a":1,"w":[7415,17157]}],["斑阑","bānlán","斑斓。色彩错杂灿烂貌。",{"a":1,"w":[4681,9419]}],["斗峻","dòujùn","高且陡。斗，通“陡”。",{"a":1,"w":[7477,9365]}],["斫路","zhuólù","谓芟除草木。以成通道。",{"a":1,"w":[11020,54]}],["斩冰","zhǎnbīng","砍冰。谓取冰藏于冰室。",{"a":1,"w":[8673,2318]}],["斩毒","zhǎndú","割除因病毒坏死的肌肤。",{"a":1,"w":[8673,3322]}]