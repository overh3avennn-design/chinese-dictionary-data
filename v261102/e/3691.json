[["举纲持领","jǔgāngchílǐng","提起网的总绳，网眼就都张开了；提起皮衣领子一抖，衣上的毛就都顺了。比喻办事要抓关键部分。",{"a":1,"w":[606,8152,7617,1361]}],["黏胶纤维","niánjiāo xiānwéi","用天然纤维素经氢氧化钠、二硫化碳处理制成的人造纤维。是制造人造丝、人造棉、人造毛的原料。",{"a":1,"w":[101006,4728]}],["正宫娘娘","zhènggōng niángniang","Empress\nsenior Imperial Consort\nQueen Mother",{"a":1,"w":[82086,16767]}],["婚丧喜庆","hūnsāngxǐqìng","泛指出生、 结婚、 升官、 乔迁、 死亡等大事。 如： “婚丧喜庆皆应避免奢侈浪费。 ”",{"a":1,"w":[7899,8016,43845]}],["害人利己","hàirén lìjǐ","为了自己的利益而不惜损害别人。 如： “像这样害人利己的行为， 也只有他才做得出来。 ”",{"a":1,"w":[12199,17795]}],["形容尽致","xíngróng jìnzhì","描摹得十分透澈。 如： “这简介将画展的特色形容尽致。 ”\n[似] 淋漓尽致、 极尽描摹",{"a":1,"w":[2779,132874]}],["旌旗所指","jīngqí suǒzhǐ","比喻军队所到的地方。 如： “昔时项羽入关， 旌旗所指， 烧杀掳掠， 令人胆颤心惊。 ”",{"a":1,"w":[26356,16651]}],["滔天大祸","tāotiān dàhuò","形容巨大的灾祸。 如： “你犯下如此的滔天大祸， 却不知悔改， 将来一定会受到报应。 ”",{"a":1,"w":[23161,40996]}],["眼狂心热","yǎn kuáng xīnrè","动心、 贪看。 董西厢·卷一： “铲地相逢， 引调得人来眼狂心热。 ”或作“眼狂心痒”。",{"a":1,"w":[551,185690,59]}],["背信忘义","bèixìn wàng yì","bèi xìn wàng yì\n不守信用，忽视道义。\n如：「背信忘义的人不可作为朋友。」",{"a":1,"w":[29859,206,7437]}],["红粉知己","hóngfěn zhījǐ","hóng fěn zhī jǐ\n知心的女性朋友。\n如：「他视妻子为无可取代的红粉知己。」",{"a":1,"w":[43370,12582]}],["喁喁细语","yóngyóng xìyǔ","yú yú xì yǔ\n形容人低声说话。\n如：「他们在那儿喁喁细语，不知商量什么事情？」",{"a":1,"w":[35062,41815]}],["浅尝则止","qiǎncháng zé zhǐ","qiǎn cháng zé zhǐ\n少量试吃一下。\n如：「这道菜太辣了，我只浅尝则止。」",{"a":1,"w":[46892,3323,4656]}],["慑人心魄","shèrén xīnpò","zhé rén xīn pò\n令人心神恐惧。\n如：「看滚滚黄河惊涛拍岸，真是慑人心魄。」",{"a":1,"w":[128142,135639]}],["下半辈子","xiàbàn bèizi","xià bàn bèi zi\n下半生。\n如：「有了这笔钱，他的下半辈子可以衣食无虞了。」",{"a":1,"w":[18380,14273]}],["不假外出","bùjiǎ wàichū","bù jià wài chū\n没有请假，就擅自出去。\n如：「军人不假外出是很严重的事。」",{"a":1,"w":[20663,5902]}],["不著一字","bù zhù yīzì","bù zhuó yī zì\n不撰一字。\n唐．司空图．诗品．含蓄：「不著一字，尽得风流。」",{"a":1,"w":[41293,10631]}],["并无不当","bìngwú bùdàng","bìng wú bù dàng\n没有不恰当的。\n如：「他对于这件事的处理方法并无不当。」",{"a":1,"w":[34418,10284]}],["扭来扭去","niǔláiniǔqù","niǔ lái niǔ qù\n左右摆动。\n如：「小孩子打针时总是会扭来扭去的闪躲逃避。」",{"a":1,"w":[4788,27,61]}],["苦苦相逼","kǔkǔ xiāngbī","kǔ kǔ xiāng bī\n不断的逼迫。\n如：「他借的钱总会还的，又何必苦苦相逼呢？」",{"a":1,"w":[4