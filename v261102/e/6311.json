[["无胫而至","wújìng'érzhì","犹无胫而行。常以喻良才不招而自至爱贤者之门。",{"a":1,"w":[2255,13941,2267,3346]}],["无事生事","wúshì shēngshì","犹言无事生非。无缘无故找岔子，存心制造麻烦。",{"a":1,"w":[12299,13838]}],["无天无日","wútiān wúrì","犹言不见天日。比喻社会黑暗，见不到一点光明。",{"a":1,"w":[38251,23083]}],["乌踷兔走","wūzhǎtùzǒu","指日月运行。兔，传说中的月中玉兔。借指月亮。",{"a":1,"w":[7520,3426,107]}],["文搜丁甲","wénsōudīngjiǎ","文章精妙感动神灵。丁甲，神名，即六丁六甲神。",{"a":1,"w":[7415,3416,4646,3330]}],["文章星斗","wénzhāngxīngdòu","是文章之冠首，形容人文章写得漂亮，超群出众。",{"a":1,"w":[1642,50183]}],["瓮天之见","wèngtiānzhījiàn","瓮天坐在瓮中观天，见天不大。比喻短浅的见识。",{"a":1,"w":[215647,2254,76]}],["帷灯匣剑","wéidēngxiájiàn","以帷罩灯，以匣藏剑。比喻真相难明，令人猜疑。",{"a":1,"w":[11988,644,10001,4730]}],["委曲成全","wěiqǔchéngquán","指使自己受委屈，来成全别人。亦作委曲周全”。",{"a":1,"w":[41807,59834]}],["忘战者危","wàngzhànzhěwēi","指忘记了战备就一定会产生危机。同忘战必危”。",{"a":1,"w":[206,7438,1285,7654]}],["望岫息心","wàng xiù xīxīn","多指遁世隐居。亦喻知难而止息。同望峰息心”。",{"a":1,"w":[7556,21492,118449]}],["微言大谊","wēiyándàyì","包含在精微语言里的深刻的道理。同微言大义”。",{"a":1,"w":[36850,4,9604]}],["枉矫过激","wǎngjiǎoguòjī","犹言矫枉过正。比喻纠正错误超过了应有的限度。",{"a":1,"w":[9134,8697,24244]}],["拖麻拽布","tuōmázhuàibù","指戴孝。旧时，长辈丧亡，幼辈要披麻衣系白布。",{"a":1,"w":[4707,7550,5165,1283]}],["晚节不终","wǎnjiébùzhōng","晚节指晚年的节操。指到了晚年却不能保持节操。",{"a":1,"w":[37561,0,7638]}],["途遥日暮","tú yáo rìmù","犹日暮途穷。比喻到了走投无路的或衰亡的境地。",{"a":1,"w":[8207,8326,86500]}],["推聋作哑","tuīlóngzuòyǎ","指装作不闻不问，什么都不知道。同推聋妆哑”。",{"a":1,"w":[586,9524,4608,8480]}],["退食从容","tuìshícóngróng","指官吏品行节俭正直，仪容从容自得，可为楷模。",{"a":1,"w":[175704,5986]}],["痛湔宿垢","tòngjiānsùgòu","犹痛改前非。彻底改正以前所犯的错误。湔，洗。",{"a":1,"w":[1417,25626,7825,9205]}],["头没杯案","tóumòbēi'àn","头伏在酒杯和桌子间。比喻尽情欢乐，不拘形迹。",{"a":1,"w":[509,94,370314]}],["涕泗滂沲","tìsìpāngtuó","谓涕泪如雨。形容涕泪流得极多。同涕泗滂沱”。",{"a":1,"w":[117186,14236,46758]}],["天地剖判","tiāndìpōupàn","犹言开天辟地。比喻空前的，自古以来没有过的。",{"a":1,"w":[9159,121330]}],["天地诛戮","tiāndìzhūlù","犹天诛地灭。比喻为天地所不容。同天地诛灭”。",{"a":1,"w":[9159,296673]}],["韬光韫玉","tāoguāngyùnyù","隐匿光采，韫藏宝玉。比喻隐藏才华，不露光芒。",{"a":1,"w":[32526,20548,2294]}],["体贴入妙","tǐtiērùmiào","指体会领悟深刻细致，而使描写或模仿巧妙逼真。",{"a":1,"w":[4383,4615,4764]}],["缩头缩颈","suōtóusuōjǐng","形容畏缩不前，或胆小不敢出头。同缩头缩脑”。",{"a":1,"w":[34266,842193]}],["贪名逐利","tānmíng zhúlì","贪图好的名声，追逐个人私利。亦作贪名图利”。",{"a":1,"w":[205514,69072]}],["溯源穷流","sùyuán qióng liú","上溯本源，穷尽支流。比喻寻究事物的起始演变。",{"a":1,"w":[24571,2372,519]}],["随车甘雨","suíchēgānyǔ","比喻官吏施行仁政及时为民解忧。同随车致雨”。",{"a":1,"w":[23019,52297]}],["随车夏雨","suíchēxiàyǔ","比喻官吏施行仁政及时为民解忧。同随车致雨”。",{"a":1,"w":[23019,1397,159]}],["碎骨粉身","suìgǔfěnshēn","指死亡。多指为某种目的而献身。同碎身粉骨”。",{"a":1,"w":[262231,59207]}],["水漫金山","shuǐ màn jīnshān","神话故事。金山，在江苏省镇江市。形容大水弥漫",{"a":1,"w":[11,7920,12430]}],["事过情迁","shìguòqíngqiān","随着事情过去，对该事的感情、态度也起了变化。",{"a":1,"w":[33,25,7490,8003]}],["事款则圆","shìkuǎnzéyuán","谓遇事只要从容对待，就能圆满解决。款，宽缓。",{"a":1,"w":[33,7573,3323,2301]}],["势合形离","shìhéxínglí","势形状；形形体。形体各自独立，结构完整不分。",{"a":1,"w":[7642,1269,4612,543]}],["时至运来","shí zhì yùnlái","时机来了，运气也有了转机。指由逆境转为顺境。",{"a":1,"w":[1280,3346,173401]}],["食不重肉","shíbùchóngròu","吃饭不用两道肉食。指饮食节俭。同食不兼肉”。",{"a":1,"w":[7466,18256,116]}],["食鱼遇鲭","shíyúyùqīng","比喻调换口味，使不单调。鲭，鱼肉合烧的美味。",{"a":1,"w":[46211,2367,11822]}],["豕虎传讹","shǐhǔchuán'é","指书籍传写或刊印中的文字错误。同豕亥鱼鲁”。",{"a":1,"w":[10916,3337,69288]}],["使蚊负山","shǐ wénfù shān","使派，令；负背。派蚊子去背山。比喻力不胜任。",{"a":1,"w":[1332,120976,45]}],["诗朋酒侣","shī péngjiǔ lǚ","侣伴侣，同伴。作诗饮酒的朋友。同诗朋酒友”。",{"a":1,"w":[2369,132852,10478]}],["石泐海枯","shílèhǎikū","直到石头碎裂，海水干涸。形容经历极长的时间。",{"a":1,"w":[7419,19504,528,8333]}],["石室金匮","shíshìjīnguì","亦作石室金鐀”。古代国家收藏重要文献的地方。",{"a":1,"w":[36960,1270,13942]}],["绳愆纠缪","shéngqiānjiūmiù","改正过失，纠正错误。绳纠正。愆过失。谬错误。",{"a":1,"w":[7867,10996,8538,9670]}],["深图远算","shēntúyuǎnsuàn","指计划得很周密，考虑得很长远。同深谋远虑”。",{"a":1,"w":[1343,1301,274364]}],["深猷远计","shēnyóuyuǎnjì","指计划得很周密，考虑得很长远。同深谋远虑”。",{"a":1,"w":[1343,13188,103,7428]}],["赏善罚否","shǎngshànfáfǒu","指赏赐善人善事，惩罚恶人恶事。同赏善罚恶”。",{"a":1,"w":[125308,3430,8585]}],["砂里淘金","shā lǐ táojīn","从砂子里淘出黄金。比喻从大量材料中选取精华。",{"a":1,"w":[8419,30,27382]}],["铩羽涸鳞","shāyǔ hé lín","用以比喻不得志，处境极为困难。同铩羽暴鳞”。",{"a":1,"w":[76476,11518,7924]}],["山崩地坼","shānbēngdìchè","山岳崩塌，大地裂开。亦用以形容响声强烈巨大。",{"a":1,"w":[41318,10,15127]}],["山复整妆","shān