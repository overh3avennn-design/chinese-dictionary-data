w":[2257,7545,68034]}],["方滋未艾","fāngzīwèi'ài","事物正在发展，尚未达到止境。同方兴未艾”。",{"a":1,"w":[2257,8214,7559,7682]}],["放心托胆","fàngxīn tuō dǎn","心里放得下，有所凭借而胆大。形容毫无顾虑。",{"a":1,"w":[1012,4618,3379]}],["飞云掣电","fēiyún chèdiàn","掣闪过。像流云飞和闪电一样。形容非常迅速。",{"a":1,"w":[210557,91981]}],["翻然改图","fānrán gǎitú","图计划，打算。比喻很快转变过来。另作打算。",{"a":1,"w":[348219,99891]}],["反身自问","fǎnshēn zìwèn","回过头来检查自己的言行得失。同反躬自问”。",{"a":1,"w":[36770,50593]}],["返我初服","fǎnwǒchūfú","返归还；初服未做官时的衣服。比喻辞官归隐。",{"a":1,"w":[8365,139,134691]}],["泛萍浮梗","fàn píngfú gěng","浮动在水面的萍草和树根。比喻踪迹漂泊不定。",{"a":1,"w":[8013,296374,8222]}],["贩官鬻爵","fàn guān yùjué","鬻卖；爵爵位，官爵。出卖官爵，以敛取财物。",{"a":1,"w":[8945,2293,139849]}],["梵册贝叶","fàncèbèiyè","指佛经，佛经原本多用梵文写在贝多罗树叶上。",{"a":1,"w":[9152,3413,15205]}],["峨峨洋洋","é'é yángyáng","用以形容音乐高亢奔放◇亦用以形容欢乐之态。",{"a":1,"w":[56678,12835]}],["短褐穿结","duǎnhèchuānjié","短褐粗布短衣；穿破；结打结。形容衣衫褴褛。",{"a":1,"w":[49819,153,2271]}],["顿足搓手","dùnzú cuōshǒu","顿以脚扣地；搓手相摩。形容着急惋惜的样子。",{"a":1,"w":[21209,37805]}],["读不舍手","dúbùshěshǒu","舍舍得，愿意。读书读到有兴趣时舍不得放下。",{"a":1,"w":[186,16133,34]}],["独茧抽丝","dú jiǎn chōusī","比喻诗文条理清晰，脉络分明。亦比喻单相思。",{"a":1,"w":[7561,10851,41970]}],["独是独非","dúshìdúfēi","指不采纳众议，是与非自己说了算，独断专行。",{"a":1,"w":[7561,48,2265]}],["笃定泰山","dǔdìng tàishān","像泰山那样稳定。比喻有绝对把握，无须忧虑。",{"a":1,"w":[279220,10192]}],["笃学不倦","dǔxuébùjuàn","笃学专心好学；倦疲倦。专心好学，不知疲倦。",{"a":1,"w":[243599,25951]}],["睹始知终","dǔshǐzhīzhōng","指看见事物的开始阶段就预见到它的最终结果。",{"a":1,"w":[10531,7683,7492,7638]}],["东声西击","dōngshēngxījī","犹言声东击西。扬言要攻此方，实际却攻彼方。",{"a":1,"w":[87,3317,51,7506]}],["洞鉴废兴","dòngjiànfèixīng","洞鉴明察。深入透彻地了解历代兴盛衰败情况。",{"a":1,"w":[135535,137599]}],["鼎足而居","dǐngzú ér jū","像鼎的三足分立那样。比喻三方面对立的局势。",{"a":1,"w":[26609,2267,7611]}],["定乱扶衰","dìngluànfúshuāi","定平定；扶帮助，扶持。平定祸乱，扶持衰弱。",{"a":1,"w":[2259,1360,3458,7950]}],["丢盔抛甲","diūkuīpāojiǎ","形容吃了败仗狼狈逃跑的景象。同丢盔卸甲”。",{"a":1,"w":[2429,9335,8247,3330]}],["东奔西逃","dōngbēnxītáo","跑到东，又逃到西。到处逃窜。同东逃西窜”。",{"a":1,"w":[87,8195,51,3455]}],["东床快婿","dōngchuáng kuài xù","指为人豁达，才能出众的女婿。是女婿的美称。",{"a":1,"w":[87374,155,12002]}],["东流西上","dōngliúxīshàng","水向东流，人往西走。比喻人们对故乡的思恋。",{"a":1,"w":[30195,219384]}],["典妻鬻子","diǎnqīyùzǐ","典典当；鬻卖。典卖妻子。形容生活极其贫困。",{"a":1,"w":[7636,8353,174431]}],["钓名欺世","diàomíng qī shì","钓捞取。运用不正当手段捞取名著，欺骗世人。",{"a":1,"w":[77540,8777,7462]}],["登坛拜将","dēngtánbàijiàng","比喻指任命将帅以及其他主持工作的首脑人物。",{"a":1,"w":[140951,7752,3328]}],["砥厉廉隅","dǐ lì liányú","指磨练节操。廉隅，棱角，比喻指方正的操守。",{"a":1,"w":[718776,128795]}],["地丑德齐","dìchǒudéqí","丑同类。地相等，德相同。比喻彼此条件一样。",{"a":1,"w":[10,3425,7416,1347]}],["颠乾倒坤","diānqiándǎokūn","乾坤指天地。能把天地颠倒。形容本领非常大。",{"a":1,"w":[8660,9029,583,9337]}],["道头知尾","dàotóuzhīwěi","说个开头就知道结果。形容思维敏捷、悟性好。",{"a":1,"w":[511,509,7492,7474]}],["得寸得尺","décùndéchǐ","指或多或少皆有所得◇也指能得多少就得多少。",{"a":1,"w":[520,3402,2347]}],["德薄才疏","débócáishū","薄浅；疏空虚。品行和才能都很差。常作谦辞。",{"a":1,"w":[7416,254484,7743]}],["德薄能鲜","débónéngxiǎn","鲜少。德行浅薄，才能不足（表示自谦的话）。",{"a":1,"w":[7416,2319,41,2339]}],["当风秉烛","dāngfēngbǐngzhú","秉举着。迎着风举着蜡烛。比喻身陷危险境地。",{"a":1,"w":[552,44,71698]}],["倒执手版","dǎozhíshǒubǎn","古代官员持手版以朝。倒执手版，指惊惶失态。",{"a":1,"w":[583,45437,3362]}],["大肆铺张","dàsì pūzhāng","为了形式上的好看，不顾一切地过分讲究排场。",{"a":1,"w":[5928,30299]}],["大头小尾","dàtóuxiǎowěi","犹虎头蛇尾”。比喻做事前紧后松，有始无终。",{"a":1,"w":[309504,7474]}],["寸指测渊","cùnzhǐcèyuān","以一寸之指而测深渊。比喻浅学不能探明深理。",{"a":1,"w":[3402,1312,2274,8649]}],["达官显宦","dáguān xiǎnhuàn","达显贵；宦官。旧指职位高而声势显赫的官员。",{"a":1,"w":[87529,150034]}],["大本大宗","dàběndàzōng","本根本；宗本，主旨。最根本，最重要的东西。",{"a":1,"w":[29914,19028]}],["丛雀渊鱼","cóngquèyuānyú","比喻不行善政，等于把老百姓赶到敌人方面去。",{"a":1,"w":[4787,7583,8649,526]}],["醋海翻波","cùhǎifānbō","醋比喻嫉妒。比喻男女间因爱情而引起的纠葛。",{"a":1,"w":[3532,528,2337,7433]}],["摧锋陷坚","cuīfēng xiànjiān","摧摧毁；锋锋利；陷攻陷；坚坚锐。破敌深入。",{"a":1,"w":[107251,150899]}],["鹑衣鹄面","chúnyī húmiàn","破烂的衣服，瘦削的面形。形容穷苦落魄之状。",{"a":1,"w":[90669,41016]}],["词穷理极","cíqióng lǐ jí","穷完，尽；极终，到头。把话说完，把理讲透。",{"a":1,"w":[72421,4609,1303]}],["词穷理绝","cíqióng lǐ jué","指再也找不到理由，无话可说。同词穷理尽”。",{"a":1,"w":[72421,4609,4627]}],["词言义正","cíyányìzhèng","词言词，语言。义道理。言辞严厉，义理正大。",{"a":1,"w":[462249,7437,62]}],["慈眉善眼","címéishànyǎn","形容人的容貌一副善良的样子。同慈眉善目”。",{"a":1,"w":[8234,7988,7657,551]}],["辞多受少","cíduōshòushǎo","辞推辞掉。受接受。推辞不受的多而接受的少。",{"a":1,"w":[7757,21,1324,126]}],["啜食吐哺","chuòshítǔbǔ","辍中止，停止。停止用饭，吐出口中含的食物。",{"a":1,"w":[11597,7466,35714]}],["传龟袭紫","chuánguīxízǐ","指继承高爵显位『制，公侯皆佩紫绶龟纽金印。",{"a":1,"w":[1297,7684,7990,3348]}],["传爵袭紫","chuánjuéxízǐ","指继承高爵显位『制，公侯皆佩紫绶龟纽金印。",{"a":1,"w":[1297,8494,7990,3348]}],["炊沙镂冰","chuīshālòubīng","炊沙不能成饭，刻冰不能作器。比喻徒劳无功。",{"a":1,"w":[10402,7472,56566]}],["出幽升高","chū yōu shēnggāo","犹言出谷迁乔。比喻人的境遇好转或职位升迁。",{"a":1,"w":[22,8098,3975]}],["除害兴利","chúhàixīnglì","根除对人民有害的事，兴办对人民有利的事业。",{"a":1,"w":[34070,75563]}],["愁长殢酒","chóuchángtìjiǔ","愁长愁闷的心肠；殢困扰。心肠愁闷容易病酒。",{"a":1,"w":[3481,515,173983]}],["酬功给效","chóugōnggěixiào","效，呈献，献出（生命者）。指赏赐有功劳者。",{"a":1,"w":[8667,7516,112,7590]}],["池酒林胾","chíjiǔlínzì","胾，切成的大块肉。形容酒肉极多，生活奢侈。",{"a":1,"w":[7815,594,7469,37261]}],["瞠呼其后","chēng hū qíhòu","在别人后面干瞪眼赶不上。形容远远落在后面。",{"a":1,"w":[21127,7783,24907]}],["承星履草","chéngxīnglǚcǎo","头戴星光，脚踏草地。形容早出晚归辛勤劳作。",{"a":1,"w":[7576,7443,7942,521]}],["沉李浮瓜","chénlǐfúguā","吃在冷水里浸过的瓜果。形容暑天消夏的生活。",{"a":1,"w":[2330,7880,4670,2370]}],["察己知人","chájǐzhīrén","指情理之中的事情，察度自己，就可知之别人。",{"a":1,"w":[7567,7767,22223]}],["谄上骄下","chǎnshàngjiāoxià","谄讨好，奉承。对上谄媚讨好，对下骄横无理。",{"a":1,"w":[10747,9,8457,17]}],["餐霞漱瀣","cānxiá shù xiè","餐食日霞，吸饮沆瀣。指超尘脱俗的仙家生活。",{"a":1,"w":[159913,11195,113113]}],["餐霞吸露","cānxiáxīlù","餐食日霞，吸饮沆瀣。指超尘脱俗的仙家生活。",{"a":1,"w":[159913,2331,4674]}],["餐霞饮景","cānxiáyǐnjǐng","餐食日霞，吞饮日光。指超尘脱俗，修炼成仙。",{"a":1,"w":[159913,7871,4676]}],["餐霞饮瀣","cānxiá yǐn xiè","餐食日霞，吸饮沆瀣。指超尘脱俗的仙家生活。",{"a":1,"w":[159913,7871,113113]}],["不知所言","bùzhīsuǒyán","形容说话内容混乱，无法理解。同不知所云”。",{"a":1,"w":[8213,1281,7440]}],["才德兼备","cáidé jiānbèi","才才能。德品德。备具备。才能和品德都具备。",{"a":1,"w":[191700,70610]}],["才望高雅","cáiwàng gāoyǎ","形容人富有才学，享有很高的声望，不同流俗。",{"a":1,"w":[201360,117410]}],["不习地土","bùxídìtǔ","对于一个地方的气候条件或饮食习惯不能适应。",{"a":1,"w":[0,7678,47180]}],["不绝如带","bùjuérúdài","形容局势危急，象差点儿就要断掉的带子一样。",{"a":1,"w":[15353,4614,542]}],["不敢造次","bùgǎnzàocì","造次仓促、莽撞。指不敢匆忙地或鲁莽地从事。",{"a":1,"w":[10096,68174]}],["拨乱为治"