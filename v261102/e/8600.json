[["国际现代建筑会议","guójì xiàndàijiànzhù huìyì","ICMA = International Congress for Modern Architecture; CIAM = International Congress for Modern Architecture",{"a":1,"w":[617,261126,1469]}],["弹炮情报指挥系统","dàn pào qíngbào zhǐhuīxìtǒng","地空导弹与高炮情报指挥系统的简称。防空旅、团实施对空侦察和作战的指挥自动化系统。由计算机、通信器材、雷达接口装置和运载车辆等组成。包括旅站、团站、营站、连站和雷达站。能自动为地空导弹和高炮提供射击方案，传送目标诸元。",{"a":1,"w":[3318,4644,4933,36278]}],["登陆指挥控制舰艇","dēnglù zhǐhuīkòngzhì jiàntǐng","登陆作战中，在登陆海域内专门负责对登陆舰艇进行指挥、控制和协调的舰艇的统称。通常在冲击出发线两端设前方控制艇，在展开线至冲击出发线之间的航道翼侧设航道控制艇，在展开(换乘)区设区域控制艇，在登陆海域中央设基本指挥舰。",{"a":1,"w":[4993,124628,5340]}],["海上遇险求救信号","hǎishàng yùxiǎn qiújiùxìnhào","简称遇险信号或海难信号。海上舰船、飞机遇险时用于求救的信号。分为国际遇险信号和军内遇险信号。国际遇险信号包括视觉信号、音响信号和无线电信号。舰艇、军用飞机遇险时一般使用军内遇险信号，在特殊情况下方可使用国际遇险信号。",{"a":1,"w":[1014554,135146]}],["全身适应综合征","quánshēn shìyìngzōnghézhēng","адаптационный синдром",{"a":1}],["各向同性辐射器","gèxiàngtóngxìngfúshè qì","изотропный излучатель",{"a":1}],["对话式编译程序","duìhuà shì biānyìchéngxù","диалоговый компилятор",{"a":1}],["男性生殖器病学","nánxìngshēngzhíqì bìng xué","андрология, andrology",{"a":1}],["血纤维蛋白溶酶","xuèxiānwéidànbái róng méi","plasmin, фибринолизин",{"a":1}],["异步感应发电机","yìbù gǎnyìngfādiànjī","асинхронный генератор",{"a":1}],["钢筋混凝土框架","gāngjīnhùnníngtǔ kuàngjià","железобетонный каркас",{"a":1}],["多合同承包方式","duō hétong chéngbāofāng shì","покомпонентный подход",{"a":1}],["不合规格的样品","bùhé guīgé de yàngpǐn","забракованный образец",{"a":1}],["二氧化碳分析器","èryǎnghuàtàn fēnxīqì","газоанализатор на СО2",{"a":1}],["冲息多谐振荡器","chōng xī duōxiézhèndàngqì","ждущий мультивибратор",{"a":1}],["凝血第十三因子","níngxuè dìshísān yīnzǐ","фактор свёртывания ⅩⅢ",{"a":1}],["微细颗粒混悬液","wēixì kēlì hùnxuányè","тонкозернистая взвесь",{"a":1}],["念珠菌性肉芽肿","niànzhūjūn xìng ròuyázhǒng","кандидозная гранулёма",{"a":1}],["感染性神经元炎","gǎnrǎnxìng shénjīngyuán yán","инфекционный нейронит",{"a":1}],["替代性纤维变性","tìdàixìng xiānwéi biànxìng","заместительный фиброз",{"a":1}],["温度感觉测验器","wēndù gǎnjué cèyànqì","термофор, thermophore",{"a":1}],["环状软骨切开术","huánzhuàngruǎngǔ qiēkāishù","крикотомия,