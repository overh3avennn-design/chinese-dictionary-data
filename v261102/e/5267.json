]}],["翔骞","xiángqiān","高飞。亦指远行之人。",{"a":1,"w":[8986,13269]}],["翠旄","cuìmáo","杆顶饰以翠羽的旗帜。",{"a":1,"w":[7928,13837]}],["翠蜡","cuìlà","一种带有香气的蜡烛。",{"a":1,"w":[7928,8142]}],["翠辇","cuìniǎn","饰有翠羽的帝王车驾。",{"a":1,"w":[7928,10459]}],["玩华","wánhuá","谓讲究文辞华丽雕琢。",{"a":1,"w":[648,7503]}],["翳蔽","yìbì","幽深不明；隐蔽不露。",{"a":1,"w":[9715,8083]}],["翻海","fānhǎi","形容声响如海涛翻腾。",{"a":1,"w":[2337,528]}],["翻盏","fānzhǎn","形容马蹄腾疾的样子。",{"a":1,"w":[2337,10030]}],["翻竞","fānjìng","谓竞相翻新。含贬义。",{"a":1,"w":[2337,8144]}],["老欧","lǎo'ōu","指宋代文学家欧阳修。",{"a":1,"w":[55,7621]}],["考省","kǎoshěng","考校省察；考校查核。",{"a":1,"w":[148,607]}],["耄皤","màopó","老而头白。泛指高龄。",{"a":1,"w":[12205,32606]}],["者别","zhěbié","蒙古语“箭”的音译。",{"a":1,"w":[1285,69]}],["耆昧","qímèi","致昧，使之至于昏乱。",{"a":1,"w":[8495,9075]}],["耆率","qílǜ","老将。率，通“帅”。",{"a":1,"w":[8495,7458]}],["耐静","nàijìng","安于清静，忍受寂寞。",{"a":1,"w":[7954,1386]}],["端启","duānqǐ","书信常用语。犹专函。",{"a":1,"w":[4659,7875]}],["耿烈","gěngliè","正直刚烈；光明炽热。",{"a":1,"w":[11102,7947]}],["圣裁","shèngcái","犹圣断。皇上的裁断。",{"a":1,"w":[7587,7851]}],["聘弓","pìngōng","古代聘问时持用之弓。",{"a":1,"w":[8784,8097]}],["闻家","wénjiā","显达、有名望的家族。",{"a":1,"w":[629,28]}],["闻义","wényì","谓听到合乎义理的事。",{"a":1,"w":[629,7437]}],["联职","liánzhí","犹同事。谓职务相连。",{"a":1,"w":[7455,7609]}],["联蝉","liánchán","连续。多指连任官职。",{"a":1,"w":[7455,8931]}],["声党","shēngdǎng","唐宋时称擅长歌唱者。",{"a":1,"w":[3317,4685]}],["耸异","sǒngyì","惊奇。耸，通“悚”。",{"a":1,"w":[5040,7464]}],["耸目","sǒngmù","动人眼目；耸动眼目。",{"a":1,"w":[5040,7465]}],["职吏","zhílì","旧指地位低下的官吏。",{"a":1,"w":[7609,8898]}],["职孤","zhígū","主持抚养孤儿的职官。",{"a":1,"w":[7609,7996]}],["职币","zhíbì","古官名。掌官用余财。",{"a":1,"w":[7609,7943]}],["职岁","zhísuì","古官名。掌邦赋支出。",{"a":1,"w":[7609,195]}],["职素","zhísù","指原来的身分和职务。",{"a":1,"w":[7609,7468]}],["职规","zhíguī","关于职务的规章制度。",{"a":1,"w":[7609,7549]}],["听纳","tīngnà","听从采纳；听谏纳善。",{"a":1,"w":[146,7454]}],["肃如","sùrú","犹肃然。恭敬整饬貌。",{"a":1,"w":[8439,4614]}],["肆手","sìshǒu","放手。谓随意，任意。",{"a":1,"w":[8346,34]}],["肆逆","sìnì","横行不法，背叛作乱。",{"a":1,"w":[8346,7762]}],["肉燎","ròuliáo","犹心焦。谓焦急难过。",{"a":1,"w":[