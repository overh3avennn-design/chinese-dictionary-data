[["软红","ruǎnhóng","1) 犹言软红尘。谓繁华热闹。\n2) 柔和的红色。",{"a":1,"w":[3349,534]}],["轲机","kējī","指孟子母亲的织机。语本汉刘向《列女传‧邹孟轲母》。",{"a":1,"w":[15171,7405]}],["输荣","shūróng","五腧穴中的两类穴位。输，通“腧”。泛指经络、穴位。",{"a":1,"w":[1352,7887]}],["辨合","biànhé","符合，契合。指论说的道理与事实相符。辨，通“别”。",{"a":1,"w":[8004,1269]}],["辨晰","biànxī","1) 辨析，分析。\n2) 分辩明白。辨，通“辩”。",{"a":1,"w":[8004,15939]}],["辨诘","biànjí","1) 查问，查办。\n2) 辩难诘问。辨，通“辩”。",{"a":1,"w":[8004,10718]}],["迅景","xùnjǐng","1) 疾行的太阳。\n2) 指光阴。时光易逝，故称。",{"a":1,"w":[9463,4676]}],["迎见","yíngjiàn","1) 迎面遇见。\n2) 犹预见。\n3) 迎接拜见。",{"a":1,"w":[8235,76]}],["迨吉","dàijí","语本《诗‧召南‧摽有梅》：“求我庶士，迨其吉兮。”",{"a":1,"w":[22414,7582]}],["退故","tuìgù","1) 谓器物陈旧而不用。\n2) 指陈旧不用的器物。",{"a":1,"w":[1371,7486]}],["退茹","tuìrú","佛教指雪山白牛的粪便。据说其粪细洁而香，可作涂料。",{"a":1,"w":[1371,8598]}],["逆案","nì'àn","1) 指叛逆的案件。\n2) 特指明末魏忠贤阉党案。",{"a":1,"w":[7762,7610]}],["通呈","tōngchéng","1) 通报呈递。\n2) 掌管宾客往来联络事务的人。",{"a":1,"w":[518,8775]}],["通庄","tōngzhuāng","1) 通道，往来的大路。\n2) 指所有下赌注的人。",{"a":1,"w":[518,7932]}],["逼同","bītóng","谓古代地位在下的冒用与地位在上的相同的名义或物品。",{"a":1,"w":[4792,4611]}],["遁秦","dùnqín","1) 谓逃避秦的苛政。\n2) 泛指逃避乱世、苛政。",{"a":1,"w":[10189,8261]}],["过位","guòwèi","1) 谓经过君主所立之位置。\n2) 前往某一处所。",{"a":1,"w":[25,545]}],["过厚","guòhòu","1) 过甚；过分。\n2) 过分厚重。\n3) 宽厚。",{"a":1,"w":[25,2336]}],["遐观","xiáguān","1) 纵观；遍览。\n2) 远眺。\n3) 回顾往事。",{"a":1,"w":[9544,7514]}],["道妙","dàomiào","1) 佛教或道教学说的精义、经典。\n2) 指文章。",{"a":1,"w":[511,4764]}],["递运","dìyùn","1) 交替运转；循环往复。\n2) 驿站运输；转运。",{"a":1,"w":[3437,3313]}],["递迁","dìqiān","1) 更易变化。\n2) 顺次提升。\n3) 犹迭毁。",{"a":1,"w":[3437,8003]}],["远世","yuǎnshì","I\n久远之年代；数世以前。\nII\n远离尘世，避世。",{"a":1,"w":[103,7462]}],["远迈","yuǎnmài","1) 高远豪迈。\n2) 远远地超过。\n3) 远行。",{"a":1,"w":[103,4743]}],["遣币","qiǎnbì","古代婚嫁礼仪之一。求婚时男方向女方赠送币帛等礼物。",{"a":1,"w":[8864,7943]}],["遣行","qiǎnxíng","1) 犹言派遣发兵。\n2) 谓妻子被丈夫休弃离去。",{"a":1,"w":[8864,8]}],["遮罗","zhēluó","亦作“遮逻”。\n1) 拦截捕捉。\n2) 遮拦保护。",{"a":1,"w":[8215,7420]}],["遶佛","ràofú","环绕着佛或佛像兜圈子。佛教以此表示对佛的敬信之情。",{"a":1,"w":[57999,4682]}],["选首","xuǎnshǒu","1) 被选中的最佳者。\n2) 指首先选拔任用的人。",{"a":1,"w":[588,2310]}],["遗图","yítú","1) 指前人留下的谋划。\n2) 指前代留下的图卷。",{"a":1,"w":[7664,1301]}],["遗想","yíxiǎng","1) 俗虑；杂念。\n2) 对古人古事或往事的怀想。",{"a":1,"w":[7664,156]}],["遗构","yígòu","1) 前代留下的建筑物。\n2) 以前留下来的制度。",{"a":1,"w":[7664,7540]}],["遗叹","yítàn","1) 前人留下的歌咏或感叹。\n2) 泛指留下感叹。",{"a":1,"w":[7664,8742]}],["遗绩","yíjì","1) 谓遗留功绩于后世。\n2) 指前人遗留的功绩。",{"a":1,"w":[7664,8634]}],["遗旧","yíjiù","1) 谓抛弃、疏远故旧。\n2) 指前代留下的旧臣。",{"a":1,"w":[7664,1396]}],["遗苞","yíbāo","1) 苞，通“殍”。谓遗弃饿殍。\n2) 遗脱叶壳。",{"a":1,"w":[7664,8067]}],["遗论","yílùn","1) 指前人留下的观点、见解。\n2) 余论；异议。",{"a":1,"w":[7664,7480]}],["遗议","yíyì","1) 谓遭致异议和非议。\n2) 指遗漏未及之评论。",{"a":1,"w":[7664,7521]}],["遗路","yílù","1) 指黄泉路。\n2) 失败；危险。路，通“露”。",{"a":1,"w":[7664,54]}],["遗露","yílù","1) 谓留下露水。\n2) 犹坠露。\n3) 犹显露。",{"a":1,"w":[7664,4674]}],["邃深","suìshēn","1) 深邃，幽深。\n2) 庄严肃穆。\n3) 精深。",{"a":1,"w":[11821,1343]}],["还主","háizhǔ","1) 惑乱君主。还，通“营”。\n2) 归还给主人。",{"a":1,"w":[129,7425]}],["还兵","háibīng","1) 回师。\n2) 倒戈，反正。\n3) 交还兵权。",{"a":1,"w":[129,2282]}],["还源","háiyuán","1) 返归本源。\n2) 佛教语。由迷误而转入醒悟。",{"a":1,"w":[129,7816]}],["还策","háicè","1) 策杖而归。\n2) 指还归时需带的手杖等行装。",{"a":1,"w":[129,7673]}],["还轸","háizhěn","1) 犹回车。谓乘车周历各国。\n2) 引申为出奔。",{"a":1,"w":[129,11130]}],["边戎","biānróng","1) 边境地区的少数民族。\n2) 边地战事；守边。",{"a":1,"w":[553,8500]}],["边计","biānjì","1) 守边之计。\n2) 用于守边的财饷；边防费用。",{"a":1,"w":[553,7428]}],["邸城","dǐchéng","古代在京师为郡国诸侯或外藩君主朝觐起居所建的小城。",{"a":1,"w":[10202,1353]}],["郡志","jùnzhì","地方志的一种。记录一郡山川、物产、人文等情况的书。",{"a":1,"w":[9030,7626]}],["乡场","xiāngchǎng","I\n指农村集镇或集市。\nII\n科举时代的乡试考场。",{"a":1,"w":[3375,544]}],["邹律","zōulǜ","相传战国齐人邹衍精于音律，吹律能使地暖而禾黍滋生。",{"a":1,"w":[12763,7544]}],["鄣泥","zhāngní","即马鞯。因垫在马鞍下，垂于马背两旁以挡尘土，故称。",{"a":1,"w":[53731,4651]}],["酒衣","jiǔyī","1) 以镌镂金银为饰的酒盏。\n2) 酒迹渍染之衣。",{"a":1,"w":[594,7536]}],["酰醢","xiānhǎi","用鱼肉等制成的酱。因调制肉酱必用盐醋等作料，故称。",{"a":1,"w":[10734,25514]}],["释梵","shìfàn","1) 指释迦。\n2) 帝释和梵天。佛经中天的名称。",{"a":1,"w":[7824,9152]}],["释解","shìjiě","1) 解释，说明因由。\n2) 解决疑难事件或问题。",{"a":1,"w":[7824,4620]}],["野候","yěhòu","古代为迎宾客在野外路旁所设的房舍，周曰庐，汉曰候。",{"a":1,"w":[4626,7622]}],["钧甄","jūnzhēn","钓和甄。均为制造陶器所用的转轮。比喻造就人才之所。",{"a":1,"w":[9707,10660]}],["巨宝","jùbǎo","1) 指陈宝。传说中鸡头而人身的神。\n2) 重宝。",{"a":1,"w":[7862,2313]}],["钩百","gōubǎi","上百次地回旋。一说钩通“奏”。“钩百”谓趋走百里。",{"a":1,"w":[7696,133]}],["银砾","yínlì","1) 含银的小颗粒。\n2) 比喻闪着银光的点状物。",{"a":1,"w":[1350,9461]}],["铜凤","tóngfèng","1) 铜制的凤形测风仪器。\n2) 铜制的凤形饰物。",{"a":1,"w":[4724,7768]}],["衔须","xiánxū","1) 口含胡须。\n2) 口含胡须。一种愤怒的表示。",{"a":1,"w":[8703,7629]}],["销歇","xiāoxiē","1) 消失。\n2) 衰败零落。\n3) 停息；休止。",{"a":1,"w":[7663,3462]}],["锋距","fēngjù","犹锋芒。距，鸡爪后突出如趾的尖骨，相斗时以刺对方。",{"a":1,"w":[8275,7632]}],["锥印","zhuīyìn","指苏秦以锥刺股、发奋夜读。事见《战国策‧秦策一》。",{"a":1,"w":[7992,4649]}],["钱平","qiánpíng","即库平。古时部库征收租税、出纳银两所用的衡量标准。",{"a":1,"w":[138,525]}],["锁树","suǒshù","《晋书‧刘聪载记》载：刘聪将宫殿，廷尉陈元达谏阻。",{"a":1,"w":[3368,109]}],["铿纯","kēngchún","1) 形容声音洪亮和谐。\n2) 指洪亮和谐的声音。",{"a":1,"w":[15974,2373]}],["鏬","xià","xià\n同“罅”。\n《尔雅‧释虫》：“翥，丑鏬。”",{"a":1}],["镌磨","juānmó","1) 雕刻；磨磋。\n2) 比喻道德文章的砥砺锤炼。",{"a":1,"w":[14209,4677]}],["铁立","tiělì","1) 形容岿然挺立，像铁铸的一样。\n2) 指松林。",{"a":1,"w":[1298,3314]}],["铁船","tiěchuán","1) 船壳用钢板制成的大船。\n2) 指庐山铁船峰。",{"a":1,"w":[1298,621]}],["铛鬲","dānggé","一种古代炊器。圆口，有三只空心足。用陶或金属制成。",{"a":1,"w":[15637,23308]}],["钻瓦","zuānwǎ","一种占卜术。钻刺瓦片，并以火灼，视其裂纹以卜吉凶。",{"a":1,"w":[4692,7533]}],["长告","zhǎnggào","1) 旧时官吏告请长假。\n2) 常用为辞职的婉辞。",{"a":1,"w":[515,7591]}],["长案","zhǎng'àn","1) 长桌。\n2) 科举时公布县考等第名次的长榜。",{"a":1,"w":[515,7610]}],["开析","kāixī","1) 劈开。\n2) 得到启发和解悟。\n3) 分析。",{"a":1,"w":[31,7744]}],["闰分","rùnfēn","指农历一年和地球绕太阳一周的时间相比所多余的时日。",{"a":1,"w":[11427,15]}],["闲串","xiánchuàn","亦作“闲串”。\n1) 犹闲逛。\n2) 指无事串门。",{"a":1,"w":[3381,4740]}],["闲简","xiánjiǎn","亦作“闲简”。\n1) 清闲。\n2) 指清闲的官职。",{"a":1,"w":[3381,7804]}],["闲素","xiánsù","亦作“闲素”。\n1) 悠闲纯朴。\n2) 安闲清静。",{"a":1,"w":[3381,7468]}],["闲远","xiányuǎn","亦作“闲远”。\n1) 闲静深远。\n2) 安闲清高。",{"a":1,"w":[3381,103]}],["关决","guānjué","1) 报请决定。\n2) 指决断。\n3) 参与决策。",{"a":1,"w":[65,7574]}],["陔兰","gāilán","《文选‧束晰〈补亡诗〉》：“循彼南陔，言采其兰。”",{"a":1,"w":[27022,7450]}],["除饰","chúshì","1) 古代下葬时除去棺上的帷饰。\n2) 整治修饰。",{"a":1,"w":[4635,7951]}],["陵历","línglì","谓星辰超越本来轨道而进入他星轨道，常指日月蚀现象。",{"a":1,"w":[7966,7643]}],["隅夷","yúyí","古代神话传说中日出处。后多指朝鲜、日本等东方诸国。",{"a":1,"w":[9362,7910]}],["陨箨","yǔntuò","1) 剥落笋壳。比喻衰败之势。\n2) 掉下的笋壳。",{"a":1,"w":[8185,32164]}],["隙日","xìrì","1) 过隙的阳光。喻易逝的时光。\n2) 空闲时日。",{"a":1,"w":[8385,50]}],["随命","suímìng","古代三科运命说之一种。谓寿命久暂与其德行好坏相应。",{"a":1,"w":[1375,4622]}],["隐闵","yǐnmǐn","1) 隐忍着忧伤。闵，通“悯”。\n2) 谓无形迹。",{"a":1,"w":[7652,10057]}],["隶行","lìxíng","汉字隶变的一种。篆字结构移动后的隶定，称“隶行”。",{"a":1,"w":[8847,8]}],["只翼","zhǐyì","1) 单翅。\n2) 指孤独的鸟。比喻妇人独守空房。",{"a":1,"w":[612,4645]}],["隼旆","sǔnpèi","画有隼鸟的旗帜。古时诗文中常用以为州郡长官之标志。",{"a":1,"w":[20908,14637]}],["隼旗","sǔnqí","画有隼鸟的旗帜。古时诗文中常用以为州郡长官之标志。",{"a":1,"w":[20908,7796]}],["雅况","yǎkuàng","1) 美好的赐予。况，通“贶”。\n2) 风雅之情。",{"a":1,"w":[7788,7889]}],["雉涧","zhìjiàn","山谷名。相传南朝梁罗子锺埋葬此处，化而为雉，故名。",{"a":1,"w":[9135,17942]}],["雕刺","diāocì","1) 古代刑徒发配时面上刺字。\n2) 谓指攀他人。",{"a":1,"w":[8192,2300]}],["双胜","shuāngshèng","传统的装饰艺术。两个菱形或圆形相扣一起，成为图案。",{"a":1,"w":[1309,1373]}],["双崤","shuāngxiáo","1) 指东西崤山。在今河南省西部。\n2) 指殽谷。",{"a":1,"w":[1309,145694]}],["杂术","záshù","1) 犹言各派学说。\n2) 指医、卜、星、相之术。",{"a":1,"w":[4680,7471]}],["杂论","zálùn","1) 共同议论。\n2) 漫无中心，涉及面广的议论。",{"a":1,"w":[4680,7480]}],["杂识","záshí","I\n犹杂念。\nII\n犹杂记。古人多以此名书以见义。",{"a":1,"w":[4680,4658]}],["雨暮","yǔmù","指男女欢会之时。用巫山神女朝为行云，暮为行雨之典。",{"a":1,"w":[159,8841]}],["雪氛","xuěfēn","雪花纷飞。语本《诗‧小雅‧信南山》：“雨雪雰雰。”",{"a":1,"w":[616,9649]}],["云幌","yúnhuǎng","1) 像布幔一样的垂云。\n2) 称道观中用的帷幕。",{"a":1,"w":[554,11672]}],["云幡","yúnfān","1) 饰有云形图案的旗帜。\n2) 出殡时用的灵幡。",{"a":1,"w":[554,10797]}],["云涯","yúnyá","1) 与云相接之处；高远之处。\n2) 曲折的河岸。",{"a":1,"w":[554,9881]}],["云腻","yúnnì","1) 谓云层厚重。\n2) 比喻女子浓黑光润的头发。",{"a":1,"w":[554,8739]}],["云蔚","yúnwèi","1) 形容颜色像云彩一样的绚丽华美。\n2) 盛貌。",{"a":1,"w":[554,10050]}],["云袍","yúnpáo","1) 道士穿用的袍子。\n2) 饰有彩云图案的官服。",{"a":1,"w":[554,9451]}],["云轩","yúnxuān","1) 云车。传说中仙人的车驾。\n2) 帝王的车乘。",{"a":1,"w":[554,8869]}],["云辇","yúnniǎn","1) 有云状文饰的车子。\n2) 相传神仙以云为车。",{"a":1,"w":[554,10459]}],["云舆","yúnyú","1) 神仙以云为车，故称。\n2) 泛指华美的车子。",{"a":1,"w":[554,8330]}],["云钲","yúnzhēng","古代打击乐器，表面有云状花纹。为行军、狩猎时所用。",{"a":1,"w":[554,21823]}],["电举","diànjǔ","1) 谓闪电。比喻闪动舒卷。\n2) 比喻速度之快。",{"a":1,"w":[12,606]}],["霄旰","xiāogàn","宵衣旰食。霄，通“宵”。旧时用来称谀帝王勤于政事。",{"a":1,"w":[9823,28176]}],["霄练","xiāoliàn","1) 指洁白的月色。霄，通“宵”。\n2) 古剑名。",{"a":1,"w":[9823,633]}],["震凌","zhènlíng","1) 指房屋的摇摇欲坠、破败。\n2) 侵凌，欺凌。",{"a":1,"w":[7751,8382]}],["霜戈","shuānggē","1) 明亮锋利的戈戟。\n2) 借指用兵，军事行动。",{"a":1,"w":[8258,7639]}],["霞襟","xiájīn","1) 道士的衣服；隐士的衣服。\n2) 美艳的衣服。",{"a":1,"w":[4805,8612]}],["雾唾","wùtuò","1) 口中呼出之热气。\n2) 借指女子轻柔的体态。",{"a":1,"w":[3421,10006]}],["露坛","lùtán","在平地上用土、石筑起的高台，供检阅军队和祭祀之用。",{"a":1,"w":[4674,8465]}],["露锷","lù'è","1) 露出刀剑锋刃。\n2) 比喻锋芒毕露咄咄逼人。",{"a":1,"w":[4674,33803]}],["灵契","língqì","1) 地契。授予天下的凭证。\n2) 谓与神灵有缘。",{"a":1,"w":[7588,8094]}],["灵洲","língzhōu","1) 对水中沙洲的美称。\n2) 山名。在广东南海。",{"a":1,"w":[7588,7759]}],["灵相","língxiāng","1) 佛教语。神佛的妙相。\n2) 灵怪奇异的现象。",{"a":1,"w":[7588,7427]}],["灵辔","língpèi","1) 神灵驾驭牲口的缰绳。\n2) 借指神灵的车驾。",{"a":1,"w":[7588,13007]}],["灵鼍","língtuó","即鼍龙。一种与鳄鱼相似的动物，皮可鞔鼓。因借指鼓。",{"a":1,"w":[7588,46381]}],["青塞","qīngsāi","指今甘肃省东北环县青山一带。古为北地郡，地近长城。",{"a":1,"w":[3320,4630]}],["青鵁","qīngjiāo","1) 水鸟名。即鵁鶄。\n2) 猛禽名。又名海东青。",{"a":1,"w":[3320,142653]}],["静者","jìngzhě","深得清静之道、超然恬静的人。多指隐士、僧侣和道徒。",{"a":1,"w":[1386,1285]}],["革鞔","gémán","谓以兽皮覆饰车舆。古代大夫以上车舆，均以革皮饰之。",{"a":1,"w":[7633,39963]}],["靴衫","xuēshān","唐开元天宝年间从驾宫人或士人之妇乘马时的胡装服式。",{"a":1,"w":[9886,9082]}],["鞍花","ānhuā","骡马背上被鞍具磨伤后长出的毛作白色，谓之“鞍花”。",{"a":1,"w":[9598,20]}],["鞙佩","xuànpèi","垂挂着玉佩。语本《诗‧小雅‧大东》：“鞙鞙佩璲。”",{"a":1,"w":[122845,7810]}],["鞠径","jūjìng","菊径。鞠，通“菊”。种植菊花的小路。比喻隐逸之所。",{"a":1,"w":[10161,7769]}],["鞭呼","biānhū","古代官员赴朝会时，武士执鞭呼叫示威戒警以驱赶行人。",{"a":1,"w":[8162,7783]}],["鞭稍","biānshāo","1) 鞭梢。钢鞭的前端。\n2) 鞭梢。马鞭的末端。",{"a":1,"w":[8162,3565]}],["韩子","hánzi","1) 指战国韩非。\n2) 指唐韩愈。\n3) 书名。",{"a":1,"w":[8332,1]}],["音均","yīnjūn","《文选‧成公绥＜啸赋＞》：“音均不恒，曲无定制。”",{"a":1,"w":[7498,7820]}],["韶雅","sháoyǎ","1) 《韶》乐和《雅》乐的合称。\n2) 俊美优雅。",{"a":1,"w":[10368,7788]}],["响钞","xiǎngchāo","元代发行纸币，称为钞，故俗称现银和铜钱为“响钞”。",{"a":1,"w":[639,8820]}],["题榜","tíbǎng","1) 题写匾额。榜，匾额。\n2) 指所题写的匾额。",{"a":1,"w":[615,8885]}],["颜冉","yánrǎn","颜回、冉耕的并称。二人均为孔子弟子，皆以德行着称。",{"a":1,"w":[8117,11768]}],["类丑","lèichǒu","1) 指附属于宗族内的奴隶。\n2) 指善良的同类。",{"a":1,"w":[1323,3425]}],["风娲","fēngwā","即女娲。传说中的人类始祖，曾用黄土造人，炼石补天。",{"a":1,"w":[44,28821]}],["风形","fēngxíng","1) 犹风貌。指容貌姿态。\n2) 指风的大小动向。",{"a":1,"w":[44,4612]}],["飘游","piāoyóu","1) 四处游荡，无所事事的样子。\n2) 轻缓飘动。",{"a":1,"w":[3467,1317]}],["食次","shícì","1) 就食之时。\n2) 食品。多指酒菜、点心之类。",{"a":1,"w":[7466,102]}],["饤盘","dìngpán","1) 果物盛放于盘中。\n2) 指盛放在盘中的果物。",{"a":1,"w":[20627,2285]}],["饭头","fàntóu","1) 寺院中管伙食的和尚。\n2) 泛指管伙食的人。",{"a":1,"w":[169,509]}],["饿乡","èxiāng","1) 缺乏食物的贫困去处。\n2) 饥火中烧的境地。",{"a":1,"w":[229,3375]}],["余芬","yúfēn","1) 残留的香气。\n2) 比喻传留后世的美德懿行。",{"a":1,"w":[7597,8444]}],["馆官","guǎnguān","唐宋时弘文馆、史馆、集贤院等编修、教授之类的官员。",{"a":1,"w":[7919,2293]}],["馈饩","kuìxì","1) 赠送粮草、牲腥。\n2) 引申指料理生活杂事。",{"a":1,"w":[8692,12244]}],["饙馏","fēnliú","1) 蒸饭。\n2) 指饭食。\n3) 指蒸腾的气体。",{"a":1,"w":[211181,9873]}],["首荐","shǒujiàn","1) 首先推荐。\n2) 指科举考试中被取为第一名。",{"a":1,"w":[2310,8795]}],["香官","xiāngguān","1) 奉命往神庙进香的官员。\n2) 朝山进香的人。",{"a":1,"w":[1311,2293]}],["马塍","mǎchéng","1) 合欢的别名。\n2) 地名。在浙江省余杭县西。",{"a":1,"w":[1273,45916]}],["马直","mǎzhí","1) 马的价钱。\n2) 古代守卫京城、王府的骑兵。",{"a":1,"w":[1273,1294]}],["冯岑","féngcén","东汉冯异、岑彭的并称。两人同为光武大将，功至封侯。",{"a":1,"w":[8535,8832]}],["腾尺","téngchǐ","谓作文。尺，指长约一尺的帛素或简牍，古代用以写字。",{"a":1,"w":[7985,2347]}],["髀盖","bìgài","即古代天文学家所倡的盖天说。因出自《周髀》，故称。",{"a":1,"w":[17475,2289]}],["高让","gāoràng","拱手相让。旧时表示推让、辞让，往往高拱其手，故称。",{"a":1,"w":[35,627]}],["高帆","gāofān","亦作“高帆”。\n1) 高大的帆。\n2) 借指大船。",{"a":1,"w":[35,8810]}],["髦民","máomín","古传说中的毛民国。其人身上长有长毛。髦，通“毛”。",{"a":1,"w":[10415,7434]}],["鬼戏","guǐxì","1) 有鬼魂角色上场的戏剧。\n2) 喻骗人的花招。",{"a":1,"w":[3340,3341]}],["鬼疰","guǐzhù","迷信者称流注，即流窜无定随处可生的多发性深部脓疡。",{"a":1,"w":[3340,44900]}],["鱼简","yújiǎn","鱼鼓和简子。唱道情者常用以伴奏的乐器。亦借指艺人。",{"a":1,"w":[526,7804]}],["鲠咽","gěngyàn","I\n谓阻塞咽喉之地。\nII\n犹哽咽。鲠，通“哽”。",{"a":1,"w":[13292,9066]}],["鳀海","tíhǎi","古称会稽之外海。因其间有东鯷人所建二十余小国而名。",{"a":1,"w":[13103,528]}],["凤咮","fèngzhòu