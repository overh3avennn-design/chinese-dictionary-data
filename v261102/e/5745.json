[["谏争如流","jiànzhēng rúliú","谏争争同诤”，直言相劝。劝谏的话如同流水一样，滔滔不绝。",{"a":1,"w":[212938,19473]}],["剪发杜门","jiǎnfàdùmén","剪发剪掉头发，指削发为僧；杜门闭门。剪发为僧，闭门不出。",{"a":1,"w":[53559,25913]}],["家无担石","jiāwúdànshí","十斗为一石，两石为一担。形容家里没有存粮。比喻家境困难。",{"a":1,"w":[28,2255,750941]}],["家无儋石","jiāwúdànshí","十斗为一石，两石为一儋。形容家里没有存粮。比喻家境困难。",{"a":1,"w":[28,2255,103459]}],["嫉闲妒能","jíxiándùnéng","嫉、妒因别人好而忌恨。对品德、才能比自己强的人心怀怨恨。",{"a":1,"w":[12776,3381,10231,41]}],["虮虱相吊","jǐshīxiāngdiào","虮虱的幼卵; 吊慰问。虮和虱相互怜悯。比喻自怜即将灭亡。",{"a":1,"w":[80675,7427,4693]}],["积重不反","jīzhòngbùfǎn","经过长时间形成的思想作风或习惯，很难改变。同积重难返”。",{"a":1,"w":[27819,68345]}],["积重不返","jīzhòngbùfǎn","经过长时间形成的思想作风或习惯，很难改变。同积重难返”。",{"a":1,"w":[27819,55865]}],["积重难反","jīzhòngnánfǎn","经过长时间形成的思想作风或习惯，很难改变。同积重难返”。",{"a":1,"w":[27819,117,2260]}],["混作一谈","hùnzuòyītán","把不同的事物混在一起，当作同样的事物谈论。同混为一谈”。",{"a":1,"w":[106345,5,1427]}],["火尽薪传","huǒjìnxīnchuán","火虽烧完，柴却留传下来。比喻思想、学术、技艺等世代相传。",{"a":1,"w":[1284,4675,176945]}],["火烛小心","huǒzhú xiǎoxīn","火烛泛指能起火的东西。原指谨防失火。亦泛指处事小心谨慎。",{"a":1,"w":[36228,812]}],["毁瓦画墁","huǐwǎhuàmàn","打碎屋瓦，涂灭已画好的田地界线。比喻一种无益不害的行为。",{"a":1,"w":[4749,7533,625,17038]}],["黄冠草履","huángguàncǎolǚ","粗劣的衣着。借指平民百姓。有时指草野高逸。同黄冠草服”。",{"a":1,"w":[28330,51759]}],["黄冠野服","huángguànyěfú","粗劣的衣着。借指平民百姓。有时指草野高逸。同黄冠草服”。",{"a":1,"w":[28330,152009]}],["灰躯糜骨","huīqūmígǔ","犹言粉身碎骨。比喻为了某种目的或遭到什么危险而丧失生命。",{"a":1,"w":[3344,10987,9609,7537]}],["灰身粉骨","huīshēnfěngǔ","犹言粉身碎骨。比喻为了某种目的或遭到什么危险而丧失生命。",{"a":1,"w":[3344,7456,7613,7537]}],["画虎刻鹄","huà hǔ kèhú","①比喻好高鹜远，终无成就。②比喻好事做不成，反变了坏事。",{"a":1,"w":[60937,94029]}],["怀柔天下","huáiróu tiānxià","使天下归服。怀柔旧指统治者用政治手腕笼络人心，使之归服。",{"a":1,"w":[29257,4801]}],["糊口度日","húkǒudùrì","糊口本是喝粥的意思。度日过日子。勉强维持生活，打发日子。",{"a":1,"w":[38481,31120]}],["闳侈不经","hóngchǐbùjīng","指不着边际，不合常理；近乎荒诞，没有根据。同闳大不经”。",{"a":1,"w":[12278,9324,11652]}],["赫斯之威","hèsīzhīwēi","赫显耀。斯语气助词。威威严。指帝王或显耀人物威武奋发貌。",{"a":1,"w":[34606,2254,7646]}],["过时黄花","guòshíhuánghuā","黄花菊花。重阳节后的菊花。比喻过了时的或失去意义的事物。",{"a":1,"w":[5987,8949]}],["海沸山裂","hǎifèishānliè","海水沸腾，山石崩裂。比喻声势或力量极大。亦作海沸山摇”。",{"a":1,"w":[754025,45,4657]}],["鬼瞰高明","guǐ kàn gāoming","指鬼神窥望显达富贵人家，将祸害其满盈之志。同鬼瞰其室”。",{"a":1,"w":[3340,13727,6686]}],["寡人之疾","guǎrén zhī jí","寡人古代君主的自称；疾病，毛病。古代君王的通病——好色。",{"a":1,"w":[29493,2254,7794]}],["管鲍之交","guǎnbào zhī jiāo","春秋时，齐人管仲和鲍叔牙相知最深◇常比喻交情深厚的朋友。",{"a":1,"w":[147224,2254,535]}],["灌夫骂座","guànfūmàzuò","灌夫西汉著名将领。指灌夫酒后骂人泄愤。形容为人刚直敢言。",{"a":1,"w":[584498,323137]}],["鼓腹击壤","gǔfù jī rǎng","原指人民吃得饱，有余闲游戏. 比喻太平盛世，百姓安居乐业",{"a":1,"w":[90610,129683]}],["瓜字初分","guāzìchūfēn","旧时文人拆瓜”字为两个八字以纪年，即十六岁。多用于女子。",{"a":1,"w":[2370,84,815926]}],["共贯同条","gòngguàntóngtiáo","串在同一钱串上，长在同一枝条上。比喻脉络连贯，事理相通。",{"a":1,"w":[2273,8062,4611,556]}],["狗偷鼠窃","gǒutōu shǔqiè","像鼠狗那样的盗贼。比喻成不了气候的反叛者。同狗盗鼠窃”。",{"a":1,"w":[202297,97080]}],["恭默守静","gōngmò shǒujìng","默沉默；守遵守，保持。恭恭敬敬地沉默，不讲话，保持肃静。",{"a":1,"w":[400893,297231]}],["隔皮断货","gé pí duànhuò","指隔着封皮，判断货物的好坏。比喻凭外部现象推测内部底细。",{"a":1,"w":[2332,1291,169140]}],["个中滋味","gèzhōngzīwèi","个中其中；滋味味道，情味。其中的味道。指切身体会的甘苦。",{"a":1,"w":[43630,5544]}],["高才大德","gāocái dàdé","高才有杰出的才能。大德有极高尚的品德。才能和品德都很好。",{"a":1,"w":[69542,16879]}],["高情逸态","gāoqíng yì tài","高情高雅的情致。逸态安闲的神态。高雅的情致，安逸的神态。",{"a":1,"w":[77379,8116,7619]}],["高文大册","gāowéndàcè","原指朝廷发布的重要文书，如诏今制诰等。引申为经典性著述。",{"a":1,"w":[105036,4,3413]}],["改头换尾","gǎitóuhuànwěi","指改变原来的面目。比喻只作形式上的变动，而实质内容不变。",{"a":1,"w":[620,509,599,7474]}],["附骥名彰","fùjì míng zhāng","附依附；骥千里马；彰显著。依附有名望者，使自己显名于世。",{"a":1,"w":[29255,560,10342]}],["覆盂之安","fùyú zhī ān","像覆置的盂那样安稳。比喻稳固，不可动摇。亦作覆盂之固”。",{"a":1,"w":[118625,2254,2261]}],["扶倾济弱","fúqīngjìruò","倾倒塌，这里指遇到困境的人。扶助困难的人，救济弱小的人。",{"a":1,"w":[3458,7714,7522,2376]}],["扶危拯溺","fúwēizhěngnì","溺落水。扶助危难者，救起落水者。比喻尽力救助别人的危难。",{"a":1,"w":[49746,13555,9168]}],["福为祸始","fúwéihuòshǐ","指福与祸没有定数，享福太甚就隐伏着祸端。亦作福为祸先”。",{"a":1,"w":[1365,550,199984]}],["凤冠霞帔","fèngguānxiápèi","旧时富家女子出嫁时的装束，以示荣耀。也指官员夫人的礼服。",{"a":1,"w":[35707,81185]}],["奉命唯谨","fèngmìng wéi jǐn","奉命接受命令；唯只有；谨小心谨慎。指服从命令，小心谨慎。",{"a":1,"w":[46501,8212,8625]}],["风雨不测","fēngyǔbùcè","风和云都不可预测。比喻事物或局势像风云变幻那样不可预测。",{"a":1,"w":[10397,20588]}],["烽火连年","fēnghuǒ liánnián","烽火古时边防报警的烟火。比喻战火或战争。指战火连年不断。",{"a":1,"w":[20752,7029]}],["锋铓毕露","fēngmángbìlù","锐气和才华全都显露出来。多指人好表现自己。同锋芒毕露”。",{"a":1,"w":[753538,53353]}],["蜂窠蚁穴","fēngkē yǐxué","比喻占据的地方极为窄小，借以对偏安一隅的地方势力的蔑称。",{"a":1,"w":[55270,61359]}],["焚薮而田","fénsǒu'értián","薮，林薮。比喻取之不留余地，只顾眼前利益，不顾长远利益。",{"a":1,"w":[9179,10471,2267,4668]}],["瞓面盎背","fènmiàn'àngbèi","指德性表现于外，而有温润之貌，敦厚之态。指有德者的仪态。",{"a":1,"w":[47749,523,12348,565]}],["丰肌弱骨","fēngjīruògǔ","丰润的肌肤，柔嫩的骨骼。形容女子或花朵娇嫩艳丽而有丰韵。",{"a":1,"w":[267508,155651]}],["废文任武","fèiwénrènwǔ","文文治；任任用；武武力。废掉文治，任用武力。指轻文重武。",{"a":1,"w":[338714,1331,7504]}],["飞沿走壁","fēiyánzǒubì","旧小说中形容有武艺的人身体轻捷，能够跳上房檐，越过墙壁。",{"a":1,"w":[56,4747,107,7850]}],["恩山义海","ēnshānyìhǎi","恩爱像高山一样重，情义像大海一样深。形容恩惠深，情义重。",{"a":1,"w":[7704,45,7437,528]}],["堆山积海","duī shānjī hǎi","堆积的如山似海。原形容占有的财富非常多。也比喻东西极多。",{"a":1,"w":[3333,105777,528]}],["独竖一帜","dúshùyīzhì","单独树起一面旗帜。比喻独特新奇，自成一家。同独树一帜”。",{"a":1,"w":[7561,4815,5,12765]}],["独有千古","dúyǒuqiāngǔ","具有流传久远的价值；具有独特的专长或优点。同独有千秋”。",{"a":1,"w":[31717,15941]}],["独有千秋","dúyǒuqiānqiū","独具流传久远的价值；具有独特的专长或优点，可以流传千古。",{"a":1,"w":[31717,16913]}],["笃信好学","dǔxìnhàoxué","笃信忠实地信仰。指对道德和事业抱有坚定的信心，勤学好问。",{"a":1,"w":[123524,5760]}],["雕墙峻宇","diāoqiáng jùnyǔ","彩绘的墙壁和高大的屋宇。形容居处豪华奢侈。同峻宇雕墙”。",{"a":1,"w":[209195,143940]}],["道头会尾","dàotóuhuìwěi","说个开头就知道结果。形容思维敏捷、悟性好。同道头知尾”。",{"a":1,"w":[511,509,18,7474]}],["得寸则寸","décùnzécùn","得到一寸就是一寸。指得到实实在在的好处，得多少就是多少。",{"a":1,"w":[520,3402,3323]}],["倒持手板","dǎochíshǒubǎn","古代官员持手板以朝。倒持手板，指惊惶失态。同倒执手版”。",{"a":1,"w":[131296,37374]}],["倒戢干戈","dǎojígāngē","把武器倒着放起来，比喻没有战争，天下太平。同倒载干戈”。",{"a":1,"w":[583,14235,16180]}],["倒裳索领","dàochángsuǒlǐng","索搜寻、寻求。把衣裳倒过来寻找领口。比喻办事抓不到要点。",{"a":1,"w":[583,9272,7470,1361]}],["带水拖泥","dàishuǐtuōní","①形容泥泞难行。②比喻不顺利或不干脆。现多作拖泥带水”。",{"a":1,"w":[38590,56280]}],["待时守分","dàishíshǒufèn","待等待；时时机；分本分。为了等待好的时机而暂时安分守己。",{"a":1,"w":[31657,86322]}],["大渐弥留","dàjiànmíliú","大渐病危；弥留本指久病不愈，后指病重将死。表示病危将死。",{"a":1,"w":[123793,53697]}],["村野匹夫","cūnyěpǐfū","村野荒村山野。匹夫平民百姓。旧指没有知识、没有地位的人。",{"a":1,"w":[198578,19918]}],["春深似海","chūnshēnsìhǎi","春天美丽的景色像大海一样深广。形容到处充满了明媚的春光。",{"a":1,"w":[131641,7803,528]}],["触类而长","chùlèi'ércháng","意指掌握一类事物知识或规律，就能据此而增长同类事物知识。",{"a":1,"w":[7734,1323,2267,515]}],["出入人罪","chūrù rén zuì","指法庭裁判错误，把有罪的人认为无罪，把无罪的人认为有罪。",{"a":1,"w":[5140,3,4686]}],["除残去秽","chúcánqùhuì","残残暴。秽污秽，比喻恶势力。清除社会上的残暴、腐朽势力。",{"a":1,"w":[4635,7814,61,9258]}],["充类至尽","chōnglèizhìjìn","充类推究同类事理；至尽到极精密处。指就事理作充分的推论。",{"a":1,"w":[7722,1323,3346,4675]}],["逞凶肆虐","chěngxiōng sìnüè","逞施展。肆放肆。虐残暴。放纵地行凶作恶，任意地进行残害。",{"a":1,"w":[160834,107261]}],["持禄养交","chílù yǎng jiāo","持禄保持禄位；养交交结权贵。指结交权贵以保持自己的职位。",{"a":1,"w":[229319,582,535]}],["巢林一枝","cháolínyīzhī","指鹪鹩筑巢，只不过占用一根树枝◇以之比喻安本分，不贪多。",{"a":1,"w":[8435,7469,25260]}],["操矛入室","cāo máo rùshì","比喻深入了解对方，找出其纰漏，又以对方的论点来批驳对方。",{"a":1,"w":[7592,8976,14612]}],["草木萧疏","cǎomù xiāoshū","萧疏冷落，稀稀落落。花草树木都已枯萎凋谢。形容深秋景象。",{"a":1,"w":[12254,221825]}],["昌歜羊枣","chāngchùyángzǎo","据传周文王嗜昌歜，春秋鲁曾点嗜羊枣◇用以指人所偏好之物。",{"a":1,"w":[254308,75631]}],["裁月镂云","cáiyuèlòuyún","剪裁明月，雕刻云霞。比喻诗文中辞藻润饰，景物描绘的新巧。",{"a":1,"w":[7851,101,9850,554]}],["不知所厝","bùzhīsuǒcuò","厝放置；安排。不知道怎么办才好。形容处境为难或心神慌乱。",{"a":1,"w":[8213,1281,15141]}],["不识马肝","bùshímǎgān","相传马肝有毒，食之能致人于死。比喻不应研讨的事不去研讨。",{"a":1,"w":[12404,138852]}],["不食马肝","bùshímǎgān","相传马肝有毒，食之能致人于死。比喻不应研讨的事不去研讨。",{"a":1,"w":[13992,138852]}],["不舞之鹤","bùwǔzhīhè","舞舞蹈。不舞蹈的鹤。比喻名不副实的人。也用来讥讽人无能。",{"a":1,"w":[0,3356,2254,8240]}],["不晓世务","bùxiǎoshìwù","不知晓当前重要的事态和时代的潮流。现也指待人接物不知趣。",{"a":1,"w":[0,8614,157877]}],["不言而信","bùyán'érxìn","旧指君子不用说什么就能得到别人的信任。形容有崇高的威望。",{"a":1,"w":[14788,2267,529]}],["不仁不义","bùrén bùyì","仁仁爱；义道义。不讲仁德，不讲道义。形容品性卑劣、残忍。",{"a":1,"w":[16786,24551]}],["不得其所","bùdéqísuǒ","原指未得善终，后指没有得到适当的安顿。也指不能达到目的。",{"a":1,"w":[8308,15848]}],["不遑启处","bùhuángqǐchǔ","没有闲暇的时间过安宁的日子。指忙于应付繁重或紧急的事务。",{"a":1,"w":[127553,282555]}],["不矜不伐","bùjīnbùfá","矜、伐自夸自大。不自经为了不起，不为自己吹嘘。形容谦逊。",{"a":1,"w":[0,8903,8087]}],["播糠眯目","bōkāngmǐmù","撒播糠秕眯住别人的眼睛。比喻外物虽小，但造成的桅却很大。",{"a":1,"w":[4713,9607,286960]}],["兵不接刃","bīngbùjiērèn","作战时兵器没接触。指战事顺利，未经交锋或激战而取得胜利。",{"a":1,"w":[2282,0,163376]}],["闭门酣歌","bìmén hāngē","指闭门不出，尽兴饮酒，尽情歌舞。形容沉缅酒色，尽情享受。",{"a":1,"w":[12769,88153]}],["背盟败约","bèiméngbàiyuē","背违背。盟、约誓约。败败坏。指撕毁。背叛誓言，撕毁盟约。",{"a":1,"w":[323031,2345,1330]}],["褒衣危冠","bāoyīwēiguān","褒衣宽大的衣服。危冠高帽子。古代儒生的装束。指宽袍高帽。",{"a":1,"w":[72607,263128]}],["饱练世故","bǎo liàn shìgù","指对世态人情有深刻感受或有丰富的处世经验。同饱谙世故”。",{"a":1,"w":[654,633,17864]}],["抱恨黄泉","bàohèn huángquán","黄泉人死埋葬的地下，指阴间。心怀遗憾离开人世，死有遗恨。",{"a":1,"w":[57072,15949]}],["抱枝拾叶","bàozhīshíyè","犹言舍本逐末。比喻不抓根本环节，而只在枝节问题上下功夫。",{"a":1,"w":[2374,4696,3494,7426]}],["白璧青蝇","bái bì qīngyíng","白璧洁白的玉，比喻清白的人。青蝇比喻佞人。比喻善恶忠佞。",{"a":1,"w":[24,8965,177710]}],["白帢青衫","bái qià qīngshān","旧时士人的服装。亦借指尚未取得功名的士人。同白袷蓝衫”。",{"a":1,"w":[24,81015,63510]}],["爱才如渴","àicái rú kě","才贤才，人才。爱慕贤才，急欲求得，就象口渴急于喝水一样。",{"a":1,"w":[413927,4614,236]}],["安身之地","ānshēnzhīdì","存身的地方。批在某地居住、生活，或以某地作为建业的根基。",{"a":1,"w":[26658,2254,10]}],["一中同长","yīzhōng tóng zhǎng","谓每个圆只有一个中心点，从圆心到圆周作直线，长度都相等。",{"a":1,"w":[41944,4611,515]}],["一干一方","yīgān yīfāng","一千一万的隐语。“干”与“千”、“方”与“万”字形相近。",{"a":1,"w":[22268,10494]}],["三同一片","sān tóngyī piàn","指干部、知识分子和工农群众同吃、同住、同劳动，打成一片。",{"a":1,"w":[74,5335,546]}],["南宰相府","nán zǎixiàng fǔ","辽代实行南北分治，设南北宰相府，南宰相府掌佐理军国大政。",{"a":1,"w":[90,20854,7706]}],["噪噪切切","zào zào qièqiè","犹言嘈嘈切切。指弦乐器上大弦和小弦发出的高低不同的声音。",{"a":1,"w":[8413,13654]}],["寿阳公主","shòuyáng gōngzhǔ","南朝宋武帝女。相传梅花落其额上，人以为美，而出现寿阳妆。",{"a":1,"w":[551576,3709]}],["外部联系","wàibù liánxì","指事物或现象之间的外部的、表面的、偶然的、非本质的联系。",{"a":1,"w":[5077,1714]}],["应天三绝","yìngtiān sān jué","唐僖宗年间，孙位在成都应天寺左壁画坐天王及其部从鬼神像。",{"a":1,"w":[47347,73804]}],["抹眉小索","mǒméixiǎosuǒ","捕捉野兽陷阱旁所设的绳子。其高齐眉，以免行人误陷，故称。",{"a":1,"w":[8295,7988,16,7470]}],["朱轓皂盖","zhūfānzàogài","红色的车障，黑色的车盖。古代高官所乘的车子。亦借指高官。",{"a":1,"w":[7906,97831]}],["枌榆松楸","fén yú sōngqiū","谓怀念故乡，悼念亲人。枌榆，故乡；松楸，代指亡故的亲人。",{"a":1,"w":[246025,168040]}],["棺中悬镜","guānzhōngxuánjìng","古代礼俗。古人于大殓时用镜悬棺前照尸，取光明破黑暗之义。",{"a":1,"w":[9589,7,4694,7535]}],["椎拍宛转","chuí pāi wǎnzhuǎn","语出《庄子‧天下》：“椎拍輐断，与物宛转。”谓顺随变化。",{"a":1,"w":[8683,1418,35818]}],["椎结左衽","chuí jié zuǒrèn","挽髻如椎，穿前襟向左的衣服。古代边远少数民族的一种服饰。",{"a":1,"w":[8683,2271,60960]}],["渭城三迭","wèichéngsāndié","即《渭城曲》。此曲分三段，将歌词重复三遍，故称“三叠”。",{"a":1,"w":[407225,74,8155]}],["潘陆颜谢","pānlùyánxiè","西晋文学家潘岳、陆机和南朝宋文学家颜延之、谢灵运的并称。",{"a":1,"w":[8658,7605,424624]}],["牛头旃檀","niútóu zhāntán","梵语的音义并译。即旃檀香树。以其产地之山状若牛头，故称。",{"a":1,"w":[14930,150297]}],["画诺坐啸","huànuò zuòxiào","主管者在文书上签签字，坐着打口哨。指为官清闲或不理政事。",{"a":1,"w":[201176,198414]}],["病风丧心","bìng fēng sàngxīn","宋苏洵《谏论》：“人之情非病风丧心，未有避赏而就刑者。”",{"a":1,"w":[67,44,66825]}],["皇帝之宝","huángdì zhībǎo","皇帝印玺之一。用于慰劳王公以下的文书。参见“皇帝行宝”。",{"a":1,"w":[5112,23252]}],["皇帝信宝","huángdì xìn bǎo","皇帝印玺之一。用于征召王公以下的文书。参见“皇帝行宝”。",{"a":1,"w":[5112,529,2313]}],["眼语颐指","yǎnyǔ yízhǐ","用眼色或面部表情示意别人为之奔走。形容有权势者气焰之盛。",{"a":1,"w":[196589,47040]}],["笓篱战格","bì lí zhàngé","古代城墙上的防御设施。由竹或荆柳编织而成，用以遮隔矢石。",{"a":1,"w":[114708,9792,222233]}],["腿曲裢子","tuǐqūliánzi","一种挂在腰带上的褡裢，装钱物用。因其下垂至腿弯处，故称。",{"a":1,"w":[660,7517,35734,1]}],["与时消息","yǔshíxiāoxī","谓事物无常，随时间的推移而兴盛衰亡。消，消亡。息，孳生。",{"a":1,"w":[24105,1646]}],["蜗名蝇利","wōmíngyínglì","蜗牛角样的细名，苍蝇头般的小利。比喻微不足道的虚名小利。",{"a":1,"w":[13793,560,9117,4606]}],["蝉冠豸绣","chánguān zhì xiù","古代御史大夫的冠服。蝉冠，貂蝉冠；豸绣，绣着獬豸的补服。",{"a":1,"w":[97184,13300,4793]}],["覆车继轨","fùchē jìguǐ","前面的车翻倒了，后面的车继续按旧车辙行进。犹言重蹈覆辙。",{"a":1,"w":[38718,190537]}],["见钱关子","jiànqián guānzi","南宋时官府发给商人用来兑换现钱的一种纸币。简称“关子”。",{"a":1,"w":[39554,49427]}],["誓书铁券","shìshū tiěquàn","I\n即誓券。又称丹书铁券。\nII\n即誓券。又称丹书铁券。",{"a":1,"w":[76073,45690]}],["谢郎着帽","xièlángzhemào","谓不拘礼数。典出《晋书‧谢安传》：“温后诣安，值其理发。",{"a":1,"w":[7570,8101,57,8140]}],["郭隗请始","guōkuíqǐngshǐ","《战国策‧燕策一》：燕昭王欲招贤士，以报齐仇。往见郭隗。",{"a":1,"w":[8959,42025,160,7683]}],["铺路石子","pūlùshí zi","片石、碎石等铺路材料。喻放弃自己利益为别人创造条件的人。",{"a":1,"w":[37331,35266]}],["镇殿将军","zhèn diàn jiāngjūn","古时朝廷新年朝会时立于殿角的武装侍卫。选身躯高大者担任。",{"a":1,"w":[4701,8493,4955]}],["陈平宰社","chénpíngzǎishè","指汉陈平微时为乡民祭社时分肉事。见《史记‧陈丞相世家》。",{"a":1,"w":[7893,525,4888,3327]}],["云屯席卷","yúntúnxíjuǎn","如云气骤然聚集，如席子迅速卷起。形容来去迅捷，气势雄伟。",{"a":1,"w":[554,8563,26002]}],["麻姑搔背","mágu sāobèi","典出晋葛洪《神仙传》。谓仙人麻姑手纤长似鸟爪，可搔背痒。",{"a":1,"w":[113760,142706]}],["上党梆子","