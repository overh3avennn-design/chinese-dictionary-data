8]}],["黍离","shǔlí","本为《诗‧王风》中的篇名。",{"a":1,"w":[8827,543]}],["黍雪","shǔxuě","谓用黍子来擦拭桃子上的毛。",{"a":1,"w":[8827,616]}],["黏糕","niángāo","食品名。黍米和糖制成的糕。",{"a":1,"w":[8548,8893]}],["黑分","hēifēn","印度历法称太阴历的下半月。",{"a":1,"w":[549,15]}],["黑档","hēidàng","暗中或秘密保存的缺档空额。",{"a":1,"w":[549,4796]}],["黑绳","hēishéng","佛家所谓八热地狱的第二狱。",{"a":1,"w":[549,7867]}],["点抹","diǎnmǒ","1) 评点。\n2) 搽抹。",{"a":1,"w":[64,8295]}],["点璧","diǎnbì","白璧的斑点。比喻美中不足。",{"a":1,"w":[64,8965]}],["党辈","dǎngbèi","1) 众多。\n2) 党与。",{"a":1,"w":[4685,3502]}],["黩冒","dúmào","1) 渎犯。\n2) 贪婪。",{"a":1,"w":[11772,3400]}],["黼裘","fǔqiú","用羔和狐白杂为黼文的皮衣。",{"a":1,"w":[19936,9755]}],["鼍吟","tuóyín","鼍鸣叫。古人听鼍叫以占雨。",{"a":1,"w":[46381,8955]}],["鼎游","dǐngyóu","谓鱼游于鼎釜。比喻无生路。",{"a":1,"w":[8230,1317]}],["鼎肉","dǐngròu","已经解割的牲肉。亦指熟肉。",{"a":1,"w":[8230,116]}],["鼎跃","dǐngyuè","举鼎跳跃。古代的一种杂技。",{"a":1,"w":[8230,8534]}],["鼓誉","gǔyù","1) 吹嘘。\n2) 称扬。",{"a":1,"w":[3352,8368]}],["鼯鼪","wúshēng","同“鼯鼬”。\n泛指小动物。",{"a":1,"w":[49421,62254]}],["鼻官","bíguān","鼻子。鼻为五官之一，故称。",{"a":1,"w":[7737,2293]}],["齐足","qízú","犹并驾。谓前进的速度相同。",{"a":1,"w":[1347,4625]}],["赍怒","jīnù","疾怒；暴怒。赍，通“齌”。",{"a":1,"w":[12223,8124]}],["龈齴","kěnyǎn","牙龈外露。比喻陡峭的岩壁。",{"a":1,"w":[11826]}],["龙帷","lóngwéi","画有龙的帷幕。王侯的棺饰。",{"a":1,"w":[1308,11988]}],["龙关","lóngguān","指漠北少数民族所设的关隘。",{"a":1,"w":[1308,65]}],["龙骞","lóngqiān","如龙之腾举。言其威势大振。",{"a":1,"w":[1308,13269]}],["庞诞","pángdàn","拉杂荒诞。庞，用同“庬”。",{"a":1,"w":[9333,8377]}],["龚召","gōngzhào","汉循吏龚遂与召信臣的并称。",{"a":1,"w":[32315,8854]}],["龚工","gōnggōng","即共工。古代传说中的人物。",{"a":1,"w":[32315,7411]}],["龚汲","gōngjí","西汉循吏龚遂与汲黯的并称。",{"a":1,"w":[32315,10065]}],["龟精","guījīng","道教指练内丹时产生的真气。",{"a":1,"w":[7684,4629]}],["龟艨","guīméng","古代一种狭长而坚固的战船。",{"a":1,"w":[7684,79194]}],["龟蓍","guīshī","龟甲和蓍草。古代占卜之具。",{"a":1,"w":[7684,21336]}],["龟莲","guīlián","龟和莲。古人以为祥瑞之物。",{"a":1,"w":[7684,7819]}],["妗母","jìnmǔ","（jìnmǔ）＜方＞舅母。",{"a":1,"w":[103946,4637]}],["蕲求","qíqiú","（ｑíｑiú）＜书＞祈求。",{"a":1,"w":[14640,598]}],["叶腑","yèfǔ","叶的基部和茎之间所夹的角。",{"a":1,"w":[7426,14020]}],["野个","yěgè","[p]西安话[/