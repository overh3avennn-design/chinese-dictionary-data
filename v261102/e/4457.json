[["奔蹙","bēncù","1) 犹奔迫。\n2) 奔跑践踏。",{"a":1,"w":[8195,10026]}],["奔霆","bēntíng","1) 暴雷。\n2) 疾驰的闪电。",{"a":1,"w":[8195,13634]}],["奠牧","diànmù","指诸侯蕃国。亦指其所辖治的区域。",{"a":1,"w":[9667,8148]}],["奢阔","shēkuò","1) 犹迂阔。\n2) 奢侈阔绰。",{"a":1,"w":[9225,4766]}],["奥薮","àosǒu","犹渊薮。比喻人或事物聚集的地方。",{"a":1,"w":[7481,10471]}],["夺误","duówù","抄刊古书而形成的文字脱漏或讹误。",{"a":1,"w":[4759,4712]}],["女飐","nǚzhǎn","古代在角觝之前表演花把势的女子。",{"a":1,"w":[98,39263]}],["好妇","hǎofù","1) 美貌的妇女。\n2) 美妻。",{"a":1,"w":[58,7957]}],["如令","rúlìng","1) 从令，遵令。\n2) 假使。",{"a":1,"w":[4614,3329]}],["妖靡","yāomí","1) 艳丽华美。\n2) 指美女。",{"a":1,"w":[8617,8373]}],["妖么","yāome","同“么麽”。\n指微不足道的小人。",{"a":1,"w":[8617,7758]}],["妾势","qièshì","方言。谓妇女在人前表现的卑贱相。",{"a":1,"w":[10041,7642]}],["始立","shǐlì","1) 谓三十岁。\n2) 犹始创。",{"a":1,"w":[7683,3314]}],["奸惰","jiānduò","亦作“奸惰”。\n谓居官奸私怠惰。",{"a":1,"w":[8125,9355]}],["姻私","yīnsī","1) 结成姻亲。\n2) 指姻戚。",{"a":1,"w":[8706,7692]}],["威服","wēifú","1) 以威力慑服。\n2) 畏服。",{"a":1,"w":[7646,4619]}],["威陵","wēilíng","1) 犹侵犯。\n2) 声威超越。",{"a":1,"w":[7646,7966]}],["娄金","lóujīn","马蹄金。相传为汉娄敬所铸，故称。",{"a":1,"w":[9079,1270]}],["婷娉","tíngpīng","1) 体态美好。\n2) 指美女。",{"a":1,"w":[19253,22606]}],["媒证","méizhèng","1) 婚约。\n2) 婚姻介绍人。",{"a":1,"w":[8288,1334]}],["媢忌","màojì","1) 嫉妒。\n2) 指嫉妒的人。",{"a":1,"w":[48728,8540]}],["媺人","měirén","姿容美好的女子。借指有才德的人。",{"a":1,"w":[79999,3]}],["娇妇","jiāofù","骄妇。谓骄横之妻。娇，通“骄”。",{"a":1,"w":[8704,7957]}],["娇爱","jiāo'ài","1) 宠爱。\n2) 谓娇媚可爱。",{"a":1,"w":[8704,131]}],["嬴台","yíngtái","古代传说中萧史、弄玉所居之凤台。",{"a":1,"w":[14547,1306]}],["季叔","jìshū","1) 末世；衰世。\n2) 叔父。",{"a":1,"w":[2321,8654]}],["孤削","gūxuē","1) 独立挺拔。\n2) 犹孤峭。",{"a":1,"w":[7996,4765]}],["孤宦","gūhuàn","地位低微的官吏；未受知遇的远臣。",{"a":1,"w":[7996,10795]}],["孤栋","gūdòng","1) 独梁。\n2) 孤立的房舍。",{"a":1,"w":[7996,5083]}],["孤门","gūmén","犹寒门。指势单力薄的非官宦家族。",{"a":1,"w":[7996,53]}],["孙曹","sūncáo","三国时吴主孙权和魏主曹操的并称。",{"a":1,"w":[7936,8358]}],["安戢","ānjí","1) 安定；平静。\n2) 安抚。",{"a":1,"w":[2261,14235]}],["宏玩","hóngwán","大型的玩赏之物。指园林、建筑等。",{"a":1,"w":[8933,648]}],["宓琴","mìqín","古琴。相传为宓羲氏所创制，故称。",{"a":1,"w":[19656,3367]}],["定执","dìngzhí","1) 一定的主张。\n2) 断定。",{"a":1,"w":[2259,7826]}],["宛驹","wǎnjū","犹言千里驹。比喻英俊有为的少年。",{"a":1,"w":[9130,10684]}],["客戍","kèshù","由外地军队驻守。亦指驻守在外地。",{"a":1,"w":[7618,9666]}],["客枕","kèzhěn","指客中使用之枕。喻指旅途中过夜。",{"a":1,"w":[7618,8523]}],["宣干","xuāngàn","指宣抚使、宣谕使属下的干办官员。",{"a":1,"w":[7827,46]}],["宦族","huànzú","谓官宦之家。常指世代为官入仕者。",{"a":1,"w":[10795,4632]}],["宫样","gōngyàng","皇宫中流行的装束、服具等的式样。",{"a":1,"w":[4679,4669]}],["宫绡","gōngxiāo","皇宫中特制的一种又轻又薄的绸子。",{"a":1,"w":[4679,22878]}],["宫缬","gōngxié","宫中所制丝织品上的对称式的印花。",{"a":1,"w":[4679,10633]}],["宫钿","gōngdiàn","宫中用的花形金质首饰。借指宫女。",{"a":1,"w":[4679,14893]}],["宰路","zǎilù","1) 渊名。\n2) 谓宰辅之位。",{"a":1,"w":[4888,54]}],["害碜","hàichěn","感到牙碜。比喻怕羞、害臊或发怵。",{"a":1,"w":[3353,14144]}],["宵晖","xiāohuī","1) 夜间发光。\n2) 指月亮。",{"a":1,"w":[9364,11534]}],["容礼","rónglǐ","容仪之礼。谓容止进退的礼仪规定。",{"a":1,"w":[7524,3342]}],["寄坐","jìzuò","谓居客位。比喻地位不稳且无实权。",{"a":1,"w":[2358,128]}],["密固","mìgù","1) 细密牢固。\n2) 犹密封。",{"a":1,"w":[2299,7552]}],["密查","mìchá","1) 秘密查访。\n2) 谓密林。",{"a":1,"w":[2299,601]}],["富櫜","fùgāo","丰富的贮藏；丰富的内容。櫜，囊。",{"a":1,"w":[1388,19354]}],["寒厅","hántīng","冷清的厅堂。亦用以谦称自己的家。",{"a":1,"w":[7631,3439]}],["寒焰","hányàn","古人称似火而不能引起燃烧的光焰。",{"a":1,"w":[7631,8874]}],["寓治","yùzhì","谓将官署设在外地，不在原辖地区。",{"a":1,"w":[9167,2283]}],["寓锡","yùxī","取僧侣寄放锡杖之意。谓僧侣寄居。",{"a":1,"w":[9167,8582]}],["寖润","jìnrùn","逐渐渗透。谓谗言渐积而发生作用。",{"a":1,"w":[126023,7847]}],["察览","chálǎn","1) 考察；观察。\n2) 审阅。",{"a":1,"w":[7567,8265]}],["寡俦","guǎchóu","1) 缺少同伴。\n2) 犹无匹。",{"a":1,"w":[8272,14795]}],["寝耒","qǐnlěi","耒耜等农具放着不用。指农事荒废。",{"a":1,"w":[8791,14135]}],["寝饿","qǐn'è","谓越来越饿，饿极。寝，通“寖”。",{"a":1,"w":[8791,229]}],["寥邈","liáomiǎo","1) 高远；遥远。\n2) 稀少。",{"a":1,"w":[11552,15504]}],["审实","shěnshí","1) 真实；详实。\n2) 核实。",{"a":1,"w":[7781,7457]}],["审责","shěnzé","1) 明确责任。\n2) 犹审问。",{"a":1,"w":[7781,7765]}],["宽褐","kuānhè","宽大的粗布衣。泛指贫贱者的衣服。",{"a":1,"w":[2323,8166]}],["宽转","kuānzhuǎn","1) 宽敞有余地。\n2) 拐弯。",{"a":1,"w":[2323,1293]}],["寰域","huányù","1) 范围，区域。\n2) 天下。",{"a":1,"w":[12225,7823]}],["宝柱","bǎozhù","古代筝、琴、瑟等弹拨乐器的弦柱。",{"a":1,"w":[2313,7685]}],["宝焰","bǎoyàn","亦作“宝焰”。\n珍宝射出的光辉。",{"a":1,"w":[2313,8874]}],["寸尺","cùnchǐ","1) 泛指长短。\n2) 喻微小。",{"a":1,"w":[3402,2347]}],["射狼","shèláng","旧传五代晋石敬瑭起兵灭唐的先兆。",{"a":1,"w":[3312,7960]}],["专执","zhuānzhí","1) 擅自捕人。\n2) 犹固执。",{"a":1,"w":[7548,7826]}],["尊候","zūnhòu","书信中问候对方起居等情况的敬词。",{"a":1,"w":[7922,7622]}],["小妆","xiǎozhuāng","稍作妆饰，淡妆。与“盛妆”对言。",{"a":1,"w":[16,8268]}],["小肆","xiǎosì","1) 小店铺。\n2) 谦称己店。",{"a":1,"w":[16,8346]}],["尖俏","jiānqiào","1) 犹刻薄。\n2) 尖细轻佻。",{"a":1,"w":[4691,9770]}],["尖薄","jiānbáo","1) 尖巧轻薄。\n2) 犹刻薄。",{"a":1,"w":[4691,2319]}],["局家","jújiā","某些牌戏或赌博中每一局的主持人。",{"a":1,"w":[2291,28]}],["局蛙","júwā","指井底之蛙。因局促于井底，故名。",{"a":1,"w":[2291,9708]}],["居林","jūlín","谓在家闲居。林，林下，退隐之所。",{"a":1,"w":[7611,7469]}],["屈临","qūlín","犹屈驾。敬辞。用于邀请宾客光临。",{"a":1,"w":[7898,7625]}],["屏伏","píngfú","1) 隐退，避匿。\n2) 伏地。",{"a":1,"w":[7852,7729]}],["展舒","zhǎnshū","1) 舒展。\n2) 施展，发挥。",{"a":1,"w":[7565,7870]}],["屠剔","tútī","1) 杀戮。\n2) 见“屠刎”。",{"a":1,"w":[9023,9422]}],["履狶","lǚxī","谓检验猪的肥瘦。亦比喻审察民情。",{"a":1,"w":[7942]}],["履凫","lǚfú","指王乔化履为凫而乘之往来的传说。",{"a":1,"w":[7942,14408]}],["屯次","túncì","1) 驻扎。\n2) 指驻扎之处。",{"a":1,"w":[8563,102]}],["山例","shānlì","旧时西南山区民间约定的惩处条例。",{"a":1,"w":[45,7927]}],["山岫","shānxiù","1) 山洞。\n2) 山峰；山峦。",{"a":1,"w":[45,21492]}],["山栗","shānlì","栗的一种。子实较板栗稍小，可食。",{"a":1,"w":[45,8177]}],["山烧","shānshāo","犹山火。山中草木焚烧而燃起的火。",{"a":1,"w":[45,2303]}],["山宾","shānbīn","来自山中的宾客。特指汉商山四皓。",{"a":1,"w":[45,7793]}],["岔出","chàchū","1) 离开。\n2) 意外地出现。",{"a":1,"w":[4922,22]}],["岳旦","yuèdàn","亦作“岳旦”。\n对人诞辰的美称。",{"a":1,"w":[8765,8414]}],["岸谷","àngǔ","1) 高深的山谷。\n2) 高傲。",{"a":1,"w":[3418,7701]}],["峭峭","qiàoqiào","1) 高峻，高。\n2) 寒冷貌。",{"a":1,"w":[10907]}],["峻削","jùnxuē","1) 陡峭。\n2) 指药性猛烈。",{"a":1,"w":[9365,4765]}],["崇名","chóngmíng","1) 重视名誉。\n2) 犹尊号。",{"a":1,"w":[8311,560]}],["崇配","chóngpèi","古时帝王于郊祀大典中以祖先配享。",{"a":1,"w":[8311,1351]}],["崖阱","yájǐng","深险的陷阱。多形容心机阴毒奸险。",{"a":1,"w":[8942,9964]}],["崖际","yájì","1) 山崖的边侧。\n2) 边际。",{"a":1,"w":[8942,7589]}],["崛兴","juéxīng","1) 崛起，兴起。\n2) 耸立。",{"a":1,"w":[14221,7545]}],["崧镇","sōngzhèn","嵩山的别称。一方主山曰镇，故称。",{"a":1,"w":[43862,4701]}],["崩弛","bēngchí","1) 塌毁。\n2) 涣散；败坏。",{"a":1,"w":[8619,8456]}],["嵎虎","yúhǔ","负嵎之虎。语出《孟子‧尽心下》。",{"a":1,"w":[18062,3337]}],["嵫景","zījǐng","崦嵫山的落日余光。喻老年，晚年。",{"a":1,"w":[62574,4676]}],["嶚峭","liáoqiào","1) 瘦削貌。\n2) 形容微寒。",{"a":1,"w":[10907]}],["巀嵲","jiéniè","1) 高耸。\n2) 指高峻的山。",{"a":1}],["巡岳","xúnyuè","谓天子巡守邦国至四方之岳而封禅。",{"a":1,"w":[7981,8765]}],["左驺","zuǒzōu","后汉时东园催督三公输礼钱的骑士。",{"a":1,"w":[154,13319]}],["巨器","jùqì","1) 大型器皿。\n2) 喻大才。",{"a":1,"w":[7862,7410]}],["巨踊","jùyǒng","谓离地而起向上跳。巨，通“距”。",{"a":1,"w":[7862,11141]}],["差移","chàyí","I\n犹差错。\nII\n变动，变更。",{"a":1,"w":[121,2306]}],["帖骑","tiēqí","贴身于马上。谓跨骑不施鞍鞯之马。",{"a":1,"w":[8250,674]}],["帝扃","dìjiōng","犹言皇帝宫阙。指朝廷。扃，门户。",{"a":1,"w":[7840,15982]}],["师祭","shījì","古代军队出兵时所行祭祀祈祷之礼。",{"a":1,"w":[7489,8417]}],["席苫","xíshān","谓坐卧于草荐上。古代居丧的礼节。",{"a":1,"w":[7836,15408]}],["带住","dàizhù","1) 拽住，拿住。\n2) 停住。",{"a":1,"w":[542,144]}],["常品","chángpǐn","1) 常格。\n2) 平常的品类。",{"a":1,"w":[99,3321]}],["帽镜","màojìng","置于几案上，可照出人头面的镜子。",{"a":1,"w":[8140,7535]}],["幡虹","fānhóng","指寺中长幡。其形长展如虹，故称。",{"a":1,"w":[10797,9919]}],["干侯","gànhóu","用豻皮装饰的箭靶。干，通“豻”。",{"a":1,"w":[46,8170]}],["干韵","gànyùn","即兼韵。谓兼取通用韵中的一二字。",{"a":1,"w":[46,8313]}],["平估","pínggū","1) 公平的价格。\n2) 抑价。",{"a":1,"w":[525,8403]}],["平粹","píngcuì","平和纯粹。多用以指人的精神品格。",{"a":1,"w":[525,9402]}],["幽事","yōushì","1) 幽景，胜景。\n2) 雅事。",{"a":1,"w":[8098,33]}],["幽岫","yōuxiù","深山中的岩洞。常为隐者所居之处。",{"a":1,"w":[8098,21492]}],["幽悄","yōuqiāo","1) 低微。\n2) 谓幽约微妙。",{"a":1,"w":[8098,11036]}],["幽漠","yōumò","1) 幽静之境。\n2) 指死者。",{"a":1,"w":[8098,8479]}],["幽经","yōujīng","指《相鹤经》。传说为神仙的经书。",{"a":1,"w":[8098,7421]}],["幽越","yōuyuè","1) 幽囚颠越。\n2) 犹悠扬。",{"a":1,"w":[8098,597]}],["幽阳","yōuyáng","指初升的太阳。因阳光微弱，故名。",{"a":1,"w":[8098,7484]}],["庋架","guǐjià","1) 置放架上。\n2) 藏书架。",{"a":1,"w":[25874,1341]}],["序秩","xùzhì","旧指按品级尊卑为序书列官职姓名。",{"a":1,"w":[7598,9216]}],["序衔","xùxián","旧指在公文上依次具列职衔、姓名。",{"a":1,"w":[7598,8703]}],["庖霜","páoshuāng","细切的鱼肉片。因色白如霜，故称。",{"a":1,"w":[11983,8258]}],["庭论","tínglùn","在朝廷上当众评议。庭，通“廷”。",{"a":1,"w":[7760,7480]}],["庭障","tíngzhàng","亭障。边塞的堡垒。庭，通“亭”。",{"a":1,"w":[7760,7656]}],["庶尹","shùyǐn","1) 众官之长。\n2) 指百官。",{"a":1,"w":[8722,10344]}],["厢巡","xiāngxún","宋代京都巡夜的军警，属厢官统辖。",{"a":1,"w":[9106,7981]}],["廉劲","liánjìn","1) 刚直。\n2) 指文笔雄健。",{"a":1,"w":[8138,7891]}],["荫埶","yīnyì","荫势。谓仗他人庇护而获得的权势。",{"a":1,"w":[8853,68901]}],["厂衣","chǎngyī","1) 斗篷；披风。\n2) 官服。",{"a":1,"w":[1401,7536]}],["废亡","fèiwáng","1) 废免，废黜。\n2) 衰亡。",{"a":1,"w":[7711,7763]}],["废替","fèitì","1) 废弃。\n2) 衰落，衰败。",{"a":1,"w":[7711,2368]}],["废顿","fèidùn","1) 废弛。\n2) 谓僵卧不起。",{"a":1,"w":[7711,1370]}],["广席","guǎngxí","1) 众多座席。\n2) 谓满座。",{"a":1,"w":[3324,7836]}],["广陕","guǎngshǎn","同“广狭”。\n陕，“狭”的古字。",{"a":1,"w":[3324,10642]}],["廥廪","kuàilǐn","储存粮草的仓库。亦借指所储粮草。",{"a":1,"w":[54904,9825]}],["庐茔","lúyíng","庐墓。指守丧期间居住的墓旁小屋。",{"a":1,"w":[9988,18391]}],["弄令","nònglìng","指弹奏令曲。令，唐宋杂曲的一种。",{"a":1,"w":[630,3329]}],["弄喧","nòngxuān","亦作“弄諠”。\n弄玄虚，耍花招。",{"a":1,"w":[630,10574]}],["弄怂","nòngsǒng","1) 见“弄耸”。\n2) 怂恿。",{"a":1,"w":[630,12106]}],["式瞻","shìzhān","1) 敬仰，景慕。\n2) 瞻视。",{"a":1,"w":[3311,10022]}],["弓纤","gōngxiān","指旧时妇女裹缠后形似弓状的小脚。",{"a":1,"w":[8097,7725]}],["吊朵","diàoduǒ","亦作“吊朵”。\n妇女的一种头饰。",{"a":1,"w":[4693,3538]}],["引墨","yǐnmò","木工使用绳墨。喻立下规矩、法度。",{"a":1,"w":[2281,7667]}],["引斗","yǐndòu","1) 准备格斗。\n2) 犹引逗。",{"a":1,"w":[2281,7477]}],["弗臣","fúchén","不敢待以臣礼。表示天子对其尊敬。",{"a":1,"w":[7630,8045]}],["弘规","hóngguī","1) 宏谟。\n2) 宏大的规模。",{"a":1,"w":[10400,7549]}],["弘长","hóngzhǎng","I\n弘大长远。\nII\n光大发扬。",{"a":1,"w":[10400,515]}],["张饰","zhāngshì","(张zhāng)夸张，夸大粉饰。",{"a":1,"w":[1333,7951]}],["形兵","xíngbīng","指制造假象来迷惑敌人的一种战术。",{"a":1,"w":[4612,2282]}],["形摹","xíngmó","1) 形状，款式。\n2) 描摹。",{"a":1,"w":[4612,12142]}],["雕弊","diāobì","1) 衰败；困苦。\n2) 损减。",{"a":1,"w":[8192,8552]}],["彭勃","péngbó","1) 迅猛不衰貌。\n2) 草名。",{"a":1,"w":[8776,8180]}],["征旅","zhēnglǚ","1) 出征的军队。\n2) 旅客。",{"a":1,"w":[7581,7730]}],["待东","dàidōng","谓替主人招待客人。待，通“代”。",{"a":1,"w":[3350,87]}],["徇公","xùngōng","为国家利益而献身。徇，通“殉”。",{"a":1,"w":[9647,4610]}],["后梢","hòushāo","1) 树木的末端。\n2) 船尾。",{"a":1,"w":[43,4867]}],["徐刘","xúliú","“建安七子”中徐干和刘桢的并称。",{"a":1,"w":[8626,8276]}],["徙卜","xǐbo","迁居。古人定居须经过占卜，故称。",{"a":1,"w":[10225,8005]}],["复吟","fùyín","旧时术士占卜吉凶时所得卦爻之象。",{"a":1,"w":[7461,8955]}],["复寝","fùqǐn","有两重屋檐的居处。复，通“复”。",{"a":1,"w":[7461,8791]}],["循省","xúnshěng","1) 考察。\n2) 检查；省察。",{"a":1,"w":[7778,607]}],["微劣","wēiliè","1) 暗劣，昏愦。\n2) 衰弱。",{"a":1,"w":[7512,8543]}],["微月","wēiyuè","犹眉月，新月。指农历月初的月亮。",{"a":1,"w":[7512,101]}],["征痛","zhēngtòng","谓受惩罚，遭痛苦。徵，通“惩”。",{"a":1,"w":[7581,1417]}],["徼进","jiǎojìn","犹幸进。非分求进。徼，通“侥”。",{"a":1,"w":[10328,71]}],["心秤","xīnchèng","比喻公正之心。谓其平如秤，故云。",{"a":1,"w":[1279,5052]}],["志趋","zhìqū","1) 小步行走。\n2) 犹志趣。",{"a":1,"w":[7626,8388]}],["忝越","tiǎnyuè","谦词。谓愧对超过自己才德的职位。",{"a":1,"w":[15197,597]}],["忠客","zhōngkè","葵的别称。以葵花常向太阳，故名。",{"a":1,"w":[8280,7618]}],["忠德","zhōngdé","忠正有德行。亦谓忠正有德行的人。",{"a":1,"w":[8280,7416]}],["忱恂","chénxún","1) 诚信。\n2) 指诚信的人。",{"a":1,"w":[13463,24029]}],["思陵","sīlíng","宋高宗赵构死后葬于会稽之永思陵。",{"a":1,"w":[7586,7966]}],["怨酷","yuànkù","1) 犹残暴。\n2) 怨恨惨痛。",{"a":1,"w":[3431,4943]}],["恚忌","huìjì","1) 愤怒嫉忌。\n2) 犹忌恨。",{"a":1,"w":[20052,8540]}],["恩信","ēnxìn","1) 恩德信义。\n2) 犹宠信。",{"a":1,"w":[7704,529]}],["恭德","gōngdé","1) 谦恭的品德。\n2) 大德。",{"a":1,"w":[8502,7416]}],["悻直","xìngzhí","1) 刚直。\n2) 刚愎；固执。",{"a":1,"w":[80344,1294]}],["惠养","huìyǎng","1) 加恩抚养。\n2) 犹豢养。",{"a":1,"w":[7968,582]}],["意好","yìhǎo","1) 感情。\n2) 要好的朋友。",{"a":1,"w":[7482,58]}],["意寄","yìjì","1) 寄以心意。\n2) 犹寄托。",{"a":1,"w":[7482,2358]}],["意计","yìjì","1) 意图，心计。\n2) 意料。",{"a":1,"w":[7482,7428]}],["意趋","yìqū","1) 意图，意向。\n2) 旨趣。",{"a":1,"w":[7482,8388]}],["愚朴","yúpǔ","1) 敦厚质朴。\n2) 犹愚钝。",{"a":1,"w":[8545,9097]}],["愝惼","yǎnbiǎn","1) 心胸狭窄。\n2) 不顺貌。",{"a":1,"w":[106157]}],["愧辱","kuìrǔ","1) 羞辱。\n2) 指遭受羞辱。",{"a":1,"w":[9311,8418]}],["慢怠","màndài","1) 轻忽怠惰。\n2) 犹怠慢。",{"a":1,"w":[182,9710]}],["慧刀","huìdāo","佛教语。谓能斩断一切烦恼的智慧。",{"a":1,"w":[8718,1369]}],["忧毁","yōuhuǐ","谓居父母之丧哀伤过度而损害身体。",{"a":1,"w":[8112,4749]}],["悯嗟","mǐnjiē","1) 忧虑叹息。\n2) 犹哀怜。",{"a":1,"w":[12483,9385]}],["悯忌","mǐnjì","旧指死者的生日。后转为逝世之日。",{"a":1,"w":[12483,8540]}],["憸狡","xiānjiǎo","1) 奸诈。\n2) 指奸诈的人。",{"a":1,"w":[21799,9556]}],["应教","yīngjiào","魏晋以来称应诸王之命而和的诗文。",{"a":1,"w":[2264,77]}],["应王","yīngwáng","汉末建安时文人应玚、王粲的并称。",{"a":1,"w":[2264,2278]}],["应缘","yīngyuán","I\n犹言大概是。\nII\n犹攀附。",{"a":1,"w":[2264,7628]}],["应阮","yīngruǎn","汉末建安时文人应玚、阮瑀的并称。",{"a":1,"w":[2264,11124]}],["应陈","yīngchén","汉末建安时文人应玚、陈琳的并称。",{"a":1,"w":[2264,7893]}],["悬耜","xuánsì","挂起农具。谓停止耕作，荒废农事。",{"a":1,"w":[4694,25320]}],["戆冥","gàngmíng","愚昧，不明事理。亦用为自谦之词。",{"a":1,"w":[17196,8508]}],["戈槛","gēkǎn","兵器排列如槛。形容军营戒备森严。",{"a":1,"w":[7639,10928]}],["戎荒","rónghuāng","古指西方少数民族聚居的边远地区。",{"a":1,"w":[8500,7797]}],["成律","chénglǜ","1) 犹成例。\n2) 符合格律。",{"a":1,"w":[517,7544]}],["戒寒","jièhán","告诫人备寒。亦借指霜降以后天气。",{"a":1,"w":[3377,7631]}],["戕伐","qiāngfá","1) 伤害。\n2) 指纵欲自残。",{"a":1,"w":[20276,8087]}],["戚家","qījiā","1) 贵戚之家。\n2) 亲戚家。",{"a":1,"w":[9077,28]}],["戟幢","jǐchuáng","门戟和饰以毛羽的旗帜。泛指仪仗。",{"a":1,"w":[8766,5413]}],["戟级","jǐjí","犹戟节。本指仪仗，借指显贵气派。",{"a":1,"w":[8766,564]}],["戡复","kānfù","犹言中兴。谓平定叛乱，复兴王业。",{"a":1,"w":[16072,7461]}],["户郎","hùláng","汉代主守卫宫门的官。户将的下属。",{"a":1,"w":[2320,8101]}],["房闼","fángtà","1) 宫闱。\n2) 寝室；闺房。",{"a":1,"w":[7555,12908]}],["房灵","fánglíng","房星之神。房星，古时为君位之象。",{"a":1,"w":[7555,7588]}],["所算","suǒsuàn","1) 算计。\n2) 暗算，谋害。",{"a":1,"w":[1281,573]}],["扃试","jiōngshì","谓科举时代考生各闭一室应答试题。",{"a":1,"w":[15982,105]}],["手挝","shǒuwō","宋时一种可用以击人、防身的手杖。",{"a":1,"w":[34,10945]}],["仂掯","lèkèn","勒掯。要挟，刁难。仂，通“勒”。",{"a":1,"w":[43603,40319]}],["打勘","dǎkān","1) 查问。\n2) 拷问；刑讯。",{"a":1,"w":[66,8682]}],["打撺","dǎcuān","角色在舞台上进进出出，跑来跑去。",{"a":1,"w":[66,14610]}],["扣剑","kòujiàn","抚剑，按剑。常用以表达悲欢情绪。",{"a":1,"w":[4699,4730]}],["扳庄","bānzhuāng","赌牌时用骰子等计数排定头家之称。",{"a":1,"w":[8561,7932]}],["扳高","bāngāo","谓竭力与地位高的人结亲或拉关系。",{"a":1,"w":[8561,35]}],["扶策","fúcè","1) 搀扶；支撑。\n2) 簇拥。",{"a":1,"w":[3458,7673]}],["扶与","fúyǔ","1) 见“扶舆”。\n2) 挟持。",{"a":1,"w":[3458,2270]}],["抃牛","biànniú","两手拉开相斗的牛。喻有超人勇力。",{"a":1,"w":[49028,1346]}],["抄估","chāogū","旧时主人侵吞奴仆财产的一种手段。",{"a":1,"w":[2430,8403]}],["把钓","bǎdiào","1) 垂钓。\n2) 指垂钓的人。",{"a":1,"w":[1321,3503]}],["投名","tóumíng","1) 投递名帖。\n2) 谓入籍。",{"a":1,"w":[2288,560]}],["投款","tóukuǎn","1) 谓以诚相待。\n2) 投诚。",{"a":1,"w":[2288,7573]}],["投义","tóuyì","1) 犹取义。\n2) 投诚起义。",{"a":1,"w":[2288,7437]}],["投躯","tóuqū","1) 舍身；献身。\n2) 置身。",{"a":1,"w":[2288,10987]}],["抖乱","dǒuluàn","1) 搞乱。\n2) 纷乱，混乱。",{"a":1,"w":[8946,1360]}],["抗义","kàngyì","1) 举义。\n2) 见“抗议”。",{"a":1,"w":[7660,7437]}],["折澄","zhéchéng","谓将已澄过的水倒入另一容器再澄。",{"a":1,"w":[2292,9434]}],["披挹","pīyì","1) 犹显现。\n2) 披襟挹取。",{"a":1,"w":[3456,12481]}],["抵对","dǐduì","1) 敌对；对抗。\n2) 答对。",{"a":1,"w":[7874,40]}],["抵搪","dǐtáng","1) 抵当，抵充。\n2) 抵挡。",{"a":1,"w":[7874,10055]}],["抹刷","mǒshuā","I\n犹抹杀。\nII\n用手往下捋。",{"a":1,"w":[8295,2365]}],["拂过","fúguò","辅助君主纠正过失。拂，通“弼”。",{"a":1,"w":[8565,25]}],["拔俊","bájùn","1) 选拔俊才。\n2) 犹拔萃。",{"a":1,"w":[3360,8835]}],["拗戾","ǎolì","1) 见“拗捩”。\n2) 违反。",{"a":1,"w":[9264,9083]}],["拘拳","jūquán","拘挛拳曲。引申为受束缚而不自由。",{"a":1,"w":[8339,8107]}],["拘缀","jūzhuì","1) 痉挛。\n2) 羁绊；牵制。",{"a":1,"w":[8339,9248]}],["招稿","zhāogǎo","记录案件始末与犯人供词等的文稿。",{"a":1,"w":[4704,8822]}],["拽塌","zhuāitā","1) 推倒；倒塌。\n2) 糟蹋。",{"a":1,"w":[5165,4891]}],["拽扎","zhuāizhā","1) 捆扎；结扎。\n2) 绷紧。",{"a":1,"w":[5165,4640]}],["持蠡","chílí","谓拿瓠瓢测量海水。比喻见识浅陋。",{"a":1,"w":[7617,11897]}],["指抉","zhǐjué","1) 犹指摘。\n2) 指名挑选。",{"a":1,"w":[1312,13150]}],["指解","zhǐjiě","1) 犹注解。\n2) 指点解说。",{"a":1,"w":[1312,4620]}],["指适","zhǐshì","1) 合乎主旨。\n2) 犹指归。",{"a":1,"w":[1312,7671]}],["挈令","qièlìng","刻于木板上的法令。挈，通“契”。",{"a":1,"w":[12393,3329]}],["按定","àndìng","1) 按住；握住。\n2) 规定。",{"a":1,"w":[1379,2259]}],["挨查","āichá","I\n逐户盘查。\nII\n等待盘查。",{"a":1,"w":[4772,601]}],["捐廉","juānlián","旧谓官吏捐献除正俸之外的养廉银。",{"a":1,"w":[3490,8138]}],["捐驹","juānjū","遗留小马。谓为官廉洁，不谋私利。",{"a":1,"w":[3490,10684]}],["捧持","pěngchí","恭敬地托着、拿着；环抱形地握持。",{"a":1,"w":[4934,7617]}],["扫括","sǎokuò","1) 扫除，打扫。\n2) 扫荡。",{"a":1,"w":[2335,8668]}],["掌藏","zhǎngcáng"