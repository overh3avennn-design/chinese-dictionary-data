[["出语成章","chūyǔchéngzhāng","说出话来就成文章。形容文思敏捷，口才好。",{"a":1,"w":[22,7447,18253]}],["逞己失众","chěngjǐ shī zhòng","逞放任。指由着性子胡来会失去众人的支持。",{"a":1,"w":[330303,7527,7688]}],["秤锤落井","chèngchuíluòjǐng","像秤锤掉进井水里一样不见踪影，不知消息。",{"a":1,"w":[140502,2275,4671]}],["魑魅罔两","chīmèi wǎngliǎng","传说中山林中的妖怪◇比喻形形色色的坏人。",{"a":1,"w":[79536,117295]}],["持久之计","chíjiǔ zhī jì","持久持之以久，即长久。长久的打算或谋略。",{"a":1,"w":[5368,2254,7428]}],["尺瑜寸瑕","chǐyúcùnxiá","大塳美玉而小有疵病。比喻良才而有小缺点。",{"a":1,"w":[2347,9512,3402,9428]}],["趁风使柁","chènfēngshǐduò","犹看风使舵。比喻随机应变或迎合别人行事。",{"a":1,"w":[66763,1332,24263]}],["乘险抵巇","chéngxiǎndǐxī","冒险钻空子。巇，多指（山岭）险恶、险峻。",{"a":1,"w":[3366,4634,140193]}],["草衣木食","cǎoyīmùshí","编草为衣，以树木果实为食。形容生活清苦。",{"a":1,"w":[180631,7435,7466]}],["财殚力痡","cáidānlìpū","殚竭尽；痡过度疲劳。钱财枯竭，民力疲困。",{"a":1,"w":[7700,278547,78786]}],["采凤随鸦","cǎifèngsuíyā","比喻才貌出众的女子嫁给远不如自己的男人。",{"a":1,"w":[7528,7768,1375,8753]}],["苍蝇见血","cāngyíngjiànxiě","苍蝇一见到血，就拼命吮吸。比喻十分贪婪。",{"a":1,"w":[16700,76,1354]}],["才多识寡","cáiduōshíguǎ","才才识。识见识。寡少。天资高，但见识少。",{"a":1,"w":[603,328286,8272]}],["才广妨身","cáiguǎngfángshēn","妨妨害。自恃才能广博，有时反而害了自己。",{"a":1,"w":[603,3324,10357,7456]}],["才华超众","cáihuáchāozhòng","才华表现于外的才能。才能远远超出一般人。",{"a":1,"w":[40647,4633,7688]}],["材高知深","cáigāozhìshēn","材通才”。知通智”。才能出众，智慧高超。",{"a":1,"w":[7585,66740,1343]}],["不时之须","bùshízhīxū","不时之需。指随时的、不是预定时间的需要。",{"a":1,"w":[4336,2254,7629]}],["不贪为宝","bùtānwéibǎo","表示以不贪为可贵、崇高，也表示廉洁奉公。",{"a":1,"w":[0,8190,550,2313]}],["不绝若线","bùjuéruòxiàn","形容局势危急，象差点儿就要断掉的线一样。",{"a":1,"w":[15353,4652,1282]}],["不挠不折","bùnáobùzhé","不弯曲，不屈服。形容节操刚正，意志坚强。",{"a":1,"w":[55958,0,2292]}],["剥肤之痛","bōfūzhītòng","剥剥去。肤皮肤。指受害极深而引起的痛苦。",{"a":1,"w":[167028,2254,1417]}],["补过饰非","bǔguòshìfēi","补过弥补过失；饰非文饰过错。指掩饰过错。",{"a":1,"w":[61289,36773]}],["哺糟歠醨","bǔzāochuòlí","比喻效法时俗，随波逐流。亦作哺糟啜醨”。",{"a":1,"w":[9935,3475,31414,29928]}],["别具只眼","biéjùzhīyǎn","具有独到的眼光和见解。比喻有独到的见解。",{"a":1,"w":[46725,12755]}],["冰寒于水","bīnghányúshuǐ","冰比水冷。指后来居上。比喻学生胜过老师。",{"a":1,"w":[805415,4621,11]}],["辩口利辞","biànkǒu lìcí","指善辩的口才，犀利的言辞。形容能言善辩。",{"a":1,"w":[242039,251314]}],["比肩接迹","bǐjiān jiē jì","肩膀相靠，足迹相接。形容人多或接连不断。",{"a":1,"w":[65978,548,8080]}],["比类从事","bǐlèicóngshì","比比照。其它类似的情况按照这种精神办理。",{"a":1,"w":[115061,1770]}],["彼众我寡","bǐzhòngwǒguǎ","彼对方。指对方军队势众，而我方力量单薄。",{"a":1,"w":[7812,7688,139,8272]}],["笔扫千军","bǐsǎoqiānjūn","形容笔力雄健，如同有横扫千军万马的气势。",{"a":1,"w":[619,2335,587,7467]}],["笔冢研穿","bǐzhǒngyánchuān","秃笔成坟，砚磨穿孔。指写作著述功力极深。",{"a":1,"w":[116928,7691,153]}],["闭明塞聪","bìmíngsècōng","堵塞视听。指对外界事物不闻不问或不了解。",{"a":1,"w":[4684,7431,4630,9113]}],["筚门圭窬","bì mén guīyú","同筚门闺窦”。柴门小户。喻指穷人的住处。",{"a":1,"w":[19051,53,750600]}],["杯中蛇影","bēizhōngshéyǐng","比喻因疑神疑鬼而引起恐惧。同杯弓蛇影”。",{"a":1,"w":[199,7,3363,7513]}],["背曲腰弯","bèiqǔyāowān","腰背弯曲。常指坐久或年老。同背曲腰躬”。",{"a":1,"w":[99562,2364,2383]}],["被甲枕戈","pījiǎzhěngē","身穿坚甲，头枕兵器。指处于高度戒备状态。",{"a":1,"w":[199596,63964]}],["蚌鹬相持","bàngyùxiāngchí","比喻双方相争，两败俱伤，徒使第三者得利。",{"a":1,"w":[10359,9771,12265]}],["傍观冷眼","bàngguānlěngyǎn","傍通旁”。用冷眼或冷淡的态度在一旁瞧着。",{"a":1,"w":[117888,25650]}],["卑陋龌龊","bēilòu wòchuò","龌龊肮脏。形容品质恶劣。亦作卑鄙龌龊”。",{"a":1,"w":[181734,42308]}],["百万雄兵","bǎiwànxióngbīng","人数众多、威武雄壮的军队。同百万雄师”。",{"a":1,"w":[12181,107029]}],["班师回俯","bānshī huí fǔ","指出征的军队胜利返回朝廷。同班师回朝”。",{"a":1,"w":[66055,79,8380]}],["白首相知","báishǒuxiāngzhī","白首白头发，引申为时间长。意谓老年知己。",{"a":1,"w":[33221,43186]}],["百般折磨","bǎibānzhémó","用各种方式使人在肉体上、精神上遭受痛苦。",{"a":1,"w":[20661,6425]}],["百废具作","bǎifèijùzuò","指一切废置的事都兴办起来。同百废俱兴”。",{"a":1,"w":[133,7711,7505,4608]}],["百废咸举","bǎifèixiánjǔ","指一切废置的事都兴办起来。同百废俱兴”。",{"a":1,"w":[133,7711,2422,606]}],["百口难分","bǎikǒunánfēn","即使有一百张嘴也难分辩清楚。犹百口莫辩。",{"a":1,"w":[58797,20000]}],["八面见光","bāmiànjiànguāng","形容人非常世故，各方面都能应付得很周到。",{"a":1,"w":[19430,16322]}],["拔毛连茹","bámáo lián rú","比喻互相推荐，用一个人就连带引进许多人。",{"a":1,"w":[19761,1288,8598]}],["鳌愤龙愁","áofènlóngchóu","如鼍愤怒，如龙忧愁。比喻乐曲的情调悲愤。",{"a":1,"w":[13761,8587,1308,3481]}],["皱原礁膜","zhòuyuánjiāomó","Monostroma undulatum",{"a":1,"w":[8292,4613,11260,4711]}],["介质厚度","jièzhì hòudù","dielectric thickness",{"a":1,"w":[9565,14575]}],["一透都透","yītòudōutòu","犹言一通百通。谓一理既明，众理皆可贯通。"