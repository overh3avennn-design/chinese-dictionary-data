284]}],["首免","shǒumiǎn","谓揭发他人而免于连坐。",{"a":1,"w":[2310,7679]}],["首戾","shǒulì","犹首罪。指罪行最重者。",{"a":1,"w":[2310,9083]}],["首逆","shǒunì","旧指造反作乱的为首者。",{"a":1,"w":[2310,7762]}],["香尉","xiāngwèi","时人对汉雍仲子的戏称。",{"a":1,"w":[1311,9085]}],["香岑","xiāngcén","对佛寺所在山丘的美称。",{"a":1,"w":[1311,8832]}],["香弓","xiānggōng","弓足的美称。借指女子。",{"a":1,"w":[1311,8097]}],["香署","xiāngshǔ","指京畿省台之类的官署。",{"a":1,"w":[1311,8264]}],["香台","xiāngtái","烧香之台。佛殿的别称。",{"a":1,"w":[1311,1306]}],["香轮","xiānglún","香木作的车；车的美称。",{"a":1,"w":[1311,2280]}],["马嵬","mǎwéi","地名。在陕西省兴平县。",{"a":1,"w":[1273,13978]}],["马排","mǎpái","用马力转动的鼓风器具。",{"a":1,"w":[1273,567]}],["马磨","mǎmó","用马拉磨。谓辛苦劳作。",{"a":1,"w":[1273,4677]}],["马讼","mǎsòng","有关马买卖引起的诉讼。",{"a":1,"w":[1273,8092]}],["冯招","féngzhāo","指汉冯唐白首被招之事。",{"a":1,"w":[8535,4704]}],["驮骡","tuóluó","专门用来驮东西的骡子。",{"a":1,"w":[10335,17089]}],["驯庭","xùntíng","谓驯服地生活于庭院中。",{"a":1,"w":[9709,7760]}],["驳选","bóxuǎn","旧指黜免已入选的官员。",{"a":1,"w":[8526,588]}],["駏驴","jùlǘ","驴和马杂交所生的力畜。",{"a":1,"w":[66009,8826]}],["驽弱","núruò","谓才能低下，力量薄弱。",{"a":1,"w":[14621,2376]}],["驹犊","jūdú","小马与小牛。泛指幼畜。",{"a":1,"w":[10684,10334]}],["驵侠","zǎngxiá","谓做事狡黠，带有侠气。",{"a":1,"w":[16268,9611]}],["驵疾","zǎngjí","骏马疾驶。引申为敏捷。",{"a":1,"w":[16268,7794]}],["驾曹","jiàcáo","驾部中分管厩牧的部门。",{"a":1,"w":[7879,8358]}],["驷骊","sìlí","驾一车的四匹深黑色马。",{"a":1,"w":[10778,10672]}],["骈门","piánmén","一户挨一户。形容人多。",{"a":1,"w":[9675,53]}],["骇奇","hàiqí","亦作“駴奇”。\n惊奇。",{"a":1,"w":[9473,7460]}],["骏壮","jùnzhuàng","犹强壮。骏，通“峻”。",{"a":1,"w":[10268,8135]}],["骏骡","jùnluó","善于奔走、负重的骡子。",{"a":1,"w":[10268,17089]}],["骋迹","chěngjì","往来自如; 纵横驰骋。",{"a":1,"w":[11912,8080]}],["骑曹","qícáo","指骑曹参军一类的小官。",{"a":1,"w":[674,8358]}],["骞荡","qiāndàng","犹飘荡。骞，通“骞”。",{"a":1,"w":[13269,7756]}],["腾谤","téngbàng","谓肆意诽谤；大加指责。",{"a":1,"w":[7985,9810]}],["骚学","sāoxué","指关于《楚辞》的学问。",{"a":1,"w":[8664,13]}],["骚携","sāoxié","谓忧愁愤懑，离心离德。",{"a":1,"w":[8664,8623]}],["骖镳","cānbiāo","骖马的镳辔。泛指马具。",{"a":1,"w":[14958,18613]}],["驱配","qūpèi","指主人给驱口指定配偶。",{"a":1,"w":[7995,1351]}],["骄空","jiāokōng","肆无忌惮