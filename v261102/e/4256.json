[["辣芥菜","là jiècài","leaf mustard preserved with chilli",{"a":1,"w":[2392,14786]}],["集油箱","jíyóu xiāng","oil collecting tank; oil sump tank",{"a":1,"w":[80365,2354]}],["频次图","píncì tú","frequency diagram; frequency graph",{"a":1,"w":[118027,1301]}],["飞越角","fēiyuè jiǎo","transit angle; transit phase angle",{"a":1,"w":[32125,533]}],["驼绒纱","tuóróng shā","camel hair yarn; camel’s wool yarn",{"a":1,"w":[34782,8800]}],["麦芽片","màiyá piàn","malt couch; malt flake; malt piece",{"a":1,"w":[13780,546]}],["胡志强","húzhìqiáng","Jason Hu (Taiwan foreign minister)",{"a":1,"w":[7554,7626,1314]}],["呼鹏马","hūpéngmǎ","呼称呼。称我牛也好，称我马也好。比喻别人骂也好，称赞也好，决不计较。",{"a":1,"w":[7783,10885,1273]}],["黄翅鱼","huángchìyú","sparuslatus，(潮汕俗称)胶辣鱼，又名黄脚立、赤翅、黄立鱼",{"a":1,"w":[530,8002,526]}],["一培土","yī péitǔ","同“一抔土”。\n唐陆龟蒙《筑城词》之二：“城上一培土，手中千万杵。”",{"a":1,"w":[5,71301]}],["一夔足","yīkuízú","《韩非子‧外储说左下》：“夔一而足矣。”谓只要是真人才，一个就足够。",{"a":1,"w":[5,25779,4625]}],["七宝池","qībǎo chí","佛教语。西方净土中由七宝构成的莲花池。往生净土的人在该池莲花中化生。",{"a":1,"w":[27158,7815]}],["三不留","sānbù liú","俗称蚕老结茧、人老去世、女大出嫁为三种不可挽回之事，叫做“三不留”。",{"a":1,"w":[12933,590]}],["三竿日","sāngān rì","犹言日上三竿。谓时间不早。语本《南齐书‧天文志上》：“日出高三竿。”",{"a":1,"w":[34653,50]}],["五虎将","wǔ hǔjiàng","五员猛将。(1)《三国演义》中对关羽、张飞、赵云、马超、黄忠的合称。",{"a":1,"w":[106,176802]}],["五云浆","wǔyún jiāng","语出北周庾信《温汤碑》：“其色变者，流为五云之浆。”后用以代称美酒。",{"a":1,"w":[91387,7883]}],["侍中貂","shìzhōng diāo","唐门下省有侍中二人，正二品，其官帽以貂尾为饰。因借指朝廷珍贵的赏赐。",{"a":1,"w":[50406,9573]}],["八合识","bāhéshí","蒙古语中的突厥语借词，义为师父，源于古汉语“博士”。常见于元代典籍。",{"a":1,"w":[145,1269,4658]}],["再来人","zàilái rén","1) 佛教称再度转世皈依佛门的人。\n2) 犹某某再世。多指后起之秀。",{"a":1,"w":[25310,3]}],["刀子秤","dāozi chèng","秤的一种。灵敏准确，用铁或钢做成，安装在秤杆上的构件呈刀刃状，故名。",{"a":1,"w":[20891,5052]}],["刨花水","bàohuā shuǐ","用桐木刨花浸泡而稍带粘性的水。旧时妇女常用以梳理头发，使之光洁柔润。",{"a":1,"w":[65300,11]}],["十二戟","shí'èr jǐ","古时官府大宅门外例有执戟的卫兵，左右各六名，因以十二戟借指守门卫士。",{"a":1,"w":[8641,8766]}],["十景橱","shíjǐngchú","一种陈设橱，中分几个不同样式的层、格，可摆设各种器皿、古董、盆景等。",{"a":1,"w":[93,4676,13135]}],["咬牙饧","yǎoyá táng","即胶牙饧。一种用麦芽或谷芽熬制而成，黏性很强的糖。古人常于元日食之。",{"a":1,"w":[23181,15398]}],["唱龙眼","chàng lóngyǎn","旧时福建风俗。东家雇人摘龙眼，恐其多吃，令歌唱不止，谓之“唱龙眼”。",{"a":1,"w":[198,13878]}],["喷喷香","pēnpēn xiāng","1) 形容香味浓郁。如：八月的桂花喷喷香。\n2) 形容吃东西有滋味。",{"a":1,"w":[57170,1311]}],["大小虎","dàxiǎo hǔ","指广东南部珠江口的大虎山和小虎山。两山相峙如门，称虎门，为海防要塞。",{"a":1,"w":[813,3337]}],["寄书雁","jìshū yàn","汉武帝天汉元年，苏武奉命出使匈奴被扣。后匈奴与汉和亲，汉使复至匈奴。",{"a":1,"w":[173980,9300]}],["富平车","fù píngchē","指富家贵族的豪华车子。因汉张安世封富平侯，五世袭爵，富贵至极，故称。",{"a":1,"w":[362485,32]}],["小交会","xiǎo jiāohuì","我国出口商品交易会的一种类型。指在各大中城市举办的专业性小型交易会。",{"a":1,"w":[16,12491]}],["山阳会","shānyáng huì","魏晋之际嵇康、向秀、王戎等常聚会山阳。后因以“山阳会”借指故友聚会。",{"a":1,"w":[62221,18]}],["岷下芋","mínxiàyù","语本《史记‧货殖列传》：“吾闻汶山之下，沃野，下有蹲鸱，至死不饥。”",{"a":1,"w":[15066,17,8090]}],["拾菜娘","shícàiniáng","词牌名。即《瑞鹧鸪》。双调五十六字，前段四句三平韵，后段四句两平韵。",{"a":1,"w":[3494,111,8089]}],["攒十字","zǎn shízì","鼓词、弹词及时调中常以“三、三、四”十字句组成唱词，称为“攒十字”。",{"a":1,"w":[5014,8709]}],["支离疏","zhīlí shū","亦省作“支离”。\n《庄子》寓言人物。肢体畸形，于世无补，而坐受赈济。",{"a":1,"w":[47922,7743]}],["方田法","fāngtián fǎ","宋王安石所行新法之一。以东西南北各千步为一方，根据土质肥瘠分等定税。",{"a":1,"w":[52657,2258]}],["星辰剑","xīngchén jiàn","泛指宝剑。典出晋张华望斗牛间紫气掘狱屋基得剑事。见《晋书‧张华传》。",{"a":1,"w":[30355,4730]}],["望夫歌","wàngfū gē","词牌名。又名《罗嗊曲》。皆为五、六、七言绝句，唯起句可用韵可不用韵。",{"a":1,"w":[337346,208]}],["木叶山","mùyè shān","山名。在今辽宁省西北部老哈河与西拉木伦河合流处，为契丹部族的发祥地。",{"a":1,"w":[42652,45]}],["梳妆楼","shūzhuāng lóu","1) 旧指妇女居住的楼房。\n2) 古迹名。即梳妆台。亦省称\"梳妆\"。",{"a":1,"w":[68108,174]}],["弃瓢岩","qìpiáoyán","山崖名。在今河南省登封县东南箕山上，因相传尧时许由曾弃瓢于此而得名。",{"a":1,"w":[7931,9986,7558]}],["棡鼓曲","gānggǔ qū","曲名。相传黄帝出师涿鹿，以棡鼓为警卫，作棡鼓曲。或谓其曲辞本之鲜卑。",{"a":1,"w":[101256,7517]}],["海上方","hǎishàng fāng","指仙方。因秦始皇、汉武帝均曾遣人赴海上求不死仙药，故称仙方为海上方。",{"a":1,"w":[9772,2257]}],["游魂汤","yóuhún tāng","迷魂汤。迷信所说地狱中使灵魂迷失本性的汤药。比喻迷惑人的语言或行为。",{"a":1,"w":[50189,1367]}],["无名钱","wúmíng qián","1) 未标名目的国库款。多指私人官俸归公者。\n2) 指来路不明的钱。",{"a":1,"w":[10034,138]}],["燕歌行","yàn gēxíng","乐府《平调曲》名。现存最早的是三国魏曹丕所作的二首，写的是行役之事。",{"a":1,"w":[7821,28909]}],["烂斧柯","làn fǔkē","同“烂柯”。\n宋陆游《世上》诗：“吾棋一局千年事，从使旁观烂斧柯。”",{"a":1,"w":[3399,99712]}],["甘州破","gānzhōu pò","唐时西凉所进乐曲名。本作《甘州》，因唐宋大曲的第三段称“破”，故名。",{"a":1,"w":[335198,1325]}],["石家园","shí jiāyuán","晋石崇家有金谷园，以富丽着称。后世因以“石家园”指称富贵人家的园林。",{"a":1,"w":[7419,6603]}],["穿针戏","chuānzhēn xì","旧是风俗，农历七月七日夜，妇女竞穿七孔针为戏，谓可从织女星求得智巧。",{"a":1,"w":[38813,3341]}],["竞渡船","jìngdù chuán","1) 竞渡用的彩舟，俗称龙船。\n2) 比喻有权有势而又唯利是争的人。",{"a":1,"w":[112031,621]}],["筒子皮","tǒngzi pí","装订线装书册时，另用双叶有色纸加在书册前后以作保护，称为“筒子皮”。",{"a":1,"w":[14886,1291]}],["管鲍交","guǎnbào jiāo","春秋时管仲、鲍叔牙二人相知最深，后因称朋友间深厚的交谊为“管鲍交”。",{"a":1,"w":[147224,535]}],["缓声歌","huǎnshēnggē","古乐府《杂曲歌辞》之一。缓声，谓歌声柔缓。古辞仅存《前缓声歌》一首。",{"a":1,"w":[7961,3317,208]}],["老复丁","lǎofùdīng","谓年老而复壮盛。犹言返老还童。一说，家有年高者，则免除其子孙的赋役。",{"a":1,"w":[55,7461,4646]}],["老相与","lǎoxiang yǔ","同“老相好”。\n《儒林外史》第五一回：“会着，彼此竟像老相与一般。”",{"a":1,"w":[134110,2270]}],["举谣言","jǔ yáoyán","汉代，朝臣为了解民风民意而搜集民间谣谚等返奏朝廷，谓之：“举谣言”。",{"a":1,"w":[606,5699]}],["莫愁湖","mòchóuhú","在江苏省南京市水西门外。周约三公里。相传六朝时有女子莫愁居此，故名。",{"a":1,"w":[7446,3481,645]}],["薜荔衣","bìlì yī","用薜荔的叶子制成的衣裳。原指神仙鬼怪所披的衣饰，后藉以称隐士的服装。",{"a":1,"w":[47670,7536]}],["质子军","zhìzǐ jūn","元代军队名。为了防止藩属及将领的叛变，而召其子弟组编成军，以便挟制。",{"a":1,"w":[19591,7467]}],["赵太爷","zhào tàiyé","鲁迅在《阿Ｑ正传》中所塑造的一个地主劣绅的典型。后用以比喻封建势力。",{"a":1,"w":[8536,23792]}],["踏百草","tà bǎicǎo","亦作“蹋百草”。\n旧时一种禳灾习俗。传说踩踏百草露水，可以祛毒去热。",{"a":1,"w":[4781,28586]}],["连环扣","liánhuán kòu","1) 几个结组成的扣子。\n2) 比喻连绵交织的情思、错综复杂的矛盾。",{"a":1,"w":[15783,4699]}],["避宫殿","bì gōngdiàn","谓古代国家有灾异急难之事，帝王避离正殿，表示自我贬责，以期消灾弥难。",{"a":1,"w":[2388,6618]}],["郑时门","zhèngshímén","同“郑庄驿”。\n清洪亮吉《早发郑州》诗：“适逢秦岁首，来过郑时门。”",{"a":1,"w":[9014,1280,53]}],["酒嗉子","jiǔ sùzi","方言。细长形酒器，口向外张开，颈细，底大，没有柄，多用锡或陶瓷制成。",{"a":1,"w":[594,121522]}],["醉桃园","zuì táoyuán","词牌名。即《桃源忆故人》。调见宋赵鼎《得全居士词》。参阅《词谱》七。",{"a":1,"w":[3387,21588]}],["醉落拓","zuì luòtuò","词牌名。即《一斛珠》调见宋黄庭坚《山谷琴趣外篇》。参阅《词谱》十二。",{"a":1,"w":[3387,79132]}],["锦帐郎","jǐnzhàngláng","汉制，尚书郎入值台中，官供锦被、锦帐等。后即以“锦帐郎”指朗官之属。",{"a":1,"w":[7982,8011,8101]}],["锦被堆","jǐnbèiduī","1) 蔷薇花的俗名。\n2) 花名。一名粉团儿。\n3) 瑞香花的别名。",{"a":1,"w":[7982,1327,3333]}],["开光明","kāiguāng míng","1) 即开光。\n2) 旧俗在盖棺之前，子女用棉花蘸水揩拭死者的眼睛。",{"a":1,"w":[97681,7431]}],["阴阳书","yīnyáng shū","本指战国时邹衍、邹奭等所作阴阳历律之书。后多指择日、占卜、星相等书。",{"a":1,"w":[9323,81]}],["陵阳山","língyáng shān","1) 相传为陵阳子明得仙之地。在今安徽宣州城内。\n2) 水银的别称。",{"a":1,"w":[122566,45]}],["杂数诗","záshù shī","诗歌的一种体栽。有以数字为题目的，有以数字嵌入诗句的，类似文字游戏。",{"a":1,"w":[306335,2369]}],["青乌子","qīngwū zi","1) 传说中的古代堪舆家。或说黄帝时人，或说秦汉时人。\n2) 乌鸦。",{"a":1,"w":[76107,1]}],["青门饯","qīngménjiàn","古长安城东青门，古来为折柳送别之处。后以“青门饯”为送行饯别的典故。",{"a":1,"w":[3320,53,12085]}],["香炉角","xiānglú jiǎo","指后代。土家族《哭嫁歌》：“我不是祖宗的子孙，我不是祖宗的香炉角！”",{"a":1,"w":[41624,533]}],["冯驩铗","fénghuānjiá","同“冯2驩弹铗”。\n明李梦阳《驰景篇》：“遥忆鹿门驾，缅轸冯驩铗。”",{"a":1,"w":[8535,20929,17245]}],["鲙残鱼","kuàicányú","即银鱼。古代传说吴王阖闾江行，食鱼鲙，弃其残余于水，化为此鱼，故名。",{"a":1,"w":[1704171,526]}],["鸭嘴棍","yāzuǐ gùn","古代武器名。一端是手柄，另一端由两块铁片组成，状如鸭嘴。亦可作刑具。",{"a":1,"w":[50011,8412]}],["鸿隙陂","hóngxìbēi","陂名。故址在今河南淮河北正阳、息县间。跨汝河，受淮北诸水，郡以为饶。",{"a":1,"w":[8788,8385,10251]}],["鹤林寺","hèlín sì","寺名。在今江苏省镇江市南郊。始建于晋代，南朝宋武帝刘裕微时曾游于此。",{"a":1,"w":[113102,4822]}],["黄金镮","huángjīn huán","用黄金制作的刀剑环扣。程善之《拟古》诗：“慷慨一长啸，手抚黄金鐶。”",{"a":1,"w":[2492,30282]}],["鼓吹手","gǔchuī shǒu","旧式婚礼或丧礼中吹奏乐器的人。亦比喻鼓吹某事或吹捧某人的人(贬义)。",{"a":1,"w":[15349,34]}],["大椎穴","dàzhuī xué","针灸穴位名。位于第七颈椎与第一胸椎棘突之间。主治发热、感冒、落枕等。",{"a":1,"w":[69344,8147]}],["复色光","fù sèguāng","由几种颜色的光配合而成的光，如太阳光。复色光通过棱镜时产生色散现象。",{"a":1,"w":[7461,19203]}],["请战书","qǐngzhàn shū","应用文中的一种形式。下级向上级请求交给战斗任务时所写的书信、报告等。",{"a":1,"w":[369911,81]}],["霸王面","bàwáng miàn","霸王面是指没有接到用人单位笔试或面试的通知，而强行去参加笔试和面试。",{"a":1,"w":[11126,523]}],["电熔砖","diànróng zhuān","zirconia-corundum refractory brick",{"a":1,"w":[27775,4857]}],["单班课","dān bānkè","individual lesson\none-on-one class",{"a":1,"w":[911693,187]}],["对称美","duìchèn měi","symmetry (as an aesthetic quality)",{"a":1,"w":[4940,1310]}],["尾羽龙","wěiyǔ lóng","caudipteryx (a feathered dinosaur)",{"a":1,"w":[195249,1308]}],["打边炉","dǎ biānlú","(Cantonese) to eat hot pot\nhot pot",{"a":1,"w":[66,93756]}],["拉匝禄","lāzālù","Lazarus (Catholic transliteration)",{"a":1,"w":[514,10643,8602]}],["暗光鸟","ànguāng niǎo","black-crowned night heron (Taiwan)",{"a":1,"w":[96959,581]}],["暗公鸟","àngōngniǎo","black-crowned night heron (