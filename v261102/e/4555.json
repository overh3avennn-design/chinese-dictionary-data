513]}],["罢瘵","bàzhài","疲困。亦指疲困的人。瘵，肺痨。",{"a":1,"w":[8239,20098]}],["罗千","luóqiān","道教谓面部七神中齿神崿锋之字。",{"a":1,"w":[7420,587]}],["羁孤","jīgū","亦作“羇孤”。\n羁旅孤独的人。",{"a":1,"w":[9726,7996]}],["羁官","jīguān","亦作“羇官”。\n久宦异乡的人。",{"a":1,"w":[9726,2293]}],["羁臣","jīchén","亦作“羇臣”。\n羁旅流窜之臣。",{"a":1,"w":[9726,8045]}],["义丁","yìdīng","旧指抗暴自卫的地方组织的兵丁。",{"a":1,"w":[7437,4646]}],["义荣","yìróng","由于修身立德而自然具有的荣誉。",{"a":1,"w":[7437,7887]}],["义租","yìzū","封建时代向民间征收的额外租粮。",{"a":1,"w":[7437,665]}],["义赋","yìfù","东汉时少数民族所纳的一种贡赋。",{"a":1,"w":[7437,8218]}],["义附","yìfù","两晋南北朝时世族豪门的依附者。",{"a":1,"w":[7437,7718]}],["羲轩","xīxuān","伏羲氏和轩辕氏(黄帝)的并称。",{"a":1,"w":[11033,8869]}],["翁妪","wēngyù","老翁老妇的并称。多指老年夫妇。",{"a":1,"w":[8165,16434]}],["翕侯","xīhóu","汉时乌孙、月氏、康居等部官名。",{"a":1,"w":[11377,8170]}],["翠墨","cuìmò","色泽鲜明的墨；色泽鲜明的字迹。",{"a":1,"w":[7928,7667]}],["翠縠","cuìhú","翠色绉纱。亦以形容绿色的水纹。",{"a":1,"w":[7928,34089]}],["翚矫","huījiǎo","形容亭阁等建筑物状如鸟翼飞举。",{"a":1,"w":[23353,8697]}],["翘肖","qiàoxiào","同“肖翘”。\n细小能飞的生物。",{"a":1,"w":[4880,8910]}],["翻思","fānsī","1) 回想。\n2) 反覆思考。",{"a":1,"w":[2337,7586]}],["翿旌","dàojīng","古代用红白羽毛交杂制成的彩旌。",{"a":1,"w":[85500,9840]}],["老慵","lǎoyōng","年老懒散。常为老年人自谦之辞。",{"a":1,"w":[55,22763]}],["老校","lǎoxiào","旧称年老或任职已久的下级军官。",{"a":1,"w":[55,7600]}],["考卜","kǎobo","古代以龟卜决疑，谓之“考卜”。",{"a":1,"w":[148,8005]}],["考覆","kǎofù","1) 考查审察。\n2) 覆试。",{"a":1,"w":[148,7864]}],["耋嗟","diéjiē","《易‧离》：“大耋之嗟，凶。”",{"a":1,"w":[27975,9385]}],["端函","duānhán","专函。书信常用语。谓特地写信。",{"a":1,"w":[4659,7764]}],["耒庛","lěicì","耒的下端，与耜相接的弯曲部分。",{"a":1,"w":[14135,86523]}],["耕奴","gēngnú","指奴隶制下从事农业生产的奴隶。",{"a":1,"w":[2416,8153]}],["聒扰","guārǎo","犹打扰。多用为表示谢意的谦词。",{"a":1,"w":[16203,7972]}],["圣质","shèngzhì","神圣的秉性。多用于圣人和帝王。",{"a":1,"w":[7587,7436]}],["圣辉","shènghuī","圣德的光辉。多为称颂帝王之词。",{"a":1,"w":[7587,8317]}],["闻慧","wénhuì","佛教语。谓由闻教法而生之慧解。",{"a":1,"w":[629,8718]}],["联字","liánzì","联缀字词。亦指联缀而成的语词。",{"a":1,"w":[7455,84]}],["耸擢","sǒngzhuó","1) 高耸突出。\n2) 跳跃。",{"a":1,"w":[5040,12456]}],["听选","tīngxuǎn","明清对已授职而等候选用者之称。",{"a":1,"w":[146,588]}],["肆断","sìduàn","犹武断。谓以权势任意决断曲直。",{"a":1,"w":[8346,1335]}],["肆踞","sìjù","放肆地伸足而坐。形容态度轻慢。",{"a":1,"w":[8346,12088]}],["肉厘","ròulí","指旧中国政府对肉类征收的厘金。",{"a":1,"w":[116,8618]}],["肚包","dùbāo","系在腹部用以盛钱或什物的布袋。",{"a":1,"w":[8407,88]}],["胎甲","tāijiǎ","犹胎壳。喻事物尚处于初始阶段。",{"a":1,"w":[8017,3330]}],["胙侑","zuòyòu","赐以祭肉，赠以束帛，表示亲近。",{"a":1,"w":[23284,33698]}],["胡伦","húlún","同“囫囵”。\n整个儿的；混沌。",{"a":1,"w":[7554,7676]}],["胡秦","húqín","胡与秦。犹中外。比喻相距很远。",{"a":1,"w":[7554,8261]}],["胡袋","húdài","某些鸟类颔下的皮囊，也称喉囊。",{"a":1,"w":[7554,2395]}],["胡贾","hújiǎ","经商的胡人。后亦泛称外国商人。",{"a":1,"w":[7554,8056]}],["胡鼓","húgǔ","古代北方民族的乐器。用手拍击。",{"a":1,"w":[7554,3352]}],["胥师","xūshī","古官名。掌管市场物价的小官吏。",{"a":1,"w":[9768,7489]}],["胥庭","xūtíng","太古帝王赫胥氏和大庭氏的并称。",{"a":1,"w":[9768,7760]}],["胥胥","xūxū","1) 松散貌。\n2) 喜乐貌。",{"a":1,"w":[9768]}],["脉散","màisàn","水道分流。犹如血脉分散，故名。",{"a":1,"w":[7615,2286]}],["脱羁","tuōjī","原指马脱笼头，后即谓不受羁绊。",{"a":1,"w":[2312,9726]}],["脯掾","púyuàn","精于烹饪，善治干肉的公厨主管。",{"a":1,"w":[9625,27955]}],["腆然","tiǎnrán","1) 羞涩貌。\n2) 犹厚颜。",{"a":1,"w":[11449,7451]}],["脑揪","nǎojiū","揪住后脑勺的头发或头巾的后部。",{"a":1,"w":[7686,10436]}],["腹枵","fùxiāo","同“枵腹”。\n空腹，饿着肚子。",{"a":1,"w":[7842,18794]}],["腿事","tuǐshì","犹鸟事。詈词。多见于戏剧小说。",{"a":1,"w":[660,33]}],["肤末","fūmò","指肤浅的见解或事物的次要部分。",{"a":1,"w":[8232,2329]}],["肤郭","fūguō","犹表皮。生物体的一种保护组织。",{"a":1,"w":[8232,8959]}],["腊糟","làzāo","冬日酿酒的酒糟。用于腌制食物。",{"a":1,"w":[8052,3475]}],["腊赐","làcì","汉制，腊日赐百官钱称“腊赐”。",{"a":1,"w":[8052,8737]}],["卧酪","wòlào","保持恒温、发酵而成的牛、羊乳。",{"a":1,"w":[7997,8938]}],["自呼","zìhū","1) 自呼己名。\n2) 自称。",{"a":1,"w":[2256,7783]}],["自树","zìshù","树立自己的权势；自己有所建树。",{"a":1,"w":[2256,109]}],["致君","zhìjūn","谓辅佐国君，使其成为圣明之主。",{"a":1,"w":[7666,7831]}],["举丝","jǔsī","古代官方对民间的一种信贷形式。",{"a":1,"w":[606,7515]}],["艮岳","gěnyuè","山名。在今河南开封城内东北隅。",{"a":1,"w":[11583,8765]}],["艰急","jiānjí","1) 艰难危急。\n2) 困难。",{"a":1,"w":[8923,569]}],["艰梗","jiāngěng","1) 阻难。\n2) 艰难险阻。",{"a":1,"w":[8923,8222]}],["艰酷","jiānkù","谓亲丧。亲亡为惨痛之事，故称。",{"a":1,"w":[8923,4943]}],["芝盖","zhīgài","指车盖或伞盖。芝形如盖，故名。",{"a":1,"w":[8348,2289]}],["花宫","huāgōng","1) 指佛寺。\n2) 犹仙界。",{"a":1,"w":[20,4679]}],["芳润","fāngrùn","芳香润泽。亦用以喻文辞之精华。",{"a":1,"w":[8273,7847]}],["苦觅","kǔmì","苦心寻觅、搜索。特指诗人苦吟。",{"a":1,"w":[2322,10275]}],["英侠","yīngxiá","1) 英勇仗义。\n2) 豪侠。",{"a":1,"w":[7637,9611]}],["荆凡","jīngfán","西周时代的荆国(楚国)和凡国。",{"a":1,"w":[8436,8150]}],["荷盘","hépán","指荷叶。荷叶形圆，似盘，故名。",{"a":1,"w":[7677,2285]}],["莫然","mòrán","1) 静寂貌。\n2) 茫茫然。",{"a":1,"w":[7446,7451]}],["莫难","mònán","I\n宝珠名。\nII\n即莫难扇。",{"a":1,"w":[7446,117]}],["菁羹","jīnggēng","菁菜羹。亦泛指穷人所食的粗菜。",{"a":1,"w":[12565,9089]}],["华篇","huápiān","美好的篇章。对他人诗文的敬称。",{"a":1,"w":[7503,703]}],["华缨","huáyīng","彩色的冠缨。古代仕宦者的冠带。",{"a":1,"w":[7503,9033]}],["万官","wànguān","数以万计的官吏。极言官吏之多。",{"a":1,"w":[568,2293]}],["着帐","zhezhàng","辽时因犯罪而被没收家产的户口。",{"a":1,"w":[57,8011]}],["董董","dǒngdǒng","1) 丰盛貌。\n2) 象声词。",{"a":1,"w":[8797]}],["苇輤","wěiqiàn","古代载柩车上用苇席作的覆盖物。",{"a":1,"w":[9735,254520]}],["蒙泽","méngzé","1) 蒙受恩泽。\n2) 地名。",{"a":1,"w":[4647,7607]}],["蒲且","púqiě","人名。相传是古代善于射鸟的人。",{"a":1,"w":[8305,8093]}],["蒲褐","púhè","蒲团褐衣。亦借指佛学或佛教徒。",{"a":1,"w":[8305,8166]}],["蒸烛","zhēngzhú","古指以麻苎、竹木等制成的火炬。",{"a":1,"w":[7703,8450]}],["盖泉","gàiquán","指舒姑泉。因在盖山之麓，故称。",{"a":1,"w":[2289,3461]}],["蓐中","rùzhōng","谓妇女产后休息复原的一段时间。",{"a":1,"w":[13331,7]}],["莲锷","lián'è","莲花形的凸纹。亦指锋利的宝剑。",{"a":1,"w":[7819,33803]}],["蔽壅","bìyōng","1) 蒙蔽。\n2) 阻塞障隔。",{"a":1,"w":[8083,9728]}],["蕃臣","fānchén","藩屏之臣；大臣。蕃，通“藩”。",{"a":1,"w":[9068,8045]}],["蕙肴","huìyáo","以蕙草熏肉。亦泛指香洁的菜肴。",{"a":1,"w":[11229,12919]}],["蕨拳","juéquán","指蕨芽。因其端卷曲如拳，故名。",{"a":1,"w":[8229,8107]}],["荡思","dàngsī","1) 涤除愁思。\n2) 邪念。",{"a":1,"w":[7756,7586]}],["薄濇","báosè","味道淡薄而涩口。濇，同“涩”。",{"a":1,"w":[2319,257442]}],["荐度","jiàndù","念经或做佛事，使亡灵脱难超升。",{"a":1,"w":[8795,513]}],["荐进","jiànjìn","1) 推荐引进。\n2) 进献。",{"a":1,"w":[8795,71]}],["藂藂","cóngcóng","1) 聚集貌。\n2) 众多貌。",{"a":1,"w":[298130]}],["兰阇","lándū","梵语或伊朗语译音。为褒赞之辞。",{"a":1,"w":[7450,12318]}],["蘸甲","zhànjiǎ","酒斟满，捧觞蘸指甲。表示畅饮。",{"a":1,"w":[20324,3330]}],["虐戏","nüèxì","使人难堪的调笑和嘲弄；恶作剧。",{"a":1,"w":[8532,3341]}],["虚封","xūfēng","空授爵位或封邑。相对实封而言。",{"a":1,"w":[7779,600]}],["虚籁","xūlài","1) 空寂无声。\n2) 指风。",{"a":1,"w":[7779,19549]}],["虞侍","yúshì","谓伴侍而使愉悦。虞，通“娱”。",{"a":1,"w":[8652,8870]}],["虞旗","yúqí","虞人在汇集所获猎物时用的旗帜。",{"a":1,"w":[8652,7796]}],["虬甲","qiújiǎ","虬龙的鳞甲。亦用以形容鳞状物。",{"a":1,"w":[12801,3330]}],["虬立","qiúlì","如虬龙般地耸立。形容姿态矫健。",{"a":1,"w":[12801,3314]}],["虬辇","qiúniǎn","古代帝皇乘坐的饰有龙形的车子。",{"a":1,"w":[12801,10459]}],["蚊聚","wénjù","蚊群聚集。比喻人众群聚而喧杂。",{"a":1,"w":[9095,2309]}],["蚤已","zǎoyǐ","早就；很早已经。蚤，通“早”。",{"a":1,"w":[9661,1374]}],["蜀盐","shǔyán","四川所产的食盐。打井汲水制成。",{"a":1,"w":[8443,2404]}],["蜃窗","shènchuāng","大蛤壳磨薄后镶嵌以透明的窗子。",{"a":1,"w":[11987,8301]}],["蜎动","yuāndòng","“蜎飞蠕动”的略语。泛指虫类。",{"a":1,"w":[22253,6]}],["蝗雨","huángyǔ","谓蝗群如雨骤至。极言蝗灾之剧。",{"a":1,"w":[12775,159]}],["蝘鼠","yǎnshǔ","1) 鼹鼠。\n2) 牛的别名。",{"a":1,"w":[102336,3351]}],["蝝息","yuánxī","谓有口能呼吸。蝝，用同“喙”。",{"a":1,"w":[82860,7510]}],["虾鬣","xiāliè","虾的触须。或谓巨大者可作柱杖。",{"a":1,"w":[8057,10816]}],["蝮虫","fùchóng","传说中的毒蛇名。虫，虺的本字。",{"a":1,"w":[10756,7601]}],["蜗斗","wōdòu","传说中的兽名。能食火、排泄火。",{"a":1,"w":[13793,7477]}],["螺亭","luótíng","古亭名。故址在今江西省赣州市。",{"a":1,"w":[7596,8241]}],["蛰萤","zhéyíng","谓因遇冷而光不甚明亮的萤火虫。",{"a":1,"w":[12784,12343]}],["蝉翅","chánchì","1) 即蝉翼。\n2) 指蝉鬓。",{"a":1,"w":[8931,8002]}],["蟹浪","xièlàng","谓捕蟹者纷集似浪潮。极言其多。",{"a":1,"w":[8486,7832]}],["蟾壶","chánhú","古代计时器。一种蟾蜍形的漏壶。",{"a":1,"w":[8862,3500]}],["蝇声","yíngshēng","苍蝇营营之声。喻指低劣的诗文。",{"a":1,"w":[9117,3317]}],["蠡谷","lígǔ","匈奴藩王封号。亦泛指王公贵族。",{"a":1,"w":[11897,7701]}],["蛊祝","gǔzhù","用邪术咒诅害人。祝，通“咒”。",{"a":1,"w":[10485,1473]}],["蛮估","mángū","古代指南方从事海上贸易的商贾。",{"a":1,"w":[8711,8403]}],["蛮利","mánlì","唐时南诏国对唐人任师保的尊称。",{"a":1,"w":[8711,4606]}],["行言","xíngyán","1) 犹流言。\n2) 犹言行。",{"a":1,"w":[8,7440]}],["衡轸","héngzhěn","辕前横木与车后横木。亦借指车。",{"a":1,"w":[7728,11130]}],["衣靠","yīkào","指武侠所穿的密扣紧袖束腰衣装。",{"a":1,"w":[7536,656]}],["衯衯","fēnfēn","1) 衣长貌。\n2) 杂乱貌。",{"a":1}],["衲锦","nàjǐn","古代的一种锦。常用以装裱书面。",{"a":1,"w":[13498,7982]}],["裁剖","cáipōu","1) 裁断剖析。\n2) 切开。",{"a":1,"w":[7851,8592]}],["裁缺","cáiquē","谓官吏免去原任官职，等候补缺。",{"a":1,"w":[7851,1412]}],["裘带","qiúdài","轻裘博带。古代达官贵人的服饰。",{"a":1,"w":[9755,542]}],["补刺","bǔcì","1) 缝补。\n2) 重施墨刑。",{"a":1,"w":[1363,2300]}],["补荫","bǔyīn","对因故而被取消的荫封予以补封。",{"a":1,"w":[1363,8853]}],["裹束","guǒshù","1) 裹头束发。\n2) 包扎。",{"a":1,"w":[8738,1407]}],["褚薛","chǔxuē","初唐书法家褚遂良、薛稷的并称。",{"a":1,"w":[15557,11105]}],["褰举","qiānjǔ","1) 高举貌。\n2) 高飞貌。",{"a":1,"w":[17511,606]}],["襐服","xiàngfú","象服。指绣绘着彩色花纹的衣服。",{"a":1,"w":[102187,4619]}],["袭位","xíwèi","封建时代，子孙承袭先代的尊位。",{"a":1,"w":[7990,545]}],["襕幞","lánfú","穿襴袍，戴襆头。古代宦者常服。",{"a":1,"w":[38373,49638]}],["西岐","xīqí","古邑名。在今陕西省岐山县东北。",{"a":1,"w":[51,11416]}],["西汜","xīsì","1) 日入处。\n2) 喻暮年。",{"a":1,"w":[51,27935]}],["西虞","xīyú","古国名。在今山西省平陆县东北。",{"a":1,"w":[51,8652]}],["覆帖","fùtiē","文书信函后所附告知机密的单帖。",{"a":1,"w":[7864,8250]}],["覆爱","fù'ài","遮盖隐蔽。爱，通“薆”，隐蔽。",{"a":1,"w":[7864,131]}]]