[["皮屦","píjù","古代以皮制作的鞋。供冬天穿用。",{"a":1,"w":[1291,10982]}],["盛章","shèngzhāng","谓穿上端庄的礼服。章，即章服。",{"a":1,"w":[4746,4661]}],["盗截","dàojié","非法截留。亦指非法截留的财物。",{"a":1,"w":[8038,7863]}],["盘擗","pánpǐ","1) 盘屈。\n2) 气充沛貌。",{"a":1,"w":[2285,17338]}],["盥溉","guàngài","洗涤。指除去(罪过、积习等)。",{"a":1,"w":[14244,15522]}],["卢儿","lú'ér","犹狗儿。古代对年轻僮仆的贱称。",{"a":1,"w":[7791,7408]}],["卢王","lúwáng","初唐文学家卢照邻与王勃的并称。",{"a":1,"w":[7791,2278]}],["盲女","mángnǚ","旧时多指以卖唱为生的失明女子。",{"a":1,"w":[8164,98]}],["盲洋","mángyáng","亦作“盳洋”。\n仰视或远视貌。",{"a":1,"w":[8164,4650]}],["盲圣","mángshèng","指双目失明的唐代圣僧鉴真和尚。",{"a":1,"w":[8164,7587]}],["直日","zhírì","值日，当班。亦指值日当班的人。",{"a":1,"w":[1294,50]}],["相乱","xiāngluàn","1) 作乱。\n2) 互相混杂。",{"a":1,"w":[7427,1360]}],["相存","xiāngcún","1) 互相问候。\n2) 共活。",{"a":1,"w":[7427,1349]}],["相彷","xiāngpáng","亦作“相仿”。\n相当；差不多。",{"a":1,"w":[7427,24699]}],["相船","xiāngchuán","旧时迷信，谓观察船体可断吉凶。",{"a":1,"w":[7427,621]}],["相趋","xiāngqū","谓因与丧家互闻姓名而前往吊问。",{"a":1,"w":[7427,8388]}],["省家","shěngjiā","I\n返家省视。\nII\n指官府。",{"a":1,"w":[607,28]}],["省禁","shěngjìn","1) 省减禁令。\n2) 宫中。",{"a":1,"w":[607,7708]}],["省訾","shěngzī","检查并纠正谬误。訾，通“疵”。",{"a":1,"w":[607,9517]}],["省钞","shěngchāo","指清代各省的类似报纸的出版物。",{"a":1,"w":[607,8820]}],["眇薄","miǎobáo","谓姿质菲薄。古代帝王自谦之词。",{"a":1,"w":[10317,2319]}],["眇质","miǎozhì","菲薄的姿质。古代帝王自谦之词。",{"a":1,"w":[10317,7436]}],["看伺","kàncì","1) 窥伺。\n2) 伺候使唤。",{"a":1,"w":[122,8912]}],["眕盱","zhěnxū","张目直视。形容死不瞑目的样子。",{"a":1,"w":[100255,18593]}],["真素","zhēnsù","真率自然，也指真率自然的境界。",{"a":1,"w":[85,7468]}],["眴视","xuànshì","1) 惊视。\n2) 凝神注视。",{"a":1,"w":[20873,7494]}],["众治","zhòngzhì","群治；不是一人专制的治国方式。",{"a":1,"w":[7688,2283]}],["瞀闷","màomèn","1) 目眩晕厥。\n2) 混乱。",{"a":1,"w":[18218,8255]}],["瞿地","qúdì","四通八达的地方。瞿，通“衢”。",{"a":1,"w":[12340,10]}],["矜嗟","jīnjiē","1) 怜悯叹息。\n2) 赞叹。",{"a":1,"w":[8903,9385]}],["知启","zhīqǐ","一种陈述事由、传递通知的帖子。",{"a":1,"w":[7492,7875]}],["矰碆","zēngbō","用丝绳系住石制箭头的射鸟工具。",{"a":1,"w":[28859]}],["石匣","shíxiá","石制藏物用具。亦指匣状的山石。",{"a":1,"w":[7419,10001]}],["石架","shíjià","1) 石头书架。\n2) 石梁。",{"a":1,"w":[7419,1341]}],["石筏","shífá","大竹筏或大木筏。石，通“硕”。",{"a":1,"w":[7419,12143]}],["砑虫","yàchóng","昆虫名。即蚜虫。农业害虫之一。",{"a":1,"w":[21091,7601]}],["研滴","yándī","滴水入砚的文具。也称“水注”。",{"a":1,"w":[7691,3434]}],["砦栅","zhàizhà","为防御而设的竹木栅栏等障碍物。",{"a":1,"w":[20835,8487]}],["破结","pòjié","1) 破除结念。\n2) 解结。",{"a":1,"w":[1325,2271]}],["硠磕","lángkē","1) 雷声。\n2) 物相击声。",{"a":1,"w":[66529,4991]}],["硬浪","yìnglàng","同“硬朗”。\n硬气；敢于担当。",{"a":1,"w":[3339,7832]}],["砚草","yàncǎo","撰拟草稿。作文需用笔砚，故云。",{"a":1,"w":[10108,521]}],["棋画","qíhuà","如棋盘一样横竖成行，界画分明。",{"a":1,"w":[8184,625]}],["碗脱","wǎntuō","方言。即窝头。以形似碗，故称。",{"a":1,"w":[744,2312]}],["碧楼","bìlóu","犹玉楼，翠楼。亦为楼阁的美称。",{"a":1,"w":[8659,174]}],["碧窗","bìchuāng","绿色的纱窗。“碧纱窗”的省称。",{"a":1,"w":[8659,8301]}],["碧蛆","bìqū","即玉蛆。酒面浮沫。色绿，故称。",{"a":1,"w":[8659,15470]}],["碧铜","bìtóng","1) 青铜。\n2) 指青铜镜。",{"a":1,"w":[8659,4724]}],["码口","mǎkǒu","方言。犹口径。比喻要求的规格。",{"a":1,"w":[7790,47]}],["硙轮","wéilún","利用水的冲力以启动水磨的轮盘。",{"a":1,"w":[38989,2280]}],["示灭","shìmiè","佛教语。佛菩萨及高僧坐化身死。",{"a":1,"w":[593,4709]}],["社祀","shèsì","同“社祭”。\n古谓祭祀土地神。",{"a":1,"w":[3327,9915]}],["祆贼","xiānzéi","詈词。旧指以妖言惑众倡乱的人。",{"a":1,"w":[21393,4718]}],["祆逆","xiānnì","旧时对不顺从者、敌对者的贬称。",{"a":1,"w":[21393,7762]}],["祈羊","qíyáng","烹羊以祭。古代祭山的一种祭仪。",{"a":1,"w":[9277,1387]}],["秘机","mìjī","隐藏内部机关，不使外见的机械。",{"a":1,"w":[7938,7405]}],["祖寺","zǔsì","佛教语。指曾为祖师所居的佛寺。",{"a":1,"w":[7723,4822]}],["祖帖","zǔtiē","最早的法帖。多指《淳化阁帖》。",{"a":1,"w":[7723,8250]}],["神脚","shénjiǎo","1) 犹言傻角。\n2) 巫师。",{"a":1,"w":[3316,602]}],["祥序","xiángxù","同“庠序”。\n谓举动安详肃穆。",{"a":1,"w":[8467,7598]}],["祭厉","jìlì","古时向恶鬼祭祀，以求免于作祟。",{"a":1,"w":[8417,8111]}],["祭豆","jìdòu","古代祭祀时用以盛放祭品的器具。",{"a":1,"w":[8417,7557]}],["禁圃","jìnpǔ","禁苑中种植御用花果蔬菜的园地。",{"a":1,"w":[7708,13245]}],["禁山","jìnshān","犹封山。禁止进山砍伐、放牧等。",{"a":1,"w":[7708,45]}],["禁沟","jìngōu","犹御沟。宫中或流经宫中的沟渠。",{"a":1,"w":[7708,3383]}],["禁牒","jìndié","以君主名义给予的身分证明文件。",{"a":1,"w":[7708,10089]}],["禁路","jìnlù","犹御道。供帝王车驾行走的道路。",{"a":1,"w":[7708,54]}],["禁阙","jìnquē","宫城前的楼观。借指宫城或宫门。",{"a":1,"w":[7708,8773]}],["祸魁","huòkuí","犹罪魁。指酿成祸患的主要人物。",{"a":1,"w":[8225,8560]}],["福庭","fútíng","幸福的地方。常指神佛所居之处。",{"a":1,"w":[1365,7760]}],["禅衲","chánnà","1) 僧衣。\n2) 以指僧人。",{"a":1,"w":[8805,13498]}],["禅规","chánguī","佛教的清规戒律。亦指寺院法规。",{"a":1,"w":[8805,7549]}],["禅道","chándào","僧侣所修之道。亦特指禅定之道。",{"a":1,"w":[8805,511]}],["禅铠","chánkǎi","谓修持禅定犹如铠甲之坚不可摧。",{"a":1,"w":[8805,11341]}],["礼食","lǐshí","古代国君赐臣下进食的一种礼遇。",{"a":1,"w":[3342,7466]}],["禾更","hégèng","旧时以稻谷代替差役的一种赋税。",{"a":1,"w":[8684,611]}],["私援","sīyuán","因私人情谊好而加以褒扬或援助。",{"a":1,"w":[7692,7930]}],["私箧","sīqiè","私人的书箱。引申为私人的藏书。",{"a":1,"w":[7692,15648]}],["私胎","sītāi","指非夫妻关系的男女所孕的胎儿。",{"a":1,"w":[7692,8017]}],["私视","sīshì","谓单凭主观和一己之见看待事物。",{"a":1,"w":[7692,7494]}],["私养","sīyǎng","私下供给其生活资料或生活费用。",{"a":1,"w":[7692,582]}],["秉穗","bǐngsuì","收稻时遗留在田中的禾把与禾实。",{"a":1,"w":[9534,8108]}],["秋省","qiūshěng","即秋猕。天子于秋季田猎而祭神。",{"a":1,"w":[1391,607]}],["秋箨","qiūtuò","秋日的竹壳。喻脆弱易掉落之物。",{"a":1,"w":[1391,32164]}],["秕稂","bǐláng","稗草。一种形状似禾的稻田杂草。",{"a":1,"w":[12726,35016]}],["秦龟","qínguī","龟的一种。产于秦地山中，故名。",{"a":1,"w":[8261,7684]}],["税屦","shuìjù","犹息足。税，通“挩”、“脱”。",{"a":1,"w":[3343,10982]}],["税帖","shuìtiē","旧时官府给予纳税人的纳税凭证。",{"a":1,"w":[3343,8250]}],["程篇","chéngpiān","犹篇章。指奏议策论之类的文章。",{"a":1,"w":[7453,703]}],["程罗","chéngluó","汉代着名富翁程郑和罗褒的并称。",{"a":1,"w":[7453,7420]}],["程老","chénglǎo","谓在路途中死亡。老，死的婉辞。",{"a":1,"w":[7453,55]}],["程酒","chéngjiǔ","古代桂阳郡郴县程乡溪出产的酒。",{"a":1,"w":[7453,594]}],["稍属","shāoshǔ","形容箭一支接着一支。稍，箭稍。",{"a":1,"w":[3565,1268]}],["稗饭","bàifàn","用稗实做的饭。一种粗劣的饭食。",{"a":1,"w":[10625,169]}],["称情","chēngqíng","I\n衡量人情。\nII\n犹称心。",{"a":1,"w":[613,7490]}],["称早","chēngzǎo","趁早。抓紧时机或在时间上提前。",{"a":1,"w":[613,164]}],["穆哀","mù'āi","指东晋穆帝司马聃、哀帝司马丕。",{"a":1,"w":[7865,8386]}],["积休","jīxiū","指因加班工作而累积的未休假日。",{"a":1,"w":[7496,7670]}],["积波","jībō","聚在一起迅速向四面分散的波纹。",{"a":1,"w":[7496,7433]}],["稳称","wěnchēng","1) 匀称。\n2) 妥帖工稳。",{"a":1,"w":[2346,613]}],["空闺","kōngguī","谓丈夫外出，妻子寂寞独居之处。",{"a":1,"w":[1274,9497]}],["穿屋","chuānwū","1) 穿过房屋。\n2) 破屋。",{"a":1,"w":[153,3389]}],["窆封","biǎnfēng","泛指埋葬。下棺入圹，用土掩埋。",{"a":1,"w":[32918,600]}],["窈九","yǎojiǔ","闽中以正月二十九日为“窈九”。",{"a":1,"w":[14217,143]}],["窘暴","jiǒngbào","1) 胁迫暴戾。\n2) 穷困。",{"a":1,"w":[10071,7675]}],["穷乌","qióngwū","窘困的乌鸦。比喻穷困窘迫的人。",{"a":1,"w":[2372,7520]}],["穷高","qiónggāo","1) 到达高处。\n2) 极高。",{"a":1,"w":[2372,35]}],["窑烟","yáoyān","烧制砖瓦陶瓷等的灶里冒出的烟。",{"a":1,"w":[8374,1376]}],["窃统","qiètǒng","不正规的皇统。与“正统”相对。",{"a":1,"w":[8296,7442]}],["章疏","zhāngshū","旧时臣下向君上进呈的言事文书。",{"a":1,"w":[4661,7743]}],["章醮","zhāngjiào","拜表设祭。道教的一种祈祷形式。",{"a":1,"w":[4661,12871]}],["竦肩","sǒngjiān","耸肩。表示震惊。竦，通“耸”。",{"a":1,"w":[10593,3459]}],["端实","duānshí","1) 正直诚实。\n2) 确实。",{"a":1,"w":[4659,7457]}],["端确","duānquè","1) 正确。\n2) 端正刚强。",{"a":1,"w":[4659,8047]}],["端箭","duānjiàn","谓发箭瞄准时，以一目凝视目标。",{"a":1,"w":[4659,4666]}],["端饬","duānchì","1) 庄重谨慎。\n2) 整顿。",{"a":1,"w":[4659,9634]}],["竞津","jìngjīn","竞争的要道。指追逐名利的途径。",{"a":1,"w":[8144,7884]}],["竹楗","zhújiàn","堵塞河堤决口所用的竹木等器材。",{"a":1,"w":[7655,23685]}],["竹笏","zhúhù","古代大臣入朝时所执的竹制手板。",{"a":1,"w":[7655,11446]}],["竹缆","zhúlǎn","用竹篾绞成的粗索。常用以拴船。",{"a":1,"w":[7655,8447]}],["竹义","zhúyì","谓竹丛生不相离异。比喻有情义。",{"a":1,"w":[7655,7437]}],["竿城","gānchéng","古地名。在今河南省濮阳县东北。",{"a":1,"w":[9280,1353]}],["符袋","fúdài","挂在小孩颈上的布制袋形护身符。",{"a":1,"w":[7841,2395]}],["符赏","fúshǎng","指军令文书中所规定的奖赏数目。",{"a":1,"w":[7841,2415]}],["笳声","jiāshēng","胡笳吹奏的曲调。亦指边地之声。",{"a":1,"w":[23726,3317]}],["笔谏","bǐjiàn","谓借用书法运笔的道理讽喻劝谏。",{"a":1,"w":[619,9148]}],["等阵","děngzhèn","犹言等一会。指此后不久的时间。",{"a":1,"w":[100,2333]}],["筋角","jīnjiǎo","动物的筋与角。古时多用于制弓。",{"a":1,"w":[8060,533]}],["笋脯","sǔnpú","把笋煮熟晾晒、加以调料的食物。",{"a":1,"w":[8811,9625]}],["答效","dáxiào","报效；为报答恩德而为对方尽力。",{"a":1,"w":[3407,7590]}],["策子","cèzi","连数页而成的书册。与卷轴有别。",{"a":1,"w":[7673,1]}],["筝雁","zhēngyàn","筝柱。因筝柱斜列如雁行，故称。",{"a":1,"w":[10331,9300]}],["算馆","suànguǎn","古代国家设立的学习算学的学馆。",{"a":1,"w":[573,7919]}],["箝勒","qiánlēi","马嚼子与马络头。比喻控制约束。",{"a":1,"w":[14814,7571]}],["箝结","qiánjié","箝口结舌。谓闭口不敢发表言论。",{"a":1,"w":[14814,2271]}],["管络","guǎnluò","亦作“筦络”。\n相互交错连接。",{"a":1,"w":[1278,7837]}],["管蔡","guǎncài","周武王弟管叔鲜与蔡叔度的并称。",{"a":1,"w":[1278,9087]}],["管顿","guǎndùn","犹供顿。供应食宿及行旅之所需。",{"a":1,"w":[1278,1370]}],["箱杠","xiānggāng","指要用两人抬的装财物等的行李。",{"a":1,"w":[2354,8183]}],["箱筥","xiāngjǔ","藏物用具。方的叫箱，圆的叫筥。",{"a":1,"w":[2354,84815]}],["节旨","jiézhǐ","犹章旨。总括经书章节大意的话。",{"a":1,"w":[540,9200]}],["节盖","jiégài","古代持符节的大将所使用的伞盖。",{"a":1,"w":[540,2289]}],["节赏","jiéshǎng","旧时过节时主人赏给佣人的钱物。",{"a":1,"w":[540,2415]}],["篆虫","zhuànchóng","犹篆书。形容篆书形体曲屈如虫。",{"a":1,"w":[9979,7601]}],["篇统","piāntǒng","谓整篇文章各种头绪的统一安排。",{"a":1,"w":[703,7442]}],["篷庐","pénglú","像篷盖似的屋子。比喻屋子简陋。",{"a":1,"w":[9193,9988]}],["簁簁","shāishāi","1) 鱼跃貌。\n2) 色白貌。",{"a":1,"w":[209882]}],["簃台","yítái","古台名。即謻台，为周景王所建。",{"a":1,"w":[246647,1306]}],["簪盍","zānhé","《易‧豫》：“勿疑，朋盍簪。”",{"a":1,"w":[9760,20279]}],["簪菊","zānjú","古人于重九日插戴菊花谓之簪菊。",{"a":1,"w":[9760,8188]}],["簿听","bùtīng","主簿办公的官署。听，通“厅”。",{"a":1,"w":[8320,146]}],["籁钥","làiyào","古管乐器。籁，三孔；龠，六孔。",{"a":1,"w":[19549,9086]}],["米麦","mǐmài","米与麦。亦泛指米麦之类的粮食。",{"a":1,"w":[557,7800]}],["粤祝","yuèzhù","粤地的咒祷法术。祝，通“咒”。",{"a":1,"w":[9363,1473]}],["纡绂","yūfú","谓佩印作官。绂，系官印的丝带。",{"a":1,"w":[11098,21975]}],["纡驾","yūjià","犹屈驾。请人或称人来访之敬辞。",{"a":1,"w":[11098,7879]}],["纸冠","zhǐguān","纸糊的帽子。喻名不副实的称号。",{"a":1,"w":[622,7694]}],["纸被","zhǐbèi","古时用藤纤维纸制成的一种被子。",{"a":1,"w":[622,1327]}],["素帻","sùzé","白色包头巾。古代用于凶、丧事。",{"a":1,"w":[7468,21379]}],["素端","sùduān","古代诸侯、大夫、士的一种祭服。",{"a":1,"w":[7468,4659]}],["素纨","sùwán","白色细绢。可用以制衣、书写等。",{"a":1,"w":[7468,14076]}],["索瑟","suǒsè","犹瑟缩。因寒冷惊惧而蜷缩颤抖。",{"a":1,"w":[7470,8205]}],["索郎","suǒláng","酒名。桑落酒的别称。亦泛指酒。",{"a":1,"w":[7470,8101]}],["紫胆","zǐdǎn","官金的一种。凹处有紫色，故名。",{"a":1,"w":[3348,3379]}],["紫英","zǐyīng","1) 紫色花。\n2) 名茶名。",{"a":1,"w":[3348,7637]}],["绀幰","gànxiǎn","天青色车幔。亦指张绀幰的车驾。",{"a":1,"w":[16735,55854]}],["弦心","xiánxīn","犹琴心。琴音中所表达出的心意。",{"a":1,"w":[4726,1279]}],["绝端","juéduān","1) 断绝端绪。\n2) 极端。",{"a":1,"w":[4627,4659]}],["络秀","luòxiù","晋周顗母李氏，名络秀，汝南人。",{"a":1,"w":[7837,8040]}],["绚缋","xuànhuì","彩绘。引申为用华美的文辞记述。",{"a":1,"w":[16285,16193]}],["给赏","gěishǎng","1) 充分欣赏。\n2) 赏赐。"