 shí","指珍馐。亦特指盛于牙盘中的祭品。",{"a":1,"w":[62988,7466]}],["特除名","tè chúmíng","唐代对官吏的罢免处分。比除名轻。",{"a":1,"w":[4607,61818]}],["狠性子","hěn xìngzi","1) 犹狠命。\n2) 指下决心。",{"a":1,"w":[4988,10661]}],["献纳函","xiànnàhán","接受臣民所投书奏、呈文等的匣子。",{"a":1,"w":[3435,7454,7764]}],["猕猴面","míhóu miàn","像猕猴的脸庞。比喻容貌丑陋怪异。",{"a":1,"w":[13202,523]}],["玄云歌","xuányún gē","1) 曲名。\n2) 指仙歌妙曲。",{"a":1,"w":[190925,208]}],["玉屑饭","yùxiè fàn","传说中以玉屑做的饭，食之可无疾。",{"a":1,"w":[146447,169]}],["玉鹿卢","yùlùlú","古代长剑剑首的玉饰。后以代称剑。",{"a":1,"w":[2294,179215]}],["王路堂","wánglùtáng","汉王莽改未央宫前殿曰“王路堂”。",{"a":1,"w":[2278,54,7695]}],["瓜皮船","guāpí chuán","亦称“瓜皮艇”。\n一种简陋小船。",{"a":1,"w":[19898,621]}],["生结香","shēngjié xiāng","亦省作“生结”。\n沉香中之上品。",{"a":1,"w":[71051,1311]}],["画助教","huà zhùjiào","宋宫廷绘画机构中低级的教学官员。",{"a":1,"w":[625,65101]}],["痴瞪瞪","chīdèngdèng","亦作“痴瞪瞪”。\n形容神情呆滞。",{"a":1,"w":[8690,5034]}],["白松扇","báisōng shàn","朝鲜产的摺扇。又名撒扇或聚头扇。",{"a":1,"w":[38372,3380]}],["白铁树","báitiě shù","指梧桐。古有因讳“铜”字而改称。",{"a":1,"w":[33170,109]}],["白云谣","báiyún yáo","古神话中西王母为周穆王所作之歌。",{"a":1,"w":[10694,9699]}],["白额驹","bái'é jū","犹言千里驹。比喻英俊有为的青年。",{"a":1,"w":[21960,10684]}],["白鸽标","báigē biāo","旧时的一种赌博。盛行于广东一带。",{"a":1,"w":[81263,7449]}],["白鹿巾","báilù jīn","古代隐士所戴的白色鹿皮做的头巾。",{"a":1,"w":[84780,8285]}],["百达柱","bǎidázhù","古代高官墓前表示墓主身分的华表。",{"a":1,"w":[133,7430,7685]}],["百炼刀","bǎiliàn dāo","精炼钢刀。比喻精炼、犀利的文字。",{"a":1,"w":[30470,1369]}],["皮桶子","pítǒng zi","做皮衣用的成件毛皮。也叫皮桶儿。",{"a":1,"w":[266313,1]}],["直楞楞","zhíléngléng","亦作“直愣愣”。\n形容呆滞失神。",{"a":1,"w":[1294,10003]}],["直苗苗","zhímiáomiáo","1) 形容耿直。\n2) 直挺挺。",{"a":1,"w":[1294,7980]}],["直荡荡","zhí dàngdàng","形容门户大开，空荡无阻隔的样子。",{"a":1,"w":[1294,16476]}],["石翁仲","shí wēngzhòng","古代帝王或大臣陵墓前石雕的人像。",{"a":1,"w":[7419,133790]}],["磨镜石","mójìng shí","传说轩辕氏铸镜时用以磨镜的石头。",{"a":1,"w":[118652,7419]}],["祖公公","zǔgōng gōng","1) 祖先；远祖。\n2) 祖父。",{"a":1,"w":[221704,4610]}],["神仙手","shénxiān shǒu","指技艺高超出众、令人叹服的能手。",{"a":1,"w":[5382,34]}],["神和病","shénhébìng","旧时迷信者所谓一种鬼神附体的病。",{"a":1,"w":[3316,39,67]}],["福德田","fúdé tián","为修福德而施舍作公众坟墓的土地。",{"a":1