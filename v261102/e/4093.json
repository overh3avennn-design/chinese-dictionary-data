[["大小阮","dàxiǎo ruǎn","指三国魏后期诗人阮籍与其兄子阮咸。二人同为“竹林七贤”中人。世称阮籍为大阮。",{"a":1,"w":[813,11124]}],["奉诚园","fèngchéngyuán","园名。原为唐司徒马燧旧宅，燧死，其子畅将园中大杏赠宦官窦文场，文场以进德宗。",{"a":1,"w":[7971,8307,4715]}],["小蓬莱","xiǎopéng lái","1) 景色清丽，有如神话中的蓬莱仙境的地方。\n2) 仙山名。\n3) 曲牌名。",{"a":1,"w":[88343,7830]}],["小郎君","xiǎoláng jūn","1) 旧时称人家的年轻儿子。亦称其中之最小者。\n2) 旧时对青年男子的敬称。",{"a":1,"w":[150035,7831]}],["崆峒子","kōngdòngzi","指广成子。古代传说，广成子居崆峒山，黄帝曾往问道，故称。事见《庄子‧在宥》。",{"a":1,"w":[56143,12157,1]}],["庆成宴","qìngchéng yàn","1) 古代皇帝祭祀、封禅礼毕时，庆贺成功的筵宴。\n2) 庆贺功名成就的筵宴。",{"a":1,"w":[184772,8323]}],["打场子","dǎcháng zi","玩把戏或拳术时，拿绳子或用拳、刀作虚势令人后退以围成场地。亦谓在空地上卖艺。",{"a":1,"w":[90430,1]}],["押座文","yāzuòwén","唐人宣讲佛教经文或故事前，先讲唱一段使在座听众安静下来的精练短文，叫押座文。",{"a":1,"w":[8081,608,7415]}],["昏擦剌","hūncālá","同“昏惨惨”。\n元刘致《寨儿令》曲：“夜已阑，灯将灭，纱窗外昏擦剌月儿斜。”",{"a":1,"w":[4748,2396,8630]}],["春申涧","chūnshēn jiàn","溪涧名。在今江苏省无锡市锡惠公园中。相传为战国春申君黄歇饮马处。又名黄公涧。",{"a":1,"w":[152341,17942]}],["梨花云","líhuā yún","《墨庄漫录》卷六引唐王建《梦看梨花云歌》：“薄薄落落雾不分，梦中唤作梨花云。",{"a":1,"w":[21798,554]}],["杨花落","yánghuā luò","词牌《谒金门》的异名。双调四十五字，前后段各四句，四仄韵。参阅《词谱》卷五。",{"a":1,"w":[50912,2275]}],["楞冲冲","léng chōngchōng","鲁莽冒失的样子。如：那次游泳，你楞冲冲地从高台上跳下来，真叫人为你捏一把汗。",{"a":1,"w":[10003,31355]}],["步步娇","bùbù jiāo","曲牌名。一名潘妃曲。属北小令，双调，并可入套。如元商挺《步步娇‧失题二首》。",{"a":1,"w":[19324,8704]}],["步虚词","bùxū cí","1) 道教唱经礼赞之词。\n2) 乐府杂曲歌名。\n3) 词牌名。即《西江月》。",{"a":1,"w":[113136,596]}],["武侯吟","wǔhóu yín","指《梁甫吟》。乐府楚调曲名。相传为诸葛亮作，以抒发未能实现其抱负的悲愤心情。",{"a":1,"w":[35658,8955]}],["历下亭","lìxiàtíng","亭名。一名客亭。在山东省济南市大明湖畔。面山环湖，风景殊胜。约建于北魏年间。",{"a":1,"w":[1129547,8241]}],["水晶脍","shuǐjīng kuài","宋代名菜，当时在汴梁市肆中享有盛誉。因其主料切丝，成品透明，犹如水晶，故名。",{"a":1,"w":[10037,13477]}],["油渍渍","yóuzì zì","形容沾满了油。杜鹏程《年青的朋友》一：“他个子挺小，歪戴着油渍渍的工人帽。”",{"a":1,"w":[67470,8883]}],["泡子河","pāozǐ hé","元代开凿的通惠河的一段，两岸多高槐垂柳，位于北京市崇文门内东城角。久已湮没。",{"a":1,"w":[35976,585]}],["波斯眼","bōsī yǎn","波斯商人多经营珍宝古董，善于识别其真伪。因以“波斯眼”借指识别力很强的眼睛。",{"a":1,"w":[10804,551]}],["净水珠","jìngshuǐ zhū","佛教经典中称能使浊水澄清的宝珠。也称“净摩尼珠”。经中常用以比喻慈心和信心。",{"a":1,"w":[16698,7784]}],["净罪山","jìngzuìshān","意大利诗人但丁(Dante)《神曲‧地狱篇》谓能替人洗去罪恶的艰险难行的山。",{"a":1,"w":[4690,4686,45]}],["清平官","qīngpíng guān","唐南诏王以下最高行政官员。有坦绰、布燮、久赞之分，共六人。相当于唐朝的宰相。",{"a":1,"w":[31637,2293]}],["汉武台","hànwǔ tái","汉武帝为求仙所筑的高台。在沧州。其地俯临大海，长澜接天，巉岩峻石，颇为壮观。",{"a":1,"w":[58893,1306]}],["泼皮货","pōpí huò","詈词。无赖的家伙。张一弓《黑娃照相》：“他在想，我咋碰到这样一个泼皮货呀！”",{"a":1,"w":[102189,2304]}],["火惹惹","huǒ rěrě","1) 犹火辣辣。形容兴奋、激动、害羞等(情绪)。\n2) 犹火辣辣。形容酷热。",{"a":1,"w":[1284,187597]}],["无灰木","wúhuī mù","不灰木的别称。指石棉一类耐燃的矿物。见明李时珍《本草纲目‧金石三‧不灰木》。",{"a":1,"w":[99607,7435]}],["照虚耗","zhào xūhào","古代风俗，于十二月二十四日或除夕点灯照床下，以驱除秽邪鬼怪，谓之“照虚耗”。",{"a":1,"w":[1326,68458]}],["王侯腊","wánghóu là","旧时阴历十二月初八日，民间有煮果粥祀神、聚食及馈送亲邻的风俗，称“王侯腊”。",{"a":1,"w":[27978,8052]}],["碧纱幮","bì shāchú","亦作“碧纱厨”。\n以木为架，顶及四周蒙以绿纱，可以摺叠。夏令张之，以避蚊蝇。",{"a":1,"w":[8659,155122]}],["祝虎院","zhùhǔyuàn","旧时对犹太教堂的称呼。祝虎djuhud的音译，阿拉伯和波斯语中对犹太人之称。",{"a":1,"w":[1473,3337,571]}],["绿珠江","lǜ zhūjiāng","江名。在今广西壮族自治区博白县双角山下。相传晋代美女绿珠出生于此，因以为名。",{"a":1,"w":[605,41055]}],["维口食","wéi kǒushí","佛教所反对的“邪命自活”的方式之一。指用种种咒术、卜算吉凶等方法以维持生活。",{"a":1,"w":[7432,254262]}],["缩项鱼","suōxiàng yú","宋王禹偁《回襄阳周奉礼同年因题纸尾》诗：“扶头酒好无辞醉，缩项鱼多且放嚵。”",{"a":1,"w":[252013,526]}],["义姑姊","yì gūzǐ","春秋时，齐攻鲁，至郊。一妇人抱子携侄而行。军且及，妇人度不能两全，乃弃己子。",{"a":1,"w":[7437,173858]}],["老大人","lǎodà rén","1) 旧时官场用语。尊称年老位尊的人。\n2) 旧时官场用语。尊称对方的父亲。",{"a":1,"w":[11014,3]}],["聪明鸟","cōngmíngniǎo","汉祢衡《鹦鹉赋》：“性辩慧而能言兮，才聪明而识机。”后因以“聪明鸟”指鹦鹉。",{"a":1,"w":[1760,581]}],["腰腿功","yāotuǐ gōng","戏曲演员的基本武功。如：他六十多岁了，还登台表演，没有扎实的腰腿功是不行的。",{"a":1,"w":[48015,7516]}],["兰亭序","lántíng xù","又名《兰亭宴集序》、《兰亭集序》、《临河序》、《禊序》、《禊帖》。行书法帖。",{"a":1,"w":[40538,7598]}],["蚁窠梦","yǐkē mèng","同“蚁梦”。亦作“螘窠梦”。\n宋陆游《衰病》诗：“仕宦螘窠梦，功名马耳风。”",{"a":1,"w":[306954,2386]}],["话靶戏","huàbǎ xì","I\n方言。让人谈论的滑稽可笑的事情。\nII\n方言。让人谈论的滑稽可笑的事情。",{"a":1,"w":[750997,3341]}],["谷口隐","gǔkǒu yǐn","同“谷口耕”。\n宋梅尧臣《依韵武平忆玉晨馆》诗：“终寻谷口隐，郑子岂其卿。”",{"a":1,"w":[53893,7652]}],["贤竹林","xián zhúlín","三国魏阮籍与其侄阮咸名列“竹林七贤”，后人因用“贤竹林”为对他人叔侄的敬称。",{"a":1,"w":[8050,17948]}],["过去世","guòqu shì","佛教把时间过程划分为过去世、现在世、未来世，合称“三世”。过去世为三世之一。",{"a":1,"w":[722,7462]}],["邹子律","zōuzilǜ","同“邹律”。\n宋黄庭坚《赠送张叔和》诗：“张侯温如邹子律，能令阴谷黍生春。”",{"a":1,"w":[12763,1,7544]}],["野狐岭","yěhúlǐng","山岭名。在河北万全西北。山势高峻，风力猛烈，雁飞过此，遇风辄堕，为军事要隘。",{"a":1,"w":[4626,8675,8515]}],["金琅珰","jīn lángdāng","1) 金属制的铃铎。即旧时悬挂于殿、塔四角或屋檐下的风铃。\n2) 喻指葡萄。",{"a":1,"w":[1270,74394]}],["金线泉","jīnxiàn quán","在山东省济南市西门外趵突泉公园内。泉水清澈，在日光辉映下有如金线浮现，故名。",{"a":1,"w":[16611,3461]}],["金陵山","jīnlíng shān","1) 即钟山。在今江苏省南京市中山门外。\n2) 即北固山。在今江苏省镇江市。",{"a":1,"w":[46334,45]}],["隔壁听","gébì tīng","I\n指大言无实，空有声调，难经目验。\nII\n指大言无实，空有声调，难经目验。",{"a":1,"w":[4065,146]}],["来年历","láinián lì","I\n去年的历书。比喻已失时效的废物。\nII\n去年的历书。比喻已失时效的废物。",{"a":1,"w":[115847,7643]}],["难荫生","nànyìn shēng","清制，因公殉职的文武官员，不论爵秩，例得有一子入国子监读书，谓之“难荫生”。",{"a":1,"w":[131114,508]}],["云韶部","yúnsháobù","1) 宋代宫中管理宫廷音乐的官署。承唐代教坊旧制。\n2) 鸟名。又称音声鸟。",{"a":1,"w":[554,10368,1295]}],["头陀行","tóutuó xíng","佛教语。指佛教僧侣行头陀时，应遵守的住空闲处、常乞食、着百衲衣等十二项苦行。",{"a":1,"w":[243930,8]}],["风木叹","fēngmù tàn","同“风木之思”。\n宋陆游《焚黄》诗：“早岁已兴风木叹，余生永废《蓼莪》诗。”",{"a":1,"w":[126928,8742]}],["食苹鹿","shípínglù","比喻秉志高洁，不慕爵禄的人。语出《诗‧小雅‧鹿鸣》：“呦呦鹿鸣，食野之苹。”",{"a":1,"w":[7466,8987,8199]}],["冯瀛王","féngyíngwáng","五代时冯道，曾倡议国子监校定“九经”，组工雕印，我国官府大规模刻书自此开始。",{"a":1,"w":[8535,14867,2278]}],["凤麟胶","fènglínjiāo","传说中的一种粘合剂。以凤喙及麟角合煎而成，能续弓弩已断之弦，连刀剑断折之金。",{"a":1,"w":[7768,8990,7702]}],["黑司命","hēi sīmìng","肉苁蓉的别名。见宋陶谷《清异录‧药谱》、明李时珍《本草纲目‧草一‧肉苁容》。",{"a":1,"w":[549,26799]}],["安代舞","āndàiwǔ","我国蒙古族民间舞蹈。舞者双手各执一方巾挥舞，由一人领唱，众人相和，边歌边舞。",{"a":1,"w":[2261,1313,3356]}],["拨秧机","bōyāngjī","拨取水稻秧苗的机器。能完成拨秧和放苗两项工作。目前主要有钳夹式和滚梳式两种。",{"a":1,"w":[4720,9452,7405]}],["采茶戏","cǎicháxì","流行于江西、湖北、广西、安徽等地的地方戏，由民间歌舞发展而成，跟花鼓戏相近。",{"a":1,"w":[79672,3341]}],["放缩尺","fàng suōchǐ","把平面图形放大或缩小的绘图工具。它是根据平行四边形和相似三角形的性质制成的。",{"a":1,"w":[63,88637]}],["结业生","jiéyè shēng","指具有学籍的学生学完教学计划规定的全部课程，其中有一门以上主要课程不及格者。",{"a":1,"w":[29819,508]}],["碾磙子","niǎn gǔnzi","碾子①的主要部分，是一个圆柱形的石头，可以轧碎粮食或去掉粮食的皮。也叫碾砣。",{"a":1,"w":[9965,232120]}],["刘青云","liú qīngyún","Lau Ching-Wan (1964-), Hong Kong actor",{"a":1,"w":[8276,20352]}],["卡洛娜","kǎluò nà","calzone (Italian pocket), folded pizza",{"a":1,"w":[20325,7698]}],["哈密市","hāmì shì"