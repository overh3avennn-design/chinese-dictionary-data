,55]}],["拐腿","guǎituǐ","瘸子。指腿不便于行走的人。",{"a":1,"w":[4808,660]}],["拒物","jùwù","拒绝外物。谓不与外界接触。",{"a":1,"w":[8554,7412]}],["拒险","jùxiǎn","据守险要；凭藉险要以拒敌。",{"a":1,"w":[8554,4634]}],["拗声","ǎoshēng","拗口的语音；不顺耳的声调。",{"a":1,"w":[9264,3317]}],["拘指","jūzhǐ","拱手。两手弯转，合抱致敬。",{"a":1,"w":[8339,1312]}],["拘摄","jūshè","1) 拘拿。\n2) 征收。",{"a":1,"w":[8339,7746]}],["拙野","zhuōyě","1) 粗糙。\n2) 质朴。",{"a":1,"w":[9782,4626]}],["持容","chíróng","谓欲保持官位而取容于人主。",{"a":1,"w":[7617,7524]}],["持筹","chíchóu","手持算筹。多指理财或经商。",{"a":1,"w":[7617,8478]}],["挂匾","guàbiǎn","悬挂匾额。表示感谢或赞扬。",{"a":1,"w":[1393,16420]}],["挂舌","guàshé","1) 挂口。\n2) 闭口。",{"a":1,"w":[1393,7844]}],["振顿","zhèndùn","1) 振作。\n2) 整顿。",{"a":1,"w":[7579,1370]}],["挺逸","tǐngyì","1) 脱逃。\n2) 俊逸。",{"a":1,"w":[677,8116]}],["挽推","wǎntuī","1) 引荐。\n2) 扶持。",{"a":1,"w":[8944,586]}],["挟生","xiéshēng","犹言不待烧煮，活吃，生吃。",{"a":1,"w":[9195,508]}],["捉头","zhuōtóu","抽头。设赌的头家抽取头钱。",{"a":1,"w":[4941,509]}],["捶表","chuíbiǎo","树立于边界悬有标志的木柱。",{"a":1,"w":[10426,536]}],["捽茹","zuórú","饮食，吃喝。捽，通“啐”。",{"a":1,"w":[17673,8598]}],["授历","shòulì","亦作“授历”。\n颁布历法。",{"a":1,"w":[8099,7643]}],["掉动","diàodòng","1) 转动。\n2) 调动。",{"a":1,"w":[651,6]}],["挣达","zhēngdá","1) 漂亮。\n2) 老练。",{"a":1,"w":[3590,7430]}],["采打","cǎidǎ","1) 砍伐。\n2) 揪打。",{"a":1,"w":[7528,66]}],["采猎","cǎiliè","1) 选取。\n2) 狩猎。",{"a":1,"w":[7528,8294]}],["探策","tàncè","1) 求签。\n2) 射策。",{"a":1,"w":[7690,7673]}],["掣板","chèbǎn","方言。安装电器开关的底板。",{"a":1,"w":[9713,1305]}],["推与","tuīyǔ","1) 让与。\n2) 推许。",{"a":1,"w":[586,2270]}],["掩塞","yǎnsāi","1) 蒙蔽。\n2) 堵塞。",{"a":1,"w":[8167,4630]}],["掩攻","yǎngōng","袭击，乘人不备而加以攻击。",{"a":1,"w":[8167,7761]}],["揆景","kuíjǐng","测量日影，以定时间或方位。",{"a":1,"w":[11452,4676]}],["提备","tíbèi","1) 防备。\n2) 准备。",{"a":1,"w":[561,7452]}],["提拂","tífú","1) 提携。\n2) 扫帚。",{"a":1,"w":[561,8565]}],["插烛","chāzhú","形容跪拜时连续磕头的动作。",{"a":1,"w":[3394,8450]}],["揖游","yīyóu","古代行礼时依礼仪进退俯仰。",{"a":1,"w":[10571,1317]}],["扬玄","yángxuán","谓汉扬雄所着的《太玄经》。",{"a":1,"w":[7578,7911]}],["揜抑","yǎnyì","1) 郁闷。\n2) 遏止。",{"a":1,"w":[16115,8091]}],["握图","wòtú","犹握符。谓膺