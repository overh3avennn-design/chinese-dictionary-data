99,9627]}],["平安醮","píng'ān jiào","旧时为一般祈福消灾举行的“打醮”仪式，与因病或因丧事延请僧道诵经祈祷的“打醮”有别。",{"a":1,"w":[887,12871]}],["武溪笛","wǔxīdí","汉马援门生爰寄生善吹笛，马援作《武溪深》和之，叹水深湍急，涉渡艰难。后用为赠别之曲。",{"a":1,"w":[7504,4874,9468]}],["水精球","shuǐjīng qiú","亦作“水晶球”。\n1) 水晶制成的球。比喻明月。\n2) 水晶制成的球。比喻圆滑之人。",{"a":1,"w":[26876,83]}],["没事村","méishì cūn","同“没2事哏”。\n元孙仲章《勘头巾》第一摺：“你骂了人倒说你是，你没事哏，没事村。”",{"a":1,"w":[11970,1430]}],["没事狠","méishì hěn","同“没2事哏”。\n明贾仲名《对玉梳》第一摺：“俺那娘颩着一个冷鼻凹，百般儿没事狠。”",{"a":1,"w":[11970,4988]}],["浣花溪","huàn huāxī","一名濯锦江。又名百花潭。在四川省成都市西郊，为锦江支流。溪旁有唐杜甫的故居浣花草堂。",{"a":1,"w":[10483,238921]}],["游衣冠","yóu yīguān","汉代制度，每月初一将高帝的衣冠从陵墓的宫殿中移到祭祀高帝的宗庙里去，谓之“游衣冠”。",{"a":1,"w":[1317,19910]}],["汉经厂","hànjīngchǎng","明代内府印经机构之一。专印汉文佛经，区别于印制少数民族语文如藏文、蒙文佛经的番经厂。",{"a":1,"w":[7539,7421,1401]}],["无尽财","wújìn cái","佛教语。寺庙中积累金钱，贷与他人，使生利息，以供佛、法、僧三宝之用，称为“无尽财”。",{"a":1,"w":[32234,7700]}],["烦恼丝","fánnǎo sī","佛教语。佛门以剃除须发为受戒出家，现清净僧尼相的标志之一，故佛家称头发为“烦恼丝”。",{"a":1,"w":[2866,7515]}],["熊子国","xióng zǐguó","周成王时，以子男之田封熊绎于楚蛮，故址在今湘鄂一带，后因以熊子国指代湖南、湖北两省。",{"a":1,"w":[3442,31883]}],["烧财神","shāo cáishén","1) 旧时迷信的人祭财神消灾求福，称“烧财神”。参见“烧路头”。\n2) 指奉承富人。",{"a":1,"w":[2303,30877]}],["玉山桂","yùshān guì","《晋书‧郤诜传》：“泰始中，诏天下举贤良直言之士，太守文立举诜应选……累迁雍州刺史。",{"a":1,"w":[14385,8044]}],["生各札","shēnggèzhá","同“生各支”。\n元李行道《灰阑记》第四摺：“一壁厢夫主身亡，更待教生各札子母分离。”",{"a":1,"w":[508,1406,8726]}],["瞎吧吧","xiā bābā","乱开口，乱说。评剧《小女婿》第十一场：“罗寡妇：‘小孩子，懂得啥？你不要瞎吧吧！’”",{"a":1,"w":[3476,73277]}],["石骆驼","shí luòtuo","封建时代贵族、大臣墓前石兽的一种。一般与其他石兽组合在一起，安置在陵墓前神道的两旁。",{"a":1,"w":[7419,15938]}],["祥桑谷","xiángsāng gǔ","妖桑和妖谷。古代传说，殷帝太戊时，“亳有祥桑谷共生于朝，一暮大拱。帝太戊惧，问伊陟。",{"a":1,"w":[105150,7701]}],["税契银","shuìqì yín","中国旧时民间不动产买卖典当，在契约成立之后，新业主向官署办理过户手续时所缴纳的税款。",{"a":1,"w":[179237,1350]}],["端公戏","duāngōng xì","从巫师(端公)跳神发展而成的戏曲剧种，流行于陕西、安徽等地。过去带有较多的宗教色彩。",{"a":1,"w":[199971,3341]}],["筹笔驿","chóubǐyì","古驿名。在四川省广元市北八十里。相传诸葛亮出师，尝驻军运筹于此。今朝天驿废址即其地。",{"a":1,"w":[8478,619,9950]}],["美姿姿","měizī zī","同“美孜孜”。\n元乔吉《金钱记》第一摺：“我见她簇双鸦将眼梢儿斜抹，美姿姿可喜煞。”",{"a":1,"w":[85172,8460]}],["虾蟆台","háma tái","蝌蚪的别名。见《尔雅翼‧释鱼三》及明李时珍《本草纲目‧虫四‧蝌斗》。参见“虾蟆子”。",{"a":1,"w":[45597,1306]}],["血盆池","xuèpén chí","旧时迷信传说，谓地狱中有血盆池，妇女生育过多，会触污神佛，死后要在此池中饮污血受苦。",{"a":1,"w":[68925,7815]}],["护官符","hùguānfú","旧指地方上权贵的名单。新上任的官员必须保护他们的利益，才能立住脚跟，保住自己的官职。",{"a":1,"w":[4643,2293,7841]}],["辋川图","wǎngchuāntú","1) 唐诗人王维绘的名画。绘辋川别业二十胜景于其上，故名。\n2) 借指风景幽胜之处。",{"a":1,"w":[30073,7897,1301]}],["连枝树","liánzhī shù","枝叶相连之树。常用以喻兄弟或夫妇。旧题汉苏武《诗》之一：“况我连枝树，与子同一身。”",{"a":1,"w":[86941,109]}],["避青骢","bìqīngcōng","同“避骢马”。\n清蓝启肃《送郭华野总制湖广》诗：“列郡应多投墨绶，当朝谁不避青骢？”",{"a":1,"w":[2388,3320,32185]}],["边韶笥","biānsháosì","同“边氏腹”。\n清李调元《送门生颜东屏赴乡试即用原韵》：“才尽江淹笔，腹嘲边韶笥。”",{"a":1,"w":[553,10368,23512]}],["邻家笛","línjiā dí","同“邻笛”。\n唐杜甫《奉汉中王手札报韦侍御萧尊师亡》诗：“处处邻家笛，飘飘客子蓬。”",{"a":1,"w":[286119,9468]}],["长鲸饮","chángjīng yǐn","语出唐杜甫《饮中八仙歌》：“左相日兴费万钱，饮如长鲸吸百川。”后以“长鲸饮”喻豪饮。",{"a":1,"w":[104782,7871]}],["闲盘儿","xián pánr","亦作“闲盘儿”。\n1) 不相干的事；闲事。\n2) 犹闲话。如：算了吧，别扯闲盘儿啦。",{"a":1,"w":[3381,13176]}],["陶令株","táolìngzhū","晋陶潜《五柳先生传》：“先生不知何许人也，亦不详其姓字。宅边有五柳树，因以为号焉。”",{"a":1,"w":[7848,3329,4901]}],["陶氏梭","táoshì suō","晋陶侃少时，渔于雷泽，网得一织梭，挂于壁，忽雷雨大作，化龙而去。见《晋书‧陶侃传》。",{"a":1,"w":[58298,8356]}],["云峤篇","yúnjiàopiān","南朝齐王融《游仙》诗之二有“结赏自云峤，移宴乃方壶”句。后因用“云峤篇”借指游仙诗。",{"a":1,"w":[554,16760,703]}],["青苹末","qīng píngmò","战国楚宋玉《风赋》：“夫风生于地，起于青苹之末。”后因以“青苹末”指初起的风，小风。",{"a":1,"w":[3320,155985]}],["题扇桥","tíshànqiáo","相传为晋王羲之替卖扇老姥题扇之处。桥在浙江省绍兴市蕺山之南。事见《晋书‧王羲之传》。",{"a":1,"w":[615,3380,1435]}],["饭后钟","fànhòu zhōng","相传唐王播少年孤贫，客居扬州惠明寺木兰院，随僧斋食。日久，众僧厌恶，故意斋后才敲钟。",{"a":1,"w":[43534,1410]}],["饮牛津","yǐn niújīn","指天河。传说海边居民曾乘槎至天河，“见一丈夫牵牛渚次饮之”。见晋张华《博物志》卷三。",{"a":1,"w":[7871,41340]}],["养廉地","yǎnglián dì","清制，对官吏除发常俸外，另给恩俸名曰“养廉”；或划给土地，以供收租，名曰“养廉地”。",{"a":1,"w":[55048,10]}],["郁轮袍","yùlúnpáo","1) 古曲名。相传为唐王维所作。\n2) 杂剧名。\n3) 琵琶套曲《霸王卸甲》的别名。",{"a":1,"w":[8084,2280,9451]}],["魏夫人","wèi fūrén","晋魏舒女，名华存。幼时好道慕仙，后托剑化形而去，被封为南岳夫人。后代又以为花神之首。",{"a":1,"w":[8322,2554]}],["麟毫帘","línháolián","用麟毛做成的帘子。语出《洞冥记》：“元鼎元年，起招仙阁于甘泉宫西，编翠羽麟毫为帘。”",{"a":1,"w":[8990,7913,8925]}],["黄金符","huángjīn fú","金制的兵符。为古代朝廷传达命令或征调兵将用的凭证，朝廷与将领各执一半，合之以验真假。",{"a":1,"w":[2492,7841]}],["齐云楼","qí yúnlóu","古楼名。齐云，言其高与云齐。较为着名者有二：(1)旧在江苏苏州子城上，唐曹恭王所建。",{"a":1,"w":[1347,163579]}],["活络丸","huóluò wán","常用中成药。有祛风除湿，理气化痰，舒筋活络的功能。主治中风瘫痪，痿痹痰厥，拘挛疼痛。",{"a":1,"w":[33938,4757]}],["水坠坝","shuǐzhuìbà","利用水的作用代替人工夯实或运土的施工方法所筑成的土坝。多见于我国西北、华北黄土地区。",{"a":1,"w":[11,4826,10428]}],["专用号","zhuānyòng hào","标点符号（—），用在横行文字的底下或竖行文字的旁边，表示人名、地名、机关团体名之类。",{"a":1,"w":[5031,78]}],["吹竽手","chuīyú shǒu","player of the yu 竽 (free reed mouth organ)",{"a":1,"w":[166801,34]}],["好立克","hǎolìkè","Horlicks milk drink (popular in Hong Kong)",{"a":1,"w":[58,3314,516]}],["导出值","dǎochū zhí","value deduced by calculation\nderived value",{"a":1,"w":[17057,1364]}],["心眼好","xīnyǎn hǎo","well-intentioned\ngood-natured\nkind-hearted",{"a":1,"w":[11845,58]}],["戴名世","dài míngshì","Dai Mingshi (1653-1713), early Qing writer",{"a":1,"w":[2394,77872]}],["曲周县","qūzhōuxiàn","Quzhou county in Handan 邯郸[Hán dān], Hebei",{"a":1,"w":[7517,563,2279]}],["棉药签","miányàoqiān","variant of 棉药签[mián yaò qiān]\nmedical swab",{"a":1,"w":[4745,579,3396]}],["横筋斗","héngjīn dòu","to tumble\nto turn a cartwheel\na somersault",{"a":1,"w":[112033,7477]}],["死伤者","sǐshāng zhě","casualty (of an accident)\ndead and wounded",{"a":1,"w":[33083,1285]}],["溆浦县","xùpǔxiàn","Xupu county in Huaihua 怀化[Huái huà], Hunan",{"a":1,"w":[387427,2279]}],["稳定塘","wěndìng táng","stabilization tank (for sewage processing)",{"a":1,"w":[2414,9103]}],["临洮县","líntáoxiàn","Lintao county in Dingxi 定西[Dìng xī], Gansu",{"a":1,"w":[627277,2279]}],["荷塘区","hétáng qū","Hetang district of Zhuzhou city 株洲市, Hunan",{"a":1,"w":[277177,1296]}],["叶永烈","yèyǒngliè","Ye Yonglie (1940-), popular science writer",{"a":1,"w":[7426,8131,7947]}],["芦淞区","lúsōngqū","Lusong district of Zhuzhou city 株洲市, Hunan",{"a":1,"w":[8303,15789,1296]}],["西吉县","xī jíxiàn","Xiji county in Guyuan 固原[Gù yuán], Ningxia",{"a":1,"w":[51,70126]}],["诺塞斯","nuò sèsī","Knossos (Minoan palace at Iraklion, Crete)",{"a":1,"w":[7495,25272]}],["超物理","chāo wùlǐ","surpassing the physical world\nmetaphysical",{"a":1,"w":[4633,3485]}],["游戏说","yóuxì shuō","theory of free play (in Kant’s philosophy)",{"a":1,"w":[1481,68]}],["邯郸县","hándān xiàn","Handan county in Handan 邯郸[Hán dān], Hebei",{"a":1,"w":[28906,2279]}],["陇西县","lǒngxī xiàn","Longxi county in Dingxi 定西[Dìng xī], Gansu",{"a":1,"w":[81821,2279]}],["电子盘","diànzǐ pán","USB flash drive\nsee also 闪存盘[shǎn cún pán]",{"a":1,"w":[7991,2285]}],["靠走廊","kào zǒuláng","next to the aisle\naisle (seat on aircraft)",{"a":1,"w":[656,5677]}],["鼠得克","shǔdékè","difenacoum (anticoagulant and rodenticide)",{"a":1,"w":[3351,520,516]}],["伶俐人","língli rén","聪慧的人。 红楼梦·第六十七回： “柳二爷那样个伶俐人， 未必是真跟了道士去罢。 ”",{"a":1,"w":[6293,3]}],["做屏风","zuò píngfēng","比喻能起掩护作用的人或事物。 如： “他有董事长做屏风， 小小的组长算得了什么！ ”",{"a":1,"w":[150,25555]}],["入眼货","rùyǎn huò","使人看上、 中意的东西。 如： “他一早就在市集里逛， 大半天都瞅不出个入眼货。 ”",{"a":1,"w":[48139,2304]}],["冒凉腔","màoliángqiāng","冷言冷语， 讥笑嘲讽。 如： “你不但不提供意见， 还在一旁冒凉腔， 真没道理。 ”",{"a":1,"w":[3400,661,8012]}],["凑现成","còu xiànchéng","比喻不劳而获， 坐享其成。 如： “你别想凑现成， 没那么便宜的事， 快动手吧！ ”",{"a":1,"w":[8789,6274]}],["切接法","qiējiē fǎ","一种将植物嫁接的方法。 为最常用的接木法， 于每年二、 三月间实施， 其存活率颇高。",{"a":1,"w":[76581,2258]}],["千佛塔","qiān fótǎ","位于印尼爪哇岛的佛教遗迹。 塔共九层， 建于西元八世纪， 是世界闻名的石刻艺术宝库。",{"a":1,"w":[587,14211]}],["博古儿","bógǔr","1. 弹古琴、 下围棋等文艺娱乐。\n2. 画上的香炉、 帽筒、 如意、 掸瓶等图形。",{"a":1,"w":[14357,7408]}],["呆憨呆","dāihāndāi","痴傻、 不灵敏的样子。 红楼梦·第五十八回： “你也学着些伏侍， 别一味呆憨呆。 ”",{"a":1,"w":[3517,12006]}],["大会厅","dàhuì tīng","泛指剧场、 电影院、 音乐厅、 公会堂、 礼堂等， 由舞台和客席所构成的建筑物总称。",{"a":1,"w":[2490,3439]}],["大方家","dàfāng jiā","有名的大家。 幼学琼林·卷四·文事飏“求作文曰乞挥如椽笔， 羡高文曰才是大方家。 ”",{"a":1,"w":[2705,28]}],["奋逸响","fèn yìxiǎng","发出不平凡的音响。 文选·古诗十九首·今日良宴会： “弹筝奋逸响， 新声妙入神。 ”",{"a":1,"w":[8299,181916]}],["宜春帖","yíchūn tiē","旧俗在立春日用来祝贺新春， 上有宜春二字的帖子。 见南朝梁·宗懔·荆楚岁时记·正月。",{"a":1,"w":[35806,8250]}],["就里人","jiùlǐ rén","知道内情的人。 水浒传·第六十九回： “其日， 使个就里人， 乘势来问这头亲事。 ”",{"a":1,"w":[115657,3]}],["布卡拉","bùkǎ lā","城市名。 在阿富汗之北， 阿姆河之东， 建有华丽的回教堂， 为仅次于麦加的回教圣地。",{"a":1,"w":[34871,514]}],["布喀河","bùkāhé","河川名。 青海省最大河川， 发源于阿木尼厄枯山， 最后注入青海。 或称为“大非川”。",{"a":1,"w":[1283,8948,585]}],["干证人","gānzhèng rén","可提供证据的人。 金瓶梅·第十回： “地方保甲押着武二， 并酒保、 唱的干证人。 ”",{"a":1,"w":[258670,3]}],["幽特贝","yōutèbèi","希腊神话中掌管艺术的九位缪斯女神之一， 掌悲剧和音乐。 为英语Euterpe的音译。",{"a":1,"w":[8098,4607,7553]}],["悲愤诗","bēifèn shī","诗名。 东汉末蔡琰陷入胡地十二年， 归汉后感伤乱离所作。 为五言诗， 共一百零八句。",{"a":1,"w":[51693,2369]}],["执旗将","zhíqíjiāng","军队中掌旗的人物。 三国演义·第七回： “曲义马到， 先斩执旗将， 把绣旗砍倒。 ”",{"a":1,"w":[7826,7796,3328]}],["扯平点","chěpíng diǎn","得失的平衡点。 如： “你分析事情的利害关系， 找到扯平点， 问题就容易解决了。 ”",{"a":1,"w":[109685,64]}],["把门人","bǎmén rén","看门的仆役。 三国演义·第二回： “我等皆来苦告， 不得放人， 反遭把门人赶打。 ”",{"a":1,"w":[21473,3]}],["拍鬼脸","pāi guǐliǎn","使人出丑丢脸。 野叟曝言·第十八回： “合堂人都气破胸脯， 正要拍出他鬼脸来哩！ ”",{"a":1,"w":[1418,24052]}],["指路人","zhǐlù rén","指明路途、 方向的人。 亦指引导的人。 如： “他是指引我走上人生正途的指路人。 ”",{"a":1,"w":[24363,3]}],["攀龙客","pānlóng kè","跟随君主以求仕进的人。 晋·左思·咏史诗八首之五： “自非攀龙客， 何为欻来游？ ”",{"a":1,"w":[21699,7618]}],["文阁","wén gé","位于江苏省扬州市大观堂的藏书阁。 清乾隆四十五年建， 专藏四库全书， 咸丰年间焚毁。",{"a":1,"w":[7415,8208]}],["旧疮疤","jiù chuāngbā","比喻过去痛苦难堪的经历或缺点。 如： “别尽挖人家的旧疮疤， 替人留一点余地吧！ ”",{"a":1,"w":[1396,30498]}],["星鸡鱼","xīngjīyú","动物名。 硬骨鱼纲石鲈科。 身体呈灰褐色， 体侧及鳞片上有黑色斑点。 台湾亦有出产。",{"a":1,"w":[7443,578,526]}],["普珥日","pǔ'ěrrì","犹太人纪念祖先， 受以斯帖和末底改的援助， 而逃避了哈曼陷害的日子。 约在三月一日。",{"a":1,"w":[7547,11050,50]}],["月仪帖","yuèyítiē","相传为晋代书法家索靖写成的书帖。 此帖用笔奇宕， 点画遒厚， 气韵古雅， 意境悠长。",{"a":1,"w":[101,7483,8250]}],["机关头","jīguān tóu","火车头。 如： “冒着白烟的机关头拉着长列的车厢驶出了火车站。 ”亦称为“机关车”。",{"a":1,"w":[4795,509]}]]