":[25783,10757]}],["出奇致胜","chūqízhìshèng","出奇兵战胜敌人。比喻用对方意料不到的方法取得胜利。",{"a":1,"w":[25783,23912]}],["刍荛之见","chúráozhījiàn","刍荛割草打柴的人。认为自己的意见很浅陋的谦虚说法。",{"a":1,"w":[45081,2254,76]}],["出谷迁乔","chū gǔ qiānqiáo","从幽深的溪谷出来，迁上了高大的乔木。比喻地位上升。",{"a":1,"w":[22,7701,200107]}],["驰马试剑","chímǎ shìjiàn","驰马骑马飞跑；试用。跑马舞剑。形容人骑马练剑习武。",{"a":1,"w":[266430,205656]}],["朝夷暮跖","zhāoyímùzhí","早晨被誉为伯夷，晚上被贬作盗跖。形容时论毁誉多变。",{"a":1,"w":[1357,7910,8841,9805]}],["朝奏暮召","zhāozòumùzhào","指早晨上书帝王，晚上就被召见。形容被朝廷任用之速。",{"a":1,"w":[1357,4777,8841,8854]}],["朝奏夕召","zhāozòuxīzhào","指早晨上书帝王，晚上就被召见。形容被朝廷任用之速。",{"a":1,"w":[1357,4777,8506,8854]}],["苌弘化碧","chánghónghuàbì","苌弘周敬王的夫人，后蒙冤为人所杀，传说血化为碧玉。",{"a":1,"w":[38514,217629,8659]}],["超超玄著","chāochāoxuánzhù","超超形容高超；玄微妙；著明显。言论、文辞高妙明切。",{"a":1,"w":[138002,7911,7908]}],["草木俱朽","cǎomù jù xiǔ","象草木一样死去，世人并不知道。借喻人一生毫无建树。",{"a":1,"w":[12254,8196,9194]}],["不知藋蕫","bùzhī diào dǒng","藋蕫草名，质地柔软可制绳子。比喻不懂事，缺乏知识。",{"a":1,"w":[8213,41056,150887]}],["步步登高","bùbù dēnggāo","登升。一步步地升高。多形容仕途顺利，职位不断高升。",{"a":1,"w":[19324,28573]}],["才轻德薄","cáiqīngdébó","才识疏浅，德行不高。常用作自谦之词。同才疏德薄”。",{"a":1,"w":[603,595,7416,2319]}],["材德兼备","cái dé jiānbèi","材通才”。既有工作的才干和能力，又有好的思想品质。",{"a":1,"w":[7585,7416,70610]}],["不失圭撮","bùshīguīcuō","圭撮容量词，六栗为一圭，十圭为一撮。形容数量准确。",{"a":1,"w":[16621,171867]}],["不次之迁","bùcìzhīqiān","次顺序，等第；迁官位升迁。比喻超出常规的提升官级。",{"a":1,"w":[54553,2254,8003]}],["博识多通","bóshíduōtōng","博广博。识学识。通精通事理。指学识广博，精通事理。",{"a":1,"w":[74691,21,518]}],["兵未血刃","bīngwèixuèrèn","犹兵不血刃。指战事顺利，未经交锋或激战而取得胜利。",{"a":1,"w":[2282,7559,135319]}],["秉要执本","bǐngyàozhíběn","秉执，拿着；要重要的；本根本。指抓住要害和根本、。",{"a":1,"w":[9534,229951,42]}],["变色易容","biànsè yì róng","变、易改变。色、容脸色、表情。形容惊惶失措的神情。",{"a":1,"w":[10821,577535]}],["鄙俚浅陋","bǐlǐqiǎnlòu","鄙俚粗俗；浅陋见闻不多。多形容文章或言谈粗俗浅薄。",{"a":1,"w":[212738,224387]}],["弊衣蔬食","bìyīshūshí","破旧的衣服和粗粝的饭食。指生活俭朴。同弊衣箪食”。",{"a":1,"w":[8552,7536,92609]}],["弊帚自珍","bì zhǒu zìzhēn","对自家的破旧扫帚，也看作很珍贵。比喻对己物的珍视。",{"a":1,"w":[8552,11203,67770]}],["杯酒解怨","bēijiǔjiěyuàn","解消除，排解；怨怨恨，怨仇。指饮酒言欢，消解仇怨。",{"a":1,"w":[20554,186117]}],["悲