诸","xīzhū","亦称“悉老”。\n传说为神农之师。",{"a":1,"w":[8908,7881]}],["惸孤","qiónggū","1) 孤独。\n2) 指孤独的人。",{"a":1,"w":[27513,7996]}],["忧属","yōushǔ","亦作“忧瞩”。\n忧国忧民的属望。",{"a":1,"w":[8112,1268]}],["忧服","yōufú","谓因父母死而居忧服丧。亦指丧服。",{"a":1,"w":[8112,4619]}],["成荆","chéngjīng","亦称“成庆”。\n春秋齐国的勇士。",{"a":1,"w":[517,8436]}],["戒监","jièjiān","亦作“戒鉴”。\n警戒；引以为戒。",{"a":1,"w":[3377,7644]}],["排阖","páihé","1) 推开门扇。\n2) 犹捭阖。",{"a":1,"w":[567,10220]}],["援噬","yuánshì","亦作“援簭”。\n谓捕执而咬食之。",{"a":1,"w":[7930,9283]}],["改席","gǎixí","改换座席。对客人表示尊敬的举动。",{"a":1,"w":[620,7836]}],["故弊","gùbì","1) 破旧。\n2) 指破旧之物。",{"a":1,"w":[7486,8552]}],["故然","gùrán","1) 因此。\n2) 本然；必然。",{"a":1,"w":[7486,7451]}],["效官","xiàoguān","1) 授官。\n2) 引申指做官。",{"a":1,"w":[7590,2293]}],["敏劭","mǐnshào","亦作“敏卲”。\n谓才识敏捷美善。",{"a":1,"w":[7965,19513]}],["新清","xīnqīng","1) 犹清新。\n2) 新鲜清爽。",{"a":1,"w":[80,4617]}],["昌仆","chāngpū","人名。相传为昌意之妃，颛顼之母。",{"a":1,"w":[8186,9072]}],["明诫","míngjiè","亦作“明戒”。\n明白告诫；明训。",{"a":1,"w":[7431,11479]}],["春至","chūnzhì","1) 即春分。\n2) 春天来到。",{"a":1,"w":[1378,3346]}],["春酝","chūnyùn","1) 春季酿造。\n2) 指春酒。",{"a":1,"w":[1378,15119]}],["景望","jǐngwàng","1) 崇高的声望。\n2) 仰慕。",{"a":1,"w":[4676,7556]}],["晓妆","xiǎozhuāng","1) 晨妆。\n2) 指晨起梳妆。",{"a":1,"w":[8614,8268]}],["月堂","yuètáng","唐李林甫堂名。因形如偃月，故名。",{"a":1,"w":[101,7695]}],["朔途","shuòtú","亦作“朔涂”。\n谓前往北方之路。",{"a":1,"w":[8952,8207]}],["朝沆","cháohàng","早晨的沆瀣。传说为神仙服食之物。",{"a":1,"w":[1357,18871]}],["朱三","zhūsān","五代后梁太祖朱温排行第三，故称。",{"a":1,"w":[7906,74]}],["柘袍","zhèpáo","1) 柘黄袍。\n2) 借指皇帝。",{"a":1,"w":[11895,9451]}],["柯舒","kēshū","亦称“柯欘”。\n古代的一种兵器。",{"a":1,"w":[8119,7870]}],["柳烟","liǔyān","柳树枝叶茂密似笼烟雾，因以为称。",{"a":1,"w":[7802,1376]}],["桲椤","poluó","亦作“桲罗”。\n木名。叶可饲蚕。",{"a":1,"w":[40845,15143]}],["梢芟","shāoshān","指树枝、芦荻之类的防汛护堤材料。",{"a":1,"w":[4867,13895]}],["植杖","zhízhàng","1) 倚杖。扶杖。\n2) 立杖。",{"a":1,"w":[7717,8427]}],["橘林","júlín","1) 古蜀名园。\n2) 橘树林。",{"a":1,"w":[8816,7469]}],["毁车","huǐchē","谓放弃战车(改编为步卒的行列)。",{"a":1,"w":[4749,32]}],["毒痛","dútòng","1) 痛楚；苦痛。\n2) 荼毒。",{"a":1,"w":[3322,1417]}],["毒痡","dúfū","1) 毒害，残害。\n2) 痛苦。",{"a":1,"w":[3322,78786]}],["氛浊","fēnzhuó","1) 尘浊之气。\n2) 喻弊端。",{"a":1,"w":[9649,8559]}],["汁防","zhīfáng","汉代侯国名。在今四川省什邡县境。",{"a":1,"w":[8420,1302]}],["沓障","dázhàng","亦作“沓嶂”。\n重重叠叠的山峰。",{"a":1,"w":[9669,7656]}],["沸涌","fèiyǒng","1) 水翻腾貌。\n2) 指喷泉。",{"a":1,"w":[8686,8855]}],["洄旋","huíxuán","亦作“洄漩”。\n水流回旋，盘旋。",{"a":1,"w":[14968,7532]}],["浅谬","qiǎnmiù","亦作“浅缪”。\n谓肤浅而多谬误。",{"a":1,"w":[2400,8720]}],["清霄","qīngxiāo","1) 天空。\n2) 指空中浮云。",{"a":1,"w":[4617,9823]}],["渚牙","zhǔyá","亦作“渚芽”。\n洲上初生的草芽。",{"a":1,"w":[13440,2308]}],["涡口","wōkǒu","涡水入淮处。在安徽省怀远县东北。",{"a":1,"w":[8189,47]}],["涤秽","díhuì","涤除污秽。多比喻清除谬误、邪恶。",{"a":1,"w":[9127,9258]}],["汉官","hànguān","指古代少数民族王朝中的汉人官吏。",{"a":1,"w":[7539,2293]}],["炊米","chuīmǐ","1) 煮饭。\n2) 煮饭用的米。",{"a":1,"w":[10402,557]}],["乌啼","wūtí","指琴曲《乌夜啼引》或《乌啼引》。",{"a":1,"w":[7520,10453]}],["烹炼","pēngliàn","1) 冶炼。\n2) 提炼、锤炼。",{"a":1,"w":[9115,8149]}],["无廖","wúliào","亦作“无戮”。\n不努力，不尽力。",{"a":1,"w":[2255,9456]}],["无朕","wúzhèn","亦作“无眹”。\n没有迹象或先兆。",{"a":1,"w":[2255,14542]}],["无觉","wújué","1) 未睡醒。\n2) 没有知觉。",{"a":1,"w":[2255,4665]}],["燔瘗","fányì","1) 祭祀天地。\n2) 指祭品。",{"a":1,"w":[13939,14440]}],["营众","yíngzhòng","1) 惑众。\n2) 指营内官兵。",{"a":1,"w":[7572,7688]}],["独贤","dúxián","1) 谓独劳。\n2) 特别贤良。",{"a":1,"w":[7561,8050]}],["玄址","xuánzhǐ","亦作“玄沚”。\n水中的小块陆地。",{"a":1,"w":[7911,9006]}],["玉押","yùyā","亦作“玉柙”。\n门帘的玉饰镇坠。",{"a":1,"w":[2294,8081]}],["王极","wángjí","皇极。指天子据以治国的大中之道。",{"a":1,"w":[2278,1303]}],["瑕摘","xiázhāi","亦作“瑕擿”。\n犹瑕适。指过失。",{"a":1,"w":[9428,3511]}],["璧采","bìcǎi","亦作“璧彩”。\n比喻月光，月色。",{"a":1,"w":[8965,7528]}],["环句","huánjù","亦作“环钩”。\n环与环相勾联貌。",{"a":1,"w":[1320,646]}],["玺册","xǐcè","亦作“玺策”。\n玉玺和册命文书。",{"a":1,"w":[11285,3413]}],["画圈","huàquān","在文件上画个圈儿，表示已经过目。",{"a":1,"w":[625,2325]}],["疏勺","shūsháo","古代柄上刻有饰纹的舀酒浆的器具。",{"a":1,"w":[7743,4956]}],["疑谬","yímiù","亦作“疑缪”。\n可疑和谬误之处。",{"a":1,"w":[8055,8720]}],["痞隔","pǐgé","亦作“痞鬲”。\n郁结，阻滞不通。",{"a":1,"w":[14849,2332]}],["百仞","bǎirèn","八尺为仞。百仞，形容极深或极高。",{"a":1,"w":[133,17608]}],["百能","bǎinéng","各种才能。借指具有各种才能的人。",{"a":1,"w":[133,41]}],["荡摩","dàngmó","亦作“荡磨”。\n谓相切摩而变化。",{"a":1,"w":[7756,7669]}],["直辟","zhípì","亦作“直劈”。\n谓固执，不随和。",{"a":1,"w":[1294,8072]}],["相禅","xiāngchán","亦作“相嬗”。\n相演变；相转化。",{"a":1,"w":[7427,8805]}],["瞑坐","míngzuò","I\n闭目静坐。\nII\n坐着小睡。",{"a":1,"w":[13420,128]}],["石局","shíjú","1) 石棋盘。\n2) 元代官名。",{"a":1,"w":[7419,2291]}],["硗聱","qiāo'áo","亦作“硗磝”。\n多石，高低不平。",{"a":1,"w":[16246,23469]}],["禄算","lùsuàn","宿命论者所谓人生注定的福禄气数。",{"a":1,"w":[8602,573]}],["穴壁","xuébì","1) 凿墙洞。\n2) 借指窃贼。",{"a":1,"w":[8147,7850]}],["空耗","kōnghào","1) 空虚；匮乏。\n2) 白费。",{"a":1,"w":[1274,7916]}],["窃訾","qièzī","亦作“窃赀”。\n占有别人的资财。",{"a":1,"w":[8296,9517]}],["章蔀","zhāngbù","亦作“章部”。\n我国古历法名词。",{"a":1,"w":[4661,28533]}],["竦身","sǒngshēn","耸身，纵身向上跳。竦，通“耸”。",{"a":1,"w":[10593,7456]}],["笔债","bǐzhài","指应人约请而尚未完成的文墨之事。",{"a":1,"w":[619,4698]}],["箕服","jīfú","亦作“箕箙”。\n箕木做成的箭袋。",{"a":1,"w":[8764,4619]}],["简恤","jiǎnxù","亦作“简恤”。\n谓考察而体恤之。",{"a":1,"w":[7804,8783]}],["精精","jīngjīng","1) 兽名。\n2) 指精明的人。",{"a":1,"w":[4629]}],["结毦","jié'ěr","亦作“结氂”。\n用羽毛编织饰物。",{"a":1,"w":[2271,40323]}],["絣扒","bēngbā","剥去衣服捆绑起来。絣，通“绷”。",{"a":1,"w":[40309,4803]}],["绿縢","lǜténg","古代弓上的绿色绳索，用作装饰品。",{"a":1,"w":[605,22536]}],["纶诰","lúngào","亦作“纶告”。\n皇帝的诏令文告。",{"a":1,"w":[9177,13565]}],["绮宴","qǐyàn","亦作“绮燕”。\n华美丰盛的筵宴。",{"a":1,"w":[9776,8323]}],["绣褓","xiùbǎo","亦作“绣葆”。\n覆裹婴儿的绣被。",{"a":1,"w":[4793,18948]}],["置楬","zhìjié","树立木桩。多用于墓前，以作标志。",{"a":1,"w":[7529,20569]}],["翠樽","cuìzūn","亦作“翠尊”。\n饰以绿玉的酒器。",{"a":1,"w":[7928,10450]}],["翠滑","cuìhuá","色黑而润泽。多用以形容女人头发。",{"a":1,"w":[7928,3334]}],["翠芽","cuìyá","亦作“翠牙”。\n植物初生的绿芽。",{"a":1,"w":[7928,8245]}],["聆风","língfēng","1) 闻风。\n2) 箘竹的别名。",{"a":1,"w":[12682,44]}],["肆情","sìqíng","1) 犹纵欲。\n2) 放荡情怀。",{"a":1,"w":[8346,7490]}],["胡苑","húyuàn","胡人牧养禽兽的苑囿。指胡人地域。",{"a":1,"w":[7554,9274]}],["脱巾","tuōjīn","脱下头巾，改戴官帽。指开始入仕。",{"a":1,"w":[2312,8285]}],["腿绷","tuǐbēng","亦作“腿絣”。\n绑腿一类的用品。",{"a":1,"w":[660,8678]}],["肤辞","fūcí","亦作“肤词”。\n肤浅空泛的言辞。",{"a":1,"w":[8232,7757]}],["腊面","làmiàn","明时宫中于十二月初八日赐食之面。",{"a":1,"w":[8052,523]}],["卧鼓","wògǔ","息鼓。常示无战争，或战事已息止。",{"a":1,"w":[7997,3352]}],["舍中","shězhōng","1) 犹家中。\n2) 指家中人。",{"a":1,"w":[7531,7]}],["苛留","kēliú","I\n极力挽留。\nII\n盘问扣留。",{"a":1,"w":[9302,590]}],["英蕤","yīngruí","1) 艳丽的花。\n2) 犹英华。",{"a":1,"w":[7637,14150]}],["茫蛮","mángmán","亦作“茫诏”。\n古代西南部族名。",{"a":1,"w":[9918,8711]}],["兹非","zīfēi","春秋楚国剑士。后世借指勇力武士。",{"a":1,"w":[7575,2265]}],["莫得","mòdé","1) 不得；休要。\n2) 没有。",{"a":1,"w":[7446,520]}],["蔓辞","màncí","亦作“蔓词”。\n芜杂繁冗的言辞。",{"a":1,"w":[8562,7757]}],["蕃畿","fānjī","古代指最远的地方。蕃，通“藩”。",{"a":1,"w":[9068,11313]}],["蛆蟝","qūqú","亦作“蛆渠”。\n即马蚿。百足虫。",{"a":1,"w":[15470]}],["蠲酲","juānchéng","消除酒病。酲，酒醉醒后困乏如病。",{"a":1,"w":[11113,40346]}],["褒录","bāolù","1) 奖进录用。\n2) 犹褒述。",{"a":1,"w":[9914,1380]}],["西倾","xīqīng","1) 向西倾斜。\n2) 喻年老。",{"a":1,"w":[51,7714]}],["誓盟","shìméng","I\n立誓订盟。\nII\n立誓订盟。",{"a":1,"w":[8615,7953]}],["语难","yǔnán","谓因愤激而出语艰涩，说话不流利。",{"a":1,"w":[7447,117]}],["诚素","chéngsù","亦作“诚愫”。\n情愫；真情实意。",{"a":1,"w":[8307,7468]}],["请会","qǐnghuì","一种邀请他人参加的小型贷款形式。",{"a":1,"w":[160,18]}],["谖浮","xuānfú","指喧嚣轻佻的风气。谖，通“諠”。",{"a":1,"w":[20450,4670]}],["谗箭","chánjiàn","谗言。谗言如箭矢一样伤人，故称。",{"a":1,"w":[10546,4666]}],["谶术","chènshù","古代巫师、方士等预卜未来的法术。",{"a":1,"w":[17142,7471]}],["贡砚","gòngyàn","亦作“贡研”。\n充作贡品的砚台。",{"a":1,"w":[8007,10108]}],["赐则","cìzé","指给未成诸侯国的子、男赐以土地。",{"a":1,"w":[8737,3323]}],["贤合","xiánhé","亦作“贤阁”。\n对人妻子的尊称。",{"a":1,"w":[8050,1269]}],["卖佣","màiyōng","亦作“卖庸”。\n出卖劳力作佣工。",{"a":1,"w":[634,9002]}],["超殊","chāoshū","1) 犹迵异。\n2) 卓越特异。",{"a":1,"w":[4633,8031]}],["路脚","lùjiǎo","1) 路的尽头。\n2) 指路边。",{"a":1,"w":[54,602]}],["踏节","tàjié","亦作“蹋节”。\n以脚踏地打节拍。",{"a":1,"w":[4781,540]}],["軥辀","qúzhōu","亦作“軥輖”。\n象声词。鸟鸣声。",{"a":1,"w":[58428,37367]}],["辅正","fǔzhèng","1) 辅佐匡正。\n2) 犹校正。",{"a":1,"w":[7940,62]}],["辍食","chuòshí","停止饭食。多形容哀伤或发愤之情。",{"a":1,"w":[11843,7466]}],["迷澌","mísī","亦作“迷厮”。\n谓神思恍惚散乱。",{"a":1,"w":[1384,35568]}],["逆政","nìzhèng","1) 乱政。\n2) 指败坏政治。",{"a":1,"w":[7762,7478]}],["逞辞","chěngcí","亦作“逞词”。\n放言；恣纵词章。",{"a":1,"w":[9682,7757]}],["连阁","liángé","1) 连延的楼阁。\n2) 满阁。",{"a":1,"w":[1288,8208]}],["过都","guòdōu","明时豪强地主瞒田逃税的一种方法。",{"a":1,"w":[25,130]}],["遵途","zūntú","亦作“遵涂”。\n谓遵循道路前进。",{"a":1,"w":[8941,8207]}],["辽绕","liáorào","亦作“辽遶”。\n缭绕，回环旋转。",{"a":1,"w":[9022,3443]}],["边信","biānxìn","1) 偏信。\n2) 边地的书信。",{"a":1,"w":[553,529]}],["郡合","jùnhé","亦作“郡阁”。\n借指郡守的府院。",{"a":1,"w":[9030,1269]}],["酒藏","jiǔcáng","旧时专门为朝廷酿造和藏酒的机构。",{"a":1,"w":[594,4688]}],["重姓","zhòngxìng","I\n犹大姓。\nII\n复姓，双姓。",{"a":1,"w":[49,719]}],["野享","yěxiǎng","亦作“野飨”。\n在野外设食款待。",{"a":1,"w":[4626,8182]}],["钝闻","dùnwén","亦作“钝闵”。\n昏昧，不明事理。",{"a":1,"w":[8549,629]}],["闪朒","shǎnnǜ","亦作“闪肭”。\n扭伤筋络或肌肉。",{"a":1,"w":[2357,26323]}],["开谕","kāiyù","亦作“开喻”。\n启发解说；劝告。",{"a":1,"w":[31,9439]}],["阪险","bǎnxiǎn","1) 斜坡与山泽。\n2) 险峻。",{"a":1,"w":[12828,4634]}],["陋圃","lòupǔ","狭小的园圃。借指浅狭简陋的居处。",{"a":1,"w":[9064,13245]}],["阴渠","yīnqú","1) 山北的沟渠。\n2) 暗渠。",{"a":1,"w":[576,8761]}],["隐鳞","yǐnlín","神龙隐匿其鳞。比喻贤者待时而动。",{"a":1,"w":[7652,7924]}],["雀罗","quèluó","捕雀的网罗。常用以形容门庭冷落。",{"a":1,"w":[7583,7420]}],["雉兔","zhìtù","野鸡和兔子。亦指猎取野鸡和兔子。",{"a":1,"w":[9135,3426]}],["雪足","xuězú","1) 赤着的脚。\n2) 赤着脚。",{"a":1,"w":[616,4625]}],["云旓","yúnshāo","亦作“云梢”。\n绘有云彩的旌旗。",{"a":1,"w":[554,143907]}],["云矗","yúnchù","1) 耸立的云。\n2) 高耸貌。",{"a":1,"w":[554,18765]}],["霞岭","xiálǐng","高山峻岭。出家修道者的隐居场所。",{"a":1,"w":[4805,8515]}],["雾勃","wùbó","亦作“雾渤”。\n雾气蓬勃蒸腾貌。",{"a":1,"w":[3421,8180]}],["青辉","qīnghuī","亦作“青晖”。\n幽暗惨淡的光线。",{"a":1,"w":[3320,8317]}],["飞钳","fēiqián","亦作“飞箝”。\n辩论的一种方法。",{"a":1,"w":[56,8489]}],["骇鹿","hàilù","1) 受惊的鹿。\n2) 犹逐鹿。",{"a":1,"w":[9473,8199]}],["魁秀","kuíxiù","1) 壮美。\n2) 指杰出人才。",{"a":1,"w":[8560,8040]}],["鸿炉","hónglú","1) 大火炉。\n2) 比喻天地。",{"a":1,"w":[8788,7902]}],["鹄苍","gǔcāng","亦作“鹄仓”。\n传说中的神犬名。",{"a":1,"w":[10801,8328]}]]