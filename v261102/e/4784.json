ū","道家谓清虚无虑的得道境界。",{"a":1,"w":[7665,7779]}],["凝锦","níngjǐn","集成锦绣。比喻华美的文章。",{"a":1,"w":[7665,7982]}],["出丁","chūdīng","抽出成年男子服劳役或兵役。",{"a":1,"w":[22,4646]}],["刀敕","dāochì","捉刀应敕的省称。借指权臣。",{"a":1,"w":[1369,9734]}],["刁酒","diāojiǔ","古代的一种名酒。亦指佳酿。",{"a":1,"w":[10265,594]}],["分宥","fēnyòu","谓区别主犯从犯，宽贷从犯。",{"a":1,"w":[15,10669]}],["分诉","fēnsù","1) 辩解。\n2) 诉说。",{"a":1,"w":[15,7817]}],["切象","qièxiàng","谓取象以作比喻。切，割取。",{"a":1,"w":[2276,7500]}],["刑宪","xíngxiàn","1) 刑法。\n2) 刑罚。",{"a":1,"w":[7716,8343]}],["列光","lièguāng","强烈的阳光。列，通“烈”。",{"a":1,"w":[2268,1271]}],["别辨","biébiàn","1) 变异。\n2) 辨别。",{"a":1,"w":[69,8004]}],["刳磔","kūzhé","古代酷刑。剖腹并分解肢体。",{"a":1,"w":[18288,13985]}],["制杖","zhìzhàng","1) 哀杖。\n2) 刑杖。",{"a":1,"w":[7413,8427]}],["刺涅","cìniè","在面部刺字涂墨，以为标记。",{"a":1,"w":[2300,7856]}],["刺篷","cìpéng","泛称丛聚而生的有刺的植物。",{"a":1,"w":[2300,9193]}],["刻漆","kèqī","谓割开漆树皮，使漆液流出。",{"a":1,"w":[626,8224]}],["前侯","qiánhóu","车辕的颈部。参见“前疾”。",{"a":1,"w":[60,8170]}],["前武","qiánwǔ","前人的足迹。喻前人的典范。",{"a":1,"w":[60,7504]}],["前軓","qiánfàn","车辕的颈部。参见“前疾”。",{"a":1,"w":[60,200191]}],["剖觚","pōugū","谓书写，写定。觚，指木简。",{"a":1,"w":[8592,13403]}],["刚獝","gāngxù","猛烈地飞扑上去。獝，惊飞。",{"a":1,"w":[636,49289]}],["剥异","bōyì","谓辩难立异。剥，通“驳”。",{"a":1,"w":[8572,7464]}],["剡章","shànzhāng","削牍写成奏章。泛指写奏章。",{"a":1,"w":[13738,4661]}],["剪定","jiǎndìng","1) 犹平定。\n2) 剪枝",{"a":1,"w":[3419,2259]}],["铲地","chǎndì","1) 反而。\n2) 怎的。",{"a":1,"w":[8837,10]}],["剽夺","piāoduó","1) 掳掠。\n2) 抄袭。",{"a":1,"w":[11247,4759]}],["剿办","jiǎobàn","谓使用武力镇压，从严惩办。",{"a":1,"w":[10677,610]}],["剧吏","jùlì","官府中处理烦剧事务的属吏。",{"a":1,"w":[4703,8898]}],["劖刻","chánkè","1) 刻凿。\n2) 峭拔。",{"a":1,"w":[56630,626]}],["劘垒","mólěi","逼近敌人的营垒。亦指战事。",{"a":1,"w":[28890,8785]}],["劣丈","lièzhàng","犹愚丈。世交长辈自谦之称。",{"a":1,"w":[8543,8472]}],["劫叛","jiépàn","谓部下将士劫持主将而叛变。",{"a":1,"w":[8458,8958]}],["勃缪","bómóu","乖谬，谬误。勃，通“悖”。",{"a":1,"w":[8180,9670]}],["勖帅","xùshuài","亦作“勖帅”。\n勉力遵循。",{"a":1,"w":[22524,2452]}],["劳尊","láozūn","表示客气的敬词。犹言劳驾。",{"a":1,"w":[7526,7922]}],["势援","shìyuán","犹后盾。势，也写作“埶”。",{"a":1