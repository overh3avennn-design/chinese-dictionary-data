582]}],["俞俞","yúyú","和乐愉快貌。俞，通“愉”。",{"a":1,"w":[15172]}],["侠介","xiájiè","在左右辅助。侠，通“夹”。",{"a":1,"w":[9611,7715]}],["信官","xìnguān","官员祷神时表示虔诚的自称。",{"a":1,"w":[529,2293]}],["修意","xiūyì","修正心志意念，谓内省自责。",{"a":1,"w":[1339,7482]}],["修染","xiūrǎn","犹修书写信。染，染翰作书。",{"a":1,"w":[1339,3355]}],["修谒","xiūyè","进见(地位或辈分高的人)。",{"a":1,"w":[1339,9577]}],["俵着","biàozhe","表彰，显扬。俵，通“表”。",{"a":1,"w":[26538,57]}],["倍招","bèizhāo","招致背叛者。倍，通“背”。",{"a":1,"w":[2381,4704]}],["倒寿","dàoshòu","古代神话传说中的一种怪兽。",{"a":1,"w":[583,7921]}],["倒屦","dàojù","把鞋子穿倒，形容急于出迎。",{"a":1,"w":[583,10982]}],["倔聱","jué'áo","指文体古奥奇特，佶屈聱牙。",{"a":1,"w":[14631,23469]}],["候迎","hòuyíng","迎候；到某一地方等候迎接。",{"a":1,"w":[7622,8235]}],["候马","hòumǎ","指担任侦察巡逻任务的骑兵。",{"a":1,"w":[7622,1273]}],["借径","jièjìng","谓依靠他人传递情况或意见。",{"a":1,"w":[650,7769]}],["借麾","jièhuī","旧指大臣自请出任州郡长官。",{"a":1,"w":[650,12053]}],["倦局","juànjú","拳曲；蜷曲。倦，通“蜷”。",{"a":1,"w":[9370,2291]}],["倩枪","qiànqiāng","旧谓请同考者暗中代答试卷。",{"a":1,"w":[14226,3338]}],["倳耜","zìsì","将耜插入地中。指翻耕土地。",{"a":1,"w":[151599,25320]}],["偃节","yǎnjié","放下符节。指完成使命归来。",{"a":1,"w":[9432,540]}],["假似","jiǎshì","1) 如果。\n2) 譬如。",{"a":1,"w":[562,7803]}],["假喘","jiǎchuǎn","短暂的喘息。谓不久于人世。",{"a":1,"w":[562,9101]}],["偎亵","wēixiè","淫乱；下流。偎，通“猥”。",{"a":1,"w":[14479,10213]}],["偏侍","piānshì","谓双亲一方去世，一方尚在。",{"a":1,"w":[4648,8870]}],["偏敬","piānjìng","谓尊敬得过分，超越了礼制。",{"a":1,"w":[4648,8118]}],["偏滥","piānlàn","偏颇失检，谓措词浮泛不当。",{"a":1,"w":[4648,8319]}],["偏论","piānlùn","偏颇的议论；不公允的言论。",{"a":1,"w":[4648,7480]}],["做品","zuòpǐn","1) 作风。\n2) 作品。",{"a":1,"w":[150,3321]}],["停午","tíngwǔ","正午；中午。停，通“亭”。",{"a":1,"w":[624,8095]}],["停毒","tíngdú","化育；养育。停，通“亭”。",{"a":1,"w":[624,3322]}],["停腾","tíngténg","1) 停当。\n2) 调理。",{"a":1,"w":[624,7985]}],["偟遽","huángjù","恐慌不安貌。偟，通“惶”。",{"a":1,"w":[50077,9754]}],["健舌","jiànshé","雄健之舌。借指雄辩的口才。",{"a":1,"w":[8022,7844]}],["侧想","cèxiǎng","思念；推想。对人自谦之词。",{"a":1,"w":[4672,156]}],["侦卒","zhēnzú","刺探机密或侦查案件的人员。",{"a":1,"w":[8691,8446]}],["伧歌","cānggē","指南北朝时期北地乐府民歌。",{"a":1,"w":[21665,208]}],["传席","chuánxí","旧时婚俗中新妇