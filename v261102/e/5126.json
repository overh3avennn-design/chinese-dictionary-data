入墓穴。",{"a":1,"w":[3514,2294]}],["赠赗","zèngfèng","赠送车马等以助人送葬。",{"a":1,"w":[3514,91392]}],["赠馈","zèngkuì","赠送。亦指赠送的财物。",{"a":1,"w":[3514,8692]}],["赡缛","shànrù","形容诗文词采丰丽繁密。",{"a":1,"w":[10095,19177]}],["赡辨","shànbiàn","犹雄辩。辨，通“辩”。",{"a":1,"w":[10095,8004]}],["赡速","shànsù","谓语汇丰富，文思敏捷。",{"a":1,"w":[10095,7497]}],["赢博","yíngbó","春秋时齐国的两个邑名。",{"a":1,"w":[1524,7502]}],["赢朒","yíngnǜ","犹言赢缩，赢余与不足。",{"a":1,"w":[1524,26323]}],["赢虚","yíngxū","充实和空虚。犹言虚实。",{"a":1,"w":[1524,7779]}],["赃械","zāngxiè","指盗贼用来作案的器械。",{"a":1,"w":[10133,7801]}],["赎取","shúqǔ","用钱物或其他代价换取。",{"a":1,"w":[9457,580]}],["赎国","shúguó","谓付出代价，拯救国家。",{"a":1,"w":[9457,23]}],["赤冀","chìjì","古代传说中臼的发明者。",{"a":1,"w":[7766,10582]}],["赤岭","chìlǐng","山名。在今青海西宁西。",{"a":1,"w":[7766,8515]}],["赤晴","chìqíng","指没有一点云翳的晴空。",{"a":1,"w":[7766,769]}],["赤兽","chìshòu","指兽炭，一种兽形的炭。",{"a":1,"w":[7766,8325]}],["赤豹","chìbào","毛赤而有黑色斑纹的豹。",{"a":1,"w":[7766,8732]}],["赤轩","chìxuān","古代帝王殿堂前的平台。",{"a":1,"w":[7766,8869]}],["赤钟","chìzhōng","相传黄帝所作五钟之一。",{"a":1,"w":[7766,1410]}],["赪肩","chēngjiān","肩头因负担重物而发红。",{"a":1,"w":[22005,3459]}],["走野","zǒuyě","指搞不正当的男女关系。",{"a":1,"w":[107,4626]}],["趁笔","chènbǐ","谓不假思索地随意书写。",{"a":1,"w":[3570,619]}],["趁体","chèntǐ","犹合身。趁，通“称”。",{"a":1,"w":[3570,7417]}],["超物","chāowù","谓离尘脱俗，超然物外。",{"a":1,"w":[4633,7412]}],["超阔","chāokuò","指才气过人，胸襟开阔。",{"a":1,"w":[4633,4766]}],["越局","yuèjú","谓超越自己职掌的部分。",{"a":1,"w":[597,2291]}],["越翳","yuèyì","即伯益。佐禹治水有功。",{"a":1,"w":[597,9715]}],["越豨","yuèxī","汉代彭越和陈豨的并称。",{"a":1,"w":[597,23588]}],["越貊","yuèmò","古代对南方土著的蔑称。",{"a":1,"w":[597,20982]}],["赶络","gǎnluò","连续不断地驱使、逼迫。",{"a":1,"w":[1440,7837]}],["赵书","zhàoshū","指元赵孟頫的书法作品。",{"a":1,"w":[8536,81]}],["赵面","zhàomiàn","赵(赵孟頫)字的外貌。",{"a":1,"w":[8536,523]}],["趋朝","qūcháo","亦作“趍朝”。\n上朝。",{"a":1,"w":[8388,1357]}],["趫揵","qiáoqián","指矫健而善于攀高的人。",{"a":1,"w":[17809,26549]}],["趴蛋","pādàn","方言。躺倒；不能动弹。",{"a":1,"w":[5087,628]}],["跂耸","qísǒng","踮脚举首。喻敬仰向往。",{"a":1,"w":[15287,5040]}],["跋识","báshí","跋文、印记、题署之类。",{"a":1,"w":[9818,4658]}],["跌钱","diēqián","掷钱以卜吉凶、赌输赢。",{"a":1,"w":[4818,138]}],["跐踦","cīyǐ","参差不齐。意谓不配对。",{"a":1,"w":[16529,19820]}],["跛立","bǒlì","站立时重心偏在一足上。",{"a":1,"w":[11946,3314]}],["跨缝","kuàfèng","指袍子下身两侧的开叉。",{"a":1,"w":[4710,7859]}],["跨边","kuàbiān","谓兼有边境两方的籍贯。",{"a":1,"w":[4710,553]}],["跪灵","guìlíng","跪伏在灵位或灵柩前面。",{"a":1,"w":[4980,7588]}],["跲疐","jiázhì","倾跌。引申为颠沛困顿。",{"a":1,"w":[146913,21644]}],["跳蹼","tiàopǔ","跳扑。蹼，用同“扑”。",{"a":1,"w":[1404,26668]}],["踏冻","tàdòng","踏着冰冻。谓冒着严寒。",{"a":1,"w":[4781,3397]}],["踏圆","tàyuán","亦作“蹋圆”。\n踏球。",{"a":1,"w":[4781,2301]}],["踏硬","tàyìng","谓用脚踩踏硬弩而发箭。",{"a":1,"w":[4781,3339]}],["踏莎","tàshā","《踏莎行》词牌的省称。",{"a":1,"w":[4781,8622]}],["踝体","huáitǐ","裸体。踝，用同“裸”。",{"a":1,"w":[14261,7417]}],["踧口","cùkǒu","犹合口。踧，通“蹙”。",{"a":1,"w":[34207,47]}],["踩捕","cǎibǔ","亦作“跴捕”。\n追捕。",{"a":1,"w":[3567,4778]}],["踊溢","yǒngyì","亦作“踊溢”。\n腾跃。",{"a":1,"w":[11141,8852]}],["踊甓","yǒngpì","亦作“踊甓”。\n指塔。",{"a":1,"w":[11141,50574]}],["踊发","yǒngfā","亦作“踊发”。\n迸发。",{"a":1,"w":[11141,522]}],["踊距","yǒngjù","亦作“踊距”。\n跳跃。",{"a":1,"w":[11141,7632]}],["踊跳","yǒngtiào","亦作“踊跳”。\n跳跃。",{"a":1,"w":[11141,1404]}],["踹蹬","chuàidēng","谓脚向脚底的方向用力。",{"a":1,"w":[17872,5380]}],["蹈拾","dǎoshí","谓蹈袭前人，拾人牙慧。",{"a":1,"w":[8509,3494]}],["蹝马","xǐmǎ","戏曲中的跃马扬鞭动作。",{"a":1,"w":[40359,1273]}],["蹩拉","biélā","形容走路扭晃，不方便。",{"a":1,"w":[11322,514]}],["蹴几","cùjǐ","触机。谓以巧遇而得之。",{"a":1,"w":[11681,136]}],["躁盛","zàoshèng","指脉搏的跳动疾速有力。",{"a":1,"w":[9259,4746]}],["跃炉","yuèlú","喻自以为能，急于求用。",{"a":1,"w":[8534,7902]}],["躖","duàn","duàn\n践处，足迹。",{"a":1}],["躝跞","lánlì","践踏辗压。喻欺压伤害。",{"a":1,"w":[32718]}],["躟躟","rángráng","纷乱貌。躟，通“攘”。",{"a":1}],["蹑冻","nièdòng","踏着未融化的冰雪行路。",{"a":1,"w":[11010,3397]}],["蹑潜","nièqián","谓行动隐秘，不露踪迹。",{"a":1,"w":[11010,7748]}],["轨官","guǐguān","古时主掌会计事宜的官。",{"a":1,"w":[7822,2293]}],["军产","jūnchǎn","充军流放者留下的产业。",{"a":1,"w":[7467,7441]}],["军笳","jūnjiā","古代塞北军用的管乐器。",{"a":1,"w":[7467,23726]}],["轩世","xuānshì","指上古黄帝轩辕氏之世。",{"a":1,"w":[8869,7462]}],["轩孙","xuānsūn","黄帝轩辕氏的子孙后代。",{"a":1,"w":[8869,7936]}],["软战","ruǎnzhàn","没配头盔、铠甲的战袍。",{"a":1,"w":[3349,7438]}],["软障","ruǎnzhàng","即幛子。古代用作画轴。",{"a":1,"w":[3349,7656]}],["载牲","zàishēng","谓陈设牺牲，准备祭祀。",{"a":1,"w":[7491,9334]}],["辅颊","fǔjiá","上颔与面颊。泛指面颊。",{"a":1,"w":[7940,9020]}],["轻垢","qīnggòu","佛教语。指犯轻戒之罪。",{"a":1,"w":[595,9205]}],["辍辍","chuòchuò","忧郁貌。辍，通“惙”。",{"a":1,"w":[11843]}],["輠脂","guǒzhī","古代车上润滑用的脂膏。",{"a":1,"w":[34164,7903]}],["輣轧","péngyà","象声词。形容水声宏大。",{"a":1,"w":[71694,8410]}],["辊辊","gǔngǔn","犹混混。形容苟且混世。",{"a":1,"w":[9486]}],["轮索","lúnsuǒ","挂攀在塔顶四周的铁链。",{"a":1,"w":[2280,7470]}],["轮补","lúnbǔ","谓候补官员依次序补缺。",{"a":1,"w":[2280,1363]}],["轮軿","lúnpíng","车轮和车帷。代称车辆。",{"a":1,"w":[2280,36094]}],["舆棺","yúguān","谓载棺以随，以示决死。",{"a":1,"w":[8330,9589]}],["舆童","yútóng","犹舆隶。泛指操贱役者。",{"a":1,"w":[8330,7929]}],["轈车","cháochē","古代军中窥敌的了望车。",{"a":1,"w":[32]}],["转轼","zhuǎnshì","回转车头。谓驾车回返。",{"a":1,"w":[1293,13005]}],["转顾","zhuǎngù","回过头看。喻时间短促。",{"a":1,"w":[1293,4700]}],["转鬻","zhuǎnyù","谓另投别主，卖身为佣。",{"a":1,"w":[1293,11267]}],["轰锽","hōnghuáng","象声词。形容声音响亮。",{"a":1,"w":[8041,31206]}],["辟置","pìzhì","谓征聘人才，置为僚属。",{"a":1,"w":[8072,7529]}],["辟质","pìzhì","即辟积。辟，通“襞”。",{"a":1,"w":[8072,7436]}],["辨变","biànbiàn","犹变换。辨，通“变”。",{"a":1,"w":[8004,539]}],["辩俊","biànjùn","俊辩，雄辩，辩才出众。",{"a":1,"w":[7873,8835]}],["辩敏","biànmǐn","谓能言善辩，才思敏捷。",{"a":1,"w":[7873,7965]}],["辩丽","biànlì","指言辞或文辞华美绮丽。",{"a":1,"w":[7873,7634]}],["辰夜","chényè","犹晨夜。辰，通“晨”。",{"a":1,"w":[8629,631]}],["辰晷","chénguǐ","日月星之光。比喻天子。",{"a":1,"w":[8629,14972]}],["辱举","rǔjǔ","谓违背自然法则而行事。",{"a":1,"w":[8418,606]}],["农社","nóngshè","古代农村中的互助组织。",{"a":1,"w":[7612,3327]}],["迅动","xùndòng","谓心性敏感，容易激动。",{"a":1,"w":[9463,6]}],["近署","jìnshǔ","与帝王接触密切的官署。",{"a":1,"w":[574,8264]}],["近血","jìnxuè","中医指先血后便的病症。",{"a":1,"w":[574,1354]}],["返葬","fǎnzàng","谓死在外地者归葬故乡。",{"a":1,"w":[8365,8823]}],["返袂","fǎnmèi","用衣袖拭泪。形容哭泣。",{"a":1,"w":[8365,15354]}],["返迷","fǎnmí","谓迷途知返，改邪归正。",{"a":1,"w":[8365,1384]}],["迦楠","jiānán","即伽南香。沉香的别名。",{"a":1,"w":[9866,10686]}],["迫戚","pòqī","困厄貌。戚，通“蹙”。",{"a":1,"w":[8059,9077]}],["述咏","shùyǒng","谓以诗歌形式叙述