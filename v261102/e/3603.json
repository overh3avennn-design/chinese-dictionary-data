[["漰渀","pēngbèn","亦作“漰奔”。\n水流猛激貌。",{"a":1,"w":[179454]}],["漱澣","shùhuàn","亦作“漱浣”。\n洗涤；涤除。",{"a":1,"w":[11195,48755]}],["灾屯","zāitún","亦作“灾迍”。\n灾难；祸患。",{"a":1,"w":[3438,8563]}],["灾晦","zāihuì","亦作“灾悔”。\n灾难，晦气。",{"a":1,"w":[3438,9596]}],["为底","wèidǐ","I\n治足茧。\nII\n为什麽。",{"a":1,"w":[550,2290]}],["焉尔","yān'ěr","亦作“焉耳”。\n于是，而已。",{"a":1,"w":[8197,7407]}],["焚逸","fényì","亦作“焚轶”。\n烧毁、散失。",{"a":1,"w":[9179,8116]}],["熛焰","biāoyàn","亦作“熛爓”。\n火焰；光芒。",{"a":1,"w":[17152,8874]}],["营葺","yíngqì","亦作“营缉”。\n修建；修缮。",{"a":1,"w":[7572,16614]}],["牡龠","mǔyuè","亦作“牡钥”。\n门闩；锁钥。",{"a":1,"w":[8408,17493]}],["牡鞠","mǔjū","亦作“牡菊”。\n菊之无子者。",{"a":1,"w":[8408,10161]}],["物直","wùzhí","亦作“物值”。\n物品的价值。",{"a":1,"w":[7412,1294]}],["独惟","dúwéi","亦作“独唯”。\n唯独，只有。",{"a":1,"w":[7561,9009]}],["玄馆","xuánguǎn","幽静的房舍。多指隐士的居处。",{"a":1,"w":[7911,7919]}],["琦魁","qíkuí","亦作“琦傀”。\n非凡；怪异。",{"a":1,"w":[14499,8560]}],["瑰词","guīcí","亦作“瑰辞”。\n瑰丽的文辞。",{"a":1,"w":[9037,596]}],["生华","shēnghuá","I\n开花。\nII\n变得浮薄。",{"a":1,"w":[508,7503]}],["当拦","dānglán","亦作“当阑”。\n拦挡；阻拦。",{"a":1,"w":[552,3529]}],["疲殚","pídān","亦作“疲单”。\n疲劳到极点。",{"a":1,"w":[8586,11893]}],["发撤","fāchè","亦作“发彻”。\n撤除；毁坏。",{"a":1,"w":[522,8665]}],["白棓","báibàng","亦作“白棒”。\n大棍；大杖。",{"a":1,"w":[24,25665]}],["盥手","guànshǒu","洗手。古人常以手洁表示敬重。",{"a":1,"w":[14244,34]}],["相畴","xiāngchóu","亦作“相俦”。\n彼此在一起。",{"a":1,"w":[7427,9184]}],["相陵","xiānglíng","亦作“相凌”。\n谓相互侵扰。",{"a":1,"w":[7427,7966]}],["省净","shěngjìng","亦作“省静”。\n谓文字简洁。",{"a":1,"w":[607,4690]}],["眼证","yǎnzhèng","当场目睹可作证的人；见证人。",{"a":1,"w":[551,1334]}],["众眺","zhòngtiào","周代诸侯朝见周王礼制的一种。",{"a":1,"w":[7688,14851]}],["睽间","kuíjiān","亦作“睽闲”。\n离别；阻隔。",{"a":1,"w":[18305,37]}],["睿鉴","ruìjiàn","亦作“睿监”。\n御览；圣鉴。",{"a":1,"w":[12154,8039]}],["石椁","shíguǒ","亦作“石郭”。\n石制的外棺。",{"a":1,"w":[7419,25016]}],["石矩","shíjǔ","亦作“石距”。\n章鱼的一种。",{"a":1,"w":[7419,8181]}],["石碕","shíqí","亦作“石圻”。\n曲折的石岸。",{"a":1,"w":[7419,53785]}],["砢么","kēme","亦作“砢磨”。\n马虎；卤莽。",{"a":1,"w":[33103,7758]}],["硎谷","xínggǔ","坑谷。相传为秦始皇坑儒之处。",{"a":1,"w":[21265,7701]}],["硕肤","shuòfū","大的美德。亦指德高望重之人。",{"a":1,"w":[9637,8232]}],["祔享","fùxiǎng","亦作“祔飨”。\n奉神主祭献。",{"a":1,"w":[24118,8182]}],["祭醊","jìzhuì","亦作“祭餟”。\n祭酹，祭祀。",{"a":1,"w":[8417,27613]}],["租挈","zūqiè","收田租的约令。挈，通“契”。",{"a":1,"w":[665,12393]}],["秦七","qínqī","北宋词家秦观辈行第七，故称。",{"a":1,"w":[8261,134]}],["程较","chéngjiào","亦作“程校”。\n考核；衡量。",{"a":1,"w":[7453,1436]}],["种智","zhǒngzhì","佛教语。“一切种智”的省称。",{"a":1,"w":[1344,7798]}],["称诩","chēngxǔ","亦作“称栩”。\n夸大；夸耀。",{"a":1,"w":[613,20378]}],["章视","zhāngshì","亦作“章示”。\n明示；诏告。",{"a":1,"w":[4661,7494]}],["竹担","zhúdān","亦作“竹檐”。\n竹制的扁担。",{"a":1,"w":[7655,7969]}],["笭箵","língxīng","渔具的总称。亦指贮鱼的竹笼。",{"a":1,"w":[34859,104578]}],["筐簏","kuānglù","盛物的竹器。方为筐，高为簏。",{"a":1,"w":[5162,28002]}],["算历","suànlì","亦作“算历”。\n算法与历象。",{"a":1,"w":[573,7643]}],["管军","guǎnjūn","统领军事，也指统领军事之官。",{"a":1,"w":[1278,7467]}],["简亢","jiǎnkàng","亦作“简伉”。\n高傲；清高。",{"a":1,"w":[7804,9121]}],["简较","jiǎnjiào","亦作“简校”。\n查核；察看。",{"a":1,"w":[7804,1436]}],["帘外","liánwài","科举考试时，负责监试之官员。",{"a":1,"w":[8925,36]}],["笼纱","lóngshā","即纱笼。用绢纱作外罩的灯笼。",{"a":1,"w":[7956,8800]}],["细书","xìshū","1) 小字。\n2) 写小字。",{"a":1,"w":[2287,81]}],["结轨","jiéguǐ","轨迹交结。形容车辆络绎不绝。",{"a":1,"w":[2271,7822]}],["绵暧","mián'ài","亦作“绵薆”。\n悠久；悠悠。",{"a":1,"w":[8228,12401]}],["繁奢","fánshē","亦作“繁奓”。\n谓繁华奢侈。",{"a":1,"w":[8553,9225]}],["纤堕","xiānduò","亦作“纤惰”。\n细柔无力貌。",{"a":1,"w":[7725,8768]}],["纤柳","xiānliǔ","Salix phaidima",{"a":1,"w":[7725,7802]}],["缺轶","quēyì","亦作“缺逸”。\n散失；遗漏。",{"a":1,"w":[1412,11934]}],["羁轭","jī'è","亦作“羁厄”。\n束缚；控制。",{"a":1,"w":[9726,11288]}],["翾飞","xuānfēi","1) 飞翔。\n2) 指鸟雀。",{"a":1,"w":[30354,56]}],["耐笃","nàidǔ","亦作“耐朵”。\n方言。你们。",{"a":1,"w":[7954,9188]}],["耿命","gěngmìng","明命。多指天帝或帝王的命令。",{"a":1,"w":[11102,4622]}],["耿节","gěngjié","犹亮节。指坚贞而高洁的节操。",{"a":1,"w":[11102,540]}],["耸恿","sǒngyǒng","亦作“耸臾”。\n劝说；怂恿。",{"a":1,"w":[5040,80579]}],["育鞫","yùjū","亦作“育鞠”。\n谓年老穷困。",{"a":1,"w":[7738,10558]}],["胎夭","tāiyāo","指刚出生及尚未出生的小动物。",{"a":1,"w":[8017,9282]}],["胡梨","húlí","亦作“胡离”。\n蜻蜓的一种。",{"a":1,"w":[7554,3632]}],["能迩","néng'ěr","谓能安抚邻国而与之和睦相处。",{"