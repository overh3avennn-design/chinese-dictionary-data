w":[1362,208]}],["午灵","wǔlíng","旧俗守丧之家于中午祭奠亡灵。",{"a":1,"w":[8095,7588]}],["卒贰","zú'èr","辅佐，谓副职。卒，通“倅”。",{"a":1,"w":[8446,10098]}],["协党","xiédǎng","1) 结党。\n2) 指勾结。",{"a":1,"w":[7580,4685]}],["危侧","wēicè","1) 犹偏颇。\n2) 危殆。",{"a":1,"w":[7654,4672]}],["却籍","quèjí","南朝齐对检出的伪冒户籍之称。",{"a":1,"w":[2314,7983]}],["厚奉","hòufèng","厚葬。奉，奉安，指帝后安葬。",{"a":1,"w":[2336,7971]}],["原祖","yuánzǔ","始祖。比喻某种事业的开创者。",{"a":1,"w":[4613,7723]}],["厌诅","yànzǔ","古代迷信，用诅咒使别人遭殃。",{"a":1,"w":[8372,13764]}],["厉翼","lìyì","厉，也写作“励”。奋勉辅佐。",{"a":1,"w":[8111,4645]}],["参驾","cānjià","配有副马的车。参，通“骖”。",{"a":1,"w":[7543,7879]}],["反庸","fǎnyōng","谓车辆于回程揽载私人的货物。",{"a":1,"w":[2260,8352]}],["叔相","shūxiāng","汉初儒者叔孙通，曾为秦博士。",{"a":1,"w":[8654,7427]}],["取勘","qǔkān","1) 审理。\n2) 犹查核。",{"a":1,"w":[580,8682]}],["取成","qǔchéng","1) 媾和。\n2) 谓学成。",{"a":1,"w":[580,517]}],["取济","qǔjì","谓取得资财或某种力量的帮助。",{"a":1,"w":[580,7522]}],["取路","qǔlù","选取经由的道路；上路，登程。",{"a":1,"w":[580,54]}],["取遣","qǔqiǎn","1) 犹取舍。\n2) 遣发。",{"a":1,"w":[580,8864]}],["口兵","kǒubīng","以口为兵器。比喻言语伤害人。",{"a":1,"w":[47,2282]}],["叨长","dāozhǎng","谦称自己年纪较大或辈分较高。",{"a":1,"w":[9519,515]}],["只首","zhǐshǒu","亦作“只手”。诚然; 实在。",{"a":1,"w":[612,2310]}],["台桑","táisāng","地名。传说禹娶涂山氏之女处。",{"a":1,"w":[1306,8026]}],["右哨","yòushào","明成祖时五军营组成部分之一。",{"a":1,"w":[178,4821]}],["司人","sīrén","1) 指更夫。\n2) 神名。",{"a":1,"w":[7476,3]}],["司傅","sīfù","对有技艺的工匠、长工的尊称。",{"a":1,"w":[7476,8760]}],["司册","sīcè","负责征收钱粮赋税。册，黄册。",{"a":1,"w":[7476,3413]}],["司卫","sīwèi","负责保卫。亦指负责保卫的人。",{"a":1,"w":[7476,7546]}],["吁叹","xūtàn","亦作“吁叹”。\n叹息；哀叹。",{"a":1,"w":[9570,8742]}],["吃受","chīshòu","亦作“吃受”。\n承受；忍受。",{"a":1,"w":[108,1324]}],["吃洴","chīpíng","亦作“吃洴”。\n谓凝滞不散。",{"a":1,"w":[108,128586]}],["合伯","hébó","古地名。即合赙。详“合赙”。",{"a":1,"w":[1269,7608]}],["合宴","héyàn","1) 犹会饮。\n2) 酺宴。",{"a":1,"w":[1269,8323]}],["吉喜","jíxǐ","吉祥喜庆。亦指吉祥喜庆之事。",{"a":1,"w":[7582,7727]}],["同辇","tóngniǎn","指与天子同车。辇，天子之车。",{"a":1,"w":[4611,10459]}],["同响","tóngxiǎng","指共鸣者。比喻志趣相合之友。",{"a":1,"w":[4611,639]}],["吏干","lìgàn","亦作“吏干”。\n为政的才干。",{"a":1,"w":[8898,46]}],["吐漱","tǔshù","犹吞吐。漱，同“嗽”，吮吸。",{"a":1,"w":[3406,11195]}],["君畴","jūnchóu","人名。传说上古圣君尧的老师。",{"a":1,"w":[7831,9184]}],["吠蛤","fèihá","1) 谓蛙鸣。\n2) 鸣蛙。",{"a":1,"w":[11211,9223]}],["含睇","hándì","含情而视。睇，微微地斜视貌。",{"a":1,"w":[2351,23453]}],["吴笺","wújiān","吴地所产之笺纸。常借指书信。",{"a":1,"w":[8110,9999]}],["吴丝","wúsī","吴地产的丝。喻指精美的琴弦。",{"a":1,"w":[8110,7515]}],["吴调","wúdiào","吴歌的曲调。其声多缠绵哀怨。",{"a":1,"w":[8110,1290]}],["吹擂","chuīléi","吹军号、擂鼓。比喻夸大宣传。",{"a":1,"w":[637,12613]}],["吼隆","hǒulóng","象声词。形容剧烈震动的声音。",{"a":1,"w":[5161,7876]}],["吕召","lǚzhào","周代功臣吕尚、召公奭的并称。",{"a":1,"w":[8345,8854]}],["吕葛","lǚgé","周吕尚与三国蜀诸葛亮的并称。",{"a":1,"w":[8345,8321]}],["周志","zhōuzhì","即《周书》。又名《逸周书》。",{"a":1,"w":[563,7626]}],["周网","zhōuwǎng","指周代的政令。网，比喻法纪。",{"a":1,"w":[563,559]}],["周饶","zhōuráo","侏儒。亦为传说中的小人国名。",{"a":1,"w":[563,8550]}],["呿嗋","qùxié","指喘气。呿，张口；嗋，闭口。",{"a":1,"w":[49126,69695]}],["咀茹","jǔrú","1) 嚼食。\n2) 谓钻研。",{"a":1,"w":[11266,8598]}],["咈咈","fúfú","象声词。人痛楚时发出的声音。",{"a":1,"w":[31413]}],["和堇","héjǐn","即野葛。有毒。相传可治蛇伤。",{"a":1,"w":[39,8899]}],["咎罪","jiùzuì","1) 罪过。\n2) 犹得罪。",{"a":1,"w":[9750,4686]}],["咢然","èrán","愕然。惊异貌。咢，通“愕”。",{"a":1,"w":[27971,7451]}],["咻呴","xiūxǔ","呵气使温暖。形容温和；仁慈。",{"a":1,"w":[19159,15802]}],["咽领","yànlǐng","咽喉与颈项。比喻形势险要处。",{"a":1,"w":[9066,1361]}],["咽颈","yànjǐng","指脖子(或颈项，头颈)；头。",{"a":1,"w":[9066,8141]}],["哀匏","āipáo","悲凉的乐器声。匏，八音之一。",{"a":1,"w":[8386,14434]}],["哀钥","āiyào","指悲伤的乐声。龠，古管乐器。",{"a":1,"w":[8386,9086]}],["品令","pǐnlìng","选拔官吏的格令。分九个品级。",{"a":1,"w":[3321,3329]}],["品诣","pǐnyì","1) 犹品类。\n2) 品行。",{"a":1,"w":[3321,15360]}],["哭主","kūzhǔ","即苦主。命案中被害人的家属。",{"a":1,"w":[728,7425]}],["哲民","zhémín","谓制裁犯罪者。哲，通“折”。",{"a":1,"w":[8304,7434]}],["唐圃","tángpǔ","场圃。指种植瓜果菜蔬的园地。",{"a":1,"w":[7869,13245]}],["唐陂","tángbēi","有堤坝的池塘。唐，通“塘”。",{"a":1,"w":[7869,10251]}],["唯复","wéifù","还是。用在疑问句，表示选择。",{"a":1,"w":[8212,7461]}],["唱门","chàngmén","在门口高声通报来客或进见者。",{"a":1,"w":[198,53]}],["啄评","zhuópíng","南朝梁时新罗国的行政区域名。",{"a":1,"w":[9483,4734]}],["问经","wènjīng","指学习或请教有关经书的问题。",{"a":1,"w":[113,7421]}],["哑喑","yǎyīn","亦作“哑瘖”。\n阴沉；沉默。",{"a":1,"w":[8480,12796]}],["启奠","qǐdiàn","皇帝之灵柩启迁前所行的奠礼。",{"a":1,"w":[7875,9667]}],["衔蹶","xiánjué","咬辔头尥蹶子。比喻不受羁系。",{"a":1,"w":[8703,9501]}],["善权","shànquán","佛教语。谓多方巧说导人觉悟。",{"a":1,"w":[7657,4623]}],["善毁","shànhuǐ","谓因丧亲过作哀伤而瘦弱变形。",{"a":1,"w":[7657,4749]}],["丧奠","sàngdiàn","古丧礼中指死者未葬前的祭奠。",{"a":1,"w":[8016,9667]}],["丧幡","sàngfān","丧家悬挂的白色狭长形的旗帜。",{"a":1,"w":[8016,10797]}],["嗃唠","hèláo","象声词。对家畜之类的呼唤声。",{"a":1,"w":[63101,11669]}],["呛白","qiāngbái","抢白。当面顶撞、责备或讽刺。",{"a":1,"w":[11147,24]}],["嗥咷","háotáo","号咷。大声哭。嗥，通“号”。",{"a":1,"w":[16891,57471]}],["嘈啾","cáojiū","象声词。形容声音的喧闹杂乱。",{"a":1,"w":[13312,18327]}],["嘉鲂","jiāfáng","鲂鱼的美称。鲂鱼味美，故云。",{"a":1,"w":[8327,10418]}],["尝谷","chánggǔ","古代祭祀后尝食新收获的谷物。",{"a":1,"w":[2455,7701]}],["尝驹","chángjū","谓汉代天子郊祀以马驹为祭品。",{"a":1,"w":[2455,10684]}],["嘻溜","xīliū","方言。谓吸咂嘴唇的一种动作。",{"a":1,"w":[13497,4717]}],["嚬噈","píncù","同“嚬蹙”。\n噈，通“戚”。",{"a":1,"w":[28640]}],["嚬顣","píncù","同“嚬蹙”。\n顣，通“蹙”。",{"a":1,"w":[28640,442225]}],["严乐","yánlè","汉武帝时人严安、徐乐的并称。",{"a":1,"w":[2349,1340]}],["严郑","yánzhèng","汉隐士严君平、郑子真的并称。",{"a":1,"w":[2349,9014]}],["严骆","yánluò","五代吴严可求与骆知祥的并称。",{"a":1,"w":[2349,10938]}],["四病","sìbìng","佛教语。指修行中的四种弊病。",{"a":1,"w":[86,67]}],["四秋","sìqiū","指春、夏、秋、冬四季的收成。",{"a":1,"w":[86,1391]}],["困毒","kùndú","1) 犹中毒。\n2) 苦难。",{"a":1,"w":[1437,3322]}],["困踧","kùncù","同“困蹙”。\n踧，通“蹙”。",{"a":1,"w":[1437,34207]}],["圉臣","yǔchén","古时臣下自谦之词，犹言贱臣。",{"a":1,"w":[11291,8045]}],["国妖","guóyāo","国家的妖孽。指危害国家的人。",{"a":1,"w":[23,8617]}],["国宦","guóhuàn","犹左宦。谓天子之臣而仕诸侯。",{"a":1,"w":[23,10795]}],["国蔽","guóbì","国家的屏障，谓国境上的要塞。",{"a":1,"w":[23,8083]}],["团扁","tuánbiǎn","篾编的扁平盛器。圆形，浅口。",{"a":1,"w":[1336,4716]}],["圜冠","huánguān","儒者戴的圆形帽子。也叫鹬冠。",{"a":1,"w":[13026,7694]}],["土俑","tǔyǒng","古代用泥土烧制的殉葬的偶人。",{"a":1,"w":[1300,20245]}],["土宿","tǔsù","即土星。我国古代五行星之一。",{"a":1,"w":[1300,7825]}],["圭衮","guīgǔn","圭玉和衮衣。比喻朝廷的高位。",{"a":1,"w":[9153,12193]}],["坊院","fāngyuàn","南宋临安富家建于水上的货房。",{"a":1,"w":[8643,571]}],["坤则","kūnzé","古指以柔顺为原则的妇女规范。",{"a":1,"w":[9337,3323]}],["坯陶","pītáo","谓制作陶器。喻指造就，培养。",{"a":1,"w":[9510,7848]}],["坼堠","chèhòu","即斥候。侦察。亦指侦察的人。",{"a":1,"w":[15127,18467]}],["垂接","chuíjiē","谓地位高的人接待地位低的人。",{"a":1,"w":[7786,548]}],["垠崖","yínyá","1) 犹悬崖。\n2) 边际。",{"a":1,"w":[13168,8942]}],["城堑","chéngqiàn","1) 护城河。\n2) 城池。",{"a":1,"w":[1353,10204]}],["城阃","chéngkǔn","犹城门。代指城市。阃，门坎。",{"a":1,"w":[1353,13395]}],["执梃","zhítǐng","手执梃杖。指持梃作仪卫前导。",{"a":1,"w":[7826,14562]}],["执盖","zhígài","道教称侍奉天帝的仙官、侍从。",{"a":1,"w":[7826,2289]}],["执辨","zhíbiàn","犹争辩，强辩。辨，通“辩”。",{"a":1,"w":[7826,8004]}],["堙厄","yīn'è","亦作“堙厄”。\n阻塞；险阻。",{"a":1,"w":[12575,8300]}],["报喏","bàonuò","谓应答尊长，表示礼敬、遵从。",{"a":1,"w":[1318,25967]}],["场灶","chǎngzào","盐场上的煮盐灶。亦借指盐场。",{"a":1,"w":[544,8804]}],["塞氛","sāifēn","边境上的气氛。指敌方的威胁。",{"a":1,"w":[4630,9649]}],["填宫","tiángōng","古代犯官家属没入宫廷称填宫。",{"a":1,"w":[2371,4679]}],["填骨","tiángǔ","犹入骨。谓在感受上达到极点。",{"a":1,"w":[2371,7537]}],["尘壤","chénrǎng","1) 泥土。\n2) 犹尘世。",{"a":1,"w":[7843,8583]}],["尘路","chénlù","布满尘土的道路。亦以喻尘俗。",{"a":1,"w":[7843,54]}],["尘鞍","chén'ān","落满尘土的马鞍。亦代指车马。",{"a":1,"w":[7843,9598]}],["墐涂","jìntú","I\n用泥涂抹。\nII\n粘土。",{"a":1,"w":[38222,7866]}],["墨丸","mòwán","古墨的一种。形圆如丸，故名。",{"a":1,"w":[7667,4757]}],["坟田","féntián","旧时私人用作埋葬死者的田地。",{"a":1,"w":[9056,4668]}],["坟陇","fénlǒng","1) 坟墓。\n2) 指祖坟。",{"a":1,"w":[9056,10388]}],["坛谕","tányù","设坛扶乩时乩盘上写下的文字。",{"a":1,"w":[8465,9439]}],["壤翁","rǎngwēng","即壤父。泛指太平盛世的老人。",{"a":1,"w":[8583,8165]}],["壤芥","rǎngjiè","泥土和小草，比喻微贱的事物。",{"a":1,"w":[8583,8473]}],["士习","shìxí","士大夫的风气；读书人的风气。",{"a":1,"w":[7542,7678]}],["壶峤","hújiào","传说中仙山方壶、员峤的并称。",{"a":1,"w":[3500,16760]}],["夏雩","xiàyú","古代夏季为求雨而举行的祭祀。",{"a":1,"w":[1397,16328]}],["外昏","wàihūn","谓另外新配偶。昏，通“婚”。",{"a":1,"w":[36,4748]}],["大涂","dàtú","1) 大路。\n2) 谓大道。",{"a":1,"w":[4,7866]}],["大姜","dàjiāng","周太王妃，文王之祖母，姓姜。",{"a":1,"w":[4,8431]}],["大璋","dàzhāng","天子巡狩祼祭大山川所用的玉。",{"a":1,"w":[4,15609]}],["天旆","tiānpèi","帝王仪仗中的旗帜。借指皇帝。",{"a":1,"w":[19,14637]}],["天江","tiānjiāng","1) 星名。\n2) 指天河。",{"a":1,"w":[19,2327]}],["天葩","tiānpā","非凡的花，常比喻秀逸的诗文。",{"a":1,"w":[19,15088]}],["天锋","tiānfēng","1) 星名。\n2) 喻兵戎。",{"a":1,"w":[19,8275]}],["天陷","tiānxiàn","指地势低洼、泥泞易陷的地带。",{"a":1,"w":[19,7914]}],["失欲","shīyù","淫佚贪欲。谓放荡于声色游乐。",{"a":1,"w":[7527,7872]}],["失状","shīzhuàng","指被偷盗、抢劫的财物的清单。",{"a":1,"w":[7527,7511]}],["失瞻","shīzhān","旧时客套语。谓失于瞻仰拜候。",{"a":1,"w":[7527,10022]}],["夷陬","yízōu","古代对少数民族居住地区之称。",{"a":1,"w":[7910,13625]}],["奇杰","qíjié","1) 俊杰。\n2) 犹杰出。",{"a":1,"w":[7460,7895]}],["奉报","fèngbào","1) 报答。\n2) 犹奉告。",{"a":1,"w":[7971,1318]}],["奉贡","fènggòng","1) 纳贡。\n2) 犹奉献。",{"a":1,"w":[7971,8007]}],["奏钞","zòuchāo","唐宋时门下省所用文书之一种。",{"a":1,"w":[4777,8820]}],["奔电","bēndiàn","1) 闪电。\n2) 骏马名。",{"a":1,"w":[8195,12]}],["奋节","fènjié","以英勇、壮烈行为表现其节操。",{"a":1,"w":[8299,540]}],["好乖","hǎoguāi","容易乖违。多指离别，不如意。",{"a":1,"w":[58,3601]}],["妖妍","yāoyán","1) 艳丽。\n2) 指美女。",{"a":1,"w":[8617,13038]}],["妙竹","miàozhú","指能奏出动听乐声的竹制乐器。",{"a":1,"w":[4764,7655]}],["妙键","miàojiàn","神妙的关键，指佛理开悟之机。",{"a":1,"w":[4764,3436]}],["姎徒","yāngtú","犹吾徒。古代西南少数民族语。",{"a":1,"w":[255148,7813]}],["姣娃","jiāowá","1) 犹娇女。\n2) 美女。",{"a":1,"w":[12773,7569]}],["奸刻","jiānkè","亦作“奸刻”。\n谓奸邪刻毒。",{"a":1,"w":[8125,626]}],["奸敝","jiānbì","亦作“奸敝”。\n见“奸弊”。",{"a":1,"w":[8125,8875]}],["奸谍","jiāndié","犹间谍。为敌方刺探情况的人。",{"a":1,"w":[8125,9043]}],["奸竖","jiānshù","亦作“奸竖”。\n奸诈的小人。",{"a":1,"w":[8125,4815]}],["姻懿","yīnyì","1) 姻亲。\n2) 指婚配。",{"a":1,"w":[8706,11249]}],["娼优","chāngyōu","从事歌舞的艺人，后多指妓女。",{"a":1,"w":[14929,7733]}],["嫣香","yānxiāng","娇艳芳香。亦指娇艳芳香的花。",{"a":1,"w":[23046,1311]}],["婴物","yīngwù","谓萦怀世务；纠缠于外界事物。",{"a":1,"w":[8656,7412]}],["孔姬","kǒngjī","孔子和姬旦(周公旦)的并称。",{"a":1,"w":[4636,8824]}],["孔昊","kǒnghào","孔子和太昊(伏羲氏)的并称。",{"a":1,"w":[4636,13001]}],["孔郑","kǒngzhèng","汉经学家孔安国与郑玄的并称。",{"a":1,"w":[4636,9014]}],["孟亭","mèngtíng","亭名。在今湖北省钟祥县境内。",{"a":1,"w":[8610,8241]}],["孤塞","gūsāi","谓独自专断，拒绝他人的意见。",{"a":1,"w":[7996,4630]}],["孤干","gūgàn","植物的独生干。亦比喻孤独者。",{"a":1,"w":[7996,46]}],["孙业","sūnyè","谓专心于学业。孙，通“逊”。",{"a":1,"w":[7936,7418]}],["孱拙","cànzhuō","笨拙无能。亦指笨拙无能的人。",{"a":1,"w":[17664,9782]}],["孳孜","zīzī","同“孜孜”。\n孳，通“孜”。",{"a":1,"w":[16827,10064]}],["守危","shǒuwēi","谓保持着如处危境的小心谨慎。",{"a":1,"w":[2338,7654]}],["完璞","wánpú","完好的璞玉。比喻美好的操守。",{"a":1,"w":[604,11839]}],["宗干","zōnggàn","犹主干。比喻位尊任重的人物。",{"a":1,"w":[7624,46]}],["宗霸","zōngbà","指身为宗室而抚绥一方的诸侯。",{"a":1,"w":[7624,8096]}],["官暇","guānxiá","公余。官吏办公后的空闲时间。",{"a":1,"w":[2293,10002]}],["官曹","guāncáo","官吏办事机关；官吏办事处所。",{"a":1,"w":[2293,8358]}],["官纲","guāngāng","旧时官府成批运输货物的组织。",{"a":1,"w":[2293,8152]}],["定趋","dìngqū","一定的趋向；固定不变的准则。",{"a":1,"w":[2259,8388]}],["宜称","yíchēng","适当(的状态)；合适；相宜。",{"a":1,"w":[7984,613]}],["客丁","kèdīng","1) 仆人。\n2) 犹客民。",{"a":1,"w":[7618,4646]}],["宣坐","xuānzuò","皇帝赐臣子坐，称为“宣坐”。",{"a":1,"w":[7827,128]}],["宣视","xuānshì","同“宣示”。\n视，通“示”。",{"a":1,"w":[7827,7494]}],["室祭","shìjì","犹家祭。在家中对先人的祭祀。",{"a":1,"w":[1359,8417]}],["室闾","shìlǘ","1) 房舍。\n2) 犹乡里。",{"a":1,"w":[1359,9516]}],["宦术","huànshù","做官的手段与本领。用于贬义。",{"a":1,"w":[10795,7471]}],["宫仪","gōngyí","谓宫中之女子。仪，通“娥”。",{"a":1,"w":[4679,7483]}],["害酒","hàijiǔ","病酒。因饮酒过量而感觉不适。",{"a":1,"w":[3353,594]}],["宵练","xiāoliàn","1) 剑名。\n2) 泛称剑。",{"a":1,"w":[9364,633]}],["家蔬","jiāshū","家种的菜。亦指自家烹制的菜。",{"a":1,"w":[28,9834]}],["容众","róngzhòng","谓心怀宽广，能与各种人交往。",{"a":1,"w":[7524,7688]}],["容养","róngyǎng","1) 犹蓄养。\n2) 宽恕。",{"a":1,"w":[7524,582]}],["宿问","sùwèn","谓学者有疑不即问，隔夜再问。",{"a":1,"w":[7825,113]}],["宿义","sùyì","谓旧日存于心中而尚未行之义。",{"a":1,"w":[7825,7437]}],["宿陈","sùchén","指积食。隔夜未消化完的食物。",{"a":1,"w":[7825,7893]}],["寄厝","jìcuò","暂时停柩待葬或浅埋以待改葬。",{"a":1,"w":[2358,15141]}],["寄资","jìzī","宋代近臣预友俸禄的一种名目。",{"a":1,"w":[2358,7444]}],["寐寤","mèiwù","睡眠和觉醒。引申为生活起居。",{"a":1,"w":[11604,15025]}],["寒蒲","hánpú","浦草。因多生长于水滨，故称。",{"a":1,"w":[7631,8305]}],["寓鹄","yùgǔ","一种游戏器械。人工制造的鹄。",{"a":1,"w":[9167,10801]}],["寡暗","guǎ'àn","犹寡昧。知识浅陋，不明事理。",{"a":1,"w":[8272,2340]}],["寝伏","qǐnfú","1) 卧伏。\n2) 息，灭。",{"a":1,"w":[8791,7729]}],["寝燕","qǐnyàn","亦作“寝宴”。\n睡卧与休息。",{"a":1,"w":[8791,7821]}],["寝遏","qǐn'è","亦作“寑遏”。\n搁置；阻止。",{"a":1,"w":[8791,9762]}],["实授","shíshòu","以额定之官职，正式除授实缺。",{"a":1,"w":[7457,8099]}],["寨粮","zhàiliáng","明初征收军队给养的名目之一。",{"a":1,"w":[9753,8088]}],["寨长","zhàizhǎng","清朝办团练时所建寨堡的头领。",{"a":1,"w":[9753,515]}],["写移","xiěyí","汉代拟定和发出文件谓之写移。",{"a":1,"w":[172,2306]}],["宽饮","kuānyǐn","劝酒之辞。表示请人多喝些酒。",{"a":1,"w":[2323,7871]}],["寮民","liáomín","旧称广东入山搭寮居住的穷民。",{"a":1,"w":[10125,7434]}],["寱语","yìyǔ","梦话。引申为胡说、无稽之谈。",{"a":1,"w":[132859,7447]}],["宠人","chǒngrén","受宠爱的人。旧多指姬妾佞臣。",{"a":1,"w":[8782,3]}],["宠借","chǒngjiè","谓给予荣宠和奖励。借，奖借。",{"a":1,"w":[8782,650]}],["宠引","chǒngyǐn","谓荐引爱宠。指引荐姬妾女宠。",{"a":1,"w":[8782,2281]}],["宠章","chǒngzhāng","封建时代表示高官显爵的章服。",{"a":1,"w":[8782,4661]}],["宠貤","chǒngyí","谓朝廷的恩宠及于乡邦或祖先。",{"a":1,"w":[8782,25578]}],["宝糖","bǎotáng","用饴糖加工成的脆美饼类食品。",{"a":1,"w":[2313,1420]}],["宝苗","bǎomiáo","传说能显示其下有玉石的树木。",{"a":1,"w":[2313,7980]}],["宝阶","bǎojiē","佛教语。指佛自天下降的步阶。",{"a":1,"w":[2313,7773]}],["封缸","fēnggāng","酒名。封贮缸中的一种陈年酒。",{"a":1,"w":[600,8568]}],["专夜","zhuānyè","专自侍寝。亦指妃妾独占宠爱。",{"a":1,"w":[7548,631]}],["尊华","zūnhuá","指京城。尊，敬词；华，京华。",{"a":1,"w":[7922,7503]}],["寻微","xúnwēi","探究微细的迹象或玄妙的道理。",{"a":1,"w":[7855,7512]}],["小旆","xiǎopèi","古时缀于旗身的燕尾形小旗尾。",{"a":1,"w":[16,14637]}],["小获","xiǎohuò","1) 小奴。\n2) 犹小得。",{"a":1,"w":[16,2355]}],["小策","xiǎocè","1) 小册子。\n2) 细鞭。",{"a":1,"w":[16,7673]}],["少学","shǎoxué","古代学校名。相对于太学而言。",{"a":1,"w":[126,13]}],["少容","shǎoróng","I\n不容情。\nII\n犹童颜。",{"a":1,"w":[126,7524]}],["尤杨","yóuyáng","南宋诗人尤袤、杨万里的并称。",{"a":1,"w":[7739,8318]}],["就谷","jiùgǔ","谓荒年到有收成的地方去就食。",{"a":1,"w":[95,7701]}],["尸宠","shīchǒng","谓臣见君非而不谏，徒被宠幸。",{"a":1,"w":[7967,8782]}],["尺椽","chǐchuán","一尺长的屋椽。指极小的房屋。",{"a":1,"w":[2347,15100]}],["尻驾","kāojià","以尻为车驾。谓随心所欲遨游。",{"a":1,"w":[14476,7879]}],["居巢","jūcháo","1) 笙。\n2) 居于巢穴。",{"a":1,"w":[7611,8435]}],["屏筹","píngchóu","即厕筹。大便后用以拭秽之具。",{"a":1,"w":[7852,8478]}],["屑玉","xièyù","碾碎玉石。多指仙家屑玉为食。",{"a":1,"w":[4853,2294]}],["展手","zhǎnshǒu","1) 纸品名。\n2) 伸手。",{"a":1,"w":[7565,34]}],["展爪","zhǎnzhǎo","谓施展手腕。亦比喻显示本领。",{"a":1,"w":[7565,8126]}],["展错","zhǎncuò","犹施展，施行。错，通“措”。",{"a":1,"w":[7565,147]}],["屠侩","túkuài","谓屠夫市侩之流。指出身微贱。",{"a":1,"w":[9023,17679]}],["屠牧","túmù","屠夫和牧人。旧时指操贱业者。",{"a":1,"w":[9023,8148]}],["层闉","céngyīn","高耸的瓮城城门。亦泛指城门。",{"a":1,"w":[575,98669]}],["屯厄","tún'è","亦作“屯厄”。\n危难；困苦。",{"a":1,"w":[8563,8300]}],["山州","shānzhōu","多山的州郡。泛指偏僻的地方。",{"a":1,"w":[45,4663]}],["岌峨","jí'é","1) 高貌。\n2) 倾颓貌。",{"a":1,"w":[19979,9923]}],["岐邑","qíyì","古邑名。在今陕西省岐山县境。",{"a":1,"w":[11416,8731]}],["岳客","yuèkè","亦作“岳客”。\n山中的隐士。",{"a":1,"w":[8765,7618]}],["岘首","xiànshǒu","山名。即湖北襄阳县南的岘山。",{"a":1,"w":[27285,2310]}],["崇科","chóngkē","犹高第。指科举考试列入优等。",{"a":1,"w":[8311,512]}],["崇观","chóngguān","宋徽宗年号崇宁、大观的并称。",{"a":1,"w":[8311,7514]}],["崋山","huàshān","即华山。在陕西省。五岳之一。",{"a":1,"w":[173260,45]}],["峥峥","zhēngzhēng","1) 高峻貌。\n2) 深貌。",{"a":1,"w":[36121]}],["崤陂","xiáobēi","古地名。即崤底。详“崤底”。",{"a":1,"w":[145694,10251]}],["嵩溟","sōngmíng","嵩山与北溟。泛指高山与大海。",{"a":1,"w":[10447,12342]}],["嵬昂","wéi'áng","犹嵬峨。倾侧不稳。形容醉态。",{"a":1,"w":[13978,8401]}],["岿望","kuīwàng","崇高的声望。亦指有声望的人。",{"a":1,"w":[62175,7556]}],["巡青","xúnqīng","谓巡视禾苗、牧草的生长情况。",{"a":1,"w":[7981,3320]}],["巢轩","cháoxuān","指巢父与轩辕。借指上古之世。",{"a":1,"w":[8435,8869]}],["工粮","gōngliáng","旧时地主付给雇农的粮食报酬。",{"a":1,"w":[7411,8088]}],["左畔","zuǒpàn","1) 左边。\n2) 指东方。",{"a":1,"w":[154,4942]}],["左貂","zuǒdiāo","武冠的冠饰，以貂尾饰于冠左。",{"a":1,"w":[154,9573]}],["巨搜","jùsōu","古代西戎国名。巨，通“渠”。",{"a":1,"w":[7862,3416]}],["巾几","jīnjǐ","巾和案几。泛指日常起居用物。",{"a":1,"w":[8285,136]}],["巾衍","jīnyǎn","放置头巾、书卷等物的小箱子。",{"a":1,"w":[8285,8283]}],["市步","shìbù","码头上的集市。步，通“埠”。",{"a":1,"w":[555,1337]}],["希水","xīshuǐ","古水名。在今湖北武汉市以东。",{"a":1,"w":[7538,11]}],["帛拜","bóbài","古代新妇持素绢拜见公婆之礼。",{"a":1,"w":[10327,7752]}],["帨缡","shuìlí","佩巾。古代女子出嫁时的装饰。",{"a":1,"w":[16701,40615]}],["师号","shīhào","对道行出众的僧人所加的称号。",{"a":1,"w":[7489,78]}],["帐眉","zhàngméi","床帐门的上端作装饰用的横幅。",{"a":1,"w":[8011,7988]}],["帏幔","wéimàn","1) 帐幕。\n2) 指车帷。",{"a":1,"w":[13815,10557]}],["幄次","wòcì","古代帝王休憩或祀神用的帷帐。",{"a":1,"w":[20743,102]}],["幄茵","wòyīn","帷帐和茵褥。谓坐卧栖息之处。",{"a":1,"w":[20743,10767]}],["幕游","mùyóu","旧时称离乡当幕友为“幕游”。",{"a":1,"w":[7877,1317]}],["币玉","bìyù","帛和玉，古代用以祭祀的礼品。",{"a":1,"w":[7943,2294]}],["干暴","gànbào","1) 谓冒犯侵凌\n2) 晒干",{"a":1,"w":[46,7675]}],["干鳖","gànbiē","干瘪。引申为没兴味，没意思。",{"a":1,"w":[46,10009]}],["平䌷","píngchōu","即绨。一种厚重光洁的丝织物。",{"a":1,"w":[525,24257]}],["平鬲","pínggé","谓车两旁之上高出于轼的平木。",{"a":1,"w":[525,23308]}],["干本","gànběn","树木的主干。亦喻事物的根本。",{"a":1,"w":[46,42]}],["幽峻","yōujùn","隐僻峻峭。亦指隐僻峻峭之处。",{"a":1,"w":[8098,9365]}],["幽禜","yōuyǒng","祭名。古代设坛祈祭星辰之称。",{"a":1,"w":[8098,108923]}],["幽辱","yōurǔ","1) 侮辱。\n2) 指受辱。",{"a":1,"w":[8098,8418]}],["序客","xùkè","鸿胪官之别称。职掌礼宾之事。",{"a":1,"w":[7598,7618]}],["序端","xùduān","堂的东墙或西墙的南端近阶处。",{"a":1,"w":[7598,4659]}],["底公","dǐgōng","谓以公正自勉。底，通“砥”。",{"a":1,"w":[2290,4610]}],["庖娲","páowā","古代神话传说中女娲氏的别称。",{"a":1,"w":[11983,28821]}],["庖馔","páozhuàn","1) 烹调。\n2) 指菜肴。",{"a":1,"w":[11983,10570]}],["庚符","gēngfú","兵符；虎符。调兵遣将的凭证。",{"a":1,"w":[9297,7841]}],["府倅","fǔcuì","知府的佐贰官，如同知、通判。",{"a":1,"w":[7706,23086]}],["度涉","dùshè","犹言涉足。引申指沾染习气等。",{"a":1,"w":[513,7925]}],["庶庶","shùshù","I\n众多貌。\nII\n象声词。",{"a":1,"w":[8722]}],["庶龟","shùguī","古代传说中有鳞甲的动物之一。",{"a":1,"w":[8722,7684]}]]