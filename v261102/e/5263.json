5,3348]}],["展谒","zhǎnyè","敬词。犹拜见，拜谒。",{"a":1,"w":[7565,9577]}],["展轮","zhǎnlún","转轮。多指启程出行。",{"a":1,"w":[7565,2280]}],["屖弩","xīnǔ","指穿水犀甲的弓弩手。",{"a":1,"w":[9962]}],["屠母","túmǔ","谓母裂胸而生下孩子。",{"a":1,"w":[9023,4637]}],["层岚","cénglán","指重山叠岭中的雾气。",{"a":1,"w":[575,12005]}],["层嶂","céngzhàng","谓重叠如屏障的山峰。",{"a":1,"w":[575,17134]}],["层殿","céngdiàn","谓多重而高大的宫殿。",{"a":1,"w":[575,8493]}],["层阿","céng'ā","重叠的或高耸的山冈。",{"a":1,"w":[575,7414]}],["山世","shānshì","佛教语。僧侣的住处。",{"a":1,"w":[45,7462]}],["山岸","shān'àn","濒临水域的陡峭山崖。",{"a":1,"w":[45,3418]}],["山弄","shānnòng","壮族语。山间的平地。",{"a":1,"w":[45,630]}],["山樊","shānfán","山旁。亦指山中茂林。",{"a":1,"w":[45,12033]}],["山父","shānfù","尧时隐士巢父的别称。",{"a":1,"w":[45,7846]}],["山瓶","shānpíng","山野人家所用的酒瓶。",{"a":1,"w":[45,671]}],["山䌷","shānchōu","用野蚕丝制成的绸子。",{"a":1,"w":[45,24257]}],["山述","shānshù","古代通天冠上的装饰。",{"a":1,"w":[45,8246]}],["山醪","shānláo","山中人家酿造的浊酒。",{"a":1,"w":[45,16249]}],["岐岖","qíqū","崎岖。比喻艰难险阻。",{"a":1,"w":[11416,31741]}],["岷嶓","mínbō","岷山与嶓冢山的并称。",{"a":1,"w":[15066,105528]}],["峨岷","émín","峨眉山与岷山的并称。",{"a":1,"w":[9923,15066]}],["峻却","jùnquè","严厉拒绝，坚决推辞。",{"a":1,"w":[9365,2314]}],["崇宏","chónghóng","高大宏伟；高大宽敞。",{"a":1,"w":[8311,8933]}],["昆岫","kūnxiù","指昆仑山。借指仙山。",{"a":1,"w":[8191,21492]}],["昆华","kūnhuá","昆仑山和华山的并称。",{"a":1,"w":[8191,7503]}],["昆邓","kūndèng","昆仑山和邓林的并称。",{"a":1,"w":[8191,10432]}],["崖公","yágōng","唐代散乐艺人称皇帝。",{"a":1,"w":[8942,4610]}],["崩石","bēngshí","损坏的刻石。指残碑。",{"a":1,"w":[8619,7419]}],["崩背","bēngbèi","犹崩殂。指帝王之死。",{"a":1,"w":[8619,565]}],["崱嶷","zèyí","交错不齐貌；纵横貌。",{"a":1,"w":[45464,31792]}],["嶓岷","bōmín","嶓冢山和岷山的并称。",{"a":1,"w":[105528,15066]}],["嶚峣","liáoyáo","形容山高。借指高峰。",{"a":1,"w":[18882]}],["嶝道","dèngdào","可供攀登的山间小道。",{"a":1,"w":[108402,511]}],["嶷尔","yí'ěr","犹嶷然。屹立不动貌。",{"a":1,"w":[31792,7407]}],["巅倒","diāndào","同“颠倒”。\n倾覆。",{"a":1,"w":[18803,583]}],["岩堀","yánkū","山洞。堀，同“窟”。",{"a":1,"w":[7558,47416]}],["岩棱","yánléng","形容骨骼突出多棱角。",{"a":1,"w":[7558,8100]}],["川陆","chuānlù","水陆。亦指水陆路途。",{"a":1,"w":[7897,7605]}],["川骛","chuānwù","江河奔驰。形容迅疾。",{"a":1,"w":[7897,13411]}],["巧任","qiǎorèn","犹巧能。技巧，技能。",{"a":1,"w":[1421,1331]}],["巧宦","qiǎohuàn","善于钻营谄媚的官吏。",{"a":1,"w":[1421,10795]}],["巧薄","qiǎobáo","奸诈刻薄；轻浮浅薄。",{"a":1,"w":[1421,2319]}],["巨金","jùjīn","大批钱财；大锭银子。",{"a":1,"w":[7862,1270]}],["巨驵","jùzǎng","大牙行商；富商大贾。",{"a":1,"w":[7862,16268]}],["巫音","wūyīn","巫觋歌舞时用的音乐。",{"a":1,"w":[8890,7498]}],["巴笺","bājiān","蜀地产的一种优质纸。",{"a":1,"w":[7424,9999]}],["市册","shìcè","指古籍中的坊间刻本。",{"a":1,"w":[555,3413]}],["市歌","shìgē","流行于市民中的歌谣。",{"a":1,"w":[555,208]}],["市正","shìzhèng","古代掌管市场的官员。",{"a":1,"w":[555,62]}],["市脔","shìluán","谓市上切割零卖之肉。",{"a":1,"w":[555,15970]}],["市闲","shìxián","市井中游手好闲的人。",{"a":1,"w":[555,3381]}],["市魁","shìkuí","古代管理市场的役吏。",{"a":1,"w":[555,8560]}],["布卦","bùguà","排列卦象，进行占卜。",{"a":1,"w":[1283,9042]}],["帑簿","tǎngbù","国库登记财物的帐簿。",{"a":1,"w":[17732,8320]}],["帑金","tǎngjīn","钱币。多指国库所藏。",{"a":1,"w":[17732,1270]}],["帑项","tǎngxiàng","国库里的钱财；款项。",{"a":1,"w":[17732,2342]}],["帖字","tiēzì","谓熟记经书以应帖试。",{"a":1,"w":[8250,84]}],["帝匹","dìpǐ","皇帝的配偶。指皇后。",{"a":1,"w":[7840,3427]}],["帝姻","dìyīn","皇帝的姻亲。犹外戚。",{"a":1,"w":[7840,8706]}],["帝家","dìjiā","京都。亦用以指皇宫。",{"a":1,"w":[7840,28]}],["帝屋","dìwū","神话传说中的树木名。",{"a":1,"w":[7840,3389]}],["帝机","dìjī","旧谓天帝造化的力量。",{"a":1,"w":[7840,7405]}],["帝牛","dìniú","古代郊祀时所用之牛。",{"a":1,"w":[7840,1346]}],["帝统","dìtǒng","帝王的统绪。指帝位。",{"a":1,"w":[7840,7442]}],["师矩","shījǔ","犹师范。学习的榜样。",{"a":1,"w":[7489,8181]}],["席屋","xíwū","用席搭盖的简易房子。",{"a":1,"w":[7836,3389]}],["帐史","zhàngshǐ","管理户籍财务的官吏。",{"a":1,"w":[8011,7661]}],["帐幅","zhàngfú","床帐四周下垂的部分。",{"a":1,"w":[8011,3454]}],["带衽","dàirèn","腰带和衣衽。喻近处。",{"a":1,"w":[542,12788]}],["常杨","chángyáng","唐常衮和杨炎的并称。",{"a":1,"w":[99,8318]}],["常爵","chángjué","素常用以罚酒的酒器。",{"a":1,"w":[99,8494]}],["帏闼","wéità","犹闺阁。引申指淑女。",{"a":1,"w":[13815,12908]}],["幕道","mùdào","指当幕友的一套本领。",{"a":1,"w":[7877,511]}],["干天","gàntiān","犹参天。谓高出空际。",{"a":1,"w":[46,19]}],["平乘","píngchéng","大船名。又名平乘舫。",{"a":1,"w":[525,3366]}],["平奏","píngzòu","谓辨析明白而后上奏。",{"a":1,"w":[525,4777]}],["平弱","píngruò","指诗文平