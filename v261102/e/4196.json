[["隽哲","juànzhé","1) 聪明睿智。\n2) 指聪明睿智者。",{"a":1,"w":[15963,8304]}],["雕柱","diāozhù","饰有浮雕、彩绘的柱子；装饰华美的柱子。",{"a":1,"w":[8192,7685]}],["雕颜","diāoyán","谓额上刺花纹。古时少数民族的一种风俗。",{"a":1,"w":[8192,8117]}],["双七","shuāngqī","1) 十四。\n2) 指农历七月初七日。",{"a":1,"w":[1309,134]}],["杂差","záchà","1) 零杂差使。\n2) 古代徭役之一。",{"a":1,"w":[4680,121]}],["离縰","líxǐ","1) 见“离簁”。\n2) 见“离纵”。",{"a":1,"w":[543,60776]}],["雪灯","xuědēng","1) 雪夜灯火。\n2) 用雪制作的灯。",{"a":1,"w":[616,644]}],["雪脊","xuějí","1) 雪亮的剑脊。\n2) 白色的屋脊。",{"a":1,"w":[616,8277]}],["雪茗","xuěmíng","经开水冲泡后，上面有一层白色泡沫的茶。",{"a":1,"w":[616,12941]}],["云宫","yúngōng","1) 巍峨的皇宫。\n2) 道者的居室。",{"a":1,"w":[554,4679]}],["云庵","yún'ān","亦作“云庵”。\n建造在高山顶上的房舍。",{"a":1,"w":[554,11122]}],["云漠","yúnmò","天上的垂云和大漠交接之处，极言其辽远。",{"a":1,"w":[554,8479]}],["云舞","yúnwǔ","1) 翩翩而舞。\n2) 指轻盈的舞蹈。",{"a":1,"w":[554,3356]}],["雷奋","léifèn","谓雷鸣。语本《易‧豫》：“雷出地奋。”",{"a":1,"w":[3319,8299]}],["雷蛰","léizhé","指蛰伏，蛰居。雷于冬时蛰伏不出，故称。",{"a":1,"w":[3319,12784]}],["震掉","zhèndiào","1) 震颤，抖动。\n2) 惊骇，惊恐。",{"a":1,"w":[7751,651]}],["震扬","zhènyáng","1) 振作，振奋。\n2) 震动，传扬。",{"a":1,"w":[7751,7578]}],["沾露","zhānlù","1) 被露水沾湿。\n2) 露水；露珠。",{"a":1,"w":[8488,4674]}],["霜兔","shuāngtù","1) 白兔。\n2) 指用兔毫制成的笔。",{"a":1,"w":[8258,3426]}],["霜臼","shuāngjiù","指石臼。一般用来舂米，也有用作捣药的。",{"a":1,"w":[8258,11478]}],["雾吐","wùtǔ","1) 雾气蒸腾貌。\n2) 飘拂翻动貌。",{"a":1,"w":[3421,3406]}],["雾委","wùwěi","1) 沛然四塞；充盛貌。\n2) 聚集。",{"a":1,"w":[3421,7519]}],["雾雪","wùxuě","雾和雪。比喻舒卷自如和曲高和寡的诗文。",{"a":1,"w":[3421,616]}],["露暴","lùbào","暴露。谓行止于野，栉风沐雨，无所遮蔽。",{"a":1,"w":[4674,7675]}],["露红","lùhóng","1) 鲜艳的红色。\n2) 显现出红色。",{"a":1,"w":[4674,534]}],["露索","lùsuǒ","1) 露出身体被人搜查。\n2) 井绳。",{"a":1,"w":[4674,7470]}],["露胔","lùzì","1) 暴露骸骨。\n2) 指未葬的尸骸。",{"a":1,"w":[4674,53748]}],["霸政","bàzhèng","指以武力、刑罚、权势等进行统治的政治。",{"a":1,"w":[8096,7478]}],["灵坚","língjiān","1) 道教语。鼻神。\n2) 借指鼻子。",{"a":1,"w":[7588,7849]}],["灵思","língsī","1) 神灵的思绪。\n2) 巧妙的构思。",{"a":1,"w":[7588,7586]}],["灵庆","língqìng","1) 喜庆。\n2) 指灵验吉祥的符谶。",{"a":1,"w":[7588,8113]}],["青毫","qīngháo","指毛笔笔头。毛笔笔头濡墨成黑色，故称。",{"a":1,"w":[3320,7913]}],["青润","qīngrùn","1) 犹言绿油油。\n2) 色青而润泽。",{"a":1,"w":[3320,7847]}],["青节","qīngjié","1) 道教的青色旗旛。\n2) 指竹子。",{"a":1,"w":[3320,540]}],["青络","qīngluò","1) 青丝马络头。\n2) 谓青藤缠绕。",{"a":1,"w":[3320,7837]}],["青肤","qīngfū","1) 青色的树皮。\n2) 苔藓的异称。",{"a":1,"w":[3320,8232]}],["青阴","qīngyīn","1) 绿色的树荫。\n2) 指树的影子。",{"a":1,"w":[3320,576]}],["青糍","qīngcí","在糯米中掺上野草汁或树叶汁做成的食品。",{"a":1,"w":[3320,22781]}],["青鬣","qīngliè","指新抽的麦穗。因其色青绿而有芒，故称。",{"a":1,"w":[3320,10816]}],["青鹊","qīngquè","1) 马名。\n2) 道教传说中的神鸟。",{"a":1,"w":[3320,9090]}],["青鸐","qīngdí","即山雉。神话传说中以为善鸣的吉祥之鸟。",{"a":1,"w":[3320,207896]}],["靖默","jìngmò","沉静自守，不汲汲于名利。靖，通“静”。",{"a":1,"w":[9378,8064]}],["靓观","jìngguān","犹静观。默不作声地察看。靓，通“静”。",{"a":1,"w":[14018,7514]}],["静坊","jìngfāng","1) 清静的别屋。\n2) 僻静的街巷。",{"a":1,"w":[1386,8643]}],["静居","jìngjū","1) 安静地闲居。\n2) 谓隐居静修。",{"a":1,"w":[1386,7611]}],["静镇","jìngzhèn","1) 静止。\n2) 犹镇静。安静镇定。",{"a":1,"w":[1386,4701]}],["鞅绊","yāngbàn","拘系马腹和马脚的绳带。比喻羁绊、束缚。",{"a":1,"w":[14511,11084]}],["鞋杯","xiébēi","亦作“鞋杯”。\n指置杯于女鞋中以行酒。",{"a":1,"w":[685,199]}],["鞠域","jūyù","1) 古代蹴鞠场所。\n2) 指地下室。",{"a":1,"w":[10161,7823]}],["鞭弭","biānmǐ","1) 马鞭和弓。\n2) 借指戎马生活。",{"a":1,"w":[8162,11160]}],["鞭耻","biānchǐ","谓施行鞭挞以羞辱之。引申为虐待、整治。",{"a":1,"w":[8162,8794]}],["鞮海","dīhǎi","匈奴中私渠比鞮海的省称。在今蒙古境内。",{"a":1,"w":[16645,528]}],["韩彭","hánpéng","汉代名将淮阴侯韩信与建成侯彭越的并称。",{"a":1,"w":[8332,8776]}],["韬旒","tāoliú","犹垂旒。帝冕前后垂下的玉串。借指皇帝。",{"a":1,"w":[11243,14816]}],["韭荓","jiǔpíng","亦作“韭萍”。亦作“韭虀”。\n食品名。",{"a":1,"w":[9340,35123]}],["音华","yīnhuá","1) 犹美名。\n2) 指人的音容仪态。",{"a":1,"w":[7498,7503]}],["韶容","sháoróng","1) 清新的风光。\n2) 美丽的容貌。",{"a":1,"w":[10368,7524]}],["韶钧","sháojūn","《韶》乐和钧天广乐。亦泛指优美的乐曲。",{"a":1,"w":[10368,9707]}],["韶陔","sháogāi","《韶》乐和《南陔》的合称。亦泛指古乐。",{"a":1,"w":[10368,27022]}],["韵叶","yùnyè","标韵字的叶形竹、木片。供作诗定韵之用。",{"a":1,"w":[8313,7426]}],["响逸","xiǎngyì","1) 音响悠扬。\n2) 比喻文气奔放。",{"a":1,"w":[639,8116]}],["顷动","qǐngdòng","1) 震动；轰动。\n2) 倾覆，动摇。",{"a":1,"w":[9233,6]}],["顺济","shùnjì","1) 顺利地渡过。\n2) 顺利，通畅。",{"a":1,"w":[4660,7522]}],["顽忽","wánhū","玩忽。不严肃认真地对待。顽，通“玩”。",{"a":1,"w":[8595,8123]}],["领兑","lǐngduì","1) 谓掌管兑运事宜。\n2) 犹领取。",{"a":1,"w":[1361,8293]}],["领掇","lǐngduō","1) 提掇，揪扯。\n2) 管领；处治。",{"a":1,"w":[1361,10915]}],["头拳","tóuquán","指脑袋。以脑袋代替拳头撞击他人，故称。",{"a":1,"w":[509,8107]}],["头拨","tóubō","明代景泰年间为防御蒙古所建精锐部队名。",{"a":1,"w":[509,4720]}],["头髻","tóujì","发髻，在头顶或脑后盘成各种形状的头发。",{"a":1,"w":[509,10590]}],["题缄","tíjiān","在书信函件封皮上题写受件人姓名、官衔。",{"a":1,"w":[615,10315]}],["颠乱","diānluàn","1) 颠狂迷乱。\n2) 不规则地颠簸。",{"a":1,"w":[8660,1360]}],["颠夭","diānyāo","西周初辅佐文王的大臣泰颠和闳夭的并称。",{"a":1,"w":[8660,9282]}],["颠搭","diāndā","1) 蹦跳地跑。\n2) 行步不平稳貌。",{"a":1,"w":[8660,4708]}],["颠歌","diāngē","滇歌。古时西南夷的民歌。颠，通“滇”。",{"a":1,"w":[8660,208]}],["颤掣","chànchè","中国书画技法之一。笔势颤动飘移的技法。",{"a":1,"w":[8935,9713]}],["显排","xiǎnpái","1) 公开的排挤。\n2) 显示并夸耀。",{"a":1,"w":[3347,567]}],["显美","xiǎnměi","1) 显耀而美好。\n2) 显贵的官位。",{"a":1,"w":[3347,1310]}],["风谕","fēngyù","亦作“风喻”。\n以委婉的言辞劝告开导。",{"a":1,"w":[44,9439]}],["飞弓","fēigōng","谓丈量田地越过界限。弓，丈量用的弓尺。",{"a":1,"w":[56,8097]}],["飞构","fēigòu","1) 谓无端构陷。\n2) 高耸的屋宇。",{"a":1,"w":[56,7540]}],["饥国","jīguó","1) 缺乏粮食的国家。\n2) 古国名。",{"a":1,"w":[8569,23]}],["饫禘","yùdì","饫礼和禘礼。泛指按一定礼制举行的宴飨。",{"a":1,"w":[18453,22518]}],["饬材","chìcái","谓整治金、石、珠、玉等材料，使成器具。",{"a":1,"w":[9634,7585]}],["饱飞","bǎofēi","比喻欲望得到满足即离去，不能长久归心。",{"a":1,"w":[654,56]}],["饱馁","bǎoněi","1) 谓饥饱不时。\n2) 使饿者饱食。",{"a":1,"w":[654,11425]}],["养魄","yǎngpò","1) 谓滋养元气。\n2) 谓涵养月光。",{"a":1,"w":[582,9063]}],["余景","yújǐng","1) 残留的光辉。\n2) 余日；残生。",{"a":1,"w":[7597,4676]}],["余残","yúcán","1) 指残兵败卒。\n2) 指残年余生。",{"a":1,"w":[7597,7814]}],["余蚳","yúchí","1) 黄地白纹的贝。\n2) 比喻华美。",{"a":1,"w":[7597,44646]}],["余隶","yúlì","微贱隶卒。官宦子弟谦称其做官父亲之词。",{"a":1,"w":[7597,8847]}],["馆券","guǎnquàn","宋代政府发放的免费供给官员食宿的凭证。",{"a":1,"w":[7919,4758]}],["首乱","shǒuluàn","1) 带头作乱。\n2) 作乱之为首者。",{"a":1,"w":[2310,1360]}],["首实","shǒushí","向官府交代、说明本人或别人的犯罪情实。",{"a":1,"w":[2310,7457]}],["香埋","xiāngmái","1) 花遭埋葬。\n2) 比喻美女亡故。",{"a":1,"w":[1311,4783]}],["香枝","xiāngzhī","1) 谓香气散溢于树枝。\n2) 花枝。",{"a":1,"w":[1311,4696]}],["香楠","xiāngnán","Machilus 